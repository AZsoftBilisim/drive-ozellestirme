// Supplements the list of organizations from the selection Organization with other information security organizations associated with them under the Intercampany scheme.
//
// Parameters:
//	Date - Date - the calculation period
//	FilterCompanies - ValueList, Array, CatalogRef.Companies - Selection by organization
//	Group_ - Boolean - to return the grouped result, or in all found the organization in the form of a regular array.
//
// Returns:
//	Array - If Grouped, then the result is similar to the returned value of the All-Link Organizationintercampany(),
//			 but only those groups (arrays) of organizations that include organizations from the selection organization will be returned.
//			 If you do NOT group, then these same groups will be merged into one array.
//			 I.e., in fact, this function is only a selection for the entire organization of the Inter-Camp()
//			 with the possibility of presenting the result in a "linear" form.
//
Function LinksOfOrganizationsUnderIntercampanyScheme(Date = Undefined, FilterCompanies = Undefined, Group_ = False) Export
	
	SetPrivilegedMode(True);
	
	If Not ValueIsFilled(Date) Then
		Date = CurrentSessionDate();
	EndIf;
	
	FilterByCompanies = TMCommonUseClientServer.Array(FilterCompanies);
	
	// We will get all the IB organizations grouped by Intercampany scheme connections
	GroupsArray1 = AllConnectionsOfOrganizationsUnderIntercampanyScheme(Date);
	
	// Let's leave such groups of organizations in which at least one organization of the group
	// needs to be recalculated (included in the required selection of organizations).
	Result = New Array;
	
	For Each GroupItem1 In GroupsArray1 Do
		For Each Organization In GroupItem1 Do
			
			If Not ValueIsFilled(FilterByCompanies) Or FilterByCompanies.Find(Organization) <> Undefined Then
				
				// This group of related organizations needs to be recalculated
				If Group_ Then
					// The result is in the form of an "array of arrays"
					Result.Add(Common.CopyRecursive(GroupItem1));
				Else
					// The result is in the form of an "array"
					CommonClientServer.SupplementArray(Result, GroupItem1);
				EndIf;
				
				Break; // added the whole group - go to the next one
				
			EndIf;
			
		EndDo;
	EndDo;
	
	Return Result;
	
EndFunction

// Returns the Query Text for getting all the links between the Company and the Crown organization, according to the register of the cost of goods, in the specified period.
//
// Returns:
//   String - Query text
//
Function QueryTextForOrganizationsCommunications()
	Return "
	|SELECT DISTINCT
	|	InventoryCost.Organization AS Organization,
	|	InventoryCost.CorCompany AS CorCompany
	|INTO TTOrganizations
	|FROM
	|	AccumulationRegister.InventoryCost AS InventoryCost
	|WHERE
	|	InventoryCost.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND InventoryCost.CorCompany <> VALUE(Catalog.Companies.EmptyRef)
	|	AND InventoryCost.Active
	|
	|UNION ALL
	|SELECT DISTINCT
	|	InventoryCost.Organization AS Organization,
	|	VALUE(Catalog.Companies.ManagementCompany) AS CorCompany
	|FROM
	|	AccumulationRegister.InventoryCost AS InventoryCost
	|WHERE
	|	InventoryCost.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomerLocalAccounting)
	|	AND InventoryCost.Active
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT DISTINCT
	|	Companies.Organization AS Organization,
	|	Companies.CorCompany AS CorCompany
	|FROM
	|	(SELECT
	|		Companies.Organization AS Organization,
	|		Companies.CorCompany AS CorCompany
	|	FROM
	|		TTOrganizations AS Companies
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		ToTransfer.CompanyOwner,
	|		ToTransfer.SellerInventoryOwnerAttribute.Organization
	|	FROM
	|		AccumulationRegister.CompanyGoodsForTransfer.Balance(&BorderEndOfPeriod,
	|			SellerInventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.OwnGoods)) AS ToTransfer
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		Reserves.Organization,
	|		Reserves.CorCompany
	|	FROM
	|		AccumulationRegister.CompanySafeStock AS Reserves
	|	WHERE
	|		Reserves.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND Reserves.RecordType = VALUE(AccumulationRecordType.Receipt)
	|		AND Reserves.CorInventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.OwnGoods)
	|		AND Reserves.Organization <> Reserves.CorCompany
	|		AND Reserves.Count > 0
	|	) AS Companies
	|WHERE
	|	Companies.Organization <> Companies.CorCompany
	|	AND Companies.Organization <> VALUE(Catalog.Companies.EmptyRef)
	|	AND Companies.CorCompany <> VALUE(Catalog.Companies.EmptyRef)
	|
	|ORDER BY
	|	Organization,
	|	CorCompany";
EndFunction

// Returns the Query Text for getting all the links between the Company and the Crown organization, according to the register of the cost of goods, in the specified period.
// The request is effective for up to ~1.4 million movements, in a given period, with the completed Attributes of the organization.
//
// Returns:
//   String - Query text
//
Function QueryTextOfOrganizationSCommunicationUsingTTFilter()
	
	Return "SELECT
	|	InventoryKinds.Ref AS InventoryOwnerAttribute,
	|	InventoryKinds.Organization AS Organization
	|INTO TTTypesOfStocksOfItems
	|FROM
	|	Catalog.InventoryKinds AS InventoryKinds
	|WHERE
	|	InventoryKinds.InventoryType = VALUE(Enum.InventoryTypes.OwnGoods)
	|
	|INDEX BY
	|	InventoryOwnerAttribute,
	|	Organization
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	InventoryCost.Organization AS Organization,
	|	InventoryCost.CorCompany AS CorCompany
	|FROM
	|	TTFilter AS TTFilter
	|		INNER JOIN AccumulationRegister.InventoryCost AS InventoryCost
	|		ON (InventoryCost.Period = TTFilter.Period)
	|			AND (InventoryCost.Recorder = TTFilter.Recorder)
	|			AND (InventoryCost.LineNumber = TTFilter.LineNumber)
	|			AND (InventoryCost.Organization <> InventoryCost.CorCompany)
	|
	|UNION
	|
	|SELECT DISTINCT
	|	InventoryCost.Organization,
	|	VALUE(Catalog.Companies.ManagementCompany)
	|FROM
	|	AccumulationRegister.InventoryCost AS InventoryCost
	|WHERE
	|	InventoryCost.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.SaleToCustomerLocalAccounting)
	|	AND InventoryCost.Organization <> InventoryCost.CorCompany
	|
	|UNION
	|
	|SELECT DISTINCT
	|	CompanyGoodsForTransferBalance.CompanyOwner,
	|	TTTypesOfStocksOfItems.Organization
	|FROM
	|	TTTypesOfStocksOfItems AS TTTypesOfStocksOfItems
	|		INNER JOIN AccumulationRegister.CompanyGoodsForTransfer.Balance(
	|				&BorderEndOfPeriod,
	|				SellerInventoryOwnerAttribute IN
	|					(SELECT
	|						TTTypesOfStocksOfItems.InventoryOwnerAttribute
	|					FROM
	|						TTTypesOfStocksOfItems AS TTTypesOfStocksOfItems)) AS CompanyGoodsForTransferBalance
	|		ON (CompanyGoodsForTransferBalance.SellerInventoryOwnerAttribute = TTTypesOfStocksOfItems.InventoryOwnerAttribute)
	|			AND (CompanyGoodsForTransferBalance.CompanyOwner <> TTTypesOfStocksOfItems.Organization)
	|			AND (CompanyGoodsForTransferBalance.CompanyOwner <> VALUE(Catalog.Companies.EmptyRef))
	|			AND (TTTypesOfStocksOfItems.Organization <> VALUE(Catalog.Companies.EmptyRef))
	|
	|UNION
	|
	|SELECT DISTINCT
	|	CompanySafeStock.Organization,
	|	CompanySafeStock.CorCompany
	|FROM
	|	TTTypesOfStocksOfItems AS TTTypesOfStocksOfItems
	|		INNER JOIN AccumulationRegister.CompanySafeStock AS CompanySafeStock
	|		ON (CompanySafeStock.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod)
	|			AND (CompanySafeStock.RecordType = VALUE(AccumulationRecordType.Receipt))
	|			AND (CompanySafeStock.CorInventoryOwnerAttribute = TTTypesOfStocksOfItems.InventoryOwnerAttribute)
	|			AND (CompanySafeStock.Organization <> CompanySafeStock.CorCompany)
	|			AND (CompanySafeStock.CorCompany <> VALUE(Catalog.Companies.EmptyRef))
	|			AND (CompanySafeStock.Count > 0)
	|
	|ORDER BY
	|	Organization,
	|	CorCompany";

EndFunction

// Returns information about all security organizations, grouped by their participation in the scheme of Intercompany in the period.
//
// Parameters:
//	Date - Date - the calculation period
//
// Returns:
//		Array of Array - the elements of this array are arrays of organizations (Reference link.Organizations),
//			interconnected according to the Intercampany scheme.
//			= if the organization is not linked to others, then it will be the only one in the array.
//			= the same organization can only be included in one array - it cannot occur several times as a result of the function.
// For example,
//	there are organizations 1, 2, 3, 4, 5
//	according to Intercamp, goods move between organizations 1-3 and 3-5
//	organization 2 in this period works "by itself", is not connected with other organizations
//	according to organization 4 in this period there were no movements in the register of cost of goods
// The array returned by the function will have the following form:
//	element(0) - array (organization 1, organization 3, organization 5) - Intercamp circuit
//	element(1) - array (organization 2) - "single", unrelated organization
//	element(2) - array (organization 4) - despite the absence of movements on it It will be supplemented from THE Catalog of organizations.
//
Function AllConnectionsOfOrganizationsUnderIntercampanyScheme(Date) Export

	GroupsArray1 = New Array; // the result of the function is an array of arrays of organizations
	RegisteredOrganizations = New Array; // related by Intercampany - they do not need to be selected from the Catalog of companies
	
	Query = New Query;
	Query.TempTablesManager = New TempTablesManager();
	Query.Text = "SELECT
	|	InventoryCost.Period AS Period,
	|	InventoryCost.Recorder AS Recorder,
	|	InventoryCost.LineNumber AS LineNumber
	|INTO TTFilter
	|FROM
	|	AccumulationRegister.InventoryCost AS InventoryCost
	|WHERE
	|	InventoryCost.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND InventoryCost.CorCompany <> VALUE(Catalog.Companies.EmptyRef)
	|
	|INDEX BY
	|	Period,
	|	Recorder,
	|	LineNumber";
	
	Query.SetParameter("BeginOfPeriod", BegOfMonth(Date));
	Query.SetParameter("EndOfPeriod", EndOfMonth(Date));
	Query.SetParameter("BorderEndOfPeriod", New Boundary(EndOfMonth(Date), BoundaryType.Including));
	
	Query.Execute();
	
	NumberOfTTLinesFilter = TemporaryTableSize(Query.TempTablesManager, "TTFilter");
	// A query using VTFilter is efficient up to ~1.4 million rows per VTFilter.
	If NumberOfTTLinesFilter > 1400000 Then
		Query.Text = "DROP TTFilter";
		Query.Execute();
		Query.Text = QueryTextForOrganizationsCommunications();
	Else
		Query.Text = QueryTextOfOrganizationSCommunicationUsingTTFilter();
	EndIf;
	
	QueryResult = Query.Execute();

	// It is necessary to gather organizations that participated in resales or intercompany movements into groups.
	If Not QueryResult.IsEmpty() Then

		Selection = QueryResult.Select();
		While Selection.Next() Do

			GroupOfOrganizations_3    = FindOrganizationsInArrayOfGroups(Selection.Organization,    GroupsArray1);
			OrganizationSCorGroup = FindOrganizationsInArrayOfGroups(Selection.CorCompany, GroupsArray1);
			
			If GroupOfOrganizations_3 = Undefined And OrganizationSCorGroup = Undefined Then
				
				// there were no such organizations in the sample yet - we will add both organizations to the new group
				AddToArrayOfOrganizationGroups(Selection.Organization,    GroupsArray1, Undefined);
				AddToArrayOfOrganizationGroups(Selection.CorCompany, GroupsArray1, GroupsArray1.Count() - 1);
				
				TMCommonUseClientServer.AddNewValueToArray(RegisteredOrganizations, Selection.Organization);
				TMCommonUseClientServer.AddNewValueToArray(RegisteredOrganizations, Selection.CorCompany);
				
			ElsIf GroupOfOrganizations_3 <> Undefined And OrganizationSCorGroup <> Undefined Then
				
				// both organizations were already in the sample
				If GroupOfOrganizations_3 <> OrganizationSCorGroup Then
					// moving all organizations from the group of cor.organizations to the group of organizations
					MoveOrganizationGroupToAnotherGroup(GroupsArray1, GroupOfOrganizations_3, OrganizationSCorGroup);
				EndIf;
				
			Else
				// one of the organizations was not in the sample yet
				If GroupOfOrganizations_3 = Undefined Then
					// let's add the organization to the cor group. organizations
					AddToArrayOfOrganizationGroups(Selection.Organization,    GroupsArray1, OrganizationSCorGroup);
					
					TMCommonUseClientServer.AddNewValueToArray(RegisteredOrganizations, Selection.Organization);
				Else
					// add cor. organization to the organization group
					AddToArrayOfOrganizationGroups(Selection.CorCompany, GroupsArray1, GroupOfOrganizations_3);
					
					TMCommonUseClientServer.AddNewValueToArray(RegisteredOrganizations, Selection.CorCompany);
				EndIf;
				
			EndIf;

		EndDo;

	EndIf;

	// Let's add the rest of the organizations from the directory.
	Query = New Query;
	Query.Text =
	"SELECT
	|	Companies.Ref AS Organization
	|FROM
	|	Catalog.Companies AS Companies
	|WHERE
	|	NOT Companies.DeletionMark
	|	AND NOT Companies.Ref IN (&RegisteredOrganizations)
	|	AND CASE
	|			WHEN NOT &UseManagementCompany
	|					AND Companies.Ref = VALUE(Catalog.Companies.ManagementCompany)
	|				THEN FALSE
	|			ELSE TRUE
	|		END
	|
	|ORDER BY
	|	Companies.Predefined";
	
	Query.SetParameter("RegisteredOrganizations",        		   RegisteredOrganizations);
	Query.SetParameter("UseManagementCompany", GetFunctionalOption("UseManagementCompany"));
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		// A new group is an array with one element
		AddToArrayOfOrganizationGroups(Selection.Organization, GroupsArray1, Undefined); 
	EndDo;
	
	Return GroupsArray1;
	
EndFunction


Function FindOrganizationsInArrayOfGroups(Value, GroupsArray1)

	For GroupCounter = 0 To GroupsArray1.Count() - 1 Do
		If GroupsArray1[GroupCounter].Find(Value) <> Undefined Then
			Return GroupCounter;
		EndIf;
	EndDo;

	Return Undefined;

EndFunction

Procedure AddToArrayOfOrganizationGroups(Value, GroupsArray1, GroupPosition)

	If GroupPosition = Undefined Then
		GroupsArray1.Add(New Array);
		GroupPosition = GroupsArray1.Count() - 1;
	EndIf;

	TMCommonUseClientServer.AddNewValueToArray(GroupsArray1[GroupPosition], Value);

EndProcedure

Procedure MoveOrganizationGroupToAnotherGroup(GroupsArray1, PositionOfGroupWhere, GroupPositionFromWhere)

	For Each Value In GroupsArray1[GroupPositionFromWhere] Do
		TMCommonUseClientServer.AddNewValueToArray(GroupsArray1[PositionOfGroupWhere], Value);
	EndDo;

	GroupsArray1.Delete(GroupPositionFromWhere);

EndProcedure

