#Region TemporaryTable

#Region OperationsWithTemporaryTables

// Places data from the value table into a temp table with the ability to index.
//
// Parameters:
//   ContainerManagerTT - TempTablesManager - A container containing a temp table manager.
//   DestinationName - String - The name of the temp table where the data will be placed.
//   Table - ValueTable - The original table of values for the room.
//   TableFields - String - A comma-separated field listing string supports the "%1" template for substitution.
//   IndexingFields - Undefined - This parameter is optional.
//                      - String - Fields for indexing a temp table.
//                      - Array of String - Fields for indexing a temp table,
//                      each array value is a row of a set of comma-separated columns
//                      that require a separate index.
//
Procedure PutTableOfValuesInTemporaryTable(ContainerManagerTT, DestinationName, Table, TableFields,
	IndexingFields = Undefined) Export
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	Query.Text =
	"SELECT
	|	&Fields
	|INTO DestinationTableName
	|FROM
	|	&Table AS T
	|WHERE &Indexes";
	
	TableFieldText = TrimAll(StrReplace(TableFields, "%1", "
		|	T."));
		
	ValueTypeOfIndexingField = TypeOf(IndexingFields);
	If IndexingFields = Undefined Then
		IndexingFieldText = "";
	ElsIf ValueTypeOfIndexingField = Type("String") Then
		IndexingFieldText = ?(IndexingFields = "", "",
			"INDEX BY " + IndexingFields); //@Query-part
	ElsIf ValueTypeOfIndexingField = Type("Array") Then
		ArrayOfIndexSets = New Array;
		For Each Set In IndexingFields Do
			ArrayOfIndexSets.Add("(" + Set + ")");
		EndDo;
		IndexingFieldText = "
		|INDEX BY SETS
		|(
		|" + StrConcat(ArrayOfIndexSets, "," + Chars.LF) + "
		|)"; //@Query-part
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "&Fields",   	  		TableFieldText);
	Query.Text = StrReplace(Query.Text, "DestinationTableName", DestinationName);
	Query.Text = StrReplace(Query.Text, "WHERE &Indexes", 	  	IndexingFieldText);
	
	Query.SetParameter("Table", Table);
	
	ExecuteRequestWithMeasurementForProtocol(
		ContainerManagerTT,
		Query,,,,
		NStr("vi = 'Tạo bảng tạm từ bảng giá trị';
			|ru = 'Создание временной таблицы из таблицы значений';
			|en = 'Create a temporary table from a value table'; fa = 'Create a temporary table from a value table';
			|it = 'Creazione di una tabella temporanea dalla tabella dei valori';
			|pl = 'Tworzenie tabeli tymczasowej z tabeli wartości';
			|tr = 'Değer tablosundan geçici tablo oluşturma'", Common.DefaultLanguageCode()));
	
EndProcedure

// Adds a table of values to an existing temporary table
//
Procedure MergeValueTableAndTemporaryTable(ContainerManagerTT, DestinationName, Table, ValueTableFields, TableFields, TableResources, IndexingFields = "") Export
	
	InternalTableName = "TTTemporaryStorageForCombiningTKIVT";
	
	If ValueIsFilled(ValueTableFields) Then
		PutTableOfValuesInTemporaryTable(ContainerManagerTT, InternalTableName, Table, ValueTableFields, IndexingFields);
	Else
		PutTableOfValuesInTemporaryTable(ContainerManagerTT, InternalTableName, Table, GetColumnNamesAsString(Table), IndexingFields);
	EndIf;
	
	AddMissingTemporaryTableColumns(ContainerManagerTT, InternalTableName, DestinationName, IndexingFields);
	
	MergeTemporaryTables(ContainerManagerTT, InternalTableName, DestinationName, TableFields, TableResources, IndexingFields);
	
	DestroyTemporaryTables(ContainerManagerTT, InternalTableName);
	
EndProcedure

// Transfers data from multiple temporary tables to a single temporary table.
//
Procedure MergeTemporaryTables(ContainerManagerTT, SourceNames_, DestinationName, TableFields, TableResources, IndexingFields = "", DeleteSources = False) Export
	
	ArrayOfSources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(SourceNames_, ",",, True);
	
	NumberOfTablesInQuery = 254;
	NumberOfRequests_ 		 = ArrayOfSources.Count() / NumberOfTablesInQuery;
	NumberOfRequests_ 		 = Int(NumberOfRequests_) + ?(NumberOfRequests_ = Int(NumberOfRequests_), 0, 1);
	
	If NumberOfRequests_ = 0 Then
		Return;
	EndIf;
	
	InternalTableName = "TTTemporaryStorageForPoolingIntoTiTT";
	ReceiverExists   = TemporaryTableExists(ContainerManagerTT, DestinationName);
	
	If ValueIsFilled(TableFields) And StrFind(TableFields, "%") = 0 Then
		PrefixedTableFields = StrReplace(TableFields, " ", "");
		PrefixedTableFields = StrReplace(PrefixedTableFields, "	", "");
		PrefixedTableFields = StrReplace(PrefixedTableFields, Chars.LF, "");
		PrefixedTableFields = "%1" + StrReplace(PrefixedTableFields, ",", ",%1");
	Else
		PrefixedTableFields = TableFields;
	EndIf;
	
	If ValueIsFilled(TableResources) And StrFind(TableResources, "%") = 0 Then
		PrefixedTableResources = StrReplace(TableResources, " ", "");
		PrefixedTableResources = StrReplace(PrefixedTableResources, "	", "");
		PrefixedTableResources = StrReplace(PrefixedTableResources, Chars.LF, "");
		PrefixedTableResources = "%1" + StrReplace(PrefixedTableResources, ",", ",%1");
	Else
		PrefixedTableResources = TableResources;
	EndIf;
	
	// Templates
	TableFieldText = TrimAll(StrReplace(PrefixedTableFields, "%1", "
		|	T."));
	IndexingFieldText = ?(IndexingFields = "", "", "INDEX BY " + IndexingFields);
	
	TextGroupedFields   = "";
	TextSelectionOfNonEmptyResources = "";
	TextFieldGrouping 	   = "";
	
	FieldArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(PrefixedTableFields, "%1", "T."),
		",",
		True,
		True);
	ArrayOfResources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(PrefixedTableResources, "%1", "T."),
		",",
		True,
		True);
	
	For Each CurrentField In FieldArray Do
		
		If ArrayOfResources.Find(CurrentField) <> Undefined Then
			
			// Resource
			TextGroupedFields = TextGroupedFields 
				+ ?(TextGroupedFields = "", "", ",
				|	") + "SUM(" + CurrentField + ")";
				
			TextSelectionOfNonEmptyResources = TextSelectionOfNonEmptyResources 
				+ ?(TextSelectionOfNonEmptyResources = "", "", "
				|	OR ") + "SUM(" + CurrentField + ") <> 0";
			
		Else
			
			// Measurement or props
			TextGroupedFields = TextGroupedFields 
				+ ?(TextGroupedFields = "", "", ",
				|	") + CurrentField;
			
			If ArrayOfResources.Count() > 0 Then
				TextFieldGrouping = TextFieldGrouping 
					+ ?(TextFieldGrouping = "", "", ",
					|	") + CurrentField;
			EndIf;
			
		EndIf;
			
	EndDo;
	
	TextFieldGrouping =  
		?(TextFieldGrouping = "", "", "GROUP BY
		|	") + TextFieldGrouping;
	TextSelectionOfNonEmptyResources =  
		?(TextSelectionOfNonEmptyResources = "", "", "HAVING
		|	") + TextSelectionOfNonEmptyResources;
	
	QueryTemplate =
	"SELECT
	|	&GroupedFields
	|INTO DestinationTableName
	|FROM
	|	TTTableJoins AS T
	|WHERE &FieldsGrouping
	|
	|AND &SelectingNonEmptyResources
	|
	|AND &Indexes
	|";
	QueryTemplate = StrReplace(QueryTemplate, "&GroupedFields", 	   TextGroupedFields);
	QueryTemplate = StrReplace(QueryTemplate, "WHERE &FieldsGrouping",    TextFieldGrouping);
	QueryTemplate = StrReplace(QueryTemplate, "AND &SelectingNonEmptyResources", TextSelectionOfNonEmptyResources);
	
	PoolingRequestTemplateEx =
	"SELECT
	|	&Fields
	|INTO TTTableJoins
	|FROM
	|	SourceTableName AS T
	|";
	PoolingRequestTemplateEx = StrReplace(PoolingRequestTemplateEx, "&Fields", TableFieldText); // @query-part-1
	
	// The records of the final time table are collapsed for all dimensions and register details (all fields that are not resources).
	// Records with all empty resources are not placed in the final temporary table.
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	For QueryNumber = 1 To NumberOfRequests_ Do
		
		QueryText = "";
		TextDeletedTables = "TTTableJoins";
		MergeQueryTemplate = PoolingRequestTemplateEx;
		
		If QueryNumber = 1 And ReceiverExists Then
			IntermediateTableName = DestinationName;
		ElsIf QueryNumber > 1 Then
			IntermediateTableName = InternalTableName + Format(QueryNumber - 1, "NG=");
		Else
			IntermediateTableName = "";
		EndIf;
		
		If ValueIsFilled(IntermediateTableName) Then
			QueryText = StrReplace(MergeQueryTemplate, "SourceTableName", IntermediateTableName); // @query-part-1
			TextDeletedTables = TextDeletedTables + ", " + IntermediateTableName;
			MergeQueryTemplate = StrReplace(MergeQueryTemplate, "INTO TTTableJoins", ""); // @query-part-1
		EndIf;
		
		TableNamesForProtocol = "";
		
		For TableNumber = 1 To NumberOfTablesInQuery Do
			
			If ArrayOfSources.Count() = 0 Then
				Break;
			EndIf;
			
			If QueryText = "" Then
				QueryText = StrReplace(MergeQueryTemplate, "SourceTableName", ArrayOfSources[0]);
				MergeQueryTemplate = StrReplace(MergeQueryTemplate, "INTO TTTableJoins", ""); // @query-part-1
			Else
				QueryText = QueryText + "
					|UNION ALL
					|" + StrReplace(MergeQueryTemplate, "SourceTableName", ArrayOfSources[0]); // @query-part-1
			EndIf;
			
			TableNamesForProtocol = TableNamesForProtocol + ?(TableNamesForProtocol = "", "", ",") + ArrayOfSources[0];
			
			If DeleteSources Then
				TextDeletedTables = TextDeletedTables + ?(TextDeletedTables = "", "", ",") + ArrayOfSources[0];
			EndIf;
			
			ArrayOfSources.Delete(0);
			
		EndDo;
		
		If QueryNumber < NumberOfRequests_ Or ReceiverExists Then
			IntermediateTableName = InternalTableName + Format(QueryNumber, "NG=");
		Else
			IntermediateTableName = DestinationName;
		EndIf;
		
		If TextGroupedFields = "" Then
			// There is no grouping, there is no point in creating an intermediate temp table.
			QueryText = MergeQueryTemplate + "
				|AND &Indexes"; // @query-part-1
			QueryText = StrReplace(QueryText, "TTTableJoins", IntermediateTableName); // @query-part-1
		Else
			// There is a grouping, an intermediate temp table of the union is being created, which we will group.
			QueryText = QueryText + ";
				|" + QueryTemplate;
			QueryText = StrReplace(QueryText, "DestinationTableName", IntermediateTableName); // @query-part-1
		EndIf;
		
		If QueryNumber = NumberOfRequests_ And IntermediateTableName = DestinationName Then
			QueryText = StrReplace(QueryText, "AND &Indexes", IndexingFieldText);
		Else
			QueryText = StrReplace(QueryText, "AND &Indexes", "");
		EndIf;
		
		Query.Text = QueryText;
		
		ExecuteRequestWithMeasurementForProtocol(
			ContainerManagerTT,
			Query,,
			TableNamesForProtocol,,
			NStr("vi = 'Hợp nhất các bảng tạm';
				|ru = 'Объединение временных таблиц';
				|en = 'Merge temporary tables'; fa = 'Merge temporary tables';
				|it = 'Unione delle tabelle temporanee';
				|pl = 'Scalenie tabel tymczasowych';
				|tr = 'Geçici tabloları birleştirme'", Common.DefaultLanguageCode()));
		
		DestroyTemporaryTables(ContainerManagerTT, TextDeletedTables);
		ReceiverExists = False;
		
		If QueryNumber = NumberOfRequests_ And IntermediateTableName <> DestinationName Then
			
			// It is necessary to transfer the data from the name of the intermediate table to the name of the receiver
			Query.Text =
			"SELECT
			|	&Fields
			|INTO DestinationTableName
			|FROM
			|	SourceTableName AS T
			|
			|WHERE &Indexes
			|";
			
			Query.Text = StrReplace(Query.Text, "&Fields", 		  		TableFieldText);
			Query.Text = StrReplace(Query.Text, "DestinationTableName", DestinationName);
			Query.Text = StrReplace(Query.Text, "SourceTableName", IntermediateTableName);
			Query.Text = StrReplace(Query.Text, "WHERE &Indexes", 	    IndexingFieldText);
			
			ExecuteRequestWithMeasurementForProtocol(
				ContainerManagerTT,
				Query,,
				IntermediateTableName + "," + DestinationName,,
				NStr("vi = 'Hợp nhất các bảng tạm';
					|ru = 'Объединение временных таблиц';
					|en = 'Merge temporary tables'; fa = 'Merge temporary tables';
					|it = 'Unione delle tabelle temporanee';
					|pl = 'Scalenie tabel tymczasowych';
					|tr = 'Geçici tabloları birleştirme'", Common.DefaultLanguageCode()));
			
			DestroyTemporaryTables(Query, IntermediateTableName);
			
		EndIf;
		
	EndDo;
	
EndProcedure

// Returns the composition of the columns of the temporary table.
//
// Returns:
//	String, ValueTableColumnCollection -
//
Function TemporaryTableColumns(ContainerManagerTT, TableName, ReturnAsString = True) Export
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	QueryTextTemplate2 =
	"SELECT TOP 0
	|	*
	|FROM
	|	TableName AS T";
	
	Query.Text = StrReplace(QueryTextTemplate2, "TableName", TableName);
	TableColumns1 = Query.Execute().Columns;
	
	If Not ReturnAsString Then
		Return TableColumns1;
	EndIf;
	
	ColumnsByRow = "";
	
	For Each CurrentColumn In TableColumns1 Do
		ColumnsByRow = ColumnsByRow + ?(ColumnsByRow = "", "", ", ") + "%1" + CurrentColumn.Name;
	EndDo;
	
	Return ColumnsByRow;
	
EndFunction

// Adds missing columns to the temporary table.
//
Procedure AddMissingTemporaryTableColumns(ContainerManagerTT, TableName, SampleName, IndexingFields = "") Export
	
	InternalTableName = "TTTemporaryStorageForAddingTTSpeakers";
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	// Let's make a list of columns that are in the sample table, but are not in the table itself.
	TableColumns1 = TemporaryTableColumns(ContainerManagerTT, TableName, False);
	SampleColumns = TemporaryTableColumns(ContainerManagerTT, SampleName, False);
	
	NewColumns = New Structure; // The column name is an empty value of the corresponding type
	
	For Each CurrentColumn In SampleColumns Do
		
		If TableColumns1.Find(CurrentColumn.Name) <> Undefined Then
			Continue;
		EndIf;
		
		ColumnValueType = CostCalculationUniversalAlgorithms.NonNullTypeDescriptions(CurrentColumn.ValueType);
		
		NewColumns.Insert(CurrentColumn.Name, ColumnValueType.AdjustValue(Undefined));
		
	EndDo;
	
	If NewColumns.Count() = 0 Then
		Return; // the table has all the columns present in the sample table
	EndIf;
	
	// Let's make a list of fields for the request text.
	TableFieldText = "";
	ParametersCount = 0;
	
	For Each CurrentColumn In TableColumns1 Do
		TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",
			|	") + "T." + CurrentColumn.Name + " AS " + CurrentColumn.Name;
	EndDo;
	
	TableFieldTextAugmented = TableFieldText;
	
	For Each CurrentColumn In NewColumns Do
		
		ParametersCount = ParametersCount + 1;
		ParameterName = "ValueOfNewField" + Format(ParametersCount, "NZ=0; NG=");
		
		Query.SetParameter(ParameterName, CurrentColumn.Value);
		
		TableFieldTextAugmented = TableFieldTextAugmented + ?(TableFieldTextAugmented = "", "", ",
			|	") + "&" + ParameterName + " AS " + CurrentColumn.Key;
		
	EndDo;
	
	IndexingFieldText = ?(IndexingFields = "", "", "INDEX BY " + IndexingFields);
	
	// Execute a query that gets the original table with the full list of fields.
	QueryTextTemplate2 =
	"SELECT
	|	Parameter3
	|INTO Parameter2
	|FROM
	|	Parameter1 AS T
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Parameter1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Parameter4
	|INTO Parameter1
	|FROM
	|	Parameter2 AS T
	|WHERE TRUE
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP Parameter2";
	
	QueryTextTemplate2 = StrReplace(QueryTextTemplate2, "Parameter", "%");
	
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(
		QueryTextTemplate2,
		TableName,
		InternalTableName,
		TableFieldText,
		TableFieldTextAugmented);
	
	Query.Text = StrReplace(Query.Text, "WHERE TRUE", IndexingFieldText);
	
	ExecuteRequestWithMeasurementForProtocol(
		ContainerManagerTT,
		Query,,,,
		NStr("vi = 'Thêm các cột của bảng tạm';
			|ru = 'Добавление колонок временной таблицы';
			|en = 'Add temporary table columns'; fa = 'Add temporary table columns';
			|it = 'Aggiunta di colonne della tabella temporanea';
			|pl = 'Dodawanie kolumna tabeli tymczasowej';
			|tr = 'Geçici tabloya sütun ekleme'", Common.DefaultLanguageCode()));
	
EndProcedure

// Deletes all records from the temporary table, but all its fields remain unchanged.
//
Procedure ClearTemporaryTable(ContainerManagerTT, TableName) Export
	
	InternalTableName = "TTTemporaryStorageForCleaningTT";
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	Query.Text =
	"SELECT TOP 0
	|	T.*
	|INTO Parameter2
	|FROM
	|	Parameter1 AS T
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|DROP Parameter1
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.*
	|INTO Parameter1
	|FROM
	|	Parameter2 AS T
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|DROP Parameter2";
	
	Query.Text = StrReplace(Query.Text, "Parameter", "%");
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(
		Query.Text,
		TableName,
		InternalTableName);
	
	Query.Execute();
	
EndProcedure

// Copies all records from the temporary table to the new temporary table.
//
Procedure CopyTemporaryTable(ContainerManagerTT, SourceName, DestinationName, IndexingFields = "") Export
	
	DestroyTemporaryTables(ContainerManagerTT, DestinationName);
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	SourceColumns = TemporaryTableColumns(ContainerManagerTT, SourceName, True);
	
	Query.Text =
	"SELECT
	|	&Fields
	|INTO DestinationTableName
	|FROM
	|	SourceTableName AS T
	|WHERE &Indexes";
	
	TableFieldText = TrimAll(StrReplace(SourceColumns, "%1", "
		|	T."));
	IndexingFieldText = ?(IndexingFields = "", "", "INDEX BY " + IndexingFields);
	
	Query.Text = StrReplace(Query.Text, "&Fields",   	  		TableFieldText);
	Query.Text = StrReplace(Query.Text, "DestinationTableName", DestinationName);
	Query.Text = StrReplace(Query.Text, "SourceTableName", SourceName);
	Query.Text = StrReplace(Query.Text, "WHERE &Indexes", 	  	IndexingFieldText);
	
	ExecuteRequestWithMeasurementForProtocol(
		ContainerManagerTT,
		Query,,,,
		NStr("vi = 'Sao chép bảng tạm';
			|ru = 'Копирование временной таблицы';
			|en = 'Copy a temporary table'; fa = 'Copy a temporary table';
			|it = 'Copia della tabella temporanea';
			|pl = 'Kopiowanie tabeli tymczasowej';
			|tr = 'Geçici tablonun kopyalanması'", Common.DefaultLanguageCode()));
	
EndProcedure

// Destroys the specified temporary tables
//
Procedure DestroyTemporaryTables(ContainerManagerTT, TablesNames) Export
	
	If Not ValueIsFilled(TablesNames) Then
		Return; // so that you don't have to do table name checks when calling this procedure
	EndIf;
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	TableStructure = New Structure(TablesNames);
	QueryText 	= "";
	
	For Each KeyAndValue In TableStructure Do
		
		If Not TemporaryTableExists(Query.TempTablesManager, KeyAndValue.Key) Then
			Continue; // so that you don't have to do table name checks when calling this procedure
		EndIf;
		
		QueryText = QueryText 
			+ ?(QueryText = "", "", "
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|
			|") + "DROP " + KeyAndValue.Key;
		
	EndDo;
	
	If ValueIsFilled(QueryText) Then
		Query.Text = QueryText;
		Query.Execute();
	EndIf;
	
EndProcedure

// Checks for the existence of a temporary table with the specified name.
//
// Returns:
//	Boolean -
//
Function TemporaryTableExists(ContainerManagerTT, TempTableName) Export
	
	TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	Return TempTablesManager.Tables.Find(TempTableName) <> Undefined;
	
EndFunction

// Checks for the existence of a temporary table column with the specified name.
//
// Returns:
//	Boolean -
//
Function TemporaryTableColumnExists(ContainerManagerTT, TempTableName, ColumnName) Export
	
	TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	TempTable = TempTablesManager.Tables.Find(TempTableName);
	If TempTable = Undefined Then
		Return False;
	EndIf;
	
	Return (TempTable.Columns.Find(ColumnName) <> Undefined);
	
EndFunction

// Returns a list of stored temporary tables.
//
// Returns:
//	String -
//
Function GetListOfExistingTemporaryTables(ContainerManagerTT, ExcludeTables = "") Export
	
	TempTablesManager    = GetTTManagerFromContainer(ContainerManagerTT);
	StructureOfExcludedTables = New Structure(ExcludeTables);
	Tables 				   = "";
	
	For Each TempTable In TempTablesManager.Tables Do
		If Not StructureOfExcludedTables.Property(TempTable.FullName) Then
			Tables = Tables + ?(Tables = "", "", ", ") + TempTable.FullName;
		EndIf;
	EndDo;
	
	Return Tables;
	
EndFunction

// Retrieves the temporary table Manager from the passed data source container.
//
// Returns:
//	TempTablesManager -
//
Function GetTTManagerFromContainer(ContainerManagerTT) Export
	
	If TypeOf(ContainerManagerTT) = Type("TempTablesManager") Then
		TempTablesManager = ContainerManagerTT;
	Else // the manager is stored in the structure or query property of the same name
		TempTablesManager = ContainerManagerTT.TempTablesManager;
	EndIf;
	
	Return TempTablesManager;
	
EndFunction

Function TableNameOfNextChunkOfData(TableName, TableDetails)
	
	TableDetails.NumberOfDataChunks = TableDetails.NumberOfDataChunks + 1;
	PortionTableName = TableName + "_" + "Batch" + Format(TableDetails.NumberOfDataChunks, "NG=");
	
	TableDetails.PortionTableNames = TableDetails.PortionTableNames
		+ ?(TableDetails.PortionTableNames = "", "", ",") + PortionTableName;
		
	Return PortionTableName;
	
EndFunction

