#Region SolutionOfSLU

Function InitializeParametersForLoadingSLUSolution(SolutionColumnNames, AdditionalColumns = Undefined, TempTableName = "DecisionTable") Export
	
	SLULoadingParameters = New Structure;
	SLULoadingParameters.Insert("ColumnNameNodeNumber", "NodeNumber");
	SLULoadingParameters.Insert("TempTableName", TempTableName);
	SLULoadingParameters.Insert("SolutionColumnNames",
		StringFunctionsClientServer.SplitStringIntoSubstringsArray(SolutionColumnNames, ",",, True));
	SLULoadingParameters.Insert("AdditionalColumns",
		?(ValueIsFilled(AdditionalColumns), AdditionalColumns, New Structure));
	SLULoadingParameters.Insert("NumberOfDigits", 28);
	SLULoadingParameters.Insert("NumberOfDigitsAfterTheDecimalPoint", 10);
	SLULoadingParameters.Insert("ConsiderZeroSolutions", True);
	
	Return SLULoadingParameters;
	
EndFunction

// Load the SLU solution into a temporary table.
// 
// Parameters:
//  CalculationParameters -Structure - Calculation parameters
//  SLULoadingParameters -Structure - Parameters for loading the service
//  DecisionTable - ValueTable - Table of solutions
//  ExplanationForMeasurement - String - Explanation for measurement
Procedure LoadSLUSolutionIntoTemporaryTable(CalculationParameters, SLULoadingParameters, DecisionTable, ExplanationForMeasurement) Export
	
	SelectionFieldText = "T.NodeNumber AS " + SLULoadingParameters.ColumnNameNodeNumber;
	TextNumberFormat = "NUMBER(" + Format(SLULoadingParameters.NumberOfDigits, "NZ=0; NG=")
		+ "," + Format(SLULoadingParameters.NumberOfDigitsAfterTheDecimalPoint, "NZ=0; NG=") + ")";
	TextConditionWHERE = "";
		
	SolutionNumber = 0;
	SolutionColumnName = Left(DecisionTable.Columns[1].Name, StrLen(DecisionTable.Columns[1].Name) - 1);
	SolutionColumns = New Structure;
	
	For Each SolutionFieldName In SLULoadingParameters.SolutionColumnNames Do
		
		SolutionNumber = SolutionNumber + 1;
		SelectionFieldText = SelectionFieldText + ",
			|	CAST(
			|		(CASE WHEN VALUETYPE(T." + SolutionColumnName + Format(SolutionNumber, "NZ=0; NG=") + ") = TYPE(NUMBER)
			|		THEN T." + SolutionColumnName + Format(SolutionNumber, "NZ=0; NG=") + " ELSE 0 END)
			|	AS " + TextNumberFormat + ") AS " + SolutionFieldName;
			
		If Not SLULoadingParameters.ConsiderZeroSolutions Then
			TextConditionWHERE = TextConditionWHERE + ?(TextConditionWHERE = "", "	", "
				|	OR ") + "T." + SolutionColumnName + Format(SolutionNumber, "NZ=0; NG=") + " <> 0
				|	AND T." + SolutionColumnName + Format(SolutionNumber, "NZ=0; NG=") + " <> UNDEFINED";
		EndIf;
		
		SolutionColumns.Insert(SolutionColumnName + Format(SolutionNumber, "NZ=0; NG="), SolutionFieldName);
		
	EndDo;
	
	For Each KeyAndValue In SLULoadingParameters.AdditionalColumns Do
		
		SelectionFieldText = SelectionFieldText + ",
			|	" + TrimAll(KeyAndValue.Value) + " AS " + TrimAll(KeyAndValue.Key);
		
	EndDo;
		
	FieldOverflowProtection = Pow(10, CalculationParameters.SolutionOfSLU.FieldOverflowProtection) - 1;
	
	If Not CalculationParameters.Property("NodesWithFieldOverflow") Then
		NodesWithFieldOverflow = New Array;
	Else
		NodesWithFieldOverflow = CalculationParameters.NodesWithFieldOverflow;
	EndIf;
	
	// Let's check the results of the solution of the SLA for exceeding the value of the protection of the field
	If FieldOverflowProtection <> 0 Then
		For Each CurrRow In DecisionTable Do
			For Each KeyAndValue In SolutionColumns Do
				
				If CurrRow[KeyAndValue.Key] > FieldOverflowProtection Or CurrRow[KeyAndValue.Key] < -FieldOverflowProtection Then
					CurrRow[KeyAndValue.Key] = 0;
					TMCommonUseClientServer.AddNewValueToArray(NodesWithFieldOverflow,	CurrRow[SLULoadingParameters.ColumnNameNodeNumber]);
				EndIf;
				
			EndDo;
		EndDo;
	EndIf;
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT
	|	&SelectionFields1
	|INTO TempTableName
	|FROM
	|	&DecisionTable AS T
	|WHERE
	|	&ConditionWHERE";
	
	Query.Text = StrReplace(Query.Text, "NodeNumber", SLULoadingParameters.ColumnNameNodeNumber);
	Query.Text = StrReplace(Query.Text, "TempTableName", SLULoadingParameters.TempTableName);
	Query.Text = StrReplace(Query.Text, "&SelectionFields1", SelectionFieldText);
	Query.Text = StrReplace(Query.Text, "&ConditionWHERE", ?(TextConditionWHERE = "", "TRUE", TextConditionWHERE));
	
	Query.Text = Query.Text + "
	|INDEX BY
	|	" + SLULoadingParameters.ColumnNameNodeNumber;
	
	Query.SetParameter("DecisionTable", DecisionTable);
	DestroyTemporaryTables(CalculationParameters, SLULoadingParameters.TempTableName);
	
	Try
		
		CalculationParameters.Insert("DoNotFixCalculationError"); // there is no need to fix the error, we will try to fix it.
		
		ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
		
	Except
		
		CalculationParameters.Delete("DoNotFixCalculationError");
		
		CostCalculationProtocol.StartOfCodeSnippetExecution(CalculationParameters, "ReducingBitDepthOfSLUSolution", ExplanationForMeasurement);
		
		// An overflow error occurred when converting the value due to the excess of the digit number.
		NumberOfSolutions = SLULoadingParameters.SolutionColumnNames.Count();
		LimitingNumber = Pow(10, SLULoadingParameters.NumberOfDigits - SLULoadingParameters.NumberOfDigitsAfterTheDecimalPoint - 1);
		MaxValue = Pow(10, SLULoadingParameters.NumberOfDigits);
		
		ColumnsNames = New Array;
		
		For SolutionNumber = 1 To NumberOfSolutions Do
			ColumnsNames.Add(SolutionColumnName + Format(SolutionNumber, "NZ=0; NG="));
		EndDo;
		
		ErrorsCount = 0;
		
		For Each CurrRow In DecisionTable Do
			
			For SolutionNumber = 0 To NumberOfSolutions-1 Do
				
				If CurrRow[ColumnsNames[SolutionNumber]] = 0 Then
					
					Continue;
					
				ElsIf CurrRow[ColumnsNames[SolutionNumber]] >= LimitingNumber Or CurrRow[ColumnsNames[SolutionNumber]] <= -LimitingNumber Then
					
					// Discard solutions that exceed the allowed field size.
					CurrRow[ColumnsNames[SolutionNumber]] = 0;
					NodesWithFieldOverflow.Add(CurrRow.NodeNumber);
					ErrorsCount = ErrorsCount + 1;
					
				Else
					
					// We bring the bit depth of the integer and fractional parts to the required bit depth of the field.
					DigitsCount = Int(Log10(MaxValue/?(CurrRow[ColumnsNames[SolutionNumber]] > 0, CurrRow[ColumnsNames[SolutionNumber]], -CurrRow[ColumnsNames[SolutionNumber]]))) - 3;
					CurrRow[ColumnsNames[SolutionNumber]] = Round(CurrRow[ColumnsNames[SolutionNumber]], DigitsCount);
					
				EndIf;
				
			EndDo;
				
		EndDo;
		
		CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
		
		Query.SetParameter("DecisionTable", DecisionTable);
		
		ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đã chẩn đoán lỗi (%1) điền lại trường kết quả giải pháp hệ phương trình tuyến tính (%2)';
				|ru = 'Диагностированы ошибки (%1 шт.) переполнение поля результата решения СЛУ (%2)';
				|en = 'Errors were found (%1) result field overflow of the LES solution (%2)'; fa = 'Errors were found (%1) result field overflow of the LES solution (%2)';
				|it = 'Sono stati rilevati degli errori (%1 pz.) di ricompilazione del campo di risultato della soluzione SLE (%2)';
				|pl = 'Zdiagnozowano błędy (%1 szt.) przepełnienie pola wyniku URL (%2)';
				|tr = 'Teşhis edilen hatalar (%1 adet) DDS çözümünün sonuç alanının fazlasıyla doldurulması (%2)'"),
			TrimAll(ErrorsCount),
			ExplanationForMeasurement);
		
		CostCalculationProtocol.AdditionalInformation(CalculationParameters, ProtocolText_);
		
	EndTry;
	
	CalculationParameters.Delete("DoNotFixCalculationError");
	CalculationParameters.Insert("NodesWithFieldOverflow", NodesWithFieldOverflow);
	
	If Not CheckCorrectnessOfDecisionSLE() Then
		Return;
	EndIf;
	
	// Let's check the result of the solution SLE - if there are fields with non-zero sums in the source data, then there must be non-zero sums in the solutions.
	SLEFields = New Structure;
	QueriesTexts = New Array;
	QueryTemplate =
	"SELECT TOP 1
	|	&FieldName AS CostField
	|FROM
	|	NameOfSolutionTable AS T
	|WHERE
	|	T.FieldName <> 0";
	
	For Each SolutionFieldName In SLULoadingParameters.SolutionColumnNames Do
		
		If Not CalculationParameters.SLEFields.Property(SolutionFieldName) Then
			Continue;
		EndIf;
		
		QueryText = StrReplace(QueryTemplate, "&FieldName", """" + SolutionFieldName + """");
		QueryText = StrReplace(QueryText, "FieldName", SolutionFieldName);
		QueryText = StrReplace(QueryText, "NameOfSolutionTable", SLULoadingParameters.TempTableName);
		
		QueriesTexts.Add(QueryText);
		SLEFields.Insert(SolutionFieldName);
		
	EndDo;
	
	If QueriesTexts.Count() > 0 Then
		
		Query.Text = StrConcat(QueriesTexts, TMCommonUse.QuerySeparatorInJoin());
		
		Selection = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True,,, ExplanationForMeasurement);
		
		While Selection.Next() Do
			SLEFields.Delete(Selection.CostField);
		EndDo;
		
		For Each KeyAndValue In SLEFields Do
			
			ErrorText = NStr("vi = 'Giai đoạn';
							|ru = 'Этап';
							|en = 'Stage'; fa = 'مرحله';
							|it = 'Stage';
							|pl = 'Stage';
							|tr = 'Aşama'") + ": " + CalculationParameters.PresentationStage + ", " + ExplanationForMeasurement + ", "
				+ NStr("vi = 'trường giá trị';
						|ru = 'поле стоимости';
						|en = 'cost field'; fa = 'cost field';
						|it = 'cost field';
						|pl = 'cost field';
						|tr = 'maliyet alanı'") + ": " + KeyAndValue.Key;
			
			RegisterCalculationExecutionProblem(
				CalculationParameters,
				,
				NStr("vi = 'Khi giải phương trình tuyến tính, đã nhận một nghiệm bằng không với dữ liệu ban đầu khác không';
					|ru = 'При решении СЛУ получено нулевое решение при ненулевых исходных данных';
					|en = 'When solving the linear equation system, a zero solution is obtained with non-zero initial data'; fa = 'When solving the linear equation system, a zero solution is obtained with non-zero initial data';
					|it = 'When solving the linear equation system, a zero solution is obtained with non-zero initial data';
					|pl = 'When solving the linear equation system, a zero solution is obtained with non-zero initial data';
					|tr = 'DDS çözümü esasında sıfır olmayan başlangıç verilerinde boş çözüm sonucu alındı.'"),
				ErrorText);
			
		EndDo;
		
	EndIf;
	
EndProcedure

Function SolveSystemOfLinearEquations(CalculationParameters, SystemOfLinearEquationsCalculation) Export
	
	If Not CalculationParameters.UsePlatformToSolveSLU
	 And CalculationParameters.Property("IterativeCalculationSLE")
	 And CalculationParameters.IterativeCalculationSLE Then
		DecisionTable = SolveSLE(CalculationParameters);
		CalculationParameters.IterativeCalculationSLE = False;
	ElsIf CalculationParameters.DisableGraphReduction Then
		DecisionTable = SystemOfLinearEquationsCalculation.SolveSystemOfLinearEquations(False);
	Else
		// In the platform below version 8.3.17, this method had no parameters.
		DecisionTable = SystemOfLinearEquationsCalculation.SolveSystemOfLinearEquations();
	EndIf;
	
	Return DecisionTable;

	
EndFunction

Function SolveSLE(CalculationParameters)
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters); 
	
	#Region InitializationOfSourceTables
	
	Query.Text = "
	// Free coefficients are taken as the solution vector at the first iteration.
	|SELECT
	|	AdjustmentNodes.NodeNumber                             AS NodeNumber,
	|	CAST(AdjustmentNodes.Cost1 AS NUMBER(28,10)) AS Decision1,
	|	CAST(AdjustmentNodes.Cost2 AS NUMBER(28,10)) AS Decision2,
	|	1 AS Character1,
	|	1 AS Character2
	|
	|INTO TTTableOfSolutions
	|FROM
	|	NodeTableName AS AdjustmentNodes 
	|INDEX BY
	|	NodeNumber
	|;
	|SELECT TOP 9999999999999
	|	AdjustmentNodes.NodeNumber  AS NodeNumber,
	|	CAST(CASE WHEN Links.ArcWeight1 <> 0
	|		THEN CAST(AdjustmentNodes.Cost1 AS NUMBER(28,10)) / Links.ArcWeight1
	|		ELSE 0 END AS NUMBER(28,10)) AS Sum1,
	|	CAST(CASE WHEN Links.ArcWeight2 <> 0
	|		THEN CAST(AdjustmentNodes.Cost2 AS NUMBER(28,10)) / Links.ArcWeight2
	|		ELSE 0 END AS NUMBER(28,10)) AS Sum2,
	|	1 AS Character1,
	|	1 AS Character2,
	|
	|	Links.ArcWeight1 AS Weight1,
	|	Links.ArcWeight2 AS Weight2
	|
	|INTO AdjustmentNodes
	|FROM
	|	NodeTableName AS AdjustmentNodes
	|	INNER JOIN RelationshipTableName AS Links
	|		ON Links.SourceNodeNumber = AdjustmentNodes.NodeNumber
	|		AND Links.SourceNodeNumber = Links.ReceiverNodeNumber
	|
	|ORDER BY
	|	NodeNumber
	|
	|INDEX BY
	|	NodeNumber
	|;
	|SELECT TOP 9999999999999
	|	Links.SourceNodeNumber AS SourceNodeNumber,
	|	Links.ReceiverNodeNumber AS ReceiverNodeNumber,
	|
	|	-Links.ArcWeight1 AS Weight1,
	|	-Links.ArcWeight2 AS Weight2
	|
	|INTO WriteOffMovements
	|FROM
	|	RelationshipTableName AS Links
	|WHERE
	|	Links.SourceNodeNumber <> Links.ReceiverNodeNumber
	|
	|ORDER BY
	|	SourceNodeNumber
	|
	|INDEX BY
	|	ReceiverNodeNumber
	|";
	For Each ColumnName In CalculationParameters.CostColumnNames Do
		Query.Text = StrReplace(Query.Text, ColumnName.Key, ColumnName.Value);
	EndDo;
	For Each ColumnName In CalculationParameters.NamesOfBalanceColumns Do
		Query.Text = StrReplace(Query.Text, ColumnName.Key, ColumnName.Value);
	EndDo;
	Query.Text = StrReplace(Query.Text, "NodeTableName", CalculationParameters.NodeTableName);  
	Query.Text = StrReplace(Query.Text, "RelationshipTableName", CalculationParameters.RelationshipTableName);
	Query.Text = CostCalculationCostAdjustment.SetBitDepthOfNumbersInRequestText(CalculationParameters, Query.Text);
	CostCalculationAppliedAlgorithms.ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	#EndRegion
	
	IterationCounter   = 1;
	CurrentDeviation = 1;
	
	DecisionTableSize = CostCalculationAppliedAlgorithms.TemporaryTableSize(CalculationParameters, "TTTableOfSolutions");
	
	Query.Text = "
	// 0 Calculation of the coefficients (the number of transitions from the State to the State) of the equation.
	|SELECT
	|	AdjustmentNodes.NodeNumber                                      AS NodeNumber,
	|
	|	CAST(SUM(
	|		CASE
	|			WHEN &FieldOverflowProtection > 0 AND ISNULL(TTTableOfSolutions.Decision1, 0)
	|				* ISNULL(WriteOffMovements.Weight1, 0) > &FieldOverflowProtection 
	|				THEN 0
	|			WHEN &FieldOverflowProtection > 0 AND ISNULL(TTTableOfSolutions.Decision1, 0)
	|				* ISNULL(WriteOffMovements.Weight1, 0) < -&FieldOverflowProtection 
	|				THEN 0
	|			ELSE CAST(ISNULL(TTTableOfSolutions.Decision1, 0) * ISNULL(TTTableOfSolutions.Character1, 0) AS NUMBER(28,10))
	|				* CAST(ISNULL(WriteOffMovements.Weight1, 0) AS NUMBER(28,10))
	|			END) AS NUMBER(28,10)) AS Decision1,
	|	CAST(SUM(
	|		CASE
	|			WHEN &FieldOverflowProtection > 0 AND ISNULL(TTTableOfSolutions.Decision2, 0)
	|				* ISNULL(WriteOffMovements.Weight2, 0) > &FieldOverflowProtection 
	|				THEN 0
	|			WHEN &FieldOverflowProtection > 0 AND ISNULL(TTTableOfSolutions.Decision2, 0)
	|				* ISNULL(WriteOffMovements.Weight2, 0) < -&FieldOverflowProtection 
	|				THEN 0
	|			ELSE CAST(ISNULL(TTTableOfSolutions.Decision2, 0) * ISNULL(TTTableOfSolutions.Character2, 0) AS NUMBER(28,10))
	|				* CAST(ISNULL(WriteOffMovements.Weight2, 0) AS NUMBER(28,10))
	|			END) AS NUMBER(28,10)) AS Decision2
	|
	|INTO TempTableOfSolutions
	|FROM
	|	AdjustmentNodes AS AdjustmentNodes
	|
	|	LEFT JOIN WriteOffMovements AS WriteOffMovements
	|		ON AdjustmentNodes.NodeNumber = WriteOffMovements.ReceiverNodeNumber
	|
	|	LEFT JOIN TTTableOfSolutions AS TTTableOfSolutions
	|		ON WriteOffMovements.SourceNodeNumber = TTTableOfSolutions.NodeNumber
	|
	|GROUP BY
	|	AdjustmentNodes.NodeNumber
	|INDEX BY
	|	NodeNumber
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	// 1 Calculation of the calculation error.
	|SELECT
	|	ISNULL(MAX(CASE 
	|		WHEN AdjustmentNodes.Weight1 = 0 THEN
	|			0
	|		WHEN ISNULL(DecisionTable.Decision1 * DecisionTable.Character1, 0)
	|				- AdjustmentNodes.Sum1 * AdjustmentNodes.Character1
	|				- CAST(TempTableOfSolutions.Decision1 / AdjustmentNodes.Weight1 AS NUMBER(28,10)) > 0
	|			THEN ISNULL(DecisionTable.Decision1 * DecisionTable.Character1, 0)
	|				- AdjustmentNodes.Sum1 * AdjustmentNodes.Character1
	|				- CAST(TempTableOfSolutions.Decision1 / AdjustmentNodes.Weight1 AS NUMBER(28,10))
	|       	ELSE
	|				-(ISNULL(DecisionTable.Decision1 * DecisionTable.Character1, 0)
	|				- AdjustmentNodes.Sum1 * AdjustmentNodes.Character1
	|				- CAST(TempTableOfSolutions.Decision1 / AdjustmentNodes.Weight1 AS NUMBER(28,10)))
	|		END)
	|		,0) AS Decision1,
	|	ISNULL(MAX(CASE 
	|		WHEN AdjustmentNodes.Weight2 = 0 THEN
	|			0
	|		WHEN ISNULL(DecisionTable.Decision2 * DecisionTable.Character2, 0)
	|				- AdjustmentNodes.Sum2 * AdjustmentNodes.Character2
	|				- CAST(TempTableOfSolutions.Decision2 / AdjustmentNodes.Weight2 AS NUMBER(28,10)) > 0
	|			THEN ISNULL(DecisionTable.Decision2 * DecisionTable.Character2, 0)
	|				- AdjustmentNodes.Sum2 * AdjustmentNodes.Character2
	|				- CAST(TempTableOfSolutions.Decision2 / AdjustmentNodes.Weight2 AS NUMBER(28,10))
	|       	ELSE
	|				-(ISNULL(DecisionTable.Decision2 * DecisionTable.Character2, 0)
	|				- AdjustmentNodes.Sum2 * AdjustmentNodes.Character2
	|				- CAST(TempTableOfSolutions.Decision2 / AdjustmentNodes.Weight2 AS NUMBER(28,10)))
	|		END)
	|		,0) AS Decision2
	|FROM
	|	TempTableOfSolutions AS TempTableOfSolutions
	|
	|	LEFT JOIN TTTableOfSolutions AS DecisionTable
	|		ON TempTableOfSolutions.NodeNumber = DecisionTable.NodeNumber
	|
	|	LEFT JOIN AdjustmentNodes AS AdjustmentNodes
	|		ON TempTableOfSolutions.NodeNumber = AdjustmentNodes.NodeNumber
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	// 2 Deleting tables.
	|DROP TTTableOfSolutions
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	// 3 Summation of coefficients.
	|SELECT
	|	TempTableOfSolutions.NodeNumber  AS NodeNumber,
	|	CAST(CASE
	|		WHEN ISNULL(AdjustmentNodes.Weight1, 0) = 0 THEN 0
	|	 	WHEN ISNULL(AdjustmentNodes.Sum1 * AdjustmentNodes.Character1, 0)
	|		 + CAST(TempTableOfSolutions.Decision1 / AdjustmentNodes.Weight1 AS NUMBER(28,10)) < 0
	|			THEN -(ISNULL(AdjustmentNodes.Sum1 * AdjustmentNodes.Character1, 0)
	|				+ CAST(TempTableOfSolutions.Decision1 / AdjustmentNodes.Weight1 AS NUMBER(28,10))) 
	|		ELSE
	|			ISNULL(AdjustmentNodes.Sum1 * AdjustmentNodes.Character1, 0)
	|				+ CAST(TempTableOfSolutions.Decision1 / AdjustmentNodes.Weight1 AS NUMBER(28,10)) 
	|		END AS NUMBER(28,10)) AS Decision1,
	|	CAST(CASE
	|		WHEN ISNULL(AdjustmentNodes.Weight2, 0) = 0 THEN 0
	|	 	WHEN ISNULL(AdjustmentNodes.Sum2 * AdjustmentNodes.Character2, 0)
	|		 + CAST(TempTableOfSolutions.Decision2 / AdjustmentNodes.Weight2 AS NUMBER(28,10)) < 0
	|			THEN -(AdjustmentNodes.Sum2 * AdjustmentNodes.Character2
	|				+ CAST(TempTableOfSolutions.Decision2 / AdjustmentNodes.Weight2 AS NUMBER(28,10))) 
	|		ELSE
	|			ISNULL(AdjustmentNodes.Sum2 * AdjustmentNodes.Character2, 0)
	|				+ CAST(TempTableOfSolutions.Decision2 / AdjustmentNodes.Weight2 AS NUMBER(28,10)) 
	|		END AS NUMBER(28,10)) AS Decision2,
	|	CASE
	|		WHEN ISNULL(AdjustmentNodes.Weight1, 0) = 0 THEN 0
	|	 	WHEN ISNULL(AdjustmentNodes.Sum1 * AdjustmentNodes.Character1, 0)
	|		 + CAST(TempTableOfSolutions.Decision1 / AdjustmentNodes.Weight1 AS NUMBER(28,10)) < 0
	|			THEN -1
	|			ELSE 1
    |	END AS Character1,
	|	CASE
	|		WHEN ISNULL(AdjustmentNodes.Weight2, 0) = 0 THEN 0
	|	 	WHEN ISNULL(AdjustmentNodes.Sum2 * AdjustmentNodes.Character2, 0)
	|		 + CAST(TempTableOfSolutions.Decision2 / AdjustmentNodes.Weight2 AS NUMBER(28,10)) < 0
	|			THEN -1
	|			ELSE 1
    |	END AS Character2
	|
	|INTO TTTableOfSolutions
	|FROM
	|	TempTableOfSolutions AS TempTableOfSolutions
	|	LEFT JOIN AdjustmentNodes AS AdjustmentNodes
	|		ON TempTableOfSolutions.NodeNumber = AdjustmentNodes.NodeNumber
	|INDEX BY
	|	NodeNumber
	|;
	// 4 The resulting table.
	|SELECT
	|	DecisionTable.NodeNumber AS NodeNumber,
	|	DecisionTable.Decision1 * DecisionTable.Character1 AS Decision1,
	|	DecisionTable.Decision2 * DecisionTable.Character2 AS Decision2
	|FROM
	|	TTTableOfSolutions AS DecisionTable
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TempTableOfSolutions
	|";
	Query.Text = CostCalculationCostAdjustment.SetBitDepthOfNumbersInRequestText(CalculationParameters, Query.Text);
	
	While CurrentDeviation > CalculationParameters.SolutionOfSLU.AdequateAccuracy
	 And IterationCounter <= CalculationParameters.SolutionOfSLU.MaxNumberOfIterations Do
		
		CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "TTTableOfSolutions");
		ResultsArray = Query.ExecuteBatch();
		QueryResult = ResultsArray[1];
		CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters, True);
		
		If Not QueryResult.IsEmpty() Then
			Selection = QueryResult.Select();
			Selection.Next();
			
			CurrentDeviation =	Max(
				Selection.Decision1,
				Selection.Decision2);
		Else
			CurrentDeviation = 0;
		EndIf;
		
		// Add an entry to the calculation protocol
		ProtocolString = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Sai lệch ở bước lặp hiện tại: %1';
				|ru = 'Отклонение на текущей итерации: %1';
				|en = 'Deviation in the current iteration: %1'; fa = 'Deviation in the current iteration: %1';
				|it = 'Deviation in the current iteration: %1';
				|pl = 'Deviation in the current iteration: %1';
				|tr = 'Mevcut yinelemede sapma: %1'"),
			CostCalculationProtocol.ValuePresentation(CurrentDeviation));
			
		CostCalculationProtocol.AdditionalInformation(CalculationParameters, ProtocolString);
		IterationCounter = IterationCounter + 1;
		
	EndDo;
	
	// Add an entry to the calculation protocol
	ProtocolString = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = 'Đã thực hiện giải quyết hệ phương trình tuyến tính (lặp lại/ sai lệch tổng số): %1 / %2';
			|ru = 'Выполнено решение СЛУ (итерации / итоговое отклонение): %1 / %2';
			|en = 'LES is solved (iterations / final deviation): %1 / %2'; fa = 'LES is solved (iterations / final deviation): %1 / %2';
			|it = 'LES is solved (iterations / final deviation): %1 / %2';
			|pl = 'LES is solved (iterations / final deviation): %1 / %2';
			|tr = 'Doğrusal denklem sisteminin çözümü bulundu (yinelemeler / toplam sapma): %1 / %2'"),
		CostCalculationProtocol.ValuePresentation(IterationCounter - 1),
		CostCalculationProtocol.ValuePresentation(CurrentDeviation));
		
	CostCalculationProtocol.AdditionalInformation(CalculationParameters, ProtocolString);
	
	Return ResultsArray[4].Unload();
	
EndFunction

// Modifies Query Texts for nodes and links:
// - in the request for nodes, the costs for nodes with zero weight are reset to zero;
// - in the request for obtaining links for arcs that include a node with zero weight, the corresponding weights are reset.
//
// Parameters:
// 	CalculationParameters - See InitializeGeneralCalculationParameters
//	RequestNodes - Query - request to select nodes
//	NameOfNodeNumberColumn - String - column name of the node number in the query
//	CommunicationRequest - Query - query to select links; this query must be executed later than the query nodes, because it deletes the auxiliary table <Name of the table of the correct nodes>
//	ColumnNamesOfNodeNumbers - String - column names of the source node and receiver node in the request
//	ConnectionsOfColumnsOfWeightsAndCosts - Structure:
//	 * Key - String - Name Of The Weight Column
//	 * Value - String - the names of the corresponding cost columns
//	ExplanationForMeasurement - String - explanation of the SLE for output to the protocol
//
Procedure AdjustCostOfNodesSLEFromQueries(CalculationParameters, RequestNodes, NameOfNodeNumberColumn,
			CommunicationRequest, ColumnNamesOfNodeNumbers, ConnectionsOfColumnsOfWeightsAndCosts, ExplanationForMeasurement = "") Export
	
	RelationshipTableName = "TTCommunicationServiceSolutionPreliminary";
	NodeTableName  = "TTSolutionSLU_NodesPreliminary";
	TableNameNodesWithZeroWeights = "TTSolutionIsForNodesWithZeroWeights";
	
	DestroyTemporaryTables(CalculationParameters, RelationshipTableName + "," + NodeTableName + "," + TableNameNodesWithZeroWeights);
	
	#Region DescriptionOfAlgorithm
	
	// 1. From the table of links, create a temporary table <Name of the link table>.
	// 2. In the table <Name of the Link table> we find the lines in which (by And)
	//	  - the source node number is equal to the receiver node number (these are the lines in which the weights of the nodes, not the arcs, are indicated)
	//    - at least in one of the fields specified in the Column Weight name parameter, the value is 0 - such nodes cannot be calculated when solving SLE
	//    The found numbers of nodes and columns of weights are placed in the temporary table <Name of the table with zero weights>
	// 3. We execute the queries from p.1 and p.2
	// 4. If the table <Name of the table with zero weights> is empty, then we terminate the algorithm - no changes are required.
	//    If there are incorrect nodes, then we add information about this to the protocol.
	// 5. We form the Query Text of a sample of links from the <Name of the Link table> - for all links with nodes from the <name of the link table with zero weights>, the weights are also set to zero.
	// 6. From the node table, create a temporary table of <Node tablename>.
	// 7. We form the Query Text of the selection of nodes from the <Node table name>
	//    in which, for rows with node numbers included in the <Node table name with zero weights>, we reset the cost fields corresponding to zero weights.
	
	#EndRegion
	
	#Region Connections_p1_p5
	
	StructureOfCost = New Structure; // connection: cost column - weight column
	ArrayNodes = StringFunctionsClientServer.SplitStringIntoSubstringsArray(ColumnNamesOfNodeNumbers, ",",, True);
	
	TextNodes 	   = RequestNodes.Text;
	TextLinks     = CommunicationRequest.Text;
	TableColumns1 = "";
	ColumnsOfTableWithCondition = "";
	BalanceColumns   = "";
	FilterCriterion  = "";
	
	// items 1 and 6
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);

	RequestSchemaNodes = New QuerySchema;
	RequestSchemaNodes.SetQueryText(TextNodes);

	RequestSchemaNodes.QueryBatch[0].PlacementTable = NodeTableName;
	RequestSchemaNodes.QueryBatch[0].Index.Add(NameOfNodeNumberColumn);
	
	Query.Text = RequestSchemaNodes.GetQueryText(); // creating a temporary node table
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, ExplanationForMeasurement);
	
	QuerySchema = New QuerySchema;
	QuerySchema.SetQueryText(TextLinks);
	
	QuerySchema.QueryBatch[0].PlacementTable = RelationshipTableName;

	Query.Text = QuerySchema.GetQueryText(); // creating a temporary relationship table
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, ExplanationForMeasurement);
	
	If CalculationParameters.Property("OptimizeSLE") Then
		OptimizeSLE = CalculationParameters.OptimizeSLE;
	Else
		OptimizeSLE = True;
	EndIf;
	
	If OptimizeSLE Then
		OptimizeSLE(
			CalculationParameters,
			NodeTableName,
			NameOfNodeNumberColumn,
			RelationshipTableName,
			ColumnNamesOfNodeNumbers,
			ConnectionsOfColumnsOfWeightsAndCosts,
			ExplanationForMeasurement);
	EndIf;

	// P.2
	For Each KeyAndValue In ConnectionsOfColumnsOfWeightsAndCosts Do
		
		FilterCriterion = FilterCriterion + ?(FilterCriterion = "", "", Chars.LF + "	OR ") + "T." + KeyAndValue.Key + " = 0";
		BalanceColumns = BalanceColumns + ?(BalanceColumns = "", "", "," + Chars.LF + "	") + "T." + KeyAndValue.Key;
		
		For Each CostColumn In New Structure(KeyAndValue.Value) Do
			StructureOfCost.Insert(CostColumn.Key, KeyAndValue.Key); 
		EndDo;
		
	EndDo;
	
	For Each CurrentColumn In QuerySchema.QueryBatch[0].Columns Do
		
		TableColumns1 = TableColumns1 + ?(TableColumns1 = "", "", "," + Chars.LF + "	") + "T." + CurrentColumn.Alias;
		
		If ConnectionsOfColumnsOfWeightsAndCosts.Property(CurrentColumn.Alias) Then
			ColumnsOfTableWithCondition = ColumnsOfTableWithCondition + ?(ColumnsOfTableWithCondition = "", "", "," + Chars.LF + "	")
				+ "CASE WHEN ISNULL(SourceNodes." + CurrentColumn.Alias + ", 1) = 0
					|  OR ISNULL(ReceiverNodes_." + CurrentColumn.Alias + ", 1) = 0 THEN 0 ELSE T." + CurrentColumn.Alias + " END AS " + CurrentColumn.Alias;
		Else
			ColumnsOfTableWithCondition = ColumnsOfTableWithCondition + ?(ColumnsOfTableWithCondition = "", "", "," + Chars.LF + "	") + "T." + CurrentColumn.Alias;
		EndIf;
		
	EndDo;

	FilterCriterion = "T." + ArrayNodes[0] + " = T." + ArrayNodes[1] + Chars.LF + "	AND (" + FilterCriterion + ")";
	
	QueryText =
	"SELECT
	|	&NodeNumber AS NodeNumber,
	|	&BalanceColumns
	|INTO TableNameNodesWithZeroWeights
	|FROM
	|	RelationshipTableName AS T
	|WHERE
	|	&FilterCriterion
	|INDEX BY
	|	NodeNumber
	|";
	
	QueryText = StrReplace(QueryText, "&NodeNumber", ArrayNodes[0]); // the value of the Array nodes[0] and Array Nodes[1] fields are equal, you can use any
	QueryText = StrReplace(QueryText, "&BalanceColumns", BalanceColumns);
	QueryText = StrReplace(QueryText, "&FilterCriterion", FilterCriterion);
	QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
	QueryText = StrReplace(QueryText, "RelationshipTableName", RelationshipTableName);

	QuerySchema.QueryBatch.Clear();
	NewPackage = QuerySchema.QueryBatch.Add(Type("QuerySchemaSelectQuery"));
	NewPackage.SetQueryText(QueryText);
	
	// P.3
	CommunicationRequest.Text = QuerySchema.GetQueryText(); // search for incorrect nodes
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, CommunicationRequest,,,, ExplanationForMeasurement);
	
	// P.4
	NodeCount = TemporaryTableSize(CalculationParameters, TableNameNodesWithZeroWeights);
	
	If NodeCount = 0 Then

		// There are no incorrect nodes.
		// We return it to the requestreferences
		// - the Query Text of the selection of all data from the <Link table name> (the <Link table name> has already been generated earlier in this procedure)
		// - Query Text for deleting <Link tablename>
		// - Query Text for deletion of <Name of the table with null weights>
		QueryText =
		"SELECT
		|	&TableColumns1
		|FROM
		|	RelationshipTableName AS T
		|;
		|
		|DROP RelationshipTableName
		|;
		|
		|DROP TableNameNodesWithZeroWeights
		|";
		
		QueryText = StrReplace(QueryText, "&TableColumns1",  TableColumns1);
		QueryText = StrReplace(QueryText, "RelationshipTableName", RelationshipTableName);
		QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
		
		CommunicationRequest.Text = QueryText;
		
	Else
		
		CostCalculationProtocol.AdditionalInformation(
			CalculationParameters,
			NStr("vi = 'Nút hệ phương trình tuyến tính với trọng số bằng 0';
				|ru = 'Узлы СЛУ с нулевыми весами';
				|en = 'LES nodes with zero weight'; fa = 'LES nodes with zero weight';
				|it = 'LES nodes with zero weight';
				|pl = 'LES nodes with zero weight';
				|tr = 'Ağırlığı sıfır olan DDS düğümleri'") + ": " + TrimAll(NodeCount) + " (" + ExplanationForMeasurement + ")");
			
		// P.5
		QueryText =
		"SELECT
		|	&ColumnsOfTableWithCondition
		|FROM
		|	RelationshipTableName AS T
		|	LEFT JOIN TableNameNodesWithZeroWeights AS SourceNodes 
		|		ON T.NameOfSourceNodeColumn = SourceNodes.NodeNumber
		|	LEFT JOIN TableNameNodesWithZeroWeights AS ReceiverNodes_
		|		ON T.NameOfReceiverNodeColumn = ReceiverNodes_.NodeNumber
		|;
		|
		|DROP RelationshipTableName
		|;
		|
		|DROP TableNameNodesWithZeroWeights
		|";
		
		QueryText = StrReplace(QueryText, "&ColumnsOfTableWithCondition", ColumnsOfTableWithCondition);
		QueryText = StrReplace(QueryText, "RelationshipTableName", RelationshipTableName);
		QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
		QueryText = StrReplace(QueryText, "NameOfSourceNodeColumn", ArrayNodes[0]);
		QueryText = StrReplace(QueryText, "NameOfReceiverNodeColumn", ArrayNodes[1]);
		
		// We return it to the requestreferences
		// - Query Text of the selection of all data from the <Link tablename> with zero weights 
		// - Query Text for deleting <Link tablename>
		// - Query Text for deletion of <Name of the table with null weights>
		CommunicationRequest.Text = QueryText;
		
	EndIf;
	
	#EndRegion
	
	#Region Nodes_p6_p7
	
	ColumnsOfTableWithCondition = "";
	FilterCriterion = "";
	
	// P.7
	For Each CurrentColumn In RequestSchemaNodes.QueryBatch[0].Columns Do
		
		NameOfWeightColumn = Undefined;
		
		If StructureOfCost.Property(CurrentColumn.Alias, NameOfWeightColumn) Then
			ColumnsOfTableWithCondition = ColumnsOfTableWithCondition + ?(ColumnsOfTableWithCondition = "", "", "," + Chars.LF + "	")
				+ "CASE WHEN ISNULL(Nodes." + NameOfWeightColumn + ", 1) = 0 THEN 0 ELSE T." + CurrentColumn.Alias + " END AS " + CurrentColumn.Alias;
			FilterCriterion = FilterCriterion + ?(FilterCriterion = "", "", Chars.LF + "	OR ")
				+ "(Nodes." + NameOfWeightColumn + " = 0 AND T." + CurrentColumn.Alias + " <> 0)";
		Else
			ColumnsOfTableWithCondition = ColumnsOfTableWithCondition + ?(ColumnsOfTableWithCondition = "", "", "," + Chars.LF + "	") + "T." + CurrentColumn.Alias;
		EndIf;
		
	EndDo;
	
	// We will save information about nodes with zero weights, but non-zero costs
	If Not CalculationParameters.Property("NodesWithZeroWeights") Then
		NodesWithZeroWeights = New Array;
	Else
		NodesWithZeroWeights = CalculationParameters.NodesWithZeroWeights;
	EndIf;
	
	QueryText =
	"SELECT
	|	Nodes.NodeNumber AS NodeNumber
	|FROM
	|	NodeTableName AS T
	|	INNER JOIN TableNameNodesWithZeroWeights AS Nodes
	|		ON T.NameOfNodeNumberColumn = Nodes.NodeNumber
	|WHERE
	|	(&FilterCriterion)
	|	AND NOT (Nodes.NodeNumber IN (&NodesWithZeroWeights))
	|";
	
	QueryText = StrReplace(QueryText, "&FilterCriterion", FilterCriterion);
	QueryText = StrReplace(QueryText, "NodeTableName",  NodeTableName);
	QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
	QueryText = StrReplace(QueryText, "NameOfNodeNumberColumn", NameOfNodeNumberColumn);
	
	RequestSchemaNodes.QueryBatch.Clear();
	NewPackage = RequestSchemaNodes.QueryBatch.Add(Type("QuerySchemaSelectQuery"));
	NewPackage.SetQueryText(QueryText);
	
	RequestNodes.Text = RequestSchemaNodes.GetQueryText();
	RequestNodes.SetParameter("NodesWithZeroWeights", NodesWithZeroWeights);
	
	Selection = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, RequestNodes,,, True, ExplanationForMeasurement + ", " + NStr("vi = 'nút không hợp lệ';
																																				|ru = 'некорректные узлы';
																																				|en = 'incorrect nodes'; fa = 'incorrect nodes';
																																				|it = 'incorrect nodes';
																																				|pl = 'incorrect nodes';
																																				|tr = 'yanlış düğümler'", Common.DefaultLanguageCode())).Select();
	
	While Selection.Next() Do
		NodesWithZeroWeights.Add(Selection.NodeNumber);
	EndDo;
	
	CalculationParameters.Insert("NodesWithZeroWeights", NodesWithZeroWeights);
	
	NonZeroCostOfNodesSLE(CalculationParameters, NodeTableName, StructureOfCost, ExplanationForMeasurement);
	
	RequestSchemaNodes = New QuerySchema;
	
	QueryText =
	"SELECT
	|	&ColumnsOfTableWithCondition
	|FROM
	|	NodeTableName AS T
	|	LEFT JOIN TableNameNodesWithZeroWeights AS Nodes
	|		ON T.NameOfNodeNumberColumn = Nodes.NodeNumber
	|";
	
	QueryText = StrReplace(QueryText, "&ColumnsOfTableWithCondition", ColumnsOfTableWithCondition);
	QueryText = StrReplace(QueryText, "NodeTableName",  NodeTableName);
	QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
	QueryText = StrReplace(QueryText, "NameOfNodeNumberColumn", NameOfNodeNumberColumn);
	
	NewPackage = RequestSchemaNodes.QueryBatch.Add(Type("QuerySchemaSelectQuery"));
	NewPackage.SetQueryText(QueryText);
	
	NewPackage = RequestSchemaNodes.QueryBatch.Add(Type("QuerySchemaTableDropQuery"));
	NewPackage.TableName = NodeTableName;
	
	// We return to the request
	// - the Query Text for generating the <Node tablename> 
	// - Query Text for fetching data from <Node table name>, excluding incorrect nodes
	// - Query Text for deleting <Node tablename>
	RequestNodes.Text = RequestSchemaNodes.GetQueryText();
	
	#EndRegion
	
EndProcedure

// Modifies temporary node and link tables:
// - the costs for nodes with zero weight are reset to zero;
// - the weights for links that include a node with zero weight are reset to zero.
//
// Parameters:
// 	CalculationParameters - See InitializeGeneralCalculationParameters
//	NodeTableName - String - name of the temporary node table
//	NameOfNodeNumberColumn - String - column name of the node number in the query
//	RelationshipTableName - String - the name of the temporary link table
//	ColumnNamesOfNodeNumbers - String - column names of the source node and receiver node in the request
//	ConnectionsOfColumnsOfWeightsAndCosts - Structure:
//	 * Key - String - Name Of The Weight Column
//	 * Value - String - the names of the corresponding cost columns
//	ExplanationForMeasurement - String - explanation of the SLE for output to the protocol
//
Procedure AdjustCostOfNodesSLEFromTemporaryTables(CalculationParameters, NodeTableName, NameOfNodeNumberColumn,
			RelationshipTableName, ColumnNamesOfNodeNumbers, ConnectionsOfColumnsOfWeightsAndCosts, ExplanationForMeasurement = "") Export
	
	NameOfRelationshipTableIsIntermediate = "TTIsIntermediateCommunicationServiceSolution";
	NameOfNodeTableIsIntermediate  = "TTSolutionSLU_IntermediateNodes";
	TableNameNodesWithZeroWeights = "TTSolutionIsForNodesWithZeroWeights";
	
	DestroyTemporaryTables(CalculationParameters, NameOfRelationshipTableIsIntermediate + "," + NameOfNodeTableIsIntermediate + "," + TableNameNodesWithZeroWeights);
	
	OptimizeSLE(
		CalculationParameters,
		NodeTableName,
		NameOfNodeNumberColumn,
		RelationshipTableName,
		ColumnNamesOfNodeNumbers,
		ConnectionsOfColumnsOfWeightsAndCosts,
		ExplanationForMeasurement);

	#Region DescriptionOfAlgorithm
	
	// 1. In the <Name of the Link table> table, we find the lines in which (by And)
	//	  - the source node number is equal to the receiver node number (these are the lines that indicate the weights of the nodes, not the arcs)
	//    - at least in one of the fields specified in the Column Weight name parameter, the value is 0 - such nodes cannot be calculated when solving SLE
	//    The found numbers of nodes and columns of weights are placed in the temporary table <Name of the table with zero weights>
	// 2. We carry out requests for the formation of <Name of the table with zero weights>
	// 3. If the table <Name of the table with zero weights> is empty, then we terminate the algorithm - no changes are required.
	//    If there are incorrect nodes, then add information about this to the protocol.
	// 4. Re-form the <Name of the linked tables>:
	//	  - we form the <name of the table with the daily connection> from the <name of the table with the connections> - if the number of the receiver node or the number of the source node is included in the <name of the table with the correct nodes>, then we reset the weight
	//    - destroying the <name of the linked tables>
	//    - we transfer all data from the <name of the linkableindividual> to the <name of the linkable>
	//    - we destroy the <Name of the tablescommunication>
	// 5. Reformulate the <name of the node tables>:
	//	  - we form a daily <Name of the table nodes> from the <Name of the table nodes>,
	//      in which for rows with node numbers included in the <Name of the table nodes with zero weights>, we reset the cost fields corresponding to zero weights
	//    - we destroy the <name of the node tables>
	//    - transferring all data from the <name of the table nodes daily> to the <name of the table nodes>
	//    - we destroy the <name of the <table_individual>
	
	#EndRegion
	
	#Region Connections_p1_p4
	
	StructureOfCost = New Structure; // connection: cost column - weight column
	ArrayNodes = StringFunctionsClientServer.SplitStringIntoSubstringsArray(ColumnNamesOfNodeNumbers, ",",, True);
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	// P.1
	TableColumns1 = StrReplace(TemporaryTableColumns(CalculationParameters, RelationshipTableName, True), "%1", "T.");
	ColumnsOfTableWithCondition = "";
	BalanceColumns   = "";
	FilterCriterion  = "";
	
	For Each KeyAndValue In ConnectionsOfColumnsOfWeightsAndCosts Do
		
		FilterCriterion = FilterCriterion + ?(FilterCriterion = "", "", Chars.LF + "	OR ") + "T." + KeyAndValue.Key + " = 0";
		BalanceColumns = BalanceColumns + ?(BalanceColumns = "", "", "," + Chars.LF + "	") + "T." + KeyAndValue.Key;
		
		For Each CostColumn In New Structure(KeyAndValue.Value) Do
			StructureOfCost.Insert(CostColumn.Key, KeyAndValue.Key); 
		EndDo;
		
	EndDo;
	
	For Each CurrentColumn In New Structure(StrReplace(TemporaryTableColumns(CalculationParameters, RelationshipTableName, True), "%1", "")) Do
		
		If ConnectionsOfColumnsOfWeightsAndCosts.Property(CurrentColumn.Key) Then
			ColumnsOfTableWithCondition = ColumnsOfTableWithCondition + ?(ColumnsOfTableWithCondition = "", "", "," + Chars.LF + "	")
				+ "CASE WHEN ISNULL(SourceNodes." + CurrentColumn.Key + ", 1) = 0
					|  OR ISNULL(ReceiverNodes_." + CurrentColumn.Key + ", 1) = 0 THEN 0 ELSE T." + CurrentColumn.Key + " END AS " + CurrentColumn.Key;
		Else
			ColumnsOfTableWithCondition = ColumnsOfTableWithCondition + ?(ColumnsOfTableWithCondition = "", "", "," + Chars.LF + "	") + "T." + CurrentColumn.Key;
		EndIf;
		
	EndDo;
	
	FilterCriterion = "T." + ArrayNodes[0] + " = T." + ArrayNodes[1] + Chars.LF + "	AND (" + FilterCriterion + ")";
	
	QueryText =
	"SELECT
	|	&NodeNumber AS NodeNumber,
	|	&BalanceColumns
	|INTO TableNameNodesWithZeroWeights
	|FROM
	|	RelationshipTableName AS T
	|WHERE
	|	&FilterCriterion
	|INDEX BY
	|	NodeNumber
	|";
	
	QueryText = StrReplace(QueryText, "&NodeNumber", ArrayNodes[0]); // the value of the Array nodes[0] and Array Nodes[1] fields are equal, you can use any
	QueryText = StrReplace(QueryText, "&BalanceColumns", BalanceColumns);
	QueryText = StrReplace(QueryText, "&FilterCriterion", FilterCriterion);
	QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
	QueryText = StrReplace(QueryText, "RelationshipTableName", RelationshipTableName);
	
	// P.2
	Query.Text = QueryText;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, ExplanationForMeasurement);
	
	// P.3
	NodeCount = TemporaryTableSize(CalculationParameters, TableNameNodesWithZeroWeights);
	
	If NodeCount = 0 Then

		NonZeroCostOfNodesSLE(CalculationParameters, NodeTableName, StructureOfCost, ExplanationForMeasurement);
		Return;
		
	Else
		
		CostCalculationProtocol.AdditionalInformation(
			CalculationParameters,
			NStr("vi = 'Nút hệ phương trình tuyến tính với trọng số bằng 0';
				|ru = 'Узлы СЛУ с нулевыми весами';
				|en = 'LES nodes with zero weight'; fa = 'LES nodes with zero weight';
				|it = 'LES nodes with zero weight';
				|pl = 'LES nodes with zero weight';
				|tr = 'Ağırlığı sıfır olan DDS düğümleri'") + ": " + TrimAll(NodeCount) + " (" + ExplanationForMeasurement + ")");
			
	EndIf;
	
	// P.4
	QueryText =
	"SELECT
	|	&ColumnsOfTableWithCondition
	|INTO NameOfRelationshipTableIsIntermediate
	|FROM
	|	RelationshipTableName AS T
	|	LEFT JOIN TableNameNodesWithZeroWeights AS SourceNodes 
	|		ON T.NameOfSourceNodeColumn = SourceNodes.NodeNumber
	|	LEFT JOIN TableNameNodesWithZeroWeights AS ReceiverNodes_
	|		ON T.NameOfReceiverNodeColumn = ReceiverNodes_.NodeNumber
	|;
	|
	|DROP RelationshipTableName
	|;
	|
	|SELECT
	|	&TableColumns1
	|INTO RelationshipTableName
	|FROM
	|	NameOfRelationshipTableIsIntermediate AS T"
	+ "
	|
	|INDEX BY
	|	NameOfSourceNodeColumn,
	|	NameOfReceiverNodeColumn
	|;
	|"
	+ "
	|DROP NameOfRelationshipTableIsIntermediate
	|";
	
	QueryText = StrReplace(QueryText, "&ColumnsOfTableWithCondition",  ColumnsOfTableWithCondition);
	QueryText = StrReplace(QueryText, "&TableColumns1",  TableColumns1);
	QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
	QueryText = StrReplace(QueryText, "NameOfRelationshipTableIsIntermediate",  NameOfRelationshipTableIsIntermediate);
	QueryText = StrReplace(QueryText, "RelationshipTableName",  RelationshipTableName);
	QueryText = StrReplace(QueryText, "NameOfSourceNodeColumn", ArrayNodes[0]);
	QueryText = StrReplace(QueryText, "NameOfReceiverNodeColumn", ArrayNodes[1]);
	
	Query.Text = QueryText;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, ExplanationForMeasurement);
	
	#EndRegion
	
	#Region Nodes_p5
	
	// P.5
	TableColumns1 = StrReplace(TemporaryTableColumns(CalculationParameters, NodeTableName, True), "%1", "T.");
	ColumnsOfTableWithCondition = "";
	FilterCriterion = "";
	
	For Each CurrentColumn In New Structure(StrReplace(TemporaryTableColumns(CalculationParameters, NodeTableName, True), "%1", "")) Do
		
		NameOfWeightColumn = Undefined;
		
		If StructureOfCost.Property(CurrentColumn.Key, NameOfWeightColumn) Then
			ColumnsOfTableWithCondition = ColumnsOfTableWithCondition + ?(ColumnsOfTableWithCondition = "", "", "," + Chars.LF + "	")
				+ "CASE WHEN ISNULL(Nodes." + NameOfWeightColumn + ", 1) = 0 THEN 0 ELSE T." + CurrentColumn.Key + " END AS " + CurrentColumn.Key;
			FilterCriterion = FilterCriterion + ?(FilterCriterion = "", "", Chars.LF + "	OR ")
				+ "(Nodes." + NameOfWeightColumn + " = 0 AND T." + CurrentColumn.Key + " <> 0)";
		Else
			ColumnsOfTableWithCondition = ColumnsOfTableWithCondition + ?(ColumnsOfTableWithCondition = "", "", "," + Chars.LF + "	") + "T." + CurrentColumn.Key;
		EndIf;
		
	EndDo;
	
	// We will save information about nodes with zero weights, but non-zero costs
	If Not CalculationParameters.Property("NodesWithZeroWeights") Then
		NodesWithZeroWeights = New Array;
	Else
		NodesWithZeroWeights = CalculationParameters.NodesWithZeroWeights;
	EndIf;
	
	QueryText =
	"SELECT
	|	Nodes.NodeNumber AS NodeNumber
	|FROM
	|	NodeTableName AS T
	|	INNER JOIN TableNameNodesWithZeroWeights AS Nodes
	|		ON T.NameOfNodeNumberColumn = Nodes.NodeNumber
	|WHERE
	|	(&FilterCriterion)
	|	AND NOT (Nodes.NodeNumber IN (&NodesWithZeroWeights))
	|";
	
	QueryText = StrReplace(QueryText, "&FilterCriterion", FilterCriterion);
	QueryText = StrReplace(QueryText, "NodeTableName",  NodeTableName);
	QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
	QueryText = StrReplace(QueryText, "NameOfNodeNumberColumn", NameOfNodeNumberColumn);

	Query.Text = QueryText;
	Query.SetParameter("NodesWithZeroWeights", NodesWithZeroWeights);
	
	Selection = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True, ExplanationForMeasurement + ", " + NStr("vi = 'nút không hợp lệ';
																																		|ru = 'некорректные узлы';
																																		|en = 'incorrect nodes'; fa = 'incorrect nodes';
																																		|it = 'incorrect nodes';
																																		|pl = 'incorrect nodes';
																																		|tr = 'yanlış düğümler'", Common.DefaultLanguageCode())).Select();
	
	While Selection.Next() Do
		NodesWithZeroWeights.Add(Selection.NodeNumber);
	EndDo;
	
	CalculationParameters.Insert("NodesWithZeroWeights", NodesWithZeroWeights);
	
	QueryText =
	"SELECT
	|	&ColumnsOfTableWithCondition
	|INTO NameOfNodeTableIsIntermediate
	|FROM
	|	NodeTableName AS T
	|	LEFT JOIN TableNameNodesWithZeroWeights AS Nodes
	|		ON T.NameOfNodeNumberColumn = Nodes.NodeNumber
	|;
	|
	|DROP NodeTableName
	|;
	|
	|SELECT
	|	&TableColumns1
	|INTO NodeTableName
	|FROM
	|	NameOfNodeTableIsIntermediate AS T"
	+ "
	|
	|INDEX BY
	|	NameOfNodeNumberColumn
	|;
	|"
	+ "
	|DROP NameOfNodeTableIsIntermediate
	|";
	
	QueryText = StrReplace(QueryText, "&ColumnsOfTableWithCondition", ColumnsOfTableWithCondition);
	QueryText = StrReplace(QueryText, "&TableColumns1",  TableColumns1);
	QueryText = StrReplace(QueryText, "TableNameNodesWithZeroWeights", TableNameNodesWithZeroWeights);
	QueryText = StrReplace(QueryText, "NameOfNodeTableIsIntermediate",  NameOfNodeTableIsIntermediate);
	QueryText = StrReplace(QueryText, "NodeTableName",  NodeTableName);
	QueryText = StrReplace(QueryText, "NameOfNodeNumberColumn", NameOfNodeNumberColumn);
	
	Query.Text = QueryText;
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, ExplanationForMeasurement);
	
	NonZeroCostOfNodesSLE(CalculationParameters, NodeTableName, StructureOfCost, ExplanationForMeasurement);
	
	#EndRegion
	
EndProcedure

// Optimizes temporary tables of nodes and links:
// delete nodes and links for which the calculation result will be zero.
//
// Parameters:
// 	CalculationParameters - See InitializeGeneralCalculationParameters
//	NodeTableName - String - name of the temporary node table
//	NameOfNodeNumberColumn - String - column name of the node number in the query
//	RelationshipTableName - String - the name of the temporary link table
//	ColumnNamesOfNodeNumbers - String - column names of the source node and receiver node in the request
//	ConnectionsOfColumnsOfWeightsAndCosts - Structure:
//	 * Key - String - Name Of The Weight Column
//	 * Value - String - the names of the corresponding cost columns
//	ExplanationForMeasurement - String - explanation of the SLE for output to the protocol
//
Procedure OptimizeSLE(CalculationParameters, NodeTableName, NameOfNodeNumberColumn,
			RelationshipTableName, ColumnNamesOfNodeNumbers, ConnectionsOfColumnsOfWeightsAndCosts, ExplanationForMeasurement)
	
	If EmptyTempTable(CalculationParameters, NodeTableName) Then
		Return;
	EndIf;
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(
		CalculationParameters,
		"OptimizeSLE",
		NStr("vi = 'Tối ưu hóa giải pháp hệ phương trình tuyến tính';
			|ru = 'Оптимизация СЛУ';
			|en = 'LES optimization'; fa = 'LES optimization';
			|it = 'LES optimization';
			|pl = 'LES optimization';
			|tr = 'DDS optimizasyonu'", Common.DefaultLanguageCode())
			+ ?(ExplanationForMeasurement = "", "", " (" + ExplanationForMeasurement + ")"));
	
	ColumnsArray1 = StringFunctionsClientServer.SplitStringIntoSubstringsArray(ColumnNamesOfNodeNumbers, ",",, True);
	NameOfSourceNodeColumn = ColumnsArray1[0];
	NameOfReceiverNodeColumn = ColumnsArray1[1];
	
	TextOfColumnOfNodeTable = "";
	TextOfColumnOfRelationshipTable = "";
	TextSelectionNodes = "";
	
	NodesBeforeOptimization = TemporaryTableSize(CalculationParameters, NodeTableName);
	CommunicationsBeforeOptimization = TemporaryTableSize(CalculationParameters, RelationshipTableName);
	
	For Each KeyAndValue In ConnectionsOfColumnsOfWeightsAndCosts Do
		
		TextOfColumnOfRelationshipTable = TextOfColumnOfRelationshipTable + ?(TextOfColumnOfRelationshipTable = "", "", ",
			|	") + "Links." + KeyAndValue.Key;
		
		For Each KeyAndValueNodes In New Structure(KeyAndValue.Value) Do
			
			TextOfColumnOfNodeTable = TextOfColumnOfNodeTable + ?(TextOfColumnOfNodeTable = "", "", ",
				|	") + "T." + KeyAndValueNodes.Key;
			
			TextSelectionNodes = TextSelectionNodes + ?(TextSelectionNodes = "", "", Chars.LF + "	OR ") + "T." + KeyAndValueNodes.Key + " <> 0";
			
		EndDo;
		
	EndDo;
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	Query.Text =
	"SELECT
	|	T.NameOfNodeNumberColumn AS NodeNumber
	|INTO NodeNumbersAreTemporary
	|FROM
	|	NodeTableName AS T
	|WHERE
	|	&FilterNodes
	|
	|INDEX BY
	|	NodeNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Links.NameOfSourceNodeColumn AS SourceNodeNumber,
	|	Links.NameOfReceiverNodeColumn AS ReceiverNodeNumber,
	|	&AllColumnsOfRelationshipTable
	|INTO SLU_IndexedLinks
	|FROM
	|	RelationshipTableName AS Links
	|
	|INDEX BY SETS
	|(
	|	(SourceNodeNumber),
	|	(ReceiverNodeNumber)
	|)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP RelationshipTableName
	|";
	
	Query.Text = StrReplace(Query.Text, "NameOfNodeNumberColumn", NameOfNodeNumberColumn);
	Query.Text = StrReplace(Query.Text, "NodeTableName", NodeTableName);
	Query.Text = StrReplace(Query.Text, "&FilterNodes", TextSelectionNodes);
	Query.Text = StrReplace(Query.Text, "NameOfSourceNodeColumn", NameOfSourceNodeColumn);
	Query.Text = StrReplace(Query.Text, "NameOfReceiverNodeColumn", NameOfReceiverNodeColumn);
	Query.Text = StrReplace(Query.Text, "RelationshipTableName", RelationshipTableName);
	Query.Text = StrReplace(Query.Text, "&AllColumnsOfRelationshipTable", TextOfColumnOfRelationshipTable);
	
	Query.Execute();
	
	Query.Text =
	"SELECT DISTINCT
	|	Links.ReceiverNodeNumber AS NodeNumber
	|INTO NodeNumbersSupplement
	|FROM
	|	SLU_IndexedLinks AS Links
	|		INNER JOIN NodeNumbersAreTemporary AS NodesAreNew
	|		ON Links.SourceNodeNumber = NodesAreNew.NodeNumber
	|		LEFT JOIN NodeNumbersAreTemporary AS NodesSelected
	|		ON Links.ReceiverNodeNumber = NodesSelected.NodeNumber
	|WHERE
	|	NodesSelected.NodeNumber IS NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.NodeNumber AS NodeNumber
	|ADD NodeNumbersAreTemporary
	|FROM
	|	NodeNumbersSupplement AS T
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 1
	|	TRUE AS ThereAreNewNodes
	|FROM
	|	NodeNumbersSupplement AS T
	|";
	
	ThereIsNewData = True;
	IterationCounter = 0;
	
	While ThereIsNewData Do
		
		IterationCounter = IterationCounter + 1;
		ThereIsNewData = Not Query.Execute().IsEmpty();
		
		DestroyTemporaryTables(CalculationParameters, "NodeNumbersSupplement");
		
	EndDo;
	
	Query.Text =
	"SELECT
	|	T.NameOfNodeNumberColumn,
	|	&AllColumnsOfNodeTable
	|INTO NodeTableIsTemporary
	|FROM
	|	NodeTableName AS T
	|	INNER JOIN NodeNumbersAreTemporary AS Filter
	|		ON T.NameOfNodeNumberColumn = Filter.NodeNumber
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP NodeTableName
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.NameOfNodeNumberColumn,
	|	&AllColumnsOfNodeTable
	|INTO NodeTableName
	|FROM
	|	NodeTableIsTemporary AS T
	|
	|INDEX BY
	|	NameOfNodeNumberColumn
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Links.SourceNodeNumber AS NameOfSourceNodeColumn,
	|	Links.ReceiverNodeNumber AS NameOfReceiverNodeColumn,
	|	&AllColumnsOfRelationshipTable
	|INTO RelationshipTableName
	|FROM
	|	SLU_IndexedLinks AS Links
	|	INNER JOIN NodeTableName AS SourceNodes
	|		ON Links.SourceNodeNumber = SourceNodes.NameOfNodeNumberColumn
	|	INNER JOIN NodeTableName AS ReceiverNodes_
	|		ON Links.ReceiverNodeNumber = ReceiverNodes_.NameOfNodeNumberColumn
	|
	|INDEX BY SETS
	|(
	|	(NameOfSourceNodeColumn),
	|	(NameOfReceiverNodeColumn)
	|)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP NodeTableIsTemporary
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP NodeNumbersAreTemporary
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP SLU_IndexedLinks
	|";
	
	Query.Text = StrReplace(Query.Text, "NameOfNodeNumberColumn", NameOfNodeNumberColumn);
	Query.Text = StrReplace(Query.Text, "&AllColumnsOfNodeTable", TextOfColumnOfNodeTable);
	Query.Text = StrReplace(Query.Text, "NodeTableName", NodeTableName);
	Query.Text = StrReplace(Query.Text, "&FilterNodes", TextSelectionNodes);
	Query.Text = StrReplace(Query.Text, "NameOfSourceNodeColumn", NameOfSourceNodeColumn);
	Query.Text = StrReplace(Query.Text, "NameOfReceiverNodeColumn", NameOfReceiverNodeColumn);
	Query.Text = StrReplace(Query.Text, "RelationshipTableName", RelationshipTableName);
	Query.Text = StrReplace(Query.Text, "&AllColumnsOfRelationshipTable", TextOfColumnOfRelationshipTable);
	
	Query.Execute();
	
	NodesAfterOptimization = TemporaryTableSize(CalculationParameters, NodeTableName);
	ConnectionsAfterOptimization = TemporaryTableSize(CalculationParameters, RelationshipTableName);
	
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
	
	ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
		NStr("vi = 'Số vòng lặp tối ưu hóa hệ phương trình tuyến tính đã thực hiện: %1
			|Số lượng nút (trước/sau): %2 / %3
			|Số lượng liên kết (trước/sau): %4 / %5';
			|ru = 'Выполнено итераций оптимизации СЛУ: %1
			|Количество узлов (до/после): %2 / %3
			|Количество связей (до/после): %4 / %5';
			|en = 'Performed iterations of LES: %1
			|Number of nodes (before/after): %2 / %3
			|Number of links (before/after): %4 / %5'; fa = 'Performed iterations of LES: %1
			|Number of nodes (before/after): %2 / %3
			|Number of links (before/after): %4 / %5';
			|it = 'Performed iterations of LES: %1
			|Number of nodes (before/after): %2 / %3
			|Number of links (before/after): %4 / %5';
			|pl = 'Performed iterations of LES: %1
			|Number of nodes (before/after): %2 / %3
			|Number of links (before/after): %4 / %5';
			|tr = 'DDS optimizasyon iterasyonları gerçekleştirildi: %1
			|Alt-varlık sayısı (önce/sonra): %2 / %3
			|Bağlantı sayısı (önce/sonra): %4 / %5'", Common.DefaultLanguageCode()),
		TrimAll(IterationCounter),
		TrimAll(NodesBeforeOptimization),
		TrimAll(NodesAfterOptimization),
		TrimAll(CommunicationsBeforeOptimization),
		TrimAll(ConnectionsAfterOptimization));
		
	CostCalculationProtocol.AdditionalInformation(CalculationParameters, ProtocolText_);
	
EndProcedure

// Defines resources for which there are non-zero costs in the node table.
//
// Parameters:
// 	CalculationParameters - See InitializeGeneralCalculationParameters
//	NodeTableName - String - name of the temporary node table
//	StructureOfCost - Structure:
//	 * Key - String - name of the sum resource
//	 * Value - Undefined - 
//	ExplanationForMeasurement - String - explanation of the SLE for output to the protocol
//
Procedure NonZeroCostOfNodesSLE(CalculationParameters, NodeTableName, StructureOfCost, ExplanationForMeasurement)
	
	If Not CheckCorrectnessOfDecisionSLE() Then
		Return;
	EndIf;
	
	Query = New Query;
	CostCalculationAppliedAlgorithms.InitializeRequestProperties(Query, CalculationParameters);
	
	QueriesTexts = New Array;
	QueryTemplate =
	"SELECT TOP 1
	|	&FieldName AS CostField
	|FROM
	|	NodeTableName AS T
	|WHERE
	|	T.FieldName <> 0";
	
	For Each KeyAndValue In StructureOfCost Do
		
		QueryText = StrReplace(QueryTemplate, "&FieldName", """" + KeyAndValue.Key + """");
		QueryText = StrReplace(QueryText, "FieldName", KeyAndValue.Key);
		QueryText = StrReplace(QueryText, "NodeTableName", NodeTableName);
		
		QueriesTexts.Add(QueryText);
		
	EndDo;
	
	Query.Text = StrConcat(QueriesTexts, TMCommonUse.QuerySeparatorInJoin());
	
	Selection = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True,,, ExplanationForMeasurement);
	SLEFields = New Structure;
	
	While Selection.Next() Do
		SLEFields.Insert(Selection.CostField);
	EndDo;
	
	CalculationParameters.Insert("SLEFields", SLEFields);
	
EndProcedure

Function CheckCorrectnessOfDecisionSLE()
	Return False; // by default, we do not check the correctness of the solution SLE
EndFunction

#EndRegion


#Region Queries

// The procedure executes a batch of requests in parts.
// At the same time, the execution time and size of the resulting temporary table for each query are measured
// , and records are generated in the cost calculation Protocol.
//
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	Query - Query - request in progress
//	IncrementPerformanceMeasurementCounter - Boolean - indicates whether the number of processed data needs to be increased for the performance Evaluation mechanism
//	NamesOfTemporaryTablesToMeasure - String - names of tables whose size will be added to the amount of processed data.
//		If there is a data sample request in the request package, then the sample size will be added to the amount of processed data unconditionally.
//	ReturnQueryResults - Boolean - defines the result returned by this function:
//		True - the results of subqueries will be returned.
//		False - samples of subquery data will be returned.
//	Explanation - String - explanation of the measurement
//	
//	Returns:
//		Array of QueryResult, QueryResult, QueryResultSelection -
//			if there is only one data sampling request in the request package, the query
//				result or the Query result selection will be returned, depending on the Return Query Results parameter,
//			otherwise an array of [Query Result or Query Result Selection] elements will be returned for each request.
//
Function ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, IncrementPerformanceMeasurementCounter = False,
			NamesOfTemporaryTablesToMeasure = "", ReturnQueryResults = False, Explanation = "") Export
	
	CalculationProtocolIsMaintained = CostCalculationProtocol.CalculationProtocolIsMaintained(CalculationParameters);
	
	If Not CalculationProtocolIsMaintained
	 And Not (TypeOf(CalculationParameters) = Type("Structure") And CalculationParameters.Property("QueryExecutionResult")) Then
		Result = Query.Execute();
		Return Result;
	EndIf;
	
	If Not CalculationProtocolIsMaintained Then

		If Not CalculationParameters.Property("QueryExecutionResult") Then
			CalculationParameters.Insert("QueryExecutionResult", "");
		Else
			CalculationParameters.QueryExecutionResult =
				CalculationParameters.QueryExecutionResult
					+ ?(CalculationParameters.QueryExecutionResult = "", "",
						Chars.LF + "////////////////////////////////////////////////////////////////////////////////"
						+ Chars.LF)
					+ ?(ValueIsFilled(Explanation), Explanation + Chars.LF, "");
		EndIf;
		
		If Not CalculationParameters.Property("QueryMeasurementTable") Then
			
			QueryMeasurementTable = New ValueTable;
			QueryMeasurementTable.Columns.Add("TableName", New TypeDescription("String"));
			QueryMeasurementTable.Columns.Add("RowsCount", New TypeDescription("Number"));
			QueryMeasurementTable.Columns.Add("RunTime", New TypeDescription("Number"));
			QueryMeasurementTable.Columns.Add("PercentageOfTime", New TypeDescription("Number"));
			QueryMeasurementTable.Columns.Add("Explanation", New TypeDescription("String"));
			
			CalculationParameters.Insert("QueryMeasurementTable", QueryMeasurementTable);
			
		EndIf;
		
	EndIf;
	
	KeepLogOfRequestExecutionInLog = CalculationProtocolIsMaintained And CalculationParameters.Property("PresentationStage")
		And Lower(CalculationParameters.PresentationStage) = Lower(TrimAll(CalculationParameters.Debug.KeepLogOfStageRequestsInLog));
	
	If KeepLogOfRequestExecutionInLog Then
		
		TableSizes = TemporaryTableSizes(CalculationParameters, True);
		ProtocolText_ = NStr("vi = 'Dung lượng của các bảng tạm hiện có';
							|ru = 'Размеры существующих временных таблиц';
							|en = 'Sizes of existing temporary tables'; fa = 'Sizes of existing temporary tables';
							|it = 'Dimensione delle tabelle temporanee esistenti';
							|pl = 'Wymiary istniejących tabel tymczasowych';
							|tr = 'Mevcut geçici tabloların boyutları'", Common.DefaultLanguageCode());
		
		For Each KeyAndValue In TableSizes Do
			ProtocolText_ = ProtocolText_ + Chars.LF + KeyAndValue.Key + ": " + KeyAndValue.Value;
		EndDo;
		
		WriteLogEvent(
			EventNameRequestExecutionProtocolForLog(CalculationParameters),
			EventLogLevel.Information,,,
			ProtocolText_);
		
	EndIf;
	
	Result = New Array;
	
	ThisIsDataFetchRequest = False;
	NumberOfSamples = 0;
	Last_Selection = -1;
	
	StructureOfTablesForMeasurement = New Structure(NamesOfTemporaryTablesToMeasure);
	
	QuerySchema = New QuerySchema;
	
	Try
		QuerySchema.SetQueryText(Query.Text);
		SchemeIsDisassembled = True;
	Except
		
		SchemeIsDisassembled = False;
		ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Không thể khởi tạo sơ đồ truy vấn:
				|%1';
				|ru = 'Не удалось инициализировать схему запроса:
				|%1';
				|en = 'Cannot initialize request schemes:
				|%1'; fa = 'Cannot initialize request schemes:
				|%1';
				|it = 'Impossibile eseguire l''inizializzazione dello schema di richiesta: 
				|%1';
				|pl = 'Nie można zainicjować schematu zapytania:
				|%1';
				|tr = 'Sorgu şeması başlatılamadı:
				|%1'", Common.DefaultLanguageCode()),
			BriefErrorDescription(ErrorInfo()));
			
		If CalculationProtocolIsMaintained Then
			
			CostCalculationProtocol.AdditionalInformation(CalculationParameters, ErrorText);
			
			If CalculationParameters.AutoTesting Then

				WriteLogEvent(
					NameOfErrorEventForLog(CalculationParameters),
					EventLogLevel.Error,,,
					CalculationParameters.PresentationStage + ":" + Chars.LF + ErrorText);
						
			EndIf;
			
		Else
			CalculationParameters.QueryExecutionResult =
				CalculationParameters.QueryExecutionResult + ?(CalculationParameters.QueryExecutionResult = "", "", Chars.LF)
				+ ErrorText;
		EndIf;
		
	EndTry;
	
	If Not SchemeIsDisassembled Then
		
		If StructureOfTablesForMeasurement.Count() = 1 Then
			TableName = NamesOfTemporaryTablesToMeasure;
		Else
			TableName = "TableNameNotDefined";
		EndIf;
		
		If Not ValueIsFilled(Explanation) And TableName = "Data" Then
			ExplanationOfTable = NStr("vi = 'Lập';
										|ru = 'Формирование';
										|en = 'Formation'; fa = 'تشکیل';
										|it = 'Formazione';
										|pl = 'Formowanie';
										|tr = 'Oluşturma'", Common.DefaultLanguageCode());
		Else
			ExplanationOfTable = Explanation;
		EndIf;
		
		If CalculationProtocolIsMaintained Then
			CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, TableName, ExplanationOfTable);
		EndIf;
		
		If KeepLogOfRequestExecutionInLog Then
			
			TextTableDescription = NStr("vi = 'Nội dung truy vấn';
										|ru = 'Текст запроса';
										|en = 'Query text'; fa = 'متن پرس‌وجو';
										|it = 'Testo della richiesta';
										|pl = 'Tekst zapytania';
										|tr = 'Sorgu metni'", Common.DefaultLanguageCode()) + " " + TableName + ":" + Chars.LF + Query.Text;
			
			WriteLogEvent(
				EventNameRequestExecutionProtocolForLog(CalculationParameters),
				EventLogLevel.Information,,,
				TextTableDescription);
			
		EndIf;
		
		ExecutionStarted = CurrentUniversalDateInMilliseconds();
		DateRequestWasLaunched = CurrentUniversalDate();
			
		If ReturnQueryResults Then
			Result = Query.ExecuteBatch();
			DataVolume = Undefined;
		Else
			Result = Query.Execute();
			If Result <> Undefined Then
				Result = Result.Select();
				DataVolume = Result.Count();
			Else
				DataVolume = Undefined;
			EndIf;
		EndIf;
		
		RunTime = (CurrentUniversalDateInMilliseconds() - ExecutionStarted) / 1000;
		TextTableDescription = StrTemplate(NStr("vi = '%1: %2 / %3 %4 / %5';
												|ru = '%1: %2 / %3 %4 / %5';
												|en = '%1: %2 / %3 %4 / %5'; fa = '%1: %2 / %3 %4 / %5';
												|it = '%1: %2 / %3 %4 / %5';
												|pl = '%1: %2 / %3 %4 / %5';
												|tr = '%1: %2 / %3 %4 / %5'"),
			TableName,
			TrimAll(DataVolume),
			CostCalculationProtocol.TimePresentation(RunTime),
			?(ExplanationOfTable = "", "", " / " + ExplanationOfTable),
			DateRequestWasLaunched);
		
		If CalculationProtocolIsMaintained Then
			
			CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters,, DataVolume);
			
			If KeepLogOfRequestExecutionInLog Then
				WriteLogEvent(
					EventNameRequestExecutionProtocolForLog(CalculationParameters),
					EventLogLevel.Information,,,
					TextTableDescription);
			EndIf;
			
		Else

			CalculationParameters.QueryExecutionResult =
				CalculationParameters.QueryExecutionResult + ?(CalculationParameters.QueryExecutionResult = "", "", Chars.LF)
				+ TextTableDescription;
			
			NwRw = CalculationParameters.QueryMeasurementTable.Add();
			NwRw.TableName = TableName;
			NwRw.RowsCount = DataVolume;
			NwRw.RunTime = RunTime;
			NwRw.Explanation = ExplanationOfTable;
			
		EndIf;
		
		Return Result;
		
	EndIf;
	
	SubqueryNumber = -1;
	
	RequestSourceText = Query.Text;
	TotalExecutionTimeOfAllRequests = 0;
	ArrayOfTableDescriptions = New Array;
	
	For Each SelectionRequest In QuerySchema.QueryBatch Do
		
		SubqueryNumber = SubqueryNumber + 1;
		
		If TypeOf(SelectionRequest) = Type("QuerySchemaTableDropQuery") Then
			
			Query.Text = "DROP" + " " + SelectionRequest.TableName;
			
			Result.Add(Query.Execute());
			
			Continue;
			
		EndIf;
		
		TableName 				= "" + SelectionRequest.PlacementTable + SelectionRequest.TableToAdd;
		ThisIsDataFetchRequest 	= Not ValueIsFilled(TableName);
		ThisIsAddRequest 	= ValueIsFilled(SelectionRequest.TableToAdd);
		
		If ThisIsDataFetchRequest Then
			NumberOfSamples = NumberOfSamples + 1;
		EndIf;
		
		SubqueryName = NStr("vi = 'Chọn lọc';
							|ru = 'Выборка';
							|en = 'Selection'; fa = 'Selection';
							|it = 'Campionatura';
							|pl = 'Dobór';
							|tr = 'Veri kümesi'", Common.DefaultLanguageCode()) + ?(NumberOfSamples = 1, "", "_" + TrimAll(NumberOfSamples));
		
		SubqueryName = StrReplace(TrimAll(SubqueryName), " ", "_"); // for the international version
		
		Query.Text = SelectionRequest.GetQueryText();
		
		// Let's perform another subquery.
		If Not ThisIsDataFetchRequest And Not ThisIsAddRequest Then
			DestroyTemporaryTables(Query, TableName);
		EndIf;
		
		If Not ValueIsFilled(Explanation) And TableName = "Data" Then
			ExplanationOfTable = NStr("vi = 'Lập';
										|ru = 'Формирование';
										|en = 'Formation'; fa = 'تشکیل';
										|it = 'Formazione';
										|pl = 'Formowanie';
										|tr = 'Oluşturma'", Common.DefaultLanguageCode());
		Else
			ExplanationOfTable = Explanation;
		EndIf;
		
		If CalculationProtocolIsMaintained Then
			
			CostCalculationProtocol.StartCreatingTemporaryTable(
				CalculationParameters,
				?(ThisIsDataFetchRequest, SubqueryName, TableName),
				ExplanationOfTable);
			
			If KeepLogOfRequestExecutionInLog Then
				
				TextTableDescription = NStr("vi = 'Nội dung truy vấn';
											|ru = 'Текст запроса';
											|en = 'Query text'; fa = 'متن پرس‌وجو';
											|it = 'Testo della richiesta';
											|pl = 'Tekst zapytania';
											|tr = 'Sorgu metni'", Common.DefaultLanguageCode()) + " "
					+ ?(ThisIsDataFetchRequest, SubqueryName, TableName) + ":" + Chars.LF + Query.Text;
				
				WriteLogEvent(
					EventNameRequestExecutionProtocolForLog(CalculationParameters),
					EventLogLevel.Information,,,
					TextTableDescription);
				
			EndIf;
			
		EndIf;
		
		ExecutionStarted = CurrentUniversalDateInMilliseconds();
		DateRequestWasLaunched = CurrentUniversalDate();
		
		Try
			SubqueryResult_ = Query.Execute();
		Except
			
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Khi điền truy vấn con %1 (%2) đã xảy ra lỗi:
					|%3';
					|ru = 'При выполнении подзапроса %1 (%2) произошла ошибка:
					|%3';
					|en = 'An error occurred while executing subquery %1 (%2):
					|%3'; fa = 'An error occurred while executing subquery %1 (%2):
					|%3';
					|it = 'Durante l''elaborazione della query subordinata %1 (%2) si è verificato un errore:
					|%3';
					|pl = 'Podczas wykonania podzapytania %1 (%2) wystąpił błąd:
					|%3';
					|tr = 'Alt sorgu %1 (%2) gerçekleştirilirken hata oluştu:
					|%3'"),
				TrimAll(SubqueryNumber),
				?(ThisIsDataFetchRequest, NStr("vi = 'chọn dữ liệu';
												|ru = 'выборка данных';
												|en = 'dataset'; fa = 'dataset';
												|it = 'selezione dati';
												|pl = 'selekcja danych';
												|tr = 'veri örneklemi'"), TableName),
				DetailErrorDescription(ErrorInfo()));
			
			If CalculationProtocolIsMaintained Then
					
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.RunTimeError,
					ProtocolText_);
					
				If KeepLogOfRequestExecutionInLog Then
					
					WriteLogEvent(
						EventNameRequestExecutionProtocolForLog(CalculationParameters),
						EventLogLevel.Information,,,
						ProtocolText_);
					
				EndIf;
				
			Else
				CalculationParameters.QueryExecutionResult =
					CalculationParameters.QueryExecutionResult + ?(CalculationParameters.QueryExecutionResult = "", "", Chars.LF)
					+ ProtocolText_;
			EndIf;
			
			Raise ProtocolText_;
			
		EndTry;
		
		If ThisIsDataFetchRequest And Not ReturnQueryResults Then
			Selection = SubqueryResult_.Select();
			DataVolume = Selection.Count();
		Else
			If CalculationProtocolIsMaintained Or Not ValueIsFilled(TableName) Then
				DataVolume = Undefined;
			Else
				DataVolume = TemporaryTableSize(Query, TableName);
			EndIf;
		EndIf;
		
		RunTime = (CurrentUniversalDateInMilliseconds() - ExecutionStarted) / 1000;
		If CalculationProtocolIsMaintained Then
			CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters,, DataVolume);
		EndIf;
		
		TextTableDescription = StrTemplate(NStr("vi = '%1: %2 / %3 %4 / %5';
												|ru = '%1: %2 / %3 %4 / %5';
												|en = '%1: %2 / %3 %4 / %5'; fa = '%1: %2 / %3 %4 / %5';
												|it = '%1: %2 / %3 %4 / %5';
												|pl = '%1: %2 / %3 %4 / %5';
												|tr = '%1: %2 / %3 %4 / %5'"),
			?(ThisIsDataFetchRequest, SubqueryName, TableName),
			Format(DataVolume, "NZ=0"),
			CostCalculationProtocol.TimePresentation(RunTime),
			?(ExplanationOfTable = "", "", " / " + ExplanationOfTable),
			DateRequestWasLaunched);
		
		If KeepLogOfRequestExecutionInLog Then
			WriteLogEvent(
				EventNameRequestExecutionProtocolForLog(CalculationParameters),
				EventLogLevel.Information,,,
				TextTableDescription);
		ElsIf Not CalculationProtocolIsMaintained Then
			
			ArrayOfTableDescriptions.Add(New Structure("TextTableDescription, QueryExecutionTime",
				TextTableDescription, RunTime));
			
			TotalExecutionTimeOfAllRequests = TotalExecutionTimeOfAllRequests + RunTime;
			
			NwRw = CalculationParameters.QueryMeasurementTable.Add();
			NwRw.TableName = ?(ThisIsDataFetchRequest, SubqueryName, TableName);
			NwRw.RowsCount = DataVolume;
			NwRw.RunTime = RunTime;
			NwRw.Explanation = ExplanationOfTable;
			
		EndIf;
		
		If ThisIsDataFetchRequest Then
			
			If ReturnQueryResults Then
				Result.Add(SubqueryResult_); // query result
			Else
				Result.Add(Selection); // Selection
			EndIf;
			
			Last_Selection = Result.Count() - 1;
			
			If IncrementPerformanceMeasurementCounter Then
				
				If ReturnQueryResults Then
					DataVolume = SubqueryResult_.Select().Count();
				Else
					DataVolume = Selection.Count();
				EndIf;
				
				If CalculationProtocolIsMaintained Then
					CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
						CalculationParameters,
						DataVolume);
				EndIf;
				
			EndIf;
			
		Else
			
			Result.Add(SubqueryResult_); // query result
			
			If CalculationProtocolIsMaintained And IncrementPerformanceMeasurementCounter And StructureOfTablesForMeasurement.Property(TableName) Then
				
				CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
					CalculationParameters,
					TemporaryTableSize(CalculationParameters, TableName));
				
			EndIf;
			
		EndIf;
		
	EndDo;
	
	If Not CalculationProtocolIsMaintained Then
		
		QueryExecutionResults = New Array;
		TableNumber = 0;
		
		For Each TableDetails In ArrayOfTableDescriptions Do
			
			PercentageOfTotalTime = ?(TotalExecutionTimeOfAllRequests = 0, 0,
				Round(TableDetails.QueryExecutionTime / TotalExecutionTimeOfAllRequests * 100, 2));
				
			QueryExecutionResults.Add(
				StrTemplate("%1 / %2%%",
					TableDetails.TextTableDescription,
					PercentageOfTotalTime));
					
			CalculationParameters.QueryMeasurementTable[CalculationParameters.QueryMeasurementTable.Count() - ArrayOfTableDescriptions.Count() + TableNumber].PercentageOfTime = PercentageOfTotalTime;
			TableNumber = TableNumber + 1;
			
		EndDo;
		
		CalculationParameters.QueryExecutionResult =
			CalculationParameters.QueryExecutionResult + ?(CalculationParameters.QueryExecutionResult = "", "", Chars.LF)
			+ StrConcat(QueryExecutionResults, Chars.LF);
		
	EndIf;
	
	Query.Text = RequestSourceText;
	
	If NumberOfSamples = 1 Then
		Return Result[Last_Selection]; // Selection
	EndIf;
		
	Return Result; // array of results
	
EndFunction

Function InitializeRequestBasedOnParameters(QueryOptions, TemporaryTable) Export
	
	Query = New Query;
	Query.TempTablesManager = TemporaryTable;
	
	For Each Parameter In QueryOptions Do
		Query.SetParameter(Parameter.Key, Parameter.Value);
	EndDo;
	
	Return Query;
	
EndFunction

Procedure ReplaceTrafficModeWithServiceMode(RegisterDescription, FieldText, FieldAlias = "OfficialTypeOfMovementParish")
	
	If RegisterDescription.ThereIsPropertyTypeOfMovement Then
		FieldText = StrReplace(FieldText,
			"T." + FieldAlias,
			"CASE WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt) THEN TRUE ELSE FALSE END AS OfficialTypeOfMovementParish");
	EndIf;
	
EndProcedure
	
Procedure ReplaceTrafficViewWithPlatformView(RegisterDescription, FieldText, FieldAlias = "OfficialTypeOfMovementParish")
	
	If RegisterDescription.ThereIsPropertyTypeOfMovement Then
		FieldText = StrReplace(FieldText,
			"T." + FieldAlias,
			"CASE WHEN T.OfficialTypeOfMovementParish THEN VALUE(AccumulationRecordType.Receipt) ELSE VALUE(AccumulationRecordType.Expense) END AS RecordType");
	EndIf;
		
EndProcedure

Procedure ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, RequestOrText,
		ByCompany = Undefined, OnOfficialSoftwareAnd = Undefined,
		AccordingToCostCalculation = Undefined, ByCalculation = Undefined, ByNonReadableRecordType = Undefined)
		
	QueryText = ?(TypeOf(RequestOrText) = Type("String"), RequestOrText, RequestOrText.Text);
	
	// Register name
	QueryText = StrReplace(QueryText, "RegisterCacheTableName", 				RegisterDescription.RegisterCacheTableName);
	QueryText = StrReplace(QueryText, "NameOfCalculatedRegisterRevolutionsTable", RegisterDescription.NameOfCalculatedRegisterRevolutionsTable);
	QueryText = StrReplace(QueryText, "NameOfCalculatedRegisterBalancesTable", RegisterDescription.NameOfCalculatedRegisterBalancesTable);
	QueryText = StrReplace(QueryText, "NameOfMainRegisterTable",			RegisterDescription.FullRegisterName);
	
	// selection of the organization
	If ByCompany <> Undefined Then
		
		If RegisterDescription.ThereIsACompany Then
			FilterByCompany = "AND %NOT T.Organization IN (&CompanyArray)";
		ElsIf RegisterDescription.ThereAreAnalyticsPartners Then
			FilterByCompany = "AND %NOT T.AccountingDimensionByPartners IN (SELECT Filter.DimensionKey FROM TTPartnerAnalyticsSelection AS Filter)";
		Else
			FilterByCompany = "";
		EndIf;
		
		FilterByCompany = StrReplace(FilterByCompany, "%NOT ", ?(ByCompany, "", "NOT "));
		QueryText = StrReplace(QueryText, "AND &FilterByCompany", FilterByCompany);
		QueryText = StrReplace(QueryText, "%FilterByCompany", FilterByCompany);
		
	EndIf;
	
	SelectionByServiceDetails = "";
	
	// Selections by service details
	If OnOfficialSoftwareAnd <> Undefined Then
		
		If AccordingToCostCalculation <> Undefined Then
			If RegisterDescription.ThereIsCostCalculation Then
				SelectionByServiceDetails = SelectionByServiceDetails
					+ ?(SelectionByServiceDetails = "", "", ?(OnOfficialSoftwareAnd, " And ", " OR "))
					+ ?(AccordingToCostCalculation, "", "NOT ") + "T.CalculationOfCost";
			ElsIf Not RegisterDescription.IsAccumulationRegister Then
				// The data registers do not have a resource for calculating the cost.
				// All their movements are considered calculated.
				SelectionByServiceDetails = SelectionByServiceDetails
					+ ?(SelectionByServiceDetails = "", "", ?(OnOfficialSoftwareAnd, " And ", " OR "))
					+ ?(AccordingToCostCalculation, "TRUE", "FALSE");
			EndIf;
		EndIf;
		
		If CalculationParameters.BatchCalculationStarted Then
			
			If ByCalculation <> Undefined And RegisterDescription.ThereIsCalculationOfParties Then
				SelectionByServiceDetails = SelectionByServiceDetails
					+ ?(SelectionByServiceDetails = "", "", ?(OnOfficialSoftwareAnd, " And ", " OR "))
					+ ?(ByCalculation, "", "NOT ") + "T.LotCalculation";
			EndIf;
			
			If ByNonReadableRecordType <> Undefined And RegisterDescription.ThisIsCostRegister Then
				SelectionByServiceDetails = SelectionByServiceDetails
					+ ?(SelectionByServiceDetails = "", "", ?(OnOfficialSoftwareAnd, " And ", " OR "))
					+ "(" + ?(Not ByNonReadableRecordType, "", "NOT ") + "T.EntryType IN (&UnreadableRecordTypes)"
					+ ?(Not ByNonReadableRecordType, " OR ", " AND NOT ") + "T.Organization IN (&MediumSlipOrganizations)" + ")";
			EndIf;
			
		EndIf;
		
		If Not IsBlankString(SelectionByServiceDetails) Then
			SelectionByServiceDetails = "AND (" + SelectionByServiceDetails + ")";
		EndIf;
		
	EndIf;
	
	QueryText = StrReplace(QueryText, "AND &SelectionByServiceDetails", SelectionByServiceDetails);
	
	If TypeOf(RequestOrText) = Type("String") Then
		RequestOrText = QueryText;
	Else
		RequestOrText.Text = QueryText;
	EndIf;
	
EndProcedure

Function EmptyRegisterLoggers(RegisterName) Export
	
	ArrayOfLoggerDescriptions = New Array();
	
	For Each MetadataOfDocument In Metadata.Documents Do
		
		If MetadataOfDocument.RegisterRecords.Contains(Metadata.AccumulationRegisters[RegisterName]) Then
			ArrayOfLoggerDescriptions.Add("VALUE(Document." + MetadataOfDocument.Name + ".EmptyRef)");
		EndIf;
		
	EndDo;
	
	Return StrConcat(ArrayOfLoggerDescriptions, ",");
	
EndFunction

Function AvailableDocumentTypes(RegisterName, AttributeName) Export
	
	ArrayOfTypeDescriptions = New Array();
	
	AttributeType = Undefined;
	
	If Metadata.AccumulationRegisters.Find(RegisterName) = Undefined Then
		AttributeType = Undefined;
	ElsIf Metadata.AccumulationRegisters[RegisterName].Attributes.Find(AttributeName) <> Undefined Then
		AttributeType = Metadata.AccumulationRegisters[RegisterName].Attributes[AttributeName].Type;
	ElsIf Metadata.AccumulationRegisters[RegisterName].Dimensions.Find(AttributeName) <> Undefined Then
		AttributeType = Metadata.AccumulationRegisters[RegisterName].Dimensions[AttributeName].Type;
	Else
		AttributeType = Undefined;
	EndIf;
	
	If AttributeType = Undefined Then
		Return "";
	EndIf;
	
	For Each DocumentType In AttributeType.Types() Do
		If DocumentType = Type("String") Then
			ArrayOfTypeDescriptions.Add("TYPE(Document.RegisterAdjustment)");
		Else
			MetadataOfDocument = Metadata.FindByType(DocumentType);
			ArrayOfTypeDescriptions.Add("TYPE(Document." + MetadataOfDocument.Name + ")");
		EndIf;
	EndDo;
	
	Return StrConcat(ArrayOfTypeDescriptions, ", ");
	
EndFunction

Function AvailableLoggerTypes(RegisterName) Export
	
	ArrayOfTypeDescriptions = New Array();
	
	RegisterMetadata = ?(Metadata.AccumulationRegisters.Find(RegisterName) <> Undefined,
		Metadata.AccumulationRegisters[RegisterName],
		Metadata.InformationRegisters[RegisterName]);
	
	For Each MetadataOfDocument In Metadata.Documents Do
		
		If MetadataOfDocument.RegisterRecords.Contains(RegisterMetadata) Then
			ArrayOfTypeDescriptions.Add("TYPE(Document." + MetadataOfDocument.Name + ")");
		EndIf;
		
	EndDo;
	
	Return StrConcat(ArrayOfTypeDescriptions, ", ");
	
EndFunction

//@skip-warning Count Parameters
Procedure MakeRequestForFieldDescriptions(CalculationParameters, FieldDescriptionTable, RegisterName, TemporaryTableNameSource, TemporaryTableNameReceiver,
			ConditionWHERE = Undefined, ParametersStructure = Undefined, DeleteUnwrittenData = True, FillInServiceFields = True) Export
	
	If CalculationParameters.RegisterRecords.Property(RegisterName) Then
		ReceiverDescription = CalculationParameters.RegisterRecords[RegisterName];
	Else
		ReceiverDescription = CalculationParameters.AuxiliaryTemporaryTables[RegisterName];
	EndIf;
	
	ThisIsCostRegister = (RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name);
	ThisIsRevenueRegister = (RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name);
	ThisIsVATToBeDistributed = (RegisterName = Metadata.AccumulationRegisters.LotsVATForAllocation.Name);
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	If ParametersStructure <> Undefined Then
		For Each KeyValue In ParametersStructure Do
			Query.SetParameter(KeyValue.Key, KeyValue.Value);
		EndDo;
	EndIf;
	
	// Fill in the service field of the calculation of the cost
	If ReceiverDescription.ThereIsCostCalculation Then
		
		If FillInServiceFields Then
			ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CalculationOfCost",
				?(CalculationParameters.PartiesAreBeingCalculated, "FALSE", "TRUE"));
		Else
			ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "CalculationOfCost", "CalculationOfCost");
		EndIf;
		
	EndIf;
	
	// Fill in the service field Calculation of parties
	If ThisIsCostRegister And CalculationParameters.LotsAreFilledInAtCostPrice Then
		
		If FillInServiceFields Then
			ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotCalculation",
				"ThisIsExactlyCalculatedMovement OR NOT (EntryType IN (&TypesOfPrimaryMotionRecordings))");
		Else
			ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotCalculation", "LotCalculation");
		EndIf;
		
	ElsIf ThisIsVATToBeDistributed Then
		
		ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotCalculation", "TRUE"); // there is only one service Attribute in the register
		
	ElsIf ReceiverDescription.ThereIsCalculationOfParties
	 And Not (ThisIsCostRegister And CalculationParameters.LotsAreFilledInAtCostPrice)
	 And Not (ThisIsRevenueRegister And CalculationParameters.BatchesInRevenueAreFilledIn) Then
	
		If FillInServiceFields Then
			ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotCalculation",
				?(CalculationParameters.PartiesAreBeingCalculated, "TRUE", "FALSE"));
		Else
			ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "LotCalculation", "LotCalculation");
		EndIf;
		
	EndIf;
	
	// Let's exclude unrecorded movements
	If DeleteUnwrittenData And CalculationParameters.PartiesAreBeingCalculated And CalculationParameters.Property("DistributionOfParties") Then
		
		UnwrittenData = CalculationParameters.DistributionOfParties.UnwrittenData;
		
		ConditionNonWritableData = "";
		
		If TemporaryTableColumnExists(CalculationParameters, TemporaryTableNameSource, "CalculationIsCompleted")
		 And Not UnwrittenData.RecordUnfinishedTasks Then
			ConditionNonWritableData = "CalculationIsCompleted";
		EndIf;
		
		If ValueIsFilled(UnwrittenData.UnrecordedRecordTypes) Then
			
			Query.SetParameter(
				"UnrecordedRecordTypes",
				TMCommonUseClientServer.ConvertMatchOrStructureToArray(UnwrittenData.UnrecordedRecordTypes));
			
			ConditionNonWritableData = ConditionNonWritableData + ?(ConditionNonWritableData = "", "", "
				|	AND ") + "NOT EntryType IN (&UnrecordedRecordTypes)";
			
		EndIf;
		
		If ValueIsFilled(UnwrittenData.UnwrittenPartitions) Then
			
			Query.SetParameter(
				"UnwrittenPartitions",
				TMCommonUseClientServer.ConvertMatchOrStructureToArray(UnwrittenData.UnwrittenPartitions));
			
			ConditionNonWritableData = ConditionNonWritableData + ?(ConditionNonWritableData = "", "", "
				|	AND ") + "NOT AccountingSection IN (&UnwrittenPartitions)";
			
		EndIf;
		
		If ValueIsFilled(UnwrittenData.UnrecordedLoggers) Then
			
			NonWritableTypesOfLoggers = New Array;
			
			For Each KeyAndValue In UnwrittenData.UnrecordedLoggers Do
				NonWritableTypesOfLoggers.Add(Type("DocumentRef." + KeyAndValue.Key));
			EndDo;
			
			Query.SetParameter("NonWritableTypesOfLoggers", NonWritableTypesOfLoggers);
			
			ConditionNonWritableData = ConditionNonWritableData + ?(ConditionNonWritableData = "", "", "
				|	AND ") + "NOT VALUETYPE(Recorder) IN (&NonWritableTypesOfLoggers)";
			
		EndIf;
		
		If ValueIsFilled(ConditionNonWritableData) Then
			ConditionWHERE = ?(Not ValueIsFilled(ConditionWHERE), "", "
				|	AND ") + ConditionNonWritableData;
		EndIf;
		
	EndIf;
	
	FieldsDetails = GetDescriptionOfRequestFields(FieldDescriptionTable, ReceiverDescription.Table);
	
	Query.Text =
	"SELECT
	|	&FieldsDetails
	|INTO TemporaryTableNameReceiver
	|FROM
	|	TemporaryTableNameSource
	|WHERE 
	|	&ConditionWHERE";
	
	Query.Text = StrReplace(Query.Text, "&FieldsDetails", FieldsDetails);
	Query.Text = StrReplace(Query.Text, "TemporaryTableNameReceiver", TemporaryTableNameReceiver);
	Query.Text = StrReplace(Query.Text, "TemporaryTableNameSource", TemporaryTableNameSource);
	Query.Text = StrReplace(Query.Text, "&ConditionWHERE", ?(ValueIsFilled(ConditionWHERE), ConditionWHERE, "TRUE"));
	
	Query.Execute();
	
EndProcedure

// Returns a description of the request fields.
// 
// Parameters:
// 	ReceiverDescription - ValueTable -
// Returns:
// 	ValueTable - LongDesc:
// * Field - String -
// * Presentation - String -
Function GenerateDescriptionOfRequestFields(ReceiverDescription) Export
	
	FieldDescriptionTable = New ValueTable;
	FieldDescriptionTable.Columns.Add("Field", New TypeDescription("String"));
	FieldDescriptionTable.Columns.Add("Presentation", New TypeDescription("String"));
	
	For Each DestinationColumn In ReceiverDescription.Columns Do
		NewRow = FieldDescriptionTable.Add();
		NewRow.Presentation = Upper(DestinationColumn.Name);
		
		If DestinationColumn.ValueType.Types().Count() > 1 Then
			NewRow.Field = "Undefined";
			Continue;
		EndIf;
		
		ColumnType = DestinationColumn.ValueType.Types().Get(0);
		MetadataObject = Metadata.FindByType(ColumnType);
		
		If ColumnType = Type("Boolean") Then
			NewRow.Field = "FALSE";
		ElsIf ColumnType = Type("Number") Then
			NewRow.Field = "0";
		ElsIf ColumnType = Type("Date") Then
			NewRow.Field = "DATETIME(1,1,1,0,0,0)";
		ElsIf ColumnType = Type("String") Then
			NewRow.Field = """""";
		ElsIf ColumnType = Type("AccumulationRecordType") Then
			NewRow.Field = "VALUE(AccumulationRecordType.Receipt)";
		ElsIf MetadataObject <> Undefined Then
			NewRow.Field = "VALUE(" + MetadataObject.FullName() + ".EmptyRef)";
		Else
			NewRow.Field = "Undefined";
		EndIf;
		
	EndDo;
	
	If ReceiverDescription.Columns.Find("RecordType") <> Undefined Then
		
		ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "OfficialTypeOfMovementParish", "
		|CASE WHEN RecordType = VALUE(AccumulationRecordType.Receipt)
		|	THEN TRUE
		|	ELSE FALSE
		|END
		|");
		
	EndIf;
	
	Return FieldDescriptionTable;
	
EndFunction

Function CopyRequestFields(FieldDescriptionTable ,CopiedFields) Export
	
	FieldArray = StrSplit(CopiedFields, ",");
	For Each Field In FieldArray Do
		MField = StrReplace(StrReplace(TrimAll(Field), Chars.LF, ""), Chars.Tab, "");
		StringField = FieldDescriptionTable.Find(Upper(MField), "Presentation");
		If StringField <> Undefined Then
			StringField.Field = MField;
		EndIf;
	EndDo;
	
	Return FieldDescriptionTable;
	
EndFunction

// Adds a field to the query in the description field.
// 
// Parameters:
// 	FieldDescriptionTable - ValueTable -
// 	Field - String -
// 	Presentation - String -
Procedure AddFieldToRequestFieldDescription(FieldDescriptionTable, Field, Presentation) Export
	
	NewRow = FieldDescriptionTable.Add();
	NewRow.Field = Field;
	NewRow.Presentation = Upper(Presentation);
	
EndProcedure

Procedure ChangeFieldInRequestFieldDescription(FieldDescriptionTable, Field_Source, Field, Presentation = Undefined) Export
	
	FieldDetails = FieldDescriptionTable.Find(Upper(Field_Source), "Presentation");
	If FieldDetails <> Undefined Then
		FieldDetails.Field = Field;
		If Presentation <> Undefined Then
			FieldDetails.Presentation = Upper(Presentation);
		EndIf;
	EndIf;
	
EndProcedure

Procedure ChangeTrafficLoggerAndDocumentInRequestFieldDescription(FieldDescriptionTable, RegisterName, SubjectToAdjustment = False) Export
	
	MetaRegister = Metadata.AccumulationRegisters[RegisterName];
	
	ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "Recorder", "
		|CASE WHEN DocumentRegisterRecords IS NULL OR DocumentRegisterRecords = UNDEFINED 
		|  OR DocumentRegisterRecords IN(" + EmptyRegisterLoggers(RegisterName) + ")
		|	THEN &DummyRegistrar
		|	ELSE DocumentRegisterRecords
		|END");
	
	If MetaRegister.Attributes.Find("DocumentRegisterRecords") <> Undefined
	 Or MetaRegister.Dimensions.Find("DocumentRegisterRecords") <> Undefined Then
	 
		ChangeFieldInRequestFieldDescription(FieldDescriptionTable, "DocumentRegisterRecords", "
			|CASE WHEN VALUETYPE(DocumentRegisterRecords) IN (" + AvailableDocumentTypes(RegisterName, "DocumentRegisterRecords") + ")
			|  " + ?(SubjectToAdjustment, "AND NOT ThisIsAdjustment", "") + "
			|	THEN DocumentRegisterRecords
			|	ELSE UNDEFINED
			|END");
		
 	EndIf;
 	
EndProcedure

Function GetRequestFieldValue(FieldDescriptionTable ,Presentation) Export
	
	Value = "Undefined";
	
	FieldDetails = FieldDescriptionTable.Find(Upper(Presentation), "Presentation");
	If FieldDetails <> Undefined Then
		Value = FieldDetails.Field;
	EndIf;
	
	Return Value;
	
EndFunction

// Gets a string description of the request fields.
// 
// Parameters:
// 	FieldDescriptionTable - ValueTable - 
// 	ReceiverDescription - ValueTable -
// Returns:
// 	String - Description of the request fields
Function GetDescriptionOfRequestFields(FieldDescriptionTable, ReceiverDescription) Export
	
	FieldsDetails = "";
	ArrayOfFieldDescriptions = New Array;
	
	For Each DestinationColumn In ReceiverDescription.Columns Do
		
		StringField = FieldDescriptionTable.Find(Upper(DestinationColumn.Name));
		If StringField = Undefined Then
			ArrayOfFieldDescriptions.Add(Chars.Tab + "Undefined" + " AS " + DestinationColumn.Name);
		Else
			ArrayOfFieldDescriptions.Add(Chars.Tab + StringField.Field + " AS " + DestinationColumn.Name);
		EndIf;
		
	EndDo;
	
	FieldsDetails = StrConcat(ArrayOfFieldDescriptions, "," + Chars.LF);
	
	Return FieldsDetails;
	
EndFunction

// Returns the title of the request text.
// 
// Parameters:
// 	RowsCount - Number, Undefined - number of rows to select
// 	SelectDistinct - Boolean - select different entries
//
// Returns:
// 	String - Request header
//
Function GETRequestHeader(RowsCount = Undefined, SelectDistinct = False) Export
	
	If SelectDistinct Then
		Title = "SELECT DISTINCT &Field";
	Else
		If RowsCount = Undefined Then
			Title = "SELECT &Field";
		Else
			Title = "SELECT TOP 1 &Field";
			Title = StrReplace(Title, "1", Format(RowsCount, "NZ=0; NG=0"));
		EndIf;
	EndIf;
	
	Title = StrReplace(Title, "&Field", "");
	
	Return TrimAll(Title);
	
EndFunction

