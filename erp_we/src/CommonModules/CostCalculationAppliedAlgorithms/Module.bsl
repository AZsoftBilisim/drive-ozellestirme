	QueryTexts.Add(
	"SELECT
	|	Costs.Organization									AS Organization,
	|	Costs.ProductionLot						AS ProductionLot,
	|	Costs.Cost_												AS Cost_
	|INTO BatchesWithCostsAfterProductionDate
	|FROM
	|	(SELECT
	|		Costs.Organization											AS Organization,
	|		Costs.Lot														AS ProductionLot,
	|		Costs.ItemsLocationAttributes.Products	AS Cost_,
	|		Costs.CountBalance								AS Count
	|	FROM
	|		AccumulationRegister.InventoryCost.Balance(
	|			,
	|			Organization IN (
	|				SELECT
	|					Companies.Organization
	|				FROM OrganizationsToCalculateCost AS Companies
	|			)
	|			AND VALUETYPE(Lot) = TYPE(Catalog.ProductionLots)
	|			AND Lot IN(
	|				SELECT
	|					CompletedBatches.Lot AS Lot
	|				FROM
	|					CompletedBatches AS CompletedBatches)
	|		) AS Costs
	|	
	|	UNION ALL
	|
	|	SELECT
	|		Costs.Organization											AS Organization,
	|		Costs.Lot														AS ProductionLot,
	|		Costs.ItemsLocationAttributes.Products	AS Cost_,
	|		-Costs.CountBalance								AS Count
	|	FROM
	|		AccumulationRegister.InventoryCost.Balance(
	|			&BorderEndOfPeriod,
	|			Organization IN (
	|				SELECT
	|					Companies.Organization
	|				FROM OrganizationsToCalculateCost AS Companies
	|			)
	|			AND VALUETYPE(Lot) = TYPE(Catalog.ProductionLots)
	|			AND Lot IN(
	|				SELECT
	|					CompletedBatches.Lot AS Lot
	|				FROM
	|					CompletedBatches AS CompletedBatches)
	|		) AS Costs
	|	
	|	UNION ALL
	|
	|	SELECT
	|		Costs.Organization											AS Organization,
	|		Costs.ProductionLot								AS ProductionLot,
	|		Costs.WorkKind													AS Cost_,
	|		Costs.CountBalance								AS Count
	|	FROM
	|		AccumulationRegister.WIPLaborCosts.Balance(
	|			,
	|			Organization IN (
	|				SELECT
	|					Companies.Organization
	|				FROM OrganizationsToCalculateCost AS Companies
	|			)
	|			AND ProductionLot IN(
	|				SELECT
	|					CompletedBatches.Lot AS Lot
	|				FROM
	|					CompletedBatches AS CompletedBatches)
	|		) AS Costs
	|	
	|	UNION ALL
	|
	|	SELECT
	|		Costs.Organization											AS Organization,
	|		Costs.ProductionLot								AS ProductionLot,
	|		Costs.WorkKind													AS Cost_,
	|		-Costs.CountBalance								AS Count
	|	FROM
	|		AccumulationRegister.WIPLaborCosts.Balance(
	|			&BorderEndOfPeriod,
	|			Organization IN (
	|				SELECT
	|					Companies.Organization
	|				FROM OrganizationsToCalculateCost AS Companies
	|			)
	|			AND ProductionLot IN(
	|				SELECT
	|					CompletedBatches.Lot AS Lot
	|				FROM
	|					CompletedBatches AS CompletedBatches)
	|		) AS Costs
	|	) AS Costs
	|
	|GROUP BY
	|	Costs.Organization,
	|	Costs.ProductionLot,
	|	Costs.Cost_
	|
	|HAVING
	|	SUM(Costs.Count) > 0
	|;
	|////////////////////////////////////////////////////////////////////////////////
