// Procedure-handler for checking the state of the system "Zapisisprizachetnezavershen".
//
// Parameters:
//	CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure CheckingRecordsWithCalculationNotCompletedAttribute(CheckParameters) Export
	
	ParameterValues = CalculationOfCostCached.ValuesOfTechnologicalParameters();
	
	AutoTesting = MonthEndTransactionsServer.ValueOfAdditionalVerificationParameter(
		CheckParameters,
		"AutoTesting",
		False);
	
	// The check is performed in autotests or if the corresponding technological parameter is explicitly enabled.
	If Not AutoTesting And Not ParameterValues.CheckRecordsWithCalculationNotCompletedAttribute Then
		Return;
	EndIf;
	
	QueryText = "";
	QueryTextTemplate2  =
	"SELECT
	|	T.CompanyFieldName1 AS Organization,
	|	""ShortRegisterName"" AS RegisterName,
	|	T.Recorder AS Recorder,
	|	SUM(1) AS NumberOfRegisteredRecords
	|INTO NameOfIntermediateVT_1
	|FROM
	|	NameOfMainRegisterTable AS T
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.CompanyFieldName1 IN(&CompanyArray)
	|	AND T.CalculationIsNotCompleted
	|	AND NOT T.Recorder REFS Document.RegisterAdjustment
	|	AND T.Active
	|
	|GROUP BY
	|	T.CompanyFieldName1,
	|	T.Recorder
	|"; // @query-part-1
	
	For Each KeyAndValue In CalculationOfCost.OutgoingMechanismData() Do
		
		MetaRegister = KeyAndValue.Key;
		
		If Not Metadata.AccumulationRegisters.Contains(MetaRegister)
		 Or MetaRegister.Attributes.Find("CalculationIsNotCompleted") = Undefined Then
			Continue;
		EndIf;
		
		RequestTextExtension = ?(QueryText = "", "", "
			|
			|UNION ALL
			|
			|") + QueryTextTemplate2;
		
		RequestTextExtension = StrReplace(RequestTextExtension, "CompanyFieldName1",
			?(MetaRegister.Dimensions.Find("Organization") = Undefined, "AccountingDimensionByPartners.Organization", "Organization"));
		RequestTextExtension = StrReplace(RequestTextExtension, "ShortRegisterName", MetaRegister.Name);
		RequestTextExtension = StrReplace(RequestTextExtension, "NameOfMainRegisterTable", "AccumulationRegister." + MetaRegister.Name);
		RequestTextExtension = StrReplace(RequestTextExtension, "INTO NameOfIntermediateVT_1",
			?(QueryText = "", "INTO TTDocumentsWithBlankBatch", ""));
		
		QueryText = QueryText + RequestTextExtension;
		
	EndDo;
	
	QueryText = TrimAll(QueryText);
	
	FieldList = New ValueList;
	FieldList.Add("Organization", 		NStr("vi = 'Doanh nghiệp';
												|ru = 'Организация';
												|en = 'Company'; fa = 'Company';
												|it = 'Azienda';
												|pl = 'Company';
												|tr = 'İş yeri'", Common.DefaultLanguageCode()));
	FieldList.Add("RegisterName", 		NStr("vi = 'Tên biểu ghi';
												|ru = 'Имя регистра';
												|en = 'Register name'; fa = 'نام رجیستر';
												|it = 'Nome del registro';
												|pl = 'Nazwa rejestru';
												|tr = 'Kayıt adı'", Common.DefaultLanguageCode()));
	FieldList.Add("Recorder", 		NStr("vi = 'Chứng từ';
											|ru = 'Документ';
											|en = 'Document'; fa = 'سند';
											|it = 'Documento';
											|pl = 'Document';
											|tr = 'Belge'", Common.DefaultLanguageCode()));
	FieldList.Add("NumberOfRegisteredRecords", 	NStr("vi = 'Số lượng bản ghi kết chuyển';
														|ru = 'Количество движений';
														|en = 'Number of records'; fa = 'تعداد ثبت‌ها';
														|it = 'Quantità dei movimenti';
														|pl = 'Ilość ruchów';
														|tr = 'Hareket miktarı'", Common.DefaultLanguageCode()));
	
	RegistrationParameters = MonthEndTransactionsServer.InitializeRegistrationAndVerificationParameters(
		"TTDocumentsWithBlankBatch",
		NStr("vi = 'Đã tìm thấy các lô chưa được chọn trong bản ghi kết chuyển của chứng từ trong doanh nghiệp ""%1"" trong kỳ %2';
			|ru = 'Обнаружены неподобранные партии в движениях документов организации ""%1"" за период %2';
			|en = 'Unpicked lots are found in document records of the ""%1"" company for period %2'; fa = 'Unpicked lots are found in document records of the ""%1"" company for period %2';
			|it = 'Rilevate dei lotti non selezionati nei movimenti dei documenti dell''organizzazione ""%1"" per il periodo %2';
			|pl = 'Wykryto nie dobrane partie w ruchach dokumentów firmy ""%1"" za okres %2';
			|tr = '""%1"" iş yerinin belge kayıtlarında %2 dönemi için eşleşmeyen lotlar tespit edildi'", Common.DefaultLanguageCode()),
		FieldList,
		"Recorder");
		
	MonthEndTransactionsServer.RegisterValidationIssues(
		CheckParameters,
		RegistrationParameters,
		QueryText);
	
EndProcedure

Function QueryTextForCheckingCalculationResultByQuantity()
	
	QueryText =
	"SELECT
	|	T.Organization 							AS Organization,
	|	T.AccountingSection 							AS AccountingSection,
	|	T.ItemsLocationAttributes 			AS ItemsLocationAttributes,
	|	T.InventoryOwnerAttribute 							AS InventoryOwnerAttribute,
	|	T.VATActivityType 					AS VATActivityType,
	|	T.Lot 								AS Lot,
	|	T.LotVendorAttributes 					AS LotVendorAttributes,
	|	T.FinancialAccountingDimension 			AS FinancialAccountingDimension,
	|	MAX(T.CountClosingBalance)	AS Count
	|INTO TTNegativeBatchBalances
	|FROM
	|	AccumulationRegister.InventoryCost.BalanceAndTurnovers(&BeginOfPeriod, &EndOfPeriod,,,
	|		Organization IN (&CompanyArray)
	|		AND &BatchAccountingVersion22
	|		AND VALUETYPE(Lot) <> TYPE(Catalog.ProductionLots)
	|		AND AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.UninvoicedDeliveries)
	|		AND AccountingSection <> VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsInTransitFromVendors)
	|		AND NOT ((ItemsLocationAttributes, AccountingSection, InventoryOwnerAttribute, Organization ) IN
	|			(SELECT T.ItemsLocationAttributes, T.AccountingSection, T.InventoryOwnerAttribute, T.Organization FROM RecyclableWaste AS T))
	|	) AS T
	|	LEFT JOIN TTNegativeBalances AS NegativeBalancesByQuantity
	|	ON NegativeBalancesByQuantity.AccountingSection = T.AccountingSection
	|		AND NegativeBalancesByQuantity.InventoryOwnerAttribute = T.InventoryOwnerAttribute
	|		AND NegativeBalancesByQuantity.Organization = T.Organization
	|		AND NegativeBalancesByQuantity.ItemsLocationAttributes = T.ItemsLocationAttributes
	|WHERE
	|	T.CountClosingBalance < 0 AND NegativeBalancesByQuantity.Count IS NULL
	|	AND (T.CountReceipt <> 0 OR T.CountExpense <> 0)
	|
	|GROUP BY
	|	T.Organization,
	|	T.AccountingSection,
	|	T.ItemsLocationAttributes,
	|	T.InventoryOwnerAttribute,
	|	T.VATActivityType,
	|	T.Lot,
	|	T.LotVendorAttributes,
	|	T.FinancialAccountingDimension";
	
	Return QueryText;
	
EndFunction

Function TextOfOrganizationToCalculateCost()
	
	QueryText =
	"SELECT DISTINCT
	|	Jobs.Organization AS Organization
	|INTO OrganizationsToCalculateCost
	|FROM InformationRegister.JobsForCalculatingCost AS Jobs
	|WHERE
	|	Jobs.Organization IN (&CompanyArray)
	|	AND Jobs.Month < &EndOfPeriod
	|INDEX BY
	|	Organization";
	
	Return QueryText;
	
EndFunction

Function QueryTextRecyclableWaste()
	
	QueryText =
	"SELECT DISTINCT
	|	Waste.ItemsLocationAttributes,
	|	Waste.AccountingSection,
	|	Waste.InventoryOwnerAttribute,
	|	Waste.Organization
	|INTO RecyclableWaste
	|FROM
	|	AccumulationRegister.InventoryCost AS Waste
	|WHERE
	|	Waste.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND Waste.Organization IN (&CompanyArray)
	|	AND Waste.RecordType = VALUE(AccumulationRecordType.Receipt)
	|	AND Waste.Count < 0
	|	AND Waste.Active
	|	AND Waste.AccountingSection IN (
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts),
	|		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedForRespSafekeeping))
	|	AND Waste.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)
	|
	|INDEX BY
	|	Waste.ItemsLocationAttributes,
	|	Waste.AccountingSection,
	|	Waste.InventoryOwnerAttribute,
	|	Waste.Organization
	|";
	
	Return QueryText;
	
EndFunction

// Generates the query text for getting a temporary table of completed production batches
// 
// Returns:
// 	String - The text of the request for the formation of a temporary table of completed parties
Function QueryTextCompletedBatches() Export
	
	Return
	"SELECT DISTINCT
	|	UsedMaterials.Lot AS Lot
	|INTO ProductionLotsPreliminary
	|FROM
	|	AccumulationRegister.InventoryCost.BalanceAndTurnovers(&BeginOfPeriod, &EndOfPeriod, Period,,
	|		Organization IN (&CompanyArray)
	|		AND VALUETYPE(Lot) = TYPE(Catalog.ProductionLots)
	|		AND NOT Lot = VALUE(Catalog.ProductionLots.EmptyRef)
	|	) AS UsedMaterials
	|	
	|UNION
	|	
	|SELECT DISTINCT
	|	OtherItems.ProductionLot AS Lot
	|FROM
	|	AccumulationRegister.OtherWorkInProgressExpenses.BalanceAndTurnovers(&BeginOfPeriod, &EndOfPeriod, Period,,
	|		Organization IN (&CompanyArray)
	|		AND VALUETYPE(ProductionLot) = TYPE(Catalog.ProductionLots)
	|		AND NOT ProductionLot = VALUE(Catalog.ProductionLots.EmptyRef)) AS OtherItems
	|	
	|UNION
	|	
	|SELECT DISTINCT
	|	Labor.ProductionLot AS Lot
	|FROM
	|	AccumulationRegister.WIPLaborCosts.BalanceAndTurnovers(&BeginOfPeriod, &EndOfPeriod, Period,,
	|		Organization IN (&CompanyArray)
	|		AND VALUETYPE(ProductionLot) = TYPE(Catalog.ProductionLots)
	|		AND NOT ProductionLot = VALUE(Catalog.ProductionLots.EmptyRef)) AS Labor
	|
	|UNION
	|
	|SELECT DISTINCT
	|	CatProductionLots.Ref AS Lot
	|FROM
	|	AccumulationRegister.ProductsRelease AS ProductsRelease
	|	
	|	INNER JOIN Catalog.ProductionLots AS CatProductionLots
	|	ON CatProductionLots.Document = ProductsRelease.Recorder
	|	
	|	LEFT JOIN Document.BackflushProduction AS ProductionDetailsWithoutOrder
	|	ON ProductionDetailsWithoutOrder.Ref = ProductsRelease.Recorder
	|WHERE
	|	ProductsRelease.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND ProductsRelease.Organization IN (&CompanyArray)
	|	AND (NOT ISNULL(ProductionDetailsWithoutOrder.Patch, FALSE)
	|		OR NOT ISNULL(ProductionDetailsWithoutOrder.CorrectionSavesProductionLots, FALSE))
	|
	|UNION
	|
	|SELECT DISTINCT
	|	CatProductionLots.Ref AS Lot
	|FROM
	|	AccumulationRegister.ProductsRelease AS ProductsRelease
	|	
	|	INNER JOIN Document.BackflushProduction AS ProductionDetailsWithoutOrder
	|	ON ProductionDetailsWithoutOrder.Ref = ProductsRelease.Recorder
	|	
	|	INNER JOIN Catalog.ProductionLots AS CatProductionLots
	|	ON CatProductionLots.Document = ProductionDetailsWithoutOrder.CorrectedDocument
	|WHERE
	|	ProductsRelease.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND ProductsRelease.Organization IN (&CompanyArray)
	|	AND ProductionDetailsWithoutOrder.Patch
	|	AND ProductionDetailsWithoutOrder.CorrectionSavesProductionLots
	|
	|UNION
	|
	|SELECT DISTINCT
	|	StageDetails.ProductionLot AS Lot
	|FROM
	|	AccumulationRegister.ProductsRelease AS ProductsRelease
	|	INNER JOIN Document.ProductionStage2_2 AS StageDetails
	|		ON StageDetails.Ref = ProductsRelease.Recorder
	|WHERE
	|	ProductsRelease.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND ProductsRelease.Organization IN (&CompanyArray)
	|
	|UNION
	|
	|SELECT DISTINCT
	|	StageDetails.ProductionLot AS Lot
	|FROM
	|	Document.SubcontractorReport2_5.ManufacturedProducts AS ProductsRelease
	|	
	|	INNER JOIN Document.ProductionStage2_2 AS StageDetails
	|	ON StageDetails.Ref = ProductsRelease.ProductionStage
	|
	|WHERE
	|	ProductsRelease.Ref.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND ProductsRelease.Ref.Posted
	|	AND ProductsRelease.Ref.Organization IN (&CompanyArray)
	|
	|INDEX BY
	|	Lot
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	Lots.Ref	AS Lot,
	|	Lots.Document	AS DocumentLots
	|INTO ProductionLots
	|FROM
	|	ProductionLotsPreliminary AS T
	|	INNER JOIN Catalog.ProductionLots AS Lots
	|		ON T.Lot = Lots.Ref
	|INDEX BY
	|	DocumentLots,
	|	Lot
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	ProductionLots.Lot AS Lot
	|INTO CompletedBatches
	|FROM
	|	(
	// Production without an order and reports of the processor without stages
	|	SELECT
	|		ProductionLots.Lot	AS Lot,
	|		BEGINOFPERIOD(ProductsRelease.Period, MONTH) AS Period
	|	FROM
	|		ProductionLots AS ProductionLots
	|	
	|		INNER JOIN AccumulationRegister.ProductsRelease AS ProductsRelease
	|		ON ProductsRelease.Recorder = ProductionLots.DocumentLots
	|	
	|	UNION ALL
	|	
	// Production stages (completed, in-house)
	|	SELECT
	|		ProductionLots.Lot	AS Lot,
	|		BEGINOFPERIOD(Products_1.ProductionDate, MONTH) AS Period
	|	FROM
	|		ProductionLots AS ProductionLots
	|	
	|		INNER JOIN Document.ProductionStage2_2 AS DocumentAttributes
	|		ON DocumentAttributes.ReferenceOrder = ProductionLots.DocumentLots
	|		AND DocumentAttributes.ProductionLot = ProductionLots.Lot
	|		AND DocumentAttributes.Posted
	|		AND NOT DocumentAttributes.ProductionByThirdParty
	|
	|		INNER JOIN Document.ProductionStage2_2.ManufacturedProducts AS Products_1
	|		ON Products_1.Ref = DocumentAttributes.Ref
	|		AND Products_1.Manufactured
	|		AND NOT Products_1.Canceled
	|	
	|	UNION ALL
	|	
	// Production stages (not completed, in-house) - the planned production date may change at any time
	|	SELECT
	|		ProductionLots.Lot		AS Lot,
	|		DATETIME(3999,12,31,23,59,59)	AS Period
	|	FROM
	|		ProductionLots AS ProductionLots
	|	
	|		INNER JOIN Document.ProductionStage2_2 AS DocumentAttributes
	|		ON DocumentAttributes.ReferenceOrder = ProductionLots.DocumentLots
	|		AND DocumentAttributes.ProductionLot = ProductionLots.Lot
	|		AND DocumentAttributes.Posted
	|		AND NOT DocumentAttributes.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
	|		AND NOT DocumentAttributes.ProductionByThirdParty
	|
	|		INNER JOIN Document.ProductionStage2_2.ManufacturedProducts AS Products_1
	|		ON Products_1.Ref = DocumentAttributes.Ref
	|		AND NOT Products_1.Manufactured
	|		AND NOT Products_1.Canceled
	|	
	|	UNION ALL
	|	
	// Stages of production (completed, by the forces of the processor 2.5)
	|	SELECT
	|		ProductionLots.Lot	AS Lot,
	|		BEGINOFPERIOD(Products_1.Ref.Date, MONTH) AS Period
	|	FROM
	|		ProductionLots AS ProductionLots
	|	
	|		INNER JOIN Document.ProductionStage2_2 AS DocumentAttributes
	|		ON DocumentAttributes.ReferenceOrder = ProductionLots.DocumentLots
	|		AND DocumentAttributes.ProductionLot = ProductionLots.Lot
	|		AND DocumentAttributes.Posted
	|		AND DocumentAttributes.ProductionByThirdParty
	|		
	|		INNER JOIN Document.SubcontractorReport2_5.ManufacturedProducts AS Products_1
	|		ON Products_1.ProductionStage = DocumentAttributes.Ref
	|	WHERE
	|		Products_1.Ref.Posted
	|	
	|	UNION ALL
	|	
	// Production stages (not completed, by the processor) - the planned production date may change at any time
	|	SELECT
	|		UnreleasedProducts.Lot     AS Lot,
	|		DATETIME(3999,12,31,23,59,59) AS Period
	|	FROM
	|		(SELECT
	|			ProductionLots.Lot AS Lot,
	|			Products_1.Products      AS Products,
	|			Products_1.Characteristic    AS Characteristic,
	|			Products_1.Purpose        AS Purpose,
	|			Products_1.Count        AS Count
	|		FROM
	|			ProductionLots AS ProductionLots
	|		
	|			INNER JOIN Document.ProductionStage2_2 AS DocumentAttributes
	|			ON DocumentAttributes.ReferenceOrder = ProductionLots.DocumentLots
	|			AND DocumentAttributes.ProductionLot = ProductionLots.Lot
	|			AND DocumentAttributes.Posted
	|			AND NOT DocumentAttributes.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
	|			AND DocumentAttributes.ProductionByThirdParty
	|			
	|			INNER JOIN Document.ProductionStage2_2.ManufacturedProducts AS Products_1
	|			ON Products_1.Ref = DocumentAttributes.Ref
	|		
	|		UNION ALL
	|		
	|		SELECT
	|			ProductionLots.Lot AS Lot,
	|			Products_1.Products      AS Products,
	|			Products_1.Characteristic    AS Characteristic,
	|			Products_1.Purpose        AS Purpose,
	|			-Products_1.Count        AS Count
	|		FROM
	|			ProductionLots AS ProductionLots
	|		
	|			INNER JOIN Document.ProductionStage2_2 AS DocumentAttributes
	|			ON DocumentAttributes.ReferenceOrder = ProductionLots.DocumentLots
	|			AND DocumentAttributes.ProductionLot = ProductionLots.Lot
	|			AND DocumentAttributes.Posted
	|			AND NOT DocumentAttributes.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
	|			AND DocumentAttributes.ProductionByThirdParty
	|			
	|			INNER JOIN Document.SubcontractorReport2_5.ManufacturedProducts AS Products_1
	|			ON Products_1.ProductionStage = DocumentAttributes.Ref
	|		) AS UnreleasedProducts
	|	
	|	GROUP BY
	|		UnreleasedProducts.Lot,
	|		UnreleasedProducts.Products,
	|		UnreleasedProducts.Characteristic,
	|		UnreleasedProducts.Purpose
	|	
	|	HAVING
	|		SUM(UnreleasedProducts.Count) > 0
	|	
	|	UNION ALL
	|	
	// Production order without specifications - completion date is uncertain
	|	SELECT
	|		ProductionLots.Lot		AS Lot,
	|		DATETIME(3999,12,31,23,59,59)	AS Period
	|	FROM
	|		ProductionLots AS ProductionLots
	|	
	|		INNER JOIN Document.ProductionOrder2_2 AS DocumentAttributes
	|		ON DocumentAttributes.Ref = ProductionLots.DocumentLots
	|
	|	WHERE
	|		DocumentAttributes.Posted
	|		AND DocumentAttributes.Organization IN (&CompanyArray)
	|		AND DocumentAttributes.Status = VALUE(Enum.ProductionOrderStatuses2_2.ToProduce)
	|		AND DocumentAttributes.ProductionProcessType = VALUE(Enum.ProductionProcessTypes.WithoutBillsOfMaterials)
	|	) AS ProductionLots
	|
	|GROUP BY
	|	ProductionLots.Lot
	|
	|HAVING
	|	MAX(ProductionLots.Period) <= &EndOfPeriod
	|
	|INDEX BY
	|	Lot
	|";
	
EndFunction

// Procedure-handler for checking the state of the system"Unallocated post-items".
//
// Parameters:
// CheckParameters - See AuditOfSystemState.InitializeVerificationParameters
//
Procedure VerificationOfUnallocatedItemByItemExpenses(CheckParameters) Export
	
	If CheckParameters.AdditionalParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing Then
		Return;
	EndIf;
	
	ClosingParameters = CalculationOfCostCached.ValuesOfTechnologicalParameters();
	CheckParameters.AdditionalParameters.Insert("TempTablesManager", New TempTablesManager);
	
	Query = New Query;
	Query.TempTablesManager = CheckParameters.AdditionalParameters.TempTablesManager;
	
	QueryOptions = Documents.AllocationOfOtherCosts.DescriptionOfParametersForRequestingDataForDistribution();
	QueryOptions.Insert("Period", CheckParameters.AdditionalParameters.Period);
	QueryOptions.Insert("Companies", CheckParameters.AdditionalParameters.CompanyArray);
	Documents.AllocationOfOtherCosts.InitializeRequestToGetDataForDistribution(Query, QueryOptions);
	
	QueryText = Documents.AllocationOfOtherCosts.QueryTextDataForDistribution(1, True);
	
	// Additional request parameters.
	AdditionalParameters = New Structure;
	AdditionalParameters.Insert("ByAllCompanies",	 	False);
	AdditionalParameters.Insert("ByAllBusinessUnits", 	True);
	AdditionalParameters.Insert("DepartmentList",  	New Array);
	AdditionalParameters.Insert("FilterByState",    	Enums.CostAllocationStates.AllocationError);
	AdditionalParameters.Insert("ExcludeDifferencesFromControl", True);
	AdditionalParameters.Insert("ManErrorValue",  ClosingParameters.ErrorValueManCosts);
	AdditionalParameters.Insert("LocalErrorValue", ClosingParameters.ValueOfErrorCostsRegl);
	AdditionalParameters.Insert("CostAllocationOptions", 
