#Region LoggersAndTimePoints

// Gets the "Moment in time" attribute for all documents in the specified time table.
//
Procedure GenerateTableOfPointsInTime(ContainerManagerTT, SourceName, FieldNameLogger = "Recorder",
			DestinationName = "TTPointsInTime", EmptyLoggersAreAllowed = False) Export
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	// Let's select the types of documents for which we need to get a point in time.
	Query.Text =
	"SELECT DISTINCT
	|	T.FieldNameLogger AS FieldNameLogger
	|INTO ReceiverName_Registrars
	|FROM
	|	SourceName AS T
	|
	|INDEX BY
	|	FieldNameLogger
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT DISTINCT
	|	VALUETYPE(T.FieldNameLogger) AS TypeOfRegistrar
	|FROM
	|	ReceiverName_Registrars AS T
	|";
	
	Query.Text = StrReplace(Query.Text, "FieldNameLogger",  FieldNameLogger);
	Query.Text = StrReplace(Query.Text, "SourceName", 		SourceName);
	Query.Text = StrReplace(Query.Text, "DestinationName", 		DestinationName);
	
	Selection = Query.Execute().Select();
	
	// We will compose the text of the field for selecting the time of the document, depending on the type of document.
	QueryText = "";
	
	DescriptionOfDocumentTypes = CostCalculationUniversalAlgorithms.DescriptionOfDocumentTypes();
	
	While Selection.Next() Do
		
		If Selection.TypeOfRegistrar = Type("Undefined")
		 Or Not DescriptionOfDocumentTypes.ContainsType(Selection.TypeOfRegistrar) Then
			
			If Not EmptyLoggersAreAllowed Then
				
				// The <Logger Field name> field does not contain a link to the document.
				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Khi xử lý nguồn ghi từ bảng tạm ""%1"" đã xảy ra lỗi:
						|sai kiểu nguồn ghi ""%2""';
						|ru = 'При обработке регистраторов из временной таблицы ""%1"" возникла ошибка:
						|некорректный тип регистратора ""%2""';
						|en = 'An error occurred while processing recorders from the ""%1"" temporary table:
						|incorrect type of the ""%2"" recorder'; fa = 'An error occurred while processing recorders from the ""%1"" temporary table:
						|incorrect type of the ""%2"" recorder';
						|it = 'Durante l''elaborazione dei registratori dalla tabella temporanea ""%1"" si è verificato un errore:
						|tipo incorretto del registratore ""%2""';
						|pl = 'Podczas przetwarzania rejestratorów z tabeli tymczasowej ""%1"" wystąpił błąd:
						|niepoprawny typ rejestratora ""%2""';
						|tr = '""%1"" geçici tablosundaki kayıt operatörleri işlenirken hata oluştu:
						|yanlış kayıt operatörü tipi ""%2""'", Common.DefaultLanguageCode()),
					SourceName,
					CostCalculationProtocol.ValuePresentation(Selection.TypeOfRegistrar));
				
				CostCalculationProtocol.FixCalculationError(
					ContainerManagerTT,
					Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenGeneratingRecordsInRegisters,
					ProtocolText_);
				
				Raise TextExceptionToLogProblem(ProtocolText_);
				
			Else
				
				Continue; // we do not include such a registrar in the final table
				
			EndIf;
			
		EndIf;
		
		NameOfLoggerType = Metadata.FindByType(Selection.TypeOfRegistrar).Name;
		ThisIsFirstSubquery  = Not ValueIsFilled(QueryText);
		
		QueryTemplate = "
		|SELECT
		|	T.FieldNameLogger AS FieldNameLogger,
		|	CAST(T.FieldNameLogger AS Document.RegisterAdjustment).PointInTime AS PointInTime,
		|	CAST(T.FieldNameLogger AS Document.RegisterAdjustment).Date AS Date
		|INTO DestinationName
		|FROM
		|	ReceiverName_Registrars AS T
		|WHERE
		|	T.FieldNameLogger REFS Document.RegisterAdjustment
		|";
		
		QueryText = QueryText + ?(ThisIsFirstSubquery, "", "
		|UNION ALL
		|") + StrReplace(
				StrReplace(
					QueryTemplate, 
					"INTO DestinationName",
					?(ThisIsFirstSubquery, "INTO DestinationName", "")),
				"RegisterAdjustment",
				NameOfLoggerType);
		
	EndDo;
	
	If Not ValueIsFilled(QueryText) Then
		QueryText =
		"SELECT TOP 0
		|	UNDEFINED AS FieldNameLogger,
		|	UNDEFINED AS PointInTime,
		|	UNDEFINED AS Date
		|INTO DestinationName
		|";
	EndIf;
	
	QueryText = QueryText + "
	|INDEX BY
	|	FieldNameLogger
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|DROP ReceiverName_Registrars";
	
	// We will get the time points of the documents.
	Query.Text = TrimAll(QueryText);
	
	Query.Text = StrReplace(Query.Text, "FieldNameLogger",  FieldNameLogger);
	Query.Text = StrReplace(Query.Text, "DestinationName", 		DestinationName);
	
	Query.Execute();
	
EndProcedure

// Selects documents from the specified time table, ordered by their point in time.
//
// Returns:
//	QueryResult -
//
Function SelectLoggersTimePoints(ContainerManagerTT, TableName, FieldNameLogger = "Recorder") Export
	
	DestinationName = "TTPointsInTime";
	
	Query = New Query;
	Query.TempTablesManager = GetTTManagerFromContainer(ContainerManagerTT);
	
	GenerateTableOfPointsInTime(ContainerManagerTT, TableName, FieldNameLogger, DestinationName);
	
	Query.Text =
	"SELECT DISTINCT
	|	T.FieldNameLogger,
	|	Source.Organization,
	|	T.PointInTime,
	|	T.Date
	|FROM
	|	DestinationName AS T
	|	LEFT JOIN TableName AS Source
	|		ON T.FieldNameLogger = Source.FieldNameLogger
	|
	|ORDER BY
	|	T.PointInTime
	|";
	
	Query.Text = StrReplace(Query.Text, "FieldNameLogger", 	FieldNameLogger);
	Query.Text = StrReplace(Query.Text, "DestinationName", 		DestinationName);
	Query.Text = StrReplace(Query.Text, "TableName", 			TableName);
	
	QueryResult = Query.Execute();
	
	DestroyTemporaryTables(ContainerManagerTT, DestinationName);
	
	Return QueryResult;
	
EndFunction
	
