#Region CostCalculationDocuments

// Generates cost calculation documents for the organizations being calculated.
// A list of documents is placed into a temporary table Withdocumentation.
//
Procedure InitializeCostCalculationDocuments(CalculationParameters, PreliminaryCalculation, ScheduledJob)
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "TTCostCalculationDocuments");
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	If CalculationParameters.Property("DecodingDistribution") Then
		
		// You do not need to initialize the documents.
		Query.Text =
		"SELECT
		|	UNDEFINED AS Ref,
		|	UNDEFINED AS PointInTime,
		|	Companies.Ref AS Organization
		|INTO TTCostCalculationDocuments
		|FROM
		|	Catalog.Companies AS Companies
		|WHERE
		|	Companies.Ref IN(&CompanyArray)";
		
		Query.Execute();
		
		Return;
		
	EndIf;
	
	// We will select all non-deleted cost calculation documents for the billing period.
	// If a suitable cost calculation document already exists for the organization, then a new document will not be created.
	Query.Text =
	"SELECT DISTINCT
	|	T.Ref AS Ref,
	|	T.Ref.Posted AS Posted,
	|	T.Ref.Organization AS Organization,
	|	CASE
	|		WHEN T.Ref.Organization = VALUE(Catalog.Companies.EmptyRef)
	|			THEN FALSE
	|		ELSE TRUE
	|	END AS NewDocumentFormat,
	|	T.Ref.PreliminaryCalculation AS PreliminaryCalculation
	|FROM
	|	Document.InventoryCostCalculation.Companies AS T
	|WHERE
	|	T.Ref.Date BETWEEN &BeginOfPeriod AND ENDOFPERIOD(&EndOfPeriod, MONTH)
	|	AND NOT T.Ref.DeletionMark
	|	AND T.Organization IN (&CurOrganizationSelection)
	|	AND T.Ref.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
	|
	|ORDER BY
	|	Organization,
	|	NewDocumentFormat DESC,
	|	Posted DESC,
	|	PreliminaryCalculation,
	|	T.Ref.Date DESC";
	
	// We will keep the link Organization - Cost calculation document, which we will recalculate.
	CalculationDocumentsForOrganizations = New Map;
	// We will save the list of cost calculation documents.
	CostCalculationDocuments  = New Array;
	CostCalculationRegistrars = New Array;
	// We will save the list of outdated cost calculation documents that need to be deleted.
	DocumentsToBeDeleted  		   = New Array;
	// Let's save all the organizations from the calculation parameters.Groupsorganizationintercampany.
	ArrayOfOrganizationsToCalculate    = New Array;
	
	NumberOfGroup = 0;
	CalculationIsPossible = Not ScheduledJob;
	
	While NumberOfGroup < CalculationParameters.IntercampanyGroupsOfOrganizations.Count() Do
		
		GroupOfOrganizations = CalculationParameters.IntercampanyGroupsOfOrganizations[NumberOfGroup];
		
		// We get a table of existing cost calculation documents for a group of related organizations.
		Query.SetParameter("CurOrganizationSelection", GroupOfOrganizations);
		
		DocumentsTable = Query.Execute().Unload();
		DocumentsTable.Indexes.Add("Organization, PreliminaryCalculation");
		
		// We will delete all the cost calculation documents in the "old format" - when the organization was not in the document header.
		DeleteCostCalculationDocuments(
			DocumentsToBeDeleted,
			DocumentsTable,
			New Structure("NewDocumentFormat", False));
		
		// According to the organization, there may be several cost calculation documents for the period - we will leave only one.
		For Each CurrentCompany In GroupOfOrganizations Do
			
			ArrayOfOrganizationsToCalculate.Add(CurrentCompany);
			
			FactRows = DocumentsTable.FindRows(
				New Structure("Organization, PreliminaryCalculation", CurrentCompany, False));
			
			If FactRows.Count() > 0 Then
				// The documents of the preliminary calculation are no longer needed.
				DeleteCostCalculationDocuments(
					DocumentsToBeDeleted,
					DocumentsTable,
					New Structure("Organization, PreliminaryCalculation", CurrentCompany, True));
			EndIf;
			
			If Not ScheduledJob Or FactRows.Count() = 0 Then
				CalculationIsPossible = True;
			EndIf;
			
			// We will leave only one document for calculation, the latest by date (if for some reason there are several documents left).
			DocumentCalculation = DeleteCostCalculationDocuments(
				DocumentsToBeDeleted,
				DocumentsTable,
				New Structure("Organization", CurrentCompany),
				True);
				
			CalculationDocumentsForOrganizations.Insert(CurrentCompany, DocumentCalculation);
			
		EndDo;
		
		NumberOfGroup = NumberOfGroup + 1;
		
	EndDo;
	
	If Not CalculationIsPossible Then
		
		ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Không cần tính toán giá vốn sơ bộ trong %1 bằng nhiệm vụ thường kỳ,
				|bởi vì theo tất cả doanh nghiệp đã thực hiện tính toán giá vốn thực tế';
				|ru = 'Расчет предварительной себестоимости за %1 регламентным заданием не требуется,
				|т.к. по всем организациям уже выполнен расчет фактической себестоимости';
				|en = 'Preliminary cost calculation for %1 by the scheduled job is not required
				|as actual cost has already been calculated for all companies'; fa = 'Preliminary cost calculation for %1 by the scheduled job is not required
				|as actual cost has already been calculated for all companies';
				|it = 'Расчет предварительной себестоимости за %1 регламентным заданием не требуется,
				|т.к. по всем организациям уже выполнен расчет фактической себестоимости';
				|pl = 'Preliminary cost calculation for %1 by the scheduled job is not required
				|as actual cost has already been calculated for all companies';
				|tr = 'Tüm kuruluşlar için gerçek maliyet fiyatı zaten hesaplanmış olduğundan
				|, %1 için ön maliyet fiyatının hesaplanması zamanlanmış görev tarafından gerekli değildir.'", Common.DefaultLanguageCode()),
			CostCalculationProtocol.PresentationOfCalculationPeriod(CalculationParameters));
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.ErrorOfCostCalculationDocumentsInInitializing,
			ErrorText);
		
		Raise TextExceptionToLogProblem(ErrorText);
		
	EndIf;
	
	// We will delete the previously generated cost calculation documents for organizations for which the calculation does not need to be carried out.
	ArrayOfNotCalculated = CommonClientServer.ArraysDifference(
		CalculationParameters.CompanyArray,
		ArrayOfOrganizationsToCalculate);
	DocumentsForCleaning = New Array;
	
	If ArrayOfNotCalculated.Count() > 0 Then
		
		Query.SetParameter("CurOrganizationSelection", ArrayOfNotCalculated);
		
		DocumentsTable = Query.Execute().Unload();
		
		If CalculationParameters.PayrollPeriod.BeginningOfNextPeriod = CalculationParameters.DateOfMigrationToBatchAccounting22 Then
			DocumentsForCleaning = DocumentsTable.UnloadColumn("Ref");
			DocumentsTable.Clear();
		Else
			DeleteCostCalculationDocuments(DocumentsToBeDeleted, DocumentsTable);
		EndIf;
		
	EndIf;
	
	Try
		
		ErrorsInDatesWhenChangesWereBanned = "";
		
		CommonClientServer.SupplementArray(DocumentsToBeDeleted, DocumentsForCleaning, True);
		
		// We will delete unnecessary cost calculation documents.
		For Each CurrentDocument In DocumentsToBeDeleted Do
			
			DocumentObject = CurrentDocument.GetObject();
			
			// Let's check that the document is in the period available for modification.
			DateErrorDescription = "";
			
			If PeriodClosingDates.DataChangesDenied(DocumentObject, CurrentDocument, DateErrorDescription) Then
				// Let's accumulate a description of errors and then call one exception for all documents.
				ErrorsInDatesWhenChangesWereBanned = ErrorsInDatesWhenChangesWereBanned + ?(ErrorsInDatesWhenChangesWereBanned = "", "", "
					|") + CostCalculationProtocol.PresentationOfMultilineText(DateErrorDescription);
				Continue;
			EndIf;
			
			If DocumentsForCleaning.Find(CurrentDocument) = Undefined Then
				DocumentObject.SetDeletionMark(True);
			Else
				// We clear the document's RegisterRecords if no calculation is required for the company. 
				DocumentObject.Write(DocumentWriteMode.UndoPosting);
				DocumentObject.Write(DocumentWriteMode.Posting);
			EndIf;
			
			// We will clear the calculation task, which will be recorded from the event in the recordset module.
			RecordSet = InformationRegisters.JobsForCalculatingCost.CreateRecordSet();
			RecordSet.Filter.Document.Set(CurrentDocument);
			RecordSet.Write(True);
			
		EndDo;
		
		// Create new or update existing cost calculation documents for organizations.
		For Each KeyAndValue In CalculationDocumentsForOrganizations Do
			
			If ValueIsFilled(KeyAndValue.Value) Then
				DocumentObject = KeyAndValue.Value.GetObject();
			Else
				DocumentObject = Documents.InventoryCostCalculation.CreateDocument();
			EndIf;
			
			// If the cost calculation has not yet been performed or was performed in a pre-existing version of the configuration (the month closing mode is not filled in),
			// then the calculation is performed with the restoration of the chronological sequence of batch write-off enabled.
			If Not ValueIsFilled(DocumentObject.MonthEndClosingMode) Then
				CalculationParameters.RestoreChronologicalSequenceOfDebitingBatches = True;
			Else
				CalculationParameters.RestoreChronologicalSequenceOfDebitingBatches =
					MonthEndTransactionsServer.GeneralParametersForClosingMonth().RestoreChronologicalSequenceOfDebitingBatches;
			EndIf;
			
			// If the closing mode of the month is not set, then we will determine it according to the previously created cost calculation document,
			// except for the calculation of the preliminary cost by the routine assignment.
			// In case of preliminary cost calculation, the month closing mode is not filled in with a routine task.
			If Not ValueIsFilled(CalculationParameters.MonthEndClosingMode)
			 And CalculationParameters.CalculationOption <> Enums.LotAndCostCalculationOptions.PreliminaryCostScheduledJob Then
				If ValueIsFilled(DocumentObject.MonthEndClosingMode) Then
					MonthEndClosingMode = DocumentObject.MonthEndClosingMode;
				ElsIf BegOfMonth(CurrentSessionDate()) = BegOfMonth(CalculationParameters.PayrollPeriod.EndOfPeriod)
				 And CalculationParameters.BatchAccountingVersion22 Then
					MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing;
				Else
					MonthEndClosingMode = Enums.MonthEndClosingModes.FinalClosing;
				EndIf;
				CalculationParameters.MonthEndClosingMode = MonthEndClosingMode; 
			Else
				MonthEndClosingMode = CalculationParameters.MonthEndClosingMode;
			EndIf;
			
			DocumentFillingData = New Structure;
			DocumentFillingData.Insert("Date", 					CalculationParameters.PayrollPeriod.EndOfPeriod);
			DocumentFillingData.Insert("Organization", 			KeyAndValue.Key);
			DocumentFillingData.Insert("PreliminaryCalculation", PreliminaryCalculation);
			DocumentFillingData.Insert("MonthEndClosingMode",   MonthEndClosingMode);
			DocumentFillingData.Insert("EntryType",   			Enums.LotRecordTypes.EmptyRef());
			
			DocumentFillingData.Insert("EvaluationMethod",
				DetermineMethodOfAssessingValueOfOrganizationSGoods(CalculationParameters, DocumentFillingData.Organization));
			
			// The header of the document will indicate the organization for which the cost price is calculated.
			// It will also be duplicated in the tabular part of the document.
			DocumentObject.Fill(DocumentFillingData);
			
			// Let's check that the document is in the period available for modification.
			DateErrorDescription = "";
			
			If PeriodClosingDates.DataChangesDenied(DocumentObject, KeyAndValue.Value, DateErrorDescription) Then
				// Let's accumulate a description of errors and then call one exception for all documents.
				ErrorsInDatesWhenChangesWereBanned = ErrorsInDatesWhenChangesWereBanned + ?(ErrorsInDatesWhenChangesWereBanned = "", "", "
					|") + CostCalculationProtocol.PresentationOfMultilineText(DateErrorDescription);
				Continue;
			EndIf;
				
			// We record the document as completed, while its old movements will remain until the end of the calculation.
			DocumentObject.Write(DocumentWriteMode.Posting);
			
			// We will clear the calculation task, which will be recorded from the event in the recordset module.
			RecordSet = InformationRegisters.JobsForCalculatingCost.CreateRecordSet();
			RecordSet.Filter.Document.Set(DocumentObject.Ref);
			RecordSet.Write(True);
			
			// Let's remember the document
			CostCalculationDocuments.Add(DocumentObject.Ref);
			CalculationDocumentsForOrganizations[KeyAndValue.Key] = DocumentObject.Ref;
			
			// Let's create a new cost calculation registrar.
			CostCalculationRecorder = InitializeRecordersOfCostCalculation(CalculationParameters, KeyAndValue.Key);
			
			If ValueIsFilled(CostCalculationRecorder) Then
				CostCalculationRegistrars.Add(CostCalculationRecorder);
			EndIf;
			
		EndDo;
		
		If ValueIsFilled(ErrorsInDatesWhenChangesWereBanned) Then
			 // The exception will be caught below in the code of this procedure, along with other document recording errors.
			Raise ErrorsInDatesWhenChangesWereBanned;
		EndIf;
		
		CalculationParameters.Insert("CostCalculationDocuments",  CostCalculationDocuments);
		CalculationParameters.Insert("CalculationDocumentsForOrganizations", CalculationDocumentsForOrganizations);
		CalculationParameters.Insert("CostCalculationRegistrars", CostCalculationRegistrars);
		
		// Dummy registrar for records with an empty registrar
		// Fill in the registrar with an arbitrary "first" cost calculation document - so that the movements can be recorded.
		// The calculation will still eventually be completed with an error, but so you can get information about all the erroneous registrars.
		For Each KeyAndValue In CalculationParameters.CalculationDocumentsForOrganizations Do
			CalculationParameters.Insert("DummyRegistrar", KeyAndValue.Key);
			Break;
		EndDo;
		
		// The cost calculation document no longer has register movements:
		//	- Revenue and cost of sales
		//	- Purchases
		// Therefore, if we recalculate the previous period, then the movements of the document "Calculation of the cost of goods" for these registers
		// must be cleared.
		
		Query.SetParameter("CostCalculationDocuments", CostCalculationDocuments);
		Query.SetParameter("CostCalculationRegistrars", CostCalculationRegistrars);
		
		QueryTextTemplate2 =
		"SELECT DISTINCT
		|	T.Recorder AS Recorder
		|FROM
		|	RegisterName AS T
		|WHERE
		|	T.Recorder IN (&CostCalculationDocuments)";
		
		RegistersStructure = New Structure("RevenueAndCOGS, Purchases");
		
		WriteParameters = InitializeRecordingParameters(
			CalculationParameters.PayrollPeriod.BeginOfPeriod,
			CalculationParameters.TaskNumberBeforeCalculation);
		
		For Each KeyAndValue In RegistersStructure Do
			
			RegisterName = KeyAndValue.Key;
			
			Query.Text = StrReplace(QueryTextTemplate2, "RegisterName", "AccumulationRegister." + RegisterName);
			
			RecordRegisteredRecordsByRegister(
				Query,
				AccumulationRegisters[RegisterName],
				WriteParameters);
			
		EndDo;
		
	Except
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Không thể khởi tạo chứng từ tính giá vốn do nguyên nhân:
				|%1';
				|ru = 'Не удалось инициализировать документы расчета себестоимости по причине:
				|%1';
				|en = 'Cannot initialize cost calculation documents. Reason:
				|%1'; fa = 'Cannot initialize cost calculation documents. Reason:
				|%1';
				|it = 'Impossibile inizializzare i documenti del calcolo del costo di produzione a causa di:
				|%1';
				|pl = 'Nie udało się zainicjować dokumenty obliczania kosztów własnych z powodu:
				|%1';
				|tr = 'Maliyet hesaplama belgeleri başlatılamadı çünkü:
				|%1'", Common.DefaultLanguageCode()),
			DetailErrorDescription(ErrorInfo()));
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.ErrorOfCostCalculationDocumentsInInitializing,
			ProtocolText_);
		
		Raise TextExceptionToLogProblem(ProtocolText_);
		
	EndTry;
	
	// We will form temporary tables for the documents of the calculation of the cost and the registrator of the calculation of the cost
	Query.Text =
	"SELECT
	|	T.Ref,
	|	T.PointInTime,
	|	T.Organization AS Organization,
	|	T.EntryType
	|INTO TTCostCalculationDocuments
	|FROM
	|	Document.InventoryCostCalculation AS T
	|WHERE
	|	T.Ref IN (&CostCalculationDocuments)
	|
	|INDEX BY
	|	Organization
	|;
	|SELECT
	|	T.Ref,
	|	T.PointInTime,
	|	T.Organization AS Organization
	|INTO TTCostCalculationRecorders
	|FROM
	|	Document.CostCalculationRecorder AS T
	|WHERE
	|	T.Ref IN (&CostCalculationRegistrars)
	|
	|INDEX BY
	|	Organization
	|;
	|SELECT
	|	T.Ref,
	|	T.Organization
	|FROM
	|	TTCostCalculationRecorders AS T
	|";
	
	Selection = Query.Execute().Select();
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters, True);
	
	RecordersOfCostCalculationByOrganizations = New Map;

	While Selection.Next() Do
		RecordersOfCostCalculationByOrganizations.Insert(Selection.Organization, Selection.Ref);
	EndDo;

	CalculationParameters.Insert("RecordersOfCostCalculationByOrganizations", RecordersOfCostCalculationByOrganizations);
	
	If CalculationParameters.Property("DeletedDocumentsCostCalculationRecorder") Then
		UpdateCalculatedRegisterCaches_(CalculationParameters);
	EndIf;
	
EndProcedure

// Generates cost calculation documents for the previous period for the calculated organizations.
// The list of documents is placed in the temporary table vtdocumentsaccount of the cost of the time period.
//
Procedure InitializeDocumentsForCalculatingCostOfPreviousPeriod(CalculationParameters) Export
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "TTDocumentsForCalculatingCostOfPreviousPeriod");
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);

	// We will select all the cost calculation documents that have not been deleted for the previous period.
	// If a suitable cost calculation document already exists for the organization, then a new document will not be created.
	Query.Text =
	"SELECT
	|	CatCompanies.Ref AS Organization,
	|	MAX(ISNULL(InventoryCostCalculation.Ref, UNDEFINED)) AS Ref
	|FROM
	|	Catalog.Companies AS CatCompanies
	|		LEFT JOIN Document.InventoryCostCalculation AS InventoryCostCalculation
	|		ON (CatCompanies.Ref = InventoryCostCalculation.Organization)
	|			AND (InventoryCostCalculation.Date BETWEEN &BeginningOfPreviousPeriod AND &EndOfPreviousPeriod)
	|			AND (InventoryCostCalculation.Posted)
	|			AND (NOT InventoryCostCalculation.PreliminaryCalculation)
	|			AND InventoryCostCalculation.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
	|WHERE
	|	CatCompanies.Ref IN(&OrganizationsWithCostBalances)
	|
	|GROUP BY
	|	CatCompanies.Ref";
	
	CalculationDocumentsForOrganizations = New Map;
	CostCalculationDocuments = New Array;
	
	Selection = Query.Execute().Select();
	While Selection.Next() Do
		CalculationDocumentsForOrganizations.Insert(Selection.Organization, Selection.Ref);
	EndDo;
	
	Try
		
		// Let's create the missing cost calculation documents for organizations.
		For Each KeyAndValue In CalculationDocumentsForOrganizations Do
			
			If ValueIsFilled(KeyAndValue.Value) Then
				CostCalculationDocuments.Add(KeyAndValue.Value);
				Continue;
			EndIf;

			DocumentObject = Documents.InventoryCostCalculation.CreateDocument();
			
			DocumentFillingData = New Structure;
			DocumentFillingData.Insert("Date", 					CalculationParameters.PayrollPeriod.EndOfPreviousPeriod);
			DocumentFillingData.Insert("Organization", 			KeyAndValue.Key);
			DocumentFillingData.Insert("PreliminaryCalculation", False);
			DocumentFillingData.Insert("EntryType", 			Enums.LotRecordTypes.EmptyRef());
			
			DocumentFillingData.Insert("EvaluationMethod",
				DetermineMethodOfAssessingValueOfOrganizationSGoods(CalculationParameters, DocumentFillingData.Organization));
			
			DocumentObject.Fill(DocumentFillingData);
			
			DocumentObject.AdditionalProperties.Insert("SkipPeriodClosingCheck", True);
				
			DocumentObject.Write(DocumentWriteMode.Posting);
			
			// Let's remember the document
			CostCalculationDocuments.Add(DocumentObject.Ref);
			CalculationDocumentsForOrganizations[KeyAndValue.Key] = DocumentObject.Ref;
			
		EndDo;
		
		Query.SetParameter("CostCalculationDocuments", CostCalculationDocuments);
		
	Except
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Không thể khởi tạo chứng từ tính giá vốn kỳ trước do nguyên nhân:
				|%1';
				|ru = 'Не удалось инициализировать документы расчета себестоимости прошлого периода по причине:
				|%1';
				|en = 'Cannot initialize past period cost calculation documents. Reason:
				|%1'; fa = 'Cannot initialize past period cost calculation documents. Reason:
				|%1';
				|it = 'Impossibile inizializzare i documenti del calcolo del costo di produzione a causa di:
				|%1';
				|pl = 'Nie udało się zainicjować dokumenty obliczania kosztów własnych ubiegłego okresu z powodu:
				|%1';
				|tr = 'Son dönem maliyetlendirme belgeleri şu nedenle başlatılamadı:
				|%1'", Common.DefaultLanguageCode()),
			DetailErrorDescription(ErrorInfo()));
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.ErrorOfCostCalculationDocumentsInInitializing,
			ProtocolText_);
		
		Raise TextExceptionToLogProblem(ProtocolText_);
		
	EndTry;
	
	// Let's create a temporary table for the calculation of the cost of the past period
	Query.Text =
	"SELECT
	|	T.Ref,
	|	T.PointInTime,
	|	T.Organization AS Organization,
	|	T.EntryType
	|INTO TTDocumentsForCalculatingCostOfPreviousPeriod
	|FROM
	|	Document.InventoryCostCalculation AS T
	|WHERE
	|	T.Ref IN (&CostCalculationDocuments)
	|	AND T.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
	|
	|UNION ALL
	|
	|SELECT
	|	T.Ref,
	|	T.PointInTime,
	|	T.Organization,
	|	T.EntryType
	|FROM
	|	Document.InventoryCostCalculation AS T
	|WHERE
	|	T.Date BETWEEN &BeginningOfPreviousPeriod AND &EndOfPreviousPeriod
	|	AND T.Posted
	|	AND NOT T.PreliminaryCalculation
	|	AND T.EntryType <> VALUE(Enum.LotRecordTypes.EmptyRef)
	|	AND T.Organization IN (&OrganizationsWithCostBalances)
	|
	|INDEX BY
	|	Ref";
	
	Query.Execute();
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters, True);
	
	CalculationParameters.Insert("RecordersOfBalanceAdjustments", New Array);
	
EndProcedure

// Checks the availability of regulatory documents for calculating the cost of goods.
//
// Returns:
//	Boolean -
//
Function ThereAreDocumentsForCalculatingCost(CalculationPeriod, CompanyArray) Export
	
	Query = New Query;
	Query.Text =
	"SELECT DISTINCT
	|	Companies.Ref
	|FROM
	|	Catalog.Companies AS Companies
	|		LEFT JOIN Document.InventoryCostCalculation.Companies AS CalculatedOrganizations
	|		ON Companies.Ref = CalculatedOrganizations.Organization
	|			AND (CalculatedOrganizations.Ref.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod)
	|			AND (CalculatedOrganizations.Ref.Posted)
	|			AND (NOT CalculatedOrganizations.Ref.PreliminaryCalculation)
	|			AND CalculatedOrganizations.Ref.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
	|WHERE
	|	Companies.Ref IN(&CompanyArray)
	|	AND CalculatedOrganizations.Organization IS NULL 
	|";
	
	Query.SetParameter("BeginOfPeriod", 	   BegOfMonth(CalculationPeriod));
	Query.SetParameter("EndOfPeriod",  	   EndOfMonth(CalculationPeriod));
	Query.SetParameter("CompanyArray", CompanyArray);
	
	Result = Query.Execute();
	
	Return Result.IsEmpty();
	
EndFunction

// Checks the availability of regulatory documents for the preliminary calculation of the cost of goods.
//
// Returns:
//	Boolean - in the specified period there are documents for the preliminary closing of the month
//
Function ThereAreDocumentsOfPreliminaryCostCalculation(CalculationPeriod, CompanyArray) Export
	
	// A similar Query Text is used when forming a temporary task table in the Text-Set-for-Distribution() function
	// of the document manager module for the allocation of all costs.
	
	Query = New Query;
	Query.Text = "
	|SELECT TOP 1
	|	InventoryCostCalculation.Ref
	|FROM
	|	Document.InventoryCostCalculation AS InventoryCostCalculation
	|WHERE
	|	InventoryCostCalculation.Organization IN (&CompanyArray)
	|	AND InventoryCostCalculation.Date BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND InventoryCostCalculation.Posted
	|	AND InventoryCostCalculation.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
	|	AND InventoryCostCalculation.MonthEndClosingMode
	|		= VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
	|";
	
	Query.SetParameter("BeginOfPeriod", 	   BegOfMonth(CalculationPeriod));
	Query.SetParameter("EndOfPeriod",  	   EndOfMonth(CalculationPeriod));
	Query.SetParameter("CompanyArray", CompanyArray);
	
	Result = Query.Execute();
	
	Return Not Result.IsEmpty();
	
EndFunction

// Deletes unnecessary cost calculation documents from the document table.
//
// Parameters:
// 	DocumentsToBeDeleted - Array -
// 	DocumentsTable - ValueTable - LongDesc:
// 	* Ref - DocumentRef -
// 	Filter - Structure, Undefined - LongDesc:
// * Organization - CatalogRef.Companies -
// 	LeaveFirst - Boolean - LongDesc
// Returns:
// 	Undefined - LongDesc
Function DeleteCostCalculationDocuments(DocumentsToBeDeleted, DocumentsTable, Filter = Undefined, LeaveFirst = False)
	
	LeftDocument = Undefined;
	
	If Filter = Undefined Then
		TableRows = DocumentsTable; // the whole table
	ElsIf TypeOf(Filter) = Type("Structure") Then
		TableRows = DocumentsTable.FindRows(Filter); // selected lines
	Else
		TableRows = Filter; // a ready-made array of strings
	EndIf;
	
	IndexOf = 0;
	
	For Each CurrentRow In TableRows Do
		
		IndexOf = IndexOf + 1;
		If LeaveFirst And IndexOf = 1 Then
			LeftDocument = CurrentRow.Ref;
			Continue;
		EndIf;
		
		DocumentsToBeDeleted.Add(CurrentRow.Ref);
		
		DocumentsTable.Delete(CurrentRow);
		
	EndDo;
	
	Return LeftDocument;
	
EndFunction

// Receives documents Recorders of cost calculation.
// If no suitable document is found for this period and organization, a new one is created.
//
// Parameters:
//	CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//	Organization - CatalogRef.Companies - the organization that is being closed for;
// Returnable value:
//	Document link.Registratorrecounts the cost of real estate.
//
Function InitializeRecordersOfCostCalculation(CalculationParameters, Organization)
	
	CostCalculationRecorder = Undefined;
	
	CreateADocument = CalculationParameters.AccountingPolicies.MovingAverage.UsedInCurPeriod.Find(Organization) <> Undefined
	 Or CalculationParameters.CompaniesWithDistributionOfDeviationsInPastPeriods.Find(Organization) <> Undefined
	 Or (CalculationParameters.HighlightDeviationsInCostOfFinalCalculation
	 	 And CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.FinalClosing);
	
	If Not CreateADocument Or CalculationParameters.Debug.ClearCalculationRecordersWithNewCalculation Then
		
		// Mark unnecessary documents for deletion
		Query = New Query;
		Query.Text =
		"SELECT
		|	Data.Ref
		|FROM
		|	Document.CostCalculationRecorder AS Data
		|WHERE
		|	BEGINOFPERIOD(Data.PayrollPeriod, MONTH) = &BeginOfPeriod
		|	AND NOT Data.DeletionMark
		|	AND Data.Organization = &Organization";
		
		Query.SetParameter("BeginOfPeriod", CalculationParameters.PayrollPeriod.BeginOfPeriod);
		Query.SetParameter("Organization", Organization);
		
		Selection = Query.Execute().Select();
		
		While Selection.Next() Do
			
			DocumentObject = Selection.Ref.GetObject();
			DocumentObject.SetDeletionMark(True);
			
			// We will clear the calculation task, which will be recorded from the event in the recordset module.
			RecordSet = InformationRegisters.JobsForCalculatingCost.CreateRecordSet();
			RecordSet.Filter.Document.Set(Selection.Ref);
			RecordSet.Write(True);
			
			CalculationParameters.Insert("DeletedDocumentsCostCalculationRecorder", True);
			
		EndDo;
		
	EndIf;
	
	If CreateADocument Then
		
		DocumentFillingData = New Structure;
		DocumentFillingData.Insert("Date", 				CurrentSessionDate());
		DocumentFillingData.Insert("PayrollPeriod", 	CalculationParameters.PayrollPeriod.EndOfPeriod);
		DocumentFillingData.Insert("Organization", 		Organization);
		DocumentFillingData.Insert("EmployeeResponsible", 	Users.CurrentUser());
		
		DocumentObject = Documents.CostCalculationRecorder.CreateDocument();
		DocumentObject.Fill(DocumentFillingData);
		DocumentObject.Write(DocumentWriteMode.Posting);
		
		CostCalculationRecorder = DocumentObject.Ref;
		
	EndIf;
	
	Return CostCalculationRecorder;
	
EndFunction

// Checks whether the transferred object is a service cost calculation document.
//
// Parameters:
//	Document - Arbitrary -
//
// Returns:
//	Boolean - service document attribute
//
Function ThisIsServiceDocumentForConvertingBalances(Document) Export
	
	// For a service document, cost calculation with the completed Attribute of the record type is not necessary to check the date of the ban.
	// Such a document is generated at the end of the previous month, which may be closed from changes.
	If TypeOf(Document) = Type("DocumentRef.InventoryCostCalculation") Then
		EntryType = Common.ObjectAttributeValue(Document, "EntryType");
	ElsIf TypeOf(Document) = Type("DocumentObject.InventoryCostCalculation") Then
		EntryType = Document.EntryType;
	Else
		EntryType = Undefined;
	EndIf;
	
	Return ValueIsFilled(EntryType);
	
EndFunction

