				|pl = 'Dla kontekstu %1 nie jest przewidziane wypełnienie pól obliczonej partii';
				|tr = '%1 bağlamı için, hesaplanan lot alanlarının doldurulması öngörülmedi'", Common.DefaultLanguageCode()),
			Context);
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.ErrorOccurredDuringLotAlocation,
			ProtocolText_);
		
		Raise TextExceptionToLogProblem(ProtocolText_);
		
	EndIf;	
	
EndProcedure

