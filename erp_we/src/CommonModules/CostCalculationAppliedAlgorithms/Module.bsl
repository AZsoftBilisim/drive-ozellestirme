// Returns a description of the chains for the specified record type.
// 
// Parameters:
// 	DescriptionOfChains - Map -
// 	EntryType - EnumRef.LotRecordTypes - 
// Returns:
// 	Structure - LongDesc:
// * LinkFields - Array -
// * TypesOfReceivers - Map -
// * SourcesTypes - Map -
//
Function ChainDescription(DescriptionOfChains, EntryType)
	
	If DescriptionOfChains[EntryType] = Undefined Then
		DescriptionOfChains.Insert(
			EntryType,
			New Structure(
				"LinkFields, TypesOfReceivers, SourcesTypes",
				New Array, New Map, New Map));
	EndIf;
	
	Return DescriptionOfChains[EntryType];
	
EndFunction

Procedure AddReceiverDescription(DescriptionOfChains, Receiver, DestinationFields, Sources = Undefined, SourceFields = Undefined) Export
	
	For Each FieldDetails In New Structure(DestinationFields) Do
		ChainDescription(DescriptionOfChains, Receiver).LinkFields.Add(FieldDetails.Key);
	EndDo;
	
	If ValueIsFilled(Sources) Then
		
		For Each SourceDetails In Sources Do
			
			If ValueIsFilled(SourceDetails.Value) Then
				Fields = SourceDetails.Value;
			ElsIf ValueIsFilled(SourceFields) Then
				Fields = SourceFields;
			Else
				Fields = DestinationFields;
			EndIf;
			
			AddSourceDescription(DescriptionOfChains, Receiver, SourceDetails.Key, Fields);
			
		EndDo;
		
	EndIf;
	
EndProcedure

Procedure AddSourceDescription(DescriptionOfChains, Receiver, Source, SourceFields) Export
	
	LinkFields = New Array;
	For Each FieldDetails In New Structure(SourceFields) Do
		LinkFields.Add(FieldDetails.Key);
	EndDo;
	
	DestinationFields = ChainDescription(DescriptionOfChains, Receiver).LinkFields;
	If DestinationFields.Count() <> LinkFields.Count() Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Số lượng trường giao tiếp khác nhau giữa nguồn ""%1"" và đích ""%2"".';
				|ru = 'Различное количество полей связи источника ""%1"" и приемника ""%2"".';
				|en = 'Different quantity of link fields of the ""%1"" source and the ""%2"" target.'; fa = 'Different quantity of link fields of the ""%1"" source and the ""%2"" target.';
				|it = 'Diverso numero di campi della connessione di sorgente ""%1"" e ricevitore ""%2"".';
				|pl = 'Różna ilość pól połączenia źródłowego „%1” i odbiornika ”%2”.';
				|tr = 'Kaynak ""%1"" ve kabul ""%2"" için farklı sayıda iletişim alanı.'", Common.DefaultLanguageCode()),
			Source,
			Receiver);
			
		ProtocolText_ = TextExceptionToLogProblem(ProtocolText_);
		
		Raise ProtocolText_;
		
	EndIf;
	
	ChainDescription(DescriptionOfChains, Source).TypesOfReceivers.Insert(Receiver, LinkFields);
	ChainDescription(DescriptionOfChains, Receiver).SourcesTypes.Insert(Source, LinkFields);
	
EndProcedure

// It is used when the record type has no sources.
// in Other words, this type of record is not obtained by distributing another type of record,
// but is simply formed based on sample data (similar to the "Supplement" record type in batch accounting version 2.1).
//
Procedure AddAddOnDescription(DescriptionOfChains, Receiver) Export
	
	AddReceiverDescription(DescriptionOfChains, Receiver, "Recorder");
	AddSourceDescription(DescriptionOfChains, Receiver, "", "Recorder"); // fictitious source
	
