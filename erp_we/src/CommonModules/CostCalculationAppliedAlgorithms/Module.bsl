// Adds technological calculation parameters to the General structure of calculation parameters.
//
Procedure SetTechnologicalParametersOfCalculation(CalculationParameters) Export
	
	// Let's transfer the operation parameters to the structure of the calculation parameters:
	//	- groups of parameters become fields of calculation parameters with the type "Structure"
	//	- the parameters themselves become elements of structures corresponding to groups of parameters.
	
	ParametersDetails = DescriptionOfParametersOfMonthClosingOperation();
	ParameterValues = CalculationOfCostCached.ValuesOfTechnologicalParameters();
		
	// Groups of parameters.
	For Each CurrentRow In DescriptionOfGroupsOfParametersForMonthClosingOperation() Do
		CalculationParameters.Insert(CurrentRow.Name, New Structure);
	EndDo;
	
	// Parameter values.
	For Each KeyAndValue In ParameterValues Do
		
		DetailsString    = ParametersDetails.Find(KeyAndValue.Key, "Name");
		ParameterValue = KeyAndValue.Value;
			
		If Not ValueIsFilled(DetailsString.Parent) Then
			CalculationParameters.Insert(KeyAndValue.Key, ParameterValue);
		Else
			CalculationParameters[DetailsString.Parent].Insert(KeyAndValue.Key, ParameterValue);
		EndIf;
		
	EndDo;
	
	EstablishNonTunableTechnologicalParametersOfCalculation(CalculationParameters);
	
EndProcedure

// Adds additional technological parameters of the calculation, the values of which cannot be changed.
//
// Parameters:
//  CalculationParameters - See CostCalculationAppliedAlgorithms.InitializeGeneralCalculationParameters
//
// Returns:
// 	ValueTable - LongDesc:
// * RegisterName - String -
// * Recorder - DocumentRef -
// * Count - Number -
Function EstablishNonTunableTechnologicalParametersOfCalculation(CalculationParameters) Export
	
	// Additional debugging options.
	// An auxiliary table for storing information about how many times the register/logger combination was passed to the background recording task.
	// If you end up with at least one line with "Quantity > 1", this is a critical error.
	VfzRegistrars = New ValueTable;
	VfzRegistrars.Columns.Add("RegisterName");
	VfzRegistrars.Columns.Add("Recorder");
	VfzRegistrars.Columns.Add("Count");
	
	CalculationParameters.Debug.Insert("VfzRegistrars", VfzRegistrars);
	
	Return VfzRegistrars;
	
EndFunction

