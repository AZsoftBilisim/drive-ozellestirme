Function GetDataFromCalculationStage(CalculationParameters, QueryText,
		NumberingParameters = Undefined,
		ClearTemporaryTables = True, Explanation = "") Export

	CalculationParameters.DistributionOfParties.Insert("NumberingParameters", NumberingParameters);
	
	RegisterRecordsDetails = CalculationParameters.DistributionOfParties.RegisterRecordsDetails;
	
	// We will prepare a request.
	Query = New Query;
	If CalculationParameters.Property("CostCalculationIsUnderway") Then
		CostCalculationIsUnderway = CalculationParameters.CostCalculationIsUnderway;
	Else
		CostCalculationIsUnderway = False;
	EndIf;
	InitializeRequestProperties(Query, CalculationParameters);
	
	For Each KeyAndValue In CalculationParameters.AdditionalStageRequestParameters Do
		Query.SetParameter(KeyAndValue.Key, KeyAndValue.Value);
	EndDo;
		
	If CalculationParameters.DebugParameters.Property("QueryTextForDebugging")
	 And CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "", False) Then
		Query.Text = CalculationParameters.DebugParameters.QueryTextForDebugging;
	Else
		Query.Text = QueryText;
	EndIf;
	
	SelectDataToBeCalculatedInTemporaryTable(Query);
	
	// Let's remember the existing temporary tables.
	If ClearTemporaryTables Then
		ExistingTT = GetListOfExistingTemporaryTables(Query);
	EndIf;
	
	If ValueIsFilled(RegisterRecordsDetails.TemporaryTablesForFollowingSteps) Then
		DestroyTemporaryTables(
			CalculationParameters,
			RegisterRecordsDetails.TemporaryTablesForFollowingSteps);
	EndIf;
	
	// Let's execute the request.
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, Explanation);
	
	// Let's number the rows of the Data table.
	If ValueIsFilled(NumberingParameters) Then
		
		CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters, "Data", NStr("vi = 'Đánh số dòng';
																								|ru = 'Нумерация строк';
																								|en = 'Line numbering'; fa = 'Line numbering';
																								|it = 'Numerazione delle righe';
																								|pl = 'Numeracja wierszy';
																								|tr = 'Satır numaralandırma'", Common.DefaultLanguageCode()));
		
		FillInTemporaryTableRowNumbers(
			CalculationParameters,
			NumberingParameters,
			"Data");
		
		CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters);
		
	EndIf;
	
	// We will destroy the auxiliary temporary tables created at this stage of the calculation.
	If ClearTemporaryTables Then
		
		ExistingTT = ExistingTT + ?(ExistingTT = "", "", ",") + "Data";
		
		If ValueIsFilled(RegisterRecordsDetails.TempTableName) Then
			ExistingTT = ExistingTT + "," + RegisterRecordsDetails.TempTableName;
		EndIf;
		
		If ValueIsFilled(RegisterRecordsDetails.TemporaryTablesForFollowingSteps) Then
			ExistingTT = ExistingTT + "," + RegisterRecordsDetails.TemporaryTablesForFollowingSteps;
		EndIf;
		
		RegisterRecordsDetails.TemporaryTablesOfCurStage =
			GetListOfExistingTemporaryTables(Query, ExistingTT);
		
	EndIf;
	
	CheckIfYouNeedToInterruptCalculationForTesting(CalculationParameters, "GetDataFromCalculationStage");
	
	CalculationParameters.AdditionalStageRequestParameters.Clear();
	
	Return True;
	
EndFunction

