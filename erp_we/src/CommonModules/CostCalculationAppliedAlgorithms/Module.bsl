#Region CheckingGeneratedCalculationData

// Checks for errors in the generated movements.
//
Procedure CheckCorrectnessOfGeneratedRegisteredRecords(CalculationParameters, WriteRegisters)
	
	CalculationProtocol = CalculationParameters.CalculationProtocol; // See CostCalculationProtocol.InitializeCalculationProtocol 
	
	If ValueIsFilled(WriteRegisters) Then
		StageNameSuffix = "ReadyMadeRegisteredRecorded" + Format(CalculationProtocol.NumberOfRegisteredRecordedCalls + 1, "NG=");
	Else
		If CalculationProtocol.NumberOfRegisteredRecordedCalls = 0 Then
			StageNameSuffix = ""; // the record is called only 1 time for the entire calculation
		Else
			StageNameSuffix = "RemainingRegisteredRecords"; // the last call to record Registered Recorded movements
		EndIf;
	EndIf;
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters,
		"CheckCorrectnessOfGeneratedRegisteredRecords" + ?(StageNameSuffix = "", "", "_") + StageNameSuffix);
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	// Checks the correctness of the Organization's indication in the generated movements:
	// - there should be no movements on non-calculated organizations.
	For Each KeyAndValue In CalculationParameters.RegisterRecords Do
		
		RegisterDescription = KeyAndValue.Value;
		
		If RegisterDescription.RegisterIsWritten
		 Or (ValueIsFilled(WriteRegisters)
		 	And WriteRegisters.Find(RegisterDescription.FullRegisterName) = Undefined) Then
			Continue;
		EndIf;
		
		If Not NeedToWriteRegister(CalculationParameters, RegisterDescription) Then
			Continue;
		EndIf;
		
		If CalculationParameters.Property("OnlyOneOrganization") And CalculationParameters.OnlyOneOrganization Then
			Continue;
		EndIf;
		
		CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
			CalculationParameters,
			TemporaryTableSize(CalculationParameters, RegisterDescription.RegisterCacheTableName));
		
		If Not RegisterDescription.SubordinateToRegistrar Then
			
			Query.Text =
			"SELECT DISTINCT
			|	T.Organization
			|INTO TTTrafficWithIncorrectOrganization
			|FROM
			|	CacheTableName AS T
			|WHERE
			|	&FilterByCompany
			|";
			
			FilterByCompany = "NOT (T.Organization IN(&CompanyArray))";
			If Not RegisterDescription.OrganizationRequired_ Then
				// Entries with an empty organization in this register are not considered erroneous.
				FilterByCompany = FilterByCompany + " AND T.Organization <> VALUE(Catalog.Companies.EmptyRef) AND T.Organization <> UNDEFINED";
			EndIf;
			Query.Text = StrReplace(Query.Text, "&FilterByCompany", FilterByCompany);
			
		ElsIf RegisterDescription.ThereIsACompany Then
			
			Query.Text =
			"SELECT DISTINCT
			|	T.Recorder,
			|	T.Organization
			|INTO TTTrafficWithIncorrectOrganization
			|FROM
			|	CacheTableName AS T
			|WHERE
			|	&FilterByCompany
			|";
			
			FilterByCompany = "NOT (T.Organization IN(&CompanyArray))";
			If Not RegisterDescription.OrganizationRequired_ Then
				// Entries with an empty organization in this register are not considered erroneous.
				FilterByCompany = FilterByCompany + " AND T.Organization <> VALUE(Catalog.Companies.EmptyRef) AND T.Organization <> UNDEFINED";
			EndIf;
			Query.Text = StrReplace(Query.Text, "&FilterByCompany", FilterByCompany);
			
		Else // ThereAreAnalyticsPartners
			
			Query.Text =
			"SELECT DISTINCT
			|	T.Recorder,
			|	T.AccountingDimensionByPartners.Organization AS Organization
			|INTO TTTrafficWithIncorrectOrganization
			|FROM
			|	CacheTableName AS T
			|		LEFT JOIN TTPartnerAnalyticsSelection AS PartnerAnalytics_
			|			ON T.AccountingDimensionByPartners = PartnerAnalytics_.DimensionKey
			|WHERE
			|	PartnerAnalytics_.DimensionKey IS NULL
			|";
			
		EndIf;
		
		Query.Text = StrReplace(Query.Text, "CacheTableName", RegisterDescription.RegisterCacheTableName);
		
		Query.Execute();
		
		CostCalculationProtocol.FixErrorsInGeneratedRegisteredRecords(
			CalculationParameters,
			RegisterDescription,
			"TTTrafficWithIncorrectOrganization",
			NStr("vi = 'Tạo bản ghi kết chuyển với doanh nghiệp không chính xác';
				|ru = 'Сформированы движения с некорректной организацией';
				|en = 'Records with incorrect company are generated'; fa = 'Records with incorrect company are generated';
				|it = 'Creati dei movimenti con un organizzazione incorretta';
				|pl = 'Utworzone ruchy z nieprawidłową firmą';
				|tr = 'Yanlış iş yeri ile oluşturulmuş hareketler'", Common.DefaultLanguageCode()));
		
		DestroyTemporaryTables(CalculationParameters, "TTTrafficWithIncorrectOrganization");
		
	EndDo;
	
	// Checks for batch accounting version 2.2:
	// make sure that no erroneous movements were generated in the calculation according to the register "Cost of goods".
	RegisterDescription = Undefined;
	CalculationParameters.RegisterRecords.Property(Metadata.AccumulationRegisters.InventoryCost.Name, RegisterDescription);
	
	If CalculationParameters.BatchAccountingVersion22
	 And CalculationParameters.CalculationOption = Enums.LotAndCostCalculationOptions.LotsAndCost
	 And RegisterDescription <> Undefined
	 And Not RegisterDescription.RegisterIsWritten
	 And (Not ValueIsFilled(WriteRegisters)
		 Or WriteRegisters.Find(RegisterDescription.FullRegisterName) <> Undefined) Then
		
		CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
			CalculationParameters,
			TemporaryTableSize(CalculationParameters, RegisterDescription.RegisterCacheTableName));
		
		// We check the correctness of the type of record in the movements formed at the stage of party distribution.
		Query.Text =
		"SELECT DISTINCT
		|	T.Recorder,
		|	T.Organization
		|INTO TTRegisteredRecordsOfUnreadableTypes
		|FROM
		|	TTCashCostOfGoods AS T
		|WHERE
		|	(T.EntryType IN (&UnreadableRecordTypes) OR T.Organization IN (&MediumSlipOrganizations))
		|	AND NOT T.LotCalculation
		|	AND NOT T.CalculationOfCost
		|";
		
		Query.Execute();
		
		CostCalculationProtocol.FixErrorsInGeneratedRegisteredRecords(
			CalculationParameters,
			RegisterDescription,
			"TTRegisteredRecordsOfUnreadableTypes",
			NStr("vi = 'Tạo bản ghi kết chuyển theo kiểu bản ghi chưa được tính';
				|ru = 'Сформированы движения по непересчитываемому типу записи';
				|en = 'Movements of non-recalculated record types are generated'; fa = 'Movements of non-recalculated record types are generated';
				|it = 'Creati movimenti sul tipo di registrazione non ricalcolabile';
				|pl = 'Utworzony ruch na niepisywalnym typie rekordu';
				|tr = 'Sayılamayan kayıt türüne göre hareketler oluşturuldu'", Common.DefaultLanguageCode()));
		
		// We check the correspondence of the quantity in the primary movements in the IB and in the movements formed at the stage of batch distribution.
		Query.Text =
		"SELECT
		|	T.Recorder,
		|	T.OfficialTypeOfMovementParish,
		|	T.ItemsLocationAttributes,
		|	T.AccountingSection,
		|	T.InventoryOwnerAttribute,
		|	T.Organization,
		|	T.CorItemsLocationAttributes,
		|	T.CorAccountingSection,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorCompany,
		|	T.EntryType,
		|	T.BusinessOperation,
		|	T.ReversingEntry,
		|	SUM(T.Count) AS Count
		|INTO TTModifiedPrimaryMotions
		|FROM
		|	(SELECT
		|		T.Recorder AS Recorder,
		|		CASE
		|			WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
		|				THEN TRUE
		|			ELSE FALSE
		|		END AS OfficialTypeOfMovementParish,
		|		T.ItemsLocationAttributes AS ItemsLocationAttributes,
		|		CASE
		|			WHEN VALUETYPE(T.Recorder) IN (&ProductionDocumentsWithoutInventoryType)
		|				THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
		|			ELSE T.AccountingSection
		|		END AS AccountingSection,
		|		CASE WHEN VALUETYPE(T.Recorder) IN (&ProductionDocumentsWithoutInventoryType)
		|			THEN VALUE(Catalog.InventoryKinds.EmptyRef)
		|			ELSE T.InventoryOwnerAttribute
		|		END AS InventoryOwnerAttribute,
		|		T.Organization AS Organization,
		|		CASE
		|			WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
		|				THEN VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)
		|			ELSE T.CorItemsLocationAttributes
		|		END AS CorItemsLocationAttributes,
		|		CASE
		|			WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
		|				THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
		|			WHEN VALUETYPE(T.Recorder) IN (&ProductionDocumentsWithoutInventoryType)
		|				THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
		|			ELSE T.CorAccountingSection
		|		END AS CorAccountingSection,
		|		CASE
		|			WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
		|				THEN VALUE(Catalog.InventoryKinds.EmptyRef)
		|			WHEN VALUETYPE(T.Recorder) IN (&ProductionDocumentsWithoutInventoryType)
		|				THEN VALUE(Catalog.InventoryKinds.EmptyRef)
		|			ELSE T.CorInventoryOwnerAttribute
		|		END AS CorInventoryOwnerAttribute,
		|		CASE
		|			WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
		|				THEN VALUE(Catalog.Companies.EmptyRef)
		|			ELSE T.CorCompany
		|		END AS CorCompany,
		|		T.EntryType AS EntryType,
		|		T.BusinessOperation AS BusinessOperation,
		|		T.ReversingEntry AS ReversingEntry,
		|		T.Count AS Count
		|	FROM
		|		AccumulationRegister.InventoryCost AS T
		|	WHERE
		|		T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
		|		AND T.Organization IN(&CompanyArray)
		|		AND T.Active
		|		AND (NOT T.EntryType IN (&UnreadableRecordTypes) AND NOT T.Organization IN (&MediumSlipOrganizations))
		|		AND NOT T.LotCalculation
		|		AND NOT T.CalculationOfCost
		|		AND NOT VALUETYPE(T.Recorder) = TYPE(Document.RegisterAdjustment)
		// The stage movements generated by the background task are excluded because the distribution can be performed both by the background
		// task and by correcting the primary document movements.
		|		AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpensingToProductionLots)
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		T.Recorder,
		|		T.OfficialTypeOfMovementParish,
		|		T.ItemsLocationAttributes,
		|		CASE
		|			WHEN VALUETYPE(T.Recorder) IN (&ProductionDocumentsWithoutInventoryType)
		|				THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
		|			ELSE T.AccountingSection
		|		END AS AccountingSection,
		|		CASE WHEN VALUETYPE(T.Recorder) IN (&ProductionDocumentsWithoutInventoryType)
		|			THEN VALUE(Catalog.InventoryKinds.EmptyRef)
		|			ELSE T.InventoryOwnerAttribute
		|		END AS InventoryOwnerAttribute,
		|		T.Organization,
		|		CASE
		|			WHEN OfficialTypeOfMovementParish
		|				THEN VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)
		|			ELSE T.CorItemsLocationAttributes
		|		END AS CorItemsLocationAttributes,
		|		CASE
		|			WHEN OfficialTypeOfMovementParish
		|				THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
		|			WHEN VALUETYPE(T.Recorder) IN (&ProductionDocumentsWithoutInventoryType)
		|				THEN VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef)
		|			ELSE T.CorAccountingSection
		|		END AS CorAccountingSection,
		|		CASE
		|			WHEN OfficialTypeOfMovementParish
		|				THEN VALUE(Catalog.InventoryKinds.EmptyRef)
		|			WHEN VALUETYPE(T.Recorder) IN (&ProductionDocumentsWithoutInventoryType)
		|				THEN VALUE(Catalog.InventoryKinds.EmptyRef)
		|			ELSE T.CorInventoryOwnerAttribute
		|		END AS CorInventoryOwnerAttribute,
		|		CASE
		|			WHEN OfficialTypeOfMovementParish
		|				THEN VALUE(Catalog.Companies.EmptyRef)
		|			ELSE T.CorCompany
		|		END AS CorCompany,
		|		T.EntryType,
		|		T.BusinessOperation,
		|		T.ReversingEntry,
		|		-T.Count
		|	FROM
		|		TTCashCostOfGoods AS T
		|	WHERE
		|		NOT T.LotCalculation
		|		AND NOT T.CalculationOfCost
		// The stage movements generated by the background task are excluded because the distribution can be performed both by the background
		// task and by correcting the primary document movements.
		|		AND T.BusinessOperation <> VALUE(Enum.BusinessTransactions.ExpensingToProductionLots)
		|
		|) AS T
		|
		|GROUP BY
		|	T.OfficialTypeOfMovementParish,
		|	T.ItemsLocationAttributes,
		|	T.AccountingSection,
		|	T.InventoryOwnerAttribute,
		|	T.Organization,
		|	T.CorItemsLocationAttributes,
		|	T.CorAccountingSection,
		|	T.CorInventoryOwnerAttribute,
		|	T.CorCompany,
		|	T.EntryType,
		|	T.BusinessOperation,
		|	T.ReversingEntry,
		|	T.Recorder
		|
		|HAVING
		|	SUM(T.Count) <> 0
		|";
		
		ProductionDocumentsWithoutInventoryType = New Array;
		
		Query.SetParameter("ProductionDocumentsWithoutInventoryType", ProductionDocumentsWithoutInventoryType);
		
		Query.Execute();
		
		CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
			CalculationParameters,
			TemporaryTableSize(CalculationParameters, "TTCashCostOfGoods"));
		
		CostCalculationProtocol.FixErrorsInGeneratedRegisteredRecords(
			CalculationParameters,
			RegisterDescription,
			"TTModifiedPrimaryMotions",
			NStr("vi = 'Đã thay đổi số lượng trong các bản ghi kết chuyển gốc';
				|ru = 'Изменилось количество в первичных движениях';
				|en = 'Quantity in primary records was changed'; fa = 'Quantity in primary records was changed';
				|it = 'Quantità modificata nei movimenti primari';
				|pl = 'Zmieniono ilość w ruchach podstawowych';
				|tr = 'Birincil hareketlerdeki sayı değişti'", Common.DefaultLanguageCode()));
		
		
		DestroyTemporaryTables(CalculationParameters,
			"TTRegisteredRecordsOfUnreadableTypes, TTModifiedPrimaryMotions
			|");
		
	EndIf;
	
EndProcedure

#EndRegion

#EndRegion

#Region AdjustmentsToInitialRegisterBalances

#Region DescriptionOfCorrectionAlgorithm

// Adjustment of registers is a separate stage of batch accounting, which includes the following stages
// - Correction of register 1
//	 = Start of register correction 1
//	 = Adjustment of type 1
//	 = View adjustment 2
//	 = ...
//	 = End of register correction 1
// - Correction of case 2
//	 = Start of register adjustment 2
//	 = Adjustment of type 1
//	 = View adjustment 3
//	 = ...
//	 = The end of the register correction 2
// - ...
//
// All registers for which adjustments are provided must be listed in the registers of the Initial adjustments()
// All types of adjustments must be described in the description of the Initial adjustments()
//
// At the beginning of the register correction, the function Initialize the correction of the register must be called()
//	- initializes the description of the correction
// At the end of the register correction, it is necessary to call the procedure to complete the correction of register settings()
//	- records the generated correction movements (Arrival, with a plus) and reverse (Arrival, with a minus)
//	  = the period of movements is the last second of last month
//	  = registrar - document "Calculation of the cost of goods" for the previous period
//
// At the beginning of the correction procedure for each type, it is necessary to start the next correction of the Registry settings()
//	- generates a table of the total settings<Register name>, which stores the estimated Balances at the beginning of the period for this adjustment
//		= the table does not take into account the adjustments generated by the previous calculation, and the adjustments already made to the Cur calculation are taken into account
//		= this temporary table should be used instead of the virtual table of the initial register Balances
// In the adjustment procedure, it is necessary to generate new (adjusted) initial Balances of the register
//	- formation of the initial Balances of the new register - the data of the new register is selected from other registers
//		= distribution is generally not required
//		= no Balance reversal required
//	- changing the measurements of the initial Balances of the register
//		= it is required to distribute the old Balances according to some database obtained from another register
//		= cancellation of old Balances is required
//	- the generated movements and reversing movements are transferred to the correction mechanism by calling the procedure to add the correction movements of the register()
//

#EndRegion

#Region AdjustmentSoftwareInterface

// Returns a list of accumulation registers for which adjustments are provided.
//
// Returns:
//	Array of String - array of register metadata names with adjustments
//
Function RegistersWithInitialRemainderAdjustments() Export
	
	RegistersWithAdjustments = New Array;
	RegistersWithAdjustments.Add(Metadata.AccumulationRegisters.InventoryCost.FullName());
	RegistersWithAdjustments.Add(Metadata.AccumulationRegisters.GoodsCostVariances.FullName());
		
	CalculationOfCostLocalization.SupplementRegistersWithAdjustmentsToInitialBalances(RegistersWithAdjustments);
	
	Return RegistersWithAdjustments;
	
EndFunction

// Returns a description of the changes of registers of accumulation.
//
// Returns:
//	ValueTable - table with a description of register adjustments
//		Correction - Enumeration of the link.Record typesparties - the type of adjustment record
//			when adding a new adjustment, you need to create a new record type for it;
//			the same adjustment for different registers can have the same record type;
//		Possible Multiple execution - Boolean adjustment can be performed multiple times (for example, if it depends on the current accounting policy)
//		Connection_name - String is the name of a constant that includes functionality that requires correction of register residuals
//		The constantname of the action start is a string - the name of the constant that stores the start date of the constant <Connection constantname>
//		Parent Correction - Enumeration link.Types of recordparties - filled in for an adjustment opposite to the one for which there is a constant <Constantname>
//
Function DescriptionOfInitialBalanceAdjustments() Export
	
	// Supported types of adjustments:
	// 1. Multiple adjustments, no date (not written to the register)
	// 2. One-time adjustment, with a date (written in the register, for reference)
	// 3. One-time adjustment, without date (written in the register)
	
	TableOfTypesOfAdjustments = New ValueTable;
	TableOfTypesOfAdjustments.Columns.Add("Adjusting", 				 New TypeDescription("EnumRef.LotRecordTypes"));
	TableOfTypesOfAdjustments.Columns.Add("MultipleExecutionIsPossible", New TypeDescription("Boolean"));
	TableOfTypesOfAdjustments.Columns.Add("NameOfInclusionConstant", 		 New TypeDescription("String"));
	TableOfTypesOfAdjustments.Columns.Add("NameOfStartDateConstant", New TypeDescription("String"));
	TableOfTypesOfAdjustments.Columns.Add("ParentalAdjustment", 	 New TypeDescription("EnumRef.LotRecordTypes"));
	TableOfTypesOfAdjustments.Columns.Add("SeparateItIntoSeparateDocument", 	 New TypeDescription("Boolean"));
	
	NewRow = TableOfTypesOfAdjustments.Add();
	NewRow.Adjusting = Enums.LotRecordTypes.ServiceEnableAccountingByPurposes;
	NewRow.NameOfInclusionConstant = Metadata.Constants.KeepRecordsOfInventoryCostByAssignments.Name;
	NewRow.NameOfStartDateConstant = Metadata.Constants.CostAccountingByAssignmentValidFrom.Name;
	
	NewRow = TableOfTypesOfAdjustments.Add();
	NewRow.Adjusting = Enums.LotRecordTypes.InternalChangingPriceEvaluationMethod;
	NewRow.MultipleExecutionIsPossible = True;
	NewRow.SeparateItIntoSeparateDocument = True;
	
	NewRow = TableOfTypesOfAdjustments.Add();
	NewRow.Adjusting = Enums.LotRecordTypes.ServiceDisableGoodsAccountingByAssignments;
	NewRow.ParentalAdjustment = Enums.LotRecordTypes.ServiceEnableAccountingByPurposes;
	
	CalculationOfCostLocalization.CompleteDescriptionOfAdjustmentsToInitialBalances(TableOfTypesOfAdjustments);
	
	Return TableOfTypesOfAdjustments;
	
EndFunction


// Initializes the description of the accumulation register adjustment
//
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	RegisterName - String - full name of the accumulation register
//
// Returns:
//	Structure - description of the adjustment
//
Function InitializeAdjustmentOfRegisterBalances(CalculationParameters, RegisterName) Export
	
	If RegistersWithInitialRemainderAdjustments().Find(RegisterName) = Undefined Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Cần chỉ ra biểu ghi ""%1"" trong %2';
				|ru = 'Регистр ""%1"" должен быть указан в %2';
				|en = 'The ""%1"" register must be specified in %2'; fa = 'The ""%1"" register must be specified in %2';
				|it = 'Il registro ""%1"" deve essere indicato in %2';
				|pl = 'Rejestr ""%1"" powinien być podany w %2';
				|tr = '""%1"" kaydı %2 içinde belirtilmelidir'", Common.DefaultLanguageCode()),
			RegisterName,
			"CostCalculationAppliedAlgorithms.RegistersWithInitialRemainderAdjustments");
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.RunTimeError,
			ProtocolText_);
		
	EndIf;
	
	AdjustmentParameters = New Structure;
	
	RegisterMetadata = Metadata.FindByFullName(RegisterName);
	
	// register description
	AdjustmentParameters.Insert("RegisterMetadata", 	 RegisterMetadata); // register metadata object
	AdjustmentParameters.Insert("FullRegisterName", 	 RegisterName); // the full name of the register from the metadata
	AdjustmentParameters.Insert("RegisterName", 			 RegisterMetadata.Name); // register name from the metadata object
	AdjustmentParameters.Insert("RegisterPresentation", RegisterMetadata.Synonym); // representation of a register from a metadata object
	AdjustmentParameters.Insert("RegisterDescription", 	 CalculationParameters.RegisterRecords[AdjustmentParameters.RegisterName]); // register description
	AdjustmentParameters.Insert("IsAccumulationRegister",  AdjustmentParameters.RegisterDescription.IsAccumulationRegister);
	AdjustmentParameters.Insert("SubordinateToRegistrar",  AdjustmentParameters.RegisterDescription.SubordinateToRegistrar);
	AdjustmentParameters.Insert("Periodic3",  		 AdjustmentParameters.RegisterDescription.Periodic3);
	AdjustmentParameters.Insert("ThereIsSliceOfLatter",  	 AdjustmentParameters.RegisterDescription.ThereIsSliceOfLatter);
	
	// Description of temporary tables
	AdjustmentParameters.Insert("NameOfRemainderTable", AdjustmentParameters.RegisterDescription.NameOfInitialRegisterBalanceTable); // the number of tables of generated movements of the type vtcorrection<Register Name><Table Numbers>
	AdjustmentParameters.Insert("NumberOfGeneratedTables", 0); // the number of tables of generated movements of the type vtcorrection<Register Name><Table Numbers>
	AdjustmentParameters.Insert("NamesOfGeneratedTables", ""); // the names of all tables of the vtcorrection type<Register Name><Table Numbers>
	AdjustmentParameters.Insert("ExistingTables", GetListOfExistingTemporaryTables(CalculationParameters)); // names of all tables that existed before the start of the adjustment
	
	// description of the adjustment
	AdjustmentParameters.Insert("AdjustmentRecordType", 	   Undefined); // type of record of the current adjustment
	AdjustmentParameters.Insert("OrganizationsToAdjust", New Array); // organizations that need an adjustment
	
	// Clearing outdated adjustments
	ClearOutdatedRegisterAdjustments(CalculationParameters, AdjustmentParameters);
	
	Return AdjustmentParameters;
	
EndFunction

// Completes the adjustment of the register and records all the corrective movement.
//
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	AdjustmentParameters - Structure - adjustment parameters, See InitializeAdjustmentOfRegisterBalances
//                                      ()
Procedure CompleteAdjustmentOfRegisterBalances(CalculationParameters, AdjustmentParameters) Export
	
	If Not AdjustmentParameters.RegisterDescription.SubordinateToRegistrar Then
		
		WriteIndependentInformationRegister(
			CalculationParameters,
			AdjustmentParameters.RegisterDescription,
			AdjustmentParameters.NamesOfGeneratedTables,
			True);
		
		Return;
		
	EndIf;
	
	#Region FormationOfTableOfNewRegisteredRecords
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.SetParameter("BeginningOfObsoleteAdjustmentPeriod", BegOfMonth(BegOfMonth(CalculationParameters.PayrollPeriod.EndOfPreviousPeriod) - 1));
	Query.SetParameter("EndOfObsoleteAdjustmentPeriod",  BegOfMonth(CalculationParameters.PayrollPeriod.EndOfPreviousPeriod) - 1);
	
	// If there are no generated adjustments, then we will put only "old" document movements that are not adjustments in the <Table Name>.
	// If there are adjustments, then we will put the "old" movements in the current movement of the document of the calculation of the value and combine it with the "new" corrective movements in the <Table name of the new movements>.
	Query.Text =
	"SELECT
	|	&RegisterFields
	|INTO TTOtherRegisteredRecordsOfCostCalculationDocuments
	|FROM
	|	NameOfMainRegisterTable AS T
	|		INNER JOIN TTDocumentsForCalculatingCostOfPreviousPeriod AS CostCalculationDocuments
	|		ON T.Recorder = CostCalculationDocuments.Ref
	|		AND CostCalculationDocuments.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
	|WHERE
	|	T.Period BETWEEN &BeginningOfPreviousPeriod AND &EndOfPreviousPeriod
	|	AND T.Organization IN (&CompanyArray)
	|	AND &SelectionByRecordTypeIsNotAllowed
	|
	|UNION ALL
	|
	|SELECT
	|	&RegisterFields
	|FROM
	|	NameOfMainRegisterTable AS T
	|		INNER JOIN TTDocumentsForCalculatingCostOfPreviousPeriod AS CostCalculationDocuments
	|		ON T.Recorder = CostCalculationDocuments.Ref
	|WHERE
	|	T.Period BETWEEN &BeginningOfObsoleteAdjustmentPeriod AND &EndOfObsoleteAdjustmentPeriod
	|	AND T.Organization IN (&CompanyArray)
	|	AND &SelectionByRecordTypeAdjustingEntries
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT TOP 1
	|	1 AS Count
	|FROM
	|	TTOtherRegisteredRecordsOfCostCalculationDocuments AS T";
	
	Query.Text = StrReplace(Query.Text, "NameOfMainRegisterTable", AdjustmentParameters.FullRegisterName);
	Query.Text = StrReplace(Query.Text, "&RegisterFields",
		StringFunctionsClientServer.SubstituteParametersToString(AdjustmentParameters.RegisterDescription.FieldsOfMainRegisterTable, "T."));
	Query.Text = StrReplace(Query.Text, "AND &SelectionByRecordTypeIsNotAllowed",
		?(AdjustmentParameters.RegisterDescription.ThereIsRecordType, "AND NOT (T.EntryType IN (&TypesOfDataConversionRecords))", "AND FALSE"));
	Query.Text = StrReplace(Query.Text, "AND &SelectionByRecordTypeAdjustingEntries",
		?(AdjustmentParameters.RegisterDescription.ThereIsRecordType, "AND T.EntryType IN (&TypesOfDataConversionRecords)", ""));
	
	QueryResult = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True);
	
	If AdjustmentParameters.NumberOfGeneratedTables = 0 Then
		
		NameOfNewMovementTable = "TTOtherRegisteredRecordsOfCostCalculationDocuments"; // There can only be "other" RegisteredRecords of the cost calculation document
		
	Else
		
		If AdjustmentParameters.NumberOfGeneratedTables = 1 And QueryResult.IsEmpty() Then
			
			NameOfNewMovementTable = AdjustmentParameters.NamesOfGeneratedTables; // There is only one table of corrective RegisteredRecords
			
		Else
			
			// Let's combine all the new adjustment movements and "other" movements of the cost calculation document.
			NameOfNewMovementTable = "TTNewRegisterRegisteredRecords" + AdjustmentParameters.RegisterName;
			
			MergeTemporaryTables(
				CalculationParameters,
				CostCalculationUniversalAlgorithms.ConnectLines(
					AdjustmentParameters.NamesOfGeneratedTables,
					"TTOtherRegisteredRecordsOfCostCalculationDocuments"),
				NameOfNewMovementTable,
				AdjustmentParameters.RegisterDescription.FieldsOfMainRegisterTable,
				AdjustmentParameters.RegisterDescription.RegisterResources,
				,
				True);
			
		EndIf;
		
	EndIf;
	
	#EndRegion
	
	#Region CreatingTableOfModifiedDocuments
	
	// Let's compare the movements in <Table Name> with the movements of the same documents in the IB.
	Query.Text = "
	|SELECT DISTINCT
	|	T.Recorder
	|INTO TTModifiedDocuments
	|FROM
	|	(SELECT // new movements, with a plus
	|		&RegisterFields
	|	FROM
	|		TableOfNewRegisteredRecords AS T
	|
	|	UNION ALL
	|
	|	SELECT // old movements, with a minus
	|		&CaseFieldsWithMinus
	|	FROM
	|		NameOfMainRegisterTable AS T
	|			INNER JOIN TTDocumentsForCalculatingCostOfPreviousPeriod AS CostCalculationDocuments
	|			ON T.Recorder = CostCalculationDocuments.Ref
	|	WHERE
	|		T.Period BETWEEN &BeginningOfObsoleteAdjustmentPeriod AND &EndOfPreviousPeriod
	|		AND T.Organization IN (&CompanyArray)
	|	) AS T
	|
	|WHERE &FieldsGrouping
	|
	|	AND &SelectingNonEmptyResources
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT DISTINCT
	|	T.Recorder
	|INTO TTDocumentsWithRegisteredRecords
	|FROM
	|	TableOfNewRegisteredRecords AS T
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.Recorder AS Recorder,
	|	CASE WHEN NewRegisteredRecords_.Recorder IS NULL THEN FALSE ELSE TRUE END AS ThereAreNewRegisteredRecords_
	|INTO TTDocumentsToRecord
	|FROM
	|	TTModifiedDocuments AS T
	|		LEFT JOIN TTDocumentsWithRegisteredRecords AS NewRegisteredRecords_
	|		ON T.Recorder = NewRegisteredRecords_.Recorder";
	
	CaseFieldTextWithMinus  = "";
	TextSelectionOfNonEmptyResources = "";
	TextFieldGrouping 	   = "";
	
	FieldArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(AdjustmentParameters.RegisterDescription.FieldsOfMainRegisterTable, "%1", "T."),
		",",
		True,
		True);
	ArrayOfResources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(AdjustmentParameters.RegisterDescription.SelectionFieldsOfNonemptyMotions, "%1", "T."),
		",",
		True,
		True);
	
	For Each CurrentField In FieldArray Do
		
		ThisIsRegisterResource = (ArrayOfResources.Find(CurrentField) <> Undefined);
		
		If ThisIsRegisterResource Then
			// Resource
			TextSelectionOfNonEmptyResources = TextSelectionOfNonEmptyResources 
				+ ?(TextSelectionOfNonEmptyResources = "", "", "
				|	OR ") + "SUM(" + CurrentField + ") <> 0";
		Else
			// Measurement or props
			TextFieldGrouping = TextFieldGrouping 
				+ ?(TextFieldGrouping = "", "", ",
				|	") + CurrentField;
		EndIf;
		
		CaseFieldTextWithMinus = CaseFieldTextWithMinus 
			+ ?(CaseFieldTextWithMinus = "", "", ",
			|		") + ?(ThisIsRegisterResource, "-", "") + CurrentField;
		
	EndDo;
	
	TextFieldGrouping =  
		?(TextFieldGrouping = "", "", "GROUP BY
		|	") + TextFieldGrouping;
	TextSelectionOfNonEmptyResources =  
		?(TextSelectionOfNonEmptyResources = "", "", "HAVING
		|	") + TextSelectionOfNonEmptyResources;
	
	Query.Text = StrReplace(Query.Text, "NameOfMainRegisterTable", AdjustmentParameters.FullRegisterName);
	Query.Text = StrReplace(Query.Text, "TableOfNewRegisteredRecords", NameOfNewMovementTable);
	Query.Text = StrReplace(Query.Text, "&CaseFieldsWithMinus",
		StringFunctionsClientServer.SubstituteParametersToString(CaseFieldTextWithMinus, "T."));
	Query.Text = StrReplace(Query.Text, "&RegisterFields",
		StringFunctionsClientServer.SubstituteParametersToString(AdjustmentParameters.RegisterDescription.FieldsOfMainRegisterTable, "T."));
	Query.Text = StrReplace(Query.Text, "WHERE &FieldsGrouping",
		StringFunctionsClientServer.SubstituteParametersToString(TextFieldGrouping, "T."));
	Query.Text = StrReplace(Query.Text, "AND &SelectingNonEmptyResources",
		StringFunctionsClientServer.SubstituteParametersToString(TextSelectionOfNonEmptyResources, "T."));
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True);
	
	#EndRegion
	
	#Region PreparingMotionRecording
	
	WriteParameters = InitializeRecordingParameters(
		CalculationParameters.PayrollPeriod.BeginOfPeriod,
		CalculationParameters.TaskNumberBeforeCalculation);
	
	#EndRegion
	
	#Region CleaningUpOldRegisteredRecords
	
	// Let's clear the movements of documents that do not have movements in <Table Name>, but there are movements in the IB
	Query.Text =
	"SELECT
	|	T.Recorder
	|FROM
	|	TTDocumentsToRecord AS T
	|WHERE
	|	NOT T.ThereAreNewRegisteredRecords_";
	
	RecordRegisteredRecordsByRegister(
		Query,
		AdjustmentParameters.RegisterDescription.RegisterManager,
		WriteParameters);
	
	#EndRegion
	
	#Region RecordNewRegisteredRecords
	
	// We will record only documents with modified movements that have movements in <Table name of the same movements>.
	Query.Text =
	"SELECT
	|	&RegisterFields
	|FROM
	|	TableOfNewRegisteredRecords AS T
	|		LEFT JOIN TTDocumentsToRecord AS DocumentsToRecord
	|		ON T.Recorder = DocumentsToRecord.Recorder
	|WHERE
	|	ISNULL(DocumentsToRecord.ThereAreNewRegisteredRecords_, FALSE)
	|ORDER BY
	|	&OrderingFields_";
	
	TextOrderingFields  = CostCalculationUniversalAlgorithms.ConnectLines(
		"%1Recorder, %1Period",
		?(AdjustmentParameters.RegisterDescription.ThereIsRecordType, "%1EntryType", ""),
		AdjustmentParameters.RegisterDescription.RegisterDimensions,
		AdjustmentParameters.RegisterDescription.RegisterResources);
	
	Query.Text = StrReplace(Query.Text, "TableOfNewRegisteredRecords", NameOfNewMovementTable);
	Query.Text = StrReplace(Query.Text, "&OrderingFields_",
		StringFunctionsClientServer.SubstituteParametersToString(TextOrderingFields, "T."));
	Query.Text = StrReplace(Query.Text, "&RegisterFields",
		StringFunctionsClientServer.SubstituteParametersToString(AdjustmentParameters.RegisterDescription.FieldsOfMainRegisterTable, "T."));
	
	Try
		
		RecordRegisteredRecordsByRegister(
			Query,
			AdjustmentParameters.RegisterDescription.RegisterManager,
			WriteParameters);
		
	Except
		
		// We will add information about the error to the calculation protocol.
		// Then, at the end of the calculation, we will write down the calculation protocol and only then we will call an exception.
		ProtocolText_ = DetailErrorDescription(ErrorInfo());
		ProtocolText_ = StrReplace(ProtocolText_, ServiceSymbol_ProblemAlreadyRegistered(), "");
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenWritingRecordsInRegisters,
			ProtocolText_);
			
		If Not ExceptionIsCausedProgrammatically(ProtocolText_) Then
			RegisterCalculationExecutionProblem(
				CalculationParameters,
				,
				NStr("vi = 'Khi ghi bản ghi kết chuyển, đã chẩn đoán được lỗi';
					|ru = 'При записи движений диагностированы ошибки';
					|en = 'Errors were found when saving records'; fa = 'Errors were found when saving records';
					|it = 'Durante la scrittura dei movimenti sono stati diagnosticati degli errori';
					|pl = 'Błędy wykryte podczas zapisywania ruchów';
					|tr = 'Hareketleri kaydederken, hatalar teşhis edildi'", Common.DefaultLanguageCode()),
				ProtocolText_);
		EndIf;
		
	EndTry;
	
	#EndRegion
	
	#Region EndOfMotionRecording
	
	// Let's update the calculated register caches.
	If TemporaryTableSize(CalculationParameters, "TTDocumentsToRecord") > 0 Then
		
		Query.Text =
		"SELECT
		|	T.Recorder
		|FROM
		|	TTDocumentsToRecord AS T";
		
		CommonClientServer.SupplementArray(
			CalculationParameters.RecordersOfBalanceAdjustments,
			Query.Execute().Unload().UnloadColumn("Recorder"),
			True);
		
		UpdateCalculatedRegisterCaches(
			CalculationParameters,
			AdjustmentParameters.RegisterDescription.RegisterName);
		
	EndIf;
	
	// All data is recorded in the IB, auxiliary tables are no longer needed.
	NamesOfTablesToDelete = GetListOfExistingTemporaryTables(
		CalculationParameters,
		AdjustmentParameters.ExistingTables);
	
	RowsArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(NamesOfTablesToDelete, ",", True, True);
	NamesOfTablesToDelete = "";
	
	// We do not delete the tables of calculated balances and the tables of generated adjustments
	// (in case several adjustments of different registers are performed simultaneously).
	For Each TableName In RowsArray Do
		
		If StrStartsWith(TableName, "TTCalculatedInitialBalances")
		 And TableName <> AdjustmentParameters.NameOfRemainderTable Then
			Continue;
		ElsIf StrStartsWith(TableName, "TTAdjustment")
		 And Not StrStartsWith(TableName, "TTAdjustment" + AdjustmentParameters.RegisterName + "_") Then
			Continue;
		EndIf;
		
		CostCalculationUniversalAlgorithms.SupplementString(NamesOfTablesToDelete, TableName);
		
	EndDo;
	
	DestroyTemporaryTables(CalculationParameters, NamesOfTablesToDelete);
	
	RecordFactThatAdjustmentWasMade(CalculationParameters, AdjustmentParameters);
	
	#EndRegion
	
EndProcedure

Procedure CompleteBalanceAdjustments(CalculationParameters) Export
	
	CostCalculationProtocol.StartOfCalculationStage(CalculationParameters, "CompleteBalanceAdjustments");
	
	If Not ValueIsFilled(CalculationParameters.RecordersOfBalanceAdjustments) Then
		Return;
	EndIf;
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.SetParameter("RecordersOfBalanceAdjustments", CalculationParameters.RecordersOfBalanceAdjustments);
	
	Query.Text =
	"SELECT
	|	&EndOfPreviousPeriod 					  AS Period,
	|	T.Ref 					  				  AS Document,
	|	T.Organization 			  					  AS Organization,
	|   BEGINOFPERIOD(&EndOfPreviousPeriod, DAY) AS DateRecord
	|INTO DocumentsToBeReflected
	|FROM
	|	TTDocumentsForCalculatingCostOfPreviousPeriod AS T
	|WHERE
	|	T.Ref IN (&RecordersOfBalanceAdjustments)
	|	AND T.EntryType <> VALUE(Enum.LotRecordTypes.EmptyRef)
	|
	|INDEX BY
	|	Document,
	|	Organization";
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "DocumentsToBeReflected");
	
	
	AccountingReflectionParameters = InitializeReflectionParametersInAccounting(
		CalculationParameters,
		NStr("vi = 'Phản ánh vào kế toán quốc tế';
			|ru = 'Отражение в международном учете';
			|en = 'General ledger posting'; fa = 'ثبت در دفتر کل';
			|it = 'Visualizzazione in contabilità internazionale';
			|pl = 'Odzwierciedlenie w ewidencji międzynarodowej';
			|tr = 'Uluslararası muhasebede geçerlilik'", Common.DefaultLanguageCode()),
		"FinancialAccountingPostingServer.ReturnDocumentsToReflection",
		"DocumentsToBeReflected",
		True);
	
	ReflectDocumentsInAccounting(CalculationParameters, AccountingReflectionParameters);
	DestroyTemporaryTables(CalculationParameters, "DocumentsToBeReflected");
	
EndProcedure

// Initializes the next case adjustment.
//
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	AdjustmentParameters - See CostCalculationAppliedAlgorithms.InitializeAdjustmentOfRegisterBalances
//	AdjustmentRecordType - EnumRef.LotRecordTypes - type of adjustment record
//	ClearAdjustmentsForFollowingPeriods - Boolean - need to make similar adjustments in the following periods
//
Procedure StartNextAdjustmentOfRegisterBalances(CalculationParameters, AdjustmentParameters,
			AdjustmentRecordType, ClearAdjustmentsForFollowingPeriods = True) Export
	
	If CalculationParameters.FormInitialBatchBalances22 Then
		// When switching to PU 2.2, we will make all adjustments with one type of record so that we can "collapse" all corrective movements.
		EntryType = Enums.LotRecordTypes.InternalMigrationToLotAccounting22;
	Else
		EntryType = AdjustmentRecordType;
	EndIf;
	
	If TypesOfDataConversionRecords().Find(EntryType) = Undefined Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Cần chỉ ra kiểu bản ghi điều chỉnh ""%1"" trong %2';
				|ru = 'Тип записи корректировки ""%1"" должен быть указан в %2';
				|en = 'Adjustment record type ""%1"" must be specified in %2'; fa = 'Adjustment record type ""%1"" must be specified in %2';
				|it = 'Il tipo di registrazione della correzione ""%1"" deve essere indicato in %2';
				|pl = 'Typ wpisu korekty ""%1"" powinien być podany w %2';
				|tr = 'Düzeltme kayıt tipi ""%1"" %2''de belirtilmelidir'", Common.DefaultLanguageCode()),
			EntryType,
			"CostCalculationAppliedAlgorithms.TypesOfDataConversionRecords");
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.RunTimeError,
			ProtocolText_);
		
	EndIf;
	
	AdjustmentParameters.AdjustmentRecordType = AdjustmentRecordType;
	
	// Maintenance of the register of the calculation of the cost of the data and the correction of the data
	InitializeDescriptionOfOrganizationsToMakeAdjustments(CalculationParameters, AdjustmentParameters);
	
	AdjustmentParameters.AdjustmentRecordType = EntryType;
	
	If ClearAdjustmentsForFollowingPeriods Then
		// We will clear the movements of adjustments in the following periods.
		ClearRegisterAdjustmentsInFollowingPeriods(CalculationParameters, AdjustmentParameters);
	EndIf;
	
	// Let's clear the temporary tables of previous adjustments.
	NamesOfTablesToDelete = GetListOfExistingTemporaryTables(
		CalculationParameters,
		CostCalculationUniversalAlgorithms.ConnectLines(AdjustmentParameters.ExistingTables, AdjustmentParameters.NamesOfGeneratedTables));
	
	RowsArray = StringFunctionsClientServer.SplitStringIntoSubstringsArray(NamesOfTablesToDelete, ",", True, True);
	NamesOfTablesToDelete = "";
	
	ServiceTables = New Structure;
	For Each RegisterDescription In CalculationParameters.RegisterRecords Do
		ServiceTables.Insert(RegisterDescription.Value.NameOfInitialRegisterBalanceTable);
	EndDo;
	
	// We do not delete the tables of calculated balances and the tables of generated adjustments
	// (in case several adjustments of different registers are performed simultaneously).
	For Each TableName In RowsArray Do
		
		If ServiceTables.Property(TableName) Then
			Continue;
		ElsIf StrStartsWith(TableName, "TTAdjustment") Then
			Continue;
		EndIf;
		
		CostCalculationUniversalAlgorithms.SupplementString(NamesOfTablesToDelete, TableName);
		
	EndDo;
	
	DestroyTemporaryTables(CalculationParameters, NamesOfTablesToDelete);
	
	// Initialize the table of calculated initial register balances.
	GenerateTableOfCalculatedInitialRegisterBalances(CalculationParameters, AdjustmentParameters);
	
EndProcedure

// Adds adjustment movements for later recording.
//
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	AdjustmentParameters - Structure - adjustment parameters, See InitializeAdjustmentOfRegisterBalances
//                                      ()
//	AdjustmentTableNames - String - the names of the tables that store the generated corrective movements (the new balances)
//	TableNamesStorno - String - the names of tables that store a reverse movement (the old, written off balances)
//	DeleteAdjustmentTables - Boolean - delete tables from <table name>
//	DeleteTablesReverse - Boolean - delete tables from <table name>
//
Procedure AddRegisterAdjustmentRegisteredRecords(CalculationParameters, AdjustmentParameters,
			AdjustmentTableNames, TableNamesStorno = "", DeleteAdjustmentTables = False, DeleteTablesReverse = False) Export
	
	// We will prepare auxiliary data.
	RegisterColumnNames  = New Structure(StringFunctionsClientServer.SubstituteParametersToString(AdjustmentParameters.RegisterDescription.FieldsOfMainRegisterTable, ""));
	RegisterResourceNames = New Structure(StringFunctionsClientServer.SubstituteParametersToString(AdjustmentParameters.RegisterDescription.RegisterResources, ""));
	NamesOfServiceColumns = New Structure("Recorder, Period, RecordType, EntryType, RegistrationPeriod");
	
	If AdjustmentParameters.RegisterDescription.ThereIsCalculationOfParties Then
		NamesOfServiceColumns.Insert("LotCalculation");
	EndIf;
	
	TablesNames = CostCalculationUniversalAlgorithms.ConnectLines(AdjustmentTableNames, TableNamesStorno);
	StructureOfTablesStorno = New Structure(TableNamesStorno);
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	Query.SetParameter("AdjustmentRecordType", AdjustmentParameters.AdjustmentRecordType);
	
	// If the correction is written in a separate document, then you need to check. that the document exists.
	// If there is no document, then we will create it.
	If AdjustmentParameters.SeparateItIntoSeparateDocument Then
		
		For Each KeyAndValue In New Structure(TablesNames) Do // for each table adjustments and reverse
			
			QueryTemplate =
			"SELECT DISTINCT
			|	T.Organization
			|FROM
			|	SourceName AS T
			|";
			QueryTemplate = StrReplace(QueryTemplate, "SourceName", KeyAndValue.Key);
			
			Query.Text = Query.Text + ?(Query.Text = "", "", "
			|UNION
			|") + QueryTemplate;
			
		EndDo;
		
		CompaniesWithAdjustments = Query.Execute().Unload().UnloadColumn("Organization");
		Query.SetParameter("CompaniesWithAdjustments", CompaniesWithAdjustments);
		
		Query.Text =
		"SELECT
		|	Companies.Ref
		|FROM
		|	Catalog.Companies AS Companies
		|	LEFT JOIN TTDocumentsForCalculatingCostOfPreviousPeriod AS Documents
		|		ON Companies.Ref = Documents.Organization
		|		AND Documents.EntryType = &AdjustmentRecordType
		|WHERE
		|	Companies.Ref IN (&CompaniesWithAdjustments)
		|	AND Documents.Organization IS NULL
		|";
		
		CompaniesWithoutDocuments = Query.Execute().Unload().UnloadColumn("Ref");
		
		If ValueIsFilled(CompaniesWithoutDocuments) Then
			
			Query.Text =
			"SELECT
			|	T.Ref,
			|	T.Organization,
			|	T.EntryType
			|FROM
			|	TTDocumentsForCalculatingCostOfPreviousPeriod AS T";
			
			DocumentsOfPreviousPeriod = Query.Execute().Unload();
			
			Try
				
				// Let's create the missing cost calculation documents for organizations.
				For Each CurrentCompany In CompaniesWithoutDocuments Do
					
					DocumentObject = Documents.InventoryCostCalculation.CreateDocument();
					
					DocumentFillingData = New Structure;
					DocumentFillingData.Insert("Date", 					CalculationParameters.PayrollPeriod.EndOfPreviousPeriod);
					DocumentFillingData.Insert("Organization", 			CurrentCompany);
					DocumentFillingData.Insert("PreliminaryCalculation", False);
					DocumentFillingData.Insert("EntryType", 			AdjustmentParameters.AdjustmentRecordType);
					
					DocumentFillingData.Insert("EvaluationMethod",
						DetermineMethodOfAssessingValueOfOrganizationSGoods(CalculationParameters, CurrentCompany));
					
					DocumentObject.Fill(DocumentFillingData);
					
					DocumentObject.AdditionalProperties.Insert("SkipPeriodClosingCheck", True);
						
					DocumentObject.Write(DocumentWriteMode.Posting);
					
					// Let's remember the document
					NwRw = DocumentsOfPreviousPeriod.Add();
					NwRw.Ref = DocumentObject.Ref;
					NwRw.Organization = CurrentCompany;
					NwRw.EntryType = AdjustmentParameters.AdjustmentRecordType;
					
				EndDo;
				
			Except
				
				ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Không thể khởi tạo chứng từ tính giá vốn kỳ trước của doanh nghiệp ""%1"" do:
						|%2';
						|ru = 'Не удалось инициализировать документ расчета себестоимости прошлого периода организации ""%1"" по причине:
						|%2';
						|en = 'Cannot initialize the previous period cost calculation document for %1. Reason:
						|%2'; fa = 'Cannot initialize the previous period cost calculation document for %1. Reason:
						|%2';
						|it = 'Cannot initialize the previous period cost calculation document for %1. Reason:
						|%2';
						|pl = 'Cannot initialize the previous period cost calculation document for %1. Reason:
						|%2';
						|tr = '""%1"" iş yerinin son dönem maliyetlendirme belgesi şu sebeple başlatılamadı:
						|%2'", Common.DefaultLanguageCode()),
					TrimAll(CurrentCompany),
					DetailErrorDescription(ErrorInfo()));
				
				CostCalculationProtocol.FixCalculationError(
					CalculationParameters,
					Enums.TypesOfLotAccountingAndCostErrors.ErrorOfCostCalculationDocumentsInInitializing,
					ProtocolText_);
				
				Raise TextExceptionToLogProblem(ProtocolText_);
				
			EndTry;
			
			DestroyTemporaryTables(CalculationParameters, "TTDocumentsForCalculatingCostOfPreviousPeriod");
			
			Query.Text =
			"SELECT
			|	T.Ref,
			|	&EndOfPreviousPeriod AS PointInTime,
			|	T.Organization,
			|	T.EntryType
			|INTO TTDocumentsForCalculatingCostOfPreviousPeriod
			|FROM
			|	&DocumentsOfPreviousPeriod AS T
			|
			|INDEX BY
			|	Ref";
			
			Query.SetParameter("DocumentsOfPreviousPeriod", DocumentsOfPreviousPeriod);
			
			ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
			
		EndIf;
		
		Query.SetParameter("TypeOfAdjustmentRecordForSelection", AdjustmentParameters.AdjustmentRecordType);
		
	Else
		
		Query.SetParameter("TypeOfAdjustmentRecordForSelection", Enums.LotRecordTypes.EmptyRef());
		
	EndIf;
	
	QueryTemplate =
	"SELECT
	|	&DestinationFields
	|INTO DestinationName
	|FROM
	|	SourceName AS T
	|	LEFT JOIN TTDocumentsForCalculatingCostOfPreviousPeriod AS CostCalculationDocuments
	|		ON T.Organization = CostCalculationDocuments.Organization
	|		AND CostCalculationDocuments.EntryType = &TypeOfAdjustmentRecordForSelection";
	
	For Each KeyAndValue In New Structure(TablesNames) Do // for each table adjustments and reverse
		
		// Source
		SourceTableName = KeyAndValue.Key;
		
		SourceTableStructure = UnloadTemporaryTable(CalculationParameters, SourceTableName, 1);
		If SourceTableStructure.Count() = 0 Then
			Continue; // there is no data in the source
		EndIf;
		
		SourceTableColumns = SourceTableStructure.Columns;
		
		// Receiver
		AdjustmentParameters.NumberOfGeneratedTables = AdjustmentParameters.NumberOfGeneratedTables + 1;
		
		DestinationTableName = "TTAdjustment" + AdjustmentParameters.RegisterName + "_" + CostCalculationUniversalAlgorithms.NumberPerLineWithoutSpaces(AdjustmentParameters.NumberOfGeneratedTables);
		CostCalculationUniversalAlgorithms.SupplementString(AdjustmentParameters.NamesOfGeneratedTables, DestinationTableName);
		
		ReceiverFieldText =
		"	CostCalculationDocuments.Ref AS Recorder,
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	&AdjustmentRecordType AS EntryType";
		
		If Not AdjustmentParameters.RegisterDescription.IsAccumulationRegister
		 And Not AdjustmentParameters.RegisterDescription.PeriodicRegister_ Then
			ReceiverFieldText = ReceiverFieldText + ",
				|	&BeginningOfPreviousPeriod AS RegistrationPeriod";
		Else
			ReceiverFieldText = ReceiverFieldText + ",
				|	&EndOfPreviousPeriod AS Period";
		EndIf;
		
		If AdjustmentParameters.RegisterDescription.ThereIsCalculationOfParties Then
			ReceiverFieldText = ReceiverFieldText + ",
				|	TRUE AS LotCalculation";
		EndIf;
		
		For Each KeyAndValue2 In RegisterColumnNames Do // receiver register columns
			
			ColumnName = KeyAndValue2.Key;
			
			If NamesOfServiceColumns.Property(ColumnName) Then // Service_
				
				Continue;// the text has already been formed
				
			ElsIf SourceTableColumns.Find(ColumnName) <> Undefined Then // take a column from a temporary table
				
				If RegisterResourceNames.Property(ColumnName) And StructureOfTablesStorno.Property(SourceTableName) Then
					TextSign = "-"; // resources with a minus sign
				Else
					TextSign = "";
				EndIf;
				
				TextField_ = TextSign + "T." + ColumnName;
				
			Else // set an empty column value
				
				RegisterTable = AdjustmentParameters.RegisterDescription.Table; //ValueTable
				ColumnValueType = CostCalculationUniversalAlgorithms.NonNullTypeDescriptions(
					RegisterTable.Columns.Find(ColumnName).ValueType);
				
				TextField_ = "&EmptyValue_" + ColumnName;
				
				Query.SetParameter(
					"EmptyValue_" + ColumnName,
					ColumnValueType.AdjustValue(Undefined));
				
			EndIf;
			
			CostCalculationUniversalAlgorithms.SupplementString(
				ReceiverFieldText,
				"	" + TextField_ + " AS " + ColumnName);
			
		EndDo; // receiver register columns
		
		Query.Text = QueryTemplate;
		Query.Text = StrReplace(Query.Text, "DestinationName",   DestinationTableName);
		Query.Text = StrReplace(Query.Text, "SourceName",   SourceTableName);
		Query.Text = StrReplace(Query.Text, "&DestinationFields", ReceiverFieldText);
		
		ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
		
	EndDo; // tables to add
	
	If DeleteAdjustmentTables Then
		DestroyTemporaryTables(CalculationParameters, AdjustmentTableNames);
	EndIf;
	
	If DeleteTablesReverse Then
		DestroyTemporaryTables(CalculationParameters, TableNamesStorno);
	EndIf;
	
EndProcedure

#EndRegion

#Region SupportingAdjustmentProcedures

// Generates a table of calculated initial balances in the Accountnachalnostatki<Register name>.
// The table is obtained as follows:
// real register balances - past adjustments from the IB + reversal of past adjustments from the IB
// - current adjustments made before the formation of estimated balances + reversal of current adjustments
//	
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	AdjustmentParameters - See CostCalculationAppliedAlgorithms.InitializeAdjustmentOfRegisterBalances
//
Procedure GenerateTableOfCalculatedInitialRegisterBalances(CalculationParameters, AdjustmentParameters)
	
	If Not AdjustmentParameters.IsAccumulationRegister
	 And Not AdjustmentParameters.RegisterDescription.PeriodicRegister_ Then
	 	Return;
	EndIf;
	
	CostCalculationProtocol.StartCreatingTemporaryTable(CalculationParameters,
		AdjustmentParameters.NameOfRemainderTable, NStr("vi = 'Phụ trợ';
														|ru = 'Вспомогательная';
														|en = 'Auxiliary'; fa = 'کمکی';
														|it = 'Ausiliaria';
														|pl = 'Auxiliary';
														|tr = 'Yardımcı'", Common.DefaultLanguageCode()));
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.SetParameter("OrganizationsToAdjust", AdjustmentParameters.OrganizationsToAdjust);
	
	#Region QueryTextTemplates_
	
	If AdjustmentParameters.IsAccumulationRegister Then
		
		QueryTemplate =
		"SELECT
		|	&RegisterDimensions,
		|	&RegisterResourcesAmount
		|INTO NameOfRemainderTable
		|FROM
		|	(SELECT
		|		&RegisterDimensions,
		|		1 AS Character,
		|		&RegisterResourcesBalance
		|	FROM
		|		AccumulationRegister.InventoryCost.Balance(&BorderEndOfPreviousPeriod,
		|			Organization IN (&OrganizationsToAdjust)) AS T
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		&RegisterDimensions,
		|		CASE WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt) THEN -1 ELSE 1 END AS Character,
		|		&ResourcesAndTurnover
		|	FROM
		|		AccumulationRegister.InventoryCost AS T
		|	WHERE
		|		T.Period BETWEEN &BeginningOfPreviousPeriod AND &EndOfPreviousPeriod
		|		AND T.Organization IN (&OrganizationsToAdjust)
		|		AND T.Recorder REFS Document.InventoryCostCalculation
		|		AND T.Active
		|		AND &SelectionByRecordType_
		|
		|	AND &SampleRequestsFromGeneratedAdjustments
		|	) AS T
		|
		|GROUP BY
		|	&RegisterDimensions
		|
		|HAVING
		|	&SelectingNonEmptyResources
		|";
		
		CurAdjustmentTemplate =
		"	
		|
		|	UNION ALL
		|	
		|	SELECT
		|		&RegisterDimensions,
		|		CASE WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt) THEN 1 ELSE -1 END AS Character,
		|		&ResourcesAndTurnover
		|	FROM
		|		NameOfAdjustmentResultsTable AS T";
		
		// Fields for substituting into templates.
		RegisterDimensions = StrReplace(AdjustmentParameters.RegisterDescription.RegisterDimensions, "%1", "T.");
		
	ElsIf AdjustmentParameters.ThereIsSliceOfLatter Then
		
		QueryTemplate =
		"SELECT
		|	&RegisterDimensions,
		|	&RegisterResourcesAmount
		|INTO NameOfRemainderTable
		|FROM
		|	(SELECT
		|		&RegisterDimensions,
		|		1 AS Character,
		|		&ResourcesAndTurnover
		|	FROM
		|		InformationRegister.GoodsCost.SliceLast(&EndOfPreviousPeriod,
		|			Organization IN (&OrganizationsToAdjust)) AS T
		|	
		|	UNION ALL
		|	
		|	SELECT
		|		&RegisterDimensions,
		|		-1 AS Character,
		|		&ResourcesAndTurnover
		|	FROM
		|		InformationRegister.GoodsCost AS T
		|	WHERE
		|		T.Period BETWEEN &BeginningOfPreviousPeriod AND &EndOfPreviousPeriod
		|		AND T.Organization IN (&OrganizationsToAdjust)
		|		AND &SelectionByRecordType_
		|
		|	AND &SampleRequestsFromGeneratedAdjustments
		|	) AS T
		|
		|GROUP BY
		|	&RegisterDimensions
		|
		|HAVING
		|	&SelectingNonEmptyResources
		|";
		
		CurAdjustmentTemplate =
		"	
		|
		|	UNION ALL
		|	
		|	SELECT
		|		&RegisterDimensions,
		|		1 AS Character,
		|		&ResourcesAndTurnover
		|	FROM
		|		NameOfAdjustmentResultsTable AS T";
		
		// Fields for substituting into templates.
		RegisterDimensions = StrReplace(AdjustmentParameters.RegisterDescription.RegisterDimensions, "%1", "T.");
		RegisterDimensions = CostCalculationUniversalAlgorithms.RemoveElementsFromTemplateString(RegisterDimensions, "T.EntryType");
		
	Else // periodic or non-periodic, without a cut of the last
		
		QueryTemplate =
		"SELECT
		|	&RegisterDimensions,
		|	&RegisterResourcesAmount
		|INTO NameOfRemainderTable
		|FROM
		|	(SELECT
		|		&RegisterDimensions,
		|		1 AS Character,
		|		&ResourcesAndTurnover
		|	FROM
		|		InformationRegister.GoodsCost AS T
		|	WHERE
		|		&SelectionCriteriaForPeriod
		|		AND Organization IN (&OrganizationsToAdjust)
		|		AND NOT (&SelectionByRecordType_)
		|	
		|	AND &SampleRequestsFromGeneratedAdjustments
		|	) AS T
		|
		|GROUP BY
		|	&RegisterDimensions
		|
		|HAVING
		|	&SelectingNonEmptyResources
		|";
		
		CurAdjustmentTemplate =
		"	
		|
		|	UNION ALL
		|	
		|	SELECT
		|		&RegisterDimensions,
		|		1 AS Character,
		|		&ResourcesAndTurnover
		|	FROM
		|		NameOfAdjustmentResultsTable AS T";
		
		// Fields for substituting into templates.
		RegisterDimensions = StrReplace(AdjustmentParameters.RegisterDescription.RegisterDimensions, "%1", "T.");
		RegisterDimensions = CostCalculationUniversalAlgorithms.RemoveElementsFromTemplateString(RegisterDimensions, "T.EntryType");
		
		QueryTemplate = StrReplace(QueryTemplate, "&SelectionCriteriaForPeriod",
			?(AdjustmentParameters.Periodic3,
				"T.Period BETWEEN &BeginningOfPreviousPeriod AND &EndOfPreviousPeriod",
				"T.Period <= &EndOfPreviousPeriod"));
		
	EndIf;
	
	#EndRegion
	
	// Fields for substituting into templates.
	RegisterResourcesAmount = StringFunctionsClientServer.SubstituteParametersToString(
		AdjustmentParameters.RegisterDescription.RegisterResourcesWithSuffix,
		"SUM(T.Character * T.",
		")");
	RegisterResourcesBalance = StringFunctionsClientServer.SubstituteParametersToString(
		AdjustmentParameters.RegisterDescription.RegisterResourcesWithSuffix,
		"T.",
		"Balance");
	ResourcesAndTurnover = StringFunctionsClientServer.SubstituteParametersToString(
		AdjustmentParameters.RegisterDescription.RegisterResourcesWithSuffix,
		"T.",
		"");
		
	TextSelectionByRecordType = ?(AdjustmentParameters.RegisterDescription.ThereIsRecordType, "T.EntryType IN (&TypesOfDataConversionRecords)", "TRUE");
	
	// We will form a selection based on non-empty register resources.
	TextSelectionOfNonEmptyResources = "";
	ArrayOfResources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
		StrReplace(AdjustmentParameters.RegisterDescription.RegisterResources, "%1", "T."),
		",",
		True,
		True);
	
	For Each CurrentField In ArrayOfResources Do
		
		TextSelectionOfNonEmptyResources = TextSelectionOfNonEmptyResources 
			+ ?(TextSelectionOfNonEmptyResources = "", "", "
			|	OR ") + "SUM(T.Character * " + CurrentField + ") <> 0";
		
	EndDo;
	
	// Let's form the query texts for the selection from the adjustment tables already formed during the current calculation.
	SampleTextFromGeneratedAdjustments = "";
	
	For TableNumber = 1 To AdjustmentParameters.NumberOfGeneratedTables Do
		
		SampleTextFromGeneratedAdjustments = SampleTextFromGeneratedAdjustments
		 + CurAdjustmentTemplate;
		
		SampleTextFromGeneratedAdjustments = StrReplace(SampleTextFromGeneratedAdjustments,
			"&RegisterDimensions", RegisterDimensions);
		SampleTextFromGeneratedAdjustments = StrReplace(SampleTextFromGeneratedAdjustments,
			"&ResourcesAndTurnover", ResourcesAndTurnover);
		SampleTextFromGeneratedAdjustments = StrReplace(SampleTextFromGeneratedAdjustments,
			"NameOfAdjustmentResultsTable", "TTAdjustment" + AdjustmentParameters.RegisterName + "_"
			+ CostCalculationUniversalAlgorithms.NumberPerLineWithoutSpaces(TableNumber));
		
	EndDo;
	
	// Substitute the parameters in the query text
	Query.Text = QueryTemplate;
	
	If TemporaryTableExists(CalculationParameters, AdjustmentParameters.NameOfRemainderTable) Then
		Query.Text =
		"DROP NameOfRemainderTable
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|" + Query.Text;
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "AccumulationRegister.InventoryCost", AdjustmentParameters.FullRegisterName);
	Query.Text = StrReplace(Query.Text, "InformationRegister.GoodsCost", AdjustmentParameters.FullRegisterName);
	Query.Text = StrReplace(Query.Text, "NameOfRemainderTable", 		AdjustmentParameters.NameOfRemainderTable);
	Query.Text = StrReplace(Query.Text, "&RegisterDimensions", 		RegisterDimensions);
	Query.Text = StrReplace(Query.Text, "&RegisterResourcesAmount", 	RegisterResourcesAmount);
	Query.Text = StrReplace(Query.Text, "&RegisterResourcesBalance", RegisterResourcesBalance);
	Query.Text = StrReplace(Query.Text, "&ResourcesAndTurnover", ResourcesAndTurnover);
	Query.Text = StrReplace(Query.Text, "&SelectionByRecordType_",		TextSelectionByRecordType);
	Query.Text = StrReplace(Query.Text, "&SelectingNonEmptyResources",	TextSelectionOfNonEmptyResources);
	
	Query.Text = StrReplace(Query.Text, "AND &SampleRequestsFromGeneratedAdjustments", SampleTextFromGeneratedAdjustments);
	
	Query.Execute();
	
	CostCalculationProtocol.EndFormationOfTemporaryTable(CalculationParameters);
	
EndProcedure

// Clears all adjustments made to inventory cost Calculation documents in the following periods.
// This operation is required for adjustments that have a specific due date.
//	
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	AdjustmentParameters - See CostCalculationAppliedAlgorithms.InitializeAdjustmentOfRegisterBalances
//
Procedure ClearRegisterAdjustmentsInFollowingPeriods(CalculationParameters, AdjustmentParameters)
	
	If Not AdjustmentParameters.IsAccumulationRegister Then
		Return;
	EndIf;
	
	AdjustmentParameters.RegisterDescription = CalculationParameters.RegisterRecords[AdjustmentParameters.RegisterName];
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	Query.SetParameter("AdjustmentRecordType", AdjustmentParameters.AdjustmentRecordType);
	
	Query.Text =
	"SELECT DISTINCT
	|	T.Recorder AS Recorder
	|FROM
	|	NameOfMainRegisterTable AS T
	|	INNER JOIN Document.InventoryCostCalculation AS Filter
	|	ON Filter.Ref = T.Recorder
	|WHERE
	|	T.Organization IN(&CompanyArray)
	|	AND T.Period > &EndOfPreviousPeriod
	|	AND &SelectionByRecordType_";
	
	TextSelectionByRecordType = ?(AdjustmentParameters.RegisterDescription.ThereIsRecordType,
		"T.EntryType = &AdjustmentRecordType
		|	AND NOT T.EntryType IN (&TypesOfMultipleDataConversionRecords)", "TRUE");
	
	Query.Text = StrReplace(Query.Text, "NameOfMainRegisterTable", AdjustmentParameters.FullRegisterName);
	Query.Text = StrReplace(Query.Text, "&SelectionByRecordType_", TextSelectionByRecordType);
	
	QueryResult = Query.Execute();
	
	If Not QueryResult.IsEmpty() Then
		
		Selection = QueryResult.Select();
		
		WriteParameters = InitializeRecordingParameters(
			CalculationParameters.PayrollPeriod.BeginOfPeriod,
			CalculationParameters.TaskNumberBeforeCalculation);
		
		RecordRegisteredRecordsByRegister(
			Selection,
			AdjustmentParameters.RegisterDescription.RegisterManager,
			WriteParameters);
			
		CostCalculationProtocol.AdditionalInformation(
			CalculationParameters,
			StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Đã xóa các bản ghi kết chuyển điều chỉnh theo biểu ghi ""%1"": %2';
					|ru = 'Очищено движений корректировки по регистру ""%1"": %2';
					|en = 'Adjustment records by the register ""%1"" are cleared: %2'; fa = 'Adjustment records by the register ""%1"" are cleared: %2';
					|it = 'Cancellati movimenti della correzione in base al registro ""%1"": %2';
					|pl = 'Usunięto ruchy korekty z rejestru „%1”: %2';
					|tr = '""%1"" kaydı tarafından düzeltme hareketleri temizlendi: %2'", Common.DefaultLanguageCode()),
				AdjustmentParameters.RegisterPresentation,
				CostCalculationProtocol.ValuePresentation(Selection.Count())));
		
	EndIf;
	
EndProcedure

// Clears all adjustments to the documents for calculating the cost of Goods made according to the old scheme (in the previous period).
//	
// Parameters:
//	CalculationParameters - Structure - Calculation parameters
//	AdjustmentParameters - See CostCalculationAppliedAlgorithms.InitializeAdjustmentOfRegisterBalances
