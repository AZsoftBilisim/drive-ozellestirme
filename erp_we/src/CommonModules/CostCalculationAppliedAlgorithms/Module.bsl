#Region WritingRegisterRecords

// Records the generated new Registered Recorded movements after their formation, until the end of the calculation.
//
// Parameters:
// 	CalculationParameters - Structure -
//	WriteRegisters - Array of String, Undefined - write only the specified registers
Procedure PreliminaryRecordingOfGeneratedRegisteredRecorded(CalculationParameters, WriteRegisters) Export
	
	If Not CalculationParameters.FederalLawRestrictions.PreliminaryRecordingOfGeneratedRegisteredRecorded
	 Or MaximumNumberOfRecordingTasks(CalculationParameters) < 2 Then
		Return; // pre-recording is supported only in the multithreaded version
	EndIf;

	If CalculationParameters.DebugParameters.Property("StageForDebugging") Then
		Return; // in the calculation debugging mode, no preliminary recording of the results is needed
	EndIf;
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(
		CalculationParameters,
		"PreliminaryRecordingOfGeneratedRegisteredRecorded",
		NStr("vi = 'Bắt đầu ghi lại các bản ghi kết chuyển đã tạo';
			|ru = 'Запуск записи сформированных движений';
			|en = 'Enable saving generated register records'; fa = 'Enable saving generated register records';
			|it = 'Запуск записи сформированных движений';
			|pl = 'Enable saving generated register records';
			|tr = 'Oluşturulan hareketlerin kaydının başlatılması'", Common.DefaultLanguageCode()));
	
	RecordGeneratedRegisteredRecords(CalculationParameters,, WriteRegisters);
	
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
	
EndProcedure

// Checks the possibility of forming Registered Records by register.
// If the register has already been recorded by the method of pre-recording the generated movements(), then the formation of new Registered Recorded movements is not possible.
//
// Parameters:
//	RegisterDescription - Structure -
//
Procedure CheckFormationOfRegisterRecordedRegister(RegisterDescription)

	If RegisterDescription.RegisterIsWritten Then
		
		ErrorText = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đã tạo bản ghi kết chuyển theo biểu ghi ""%1"" sau bản ghi kết chuyển theo biểu ghi này.';
				|ru = 'Сформированы движения по регистру ""%1"" после записи движений по данному регистру.';
				|en = 'The ""%1"" register records are generated after saving records of this register.'; fa = 'The ""%1"" register records are generated after saving records of this register.';
				|it = 'Сформированы движения по регистру ""%1"" после записи движений по данному регистру.';
				|pl = 'The ""%1"" register records are generated after saving records of this register.';
				|tr = 'Mevcut kayıttaki hareketler kaydedildikten sonra ""%1"" kaydında hareketler oluşturuldu.'", Common.DefaultLanguageCode()),
			RegisterDescription.RegisterName);
		
		Raise ErrorText;
		
	EndIf;
	
EndProcedure

// Records generated new movements.
//
// Parameters:
// 	CalculationParameters - Structure -
// 	CalculationProtocols - Array of Structure -
//	WriteRegisters - Array of String, Undefined - write only the specified registers
//
Procedure RecordGeneratedRegisteredRecords(CalculationParameters, CalculationProtocols = Undefined, WriteRegisters = Undefined) Export
	
	If Not CalculationParameters.PartiesAreBeingCalculated Then
		
		// We will restore the selection for all organizations, because when calculating the cost price, it was replaced when calculating for groups of organizations.
		CalculationParameters.Insert("CompanyArray",
			Common.CopyRecursive(CalculationParameters.CopyArrayOfOrganizations));
		
		// Let's restore temporary tables with selections for all organizations
		InitializeTemporaryTablesForSelections(CalculationParameters);
		
		If CalculationParameters.BatchCalculationStarted Then
			
			// Return to the batch calculation mechanism from the cost calculation
			CostCalculationMechanismIsPerformed(CalculationParameters, False);
			
			// We will restore all settlement caches of balances and turnover for all organizations
			UpdateCalculatedRegisterCaches_(CalculationParameters);
			
			Return; // you need to record the movements either at the end of the batch calculation, or at the end of a separate cost calculation
			
		EndIf;
		
		// We will delete the register data that was used in the cost calculation only for reading their caches.
		For Each KeyAndValue In CostCalculationCostAdjustment.UsedCachesOfBatchAccountingRegisters() Do
			DestroyRegisterData(CalculationParameters, KeyAndValue.Key);
		EndDo;
		
	EndIf;
	
	// Checks for errors in the generated movements.
	CheckCorrectnessOfGeneratedRegisteredRecords(CalculationParameters, WriteRegisters);
	
	CalculationOfCostLocalization.BeforeRecordingGeneratedRegisteredRecords(CalculationParameters);
	
	// Records movements and forms a temporary table in the changed documents
	StartRecordingRegisteredRecords(CalculationParameters, WriteRegisters);
	
	If ValueIsFilled(WriteRegisters) Then
		Return; // the remaining code must be executed after writing all the registers
	EndIf;
	
	// Waits for the end of recording tasks.
	CompletingMotionRecording(CalculationParameters);
	
	CalculationOfCostLocalization.RecordGeneratedRegisteredRecords(CalculationParameters);
	If (Not CalculationParameters.BatchCalculationStarted And Not CalculationParameters.PreliminaryCalculation)
	 Or CalculationParameters.PartiesAreBeingCalculated Then
		If CalculationParameters.FederalDistrict.UseFinancialAccounting Then
			// Forms movements according to official registers of international accounting
			RequirementsForReflectionInInternationalAccounting(CalculationParameters);
		EndIf;
	EndIf;
	CreateTasksForCalculatingReservesForImpairmentOfInventories(CalculationParameters);
	CreateTasksForRecognizingResearchAndDevelopmentExpenses(CalculationParameters);
	
	DestroyTemporaryTables(CalculationParameters, "TTModifiedDocuments");
	
	// Note in the "sequence registers" the current period as calculated
	If CalculationParameters.BatchCalculationStarted Then 
		
		If Not CalculationParameters.Debug.DoNotShiftPeriodAtEndOfCalculation
			And CalculationParameters.Property("InitialTasksForCalculatingCost") Then
			IncreaseCostCalculationPeriod(
				CalculationParameters.PayrollPeriod.BeginOfPeriod,
				CalculationParameters.CompanyArray,
				CalculationParameters.InitialTasksForCalculatingCost,
				CalculationParameters);
		EndIf;
		
	EndIf;
	
	If (Not CalculationParameters.BatchCalculationStarted And Not CalculationParameters.PreliminaryCalculation)
	 Or CalculationParameters.PartiesAreBeingCalculated Then
	 	// Checks the correctness of the balances at the end of a separate actual cost calculation or at the end of the batch calculation.
		CheckCorrectnessOfBalancesInRegisterCostOfGoodsAfterCalculation(CalculationParameters);
	EndIf;
	
	If CalculationProtocols <> Undefined Then
		// Save the protocol ID to the protocol array
		CalculationProtocols.Add(CostCalculationProtocol.UniqueProtocolID(CalculationParameters));
	EndIf;
	
	CalculationEnd(CalculationParameters);
	
EndProcedure

// Starts the process of recording new movements.
//
Procedure StartRecordingRegisteredRecords(CalculationParameters, WriteRegisters)
	
	CostCalculationProtocol.StartRecordingRegisteredRecords(CalculationParameters, WriteRegisters);
	
	RunNextWriteJobFromStack(CalculationParameters);
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	WriteParameters = InitializeRecordingParameters(
		CalculationParameters.PayrollPeriod.BeginOfPeriod,
		CalculationParameters.TaskNumberBeforeCalculation);
	
	// Let's arrange the register cache tables in descending order of their size to start writing from the largest registers.
	For Each KeyAndValue In CalculationParameters.RegisterRecords Do
		
		RegisterDescription = CalculationParameters.RegisterRecords[KeyAndValue.Key];
		
		If RegisterDescription.RegisterIsWritten
		 Or (ValueIsFilled(WriteRegisters)
		 	And WriteRegisters.Find(RegisterDescription.FullRegisterName) = Undefined) Then
			Continue;
		EndIf;
		
		RegisterDescription.RegisterIsWritten = True;
		
		QueryText =
		"SELECT
		|	&RegisterName AS RegisterName,
		|	COUNT(*) AS Count
		|FROM
		|	CacheTable AS T";
		
		QueryText = StrReplace(QueryText, "&RegisterName", """" + KeyAndValue.Key + """");
		QueryText = StrReplace(QueryText, "CacheTable",  KeyAndValue.Value.RegisterCacheTableName);
		
		Query.Text = Query.Text + ?(Query.Text = "", "", "
		|
		|	UNION ALL
		|
		|") + QueryText;
		
	EndDo;
	
	Query.Text = Query.Text + "
	|
	|ORDER BY
	|	Count DESC,
	|	RegisterName";
	
	SelectingWritableRegisters = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, NStr("vi = 'Sắp xếp bảng để ghi lại';
																												|ru = 'Упорядочивание таблиц для записи';
																												|en = 'Sort record tables'; fa = 'Sort record tables';
																												|it = 'Ordinazione delle tabelle per le voci';
																												|pl = 'Uporządkowanie tabel do zapisu';
																												|tr = 'Kayıt için tabloların düzenlenmesi'", Common.DefaultLanguageCode()));
	While SelectingWritableRegisters.Next() Do
		
		NameOfRegisterBeingWritten = TrimAll(SelectingWritableRegisters.RegisterName);
		RegisterDescription = CalculationParameters.RegisterRecords[NameOfRegisterBeingWritten];
		
		WriteParameters.Insert("RegistrarsWithLargeSets", Undefined);
		
		If Not NeedToWriteRegister(CalculationParameters, RegisterDescription) Then
			Continue;
		EndIf;
		
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = '*** Bắt đầu ghi biểu ghi';
				|ru = '*** Начало записи регистра';
				|en = '*** Register record start'; fa = '*** Register record start';
				|it = '*** Начало записи регистра';
				|pl = '*** Register record start';
				|tr = '*** Kayıt tablosu kaydının başlangıcı'") + " " + NameOfRegisterBeingWritten);
	
		CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
			CalculationParameters,
			TemporaryTableSize(CalculationParameters, RegisterDescription.RegisterCacheTableName));
		
		If RegisterDescription.SubordinateToRegistrar Then
			
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Bắt đầu tạo bảng';
					|ru = 'Начало формирования таблицы';
					|en = 'Start table generation'; fa = 'Start table generation';
					|it = 'Начало формирования таблицы';
					|pl = 'Start table generation';
					|tr = 'Tablo oluşturma başlangıcı'") + " TTCacheOldDocuments");
	
			// We will form Vtkashstaryedocuments
			CreateTableOfOldDocuments(CalculationParameters, RegisterDescription, Query);
			
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Bắt đầu tạo bảng';
					|ru = 'Начало формирования таблицы';
					|en = 'Start table generation'; fa = 'Start table generation';
					|it = 'Начало формирования таблицы';
					|pl = 'Start table generation';
					|tr = 'Tablo oluşturma başlangıcı'") + " TTCacheModifiedDocuments");
	
			// We will form vtkashizmennyedocuments
			CreateTableOfModifiedDocuments(CalculationParameters, RegisterDescription, Query);
			
			// Let's count the number of documents with modified movements
			DocumentsCount = TemporaryTableSize(CalculationParameters, "TTCacheModifiedDocuments");
			
		Else
			
			DocumentsCount = 0;
			
		EndIf;
		
		CostCalculationProtocol.RecordingGeneratedRegisteredRecords(
			CalculationParameters,
			NameOfRegisterBeingWritten,
			DocumentsCount);
		
		RunNextWriteJobFromStack(CalculationParameters);
		
		If RegisterDescription.SubordinateToRegistrar And DocumentsCount > 0 Then
			
			// Replacement templates in the request text
			FieldTextOfMainRegisterTable = TrimAll(StrReplace(RegisterDescription.FieldsOfMainRegisterTable, "%1", "
				|		T."));
			RegisterCacheFieldText 		     = TrimAll(StrReplace(RegisterDescription.RegisterCacheFields, "%1", "
				|		T."));
			ReplaceTrafficViewWithPlatformView(RegisterDescription, RegisterCacheFieldText);
			
			TextOfSortField = TrimAll(StrReplace(RegisterDescription.RegisterDimensions, "%1", "
				|		T."));
			TextOfSortField = "T.Recorder, T.Period"
				+ ?(TextOfSortField = "", "", ", ") + TextOfSortField
				+ ?(RegisterDescription.ThereIsCostCalculation, ", T.CalculationOfCost", "")
				+ ?(RegisterDescription.ThereIsCalculationOfParties, 		  ", T.LotCalculation", "");
			
			If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name Then
				NonTemporaryBalanceRecords =
					"	AND NOT T.SourceKind IN (
					|		VALUE(Enum.MovementSourcesKinds.BalanceCalculation)
					|)";
			Else
				NonTemporaryBalanceRecords = "";
			EndIf;
			
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Bắt đầu tạo bảng';
					|ru = 'Начало формирования таблицы';
					|en = 'Start table generation'; fa = 'Start table generation';
					|it = 'Начало формирования таблицы';
					|pl = 'Start table generation';
					|tr = 'Tablo oluşturma başlangıcı'") + " TTMovementCacheOfOtherPeriodsOrOrganizations");
	
			// Let's form a VTCASH movement of other periods or organizations
			CreateTableOfRegisteredRecordsOfOtherPeriodsOrOrganizations(CalculationParameters, RegisterDescription, Query);
			
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Bắt đầu tạo bảng';
					|ru = 'Начало формирования таблицы';
					|en = 'Start table generation'; fa = 'Start table generation';
					|it = 'Начало формирования таблицы';
					|pl = 'Start table generation';
					|tr = 'Tablo oluşturma başlangıcı'") + " TTCacheClearedDocuments");
	
			// Let's form the cachecashable documents
			CreateTableOfClearedDocuments(CalculationParameters, RegisterDescription, Query);
			
			CostCalculationProtocol.AddRegisteredRecordedInformation(
				CalculationParameters,
				NStr("vi = 'Chuẩn bị dữ liệu để xóa bản ghi kết chuyển cũ';
					|ru = 'Подготовка данных для очистки старых движений';
					|en = 'Prepare data to clear old records'; fa = 'Prepare data to clear old records';
					|it = 'Подготовка данных для очистки старых движений';
					|pl = 'Prepare data to clear old records';
					|tr = 'Eski hareketlerin temizlenmesi için verilerin hazırlanması'"));
			
			// Let's prepare data for cleaning up old movements
			Query.Text =
			"SELECT
			|	*
			|FROM
			|	TTCacheClearedDocuments AS T";
			
			QueryResult = Query.Execute();
			
			RegisterDescription.ThereIsChangedData = Not QueryResult.IsEmpty();
			
			If CalculationParameters.TotalsControl.DisableTotalsBeforeRecording
			 And RegisterDescription.ThereIsPropertyTypeOfMovement Then // This is the register of residuals
				
				CostCalculationProtocol.AddRegisteredRecordedInformation(
					CalculationParameters,
					NStr("vi = 'Tắt phần tổng kết của biểu ghi';
						|ru = 'Выключение итогов регистра';
						|en = 'Disable register totals'; fa = 'Disable register totals';
						|it = 'Выключение итогов регистра';
						|pl = 'Disable register totals';
						|tr = 'Toplam kayıtlarının kapatılması'"));
	
				TurnOffRegisterResults(CalculationParameters, RegisterDescription.RegisterManager);
				
			EndIf;
			
			If MaximumNumberOfRecordingTasks(CalculationParameters) < 2 Then
				
				// Let's record the movements synchronously, without background tasks.
				
				// Let's clear the old movements from the selected registrars
				StartDateOfRecording = CurrentSessionDate();
				
				CostCalculationProtocol.AddRegisteredRecordedInformation(
					CalculationParameters,
					NStr("vi = 'Xóa bản ghi kết chuyển cũ';
						|ru = 'Очистка старых движений';
						|en = 'Clear old records'; fa = 'Clear old records';
						|it = 'Очистка старых движений';
						|pl = 'Clear old records';
						|tr = 'Eski hareketlerin temizlenmesi'"));
				
				RecordRegisteredRecordsByRegister(
					QueryResult,
					RegisterDescription.RegisterManager,
					WriteParameters);
				
				CostCalculationProtocol.RecordingGeneratedRegisteredRecords(
					CalculationParameters,
					RegisterDescription.RegisterName,,,
					CurrentSessionDate() - StartDateOfRecording + 1);
				
				CostCalculationProtocol.AddRegisteredRecordedInformation(
					CalculationParameters,
					NStr("vi = 'Bắt đầu tạo bảng';
						|ru = 'Начало формирования таблицы';
						|en = 'Start table generation'; fa = 'Start table generation';
						|it = 'Начало формирования таблицы';
						|pl = 'Start table generation';
						|tr = 'Tablo oluşturma başlangıcı'") + " TTMotionForRecording");
				
				// Preparation of movements for those registrars for which there are differences in old/new movements - we combine
				//	- "primary" document movements in the calculation period
				//	- unreadable document movements
				//	- new "calculated" document movements.
				Query.Text =
				"SELECT
				|	&FieldsOfMainRegisterTable
				|INTO TTMotionForRecording
				|FROM
				|	NameOfMainRegisterTable AS T
				|		INNER JOIN TTCacheModifiedDocuments AS ModifiedDocuments
				|		ON T.Recorder = ModifiedDocuments.Recorder
				|WHERE
				|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
				|	AND &FilterByCompany
				|	AND &SelectionByServiceDetails
				|	AND &NonTemporaryBalanceRecords
				|
				|UNION ALL
				|
				|SELECT
				|	&FieldsOfMainRegisterTable
				|FROM
				|	TTMovementCacheOfOtherPeriodsOrOrganizations AS T
				|
				|UNION ALL
				|
				|SELECT
				|	&RegisterCacheFields
				|FROM
				|	RegisterCacheTableName AS T
				|		INNER JOIN TTCacheModifiedDocuments AS ModifiedDocuments
				|		ON T.Recorder = ModifiedDocuments.Recorder
				|";
				
				// Replace the templates in the request text
				Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
				Query.Text = StrReplace(Query.Text, "&RegisterCacheFields",   		 RegisterCacheFieldText);
				
				// Selection - primary movements
				If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name
				 And CalculationParameters.BatchCalculationStarted Then
					// Data from the IB is not selected - they are all in the cache
					Query.Text = StrReplace(Query.Text, "AND &SelectionByServiceDetails", "AND FALSE");
				EndIf;
				ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, True, False, False, False);
				Query.Text = StrReplace(Query.Text, "AND &NonTemporaryBalanceRecords", NonTemporaryBalanceRecords);
				
				ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, RegisterDescription.RegisterName);
				
				CostCalculationProtocol.AddRegisteredRecordedInformation(
					CalculationParameters,
					NStr("vi = 'Bắt đầu tạo bảng';
						|ru = 'Начало формирования таблицы';
						|en = 'Start table generation'; fa = 'Start table generation';
						|it = 'Начало формирования таблицы';
						|pl = 'Start table generation';
						|tr = 'Tablo oluşturma başlangıcı'") + " TTDocumentMovement");
				
				// Let's divide the recorders into portions for recording.
				Query.Text =
				"SELECT
				|	T.Recorder   AS Recorder,
				|	SUM(1) 		AS NumberOfRegisteredRecords
				|INTO TTDocumentMovement
				|FROM
				|	TTMotionForRecording AS T
				|GROUP BY
				|	T.Recorder
				|";
				
				ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, RegisterDescription.RegisterName);
				
				CostCalculationProtocol.AddRegisteredRecordedInformation(
					CalculationParameters,
					NStr("vi = 'Bắt đầu chia tách bản ghi kết chuyển thành các phần';
						|ru = 'Начало разделения движений на порции';
						|en = 'Start dividing records into batches'; fa = 'Start dividing records into batches';
						|it = 'Начало разделения движений на порции';
						|pl = 'Start dividing records into batches';
						|tr = 'Hareket bölüştürmesinin başlangıcı'"));
				
				SeparationParameters = GenerateParametersForSplittingTemporaryTableIntoPortions(
					CalculationParameters.SamplingRestrictions.NumberOfVTZLines,
					"NumberOfRegisteredRecords", "NumberOfRegisteredRecords DESC, Recorder",, "Recorder, PortionNumber");
				
				MaxPortionNumber = DivideTemporaryTableIntoPortions(CalculationParameters, SeparationParameters, "TTDocumentMovement", RegisterDescription.RegisterName);
				
				Query.Text =
				"SELECT DISTINCT
				|	T.Recorder
				|FROM
				|	TTDocumentMovement AS T
				|WHERE
				|	T.NumberOfRegisteredRecords >= &NumberOfGnzRecords";
				
				WriteParameters.Insert("RegistrarsWithLargeSets", Query.Execute().Unload().UnloadColumn("Recorder"));
				
				Query.Text =
				"SELECT
				|	&FieldsOfMainRegisterTable
				|FROM
				|	TTMotionForRecording AS T
				|		INNER JOIN TTDocumentMovement AS RecordPortionLoggers
				|		ON T.Recorder = RecordPortionLoggers.Recorder
				|		AND RecordPortionLoggers.PortionNumber = &PortionNumber
				|
				|ORDER BY
				|	&Order
				|";
				
				Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
				Query.Text = StrReplace(Query.Text, "&Order", 					 TextOfSortField);
				
				For PortionNumber = 1 To MaxPortionNumber Do
					
					// Let's choose the next batch of movements.
					Query.SetParameter("PortionNumber", PortionNumber);
					
					CostCalculationProtocol.AddRegisteredRecordedInformation(
						CalculationParameters,
						NStr("vi = 'Bắt đầu ghi các phần của bản ghi kết chuyển';
							|ru = 'Начало записи порции движений';
							|en = 'Start record batch saving'; fa = 'Start record batch saving';
							|it = 'Начало записи порции движений';
							|pl = 'Start record batch saving';
							|tr = 'Hareket bölüştürmesi kaydının başlangıcı'"));
					
					Selection = ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,, True, RegisterDescription.RegisterName).Select();
					
					CostCalculationProtocol.RecordingGeneratedRegisteredRecords(CalculationParameters, NameOfRegisterBeingWritten, , Selection.Count());
					
					Try
						
						RegisterDescription.ThereIsChangedData = RegisterDescription.ThereIsChangedData Or Selection.Count() > 0;
						
						StartDateOfRecording = CurrentSessionDate();
						
						RecordRegisteredRecordsByRegister(
							Selection,
							RegisterDescription.RegisterManager,
							WriteParameters);
						
						CostCalculationProtocol.RecordingGeneratedRegisteredRecords(
							CalculationParameters,
							RegisterDescription.RegisterName,,,
							CurrentSessionDate() - StartDateOfRecording + 1);
						
					Except
						
						// We will add information about the error to the calculation protocol.
						// Then, at the end of the calculation, we will write down the calculation protocol and only then we will call an exception.
						ProtocolText_ = DetailErrorDescription(ErrorInfo());
						ProtocolText_ = StrReplace(ProtocolText_, ServiceSymbol_ProblemAlreadyRegistered(), "");
						
						CostCalculationProtocol.FixCalculationError(
							CalculationParameters,
							Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenWritingRecordsInRegisters,
							ProtocolText_);
							
						If Not ExceptionIsCausedProgrammatically(ProtocolText_) Then
							RegisterCalculationExecutionProblem(
								CalculationParameters,
								,
								NStr("vi = 'Khi ghi bản ghi kết chuyển, đã chẩn đoán được lỗi';
									|ru = 'При записи движений диагностированы ошибки';
									|en = 'Errors were found when saving records'; fa = 'Errors were found when saving records';
									|it = 'Durante la scrittura dei movimenti sono stati diagnosticati degli errori';
									|pl = 'Błędy wykryte podczas zapisywania ruchów';
									|tr = 'Hareketleri kaydederken, hatalar teşhis edildi'", Common.DefaultLanguageCode()),
								ProtocolText_);
						EndIf;
						
					EndTry;
					
				EndDo;
				
				DestroyTemporaryTables(CalculationParameters, "TTMotionForRecording, TTDocumentMovement");
				
			Else // multithreaded recording
					
				CostCalculationProtocol.AddRegisteredRecordedInformation(
					CalculationParameters,
					NStr("vi = 'Bắt đầu ghi đa luồng các bản ghi kết chuyển';
						|ru = 'Начало многопоточной записи движений';
						|en = 'Start multithreaded record saving'; fa = 'Start multithreaded record saving';
						|it = 'Начало многопоточной записи движений';
						|pl = 'Start multithreaded record saving';
						|tr = 'Çok iş parçacıklı hareket kaydının başlangıcı'"));
					
				RunNextWriteJobFromStack(CalculationParameters);
				
				RegisterEntryParameters = InitializeParametersForRecordingCalculationResults(
					CalculationParameters.PayrollPeriod.BeginOfPeriod,
					RegisterDescription,
					CalculationParameters.TaskNumberBeforeCalculation);
				
				// Let's record the movements asynchronously, in background tasks.
				
				If Not QueryResult.IsEmpty() Then
					
					// We will clear the old movement movements from the selected registrars.
					CacheChunkOfDataForWriting(CalculationParameters, RegisterEntryParameters, QueryResult, True,, True);
					
					If CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry Then
						
						RegisterEntryParameters = InitializeParametersForRecordingCalculationResults(
							CalculationParameters.PayrollPeriod.BeginOfPeriod,
							RegisterDescription,
							CalculationParameters.TaskNumberBeforeCalculation);
						
					EndIf;
					
				EndIf;
				
				// Dividing loggers into portions for parallel recording:
				// - the portion size will approximately correspond to the limit on the maximum size of the table of values
				// - one document cannot be present in several portions - otherwise one recording task will overwrite the results of another
				// - "large" documents are written one document per serving - we believe that the movements of the document will always "fit"
				// into the table of values.
				
				CostCalculationProtocol.AddRegisteredRecordedInformation(
					CalculationParameters,
					NStr("vi = 'Bắt đầu tạo bảng';
						|ru = 'Начало формирования таблицы';
						|en = 'Start table generation'; fa = 'Start table generation';
						|it = 'Начало формирования таблицы';
						|pl = 'Start table generation';
						|tr = 'Tablo oluşturma başlangıcı'") + " TTDocumentMovement");
				
				Query.Text =
				"SELECT TOP 9999999999999
				|	T.Recorder   		  	AS Recorder,
				|	SUM(T.NumberOfRegisteredRecords) AS NumberOfRegisteredRecords
				|INTO TTDocumentMovement
				|FROM
				|	(SELECT
				|		ModifiedDocuments.Recorder   AS Recorder,
				|		SUM(1) 						  AS NumberOfRegisteredRecords
				|	FROM
				|		NameOfMainRegisterTable AS T
				|			INNER JOIN TTCacheModifiedDocuments AS ModifiedDocuments
				|			ON T.Recorder = ModifiedDocuments.Recorder
				|	WHERE
				|		T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
				|		AND &FilterByCompany
				|		AND &SelectionByServiceDetails
				|		AND &NonTemporaryBalanceRecords
				|	GROUP BY
				|		ModifiedDocuments.Recorder
				|	
				|	UNION ALL
				|	
				|	SELECT
				|		T.Recorder,
				|		SUM(1) AS NumberOfRegisteredRecords
				|	FROM
				|		TTMovementCacheOfOtherPeriodsOrOrganizations AS T
				|	GROUP BY
				|		T.Recorder
				|	
				|	UNION ALL
				|	
				|	SELECT
				|		ModifiedDocuments.Recorder,
				|		SUM(1) AS NumberOfRegisteredRecords
				|	FROM
				|		RegisterCacheTableName AS T
				|			INNER JOIN TTCacheModifiedDocuments AS ModifiedDocuments
				|			ON T.Recorder = ModifiedDocuments.Recorder
				|	GROUP BY
				|		ModifiedDocuments.Recorder
				|	) AS T
				|
				|GROUP BY
				|	T.Recorder
				|ORDER BY
				|   NumberOfRegisteredRecords DESC
				|";
				
				// Selection - primary movements
				If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name
				 And CalculationParameters.BatchCalculationStarted Then
					// Data from the IB is not selected - they are all in the cache
					Query.Text = StrReplace(Query.Text, "AND &SelectionByServiceDetails", "AND FALSE");
				EndIf;
				ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, True, False, False, False);
				Query.Text = StrReplace(Query.Text, "AND &NonTemporaryBalanceRecords", NonTemporaryBalanceRecords);
				
				ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, RegisterDescription.RegisterName);
				
				RunNextWriteJobFromStack(CalculationParameters);
				
				CostCalculationProtocol.AddRegisteredRecordedInformation(
					CalculationParameters,
					NStr("vi = 'Bắt đầu chia tách bản ghi kết chuyển thành các phần';
						|ru = 'Начало разделения движений на порции';
						|en = 'Start dividing records into batches'; fa = 'Start dividing records into batches';
						|it = 'Начало разделения движений на порции';
						|pl = 'Start dividing records into batches';
						|tr = 'Hareket bölüştürmesinin başlangıcı'"));
				
				// Let's divide the recorders into portions for recording.
				SeparationParameters = GenerateParametersForSplittingTemporaryTableIntoPortions(
					CalculationParameters.FederalLawRestrictions.NumberOfRegisteredRecordsOfVfzRecording,
					"NumberOfRegisteredRecords", "NumberOfRegisteredRecords DESC, Recorder",, "PortionNumber");
				
				MaxPortionNumber = DivideTemporaryTableIntoPortions(CalculationParameters, SeparationParameters, "TTDocumentMovement", RegisterDescription.RegisterName);
				
				Query.Text =
				"SELECT DISTINCT
				|	T.Recorder
				|FROM
				|	TTDocumentMovement AS T
				|WHERE
				|	T.NumberOfRegisteredRecords >= &NumberOfGnzRecords";
				
				RegistrarsWithLargeSets = Query.Execute().Unload().UnloadColumn("Recorder");
				RegisterEntryParameters.Insert("RegistrarsWithLargeSets", RegistrarsWithLargeSets);
				
				// Preparation of movements for those registrars for which there are differences in old/new movements - we combine
				//	- "primary" document movements in the calculation period
				//	- unreadable document movements
				//	- new "calculated" document movements.
				
				Query.Text =
				"SELECT
				|	T.Recorder AS Recorder
				|INTO TTCurPortionLoggers
				|FROM
				|	TTDocumentMovement AS T
				|WHERE
				|	T.PortionNumber = &PortionNumber
				|
				|INDEX BY
				|	Recorder
				|;
				|////////////////////////////////////////////////////////////////////////////////
				|
				|SELECT TOP 9999999999999
				|	&FieldsOfMainRegisterTable
				|INTO TTMotionOfCurPortion
				|FROM
				|(SELECT
				|	&FieldsOfMainRegisterTable
				|FROM
				|	NameOfMainRegisterTable AS T
				|		INNER JOIN TTCurPortionLoggers AS RecordPortionLoggers
				|		ON T.Recorder = RecordPortionLoggers.Recorder
				|WHERE
				|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
				|	AND &FilterByCompany
				|	AND &SelectionByServiceDetails
				|	AND &NonTemporaryBalanceRecords
				|
				|UNION ALL
				|
				|SELECT
				|	&FieldsOfMainRegisterTable
				|FROM
				|	TTMovementCacheOfOtherPeriodsOrOrganizations AS T
				|		INNER JOIN TTCurPortionLoggers AS RecordPortionLoggers
				|		ON T.Recorder = RecordPortionLoggers.Recorder
				|
				|UNION ALL
				|
				|SELECT
				|	&RegisterCacheFields
				|FROM
				|	RegisterCacheTableName AS T
				|		INNER JOIN TTCurPortionLoggers AS RecordPortionLoggers
				|		ON T.Recorder = RecordPortionLoggers.Recorder
				|
				|) AS T
				|ORDER BY
				|	&Order";
				
				// Replace the templates in the request text
				Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
				Query.Text = StrReplace(Query.Text, "&RegisterCacheFields",   		 RegisterCacheFieldText);
				Query.Text = StrReplace(Query.Text, "&Order", 					 TextOfSortField);
				
				// Selection - primary movements
				If RegisterDescription.RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name
				 And CalculationParameters.BatchCalculationStarted Then
					// Data from the IB is not selected - they are all in the cache
					Query.Text = StrReplace(Query.Text, "AND &SelectionByServiceDetails", "AND FALSE");
				EndIf;
				ReplaceTemplatesInQueryText(CalculationParameters, RegisterDescription, Query, True, True, False, False, False);
				
				Query.Text = StrReplace(Query.Text, "AND &NonTemporaryBalanceRecords", 	 NonTemporaryBalanceRecords);
					
				RegisterDescription.ThereIsChangedData = True;
				
				TimeOfFormationOfTTMovementOfCurPortion = 0;
				TimeToUnloadValueTables = 0;
				
				For PortionNumber = 1 To MaxPortionNumber Do
					
					CostCalculationProtocol.AddRegisteredRecordedInformation(
						CalculationParameters,
						NStr("vi = 'Chuẩn bị phần tiếp theo của bản ghi kết chuyển';
							|ru = 'Подготовка очередной порции движений';
							|en = 'Prepare another batch of records'; fa = 'Prepare another batch of records';
							|it = 'Подготовка очередной порции движений';
							|pl = 'Prepare another batch of records';
							|tr = 'Sonraki hareket grubunun hazırlanması'"));
					
					// Let's choose the next batch of movements.
					Query.SetParameter("PortionNumber", PortionNumber);
					
					BeginTime = CurrentUniversalDateInMilliseconds();
					Query.Execute();
					TimeOfFormationOfTTMovementOfCurPortion = TimeOfFormationOfTTMovementOfCurPortion + CurrentUniversalDateInMilliseconds() - BeginTime;
					
					NumberOfRegisteredRecords = TemporaryTableSize(Query, "TTMotionOfCurPortion");
					
					If TemporaryTableSize(Query, "TTCurPortionLoggers") = 1
					 And NumberOfRegisteredRecords > CalculationParameters.FederalLawRestrictions.NumberOfRegisteredRecordsOfVfzRecording Then
					 
						PreviousText1 = Query.Text;
						
						NumberingParameters = GenerateParametersForNumberingRowsInTemporaryTable(
							"", // Separator
							"", // Resources
							StrReplace(TextOfSortField, "T.", ""), // Order
							"RecNo", // Number
							"", // IndexOf
							"", // accumulation
							True);
						
						FillInTemporaryTableRowNumbers(
							CalculationParameters,
							NumberingParameters,
							"TTMotionOfCurPortion",
							"TTRegisteredRecordsOfCurPortionAreNumbered",
							RegisterDescription.RegisterName);
						
						NumberOfSets = NumberOfRegisteredRecords / CalculationParameters.FederalLawRestrictions.NumberOfRegisteredRecordsOfVfzRecording;
						NumberOfSets = Int(NumberOfSets) + ?(Int(NumberOfSets) = NumberOfSets, 0, 1);
						
						Query.Text =
						"SELECT
						|	&FieldsOfMainRegisterTable
						|FROM
						|	TTRegisteredRecordsOfCurPortionAreNumbered AS T
						|WHERE
						|	T.RecNo >= &FirstEntryNumber
						|	AND T.RecNo <= &LastRecordNumber
						|ORDER BY
						|	&Order";
						
						Query.Text = StrReplace(Query.Text, "&FieldsOfMainRegisterTable", FieldTextOfMainRegisterTable);
						Query.Text = StrReplace(Query.Text, "&Order", 					 TextOfSortField);
						
						For SetNumber = 1 To NumberOfSets Do
							
							CostCalculationProtocol.AddRegisteredRecordedInformation(
								CalculationParameters,
								NStr("vi = 'Chuẩn bị bộ tiếp theo trong phần hiện tại';
									|ru = 'Подготовка очередного набора в текущей порции';
									|en = 'Prepare another set in the current batch'; fa = 'Prepare another set in the current batch';
									|it = 'Подготовка очередного набора в текущей порции';
									|pl = 'Prepare another set in the current batch';
									|tr = 'Mevcut paketin sonraki setinin hazırlanması'"));
					
							Query.SetParameter("FirstEntryNumber",
								(SetNumber - 1) * CalculationParameters.FederalLawRestrictions.NumberOfRegisteredRecordsOfVfzRecording);
							Query.SetParameter("LastRecordNumber",
								SetNumber * CalculationParameters.FederalLawRestrictions.NumberOfRegisteredRecordsOfVfzRecording - 1);
								
							BeginTime = CurrentUniversalDateInMilliseconds();
							RegisterRecordTable = Query.Execute().Unload();
							TimeToUnloadValueTables = TimeToUnloadValueTables + CurrentUniversalDateInMilliseconds() - BeginTime;
							
							If RegisterRecordTable.Count() = 0 Then
								Continue; // nothing got into this portion
							EndIf;
							
							// Let's record new movements.
							CacheChunkOfDataForWriting(CalculationParameters, RegisterEntryParameters, RegisterRecordTable,, SetNumber > 1, False);
							
						EndDo;
						
						Query.Text = PreviousText1;
						NumberOfRegisteredRecords = 0; // so that no further recording code is executed
						
						DestroyTemporaryTables(CalculationParameters, "TTRegisteredRecordsOfCurPortionAreNumbered");
						
						If CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry Then
							
							PutPieceOfDataOnStack(CalculationParameters, RegisterEntryParameters);
							
							RegisterEntryParameters = InitializeParametersForRecordingCalculationResults(
								CalculationParameters.PayrollPeriod.BeginOfPeriod,
								RegisterDescription,
								CalculationParameters.TaskNumberBeforeCalculation);
							
							RegisterEntryParameters.Insert("RegistrarsWithLargeSets", RegistrarsWithLargeSets);
							
						EndIf;
						
					Else
						
						BeginTime = CurrentUniversalDateInMilliseconds();
						RegisterRecordTable = UnloadTemporaryTable(Query, "TTMotionOfCurPortion",, TextOfSortField);
						TimeToUnloadValueTables = TimeToUnloadValueTables + CurrentUniversalDateInMilliseconds() - BeginTime;
						
					EndIf;
					
					DestroyTemporaryTables(CalculationParameters, "TTCurPortionLoggers, TTMotionOfCurPortion");
					
					If NumberOfRegisteredRecords = 0 Then
						Continue; // nothing got into this portion
					EndIf;
					
					CacheChunkOfDataForWriting(CalculationParameters, RegisterEntryParameters, RegisterRecordTable,,, True);
					
					If CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry Then
						
						RegisterEntryParameters = InitializeParametersForRecordingCalculationResults(
							CalculationParameters.PayrollPeriod.BeginOfPeriod,
							RegisterDescription,
							CalculationParameters.TaskNumberBeforeCalculation);
						
						RegisterEntryParameters.Insert("RegistrarsWithLargeSets", RegistrarsWithLargeSets);
						
					EndIf;
					
				EndDo;
				
				CostCalculationProtocol.AdditionalInformation(
					CalculationParameters,
					StringFunctionsClientServer.SubstituteParametersToString(
						NStr("vi = 'Thời gian lập bảng ""%1"" của biểu ghi ""%2"": %3';
							|ru = 'Время формирования таблиц ""%1"" регистра ""%2"": %3';
							|en = 'Time of the ""%1"" tables generation of the ""%2"" register: %3'; fa = 'Time of the ""%1"" tables generation of the ""%2"" register: %3';
							|it = 'Tempo di creazione delle tabelle ""%1"" del registro ""%2"": %3';
							|pl = 'Czas tworzenia tabel ""%1"" rejestru ""%2"": %3';
							|tr = '""%2"" kaydının ""%1"" tablolarının oluşturulma zamanı: %3'", Common.DefaultLanguageCode()),
						"TTMotionOfCurPortion",
						RegisterDescription.RegisterName,
						CostCalculationProtocol.TimePresentation(TimeOfFormationOfTTMovementOfCurPortion/1000, True)));
				
				CostCalculationProtocol.AdditionalInformation(
					CalculationParameters,
					StringFunctionsClientServer.SubstituteParametersToString(
						NStr("vi = 'Thời gian kết xuất kết quả truy vấn vào bảng giá trị, biểu ghi ""%1"": %2';
							|ru = 'Время выгрузки результатов запроса в таблицы значений, регистр ""%1"": %2';
							|en = 'Time of query results export to value tables, register ""%1"": %2'; fa = 'Time of query results export to value tables, register ""%1"": %2';
							|it = 'Tempo di caricamento dei risultati della richiesta nelle tabelle dei valori, registro ""%1"": %2';
							|pl = 'Czas wysyłki wyników zapytania w tabeli wartości, rejestr ""%1"": %2';
							|tr = 'Sorgu sonuçlarının değer tablolarına yüklenme zamanı, ""%1"" kayıt: %2'", Common.DefaultLanguageCode()),
						RegisterDescription.RegisterName,
						CostCalculationProtocol.TimePresentation(TimeToUnloadValueTables/1000, True)));
				
				DestroyTemporaryTables(CalculationParameters, "TTDocumentMovement");
				
				If Not CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry Then
					RunRegisterEntryJob(CalculationParameters, RegisterEntryParameters);
				EndIf;
				
			EndIf; // we write in background tasks
			
			DestroyTemporaryTables(CalculationParameters, "TTMovementCacheOfOtherPeriodsOrOrganizations, TTCacheClearedDocuments");
			
		EndIf; // there are changed documents
		
		DestroyTemporaryTables(CalculationParameters, "TTCacheOldDocuments, TTCacheModifiedDocuments");
		
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = 'Bổ sung bảng';
				|ru = 'Дополнение таблицы';
				|en = 'Supplement table'; fa = 'Supplement table';
				|it = 'Дополнение таблицы';
				|pl = 'Supplement table';
				|tr = 'Tablo ekleme'") + " TTModifiedDocuments");
			
		// Let's add the changed documents to the Cur register to the general table of the changed documents.
		Query.Text =
		"SELECT
		|	T.Recorder     			 AS Recorder,
		|	T.Organization     			 AS Organization,
		|	T.Period     	  			 AS Period,
		|	""NameOfRegisterBeingWritten"" AS RegisterName,
		|	&AffectsTransactions 			 AS AffectsTransactions
		|INTO NameOfTemporaryResultTable
		|FROM
		|	TTCacheModifiedDocumentsForReflection AS T";
		
		If Not RegisterDescription.SubordinateToRegistrar Then
			
			If Not ValueIsFilled(RegisterDescription.RegisterName) Then // for easy tag placement
				
			ElsIf RegisterDescription.PeriodicRegister_ Then
				
				Query.Text =
				"SELECT DISTINCT
				|	T.Recorder      			 AS Recorder,
				|	T.Organization      			 AS Organization,
				|	T.Period     	   			 AS Period,
				|	""NameOfRegisterBeingWritten"" AS RegisterName,
				|	&AffectsTransactions  			 AS AffectsTransactions
				|INTO NameOfTemporaryResultTable
				|FROM
				|(SELECT
				|	T.Period,
				|	T.OfficialTypeOfMovementParish,
				|	T.Recorder,
				|	T.Organization,
				|	T.ItemsLocationAttributes,
				|	T.InventoryOwnerAttribute,
				|	T.AccountingSection,
				|	T.Lot,
				|	T.LotVendorAttributes,
				|	T.FinancialAccountingDimension,
				|	T.VATActivityType,
				|
				|	Prices.DocumentInflow,
				|	Prices.LotVendorAttributesOfReceiptDocument,
				|	Prices.InventoryLocationAttributesOfReceiptDocument,
				|	&AdditionalPriceRegisterFields,
				|
				|	T.CostExcludingVAT AS CostExcludingVAT
				|FROM
				|	TTCashEstimatedTurnoverCostOfGoods AS T
				|		INNER JOIN RegisterCacheTableName AS Prices
				|		ON (Prices.Organization = T.Organization)
				|			AND (Prices.AccountingSection = T.AccountingSection)
				|			AND (Prices.ItemsLocationAttributes = T.ItemsLocationAttributes)
				|			AND (Prices.InventoryOwnerAttribute = T.InventoryOwnerAttribute)
				|			AND (Prices.Lot = T.Lot)
				|			AND (Prices.LotVendorAttributes = T.LotVendorAttributes)
				|			AND (Prices.VATActivityType = T.VATActivityType)
				|			AND (Prices.FinancialAccountingDimension = T.FinancialAccountingDimension)
				|WHERE
				|	T.Organization IN(&CompanyArray)
				|	AND NOT Prices.EntryType IN (&TypesOfDataConversionRecords)
				|	AND T.Count <> 0
				|
				|UNION ALL
				|
				|SELECT
				|	T.Period,
				|	CASE WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
				|		THEN TRUE
				|		ELSE FALSE
				|	END AS OfficialTypeOfMovementParish,
				|	T.Recorder,
				|	T.Organization,
				|	T.ItemsLocationAttributes,
				|	T.InventoryOwnerAttribute,
				|	T.AccountingSection,
				|	T.Lot,
				|	T.LotVendorAttributes,
				|	T.FinancialAccountingDimension,
				|	T.VATActivityType,
				|
				|	Prices.DocumentInflow,
				|	Prices.LotVendorAttributesOfReceiptDocument,
				|	Prices.InventoryLocationAttributesOfReceiptDocument,
				|	&AdditionalPriceRegisterFields,
				|
				|	-T.CostExcludingVAT AS CostExcludingVAT
				|FROM
				|	AccumulationRegister.InventoryCost AS T
				|		INNER JOIN NameOfMainRegisterTable AS Prices
				|		ON (Prices.Organization = T.Organization)
				|			AND (Prices.AccountingSection = T.AccountingSection)
				|			AND (Prices.ItemsLocationAttributes = T.ItemsLocationAttributes)
				|			AND (Prices.InventoryOwnerAttribute = T.InventoryOwnerAttribute)
				|			AND (Prices.Lot = T.Lot)
				|			AND (Prices.LotVendorAttributes = T.LotVendorAttributes)
				|			AND (Prices.VATActivityType = T.VATActivityType)
				|			AND (Prices.FinancialAccountingDimension = T.FinancialAccountingDimension)
				|WHERE
				|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
				|	AND T.Organization IN(&CompanyArray)
				|	AND Prices.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
				|	AND Prices.Organization IN(&CompanyArray)
				|	AND NOT Prices.EntryType IN (&TypesOfDataConversionRecords)
				|	AND T.Count <> 0
				|) AS T
				|GROUP BY
				|	T.Period,
				|	T.OfficialTypeOfMovementParish,
				|	T.Recorder,
				|	T.Organization,
				|	T.ItemsLocationAttributes,
				|	T.InventoryOwnerAttribute,
				|	T.AccountingSection,
				|	T.Lot,
				|	T.LotVendorAttributes,
				|	T.FinancialAccountingDimension,
				|	T.VATActivityType,
				|	&GroupingAdditionalPriceRegisterFields,
				|	T.DocumentInflow,
				|	T.LotVendorAttributesOfReceiptDocument,
				|	T.InventoryLocationAttributesOfReceiptDocument
				|HAVING
				|	SUM(T.CostExcludingVAT) <> 0
				|";
				
				If RegisterDescription.RegisterName = Metadata.InformationRegisters.ItemizeGoodsCostItemizedAndOtherCosts.Name Then
					Query.Text = StrReplace(Query.Text, "&AdditionalPriceRegisterFields", "Prices.ExpenseItem,
						|	Prices.DimensionOfExpenses");
					Query.Text = StrReplace(Query.Text, "&GroupingAdditionalPriceRegisterFields", "T.ExpenseItem,
						|	T.DimensionOfExpenses");
				Else
					Query.Text = StrReplace(Query.Text, "&AdditionalPriceRegisterFields,", "");
					Query.Text = StrReplace(Query.Text, "&GroupingAdditionalPriceRegisterFields,", "");
				EndIf;
				
				TextOfAmountsField = StringFunctionsClientServer.SubstituteParametersToString(
					RegisterDescription.RegisterResourcesWithSuffix,
					"CAST(CAST(Prices.",
					" AS NUMBER(31,10)) * CAST(T.Count AS NUMBER(15,3)) AS NUMBER (31,2))");
				TextOfSumFieldWithMinus = StringFunctionsClientServer.SubstituteParametersToString(
					RegisterDescription.RegisterResourcesWithSuffix,
					"-CAST(CAST(Prices.",
					" AS NUMBER(31,10)) * CAST(T.Count AS NUMBER(15,3)) AS NUMBER (31,2))");
				
				TextSelectionOfNonEmptyResources = "";
				ArrayOfResources = StringFunctionsClientServer.SplitStringIntoSubstringsArray(
					StrReplace(RegisterDescription.SelectionFieldsOfNonemptyMotions, "%1", "T."),
					",",
					True,
					True);
				
				For Each CurrentField In ArrayOfResources Do
					
					TextSelectionOfNonEmptyResources = TextSelectionOfNonEmptyResources 
						+ ?(TextSelectionOfNonEmptyResources = "", "", "
						|	OR ") + "SUM(" + CurrentField + ") <> 0";
					
				EndDo;
				
				Query.Text = StrReplace(Query.Text, "-T.CostExcludingVAT AS CostExcludingVAT", TextOfSumFieldWithMinus);
				Query.Text = StrReplace(Query.Text, "T.CostExcludingVAT AS CostExcludingVAT", TextOfAmountsField);
				Query.Text = StrReplace(Query.Text, "SUM(T.CostExcludingVAT) <> 0", TextSelectionOfNonEmptyResources);
				
			Else // non-periodic batch detail registers
				
				If Not TemporaryTableExists(CalculationParameters, "TTOfRegisteredRecordedCostPriceToVerifyChanges") Then
					
					Query.Text =
					"SELECT
					|	FALSE AS IBData,
					|	T.OfficialTypeOfMovementParish,
					|	T.Period,
					|	T.Recorder,
					|	T.Organization,
					|	T.Lot,
					|	T.LotVendorAttributes,
					|	T.InventoryOwnerAttribute,
					|	T.ItemsLocationAttributes.Products AS Products,
					|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
					|	CAST(SUM(T.Count) AS NUMBER(15,3)) AS Count
					|INTO TTOfRegisteredRecordedCostPriceToVerifyChanges
					|FROM
					|	TTCashEstimatedTurnoverCostOfGoods AS T
					|WHERE
					|	T.Count <> 0
					|GROUP BY
					|	T.OfficialTypeOfMovementParish,
					|	T.Period,
					|	T.Recorder,
					|	T.Organization,
					|	T.Lot,
					|	T.LotVendorAttributes,
					|	T.InventoryOwnerAttribute,
					|	T.ItemsLocationAttributes.Products,
					|	T.ItemsLocationAttributes.CHARACTERISTIC
					|
					|UNION ALL
					|
					|SELECT
					|	TRUE AS IBData,
					|	CASE WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
					|		THEN TRUE
					|		ELSE FALSE
					|	END AS OfficialTypeOfMovementParish,
					|	T.Period,
					|	T.Recorder,
					|	T.Organization,
					|	T.Lot,
					|	T.LotVendorAttributes,
					|	T.InventoryOwnerAttribute,
					|	T.ItemsLocationAttributes.Products AS Products,
					|	T.ItemsLocationAttributes.Characteristic AS Characteristic,
					|	CAST(SUM(-T.Count) AS NUMBER(15,3)) AS Count
					|FROM
					|	AccumulationRegister.InventoryCost AS T
					|WHERE
					|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
					|	AND T.Organization IN(&CompanyArray)
					|	AND T.Count <> 0
					|GROUP BY
					|	CASE WHEN T.RecordType = VALUE(AccumulationRecordType.Receipt)
					|		THEN TRUE
					|		ELSE FALSE
					|	END,
					|	T.Period,
					|	T.Recorder,
					|	T.Organization,
					|	T.Lot,
					|	T.LotVendorAttributes,
					|	T.InventoryOwnerAttribute,
					|	T.ItemsLocationAttributes.Products,
					|	T.ItemsLocationAttributes.Characteristic
					|
					|INDEX BY
					|	Products,
					|	Lot,
					|	LotVendorAttributes,
					|	InventoryOwnerAttribute,
					|	Characteristic,
					|	IBData,
					|	Organization";
					
					ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
					
				EndIf;
				
				Query.Text =
				"SELECT
				|	FALSE AS IBData,
				|	Prices.RegistrationPeriod AS Period,
				|	Prices.Organization,
				|	Prices.Lot,
				|	Prices.LotVendorAttributes,
				|	Prices.InventoryOwnerAttribute,
				|	Prices.Products,
				|	Prices.Characteristic,
				|	Prices.PreviousRedistributionCosts,
				|
				|	Prices.DocumentInflow,
				|	Prices.LotVendorAttributesOfReceiptDocument,
				|	&AdditionalPriceRegisterFields,
				|
				|	CAST(Prices.CostInclVAT AS NUMBER(31,10)) AS CostInclVAT,
				|	CAST(Prices.CostExcludingVAT AS NUMBER(31,10)) AS CostExcludingVAT,
				|	CAST(Prices.CostExcludingVATLocal AS NUMBER(31,10)) AS CostExcludingVATLocal,
				|	CAST(Prices.VATLocal AS NUMBER(31,10)) AS VATLocal,
				|	CAST(Prices.CostExcludingVATMan AS NUMBER(31,10)) AS CostExcludingVATMan,
				|	CAST(Prices.VATManag AS NUMBER(31,10)) AS VATManag
				|INTO VATTTOfBatchToCheckChanges
				|FROM
				|	RegisterCacheTableName AS Prices
				|WHERE
				|	NOT Prices.EntryType IN (&TypesOfDataConversionRecords)
				|
				|UNION ALL
				|
				|SELECT
				|	TRUE AS IBData,
				|	Prices.RegistrationPeriod AS Period,
				|	Prices.Organization,
				|	Prices.Lot,
				|	Prices.LotVendorAttributes,
				|	Prices.InventoryOwnerAttribute,
				|	Prices.Products,
				|	Prices.Characteristic,
				|	Prices.PreviousRedistributionCosts,
				|
				|	Prices.DocumentInflow,
				|	Prices.LotVendorAttributesOfReceiptDocument,
				|	&AdditionalPriceRegisterFields,
				|
				|	CAST(Prices.CostInclVAT AS NUMBER(31,10)) AS CostInclVAT,
				|	CAST(Prices.CostExcludingVAT AS NUMBER(31,10)) AS CostExcludingVAT,
				|	CAST(Prices.CostExcludingVATLocal AS NUMBER(31,10)) AS CostExcludingVATLocal,
				|	CAST(Prices.VATLocal AS NUMBER(31,10)) AS VATLocal,
				|	CAST(Prices.CostExcludingVATMan AS NUMBER(31,10)) AS CostExcludingVATMan,
				|	CAST(Prices.VATManag AS NUMBER(31,10)) AS VATManag
				|FROM
				|	NameOfMainRegisterTable AS Prices
				|WHERE
				|	Prices.RegistrationPeriod BETWEEN &BeginOfPeriod AND &EndOfPeriod
				|	AND Prices.Organization IN(&CompanyArray)
				|	AND NOT Prices.EntryType IN (&TypesOfDataConversionRecords)
				|
				|INDEX BY
				|	Products,
				|	Lot,
				|	LotVendorAttributes,
				|	InventoryOwnerAttribute,
				|	Characteristic,
				|	IBData,
				|	Organization
				|;
				|////////////////////////////////////////////////////////////////////////////////
				|SELECT DISTINCT
				|	T.Recorder      			 AS Recorder,
				|	T.Organization      			 AS Organization,
				|	T.Period     	   		 	 AS Period,
				|	""NameOfRegisterBeingWritten"" AS RegisterName,
				|	&AffectsTransactions  			 AS AffectsTransactions
				|INTO NameOfTemporaryResultTable
				|FROM
				|	TTOfRegisteredRecordedCostPriceToVerifyChanges AS T
				|		INNER JOIN VATTTOfBatchToCheckChanges AS Prices
				|		ON Prices.Lot = T.Lot
				|			AND Prices.Organization = T.Organization
				|			AND Prices.Products = T.Products
				|			AND Prices.Characteristic = T.Characteristic
				|			AND Prices.LotVendorAttributes = T.LotVendorAttributes
				|			AND Prices.InventoryOwnerAttribute = T.InventoryOwnerAttribute
				|			AND Prices.IBData = T.IBData
				|GROUP BY
				|	T.OfficialTypeOfMovementParish,
				|	T.Period,
				|	T.Recorder,
				|	T.Organization,
				|	T.Lot,
				|	T.LotVendorAttributes,
				|	T.InventoryOwnerAttribute,
				|	T.Products,
				|	T.Characteristic,
				|	Prices.PreviousRedistributionCosts,
				|	&AdditionalPriceRegisterFields,
				|	Prices.DocumentInflow,
				|	Prices.LotVendorAttributesOfReceiptDocument
				|HAVING
				|	SUM(CAST(Prices.CostInclVAT * T.Count AS NUMBER (31,2))) <> 0
				|	OR SUM(CAST(Prices.CostExcludingVAT * T.Count AS NUMBER (31,2))) <> 0
				|	OR SUM(CAST(Prices.CostExcludingVATLocal * T.Count AS NUMBER (31,2))) <> 0
				|	OR SUM(CAST(Prices.VATLocal * T.Count AS NUMBER (31,2))) <> 0
				|	OR SUM(CAST(Prices.CostExcludingVATMan * T.Count AS NUMBER (31,2))) <> 0
				|	OR SUM(CAST(Prices.VATManag * T.Count AS NUMBER (31,2))) <> 0
				|;
				|////////////////////////////////////////////////////////////////////////////////
				|DROP VATTTOfBatchToCheckChanges
				|";
				
				If RegisterDescription.RegisterName = Metadata.InformationRegisters.ItemizeGoodsLotCost.Name Then
					Query.Text = StrReplace(Query.Text, "&AdditionalPriceRegisterFields", "Prices.InventoryLocationAttributesOfReceiptDocument,
						|	Prices.WIPInventoryLocationAttributes");
				Else
					Query.Text = StrReplace(Query.Text, "&AdditionalPriceRegisterFields", "Prices.ExpenseItem,
						|	Prices.DimensionOfExpenses,
						|	Prices.WIPInventoryLocationAttributes");
				EndIf;
				
			EndIf;
			
		EndIf;
		
		Query.Text = StrReplace(Query.Text, "NameOfRegisterBeingWritten",   RegisterDescription.RegisterName);
		Query.Text = StrReplace(Query.Text, "NameOfMainRegisterTable", RegisterDescription.FullRegisterName);
		Query.Text = StrReplace(Query.Text, "RegisterCacheTableName", 	   RegisterDescription.RegisterCacheTableName);
		
		Query.SetParameter("AffectsTransactions",
			RegisterDescription.RegisterName <> Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name
			And Not CalculationOfCostLocalization.ThisIsLocalizableInformationRegister(RegisterDescription.RegisterName)
			And RegisterDescription.RegisterName <> Metadata.InformationRegisters.GoodsCost.Name);
		
		CostCalculationProtocol.StartOfCodeSnippetExecution(
			CalculationParameters,
			"TTModifiedDocuments",
			NStr("vi = 'Thêm bảng tạm theo dữ liệu biểu ghi';
				|ru = 'Дополнение временной таблицы по данным регистра';
				|en = 'Add register data to a temporary table'; fa = 'Add register data to a temporary table';
				|it = 'Aggiunta tabella temporanea in base ai dati del registro';
				|pl = 'Dodatek tabeli czasowej według danych rejestru';
				|tr = 'Kayıt verilerine dayalı geçici tablonun tamamlanması'", Common.DefaultLanguageCode()) + " " + RegisterDescription.RegisterName);
		
		If Not TemporaryTableExists(CalculationParameters, "TTModifiedDocuments") Then
		
			// Let's create a temporary table in the changed documents
			Query.Text = StrReplace(Query.Text, "NameOfTemporaryResultTable", "TTModifiedDocuments");
			ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, RegisterDescription.RegisterName);
			
		Else
			
			// Let's add the temporary table to the changed documents
			Query.Text = StrReplace(Query.Text, "NameOfTemporaryResultTable", "TTNewBatchOfModifiedDocuments");
			ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query,,,, RegisterDescription.RegisterName);
			
			MergeTemporaryTables(
				CalculationParameters,
				"TTNewBatchOfModifiedDocuments",
				"TTModifiedDocuments",
				"Recorder, Organization, Period, RegisterName, AffectsTransactions",
				"");
			
			DestroyTemporaryTables(CalculationParameters, "TTNewBatchOfModifiedDocuments");
			
		EndIf;
		
		CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
		
		DestroyTemporaryTables(CalculationParameters, "TTCacheModifiedDocumentsForReflection");
		If Not RegisterDescription.SubordinateToRegistrar Then
			
			DataForProtocol = WriteIndependentInformationRegister(
				CalculationParameters,
				RegisterDescription,
				RegisterDescription.RegisterCacheTableName,
				False);
			
			CostCalculationProtocol.RecordingGeneratedRegisteredRecords(
				CalculationParameters,
				RegisterDescription.RegisterName,
				DataForProtocol.NumberOfSets,
				DataForProtocol.RecordsCount,
				CurrentSessionDate() - DataForProtocol.StartDateOfRecording + 1);
			
		EndIf;
		
	EndDo;
	
	If MaximumNumberOfRecordingTasks(CalculationParameters) < 2 Then
		CostCalculationProtocol.EndOfMotionRecording(CalculationParameters);
	EndIf;
	
	// Let's fix the performance measurement data.
	CostCalculationProtocol.RecordTimeMeasurement(CalculationParameters);
	
	If Not ValueIsFilled(WriteRegisters) Then
		
		DestroyTemporaryTables(CalculationParameters, "TTOfRegisteredRecordedCostPriceToVerifyChanges");
		
	EndIf;
	
EndProcedure

// Completes the multithreaded motion recording process.
//
Procedure CompletingMotionRecording(CalculationParameters)
	
	If MaximumNumberOfRecordingTasks(CalculationParameters) < 2 Then
		// The recording is already finished - it was performed in one thread, without background tasks
		CostCalculationProtocol.AddRegisteredRecordedInformation(
			CalculationParameters,
			NStr("vi = 'Hoàn tất ghi bản ghi kết chuyển';
				|ru = 'Завершение записи движений';
				|en = 'End record saving'; fa = 'End record saving';
				|it = 'Завершение записи движений';
				|pl = 'End record saving';
				|tr = 'Hareket kaydının sonlandırılması'"));
		Return;
	EndIf;
	
	// If the movements are written by background tasks, then we will wait for the end of all tasks
	If CalculationParameters.FederalLawRestrictions.MultithreadedRegisterEntry
	 And Not CalculationParameters.Debug.DisableRecordingGeneratedRegisteredRecords Then
	 
		While CalculationParameters.DataStackForWriting.Count() > 0 Do
			RunNextWriteJobFromStack(CalculationParameters, True);
		EndDo;
	
	EndIf;
	
	WaitForWriteJobsToComplete(CalculationParameters, True);
	
	CostCalculationProtocol.AddRegisteredRecordedInformation(
		CalculationParameters,
		NStr("vi = 'Hoàn tất ghi bản ghi kết chuyển';
			|ru = 'Завершение записи движений';
			|en = 'End record saving'; fa = 'End record saving';
			|it = 'Завершение записи движений';
			|pl = 'End record saving';
			|tr = 'Hareket kaydının sonlandırılması'"));
	
	// Let's check the correctness of the formation of portions of the record.
	If Not CalculationParameters.Debug.MonitorVfzRegistrars
	 Or CalculationParameters.Debug.VfzRegistrars.Count() = 0 Then
		Return;
	EndIf;
	
	CalculationParameters.Debug.VfzRegistrars.GroupBy("RegisterName, Recorder", "Count");
	CalculationParameters.Debug.VfzRegistrars.Sort("Count Desc, RegisterName, Recorder");
	
	If CalculationParameters.Debug.VfzRegistrars[0].Count > 1 Then
		
		ProtocolText_ =	NStr("vi = 'Đã phân chia sai các bản ghi kết chuyển cho tùy chọn đối với bản ghi đa luồng. Bản ghi kết chuyển có thể không chính xác.';
								|ru = 'Некорректно выполнено разделение движений на порции для многопоточной записи. Движения могут быть некорректны.';
								|en = 'The movements are incorrectly divided into portions for multi-threaded writing. The movements might be incorrect.'; fa = 'The movements are incorrectly divided into portions for multi-threaded writing. The movements might be incorrect.';
								|it = 'È stata effettuata incorrettamente la divisione dei movimenti in porzioni per la scrittura a più thread. I movimenti potrebbero essere incorretti.';
								|pl = 'Nieprawidłowo wykonane rozdzielenie ruchów na kawałki w przypadku nagrywania wielowątkowego. Ruch może być nieprawidłowy.';
								|tr = 'Çok iş parçacıklı kayıt için hareketleri bölümlere ayırmak yanlıştır. Hareketler yanlış olabilir.'", Common.DefaultLanguageCode());
		
		CostCalculationProtocol.FixCalculationError(
			CalculationParameters,
			Enums.TypesOfLotAccountingAndCostErrors.AnErrorOccurredWhenWritingRecordsInRegisters,
			ProtocolText_);
		
		RegisterCalculationExecutionProblem(
			CalculationParameters,
			,
			NStr("vi = 'Khi ghi bản ghi kết chuyển, đã chẩn đoán được lỗi';
				|ru = 'При записи движений диагностированы ошибки';
				|en = 'Errors were found when saving records'; fa = 'Errors were found when saving records';
				|it = 'Durante la scrittura dei movimenti sono stati diagnosticati degli errori';
				|pl = 'Błędy wykryte podczas zapisywania ruchów';
				|tr = 'Hareketleri kaydederken, hatalar teşhis edildi'", Common.DefaultLanguageCode()),
			ProtocolText_);
		
	EndIf;
	
EndProcedure

// Initializes the structure of the record parameters.
// 
// Parameters:
//  CalculationPeriod - Date - the calculation period
//  TaskNumberBeforeCalculation - Number - Task Number Before Calculation
// 
// Returns:
//  Structure - Initialize Recording Parameters:
// * CalculationPeriod - Date - 
// * TaskNumberBeforeCalculation - Number - 
// * AddRecordSet - Boolean - 
// * SeparatorFieldName - String - 
// * NumberOfGnzRecords - Number - 
// * NumberOfWriteAttempts - Number - 
// * NumberOfLoggersInWriteTransaction - Number - 
Function InitializeRecordingParameters(CalculationPeriod, TaskNumberBeforeCalculation = -1) Export
	
	WriteParameters = New Structure;
	WriteParameters.Insert("CalculationPeriod", 		  CalculationPeriod);
	WriteParameters.Insert("TaskNumberBeforeCalculation", TaskNumberBeforeCalculation);
	WriteParameters.Insert("AddRecordSet", False);
	WriteParameters.Insert("SeparatorFieldName",    "DocumentInflow"); // for independent data registers (VAT lots), for dividing data into portions
	
	// additional recording parameters.
	ParameterValues = CalculationOfCostCached.ValuesOfTechnologicalParameters();
	
	WriteParameters.Insert("NumberOfGnzRecords",	ParameterValues.NumberOfGnzRecords);
	WriteParameters.Insert("NumberOfWriteAttempts", ParameterValues.NumberOfWriteAttempts);
	WriteParameters.Insert("NumberOfLoggersInWriteTransaction", ParameterValues.NumberOfLoggersInWriteTransaction);
	
	Return WriteParameters;
	
EndFunction

// Initializes the parameter structure for recording calculation results.
//
// Returns:
//	Structure -
//
Function InitializeParametersForRecordingCalculationResults(CalculationPeriod, RegisterDescription, TaskNumberBeforeCalculation = -1) Export
	
	RegisterEntryParameters = InitializeRecordingParameters(CalculationPeriod, TaskNumberBeforeCalculation);
	
	RegisterEntryParameters.Insert("RegisterName", 		  RegisterDescription.RegisterName);
	RegisterEntryParameters.Insert("RegisterManager", 	  RegisterDescription.RegisterManager);
	RegisterEntryParameters.Insert("CalculationID",  New UUID);
	RegisterEntryParameters.Insert("BatchesCount", 	  0);
	RegisterEntryParameters.Insert("NumberOfFirstPortion", 	  1);
	RegisterEntryParameters.Insert("CleaningPortions", 		  New Array); // portion numbers with data for cleaning movements
	RegisterEntryParameters.Insert("SupplementServings", 	  New Array); // number of portions with movements of "large" sets, for recording with the Replace parameter = A lie
	RegisterEntryParameters.Insert("DataPreparationTime", 0);
	RegisterEntryParameters.Insert("RecordsCount", 	  0);
	RegisterEntryParameters.Insert("RegistrarsWithLargeSets", New Array);
	RegisterEntryParameters.Insert("ItIsIndependentRegister", Not RegisterDescription.SubordinateToRegistrar);

	If RegisterEntryParameters.ItIsIndependentRegister Then
		RegisterEntryParameters.Insert("NotRaiseExceptionAtError", True);
	EndIf;
	
	Return RegisterEntryParameters;
	
EndFunction

// Records document movements in the specified register in the background task.
//
// Parameters:
//	RegisterEntryParameters - Structure - motion recording parameters
//
Procedure RecordRegisteredRecordsByRegisterAsBackgroundTask(RegisterEntryParameters) Export
	
	SetPrivilegedMode(True);
	
	BeginTime = CurrentUniversalDateInMilliseconds();
	TextStatistics = NStr("vi = 'Bắt đầu';
							|ru = 'Начало';
							|en = 'Start'; fa = 'شروع';
							|it = 'Inizio';
							|pl = 'Początek';
							|tr = 'Başlangıç'") + ": " + Format(CurrentSessionDate(), "DLF=DT");
	ErrorText = "";
	
	RegisterEntryParameters.Insert("NotRaiseExceptionAtError", True);
	RegisterEntryParameters.Insert("NumberOfSets", 0);
	RegisterEntryParameters.Insert("RecordsCount", 0);
	
	ItIsIndependentRegister = RegisterEntryParameters.Property("ItIsIndependentRegister") And RegisterEntryParameters.ItIsIndependentRegister;
	
	For PortionNumber = RegisterEntryParameters.NumberOfFirstPortion To RegisterEntryParameters.BatchesCount Do
		
		AccessManagement.DisableAccessKeysUpdate(True);
		
		Try
			
			ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
				NStr("vi = 'Biểu ghi %1, xử lý tùy chọn dữ liệu %2 trong số %3';
					|ru = 'Регистр %1, обработка порции данных %2 из %3';
					|en = 'Register %1, processing data batch %2 of %3'; fa = 'Register %1, processing data batch %2 of %3';
					|it = 'Registro %1, elaborazione della porzione dati %2 di %3';
					|pl = 'Rejestr %1, przetworzenie porcji danych %2 z %3';
					|tr = '%1 kayıt, %3''ün %2''lik veri bölümünü işleme'"),
				RegisterEntryParameters.RegisterName,
				PortionNumber,
				RegisterEntryParameters.BatchesCount);
			
			If PortionNumber > RegisterEntryParameters.NumberOfFirstPortion Then
				
				PortionRecordingTime = (CurrentUniversalDateInMilliseconds() - BeginTime) / (PortionNumber - RegisterEntryParameters.NumberOfFirstPortion) / 1000;
				RecordingTimeRemaining = PortionRecordingTime * (RegisterEntryParameters.BatchesCount - PortionNumber + 1);
				
				ProtocolText_ = ProtocolText_ + "; "
					+ StringFunctionsClientServer.SubstituteParametersToString(
						NStr("vi = 'thời gian ghi lại còn lại gần đúng: %1';
							|ru = 'примерное оставшееся время записи: %1';
							|en = 'approximate remaining writing time: %1'; fa = 'approximate remaining writing time: %1';
							|it = 'Tempo di registrazione rimanente: %1';
							|pl = 'przybliżony pozostały czas zapisywania: %1';
							|tr = 'yaklaşık kalan kayıt süresi: %1'"),
						CostCalculationProtocol.TimePresentation(RecordingTimeRemaining, False));
				
			EndIf;
			
			WriteLogEvent(
				EventLogEventName(Undefined, NStr("vi = 'Bản ghi kết chuyển';
													|ru = 'Запись движений';
													|en = 'Writing register records'; fa = 'Writing register records';
													|it = 'Scrittura dei movimenti';
													|pl = 'Nagrywanie ruchów';
													|tr = 'Hareket kaydı'", Common.DefaultLanguageCode())),
				EventLogLevel.Information,,,
				ProtocolText_);
			
			RegisterRecord = InformationRegisters.LotAccountingDataCache.CreateRecordManager();
			RegisterRecord.CalculationID = RegisterEntryParameters.CalculationID;
			RegisterRecord.DataType 			= Enums.DataTypesInLotAccountingCache.CalculationResult2;
			RegisterRecord.DataPortionNumber 	= PortionNumber;
			RegisterRecord.VersionNumber 			= TrimAll(Metadata.Version);
			
			RegisterRecord.Read();
			
			If Not RegisterRecord.Selected() Then
				
				AccessManagement.DisableAccessKeysUpdate(False);
				
				ErrorText = ErrorText + Chars.LF +
					StringFunctionsClientServer.SubstituteParametersToString(NStr("vi = 'Không tìm thấy phần dữ liệu số %1';
																					|ru = 'Не найдена порция данных №%1';
																					|en = 'Data batch %1 not found'; fa = 'Data batch %1 not found';
																					|it = 'Porzione dati n.%1 non trovata';
																					|pl = 'Nie znaleziono porcji danych nr %1';
																					|tr = 'Veri bölümü №%1 bulunamadı'"), PortionNumber);
					
				Break;
				
			EndIf;
			
			Table = RegisterRecord.Data.Get();
			
			RegisterEntryParameters.Insert("AddRecordSet", RegisterEntryParameters.SupplementServings.Find(PortionNumber) <> Undefined);
			
			If ItIsIndependentRegister Then
				RecordPortionOfRegisteredRecordsOfIndependentRegister(
					Table,
					RegisterEntryParameters.RegisterManager,
					RegisterEntryParameters);
			Else
				RecordRegisteredRecordsByRegister(
					Table,
					RegisterEntryParameters.RegisterManager,
					RegisterEntryParameters);
			EndIf;
			
			If RegisterEntryParameters.CleaningPortions.Find(PortionNumber) = Undefined Then
				RegisterEntryParameters.RecordsCount = RegisterEntryParameters.RecordsCount + Table.Count();
			EndIf;
			
			If ValueIsFilled(RegisterEntryParameters.DescriptionOfRecordingErrors) Then
				
				ErrorText = ErrorText + Chars.LF + RegisterEntryParameters.DescriptionOfRecordingErrors;
				
			EndIf;
			
			ClearWriteDataCache(RegisterEntryParameters.CalculationID, PortionNumber);
			
			AccessManagement.DisableAccessKeysUpdate(False);
			
		Except
			
			AccessManagement.DisableAccessKeysUpdate(False);
			
			ErrorText = ErrorText + Chars.LF +
				StringFunctionsClientServer.SubstituteParametersToString(
					NStr("vi = 'Lỗi nhiệm vụ nền của bản ghi kết chuyển:
						|%1';
						|ru = 'Ошибка фонового задания записи движений:
						|%1';
						|en = 'Register records writing background job error:
						|%1'; fa = 'Register records writing background job error:
						|%1';
						|it = 'Errore di registrazione del movimento del processo in background:
						|%1';
						|pl = 'Błąd zadania w tle wpisu ruchów:
						|%1';
						|tr = 'Hareket kaydının arka plan işinde hata:
						|%1'", Common.DefaultLanguageCode()),
					DetailErrorDescription(ErrorInfo()));
					
			Break;
			
		EndTry;
		
	EndDo;
	
	TextStatistics = TextStatistics + "; "
		+ NStr("vi = 'kết thúc';
				|ru = 'окончание';
				|en = 'end'; fa = 'end';
				|it = 'fine';
				|pl = 'zakończenie';
				|tr = 'bitiş'") + ": " + Format(CurrentSessionDate(), "DLF=DT") + "; "
		+ NStr("vi = 'thời lượng';
				|ru = 'длительность';
