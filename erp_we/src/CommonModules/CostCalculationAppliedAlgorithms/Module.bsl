#Region NumberingAndPartitioningOfTemporaryTableRows

// Returns the default column name for numbering rows in the temporary table.
//
// Returns:
//	String -
//
Function DefaultColumnNameForNumbering() Export
	Return "K";
EndFunction

// Adds a column for row numbering to the value table.
//
// Returns:
//	ValueTableColumn -
//
Function AddColumnForLineNumbering(Table, NameOfLineNumberField = "") Export
	
	If Not ValueIsFilled(NameOfLineNumberField) Then
		NameOfLineNumberField = DefaultColumnNameForNumbering();
	EndIf;
	
	Return AddNumberColumnToValueTable(Table, NameOfLineNumberField);
	
EndFunction

// Generates parameters for numbering rows in a temporary table.
//
// Returns:
//	Structure -
//
Function GenerateParametersForNumberingRowsInTemporaryTable(SeparatorFieldName = "",
			NamesOfSummableFields = "", NamesOfOrderingFields = "", NameOfLineNumberField = "",
			NamesOfIndexingFields = "", AccumulationFieldName = "", SelectingSeparator = True) Export
	
	NumberingParameters = New Structure;
	NumberingParameters.Insert("SeparatorFieldName", 		SeparatorFieldName);
	NumberingParameters.Insert("OptimalSeparator", 	?(SelectingSeparator, "", SeparatorFieldName));
	NumberingParameters.Insert("NamesOfSummableFields", 	NamesOfSummableFields);
	NumberingParameters.Insert("NamesOfOrderingFields", ?(Not ValueIsFilled(NamesOfOrderingFields), SeparatorFieldName, NamesOfOrderingFields));
	NumberingParameters.Insert("NameOfLineNumberField", 		?(Not ValueIsFilled(NameOfLineNumberField), DefaultColumnNameForNumbering(), NameOfLineNumberField));
	NumberingParameters.Insert("NamesOfIndexingFields", ?(Not ValueIsFilled(NamesOfIndexingFields), NumberingParameters.NameOfLineNumberField, NamesOfIndexingFields));
	NumberingParameters.Insert("AccumulationFieldName", 		AccumulationFieldName);
	NumberingParameters.Insert("NameOfOldNumberingTable","");
	
	Return NumberingParameters;
	
EndFunction

// Fills in the row numbers of the temporary table.
//
// Parameters:
// 	CalculationParameters - See InitializeGeneralCalculationParameters
// 	NumberingParameters - Structure -
// 	TableName - String - 
// 	NameOfNumberedTable - String -
//	Explanation - String -
Procedure FillInTemporaryTableRowNumbers(CalculationParameters, NumberingParameters, TableName, NameOfNumberedTable = Undefined, Explanation = "") Export
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(
		CalculationParameters,
		TableName,
		NStr("vi = 'Đánh số các dòng của bảng tạm';
			|ru = 'Нумерация строк временной таблицы';
			|en = 'Numbering of temporary table rows'; fa = 'Numbering of temporary table rows';
			|it = 'Numerazione delle righe della tabella temporanea';
			|pl = 'Numeracja wierszy tabeli tymczasowej';
			|tr = 'Geçici tablonun satırlarının numaralandırılması'", Common.DefaultLanguageCode())
			+ ?(Explanation = "", "", " (" + Explanation + ")"));
	
	If Not ValueIsFilled(NameOfNumberedTable) Then
		NameOfNumberedTable = TableName;
	EndIf;
	
	SaveInformationAboutOldNumbering = ValueIsFilled(NumberingParameters.NameOfOldNumberingTable);
	
	Query = New Query;
	Query.TempTablesManager = CalculationParameters.TempTablesManager;
	
	EmptyDataTable_ = UnloadTemporaryTable(CalculationParameters, TableName, 0);
	
	NamesOfSummableFields = NumberingParameters.NamesOfSummableFields;
	
	NamesOfAllOrderingFields = StrReplace(
		?(ValueIsFilled(NumberingParameters.NamesOfOrderingFields),
			NumberingParameters.NamesOfOrderingFields,
			NumberingParameters.OptimalSeparator),
		"	",
		" ");
	
	NamesOfAllOrderingFieldsForStructure = "";
	
	For Each CurrentFieldName In StringFunctionsClientServer.SplitStringIntoSubstringsArray(NamesOfAllOrderingFields, ",", True, True) Do
		
		CostCalculationUniversalAlgorithms.SupplementString(
			NamesOfAllOrderingFieldsForStructure,
			StringFunctionsClientServer.SplitStringIntoSubstringsArray(CurrentFieldName, ".")[0]);
			
	EndDo;
	
	StructureExcludedFields = New Structure("LineNumber, RequestSource, CalculationIsCompleted");
	If Not SaveInformationAboutOldNumbering Then
		StructureExcludedFields.Insert(NumberingParameters.NameOfLineNumberField);
	EndIf;
	
	StructureFieldNames 	 = New Structure(
		StrReplace(StrReplace(Lower(NamesOfAllOrderingFieldsForStructure), " asc", ""), " desc", "")
		+ ?(NamesOfSummableFields = "" Or NamesOfAllOrderingFieldsForStructure = "", "", ", ") + NamesOfSummableFields);
	
	For Each DataColumn In EmptyDataTable_.Columns Do
		
		If StructureExcludedFields.Property(DataColumn.Name)  // service field
		 Or StructureFieldNames.Property(DataColumn.Name) Then // the field is already being used for ordering
			Continue;
		EndIf;
		
		If ThisIsSummableColumnOfTable(DataColumn) Then // the names of the summation fields are not specified - we sum over all numeric fields
			NamesOfSummableFields = NamesOfSummableFields + ?(NamesOfSummableFields = "", "", ", ") + DataColumn.Name;
		Else
			NamesOfAllOrderingFields = NamesOfAllOrderingFields
				+ ?(NamesOfAllOrderingFields = "", "", ", ") + DataColumn.Name;
		EndIf;
		
		StructureFieldNames.Insert(StructureFieldNames);
		
	EndDo;
	
	NamesOfAllOrderingFields = NamesOfAllOrderingFields
		+ ?(NamesOfSummableFields = "" Or NamesOfAllOrderingFields = "", "", ", ") + NamesOfSummableFields;
	
	SummaryColumnNames = "";
	
	For Each DataColumn In EmptyDataTable_.Columns Do
		
		If Lower(DataColumn.Name) = Lower(NumberingParameters.NameOfLineNumberField) Then
			Continue;
		EndIf;
			
		SummaryColumnNames = SummaryColumnNames + ?(SummaryColumnNames = "", "", ",
			|	") + "T." + DataColumn.Name + " AS " + DataColumn.Name;
		
	EndDo;
	
	TableFieldText = "";
	TextOfDimensionField  = "";
	
	// Let's group the rows of the temporary table by all fields that are not summation fields.
	If Not SaveInformationAboutOldNumbering And ValueIsFilled(NumberingParameters.NamesOfSummableFields) Then
		
		StructureNamesOfSummableFields = New Structure(NumberingParameters.NamesOfSummableFields);
		
		For Each DataColumn In EmptyDataTable_.Columns Do
			
			If StructureNamesOfSummableFields.Property(DataColumn.Name) Then
				TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",
					|	") + "SUM(T." + DataColumn.Name + ") AS " + DataColumn.Name;
			Else
				TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",
					|	") + "T." + DataColumn.Name + " AS " + DataColumn.Name;
				TextOfDimensionField = TextOfDimensionField + ?(TextOfDimensionField = "", "", ",
					|	") + "T." + DataColumn.Name;
			EndIf;
			
		EndDo;
		
		TextOfDimensionField = ?(TextOfDimensionField = "", "", "GROUP BY
			|	") + TextOfDimensionField;
		
		Query.Text =
		"SELECT
		|	&TableFieldText
		|INTO TemporaryTableForGrouping
		|FROM
		|	SourceTableName AS T
		|WHERE &Group
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 9999999999999
		|	RECORDAUTONUMBER() AS TemporaryNumberingField,
		|	T.*
		|INTO TemporaryTableForNumbering
		|FROM
		|	TemporaryTableForGrouping AS T
		|
		|ORDER BY
		|	&NamesOfAllOrderingFields
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|DROP TemporaryTableForGrouping;
		|";
		
	Else 
	
		Query.Text = "
		|////////////////////////////////////////////////////////////////////////////////
		|SELECT TOP 9999999999999
		|	RECORDAUTONUMBER() AS TemporaryNumberingField,
		|	T.*
		|INTO TemporaryTableForNumbering
		|FROM
		|	SourceTableName AS T
		|
		|ORDER BY
		|	&NamesOfAllOrderingFields
		|";
		
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "&TableFieldText", TableFieldText);
	Query.Text = StrReplace(Query.Text, "SourceTableName", TableName);
	Query.Text = StrReplace(Query.Text, "&NamesOfAllOrderingFields", NamesOfAllOrderingFields);
	Query.Text = StrReplace(Query.Text, "WHERE &Group", TextOfDimensionField);
		
	Query.Execute();
		
	Query.Text = "
	|SELECT TOP 1
	|	T.TemporaryNumberingField AS TemporaryNumberingField
	|FROM
	|	TemporaryTableForNumbering AS T
	|
	|ORDER BY
	|	TemporaryNumberingField
	|";
	
	MinimumSequenceNumber = 1;
	
	Selection = Query.Execute().Select();
	If Selection.Next() Then
		MinimumSequenceNumber = Selection.TemporaryNumberingField;
	EndIf;
	
	Query.SetParameter("MinimumSequenceNumber", MinimumSequenceNumber);
	
	Query.Text = "";
	
	If SaveInformationAboutOldNumbering Then
		
		DestroyTemporaryTables(CalculationParameters, NumberingParameters.NameOfOldNumberingTable);
		
		Query.Text = 
		"SELECT
		|	T.TemporaryNumberingField - &MinimumSequenceNumber AS NameOfLineNumberField,
		|	T.NameOfLineNumberField AS OldNumberingField,
		|	CASE WHEN T.TemporaryNumberingField - &MinimumSequenceNumber = T.NameOfLineNumberField
		|		THEN FALSE
		|		ELSE TRUE
		|	END AS NumberingHasChanged
		|INTO NameOfOldNumberingTable
		|FROM
		|	TemporaryTableForNumbering AS T
		|INDEX BY
		|	OldNumberingField
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|";
		
	EndIf;
	
	Query.Text = Query.Text + "
	|DROP SourceTableName
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.TemporaryNumberingField - &MinimumSequenceNumber AS NameOfLineNumberField,
	|	&SummaryColumnNames
	|INTO NameOfNumberedTable
	|FROM
	|	TemporaryTableForNumbering AS T
	|
	|WHERE &Indexing
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TemporaryTableForNumbering
	|";
	
	Query.Text = StrReplace(Query.Text, "SourceTableName", TableName);
	Query.Text = StrReplace(Query.Text, "NameOfOldNumberingTable", NumberingParameters.NameOfOldNumberingTable);
	Query.Text = StrReplace(Query.Text, "NameOfNumberedTable", NameOfNumberedTable);
	Query.Text = StrReplace(Query.Text, "NameOfLineNumberField", NumberingParameters.NameOfLineNumberField);
	Query.Text = StrReplace(Query.Text, "&SummaryColumnNames", SummaryColumnNames);
	Query.Text = StrReplace(Query.Text, "WHERE &Indexing",
		?(Not ValueIsFilled(NumberingParameters.NamesOfIndexingFields), "", "INDEX BY " + Chars.LF + "	" + NumberingParameters.NamesOfIndexingFields));
	
	Query.Execute();
	
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
	
EndProcedure

// Returns the default column name for temporary table portion numbers.
//
Function ColumnNameForDefaultPortionNumber()
	Return "PortionNumber";
EndFunction

// Adds a column for numbers of servings in a table of values.
//
// Returns:
//	ValueTableColumn -
//
Function AddColumnForRowPortionNumbers(Table, NameOfPortionNumberField = "") Export
	
	If Not ValueIsFilled(NameOfPortionNumberField) Then
		NameOfPortionNumberField = ColumnNameForDefaultPortionNumber();
	EndIf;
	
	Return AddNumberColumnToValueTable(Table, NameOfPortionNumberField);
	
EndFunction

// Generates parameters for dividing the temporary table into portions.
//
// Returns:
//	Structure -
//
Function GenerateParametersForSplittingTemporaryTableIntoPortions(PortionSize, NameOfRowWeightField = "",
			NamesOfOrderingFields = "", NameOfPortionNumberField = "", NamesOfIndexingFields = "") Export
	
	SeparationParameters = New Structure;
	SeparationParameters.Insert("PortionSize", 		 	 PortionSize);
	SeparationParameters.Insert("NameOfRowWeightField", 		 NameOfRowWeightField);
	SeparationParameters.Insert("NamesOfOrderingFields", ?(Not ValueIsFilled(NamesOfOrderingFields), ?(NameOfRowWeightField = "", "", NameOfRowWeightField + " " + "DESC"), NamesOfOrderingFields));
	SeparationParameters.Insert("NameOfPortionNumberField", 	 ?(Not ValueIsFilled(NameOfPortionNumberField), ColumnNameForDefaultPortionNumber(), NameOfPortionNumberField));
	SeparationParameters.Insert("NamesOfIndexingFields", ?(Not ValueIsFilled(NamesOfIndexingFields), SeparationParameters.NameOfPortionNumberField, NamesOfIndexingFields));
	
	Return SeparationParameters;
	
EndFunction

// Divides the temporary table into portions.
//
// Returns:
//	Number -
//
Function DivideTemporaryTableIntoPortions(CalculationParameters, SeparationParameters, TableName, Explanation = "") Export
	
	CostCalculationProtocol.StartOfCodeSnippetExecution(
		CalculationParameters,
		TableName,
		NStr("vi = 'Chia bảng tạm thành các phần';
			|ru = 'Деление временной таблицы на порции';
			|en = 'Divide a temporary table into parts'; fa = 'Divide a temporary table into parts';
			|it = 'Divisione della tabella temporanea in porzioni';
			|pl = 'Podział tabeli tymczasowej na porcje';
			|tr = 'Zaman tablosunun bölümlere ayrılması'", Common.DefaultLanguageCode())
			+ ?(Explanation = "", "", " (" + Explanation + ")"));
	
	Query = New Query;
	Query.TempTablesManager = CalculationParameters.TempTablesManager;
	
	// We get an empty table of values with fields corresponding to the fields of the temporary table.
	Query.Text =
	"SELECT TOP 0
	|	T.*
	|FROM
	|	TableName AS T";
	
	Query.Text = StrReplace(Query.Text, "TableName", TableName);
	
	DataTable = Query.Execute().Unload();
	
	// We get a description of the fields of the table.
	TableFieldText = "";
	TableFieldTemplate = "";
		
	For Each DataColumn In DataTable.Columns Do
		TableFieldText = TableFieldText + ?(TableFieldText = "", "", ",
			|	") + "T." + DataColumn.Name;
		TableFieldTemplate = TableFieldTemplate + ?(TableFieldTemplate = "", "", ", ") + "%1" + DataColumn.Name;
	EndDo;
	
	// Let's add a column for the portion number to which the current row of the table belongs.
	ColumnAdded = AddColumnForRowPortionNumbers(DataTable, SeparationParameters.NameOfPortionNumberField);
	
	If ColumnAdded Then
		TableFieldTemplate = TableFieldTemplate + ", %1" + SeparationParameters.NameOfPortionNumberField;
	EndIf;
	
	// Create an empty temporary table in which the processed source table will be placed.
	PutTableOfValuesInTemporaryTable(
		CalculationParameters,
		"TemporaryTableForDividingIntoPortions",
		DataTable,
		TableFieldTemplate);
	
	// Let's put the data of the temporary table in the table of values, while filling in the portion number for each row.
	If ValueIsFilled(SeparationParameters.NamesOfOrderingFields) Then
		Query.Text =
		"SELECT
		|	Parameter1
		|FROM
		|	Parameter2 AS T
		|ORDER BY
		|	Parameter3";
	Else
		Query.Text =
		"SELECT
		|	Parameter1
		|FROM
		|	Parameter2 AS T";
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "Parameter", "%");
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(Query.Text,
		TableFieldText,
		TableName,
		SeparationParameters.NamesOfOrderingFields);
		
	Selection = Query.Execute().Select();
	
	PortionNumber = 1;
	CurPortionSize = 0;
	
	SampleLineNumber = 0;
	SelectionSize = Selection.Count();
	
	While Selection.Next() Do
		
		SampleLineNumber = SampleLineNumber + 1;
		
		CurrentRow = DataTable.Add();
		FillPropertyValues(CurrentRow, Selection);
		
		TheWeightOfARow = ?(ValueIsFilled(SeparationParameters.NameOfRowWeightField), CurrentRow[SeparationParameters.NameOfRowWeightField], 1);
		TheWeightOfARow = ?(TheWeightOfARow < 0, - TheWeightOfARow, TheWeightOfARow);
		
		If CurPortionSize + TheWeightOfARow <= SeparationParameters.PortionSize Then
			// The weight of the current row is "placed" in the current portion.
			// The row is added to the current portion.
		ElsIf CurPortionSize > 0 Then
			// The weight of the current row "goes" beyond the current portion, which already has other rows.
			// The row is added first to the new portion.
			PortionNumber = PortionNumber + 1;
			CurPortionSize = 0;
		Else
			// The weight of the current row is "greater" than the possible portion size, while there are no other rows in the current portion yet.
			// The whole line is placed in a separate portion.
		EndIf;
		
		CurrentRow[SeparationParameters.NameOfPortionNumberField] = PortionNumber;
		
		CurPortionSize = CurPortionSize + TheWeightOfARow;
		
		If SampleLineNumber = SelectionSize
		 Or DataTable.Count() = CalculationParameters.SamplingRestrictions.NumberOfVTZLines Then
		 
			// Move the data from the value table to the temporary table.
			MergeValueTableAndTemporaryTable(
				CalculationParameters, 
				"TemporaryTableForDividingIntoPortions",
				DataTable,
				"", // all columns of the data table
				TableFieldTemplate,
				"");
			
			DataTable.Clear();
			
		EndIf;
		
	EndDo;
	
	// We will destroy the old table and put a new one instead, with the portion number column filled in.
	Query.Text =
	"DROP Parameter1
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|SELECT
	|	T.*
	|INTO Parameter1
	|FROM
	|	TemporaryTableForDividingIntoPortions AS T
	|
	|INDEX BY
	|	Parameter2
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|DROP TemporaryTableForDividingIntoPortions";
	
	Query.Text = StrReplace(Query.Text, "Parameter", "%");
	Query.Text = StringFunctionsClientServer.SubstituteParametersToString(Query.Text,
		TableName,
		SeparationParameters.NamesOfIndexingFields);
	
	Query.Execute();
	
	CostCalculationProtocol.EndOfCodeSnippetExecution(CalculationParameters);
	
	Return ?(SelectionSize = 0, 0, PortionNumber);
	
EndFunction


// Adds a numeric column to the value table.
//
// Parameters:
// 	Table - ValueTable -
// 	ColumnName - String -
// 	InsertAtBeginning - Boolean -
// Returns:
// 	Boolean -
Function AddNumberColumnToValueTable(Table, ColumnName, InsertAtBeginning = True)
	
	If Table.Columns.Find(ColumnName) = Undefined Then
		
		If InsertAtBeginning And Table.Columns.Count() > 0 Then
			Table.Columns.Insert(0, ColumnName, New TypeDescription("Number", New NumberQualifiers(15)));
		Else
			Table.Columns.Add(ColumnName, New TypeDescription("Number", New NumberQualifiers(15)));
		EndIf;
		
		Return True;
		
	EndIf;
	
	Return False;
	
EndFunction

