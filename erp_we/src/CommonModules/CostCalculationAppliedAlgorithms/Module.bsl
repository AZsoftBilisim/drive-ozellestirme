#Region OtherAuxiliaryMethods

// Returns an array of record types used in the chain description.
//
// Returns:
//	Array -
//
Function TypesOfRecordsUsedInChains(DescriptionOfChains, InReceivers = True, InSources = True,
			AddEmptyRecordTypeToResult = True) Export
	
	RecordTypes = New Array;
	
	For Each KeyAndValue In DescriptionOfChains Do
		
		If InReceivers And InSources Then
			TMCommonUseClientServer.AddNewValueToArray(RecordTypes, KeyAndValue.Key);
		ElsIf InReceivers
		 And KeyAndValue.Value.TypesOfReceivers.Count() = 0
		 And KeyAndValue.Value.SourcesTypes.Count() = 0 Then
			TMCommonUseClientServer.AddNewValueToArray(RecordTypes, KeyAndValue.Key);
		EndIf;
		
		If InReceivers Then
			For Each Destinations In KeyAndValue.Value.TypesOfReceivers Do
				TMCommonUseClientServer.AddNewValueToArray(RecordTypes, Destinations.Key);
			EndDo;
		EndIf;
		
		If InSources Then
			For Each Sources In KeyAndValue.Value.SourcesTypes Do
				TMCommonUseClientServer.AddNewValueToArray(RecordTypes, Sources.Key);
			EndDo;
		EndIf;
		
	EndDo;
	
	If AddEmptyRecordTypeToResult Then
		TMCommonUseClientServer.AddNewValueToArray(RecordTypes, Enums.LotRecordTypes.EmptyRef());
	EndIf;
	
	Return RecordTypes;
	
EndFunction

// It is also used when allocating receipts for expenses
//
Procedure InvertMetrics(Record, ListOfIndicators, Invert) Export
	
	If Not Invert Then
		Return;
	EndIf;
	
	For Each Field In New Structure(ListOfIndicators) Do
		Record[Field.Key] = -Record[Field.Key];
	EndDo;
	
EndProcedure

