	|	T.Period						AS Period,
	|
	|	T.Organization					AS Organization,
	|	T.ItemsLocationAttributes	AS ItemsLocationAttributes,
	|	T.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
	|	T.AccountingSection					AS AccountingSection,
	|	T.Lot						AS Lot,
	|	T.LotVendorAttributes			AS LotVendorAttributes,
	|	T.FinancialAccountingDimension		AS FinancialAccountingDimension,
	|	T.VATActivityType			AS VATActivityType,
	|
	|	CAST(0 AS NUMBER (31, 10))	AS Cost,
	|	CAST(0 AS NUMBER (31, 10))	AS CostExcludingVAT,
	|	CAST(0 AS NUMBER (31, 10))	AS OffBalanceCost,
	|	CAST(0 AS NUMBER (31, 10))	AS AdditionalExpenseCost,
	|	CAST(0 AS NUMBER (31, 10))	AS AdditionalExpensesCostExcludingVAT,
	|	CAST(0 AS NUMBER (31, 10))	AS LaborCosts,
	|	CAST(0 AS NUMBER (31, 10))	AS ItemizedFixedCostsIncludingVAT,
	|	CAST(0 AS NUMBER (31, 10))	AS ItemizedFixedCostsExcludingVAT,
	|	CAST(0 AS NUMBER (31, 10))	AS ItemizedVariableCostsIncludingVAT,
	|	CAST(0 AS NUMBER (31, 10))	AS ItemizedVariableCostsExcludingVAT,
	|	CAST(0 AS NUMBER (31, 10))	AS LocalCost,
	|	CAST(0 AS NUMBER (31, 10))	AS OffBalanceCostLocal,
	|	CAST(0 AS NUMBER (31, 10))	AS CostInTaxAccounting,
	|	CAST(0 AS NUMBER (31, 10))	AS PermanentDifference,
	|	CAST(0 AS NUMBER (31, 10))	AS CostTD,
	|	CAST(0 AS NUMBER (31, 10))	AS CostOfPersonalIncomeTax,
	|	CAST(0 AS NUMBER (31, 10))	AS AddExpensesLocal,
	|	CAST(0 AS NUMBER (31, 10))	AS LaborCostsLocal,
	|	CAST(0 AS NUMBER (31, 10))	AS ItemizedFixedCostsCompl,
	|	CAST(0 AS NUMBER (31, 10))	AS ItemizedVariableCostsCompl,
	|	CAST(0 AS NUMBER (31, 10))	AS ProvisionForImpairmentLocal,
	|	CAST(0 AS NUMBER (31, 10))	AS CostMan,
	|	CAST(0 AS NUMBER (31, 10))	AS AddExpensesMan,
	|	CAST(0 AS NUMBER (31, 10))	AS LaborCostsMan,
	|	CAST(0 AS NUMBER (31, 10))	AS ItemizedFixedCostsManag,
	|	CAST(0 AS NUMBER (31, 10))	AS ItemizedVariableCostsManag,
	|	CAST(0 AS NUMBER (31, 10))	AS ProvisionForImpairmentMan
	|INTO TTValueOfBatchesOfGoods
	|FROM
	|	AccumulationRegister.InventoryCost AS T
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 0
	|	CAST(0 AS NUMBER(15,0))		AS NodeNumber,
	|	T.Organization					AS Organization,
	|	T.ItemsLocationAttributes	AS ItemsLocationAttributes,
	|	T.InventoryOwnerAttribute					AS InventoryOwnerAttribute,
	|	T.AccountingSection					AS AccountingSection,
	|	T.Lot						AS Lot,
	|	T.LotVendorAttributes			AS LotVendorAttributes,
	|	T.FinancialAccountingDimension		AS FinancialAccountingDimension,
	|	T.VATActivityType			AS VATActivityType,
	|
	|	T.Count					AS Weight
	|INTO TTCostAdjustmentUnits
	|FROM
	|	AccumulationRegister.InventoryCost AS T
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 0
	|	CAST(0 AS NUMBER(15,0))		AS SourceNodeNumber,
	|	CAST(0 AS NUMBER(15,0))		AS ReceiverNodeNumber,
	|	FALSE							AS DoNotMoveNetInitialCostLOCAL,
	|	T.Count					AS Weight
	|INTO TTCommunicationNodesCostAdjustment
	|FROM
	|	AccumulationRegister.InventoryCost AS T
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	UNDEFINED AS Ref,
	|	&BeginOfPeriod IBDocumentDate
	|
	|INTO TueDatesOfSourceDocuments
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	&BeginOfPeriod AS Period,
	|	UNDEFINED AS Recorder
	|INTO CalculatedDocuments
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 0
	|	UNDEFINED AS Recorder,
	|	VALUE(Catalog.DimensionKeysOfAccountingByPartners.EmptyRef) AS AccountingDimensionByPartners
	|INTO TTAccountingAnalyticsForPartnersFromGiverReports
	|
	|UNION ALL
	|
	|SELECT
	|	T.Recorder,
	|	MAX(T.AccountingDimensionByPartners) AS AccountingDimensionByPartners
	|FROM
	|	AccumulationRegister.InventoryCost AS T
	|WHERE
	|	T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|	AND T.Organization IN(&CompanyArray)
	|	AND T.Recorder REFS Document.ReportToMaterialProvider2_5
	|	AND T.ItemsLocationAttributes <> VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)
	|	AND NOT T.LotCalculation
	|	AND NOT T.CalculationOfCost
	|	AND T.Active
	|GROUP BY
	|	T.Recorder
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	0 AS NodeNumber,
	|	0 AS AmountFA,
	|	0 AS PermanentDifference,
	|	0 AS CostTD
	|INTO TTDecisionTable_TaxAccounting
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 0
	|	UNDEFINED AS NodeNumber,
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	0 AS ItemizedFixedCostsIncludingVAT,
	|	0 AS ItemizedVariableCostsIncludingVAT,
	|	0 AS ItemizedFixedCostsExcludingVAT,
	|	0 AS ItemizedVariableCostsExcludingVAT
	|INTO TtOfCostOfAdditionalExpenses
	|FROM
	|	AccumulationRegister.OtherExpenses AS T
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 0
	|	T.Organization AS Organization,
	|	T.Department AS Department,
	|	T.LineOfBusiness AS LineOfBusiness,
	|	T.ExpenseItem AS ExpenseItem,
	|	T.DimensionOfExpenses AS DimensionOfExpenses,
	|	0 AS ItemizedFixedCostsCompl,
	|	0 AS ItemizedVariableCostsCompl,
	|	0 AS ItemizedFixedCostsManag,
	|	0 AS ItemizedVariableCostsManag,
	|	0 AS PermanentDifference,
	|	0 AS CostTD,
	|	0 AS CostOfPersonalIncomeTax
	|
	|INTO TtOfCostOfAdditionalLocalExpenses
	|FROM
	|	AccumulationRegister.OtherExpenses AS T
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Ref,
	|	CASE WHEN T.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|		THEN 1
	|		ELSE 0
	|	END AS ManSCoefficient,
	|	CASE WHEN T.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|		THEN 1
	|		ELSE 0
	|	END AS LocalCoefficient
	|INTO TTCostItems
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS T
	|WHERE
	|	(T.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToInventoryCost)
	|		OR T.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToInventoryCost))
	|	AND T.SeparateVATAccountingOption <> VALUE(Enum.SeparateVATAccountingOptions.Allocation)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 0
	|	T.Ref,
	|	FALSE AS EnteredInTaxAccounting,
	|	0 AS ManSCoefficient,
	|	0 AS LocalCoefficient
	|INTO TTProductionCostItems
	|FROM
	|	ChartOfCharacteristicTypes.ExpenseItems AS T
	|INDEX BY
	|	Ref
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Ref,
	|	T.ManSCoefficient,
	|	T.LocalCoefficient,
	|	TRUE AS ProductionCosts
	|INTO TTCostItemsForOtherBatches
	|FROM
	|	TTProductionCostItems AS T
	|
	|UNION ALL
	|
	|SELECT
	|	T.Ref,
	|	T.ManSCoefficient,
	|	T.LocalCoefficient,
	|	FALSE AS ProductionCosts
	|FROM
	|	TTCostItems AS T
	|INDEX BY
	|	Ref
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	T.Organization AS Organization,
	|	MAX(T.VATActivityType) AS VATActivityType
	|INTO TTOrganizationsWithOneTypeOfActivityVAT
	|FROM
	|	(SELECT DISTINCT
	|		T.Organization,
	|		T.VATActivityType
	|	 FROM
	|		AccumulationRegister.InventoryCost AS T
	|	WHERE
	|		T.Period BETWEEN &BeginOfPeriod AND &EndOfPeriod
	|		AND T.Organization IN(&CompanyArray)
	|		AND T.VATActivityType <> VALUE(Enum.VATTaxationTypes.EmptyRef)
	|		AND T.Active
	|
	|	UNION
	|
	|	SELECT DISTINCT
	|		T.Organization,
	|		T.VATActivityType
	|	 FROM
	|		AccumulationRegister.InventoryCost.Balance(&BorderEndOfPreviousPeriod,
	|			Organization IN (&CompanyArray) AND VATActivityType <> VALUE(Enum.VATTaxationTypes.EmptyRef)) AS T
	|   ) AS T
	|GROUP BY
	|	T.Organization
	|HAVING
	|	COUNT(DISTINCT T.VATActivityType) = 1
	|INDEX BY
	|	Organization
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT TOP 0
	|	Cost_.Organization,
	|	Cost_.ItemsLocationAttributes,
	|	Cost_.AccountingSection,
	|	Cost_.InventoryOwnerAttribute,
	|	Cost_.Lot,
	|	Cost_.LotVendorAttributes,
	|	Cost_.FinancialAccountingDimension,
	|	Cost_.VATActivityType,
	|	0 AS LocalCost,
	|	0 AS CostMan
	|INTO ValueOfVAT
	|FROM
	|	AccumulationRegister.InventoryCost AS Cost_
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	0 AS NodeNumber,
	|	0 AS LocalCost,
	|	0 AS CostMan
	|
	|INTO AdjustmentNodesInclusionExclusionOfVAT
	|;
	|////////////////////////////////////////////////////////////////////////////////
	// The Goods receiver table is used in the function of the text Sum of all expenses()
	// of the general module for calculating the cost of cost correction with batch accounting turned off or
	// with batch accounting 2.1.
	|SELECT
	|	UNDEFINED AS Recorder,
	|	FALSE AS ThisIsPartyOfPastPeriod
	|
	|INTO ProductReceivers
	|;
	|
	// The production batch table is used in the function of the indicator of the base of the distribution of the receivers of the past periods()
	// of the general module of calculation of the cost and cost of the monthly expenses when performing the preliminary closing of the month.
	|SELECT
	|	VALUE(Catalog.ProductionLots.EmptyRef)       AS ProductionLot,
	|	UNDEFINED                                               AS DocumentLots,
	|	0                                                          AS CostGroupNumber,
	|	VALUE(Catalog.LinesOfBusiness.EmptyRef)  AS LineOfBusiness,
	|	UNDEFINED                                               AS FinancialAccountingDimension,
	|	VALUE(Catalog.Companies.EmptyRef)              AS Organization,
	|	VALUE(Catalog.Products.EmptyRef)             AS Products,
	|	VALUE(Catalog.Assignments.EmptyRef)               AS Purpose,
	|	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATActivityType,
	|	FALSE                                                       AS CostAllocationForIssue,
	|	FALSE                                                       AS LongTermProduction
	|
	|INTO ProductionBatchesAreSummarized
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	0 AS NodeNumber,
	|	VALUE(Enum.SectionsOfInventoryCostAccounting.EmptyRef) AS AccountingSection,
	|	VALUE(Catalog.Companies.EmptyRef) AS Organization
	|
	|INTO TTNodesAdjustmentsItemByItemUnfinishedProductionCosts
	|";
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTAccountingAnalyticsForPartnersFromGiverReports");
	
	Query.Text = CostCalculationFillingInformationAboutLots.TextDescriptionOfDataForBatchesOfGoods();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "TTInvoicingOfDeliveries");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTInvoicingOfDeliveries");
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForOtherUnfinishedProductionExpenses();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "TTOtherWorkInProgressExpenses__");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTOtherWorkInProgressExpenses__");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForBalancesOfDistributionBases();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "RemnantsOfDistributionBases");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "RemnantsOfDistributionBases");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForReductionFactors();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "ReductionCoefficients");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "ReductionCoefficients");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForDistributionOfProductionCostShares();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "SharesOfProductionCosts");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "SharesOfProductionCosts");
	
	Query.Text = CostCalculationFillingInformationAboutLots.TextDescriptionOfDataForBatchesOfGoods();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "TTProductionCostsCostOfGoods");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTProductionCostsCostOfGoods");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForExpenseAllocationParties();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "LotsForAttributingExpenses");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "LotsForAttributingExpenses");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForAllocationOfDirectProductionCosts();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "DirectProductionCosts");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "DirectProductionCosts");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForHIA();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "TTOvz");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTOvz");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForInitialTransitDataOfExpendituresBetweenHIA();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "TTInitialDataOfTransitNodesOfExpendituresBetweenHIA");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTInitialDataOfTransitNodesOfExpendituresBetweenHIA");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForTransitCostsBetweenHIA();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "TTTransitOfExpensesBetweenHIA");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTTransitOfExpensesBetweenHIA");
	
	Query.Text = CostCalculationItemizedCosts.TextDescriptionOfDataForCalculationOfSharesOfDistributionOfOtherCosts();
	Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "TTShareOfDistributionOfOtherCosts");
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "TTShareOfDistributionOfOtherCosts");
	If CalculationParameters.MonthEndClosingMode = Enums.MonthEndClosingModes.PreliminaryClosing
	 And Not CalculationParameters.DistributionOfAdditionalCostsBetweenPartiesAndGoods Then
		Query.Text = CostCalculationLESSolution.TextDescriptionOfDataForAdditionalCostAdjustmentNodes();
		Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "AdditionalCostAdjustmentNodes");
		ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "AdditionalCostAdjustmentNodes");
		
		Query.Text = CostCalculationLESSolution.TextDescriptionOfDataForConnectionsOfNodesOfProductionCostsOfPreviousPeriods();
		Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "ConnectionsOfNodesOfProductionExpensesOfPreviousPeriods");
		ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "ConnectionsOfNodesOfProductionExpensesOfPreviousPeriods");
		
		Query.Text = CostCalculationLESSolution.TextDescriptionOfDataForLinksOfAdditionalCostNodes();
		Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "ConnectionsOfNodesOfAdditionalExpenses");
		ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "ConnectionsOfNodesOfAdditionalExpenses");
		
		Query.Text = CostCalculationLESSolution.TextDescriptionOfDataForCostOfAdditionalExpenses();
		Query.Text = ChangeDataDescriptionRequestReceiver(Query.Text, "CostOfAdditionalExpenses");
		ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query, True, "CostOfAdditionalExpenses");
	EndIf;
	
	// Let's create a temporary table of accounting policies of organizations.
	DestroyTemporaryTables(CalculationParameters, "TTAccountingPoliciesOfOrganizations, TTAccountingPoliciesOfPreviousPeriod, TTAccountingPoliciesOfFinancialAccounting");
	
	AccountingPoliciesTaxSettings.SupplementTemporaryTableManagerWithCurrentParametersForAccountingPolicies(
		Metadata.InformationRegisters.TaxationSystemSettings.Name,
		CalculationParameters.TempTablesManager,
		CalculationParameters.PayrollPeriod.BeginOfPeriod,
		"TTAccountingPoliciesOfOrganizations",
		CalculationParameters.CompanyArray);
		
	AccountingPoliciesTaxSettings.SupplementTemporaryTableManagerWithCurrentParametersForAccountingPolicies(
		Metadata.InformationRegisters.TaxationSystemSettings.Name,
		CalculationParameters.TempTablesManager,
		CalculationParameters.PayrollPeriod.BeginningOfPreviousPeriod,
		"TTAccountingPoliciesOfPreviousPeriod",
		CalculationParameters.CompanyArray);
	
	
	AddTTMethodsForEstimatingValueOfOrganizationsByPeriod(CalculationParameters);
	
	// In the accounting policy of financial accounting, we will redefine the accounting of products at the planned cost.
	// Full-fledged accounting of finished products at the planned cost is maintained when deviations are written-off for cost of goods sold,
	// except for the "Medium-sliding" valuation method. With an average sliding cost, products are always recorded at the planned cost.
	
	AccountingPoliciesTaxSettings.AddParentOrganizationsToTemporaryTableManager(
		CalculationParameters.TempTablesManager,
		CalculationParameters.CompanyArray);
	
	QueryText = InformationRegisters.FinancialAccountingPolicy.QueryTextCurrentTaxAccountingPolicySettings();
	
	QuerySchema = New QuerySchema;
	QuerySchema.SetQueryText(QueryText);
	QuerySchema.QueryBatch[0].PlacementTable = "TTAccountingPoliciesOfFinancialAccountingPreliminary";
	QuerySchema.QueryBatch[0].Index.Add("Organization");
	NewPackage = QuerySchema.QueryBatch.Add(Type("QuerySchemaTableDropQuery"));
	NewPackage.TableName = "TTParentOrganizations";
	QueryText = QuerySchema.GetQueryText();
	
	QueriesArray = New Array;
	QueriesArray.Add(QueryText);
	
	QueryText = "
	|SELECT
	|	&Fields
	|INTO TTAccountingPoliciesOfFinancialAccounting
	|FROM
	|	TTAccountingPoliciesOfFinancialAccountingPreliminary AS T
	|";
	
	FieldText = "";
	For Each CurrentColumn In QuerySchema.QueryBatch[0].Columns Do
		
		FieldName = CurrentColumn.Alias;
		If FieldName = "ProductCostingByPlannedCost" Then
			FieldText = FieldText + ?(FieldText = "", "", "," + Chars.LF + "	")
				+ "
				|	(CASE
				|		WHEN ISNULL(T.ProductCostingByPlannedCost, FALSE)
				|		 AND ISNULL(T.WriteOffProductCostVariancesToCostOfGoodsSold, FALSE)
				|		 OR (ISNULL(T.InventoryValuationMethod, UNDEFINED)
				|				= VALUE(Enum.InventoryValuationMethods.MovingAverage))
				|			THEN TRUE
				|		ELSE FALSE END) AS ProductCostingByPlannedCost
				|"
		Else
			FieldText = FieldText + ?(FieldText = "", "", "," + Chars.LF + "	") + "T." + FieldName + " AS " + FieldName;
		EndIf;
		
	EndDo;
	
	QueryText = StrReplace(QueryText, "&Fields", FieldText);
	QueriesArray.Add(QueryText);
	Query.Text = StrConcat(QueriesArray, Common.QueryBatchSeparator());
	Query.SetParameter("Period", CalculationParameters.PayrollPeriod.BeginOfPeriod);
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	// Let's create a temporary table of exchange rates of organizations.
	Query.Text = 
	"SELECT
	|	Companies.Ref AS Organization,
	|	Companies.LocalAccountingCurrency AS LocalAccountingCurrency,
	|	CASE
	|		WHEN CurrencyExchangeRate.Currency IS NULL
	|				OR CurrencyExchangeRate.CourseDenominator = 0
	|				OR CurrencyConversionRate_2.CourseNumerator = 0
	|			THEN 1
	|		ELSE CurrencyExchangeRate.CourseNumerator * CurrencyConversionRate_2.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * CurrencyConversionRate_2.CourseNumerator)
	|	END AS LocalCurrencyRatio, // when multiplied by the amount of regl , it allows you to get the amount of upr
	|	CASE
	|		WHEN CurrencyExchangeRate.Currency IS NULL
	|				OR CurrencyExchangeRate.CourseNumerator = 0
	|				OR CurrencyConversionRate_2.CourseDenominator = 0
	|			THEN 1
	|		ELSE CurrencyExchangeRate.CourseDenominator * CurrencyConversionRate_2.CourseNumerator / (CurrencyExchangeRate.CourseNumerator * CurrencyConversionRate_2.CourseDenominator)
	|	END AS ManSCurrencyRatio // when multiplied by the amount of upr , it allows you to get the amount of regl
	|INTO TTExchangeRatesOfOrganizations
	|FROM
	|	Catalog.Companies AS Companies
	|		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&EndOfPeriod, ) AS CurrencyExchangeRate
	|			INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&EndOfPeriod, Currency = &ManagementAccountingCurrency) AS CurrencyConversionRate_2
	|			ON CurrencyExchangeRate.BaseCurrency = CurrencyConversionRate_2.BaseCurrency
	|		ON Companies.LocalAccountingCurrency = CurrencyExchangeRate.Currency
	|WHERE
	|	Companies.Ref IN(&CompanyArray)
	|INDEX BY
	|	Organization";
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	// Let's create a temporary VAT accounting settings table with a selection by organization on the main.
	QueriesArray = New Array;
	
	// Let's replace the table of VTGOL organizations by organizations on the main
	QueryText = "SELECT
	|	CatCompanies.ParentCompany AS Organization,
	|	CatCompanies.Ref AS BranchOffice
	|INTO TTParentOrganizations
	|FROM
	|	Catalog.Companies AS CatCompanies
	|	INNER JOIN TTAccountingPoliciesOfOrganizations AS OrganizationsOnOSN
	|	ON CatCompanies.Ref = OrganizationsOnOSN.Organization
	|		AND OrganizationsOnOSN.TaxationSystem = VALUE(Enum.TaxationSystems.Shared3)
	|INDEX BY
	|	Organization";
	QueriesArray.Add(QueryText);

	QueryText = InformationRegisters.VATAccountingSettings.QueryTextCurrentTaxAccountingPolicySettings();
	
	QuerySchema = New QuerySchema;
	QuerySchema.SetQueryText(QueryText);
	QuerySchema.QueryBatch[0].PlacementTable = "TTVATAccountingSettingsPreliminary";
	QuerySchema.QueryBatch[0].Index.Add("Organization");
	QueryText = QuerySchema.GetQueryText();
	QueriesArray.Add(QueryText);
	
	QueryText =
	"SELECT
	|	&Fields
	|INTO TTVATAccountingSettings
	|FROM
	|	TTVATAccountingSettingsPreliminary AS T
	|	LEFT JOIN TTAccountingPoliciesOfFinancialAccounting AS AccountingPolicy
	|		ON T.Organization = AccountingPolicy.Organization
	|";
	
	FieldText = "";
	FIFOFields = New Structure("VATAccountingForLongProductionCycle");
	
	For Each CurrentColumn In QuerySchema.QueryBatch[0].Columns Do
		
		FieldName = CurrentColumn.Alias;
		
		If FIFOFields.Property(FieldName) Then
			FieldText = FieldText + ?(FieldText = "", "", "," + Chars.LF + "	")
				+ "CASE WHEN AccountingPolicy.InventoryValuationMethod = VALUE(Enum.InventoryValuationMethods.FIFORollingValuation)
				|		THEN T." + FieldName + "
				|		ELSE FALSE
				|	END AS " + FieldName;
		Else
			FieldText = FieldText + ?(FieldText = "", "", "," + Chars.LF + "	") + "T." + FieldName + " AS " + FieldName;
		EndIf;
		
	EndDo;
	
	QueryText = StrReplace(QueryText, "&Fields", FieldText);
	QueryText = QueryText + "
	|INDEX BY
	|	Organization";
	
	QueriesArray.Add(QueryText);
	
	Query.SetParameter("Period", CalculationParameters.PayrollPeriod.BeginOfPeriod);
	Query.Text = StrConcat(QueriesArray, Common.QueryBatchSeparator());
	
	ExecuteRequestWithMeasurementForProtocol(CalculationParameters, Query);
	
	DestroyTemporaryTables(CalculationParameters, "TTVATAccountingSettingsPreliminary, TTParentOrganizations");
	
	// Create a temporary table of interconnected organizations.
	Catalogs.Companies.GetRelatedCompanies(CalculationParameters.TempTablesManager);
	
EndProcedure

// Creates an auxiliary temporary table.
//
Procedure InitializeAuxiliaryTemporaryTable(CalculationParameters, TempTableName, RegisterName = "", QueryText = "")
	
	Query = New Query;
	InitializeRequestProperties(Query, CalculationParameters);
	
	If ValueIsFilled(RegisterName) Then
		
		RegisterDescription = CalculationParameters.RegisterRecords[RegisterName];
		
		Query.Text = 
		"SELECT TOP 0
		|	VALUE(AccumulationRecordType.Receipt) AS RecordType,
		|	*
		|INTO TempTableName
		|FROM
		|	CacheTableName AS T";
		
		Query.Text = StrReplace(Query.Text, "CacheTableName", RegisterDescription.RegisterCacheTableName);
		
	Else
		
		Query.Text = QueryText + "
		|;
		|SELECT TOP 0
		|	*
		|FROM
		|	TempTableName AS T";
		
	EndIf;
	
	Query.Text = StrReplace(Query.Text, "TempTableName", TempTableName);
		
	QueryResult = Query.Execute();
	
	TableDetails = New Structure;
	TableDetails.Insert("ThisIsRegisterDescription", 		False);
	TableDetails.Insert("ThisIsDescriptionOfTemporaryTable", True);
	TableDetails.Insert("TempTableName", 		TempTableName);
	
	If ValueIsFilled(RegisterName) Then
		
		TableDetails.Insert("Table", 				RegisterDescription.Table.CopyColumns()); // ValueTable
		TableDetails.Insert("TableFields",				RegisterDescription.RegisterCacheFields);
		TableDetails.Insert("SummableFields",			RegisterDescription.SelectionFieldsOfNonemptyMotions);
		TableDetails.Insert("ThereIsPropertyTypeOfMovement", RegisterDescription.ThereIsPropertyTypeOfMovement);
		
	Else
		
		TableDetails.Insert("Table", QueryResult.Unload());
		
		CostCalculationProtocol.IncreaseAmountOfProcessedDataForMeasurement(
			CalculationParameters,
			TableDetails.Table.Count());
		
		TableFields = "";
		SummableFields = "";
		
		For Each Column In TableDetails.Table.Columns Do
			
			TableFields = TableFields + ?(TableFields = "", "", ", ") + "%1" + Column.Name;
			
			If ThisIsSummableColumnOfTable(Column) Then
				SummableFields = SummableFields + ?(SummableFields = "", "", ", ") + "%1" + Column.Name;
			EndIf;
			
		EndDo;
		
		TableDetails.Insert("TableFields",				TableFields);
		TableDetails.Insert("SummableFields",			SummableFields);
		TableDetails.Insert("ThereIsPropertyTypeOfMovement",
			TableDetails.Table.Columns.Find("OfficialTypeOfMovementParish") <> Undefined);
		
	EndIf;
	
	TableDetails.Insert("NumberOfDataChunks", 0);  // when calculating the stage, each portion of the generated data is first added into separate W, and at the end of the stage all of them are combined
	TableDetails.Insert("PortionTableNames",  	   ""); // names of all VT portions of the form <Table name>_<The number of portions from 1 to the number of portions given>
	
	CalculationParameters.AuxiliaryTemporaryTables.Insert(TempTableName, TableDetails);
	
EndProcedure


// Forms The Right To Fill In The Record Field.
//
Procedure CreateTableOfRulesForFillingInRecordTypeField(TempTablesManager, RulesForFillingInRecordTypeField) Export
	
	DestroyTemporaryTables(TempTablesManager, "TTRulesForFillingInRecordTypeField");
	
	Query = New Query;
	Query.TempTablesManager = TempTablesManager;
	
	Query.SetParameter("RulesForFillingInRecordTypeField", RulesForFillingInRecordTypeField);
	
	Query.Text = 
	"SELECT
	|	T.EmptyLoggerValue AS EmptyLoggerValue,
	|	T.BusinessOperation 	 AS BusinessOperation,
	|	T.PositiveQuantity    AS PositiveQuantity,
	|	T.EntryTypeReceipt 			 AS EntryTypeReceipt,
	|	T.EntryTypeExpense 			 AS EntryTypeExpense,
	|	T.DocumentSourceInParish 	 AS DocumentSourceInParish,
	|	T.DocumentSourceInExpense 	 AS DocumentSourceInExpense,
	|	T.CorPartyAtExpense 		 AS CorPartyAtExpense
	|INTO TTRulesForFillingInRecordTypeField
	|FROM
	|	&RulesForFillingInRecordTypeField AS T";
	
	Query.Execute();
	
EndProcedure


// Actions performed at the end of the calculation.
//
Function CalculationEnd(CalculationParameters)
	
	If CostCalculationProtocol.CalculationProtocolIsMaintained(CalculationParameters) Then
		CostCalculationProtocol.CalculationEnd(CalculationParameters);
	EndIf;
	
	If CalculationParameters.Property("TempTablesManager") Then
		CalculationParameters.TempTablesManager.Close();
	EndIf;
	
	CalculationParameters = Undefined;
	
	Return True;
	
EndFunction


// Returns a list of documents that may have movements in different months or for several organizations.
//
// Parameters:
//	DifferentPeriods_ - Boolean - add documents with movements in different periods to the result
//	DifferentOrganizations - Boolean - add documents with movements for several organizations to the result
//	RegisterName - String - name of the accumulation register to get a list of documents for;
//		empty value - list of documents for all registers.
//
// Returns:
//	Map - The key is the Metadata object.
//
Function DocumentsWithDifferentPeriodsOrOrganizationsInRegisteredRecords(DifferentPeriods_, DifferentOrganizations, RegisterName = "") Export
	
	DescriptionOfDocuments = New Map;
	
	// For movements in other periods, the value = True means
	// - the presence of primary +calculated movements,
	// - calculated movements are formed when calculating their period.
	// If the value is False, it means that
	// - calculation movements can be without primary movements,
	// - calculation movements of any periods are formed when calculating the period of the document.
	// For movements of other organizations, only the Truth should matter.
	
	Value = True;
	
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.InventoryCost.Name
	 Or RegisterName = Metadata.AccumulationRegisters.GoodsCostVariances.Name Then
		
		If DifferentPeriods_ Then
			DescriptionOfDocuments.Insert(Metadata.Documents.CustomerInvoice,     				Value); // operation of realizationreferencesexternal links
			DescriptionOfDocuments.Insert(Metadata.Documents.ReversingEntry, Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.ProductionStage2_2, 		 				Value); // with long-term production, movements in materials and products are formed in different periods
			DescriptionOfDocuments.Insert(Metadata.Documents.ExpenseReport, 							Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.OBEntry, 								Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.OBEntryGoods,						Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.PurchaseAdjustment, 				Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.SaleAdjustment, 					Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.VendorInvoice, 					Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.VendorInvoiceServicesAndAssets, 			Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.OtherIncomeExpenses, 						Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.DeferredExpensesAllocation, 		Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.CashVoucher, 					Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.BankAccountIssue, 		Value); // Additional expenses
			DescriptionOfDocuments.Insert(Metadata.Documents.CCDImport, 				Value); // Additional expenses
		EndIf;
		
		If DifferentOrganizations Then
			DescriptionOfDocuments.Insert(Metadata.Documents.IntercompanyGoodsReturn, 				Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.CommissionReportIntercompany, 			Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.CommissionWriteOffReportIntercompany,	Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.CustomerInvoiceIntercompany, 			Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.InventoryTransfer, 							Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.ReversingEntry,										Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.BackflushProduction,							Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.ProductionStage2_2,							Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.ConsumptionReportSubcontractingServicesDeliveredIntercompany,				Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.MovementOfProductsAndMaterials,					Value);
		EndIf;
		
	EndIf;
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.CompanyGoods.Name Then
		
		If DifferentPeriods_ Then
			DescriptionOfDocuments.Insert(Metadata.Documents.ProductionStage2_2, Value); // with long-term production, movements in materials and products are formed in different periods
		EndIf;
		
	EndIf;
	
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.WIPLaborCosts.Name Then
		
		If DifferentPeriods_ Then
			DescriptionOfDocuments.Insert(Metadata.Documents.ProductionStage2_2, Value); // with long-term production, labor movements are formed in different periods
		EndIf;
		
	EndIf;
	
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.OtherWorkInProgressExpenses.Name Then
		
		If DifferentPeriods_ Then
			DescriptionOfDocuments.Insert(Metadata.Documents.ProductionStage2_2, Value); // with long-term production, movements on other expenses of the WIP are formed in different periods
		EndIf;
		
	EndIf;
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.ItemisedExpensesLots.Name Then
		
		If DifferentPeriods_ Then
			For Each MetaDocument In Metadata.Documents Do
				If MetaDocument.RegisterRecords.Contains(Metadata.AccumulationRegisters.ItemisedExpensesLots) Then
					If MetaDocument = Metadata.Documents.DeferredExpensesAllocation Then
						DescriptionOfDocuments.Insert(MetaDocument, Not Value);
					Else
						DescriptionOfDocuments.Insert(MetaDocument, Value);
					EndIf;
				EndIf;
			EndDo;
		EndIf;
		
	EndIf;
	
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.OtherAssetsLiabilities.Name Then
		
		If DifferentPeriods_ Then
			
			For Each MetaDocument In Metadata.Documents Do
				If MetaDocument.RegisterRecords.Contains(Metadata.AccumulationRegisters.OtherAssetsLiabilities) Then
					DescriptionOfDocuments.Insert(MetaDocument, Value);
				EndIf;
			EndDo;
			
		EndIf;
		
		If DifferentOrganizations Then
			DescriptionOfDocuments.Insert(Metadata.Documents.CommissionReportIntercompany, Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.ReversingEntry, Value);
		EndIf;
		
	EndIf;
	
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.OtherExpenses.Name Then
		
		If DifferentPeriods_ Then
			For Each MetaDocument In Metadata.Documents Do
				If MetaDocument.RegisterRecords.Contains(Metadata.AccumulationRegisters.OtherExpenses) Then
					If MetaDocument = Metadata.Documents.DeferredExpensesAllocation Then
						DescriptionOfDocuments.Insert(MetaDocument, Not Value);
					Else
						DescriptionOfDocuments.Insert(MetaDocument, Value);
					EndIf;
				EndIf;
			EndDo;
		EndIf;
		
	EndIf;
	
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.RevenueAndCOGS.Name Then
		
		If DifferentPeriods_ Then
			For Each MetaDocument In Metadata.Documents Do
				If MetaDocument.RegisterRecords.Contains(Metadata.AccumulationRegisters.RevenueAndCOGS) Then
					If MetaDocument = Metadata.Documents.DeferredExpensesAllocation Then
						DescriptionOfDocuments.Insert(MetaDocument, Not Value);
					Else
						DescriptionOfDocuments.Insert(MetaDocument, Value);
					EndIf;
				EndIf;
			EndDo;
		EndIf;
		
	EndIf;
	
	If RegisterName = ""
	 Or RegisterName = Metadata.AccumulationRegisters.RecordsProductsProducts.Name Then
		
		If DifferentPeriods_ Then
			DescriptionOfDocuments.Insert(Metadata.Documents.CustomerInvoice, Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.ReversingEntry, Value);
			DescriptionOfDocuments.Insert(Metadata.Documents.ProductionStage2_2, Value);
		EndIf;
		
	EndIf;
	
	CalculationOfCostLocalization.SupplementDocumentsWithDifferentPeriodsOrOrganizationsInRegisteredRecords(DifferentPeriods_, DifferentOrganizations, RegisterName, DescriptionOfDocuments);
	
	// This type of documents should not be processed by settlement mechanisms
	DescriptionOfDocuments.Delete(Metadata.Documents.RegisterAdjustment);
	
	Return DescriptionOfDocuments;
	
EndFunction

