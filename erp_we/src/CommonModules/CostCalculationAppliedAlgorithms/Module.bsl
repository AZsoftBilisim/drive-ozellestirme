Procedure FillInSettlementBatch(CalculationParameters, Context, SettlementBatch, Expense, Receipt) Export
	
	BatchIsFull = False;
	CostCalculationFillingInformationAboutLots.FillInSettlementBatch(CalculationParameters, Context, SettlementBatch, Expense, Receipt, BatchIsFull);
	CostCalculationItemizedCosts.FillInSettlementBatch(CalculationParameters, Context, SettlementBatch, Expense, Receipt, BatchIsFull);
	CostCalculationMaterialCosts.FillInSettlementBatch(CalculationParameters, Context, SettlementBatch, Expense, Receipt, BatchIsFull);
	CostCalculationLaborCosts.FillInSettlementBatch(CalculationParameters, Context, SettlementBatch, Expense, Receipt, BatchIsFull);
	VATCostCalculation.FillInSettlementBatch(CalculationParameters, Context, SettlementBatch, Expense, Receipt, BatchIsFull);
	CalculationOfCostLocalization.FillInSettlementBatch(CalculationParameters, Context, SettlementBatch, Expense, Receipt, BatchIsFull);
		
	If Not BatchIsFull Then
		
		ProtocolText_ = StringFunctionsClientServer.SubstituteParametersToString(
			NStr("vi = 'Đối với ngữ cảnh %1, không xem xét việc điền trường lô';
				|ru = 'Для контекста %1 не предусмотрено заполнение полей расчетной партии';
				|en = 'Population of estimated lot fields is not available for the %1 context'; fa = 'Population of estimated lot fields is not available for the %1 context';
