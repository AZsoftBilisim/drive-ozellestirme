	<template>
		<name>Template1</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="dcscor:Parameter">MeasurementPeriod</dcsat:value>
					</dcsat:item>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>MeasurementPeriod</dcsat:name>
			<dcsat:expression>Case
    When &amp;MeasurementsPeriodicity=1 Then Format(MeasurementPeriod, "DF='dd.MM.yyyy""g. "" HH:mm'")+ "-" + Format(DateAdd(MeasurementPeriod,"Minute",59), "DF='HH:mm'")
    When &amp;MeasurementsPeriodicity=2 Then Format(MeasurementPeriod, "DF='dd.MM.yyyy'") + "G."
    When &amp;MeasurementsPeriodicity=3 Then
        Case
            When BeginOfPeriod(MeasurementPeriod, "Week") &lt; &amp;BeginOfPeriod Then Format(&amp;BeginOfPeriod, "DF='dd.MM.yyyy""G.""'") + " - " + Format(EndOfPeriod(MeasurementPeriod,"Week"), "DF='dd.MM.yyyy""G. "" '")
            When EndOfPeriod(MeasurementPeriod, "Week") &gt; &amp;EndOfPeriod Then Format(BeginOfPeriod(MeasurementPeriod, "Week"), "DF='dd.MM.yyyy""G.""'")+ " - " + Format(&amp;EndOfPeriod, "DF='dd.MM.yyyy""G. "" '")
            Else Format(BeginOfPeriod(MeasurementPeriod, "Week"), "DF='dd.MM.yyyy""G.""'")+ " - " + Format(EndOfPeriod(MeasurementPeriod,"Week"), "DF='dd.MM.yyyy""G. "" '")
        End
    When &amp;MeasurementsPeriodicity=4 Then Format(&amp;BeginOfPeriod, "DF='dd.MM.yyyy'") + " - " + Format(&amp;EndOfPeriod, "DF='dd.MM.yyyy'")
End</dcsat:expression>
		</parameter>
	</template>
	<template>
		<name>Template2</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="dcscor:Parameter">APDEX</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>HorizontalAlign</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:HorizontalAlign">Right</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>APDEX</dcsat:name>
			<dcsat:expression>Case
    When
        APDEXPrevious IS NULL
    Then
        Format(APDEX, "NFD=3; NZ=0,000")
    Else
        Case
            When
                APDEX - APDEXPrevious &gt; 0
            Then
                Format(APDEX, "NFD=3; NZ=0,000") + "(+" + Format(APDEX - APDEXPrevious,"NFD=3; NZ=0,000") + ")"
            When
                APDEX - APDEXPrevious &lt; 0
            Then
                Format(APDEX, "NFD=3; NZ=0,000") + "(-" + Format(APDEXPrevious - APDEX,"NFD=3; NZ=0,000") + ")"
            Else
                Format(APDEX, "NFD=3; NZ=0,000")
        End
End</dcsat:expression>
		</parameter>
	</template>
	<template>
		<name>Template3</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="dcscor:Parameter">AverageMeasurementValue</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>HorizontalAlign</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:HorizontalAlign">Right</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>AverageMeasurementValue</dcsat:name>
			<dcsat:expression>Case
    When
        AverageMeasurementValue IS NULL
    Then
        Format(AverageMeasurementValue, "NFD=3; NZ=0,000")
    Else
        Case
            When
                AverageMeasurementValue - AverageMeasurementValuePrevious &gt; 0
            Then
                Format(AverageMeasurementValue, "NFD=3; NZ=0,000") + "(+" + Format(AverageMeasurementValue - AverageMeasurementValuePrevious,"NFD=3; NZ=0,000") + ")"
            When
                AverageMeasurementValue - AverageMeasurementValuePrevious &lt; 0
            Then
                Format(AverageMeasurementValue, "NFD=3; NZ=0,000") + "(-" + Format(AverageMeasurementValuePrevious - AverageMeasurementValue, "NFD=3; NZ=0,000") + ")"
            Else
                Format(AverageMeasurementValue, "NFD=3; NZ=0,000")
        End
End</dcsat:expression>
		</parameter>
	</template>
	<fieldTemplate>
		<field>MeasurementPeriod</field>
		<template>Template1</template>
	</fieldTemplate>
