	</totalField>
	<totalField>
		<dataPath>APDEXDelta</dataPath>
		<expression>APDEXDelta</expression>
	</totalField>
	<totalField>
		<dataPath>AverageMeasurementValuePrevious</dataPath>
		<expression>AverageMeasurementValuePrevious</expression>
	</totalField>
	<totalField>
		<dataPath>AverageMeasurementValueDelta</dataPath>
		<expression>AverageMeasurementValueDelta</expression>
	</totalField>
