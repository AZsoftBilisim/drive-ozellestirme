	<totalField>
		<dataPath>CanceledOrderLines</dataPath>
		<expression>Sum(CanceledOrderLines)</expression>
	</totalField>
	<totalField>
		<dataPath>CanceledOrders</dataPath>
		<expression>Count(Distinct SalesOrder)</expression>
	</totalField>
	<totalField>
		<dataPath>CanceledOrders.Share</dataPath>
		<expression>Cast(Case When EvalExpression("Count(Distinct SalesOrder)", "Overall") = 0 Then 0 Else 100* Count(Distinct SalesOrder) / EvalExpression("Count(Distinct SalesOrder)", "Overall") End, "Number(15,2)")</expression>
	</totalField>
	<totalField>
		<dataPath>CanceledOrderLines.Share</dataPath>
		<expression>Cast(Case When EvalExpression("Sum(CanceledOrderLines)", "Overall") = 0 Then 0 Else 100* Sum(CanceledOrderLines) / EvalExpression("Sum(CanceledOrderLines)", "Overall") End, "Number(15,2)")</expression>
	</totalField>
