		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	COUNT(1) AS CanceledOrderLines,
	ShipmentReferences.CancellationReason,
	ShipmentReferences.Products.PriceGroup AS PriceGroup,
	ShipmentReferences.Products,
	ShipmentReferences.ReferenceOrder.Manager AS Manager,
	ShipmentReferences.ReferenceOrder.Partner AS Partner,
	ShipmentReferences.Characteristic,
	ShipmentReferences.ReferenceOrder AS SalesOrder
FROM
	AccumulationRegister.ShipmentAndReturnReferences AS ShipmentReferences
WHERE
	ShipmentReferences.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Canceled)
	AND ShipmentReferences.Count &lt;&gt; 0
	AND ShipmentReferences.Active
{WHERE
	((ShipmentReferences.Products, ShipmentReferences.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(ShipmentReferences.ReferenceOrder.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	(ShipmentReferences.Period &gt;= &amp;PeriodBeginning),
	(ShipmentReferences.Period &lt; &amp;PeriodEnd_),
	ShipmentReferences.CancellationReason.*,
	ShipmentReferences.Products.PriceGroup.* AS PriceGroup,
	ShipmentReferences.Products.*,
	ShipmentReferences.ReferenceOrder.Manager.* AS Manager,
	ShipmentReferences.ReferenceOrder.Partner.* AS Partner}
GROUP BY
	ShipmentReferences.CancellationReason,
	ShipmentReferences.Products.PriceGroup,
	ShipmentReferences.Products,
	ShipmentReferences.ReferenceOrder.Manager,
	ShipmentReferences.ReferenceOrder.Partner,
	ShipmentReferences.Characteristic,
	ShipmentReferences.ReferenceOrder</query>
	</dataSet>
