			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsForRegistration.InventoryOwnerAttribute.Organization AS Organization,
	GoodsForRegistration.Currency,
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Characteristic,
	GoodsForRegistration.InventoryOwnerAttribute.GoodsOwner AS Consignor,
	GoodsForRegistration.InventoryOwnerAttribute.Terms AS Terms,
		
	CASE WHEN GoodsForRegistration.Recorder = UNDEFINED THEN
		NULL
	ELSE
		GoodsForRegistration.Recorder
	END AS Recorder,
	
	GoodsForRegistration.SecondPeriod AS SecondPeriod,
	GoodsForRegistration.DayPeriod AS DayPeriod,
	GoodsForRegistration.WeekPeriod AS WeekPeriod,
	GoodsForRegistration.TenDaysPeriod AS TenDaysPeriod,
	GoodsForRegistration.MonthPeriod AS MonthPeriod,
	GoodsForRegistration.QuarterPeriod AS QuarterPeriod,
	GoodsForRegistration.HalfYearPeriod AS HalfYearPeriod,
	GoodsForRegistration.YearPeriod AS YearPeriod,
	
	GoodsForRegistration.RevenueAmountOpeningBalance AS RevenueAmountOpeningBalance,
	GoodsForRegistration.RevenueAmountReceipt AS RevenueAmountReceipt,
	GoodsForRegistration.RevenueAmountExpense AS RevenueAmountExpense,
	GoodsForRegistration.RevenueAmountClosingBalance AS RevenueAmountClosingBalance,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		GoodsForRegistration.CountOpeningBalance
		+ GoodsForRegistration.QuantityConsumedOpeningBalance
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			(GoodsForRegistration.CountOpeningBalance
			+ GoodsForRegistration.QuantityConsumedOpeningBalance) / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityToRegisterOpeningBalance,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		GoodsForRegistration.CountClosingBalance
		+ GoodsForRegistration.QuantityConsumedClosingBalance
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			(GoodsForRegistration.CountClosingBalance
			+ GoodsForRegistration.QuantityConsumedClosingBalance) / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityToRegisterClosingBalance,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		GoodsForRegistration.CountReceipt
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			GoodsForRegistration.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityToRegisterReceipt,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		GoodsForRegistration.QuantityConsumedReceipt
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			GoodsForRegistration.QuantityConsumedReceipt / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityConsumedForIncoiceRegistrationReceipt,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		GoodsForRegistration.CountExpense
		+ GoodsForRegistration.QuantityConsumedExpense
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			(GoodsForRegistration.CountExpense
			+ GoodsForRegistration.QuantityConsumedExpense) / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityToRegisterExpense,
	
	(GoodsForRegistration.CountOpeningBalance
		+ GoodsForRegistration.QuantityConsumedOpeningBalance) * &amp;QueryTextItemWeight       AS ToRegisterOpeningBalanceWeight,
	(GoodsForRegistration.CountClosingBalance
		+ GoodsForRegistration.QuantityConsumedClosingBalance) * &amp;QueryTextItemWeight        AS ToRegisterClosingBalanceWeight,
	GoodsForRegistration.CountReceipt * &amp;QueryTextItemWeight                               AS ToRegisterReceiptWeight,
	GoodsForRegistration.QuantityConsumedReceipt * &amp;QueryTextItemWeight                        AS WrittenOffToRegisterReceiptWeight,
	(GoodsForRegistration.CountExpense
		+ GoodsForRegistration.QuantityConsumedExpense) * &amp;QueryTextItemWeight                 AS ToRegisterConsumptionWeight,
	
	(GoodsForRegistration.CountOpeningBalance
		+ GoodsForRegistration.QuantityConsumedOpeningBalance) * &amp;QueryTextTheVolumeOfTheItem     AS ToRegisterOpeningBalanceVolume,
	(GoodsForRegistration.CountClosingBalance
		+ GoodsForRegistration.QuantityConsumedClosingBalance) * &amp;QueryTextTheVolumeOfTheItem      AS ToRegisterClosingBalanceVolume,
	GoodsForRegistration.CountReceipt * &amp;QueryTextTheVolumeOfTheItem                             AS ToRegisterReceiptVolume,
	GoodsForRegistration.QuantityConsumedReceipt * &amp;QueryTextTheVolumeOfTheItem                      AS WrittenOffToRegisterReceiptVolume,
	(GoodsForRegistration.CountExpense
		+ GoodsForRegistration.QuantityConsumedExpense) * &amp;QueryTextTheVolumeOfTheItem               AS ToRegisterConsumptionVolume
	
FROM
	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.BalanceAndTurnovers(,,Auto,,) AS GoodsForRegistration
	INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	ON GoodsForRegistration.ItemsLocationAttributes = DimensionOfProductItem.Ref
	{WHERE
		DimensionOfProductItem.Products.* AS Products,
		DimensionOfProductItem.Characteristic.* AS Characteristic,
		InventoryOwnerAttribute.GoodsOwner REFS Catalog.Partners,
		((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN 
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed
			)),
		(InventoryOwnerAttribute.GoodsOwner IN 
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed
			))
		}	</query>
		</item>
