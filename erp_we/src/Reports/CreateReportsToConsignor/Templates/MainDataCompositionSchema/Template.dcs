			<field xsi:type="DataSetFieldField">
				<dataPath>RevenueAmountReceipt</dataPath>
				<field>RevenueAmountReceipt</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>RevenueAmountExpense</dataPath>
				<field>RevenueAmountExpense</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Characteristic</dataPath>
				<field>Characteristic</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ServicesForRegistration.Organization AS Organization,
	ServicesForRegistration.Currency,
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Characteristic,
	DimensionOfProductItem.StorageLocation AS Consignor,
	ServicesForRegistration.Terms AS Terms,
		
	CASE WHEN ServicesForRegistration.Recorder = UNDEFINED THEN
		NULL
	ELSE
		ServicesForRegistration.Recorder
	END AS Recorder,
	
	ServicesForRegistration.SecondPeriod AS SecondPeriod,
	ServicesForRegistration.DayPeriod AS DayPeriod,
	ServicesForRegistration.WeekPeriod AS WeekPeriod,
	ServicesForRegistration.TenDaysPeriod AS TenDaysPeriod,
	ServicesForRegistration.MonthPeriod AS MonthPeriod,
	ServicesForRegistration.QuarterPeriod AS QuarterPeriod,
	ServicesForRegistration.HalfYearPeriod AS HalfYearPeriod,
	ServicesForRegistration.YearPeriod AS YearPeriod,
	
	ServicesForRegistration.RevenueAmountOpeningBalance AS RevenueAmountOpeningBalance,
	ServicesForRegistration.RevenueAmountReceipt AS RevenueAmountReceipt,
	ServicesForRegistration.RevenueAmountExpense AS RevenueAmountExpense,
	ServicesForRegistration.RevenueAmountClosingBalance AS RevenueAmountClosingBalance,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		ServicesForRegistration.CountOpeningBalance
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			ServicesForRegistration.CountOpeningBalance
				 / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityToRegisterOpeningBalance,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		ServicesForRegistration.CountClosingBalance
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			ServicesForRegistration.CountClosingBalance
				 / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityToRegisterClosingBalance,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		ServicesForRegistration.CountReceipt
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			ServicesForRegistration.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityToRegisterReceipt,
	
	0 AS QuantityConsumedForIncoiceRegistrationReceipt,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		ServicesForRegistration.CountExpense
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			ServicesForRegistration.CountExpense
				 / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS QuantityToRegisterExpense,
	
	ServicesForRegistration.CountOpeningBalance * &amp;QueryTextItemWeight       AS ToRegisterOpeningBalanceWeight,
	ServicesForRegistration.CountClosingBalance * &amp;QueryTextItemWeight        AS ToRegisterClosingBalanceWeight,
	ServicesForRegistration.CountReceipt * &amp;QueryTextItemWeight                               AS ToRegisterReceiptWeight,
	0 AS WrittenOffToRegisterReceiptWeight,
	ServicesForRegistration.CountExpense * &amp;QueryTextItemWeight                 AS ToRegisterConsumptionWeight,
	
	ServicesForRegistration.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem     AS ToRegisterOpeningBalanceVolume,
	ServicesForRegistration.CountClosingBalance * &amp;QueryTextTheVolumeOfTheItem      AS ToRegisterClosingBalanceVolume,
	ServicesForRegistration.CountReceipt * &amp;QueryTextTheVolumeOfTheItem                             AS ToRegisterReceiptVolume,
	0 AS WrittenOffToRegisterReceiptVolume,
	ServicesForRegistration.CountExpense * &amp;QueryTextTheVolumeOfTheItem               AS ToRegisterConsumptionVolume
	
FROM
	AccumulationRegister.ServicesForRegistrationOfReportsToPrincipal.BalanceAndTurnovers(,,Auto,,) AS ServicesForRegistration
	INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	ON ServicesForRegistration.ItemsLocationAttributes = DimensionOfProductItem.Ref
	{WHERE
		DimensionOfProductItem.Products.* AS Products,
		DimensionOfProductItem.Characteristic.* AS Characteristic,
		DimensionOfProductItem.StorageLocation.* AS Principal,
		((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN 
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed
			)),
		(DimensionOfProductItem.StorageLocation IN 
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed
			))
		}	
</query>
		</item>
	</dataSet>
