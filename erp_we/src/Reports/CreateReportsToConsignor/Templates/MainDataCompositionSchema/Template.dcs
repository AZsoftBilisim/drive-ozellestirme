			<field xsi:type="DataSetFieldField">
				<dataPath>ToRegisterOpeningBalanceWeight</dataPath>
				<field>ToRegisterOpeningBalanceWeight</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>To register opening balance weight</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>وزن مانده افتتاحیه برای ثبت</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Per la formalizzazione saldo iniziale peso</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Do sporządzenia początkowe saldo waga</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>К оформлению начальный остаток вес</v8:content>
					</v8:item>
