		<field xsi:type="DataSetFieldField">
			<dataPath>Warehouse</dataPath>
			<field>Warehouse</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Distributions.Ref AS Recorder,
	Distributions.Products,
	Distributions.Characteristic,
	Distributions.Series,
	Distributions.Department,
	Distributions.Warehouse,
	Distributions.Count AS TotalCount1,
	Distributions.QuantityToAllocateAccordingToRule AS QuantityAccordingToRule,
	Distributions.StageQuantityManually AS StageQuantityManually,
	Distributions.QuantityForExpenseItems AS QuantityForItems,
	Distributions.Products.UnitOfMeasure AS Ed,
	Distributions.Date AS DocDate
FROM
	Document.ProductionCostAllocation AS Distributions
WHERE
	Distributions.Ref = &amp;Recorder

UNION ALL

SELECT
	Distributions.Ref AS Recorder,
	Distributions.Products,
	Distributions.Characteristic,
	Distributions.Series,
	Distributions.Department,
	Distributions.Recipient,
	Distributions.Count AS TotalCount1,
	Distributions.QuantityAccordingToRule AS QuantityAccordingToRule,
	Distributions.Count - Distributions.QuantityAccordingToRule AS StageQuantityManually,
	0 AS QuantityForItems,
	Distributions.Products.UnitOfMeasure AS Ed,
	Distributions.Date AS DocDate
FROM
	Document.RecyclableWasteAllocation AS Distributions
WHERE
	Distributions.Ref = &amp;Recorder</query>
	</dataSet>
