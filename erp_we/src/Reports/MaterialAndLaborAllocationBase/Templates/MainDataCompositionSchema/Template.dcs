		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Allocation of materials, works, and recyclable waste</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تسهیم مواد، کارها و ضایعات قابل بازیافت</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Distribuzione del materiale, del lavoro, dello spreco di ritorno</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Dystrybucja materiałów, pracy, odpadu zwrotnego</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Распределение материала, работы, возвратного отхода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Malzeme, iş, geri dönüştürülebilir atık dağıtımı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Phân bổ nguyên vật liệu, công việc, phế liệu thu hồi</v8:content>
			</v8:item>
		</dcsset:presentation>
