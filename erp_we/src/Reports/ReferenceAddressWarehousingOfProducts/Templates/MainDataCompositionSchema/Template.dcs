	</calculatedField>
	<totalField>
		<dataPath>AdditionalStorageBin</dataPath>
		<expression>JoinStrings (Order(Array(Distinct AdditionalStorageBin)), ", ")</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>InStock</dataPath>
		<expression>Min(InStock)</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>AdditionalCellProducts</dataPath>
		<expression>JoinStrings (Order(ValueTable(Distinct AdditionalCellProducts, ProductsOfAdditionalStorageBinInStock, ProductsOfAdditionalStorageBinUnitOfMeasure)), ", ", " ")</expression>
		<group>MainStorageBin</group>
	</totalField>
	<totalField>
		<dataPath>InStock</dataPath>
		<expression>0</expression>
		<group>MainStorageBin Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>InStockWeight</dataPath>
		<expression>Min(InStockWeight)</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>InStockVolume</dataPath>
		<expression>Min(InStockVolume)</expression>
		<group>Products</group>
	</totalField>
