		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Warehouses.Ref AS Warehouse,
	ISNULL(Warerooms.Ref, VALUE(Catalog.Warerooms.EmptyRef)) AS Premise,
	VALUE(Catalog.StorageBins.EmptyRef) AS MainStorageBin
INTO StorageBins
FROM
	Catalog.Warehouses AS Warehouses
		LEFT JOIN Catalog.Warerooms AS Warerooms
		ON Warehouses.Ref = Warerooms.Owner
WHERE
	CASE
			WHEN Warehouses.UseWarerooms
					AND &amp;CurrentDate &gt;= Warehouses.StartDateOfWareroomUse
				THEN Warerooms.UseBinLocationWarehousingForInformation
						AND (NOT Warerooms.UseBinLocationWarehousing
							OR &amp;CurrentDate &lt; Warerooms.StartDateOfUsingWarehouseBinSystem)
			ELSE Warehouses.UseBinLocationWarehousingForInformation
					AND (NOT Warehouses.UseBinLocationWarehousing
						OR &amp;CurrentDate &lt; Warehouses.StartDateOfUsingWarehouseBinSystem)
		END
{WHERE
	Warehouses.Ref.* AS Warehouse,
	Warerooms.Ref.* AS Premise}

UNION ALL

SELECT
	StorageBins.Owner,
	StorageBins.Premise,
	StorageBins.Ref
FROM
	Catalog.StorageBins AS StorageBins
WHERE
	NOT StorageBins.IsFolder
	AND CASE
			WHEN StorageBins.Owner.UseWarerooms
					AND &amp;CurrentDate &gt;= StorageBins.Owner.StartDateOfWareroomUse
				THEN StorageBins.Premise.UseBinLocationWarehousingForInformation
						AND (NOT StorageBins.Premise.UseBinLocationWarehousing
							OR &amp;CurrentDate &lt; StorageBins.Premise.StartDateOfUsingWarehouseBinSystem)
			ELSE StorageBins.Owner.UseBinLocationWarehousingForInformation
					AND (NOT StorageBins.Owner.UseBinLocationWarehousing
						OR &amp;CurrentDate &lt; StorageBins.Owner.StartDateOfUsingWarehouseBinSystem)
		END
{WHERE
	StorageBins.Ref.* AS MainStorageBin,
	StorageBins.Owner.* AS Warehouse,
	StorageBins.Premise.* AS Premise}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	AllProductsAreNested.Products AS Products,
	AllProductsAreNested.Warehouse AS Warehouse,
	AllProductsAreNested.Premise AS Premise,
	SUM(AllProductsAreNested.InStock) AS InStock
INTO AllProducts
FROM
	(SELECT DISTINCT
		PlaceProductsInStorageBins.Products AS Products,
		PlaceProductsInStorageBins.Warehouse AS Warehouse,
		PlaceProductsInStorageBins.Premise AS Premise,
		0 AS InStock
	FROM
		InformationRegister.PlaceProductsInStorageBins AS PlaceProductsInStorageBins
	{WHERE
		PlaceProductsInStorageBins.Warehouse.*,
		PlaceProductsInStorageBins.Premise.*}
	
	UNION ALL
	
	SELECT
		ProductStockBalance.Products,
		ProductStockBalance.Warehouse,
		ProductStockBalance.Premise,
		ProductStockBalance.InStockBalance
	FROM
		AccumulationRegister.ProductStock.Balance(
				,
				CASE
					WHEN Warehouse.UseWarerooms
							AND &amp;CurrentDate &gt;= Warehouse.StartDateOfWareroomUse
						THEN Premise.UseBinLocationWarehousingForInformation
								AND (NOT Premise.UseBinLocationWarehousing
									OR &amp;CurrentDate &lt; Premise.StartDateOfUsingWarehouseBinSystem)
					ELSE Warehouse.UseBinLocationWarehousingForInformation
							AND (NOT Warehouse.UseBinLocationWarehousing
								OR &amp;CurrentDate &lt; Warehouse.StartDateOfUsingWarehouseBinSystem)
				END {(Warehouse).* AS Warehouse, (Premise).* AS Premise}) AS ProductStockBalance) AS AllProductsAreNested

GROUP BY
	AllProductsAreNested.Products,
	AllProductsAreNested.Warehouse,
	AllProductsAreNested.Premise
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	AllProducts.Products AS Products,
	AllProducts.Warehouse AS Warehouse,
	AllProducts.Premise AS Premise,
	ISNULL(AdditionalStorageBins.Cell, VALUE(Catalog.StorageBins.EmptyRef)) AS AdditionalStorageBin,
	ISNULL(MainStorageBins.Cell, VALUE(Catalog.StorageBins.EmptyRef)) AS MainStorageBin,
	ISNULL(AllProducts.InStock, 0) AS InStock
INTO CellProducts
FROM
	AllProducts AS AllProducts
		LEFT JOIN InformationRegister.PlaceProductsInStorageBins AS MainStorageBins
		ON AllProducts.Products = MainStorageBins.Products
			AND AllProducts.Warehouse = MainStorageBins.Warehouse
			AND AllProducts.Premise = MainStorageBins.Premise
			AND (MainStorageBins.MainStorageBin)
		LEFT JOIN InformationRegister.PlaceProductsInStorageBins AS AdditionalStorageBins
		ON AllProducts.Products = AdditionalStorageBins.Products
			AND AllProducts.Warehouse = AdditionalStorageBins.Warehouse
			AND AllProducts.Premise = AdditionalStorageBins.Premise
			AND (NOT AdditionalStorageBins.MainStorageBin)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	StorageBins.Warehouse,
	StorageBins.Premise,
	StorageBins.MainStorageBin,
	CellProducts.Products,
	CellProducts.InStock,
	CellProducts.AdditionalStorageBin.Code AS AdditionalStorageBin,
	AdditionalCellProducts.Products.Description AS AdditionalCellProducts,
	AdditionalCellProducts.Products.UnitOfMeasure AS ProductsOfAdditionalStorageBinUnitOfMeasure,
	AdditionalCellProducts.InStock AS ProductsOfAdditionalStorageBinInStock,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume
FROM
	StorageBins AS StorageBins
		LEFT JOIN CellProducts AS CellProducts
		ON StorageBins.MainStorageBin = CellProducts.MainStorageBin
			AND StorageBins.Warehouse = CellProducts.Warehouse
			AND StorageBins.Premise = CellProducts.Premise
		LEFT JOIN CellProducts AS AdditionalCellProducts
		ON StorageBins.MainStorageBin = AdditionalCellProducts.AdditionalStorageBin
			AND StorageBins.Warehouse = AdditionalCellProducts.Warehouse
			AND StorageBins.Premise = AdditionalCellProducts.Premise
			AND (AdditionalCellProducts.InStock &lt;&gt; 0)
			AND (CellProducts.Products IS NULL )
WHERE
	NOT(StorageBins.MainStorageBin = VALUE(Catalog.StorageBins.EmptyRef)
				AND CellProducts.Products IS NULL )
{WHERE
	StorageBins.MainStorageBin.* AS MainStorageBin}</query>
	</dataSet>
	<calculatedField>
		<dataPath>InStock</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        InStock
    When &amp;QuantityUnits = 1 Then
        InStock / Products.UnitFactorForReports
End</expression>
