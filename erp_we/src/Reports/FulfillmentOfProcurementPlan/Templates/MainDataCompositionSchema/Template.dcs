		Then 0
	When PlanExecution.Sum &gt; 100
		Then PlanExecution.Sum - 100
	Else 100 - PlanExecution.Sum
End</dcsset:detailExpression>
							<dcsset:detailExpressionPresentation>Case
	When Plan.Sum = 0 And Real.Sum = 0
		Then 0
	When PlanExecution.Sum &gt; 100
		Then PlanExecution.Sum - 100
	Else 100 - PlanExecution.Sum
End</dcsset:detailExpressionPresentation>
