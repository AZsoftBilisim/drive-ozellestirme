							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>NFD=2</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>NFD=2</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>NFD=2</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>NFD=2</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>NFD=2</v8:content>
							</v8:item>
