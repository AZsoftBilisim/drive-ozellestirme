					</title>
				</field>
				<field xsi:type="DataSetFieldFolder">
					<dataPath>PlanExecution</dataPath>
					<title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Plan fulfillment</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>اجرای برنامه</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>ИсполнениеПлана</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>ИсполнениеПлана</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ИсполнениеПлана</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>ИсполнениеПлана</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>ThựcHiệnKếHoạch</v8:content>
						</v8:item>
					</title>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>OrderDate</dataPath>
					<field>OrderDate</field>
				</field>
				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PurchasePlansTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasePlansTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PurchasePlansTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasePlansTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasePlansTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PurchasePlansTurnovers.YearPeriod
		ELSE PurchasePlansTurnovers.DayPeriod
	END AS DynamicPeriod,
	PurchasePlansTurnovers.Partner AS Partner,
	PurchasePlansTurnovers.Products AS Products,
	PurchasePlansTurnovers.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
		THEN PurchasePlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	PurchasePlansTurnovers.Recorder AS Recorder,
	SUM(PurchasePlansTurnovers.CountTurnover) AS Count,
	SUM(PurchasePlansTurnovers.SumTurnover) AS Sum
INTO PurchasePlan
{SELECT
	Partner.*}
FROM
	AccumulationRegister.PurchasePlans.Turnovers(
		,
		,
		Auto,
		Scenario = &amp;Scenario
		{(Partner) AS Partner, (Partner IN
			(SELECT
					SelectionByPartnerSegment.Partner
				FROM
					SelectionByPartnerSegment AS SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
		((Products, Characteristic) IN
			(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment AS SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))
	}) AS PurchasePlansTurnovers
{WHERE
	PurchasePlansTurnovers.Products.*}

GROUP BY
	PurchasePlansTurnovers.Products,
	PurchasePlansTurnovers.Characteristic,
	CASE 
		WHEN &amp;SpecifyTargets 
		THEN PurchasePlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	PurchasePlansTurnovers.Partner,
	PurchasePlansTurnovers.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PurchasePlansTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasePlansTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PurchasePlansTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasePlansTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasePlansTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PurchasePlansTurnovers.YearPeriod
		ELSE PurchasePlansTurnovers.DayPeriod
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;BeginOfPeriod AS Period,
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;BeginOfPeriod, Currency IN (&amp;CurrencyOfMan, &amp;ScenarioCurrency) AND BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
WHERE
	&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency

UNION ALL

SELECT
	ExchangeRates.Period,
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
FROM
	InformationRegister.RelativeExchangeRates AS ExchangeRates
WHERE
	&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency
	AND ExchangeRates.Period &gt; &amp;BeginOfPeriod
	AND ExchangeRates.Period &lt;= &amp;EndOfPeriod
	AND ExchangeRates.Currency IN (&amp;CurrencyOfMan, &amp;ScenarioCurrency)
	AND BaseCurrency = &amp;BaseCurrency

INDEX BY
	Period,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PurchasesTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasesTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PurchasesTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasesTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasesTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PurchasesTurnovers.YearPeriod
		ELSE PurchasesTurnovers.DayPeriod
	END AS DynamicPeriod,
	PurchasesTurnovers.Partner AS Partner,
	PurchasesTurnovers.ItemsLocationAttributes.Products AS Products,
	PurchasesTurnovers.ItemsLocationAttributes.Characteristic AS Characteristic,
	CASE 
		WHEN &amp;SpecifyTargets
		THEN PurchasesTurnovers.ItemsLocationAttributes.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	PurchasesTurnovers.Recorder AS Recorder,
	SUM(PurchasesTurnovers.CountTurnover * CASE
			WHEN PurchasesTurnovers.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfGoodsToVendor)
				THEN -1
			ELSE 1
		END) AS FactQuantity,
	SUM(CAST(CASE
		WHEN &amp;SumOfFactWithVAT
			THEN PurchasesTurnovers.SumTurnover
		ELSE PurchasesTurnovers.AmountExcludingVATTurnover
	END * CASE
		WHEN PurchasesTurnovers.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfGoodsToVendor)
			THEN -1
		ELSE 1
	END * CASE
		WHEN &amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency
			THEN CASE
				WHEN ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)) &gt; 0
					AND ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) &gt; 0
					AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
					AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
					THEN ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) * ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) / (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) * ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)))
				ELSE 0
			END
		ELSE 1
	END AS NUMBER(31,2))) AS ActualAmount
INTO Purchases
FROM
	AccumulationRegister.Purchases.Turnovers(
		,
		,
		Auto,
		{(CASE
			WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
				THEN ItemsLocationAttributes IN
					(SELECT DISTINCT
						ItemsLocationAttributes.DimensionKey
					FROM
						PurchasePlan AS PurchasePlan
							INNER JOIN InformationRegister.ItemsLocationAttributes AS ItemsLocationAttributes
							ON PurchasePlan.Products = ItemsLocationAttributes.Products
							 AND PurchasePlan.Characteristic = ItemsLocationAttributes.Characteristic)
			ELSE TRUE
		END), (Organization) AS Organization, (Partner) AS Partner}) AS PurchasesTurnovers
		LEFT JOIN ExchangeRates AS ManSExchangeRates
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (ManSExchangeRates.Currency = &amp;CurrencyOfMan)
			AND PurchasesTurnovers.DayPeriod = ManSExchangeRates.Period
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND PurchasesTurnovers.DayPeriod = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS ExchangeRatesOfManAtBeginning
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (ExchangeRatesOfManAtBeginning.Currency = &amp;CurrencyOfMan)
			AND (ExchangeRatesOfManAtBeginning.Period = &amp;BeginOfPeriod)
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;BeginOfPeriod)
{WHERE
	PurchasesTurnovers.ItemsLocationAttributes.Products.* AS Products}

GROUP BY
	PurchasesTurnovers.Partner,
	PurchasesTurnovers.ItemsLocationAttributes.Characteristic,
	PurchasesTurnovers.ItemsLocationAttributes.Products,
	CASE 
		WHEN &amp;SpecifyTargets 
		THEN PurchasesTurnovers.ItemsLocationAttributes.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	PurchasesTurnovers.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PurchasesTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasesTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PurchasesTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasesTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasesTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PurchasesTurnovers.YearPeriod
		ELSE PurchasesTurnovers.DayPeriod
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Table.Products AS Products,
	Table.Characteristic AS Characteristic
INTO TTPlanProducts
FROM
	PurchasePlan AS Table

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, YEAR)
		ELSE PurchaseOrderGoods.DateOfReceipt
	END AS DynamicPeriod,
	PurchaseOrderGoods.Ref.Partner AS Partner,
	PurchaseOrderGoods.Products AS Products,
	PurchaseOrderGoods.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN PurchaseOrderGoods.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	PurchaseOrderGoods.Ref AS Recorder,
	SUM(ISNULL(OrdersToBeRegistered.ToRegisterBalance, 0)) AS OrderedQuantity,
	SUM(CASE
		WHEN PurchaseOrderGoods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
			THEN PurchaseOrderGoods.Count - ISNULL(OrdersToBeRegistered.OrderedBalance, 0)
		ELSE 0
	END) AS NumberOfServiceFacts,
	SUM(CASE
		WHEN PurchaseOrderGoods.Products.ItemsType = VALUE(Enum.ItemsTypes.OperationService)
			THEN (PurchaseOrderGoods.Count - ISNULL(OrdersToBeRegistered.OrderedBalance, 0)) * PurchaseOrderGoods.Price
		ELSE 0
	END) AS AmountFactOfService
INTO Orders
FROM
	Document.PurchaseOrder.Goods AS PurchaseOrderGoods
		
		INNER JOIN TTPlanProducts AS FilterOfProductItem
		ON PurchaseOrderGoods.Products = FilterOfProductItem.Products
		 AND PurchaseOrderGoods.Characteristic = FilterOfProductItem.Characteristic
		
		LEFT JOIN AccumulationRegister.PurchaseOrders.Balance(
			,
			PurchaseOrder REFS Document.PurchaseOrder
			AND CASE
				WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
					THEN (Products, Characteristic) IN
						(SELECT DISTINCT
							FilterOfProductItem.Products,
							FilterOfProductItem.Characteristic
						FROM
							TTPlanProducts AS FilterOfProductItem)
				ELSE TRUE
			END) AS OrdersToBeRegistered
		ON PurchaseOrderGoods.Ref = OrdersToBeRegistered.PurchaseOrder
		AND PurchaseOrderGoods.RowCode = OrdersToBeRegistered.RowCode
WHERE
	PurchaseOrderGoods.Ref.Posted
	AND NOT PurchaseOrderGoods.Canceled
{WHERE
	(PurchaseOrderGoods.DateOfReceipt &gt;= &amp;BeginOfPeriod),
	(PurchaseOrderGoods.DateOfReceipt &lt;= &amp;EndOfPeriod),
	PurchaseOrderGoods.Ref.Organization.* AS Organization,
	PurchaseOrderGoods.Ref.Partner.* AS Partner,
	(PurchaseOrderGoods.Ref.Partner IN
		(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment AS SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	PurchaseOrderGoods.Characteristic,
	PurchaseOrderGoods.Products,
	CASE
		WHEN &amp;SpecifyTargets
			THEN PurchaseOrderGoods.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	PurchaseOrderGoods.Ref,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(PurchaseOrderGoods.DateOfReceipt, YEAR)
		ELSE PurchaseOrderGoods.DateOfReceipt
	END,
	PurchaseOrderGoods.Ref.Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DynamicPeriod,
	NestedQuery.Partner,
	NestedQuery.Products,
	NestedQuery.Characteristic,
	NestedQuery.Purpose,
	NestedQuery.Recorder,
	SUM(NestedQuery.PlanQuantity) AS PlanQuantity,
	SUM(NestedQuery.PlanAmount) AS PlanAmount,
	SUM(NestedQuery.FactQuantity) AS FactQuantity,
	SUM(NestedQuery.ActualAmount) AS ActualAmount,
	SUM(NestedQuery.OrderedQuantity) AS OrderedQuantity
INTO ProcurementPlanFact
FROM
	(SELECT
		PurchasePlan.DynamicPeriod AS DynamicPeriod,
		PurchasePlan.Partner AS Partner,
		PurchasePlan.Products AS Products,
		PurchasePlan.Characteristic AS Characteristic,
		PurchasePlan.Purpose AS Purpose,
		PurchasePlan.Recorder AS Recorder,
		PurchasePlan.Count AS PlanQuantity,
		PurchasePlan.Sum AS PlanAmount,
		0 AS FactQuantity,
		0 AS ActualAmount,
		0 AS OrderedQuantity
	FROM
		PurchasePlan AS PurchasePlan
	
	UNION ALL
	
	SELECT
		Purchases.DynamicPeriod,
		Purchases.Partner,
		Purchases.Products,
		Purchases.Characteristic,
		Purchases.Purpose,
		Purchases.Recorder,
		0,
		0,
		Purchases.FactQuantity,
		Purchases.ActualAmount,
		0
	FROM
		Purchases AS Purchases
	
	UNION ALL
	
	SELECT
		Orders.DynamicPeriod,
		Orders.Partner,
		Orders.Products,
		Orders.Characteristic,
		Orders.Purpose,
		Orders.Recorder,
		0,
		0,
		Orders.NumberOfServiceFacts,
		Orders.AmountFactOfService,
		Orders.OrderedQuantity
	FROM
		Orders AS Orders) AS NestedQuery

GROUP BY
	NestedQuery.DynamicPeriod,
	NestedQuery.Characteristic,
	NestedQuery.Products,
	NestedQuery.Purpose,
	NestedQuery.Recorder,
	NestedQuery.Partner
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProcurementPlanFact.DynamicPeriod,
	ProcurementPlanFact.Partner AS Partner,
	ProcurementPlanFact.Products,
	ProcurementPlanFact.Products.UnitOfMeasure AS StorageUnit,
	ProcurementPlanFact.Products.UnitForReports AS UnitForReports,
	CASE
		WHEN ProcurementPlanFact.Products.UnitFactorForReports &lt;&gt; 0
			THEN 1 / ProcurementPlanFact.Products.UnitFactorForReports
		ELSE 1
	END AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	ProcurementPlanFact.Characteristic,
	ProcurementPlanFact.Purpose,
	ProcurementPlanFact.Recorder,
	SUM(ProcurementPlanFact.PlanQuantity) AS PlanQuantity,
	SUM(ProcurementPlanFact.PlanAmount) AS PlanAmount,
	SUM(ProcurementPlanFact.FactQuantity) AS FactQuantity,
	SUM(ProcurementPlanFact.ActualAmount) AS ActualAmount,
	100 * (CASE
		WHEN SUM(ProcurementPlanFact.PlanQuantity) = 0
			THEN 0
		ELSE SUM(ProcurementPlanFact.FactQuantity) / SUM(ProcurementPlanFact.PlanQuantity)
	END) AS ExecutionOfPlanQuantity,
	100 * (CASE
		WHEN SUM(ProcurementPlanFact.PlanAmount) = 0
			THEN 0
		ELSE SUM(ProcurementPlanFact.ActualAmount) / SUM(ProcurementPlanFact.PlanAmount)
	END) AS ExecutionOfPlanSum,
	SUM(ProcurementPlanFact.OrderedQuantity) AS OrderedQuantity
FROM
	ProcurementPlanFact AS ProcurementPlanFact
WHERE
	ProcurementPlanFact.DynamicPeriod BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
{WHERE
	ProcurementPlanFact.Partner.*}

GROUP BY
	ProcurementPlanFact.DynamicPeriod,
	ProcurementPlanFact.Products,
	ProcurementPlanFact.Characteristic,
	ProcurementPlanFact.Purpose,
	ProcurementPlanFact.Recorder,
	ProcurementPlanFact.Partner</query>
			</dataSet>
			<calculatedField>
				<dataPath>PlanExecution.Price</dataPath>
				<expression>100 * (Case When Plan.Count &lt;&gt; 0 And Real.Count &lt;&gt; 0 Then (Case When (Plan.Sum / Plan.Count) = 0 Then 0 Else (Real.Sum / Real.Count) / (Plan.Sum / Plan.Count) End-1) Else 0 End)</expression>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Price variance</v8:content>
					</v8:item>
