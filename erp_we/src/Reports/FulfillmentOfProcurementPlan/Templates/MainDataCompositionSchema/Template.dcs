				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PaymentPlan_.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PaymentPlan_.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PaymentPlan_.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PaymentPlan_.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PaymentPlan_.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PaymentPlan_.YearPeriod
		ELSE PaymentPlan_.DayPeriod
	END AS DynamicPeriod,
	PaymentPlan_.Partner AS Partner,
	PaymentPlan_.Recorder AS Recorder,
	SUM(PaymentPlan_.SumTurnover) AS PaymentPlan_1,
	0 AS ShippingPlan_
INTO Plans
{SELECT
	Partner.*}
FROM
	AccumulationRegister.CashFlowPlansVendors.Turnovers(
		,
		,
		Auto,
		Scenario = &amp;Scenario
		{(Plan) AS DocumentPlan,
		(Partner IN
			(SELECT
					SelectionByPartnerSegment.Partner
				FROM
					SelectionByPartnerSegment AS SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))
		}) AS PaymentPlan_

GROUP BY
	PaymentPlan_.Partner,
	PaymentPlan_.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PaymentPlan_.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PaymentPlan_.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PaymentPlan_.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PaymentPlan_.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PaymentPlan_.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PaymentPlan_.YearPeriod
		ELSE PaymentPlan_.DayPeriod
	END

UNION ALL

SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN ShipmentPlan.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN ShipmentPlan.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN ShipmentPlan.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN ShipmentPlan.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN ShipmentPlan.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN ShipmentPlan.YearPeriod
		ELSE ShipmentPlan.DayPeriod
	END,
	ShipmentPlan.Partner,
	ShipmentPlan.Recorder,
	0,
	SUM(ShipmentPlan.SumTurnover)
FROM
	AccumulationRegister.PurchasePlans.Turnovers(
		,
		,
		Auto,
		Scenario = &amp;Scenario
		{(PurchasePlan) AS DocumentPlan,
		(Partner IN
			(SELECT
					SelectionByPartnerSegment.Partner
				FROM
					SelectionByPartnerSegment AS SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))
		}) AS ShipmentPlan

GROUP BY
	ShipmentPlan.Partner,
	ShipmentPlan.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN ShipmentPlan.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN ShipmentPlan.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN ShipmentPlan.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN ShipmentPlan.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN ShipmentPlan.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN ShipmentPlan.YearPeriod
		ELSE ShipmentPlan.DayPeriod
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;BeginOfPeriod AS Period,
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;BeginOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut

UNION ALL

SELECT
	ExchangeRates.Period,
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
FROM
	InformationRegister.RelativeExchangeRates AS ExchangeRates
WHERE
	ExchangeRates.Period &gt; &amp;BeginOfPeriod
	AND ExchangeRates.Period &lt;= &amp;EndOfPeriod
	AND BaseCurrency = &amp;BaseCurrency

INDEX BY
	Period,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PurchasesTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasesTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PurchasesTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasesTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasesTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PurchasesTurnovers.YearPeriod
		ELSE PurchasesTurnovers.DayPeriod
	END AS DynamicPeriod,
	PurchasesTurnovers.Partner AS Partner,
	PurchasesTurnovers.Recorder AS Recorder,
	SUM(CAST(CASE
		WHEN &amp;SumOfFactWithVAT
			THEN PurchasesTurnovers.SumTurnover
		ELSE PurchasesTurnovers.AmountExcludingVATTurnover
	END * CASE
		WHEN PurchasesTurnovers.BusinessOperation = VALUE(Enum.BusinessTransactions.ReturnOfGoodsToVendor)
			THEN -1
		ELSE 1
	END * CASE
		WHEN &amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency
			THEN CASE
				WHEN ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)) &gt; 0
					AND ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) &gt; 0
					AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
					AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
					THEN ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) * ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) / (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) * ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)))
				ELSE 0
			END
		ELSE 1
	END AS NUMBER(31,2))) AS FactShipment,
	0 AS FactPayment
INTO Real
FROM
	AccumulationRegister.Purchases.Turnovers(, , Auto, 
			{(Partner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment AS SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))
			}) AS PurchasesTurnovers
		LEFT JOIN ExchangeRates AS ManSExchangeRates
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (ManSExchangeRates.Currency = &amp;CurrencyOfMan)
			AND PurchasesTurnovers.DayPeriod = ManSExchangeRates.Period
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND PurchasesTurnovers.DayPeriod = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS ExchangeRatesOfManAtBeginning
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (ExchangeRatesOfManAtBeginning.Currency = &amp;CurrencyOfMan)
			AND (ExchangeRatesOfManAtBeginning.Period = &amp;BeginOfPeriod)
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;BeginOfPeriod)

GROUP BY
	PurchasesTurnovers.Partner,
	PurchasesTurnovers.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PurchasesTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasesTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PurchasesTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasesTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasesTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PurchasesTurnovers.YearPeriod
		ELSE PurchasesTurnovers.DayPeriod
	END

UNION ALL

SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.YearPeriod
		ELSE RegisteredRecordsOfSuppliersAndRevolutions.DayPeriod
	END,
	RegisteredRecordsOfSuppliersAndRevolutions.Partner,
	RegisteredRecordsOfSuppliersAndRevolutions.Recorder,
	0,
	SUM(CAST(CASE
		WHEN &amp;SumOfFactWithVAT
			THEN RegisteredRecordsOfSuppliersAndRevolutions.PaymentAmountPaymentCurrencyTurnover
		ELSE (RegisteredRecordsOfSuppliersAndRevolutions.PaymentAmountPaymentCurrencyTurnover - RegisteredRecordsOfSuppliersAndRevolutions.AmountVATCurrencyPaymentTurnover)
	END * CASE
		WHEN RegisteredRecordsOfSuppliersAndRevolutions.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundFromVendor)
			THEN -1
		ELSE 1
	END * CASE
				WHEN RegisteredRecordsOfSuppliersAndRevolutions.PaymentCurrency &lt;&gt; &amp;ScenarioCurrency
			THEN CASE
				WHEN ISNULL(SettlementCurrencyRates_.CourseDenominator, ISNULL(SettlementCurrencyRatesAtBeginning.CourseDenominator, 0)) &gt; 0
				AND ISNULL(SettlementCurrencyRates_.CourseNumerator, ISNULL(SettlementCurrencyRatesAtBeginning.CourseNumerator, 0)) &gt; 0
				AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
				AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
					THEN ISNULL(SettlementCurrencyRates_.CourseNumerator, ISNULL(SettlementCurrencyRatesAtBeginning.CourseNumerator, 0))
					* ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0))
					/ (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0))
					* ISNULL(SettlementCurrencyRates_.CourseDenominator, ISNULL(SettlementCurrencyRatesAtBeginning.CourseDenominator, 0)))
				ELSE 0
			END
		ELSE 1
	END AS NUMBER(31,2)))
FROM
	AccumulationRegister.RecordsCashCounterparty.Turnovers(, , Auto, ) AS RegisteredRecordsOfSuppliersAndRevolutions
		LEFT JOIN ExchangeRates AS SettlementCurrencyRates_
		ON RegisteredRecordsOfSuppliersAndRevolutions.DayPeriod = SettlementCurrencyRates_.Period
			AND RegisteredRecordsOfSuppliersAndRevolutions.PaymentCurrency = SettlementCurrencyRates_.Currency
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND RegisteredRecordsOfSuppliersAndRevolutions.DayPeriod = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS SettlementCurrencyRatesAtBeginning
		ON (SettlementCurrencyRatesAtBeginning.Period = &amp;BeginOfPeriod)
			AND RegisteredRecordsOfSuppliersAndRevolutions.PaymentCurrency = SettlementCurrencyRatesAtBeginning.Currency
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;BeginOfPeriod)
WHERE
	RegisteredRecordsOfSuppliersAndRevolutions.BusinessOperation IN (
		VALUE(Enum.BusinessTransactions.PaymentToVendor), 
		VALUE(Enum.BusinessTransactions.AdvanceHolderPaymentToVendor), 
		VALUE(Enum.BusinessTransactions.RefundFromVendor))
{WHERE
	RegisteredRecordsOfSuppliersAndRevolutions.Organization.*,
	(RegisteredRecordsOfSuppliersAndRevolutions.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment AS SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	RegisteredRecordsOfSuppliersAndRevolutions.Partner,
	RegisteredRecordsOfSuppliersAndRevolutions.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN RegisteredRecordsOfSuppliersAndRevolutions.YearPeriod
		ELSE RegisteredRecordsOfSuppliersAndRevolutions.DayPeriod
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DynamicPeriod,
	NestedQuery.Partner,
	NestedQuery.Recorder,
	SUM(NestedQuery.ShippingPlan_) AS ShippingPlan_,
	SUM(NestedQuery.PaymentPlan_1) AS PaymentPlan_1,
	SUM(NestedQuery.FactShipment) AS FactShipment,
	SUM(NestedQuery.FactPayment) AS FactPayment
INTO PlanFact
FROM
	(SELECT
		Plans.DynamicPeriod AS DynamicPeriod,
		Plans.Partner AS Partner,
		Plans.Recorder AS Recorder,
		Plans.ShippingPlan_ AS ShippingPlan_,
		Plans.PaymentPlan_1 AS PaymentPlan_1,
		0 AS FactShipment,
		0 AS FactPayment
	FROM
		Plans AS Plans
	
	UNION ALL
	
	SELECT
		Real.DynamicPeriod,
		Real.Partner,
		Real.Recorder,
		0,
		0,
		Real.FactShipment,
		Real.FactPayment
	FROM
		Real AS Real) AS NestedQuery

GROUP BY
	NestedQuery.DynamicPeriod,
	NestedQuery.Partner,
	NestedQuery.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PlanFact.DynamicPeriod,
	PlanFact.Partner AS Partner,
	PlanFact.Recorder,
	PlanFact.ShippingPlan_,
	PlanFact.PaymentPlan_1,
	PlanFact.FactShipment,
	PlanFact.FactPayment,
	100 * (CASE
		WHEN SUM(PlanFact.PaymentPlan_1) = 0
			THEN 0
		ELSE SUM(PlanFact.FactPayment) / SUM(PlanFact.PaymentPlan_1)
	END) AS ExecutionOfPaymentPlan_
FROM
	PlanFact AS PlanFact
WHERE
	PlanFact.DynamicPeriod BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	PlanFact.DynamicPeriod,
	PlanFact.Recorder,
	PlanFact.ShippingPlan_,
	PlanFact.PaymentPlan_1,
	PlanFact.FactShipment,
	PlanFact.FactPayment,
	PlanFact.Partner</query>
			</dataSet>
