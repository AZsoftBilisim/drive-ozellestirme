					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Unità del report</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Jednostka raportu</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Единица отчета</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Rapor birimi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Đơn vị báo cáo</v8:content>
					</v8:item>
				</title>
				<useRestriction>
					<field>true</field>
					<condition>true</condition>
					<group>true</group>
					<order>true</order>
				</useRestriction>
			</calculatedField>
			<calculatedField>
				<dataPath>DynamicPeriod</dataPath>
				<expression>Case
	When &amp;Periodicity = Value(Enum.Periodicity.Week)
		Then Format(DynamicPeriod, NStr("ru = 'ДФ=''dd.MM.yyyy ""г.""'''; vi = 'DF=''dd.MM.yyyy'''; en = 'DF=''MM/dd/yyyy'''; it = 'DF=''dd.MM.yyyy ""a.""'''; pl = 'DF=''dd.MM.yyyy ""r"".'; tr = 'TF=''gg.AA.yyyy ""y"".'"))
	When &amp;Periodicity = Value(Enum.Periodicity.TenDays)
		Then Format(DynamicPeriod, NStr("ru = 'ДФ=''dd.MM.yyyy ""г.""'''; vi = 'DF=''dd.MM.yyyy'''; en = 'DF=''MM/dd/yyyy'''; it = 'DF=''dd.MM.yyyy ""a.""'''; pl = 'DF=''dd.MM.yyyy ""r"".'; tr = 'TF=''gg.AA.yyyy ""y"".'"))
	When &amp;Periodicity = Value(Enum.Periodicity.Month)
		Then Format(DynamicPeriod, NStr("ru = 'ДФ=''ММММ гггг ""г.""'''; vi = 'DF=''MMMM yyyy'''; en = 'DF=''MMMM yyyy'''; it = 'DF=''MMMM yyyy ""a.""'''; pl = 'DF=''ММММ yyyy ""r.""'''; tr = 'DF=''MMMM yyyy ""yıl.""'''"))
	When &amp;Periodicity = Value(Enum.Periodicity.Quarter)
		Then Format(DynamicPeriod, NStr("ru = 'ДФ=''к ""квартал"" гггг ""г.""'''; vi = 'DF=''""quý"" q ""năm"" yyyy'''; en = 'DF=''q ""quarter"" yyyy'''; it = 'DF=''q ''''trimestre'''' yyyy  ''''a.'''''''; pl = 'DF=''k ""kwartał"" rrrr ""r.""'''; tr = 'DF=''q ""çeyrek"" yyyy ""yıl.""'''"))
	When &amp;Periodicity = Value(Enum.Periodicity.HalfYear)
		Then Format(DynamicPeriod, NStr("ru = 'ДФ=''ММ.гггг ""г.""'''; vi = 'DF=''ММ.yyyy'''; en = 'DF=''MM.yyyy'''; it = 'FD=''MM.aaaa ""a""'; pl = 'DF=''MM.yyyy ""r.""'''; tr = 'TF=''AAAA yyyy ""y.""'''"))
	When &amp;Periodicity = Value(Enum.Periodicity.Year)
		Then Format(DynamicPeriod, NStr("ru = 'ДФ=''yyyy ""г.""'''; vi = 'DF=''yyyy'''; en = 'DF=''yyyy'''; it = 'DF=''yyyy ""a.""'''; pl = 'ДФ(LD)=''rrrr ""r.""'''; tr = 'TF=''yyyy ""y.""'''"))
	Else Format(DynamicPeriod, NStr("ru = 'ДФ=''dd.MM.yyyy ""г.""'''; vi = 'DF=''dd.MM.yyyy'''; en = 'DF=''MM/dd/yyyy'''; it = 'DF=''dd.MM.yyyy ""a.""'''; pl = 'DF=''dd.MM.yyyy ""r"".'; tr = 'TF=''gg.AA.yyyy ""y"".'"))
End</expression>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Dynamic period</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>دوره پویا</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Periodo dinamico</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Okres dynamiczny</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Динамический период</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Dinamik dönem</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Kỳ biến động</v8:content>
					</v8:item>
				</title>
				<orderExpression>
					<dcscom:expression>DynamicPeriod</dcscom:expression>
					<dcscom:orderType>Asc</dcscom:orderType>
					<dcscom:autoOrder>false</dcscom:autoOrder>
				</orderExpression>
			</calculatedField>
			<totalField>
				<dataPath>Ordered.Count</dataPath>
				<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Ordered.Count)
End</expression>
			</totalField>
			<totalField>
				<dataPath>PlanExecution.Count</dataPath>
				<expression>100 * (Case When Sum(Plan.Count) = 0 Then 0 Else Sum(Real.Count) / Sum(Plan.Count) End)</expression>
			</totalField>
			<totalField>
				<dataPath>PlanExecution.Sum</dataPath>
				<expression>100 * (Case When Sum(Plan.Sum) = 0 Then 0 Else Sum(Real.Sum) / Sum(Plan.Sum) End)</expression>
			</totalField>
			<totalField>
				<dataPath>PlanExecution.Price</dataPath>
				<expression>100 * (Case When Sum(Plan.Count) &lt;&gt; 0 And Sum(Real.Count) &lt;&gt; 0 Then (Case When (Sum(Plan.Sum) / Sum(Plan.Count)) = 0 Then 0 Else (Sum(Real.Sum) / Sum(Real.Count)) / (Sum(Plan.Sum) / Sum(Plan.Count)) End-1) Else 0 End)</expression>
			</totalField>
			<totalField>
				<dataPath>Plan.Count</dataPath>
				<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Plan.Count)
End</expression>
			</totalField>
			<totalField>
				<dataPath>Plan.Sum</dataPath>
				<expression>Sum(Plan.Sum)</expression>
			</totalField>
			<totalField>
				<dataPath>Real.Count</dataPath>
				<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Real.Count)
End</expression>
			</totalField>
			<totalField>
				<dataPath>Real.Sum</dataPath>
				<expression>Sum(Real.Sum)</expression>
			</totalField>
			<totalField>
				<dataPath>Ordered.Weight</dataPath>
				<expression>Sum(Ordered.Weight)</expression>
			</totalField>
			<totalField>
				<dataPath>Ordered.VolumeM3</dataPath>
				<expression>Sum(Ordered.VolumeM3)</expression>
			</totalField>
			<totalField>
				<dataPath>PlanExecution.Weight</dataPath>
				<expression>100 * (Case When Sum(Plan.Count * ProductsWeight) = 0 Then 0 Else Sum(Real.Count * ProductsWeight) / Sum(Plan.Count * ProductsWeight) End)</expression>
			</totalField>
			<totalField>
				<dataPath>PlanExecution.VolumeM3</dataPath>
				<expression>100 * (Case When Sum(Plan.Count * ProductsVolume) = 0 Then 0 Else Sum(Real.Count * ProductsVolume) / Sum(Plan.Count * ProductsVolume) End)</expression>
			</totalField>
			<totalField>
				<dataPath>Plan.Weight</dataPath>
				<expression>Sum(Plan.Weight)</expression>
			</totalField>
			<totalField>
				<dataPath>Plan.VolumeM3</dataPath>
				<expression>Sum(Plan.VolumeM3)</expression>
			</totalField>
			<totalField>
				<dataPath>Real.Weight</dataPath>
				<expression>Sum(Real.Weight)</expression>
			</totalField>
			<totalField>
				<dataPath>Real.VolumeM3</dataPath>
				<expression>Sum(Real.VolumeM3)</expression>
			</totalField>
