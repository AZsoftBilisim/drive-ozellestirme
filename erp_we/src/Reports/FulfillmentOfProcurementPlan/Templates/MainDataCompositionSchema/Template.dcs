				<v8:content>Tolleranza Importo, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Dopuszczalne tolerancje kwoty, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
