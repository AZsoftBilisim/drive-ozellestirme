	<totalField>
		<dataPath>GrossProfit</dataPath>
		<expression>Case
    When Sum(GrossProfit) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(GrossProfit), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(GrossProfit)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Revenue</dataPath>
		<expression>Case
    When Sum(Revenue) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Revenue), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(Revenue)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AddExpensesForGoods</dataPath>
		<expression>Case
    When Sum(AddExpensesForGoods) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(AddExpensesForGoods), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(AddExpensesForGoods)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(Count)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Profitability</dataPath>
		<expression>Cast(
	Case 
		When Sum(Revenue) &lt;&gt; 0 Then
            (Sum(Revenue)- Sum(Cost_) - Sum(AddExpensesForGoods) - Sum(LaborCosts) - Sum(ItemizedVariable) - Sum(ItemizedFixed) 
            - Sum(SellingExpenses_) - Sum(ProvisionForImpairment)
            )
            / Case When Sum(Revenue) &gt; 0 Then Sum(Revenue) Else -1*Sum(Revenue) End
	Else
		0
	End * 100, "NUMBER(15,2)")</expression>
	</totalField>
	<totalField>
		<dataPath>Cost_</dataPath>
		<expression>Case
    When Sum(Cost_) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Cost_), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(Cost_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>VATRevenue</dataPath>
		<expression>Case
    When Sum(VATRevenue) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(VATRevenue), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(VATRevenue)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CostOfProductionTotal</dataPath>
		<expression>Case
    When Sum(CostOfProductionTotal) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(CostOfProductionTotal), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(CostOfProductionTotal)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SerialNumber</dataPath>
		<expression>EvalExpression("GroupSerialNumber()", , , , , "Sum(Revenue) Desc")</expression>
	</totalField>
	<totalField>
		<dataPath>Weight</dataPath>
		<expression>Sum(Weight)</expression>
	</totalField>
	<totalField>
		<dataPath>VolumeM3</dataPath>
		<expression>Sum(VolumeM3)</expression>
	</totalField>
	<totalField>
		<dataPath>DiscountMarkupAmount</dataPath>
		<expression>Case
    When Sum(DiscountMarkupAmount) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(DiscountMarkupAmount), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(DiscountMarkupAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ManualDiscount</dataPath>
		<expression>Case
    When Sum(ManualDiscount) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ManualDiscount), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ManualDiscount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>TotalOfDiscounts</dataPath>
		<expression>Case
    When Sum(TotalOfDiscounts) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(TotalOfDiscounts), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(TotalOfDiscounts)
End</expression>
	</totalField>
	<totalField>
		<dataPath>LaborCosts</dataPath>
		<expression>Case
    When Sum(LaborCosts) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(LaborCosts), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(LaborCosts)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ItemizedVariable</dataPath>
		<expression>Case
    When Sum(ItemizedVariable) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ItemizedVariable), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ItemizedVariable)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ItemizedFixed</dataPath>
		<expression>Case
    When Sum(ItemizedFixed) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ItemizedFixed), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ItemizedFixed)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Cost_Preliminary</dataPath>
		<expression>Case
    When Sum(Cost_Preliminary) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Cost_Preliminary), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(Cost_Preliminary)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CostDeviation_</dataPath>
		<expression>Case
    When Sum(CostDeviation_) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(CostDeviation_), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(CostDeviation_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SellingExpenses_</dataPath>
		<expression>Case
    When Sum(SellingExpenses_) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SellingExpenses_), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(SellingExpenses_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Cost_</dataPath>
		<expression>Sum(InitialMaterialCosts)</expression>
		<group>DimensionOfExpenses</group>
		<group>SourceReceiptDocument</group>
		<group>SourceProducts_</group>
		<group>ExpenseItem</group>
		<group>InitialCharacteristic</group>
	</totalField>
	<totalField>
		<dataPath>ItemizedFixed</dataPath>
		<expression>Sum(InitialArticleByArticleConstants)</expression>
		<group>DimensionOfExpenses</group>
		<group>SourceReceiptDocument</group>
		<group>SourceProducts_</group>
		<group>ExpenseItem</group>
		<group>InitialCharacteristic</group>
	</totalField>
	<totalField>
		<dataPath>ItemizedVariable</dataPath>
		<expression>Sum(InitialArticleByArticleVariables)</expression>
		<group>DimensionOfExpenses</group>
		<group>SourceReceiptDocument</group>
		<group>SourceProducts_</group>
		<group>ExpenseItem</group>
		<group>InitialCharacteristic</group>
	</totalField>
	<totalField>
		<dataPath>AddExpensesForGoods</dataPath>
		<expression>Sum(InitialAdditionalCosts)</expression>
		<group>DimensionOfExpenses</group>
		<group>SourceReceiptDocument</group>
		<group>SourceProducts_</group>
		<group>ExpenseItem</group>
		<group>InitialCharacteristic</group>
	</totalField>
	<totalField>
		<dataPath>CostOfProductionTotal</dataPath>
		<expression>Sum(InitialMaterialCosts) + Sum(InitialArticleByArticleConstants) + Sum(InitialArticleByArticleVariables) + Sum(InitialAdditionalCosts)</expression>
		<group>DimensionOfExpenses</group>
		<group>SourceReceiptDocument</group>
		<group>SourceProducts_</group>
		<group>ExpenseItem</group>
		<group>InitialCharacteristic</group>
	</totalField>
	<totalField>
		<dataPath>ProvisionForImpairment</dataPath>
		<expression>Case
    When Sum(ProvisionForImpairment) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ProvisionForImpairment), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ProvisionForImpairment)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ExciseTaxAmount</dataPath>
		<expression>Case
    When Sum(ExciseTaxAmount) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ExciseTaxAmount), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ExciseTaxAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CostOfProductionTotal</dataPath>
		<expression>Sum(InitialCostOfProduction)</expression>
		<group>ProductCostElementArticle</group>
	</totalField>
