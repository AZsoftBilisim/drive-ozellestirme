		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED TOP 0
	0 AS DataSet,
	Table.Recorder AS Recorder,
	DATETIME(1, 1, 1) AS SecondPeriod,
	DATETIME(1, 1, 1) AS DayPeriod,
	DATETIME(1, 1, 1) AS WeekPeriod,
	DATETIME(1, 1, 1) AS TenDaysPeriod,
	DATETIME(1, 1, 1) AS MonthPeriod,
	DATETIME(1, 1, 1) AS QuarterPeriod,
	DATETIME(1, 1, 1) AS HalfYearPeriod,
	DATETIME(1, 1, 1) AS YearPeriod,
	0 AS Count,
	0 AS Revenue,
	0 AS VATRevenue,
	0 AS ManualDiscount,
	0 AS DiscountMarkupAmount,
	0 AS TotalOfDiscounts,
	0 AS Cost_,
	0 AS AddExpensesForGoods,
	0 AS ExciseTaxAmount,
	0 AS LaborCosts,
	0 AS ItemizedFixed,
	0 AS ItemizedVariable,
	0 AS SellingExpenses_,
	0 AS ProvisionForImpairment,
	0 AS Cost_Preliminary,
	0 AS CostDeviation_,
	0 AS GrossProfit,
	0 AS Profitability,
	TRUE AS IntercompanySales,
	Table.ItemsLocationAttributes AS ItemsLocationAttributes,
	Table.ItemsLocationAttributes.Products AS Products,
	Table.ItemsLocationAttributes.Products.UnitOfMeasure AS StorageUnit,
	Table.ItemsLocationAttributes.Products.UnitForReports AS UnitForReports,
	Table.ItemsLocationAttributes.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight1 AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem1 AS ProductsVolume,
	Table.ItemsLocationAttributes.Products.AnalyticalGroup AS AnalyticalGroup,
	Table.ItemsLocationAttributes.Characteristic AS Characteristic,
	Table.ItemsLocationAttributes.Series AS Series,
	Table.AccountingDimensionByPartners.Organization AS Organization,
	Table.AccountingDimensionByPartners.Organization AS Seller,
	Table.AccountingDimensionByPartners.Partner AS Partner,
	Table.SalesOrder AS SalesOrder,
	Table.Department AS Department,
	Table.ItemsLocationAttributes.StorageLocation AS Warehouse,
	Table.AccountingDimensionByPartners.Counterparty AS Counterparty,
	Table.AccountingDimensionByPartners.Counterparty AS Customer,
	Table.AccountingDimensionByPartners.Counterparty AS Vendor,
	VALUE(Catalog.Users.EmptyRef) AS Manager,
	VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef) AS SalesOpportunity,
	VALUE(Catalog.Users.EmptyRef) AS OpportunityManager,
	Table.InventoryType AS InventoryType,
	Table.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	Table.AccountingSection AS AccountingSection,
	Table.Lot AS Lot,
	Table.LotVendorAttributes AS LotVendorAttributes,
	Table.FinancialAccountingDimension AS FinancialAccountingDimension,
	Table.VATActivityType AS VATActivityType,
	Table.InventoryOwnerAttribute.FinancialAccountingGroup AS FinancialAccountingGroup,
	UNDEFINED AS SalesOpportunityKind,
	Table.CounterpartyLineOfBusiness AS CounterpartyLineOfBusiness,
	Table.ProductLineOfBusiness AS ProductLineOfBusiness,
	Table.Terms AS Terms,
	Table.SetAccountingDimension AS SetAccountingDimension,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	Table.BusinessOperation AS BusinessOperation,
	Table.VATRate AS VATRate,
	Table.AdjustmentPeriod_ AS AdjustmentPeriod_,
	0 AS QuantityForDetail,
	UNDEFINED AS PartyDetail,
	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS AnalysisOfAccountingAndDetailing,
	VALUE(Catalog.Companies.EmptyRef) AS OrganizationDetail,
	VALUE(Catalog.InventoryKinds.EmptyRef) AS TypeAndDetail,
	VALUE(Catalog.Products.EmptyRef) AS ProductDetailing,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS CharacteristicDetail,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	UNDEFINED AS DimensionOfExpenses,
	VALUE(Enum.AssetKinds.EmptyRef) AS AssetTaxClass,
	UNDEFINED AS LotVendorAttributesOfReceiptDocument,
	VALUE(Catalog.Products.EmptyRef) AS InventoryLocationAttributesOfReceiptDocument,
	VALUE(Catalog.Products.EmptyRef) AS SourceProducts_,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS InitialCharacteristic,
	UNDEFINED AS SourceReceiptDocument,

	
	0 AS InitialMaterialCosts,
	0 AS InitialArticleByArticleConstants,
	0 AS InitialArticleByArticleVariables,
	0 AS InitialAdditionalCosts,
	0 AS LotQuantity
{SELECT
	SalesOrder.*,
	SalesOpportunity.*,
	OpportunityManager,
	Department.*,
	ItemsLocationAttributes.*,
	Products.*,
	Characteristic.*,
	Warehouse.*,
	Organization.*,
	Seller.*,
	Partner.*,
	Counterparty.*,
	Customer.*,
	Vendor.*,
	Manager.*,
	InventoryOwnerAttribute.*,
	FinancialAccountingGroup.*,
	Recorder,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	SalesOpportunityKind,
	CounterpartyLineOfBusiness.*,
	ProductLineOfBusiness.*,
	Terms.*,
	SetAccountingDimension.*,
	BusinessOperation.*,
	VATRate,
	AdjustmentPeriod_}
FROM
	AccumulationRegister.RevenueAndCOGS AS Table
{WHERE
	((Table.ItemsLocationAttributes.Products, Table.ItemsLocationAttributes.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(Table.AccountingDimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	(Table.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod),
	(DATETIME(1, 1, 1)) AS DayPeriod,
	(DATETIME(1, 1, 1)) AS WeekPeriod,
	(DATETIME(1, 1, 1)) AS TenDaysPeriod,
	(DATETIME(1, 1, 1)) AS MonthPeriod,
	(DATETIME(1, 1, 1)) AS QuarterPeriod,
	(DATETIME(1, 1, 1)) AS HalfYearPeriod,
	(DATETIME(1, 1, 1)) AS YearPeriod,
	
	Table.Recorder.* AS Recorder,
	Table.ItemsLocationAttributes.* AS ItemsLocationAttributes,
	Table.ItemsLocationAttributes.Products.* AS Products,
	Table.ItemsLocationAttributes.Products.UnitOfMeasure.* AS StorageUnit,
	Table.ItemsLocationAttributes.Products.UnitForReports.* AS UnitForReports,
	Table.ItemsLocationAttributes.Products.UnitFactorForReports.* AS UnitFactorForReports,
	0 AS ProductsWeight,
	0 AS ProductsVolume,
	Table.ItemsLocationAttributes.Products.AnalyticalGroup.* AS AnalyticalGroup,
	Table.ItemsLocationAttributes.Characteristic.* AS Characteristic,
	Table.ItemsLocationAttributes.Series.* AS Series,
	Table.AccountingDimensionByPartners.Organization.* AS Organization,
	Table.AccountingDimensionByPartners.Organization.* AS Seller,
	Table.AccountingDimensionByPartners.Partner.* AS Partner,
	Table.SalesOrder.* AS SalesOrder,
	Table.Department.* AS Department,
	Table.ItemsLocationAttributes.StorageLocation.* AS Warehouse,
	Table.AccountingDimensionByPartners.Counterparty.* AS Counterparty,
	Table.AccountingDimensionByPartners.Counterparty.* AS Customer,
	Table.AccountingDimensionByPartners.Counterparty.* AS Vendor,
	Table.Contract.* AS Contract,
	(VALUE(Catalog.Users.EmptyRef)).* AS Manager,
	(VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)).* AS SalesOpportunity,
	(VALUE(Catalog.Users.EmptyRef)).* AS OpportunityManager,
	Table.InventoryType AS InventoryType,
	Table.InventoryOwnerAttribute.* AS InventoryOwnerAttribute,
	Table.AccountingSection.* AS AccountingSection,
	Table.Lot.* AS Lot,
	Table.LotVendorAttributes.* AS LotVendorAttributes,
	Table.FinancialAccountingDimension.* AS FinancialAccountingDimension,
	Table.VATActivityType.* AS VATActivityType,
	Table.InventoryOwnerAttribute.FinancialAccountingGroup.* AS FinancialAccountingGroup,
	UNDEFINED AS SalesOpportunityKind,
	Table.CounterpartyLineOfBusiness.* AS CounterpartyLineOfBusiness,
	Table.ProductLineOfBusiness.* AS ProductLineOfBusiness,
	Table.Terms.* AS Terms,
	Table.SetAccountingDimension.* AS SetAccountingDimension,
	(VALUE(Catalog.Currencies.EmptyRef)).* AS Currency,
	Table.BusinessOperation.* AS BusinessOperation,
	Table.VATRate AS VATRate,
	Table.AdjustmentPeriod_ AS AdjustmentPeriod_,
	0 AS QuantityForDetail,
	0 AS Count,
	0 AS Revenue,
	0 AS VATRevenue,
	0 AS ManualDiscount,
	0 AS DiscountMarkupAmount,
	0 AS TotalOfDiscounts,
	0 AS Cost_,
	0 AS AddExpensesForGoods,
	0 AS ExciseTaxAmount,
	0 AS LaborCosts,
	0 AS ItemizedFixed,
	0 AS ItemizedVariable,
	0 AS SellingExpenses_,
	0 AS Cost_Preliminary,
	0 AS CostDeviation_,
	0 AS GrossProfit,
	0 AS Profitability,
	TRUE AS IntercompanySales,
	UNDEFINED AS PartyDetail,
	(VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)).* AS AnalysisOfAccountingAndDetailing,
	(VALUE(Catalog.Companies.EmptyRef)).* AS OrganizationDetail,
	(VALUE(Catalog.InventoryKinds.EmptyRef)).* AS TypeAndDetail,
	(VALUE(Catalog.Products.EmptyRef)).* AS ProductDetailing,
	(VALUE(Catalog.ItemsCharacteristics.EmptyRef)).* AS CharacteristicDetail,
	(VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)).* AS ExpenseItem,
	UNDEFINED AS DimensionOfExpenses,
	(VALUE(Enum.AssetKinds.EmptyRef)).* AS AssetTaxClass,
	UNDEFINED AS LotVendorAttributesOfReceiptDocument,
	(VALUE(Catalog.Products.EmptyRef)).* AS InventoryLocationAttributesOfReceiptDocument,
	(VALUE(Catalog.Products.EmptyRef)).* AS SourceProducts_,
	(VALUE(Catalog.ItemsCharacteristics.EmptyRef)).* AS InitialCharacteristic,
	Table.Recorder.*  AS SourceReceiptDocument,

	
	0 AS InitialMaterialCosts,
	0 AS InitialArticleByArticleConstants,
	0 AS InitialArticleByArticleVariables,
	0 AS InitialAdditionalCosts,
	0 AS LotQuantity
}</query>
	</dataSet>
