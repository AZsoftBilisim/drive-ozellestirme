		<field xsi:type="DataSetFieldField">
			<dataPath>SubAssetComponent</dataPath>
			<field>SubAssetComponent</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CGUCompositionSliceLast.NonCurrentAsset AS NonCurrentAsset,
	CGUCompositionSliceLast.Organization AS Organization,
	CGUCompositionSliceLast.CGU AS CGU
INTO CGUCompositionAsOfDateByRegister
FROM
	InformationRegister.CGUComposition.SliceLast(ENDOFPERIOD(&amp;Date, DAY), {(Organization).*, (NonCurrentAsset).*}) AS CGUCompositionSliceLast

INDEX BY
	NonCurrentAsset,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CGUCompositionAsOfDateByRegister.Organization AS Organization,
	SubAssetsComponentsOfDepreciationSliceLast.SubAssetComponent AS SubAssetComponent,
	CGUCompositionAsOfDateByRegister.CGU AS CGUOfComponentOwner
INTO SEGDSComponents
FROM
	CGUCompositionAsOfDateByRegister AS CGUCompositionAsOfDateByRegister
		INNER JOIN InformationRegister.SubAssetsComponentsOfDepreciation.SliceLast(ENDOFPERIOD(&amp;Date, DAY), {(SubAssetComponent).*}) AS SubAssetsComponentsOfDepreciationSliceLast
		ON CGUCompositionAsOfDateByRegister.NonCurrentAsset = SubAssetsComponentsOfDepreciationSliceLast.FixedAsset
		LEFT JOIN CGUCompositionAsOfDateByRegister AS FilterByCGUCompositionOnDateByCase
		ON (FilterByCGUCompositionOnDateByCase.NonCurrentAsset = SubAssetsComponentsOfDepreciationSliceLast.SubAssetComponent)
WHERE
	FilterByCGUCompositionOnDateByCase.NonCurrentAsset IS NULL
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CGUCompositionAsOfDateByRegister.NonCurrentAsset AS NonCurrentAsset,
	CGUCompositionAsOfDateByRegister.Organization AS Organization,
	CGUCompositionAsOfDateByRegister.CGU AS CGU
INTO CompositionOfCGUAsOfDate
FROM
	CGUCompositionAsOfDateByRegister AS CGUCompositionAsOfDateByRegister

UNION

SELECT
	SEGDSComponents.SubAssetComponent,
	SEGDSComponents.Organization,
	SEGDSComponents.CGUOfComponentOwner
FROM
	SEGDSComponents AS SEGDSComponents

INDEX BY
	NonCurrentAsset,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ImpairmentFABalanceAndTurnovers.NonCurrentAsset AS NonCurrentAsset,
	ImpairmentFABalanceAndTurnovers.CGU AS CGU,
	ImpairmentFABalanceAndTurnovers.Organization AS Organization,
	-ImpairmentFABalanceAndTurnovers.ImpairmentLocalAssetsClosingBalance AS ImpairmentAC,
	-ImpairmentFABalanceAndTurnovers.ImpairmenManClosingBalance AS ImpairmentMA
INTO ImpairmentOfVNAAtDate
FROM
	AccumulationRegister.ImpairmentFA.BalanceAndTurnovers(&amp;Date, &amp;Date, , RegisterRecordsAndPeriodBoundaries, {(Organization).*, (CGU).*, (NonCurrentAsset).*}) AS ImpairmentFABalanceAndTurnovers
WHERE
	(ImpairmentFABalanceAndTurnovers.ImpairmentLocalAssetsClosingBalance &lt;&gt; 0
			OR ImpairmentFABalanceAndTurnovers.ImpairmenManClosingBalance &lt;&gt; 0)

INDEX BY
	NonCurrentAsset,
	CGU,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ImpairmentOfVNAAtDate.NonCurrentAsset AS NonCurrentAssetWithImpairment
INTO BNASImpairmentBalances
FROM
	ImpairmentOfVNAAtDate AS ImpairmentOfVNAAtDate

INDEX BY
	NonCurrentAssetWithImpairment
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	AccrualOfImpairment.NonCurrentAsset AS NonCurrentAsset,
	AccrualOfImpairment.Organization AS Organization,
	SUM(AccrualOfImpairment.AccruedImpairmentOfAC) AS AccruedImpairmentOfAC,
	SUM(AccrualOfImpairment.AccruedImpairmentOfMa) AS AccruedImpairmentOfMa
INTO AccruedImpairment
FROM
	(SELECT
		ImpairmentFA.NonCurrentAsset AS NonCurrentAsset,
		ImpairmentFA.Organization AS Organization,
		ImpairmentFA.ImpairmentLocalAssets AS AccruedImpairmentOfAC,
		ImpairmentFA.ImpairmenMan AS AccruedImpairmentOfMa
	FROM
		AccumulationRegister.ImpairmentFA AS ImpairmentFA
			INNER JOIN BNASImpairmentBalances AS BNASImpairmentBalances
			ON ImpairmentFA.NonCurrentAsset = BNASImpairmentBalances.NonCurrentAssetWithImpairment
	WHERE
		ImpairmentFA.Period &lt;= &amp;Date
		AND ImpairmentFA.BusinessTransactionSetting IN(&amp;BusinessTransactionSettingsImpairmentCharge)
		AND ImpairmentFA.RecordType = VALUE(AccumulationRecordType.Expense)
	
	UNION ALL
	
	SELECT
		ImpairmentFA.NonCurrentAsset,
		ImpairmentFA.Organization,
		-ImpairmentFA.ImpairmentLocalAssets * CASE
			WHEN ImpairmentFA.RecordType = VALUE(AccumulationRecordType.Expense)
				THEN -1
			ELSE 1
		END,
		-ImpairmentFA.ImpairmenMan * CASE
			WHEN ImpairmentFA.RecordType = VALUE(AccumulationRecordType.Expense)
				THEN -1
			ELSE 1
		END
	FROM
		AccumulationRegister.ImpairmentFA AS ImpairmentFA
			INNER JOIN BNASImpairmentBalances AS BNASImpairmentBalances
			ON ImpairmentFA.NonCurrentAsset = BNASImpairmentBalances.NonCurrentAssetWithImpairment
	WHERE
		ImpairmentFA.Period &lt;= &amp;Date
		AND ImpairmentFA.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.ReclassificationOfFA)) AS AccrualOfImpairment

GROUP BY
	AccrualOfImpairment.NonCurrentAsset,
	AccrualOfImpairment.Organization

INDEX BY
	AccrualOfImpairment.NonCurrentAsset,
	AccrualOfImpairment.Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	AccruedImpairment.NonCurrentAsset AS NonCurrentAsset,
	AccruedImpairment.Organization AS Organization,
	ISNULL(AccruedImpairment.AccruedImpairmentOfAC, 0) + ISNULL(ImpairmentFABalanceAndTurnovers.ImpairmentLocalAssetsClosingBalance, 0) AS ACImpairmentAdjustment,
	ISNULL(AccruedImpairment.AccruedImpairmentOfMa, 0) + ISNULL(ImpairmentFABalanceAndTurnovers.ImpairmenManClosingBalance, 0) AS AdjustmentOfMaImpairment
INTO AccumulatedImpairmentAdjustment
FROM
	BNASImpairmentBalances AS BNASImpairmentBalances
		INNER JOIN AccruedImpairment AS AccruedImpairment
			LEFT JOIN AccumulationRegister.ImpairmentFA.BalanceAndTurnovers(&amp;Date, &amp;Date, , RegisterRecordsAndPeriodBoundaries, {(Organization).*, (NonCurrentAsset).*}) AS ImpairmentFABalanceAndTurnovers
			ON AccruedImpairment.NonCurrentAsset = ImpairmentFABalanceAndTurnovers.NonCurrentAsset
				AND AccruedImpairment.Organization = ImpairmentFABalanceAndTurnovers.Organization
		ON BNASImpairmentBalances.NonCurrentAssetWithImpairment = AccruedImpairment.NonCurrentAsset

INDEX BY
	NonCurrentAsset,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CostOfVNAOnDate.NonCurrentAsset AS NonCurrentAsset,
	CostOfVNAOnDate.Organization AS Organization,
	SUM(CostOfVNAOnDate.CostInManagementAccounting) AS CostInManagementAccounting,
	SUM(CostOfVNAOnDate.CostInAccounting) AS CostInAccounting
INTO CostOfVNAOnDate
FROM
	(SELECT
		FACostBalanceAndTurnovers.FixedAsset AS NonCurrentAsset,
		FACostBalanceAndTurnovers.Organization AS Organization,
		FACostBalanceAndTurnovers.CostClosingBalance AS CostInManagementAccounting,
		FACostBalanceAndTurnovers.LocalCostClosingBalance + FACostBalanceAndTurnovers.CostTargetFinancingClosingBalance AS CostInAccounting
	FROM
		AccumulationRegister.FACost.BalanceAndTurnovers(ENDOFPERIOD(&amp;Date, DAY), ENDOFPERIOD(&amp;Date, DAY), Period, RegisterRecordsAndPeriodBoundaries, {(Organization).*, (FixedAsset).* AS NonCurrentAsset}) AS FACostBalanceAndTurnovers
	
	UNION
	
	SELECT
		IACostBalanceAndTurnovers.IntangibleAsset,
		IACostBalanceAndTurnovers.Organization,
		IACostBalanceAndTurnovers.CostClosingBalance,
		IACostBalanceAndTurnovers.LocalCostClosingBalance + IACostBalanceAndTurnovers.CostTargetFinancingClosingBalance
	FROM
		AccumulationRegister.IACost.BalanceAndTurnovers(ENDOFPERIOD(&amp;Date, DAY), ENDOFPERIOD(&amp;Date, DAY), Period, RegisterRecordsAndPeriodBoundaries, {(Organization).*, (IntangibleAsset).* AS NonCurrentAsset}) AS IACostBalanceAndTurnovers
	
	UNION
	
	SELECT
		CompositionOfCGUAsOfDate.NonCurrentAsset,
		CompositionOfCGUAsOfDate.Organization,
		0,
		0
	FROM
		CompositionOfCGUAsOfDate AS CompositionOfCGUAsOfDate) AS CostOfVNAOnDate

GROUP BY
	CostOfVNAOnDate.NonCurrentAsset,
	CostOfVNAOnDate.Organization

INDEX BY
	NonCurrentAsset,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	FixedAssetsDepreciationChargeBalanceAndTurnovers.FixedAsset AS NonCurrentAsset,
	FixedAssetsDepreciationChargeBalanceAndTurnovers.Organization AS Organization,
	-FixedAssetsDepreciationChargeBalanceAndTurnovers.DepreciationClosingBalance AS DepreciationManagementAccounting,
	-(FixedAssetsDepreciationChargeBalanceAndTurnovers.DepreciationLocalClosingBalance + FixedAssetsDepreciationChargeBalanceAndTurnovers.FixedAssetDepreciationTargetFinancingClosingBalance) AS DepreciationInAccounting
INTO DepreciationOfVNA
FROM
	AccumulationRegister.FixedAssetsDepreciationCharge.BalanceAndTurnovers(&amp;Date, &amp;Date, , RegisterRecordsAndPeriodBoundaries, {(Organization).*, (FixedAsset).* AS NonCurrentAsset}) AS FixedAssetsDepreciationChargeBalanceAndTurnovers

UNION ALL

SELECT
	IntangibleAssetsAmortizationChargeBalanceAndTurnovers.IntangibleAsset,
	IntangibleAssetsAmortizationChargeBalanceAndTurnovers.Organization,
	-IntangibleAssetsAmortizationChargeBalanceAndTurnovers.DepreciationClosingBalance,
	-(IntangibleAssetsAmortizationChargeBalanceAndTurnovers.DepreciationLocalClosingBalance + IntangibleAssetsAmortizationChargeBalanceAndTurnovers.FixedAssetDepreciationTargetFinancingClosingBalance)
FROM
	AccumulationRegister.IntangibleAssetsAmortizationCharge.BalanceAndTurnovers(&amp;Date, &amp;Date, , RegisterRecordsAndPeriodBoundaries, {(Organization).*, (IntangibleAsset).* AS NonCurrentAsset}) AS IntangibleAssetsAmortizationChargeBalanceAndTurnovers

INDEX BY
	NonCurrentAsset,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CostOfVNAOnDate.NonCurrentAsset AS NonCurrentAsset,
	CompositionOfCGUAsOfDate.CGU AS CGU,
	CostOfVNAOnDate.Organization AS Organization,
	ISNULL(CostOfVNAOnDate.CostInManagementAccounting, 0) AS CostInManagementAccounting,
	ISNULL(CostOfVNAOnDate.CostInAccounting, 0) AS CostInAccounting,
	ISNULL(DepreciationOfVNA.DepreciationManagementAccounting, 0) AS DepreciationManagementAccounting,
	ISNULL(DepreciationOfVNA.DepreciationInAccounting, 0) AS DepreciationInAccounting,
	ISNULL(AccruedImpairment.AccruedImpairmentOfMa, 0) AS AccruedImpairmentOfMa,
	ISNULL(AccruedImpairment.AccruedImpairmentOfAC, 0) AS AccruedImpairmentOfAC,
	ISNULL(AccumulatedImpairmentAdjustment.AdjustmentOfMaImpairment, 0) AS AdjustmentOfMaImpairment,
	ISNULL(AccumulatedImpairmentAdjustment.ACImpairmentAdjustment, 0) AS ACImpairmentAdjustment
INTO CostOfVNAsAmortizationOfIEGDS
FROM
	CostOfVNAOnDate AS CostOfVNAOnDate
		LEFT JOIN DepreciationOfVNA AS DepreciationOfVNA
		ON CostOfVNAOnDate.NonCurrentAsset = DepreciationOfVNA.NonCurrentAsset
			AND CostOfVNAOnDate.Organization = DepreciationOfVNA.Organization
		LEFT JOIN CompositionOfCGUAsOfDate AS CompositionOfCGUAsOfDate
		ON CostOfVNAOnDate.NonCurrentAsset = CompositionOfCGUAsOfDate.NonCurrentAsset
			AND CostOfVNAOnDate.Organization = CompositionOfCGUAsOfDate.Organization
		LEFT JOIN AccruedImpairment AS AccruedImpairment
		ON CostOfVNAOnDate.NonCurrentAsset = AccruedImpairment.NonCurrentAsset
			AND CostOfVNAOnDate.Organization = AccruedImpairment.Organization
		LEFT JOIN AccumulatedImpairmentAdjustment AS AccumulatedImpairmentAdjustment
		ON CostOfVNAOnDate.NonCurrentAsset = AccumulatedImpairmentAdjustment.NonCurrentAsset
			AND CostOfVNAOnDate.Organization = AccumulatedImpairmentAdjustment.Organization

INDEX BY
	NonCurrentAsset,
	CGU,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CostWithDepreciationAndImpairmentOnCGU.NonCurrentAsset AS NonCurrentAsset,
	ISNULL(CostWithDepreciationAndImpairmentOnCGU.CGU, VALUE(Catalog.CashGeneratingUnits.EmptyRef)) AS CGU,
	CostWithDepreciationAndImpairmentOnCGU.Organization AS Organization,
	SUM(CostWithDepreciationAndImpairmentOnCGU.CostInManagementAccounting) AS CostInManagementAccounting,
	SUM(CostWithDepreciationAndImpairmentOnCGU.CostInAccounting) AS CostInAccounting,
	SUM(CostWithDepreciationAndImpairmentOnCGU.DepreciationManagementAccounting) - SUM(CostWithDepreciationAndImpairmentOnCGU.AdjustmentOfMaImpairment) AS DepreciationManagementAccounting,
	SUM(CostWithDepreciationAndImpairmentOnCGU.DepreciationInAccounting) - SUM(CostWithDepreciationAndImpairmentOnCGU.ACImpairmentAdjustment) AS DepreciationInAccounting,
	SUM(CostWithDepreciationAndImpairmentOnCGU.AccruedImpairmentOfMa) AS AccruedImpairmentOfMa,
	SUM(CostWithDepreciationAndImpairmentOnCGU.AccruedImpairmentOfAC) AS AccruedImpairmentOfAC,
	SUM(CostWithDepreciationAndImpairmentOnCGU.AdjustmentOfMaImpairment) AS AdjustmentOfMaImpairment,
	SUM(CostWithDepreciationAndImpairmentOnCGU.ACImpairmentAdjustment) AS ACImpairmentAdjustment,
	SUM(CostWithDepreciationAndImpairmentOnCGU.ImpairmentMA) AS ImpairmentMA,
	SUM(CostWithDepreciationAndImpairmentOnCGU.ImpairmentAC) AS ImpairmentAC
INTO CostAndImpairmentOfSegmentsAtDate
FROM
	(SELECT
		CostWithDepreciation.NonCurrentAsset AS NonCurrentAsset,
		CostWithDepreciation.CGU AS CGU,
		CostWithDepreciation.Organization AS Organization,
		CostWithDepreciation.CostInManagementAccounting AS CostInManagementAccounting,
		CostWithDepreciation.CostInAccounting AS CostInAccounting,
		CostWithDepreciation.DepreciationManagementAccounting AS DepreciationManagementAccounting,
		CostWithDepreciation.DepreciationInAccounting AS DepreciationInAccounting,
		CostWithDepreciation.AccruedImpairmentOfMa AS AccruedImpairmentOfMa,
		CostWithDepreciation.AccruedImpairmentOfAC AS AccruedImpairmentOfAC,
		CostWithDepreciation.AdjustmentOfMaImpairment AS AdjustmentOfMaImpairment,
		CostWithDepreciation.ACImpairmentAdjustment AS ACImpairmentAdjustment,
		ISNULL(Impairment.ImpairmentMA, 0) AS ImpairmentMA,
		ISNULL(Impairment.ImpairmentAC, 0) AS ImpairmentAC
	FROM
		CostOfVNAsAmortizationOfIEGDS AS CostWithDepreciation
			LEFT JOIN ImpairmentOfVNAAtDate AS Impairment
			ON CostWithDepreciation.NonCurrentAsset = Impairment.NonCurrentAsset
				AND CostWithDepreciation.CGU = Impairment.CGU
				AND CostWithDepreciation.Organization = Impairment.Organization
	
	UNION ALL
	
	SELECT
		Impairment.NonCurrentAsset,
		Impairment.CGU,
		Impairment.Organization,
		0,
		0,
		0,
		0,
		0,
		0,
		0,
		0,
		Impairment.ImpairmentMA,
		Impairment.ImpairmentAC
	FROM
		ImpairmentOfVNAAtDate AS Impairment
			LEFT JOIN CostOfVNAsAmortizationOfIEGDS AS CostWithDepreciation
			ON (CostWithDepreciation.NonCurrentAsset = Impairment.NonCurrentAsset)
				AND (CostWithDepreciation.CGU = Impairment.CGU)
				AND (CostWithDepreciation.Organization = Impairment.Organization)
	WHERE
		CostWithDepreciation.NonCurrentAsset IS NULL) AS CostWithDepreciationAndImpairmentOnCGU

GROUP BY
	CostWithDepreciationAndImpairmentOnCGU.NonCurrentAsset,
	ISNULL(CostWithDepreciationAndImpairmentOnCGU.CGU, VALUE(Catalog.CashGeneratingUnits.EmptyRef)),
	CostWithDepreciationAndImpairmentOnCGU.Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CostAndImpairmentOfSegmentsAtDate.Organization AS Organization,
	CostAndImpairmentOfSegmentsAtDate.CGU AS CGU,
	CASE
		WHEN CostAndImpairmentOfSegmentsAtDate.NonCurrentAsset REFS Catalog.Assets
			THEN CostAndImpairmentOfSegmentsAtDate.NonCurrentAsset.AssetID
		ELSE CostAndImpairmentOfSegmentsAtDate.NonCurrentAsset.Code
	END AS InventoryNumberCode,
	CostAndImpairmentOfSegmentsAtDate.NonCurrentAsset AS NonCurrentAsset,
	"ACC" AS IndicatorAccounting,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.CostInAccounting, 0) - ISNULL(CostAndImpairmentOfSegmentsAtDate.DepreciationInAccounting, 0) - (ISNULL(CostAndImpairmentOfSegmentsAtDate.ImpairmentAC, 0) + ISNULL(CostAndImpairmentOfSegmentsAtDate.ACImpairmentAdjustment, 0)) AS CostInAccounting,
	CostAndImpairmentOfSegmentsAtDate.DepreciationInAccounting AS DepreciationInAccounting,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.ImpairmentAC, 0) + ISNULL(CostAndImpairmentOfSegmentsAtDate.ACImpairmentAdjustment, 0) AS ImpairmentAC,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.ACImpairmentAdjustment, 0) AS ACImpairmentAdjustment,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.ImpairmentAC, 0) AS ImpairmentToRestoreAC,
	"MA" AS MAIndicator,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.CostInManagementAccounting, 0) - ISNULL(CostAndImpairmentOfSegmentsAtDate.DepreciationManagementAccounting, 0) - (ISNULL(CostAndImpairmentOfSegmentsAtDate.ImpairmentMA, 0) + ISNULL(CostAndImpairmentOfSegmentsAtDate.AdjustmentOfMaImpairment, 0)) AS CostInManagementAccounting,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.DepreciationManagementAccounting, 0) AS DepreciationManagementAccounting,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.ImpairmentMA, 0) + ISNULL(CostAndImpairmentOfSegmentsAtDate.AdjustmentOfMaImpairment, 0) AS ImpairmentMA,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.AdjustmentOfMaImpairment, 0) AS AdjustmentOfMaImpairment,
	ISNULL(CostAndImpairmentOfSegmentsAtDate.ImpairmentMA, 0) AS ImpairmentToRestoreMa
FROM
	CostAndImpairmentOfSegmentsAtDate AS CostAndImpairmentOfSegmentsAtDate
WHERE
	(ISNULL(CostAndImpairmentOfSegmentsAtDate.ImpairmentAC, 0) &lt;&gt; 0
			OR ISNULL(CostAndImpairmentOfSegmentsAtDate.ImpairmentMA, 0) &lt;&gt; 0)

ORDER BY
	Organization,
	CGU,
	NonCurrentAsset</query>
	</dataSet>
