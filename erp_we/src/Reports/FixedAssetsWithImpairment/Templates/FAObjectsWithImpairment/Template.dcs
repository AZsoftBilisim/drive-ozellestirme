			<field>CGU</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Cash-generating unit</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>واحد مولد وجه نقد</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Unità generatrice di cassa</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Jednostka generujący środki pieniężne</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>ЕГДС</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>NYB (nakit yaratan birim)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đơn vị tạo tiền</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Presentation(Case
	When 
		CGU = Value(Catalog.CashGeneratingUnits.EmptyRef)  
	Then 
		NStr("ru = '&lt;Не входят в ЕГДС&gt;'; vi = '&lt;Không đưa vào đơn vị tạo tiền&gt;'; en = '&lt;Not included in cash-generating units&gt;'; it = '&lt;Non inclusi in unità generatrice di cassa&gt;'; pl = '&lt;Nie wchodzi do jednostki generującej środki pieniężne&gt;'; tr = '&lt;NYB''nin bir parçası değil&gt;'")
	Else 
		CGU
End
)</presentationExpression>
			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceParameterLinks</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameterLinks">
						<dcscor:item>
							<dcscor:choiceParameter>Filter.Owner</dcscor:choiceParameter>
							<dcscor:value>Organization</dcscor:value>
