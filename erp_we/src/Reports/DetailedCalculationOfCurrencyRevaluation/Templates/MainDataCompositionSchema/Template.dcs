	<calculatedField>
		<dataPath>TAAccrualIsRequired</dataPath>
		<expression>Case When AmountFA = 0 Or StartDateOfApplication67FL &gt; Period Then 0
    Else
        Case
            When (RevaluationSection = "CustomersARAPAccounting" 
                        Or RevaluationSection = "VendorsARAPAccounting"
                        Or RevaluationSection = "FinancialInstrumentsARAP")
                    And AmountFA &lt;&gt; Cast(Sum*LocalCourse/MultiplicityOfLocal, "Number(31,2)")
                Then Cast(Sum*LocalCourse/MultiplicityOfLocal, "Number(31,2)") - AmountFA
            Else
                0
        End
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
