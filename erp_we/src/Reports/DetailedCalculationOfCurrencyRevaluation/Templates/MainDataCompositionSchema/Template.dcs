			<field xsi:type="DataSetFieldField">
				<dataPath>ContractKind</dataPath>
				<field>ContractKind</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДоговорПодразделение</dataPath>
				<field>ДоговорПодразделение</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>
SELECT ALLOWED
	&amp;BeginOfPeriod AS Period,
	BEGINOFPERIOD(&amp;BeginOfPeriod, DAY) AS BalanceDate,
	UNDEFINED AS Recorder,
	InvestmentInRent.Currency AS Currency,
	InvestmentInRent.Organization AS Organization,
	InvestmentInRent.FixedAsset AS FixedAsset,
	InvestmentInRent.FinancialAccountingGroup AS FinancialAccountingGroup,
	Contracts.LineOfBusiness AS LineOfBusiness,
	Contracts.Department AS Department,
	Contracts.Partner AS Partner,
	Contracts.Counterparty AS Counterparty,
	InvestmentInRent.Contract AS Contract,
	ISNULL(Contracts.ContractRateOption,
			VALUE(Enum.ContractRateOptions.Mutable)) AS ContractRateOption,
	InvestmentInRent.RentalPaymentsBalance AS Sum,
	InvestmentInRent.RentalPaymentsManagBalance AS SumMan,
	InvestmentInRent.RentalPaymentsLocalBalance AS SumCompl,
	0 AS IncomeMan,
	0 AS ExpenseMan,
	0 AS IncomeCompl,
	0 AS ExpenseCompl
INTO TTBalancesAndRevolutions
FROM
	AccumulationRegister.InvestmentInRent.Balance(
			&amp;Period,
			Currency &lt;&gt; &amp;CurrencyOfMan
				OR Currency &lt;&gt; Organization.LocalAccountingCurrency {(Organization).*, (Contract.Department).*}) AS InvestmentInRent
	LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON InvestmentInRent.Contract = Contracts.Ref

UNION ALL

SELECT
	InvestmentInRent.Period AS Period,
	BEGINOFPERIOD(InvestmentInRent.Period, DAY) AS BalanceDate,
	InvestmentInRent.Recorder AS Recorder,
	InvestmentInRent.Currency AS Currency,
	InvestmentInRent.Organization AS Organization,
	InvestmentInRent.FixedAsset AS FixedAsset,
	InvestmentInRent.FinancialAccountingGroup AS FinancialAccountingGroup,
	Contracts.LineOfBusiness AS LineOfBusiness,
	Contracts.Department AS Department,
	Contracts.Partner AS Partner,
	Contracts.Counterparty AS Counterparty,
	InvestmentInRent.Contract AS Contract,
	ISNULL(Contracts.ContractRateOption,
			VALUE(Enum.ContractRateOptions.Mutable)) AS ContractRateOption,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InvestmentInRent.RentalPayments
		ELSE -InvestmentInRent.RentalPayments
	END AS Sum,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InvestmentInRent.RentalPaymentsManag
		ELSE -InvestmentInRent.RentalPaymentsManag
	END AS SumMan,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InvestmentInRent.RentalPaymentsLocal
		ELSE -InvestmentInRent.RentalPaymentsLocal
	END AS SumCompl,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(InvestmentInRent.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN InvestmentInRent.RentalPaymentsManag
		ELSE 0
	END AS IncomeMan,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(InvestmentInRent.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -InvestmentInRent.RentalPaymentsManag
		ELSE 0
	END AS ExpenseMan,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(InvestmentInRent.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN InvestmentInRent.RentalPaymentsLocal
		ELSE 0
	END AS IncomeCompl,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(InvestmentInRent.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -InvestmentInRent.RentalPaymentsLocal
		ELSE 0
	END AS ExpenseCompl
FROM
	AccumulationRegister.InvestmentInRent AS InvestmentInRent
	LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON InvestmentInRent.Contract = Contracts.Ref
WHERE
	InvestmentInRent.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND (InvestmentInRent.Currency &lt;&gt; &amp;CurrencyOfMan OR InvestmentInRent.Currency &lt;&gt; InvestmentInRent.Organization.LocalAccountingCurrency)
	AND (InvestmentInRent.RentalPayments &lt;&gt; 0 OR InvestmentInRent.RentalPaymentsLocal &lt;&gt; 0 OR InvestmentInRent.RentalPaymentsManag &lt;&gt; 0)
{WHERE
	InvestmentInRent.Recorder,
	InvestmentInRent.Organization.*,
	Contract.Department.*}

UNION ALL

SELECT
	&amp;BeginOfPeriod AS Period,
	BEGINOFPERIOD(&amp;BeginOfPeriod, DAY) AS BalanceDate,
	UNDEFINED AS Recorder,
	InvestmentInRent.Currency AS Currency,
	InvestmentInRent.Organization AS Organization,
	InvestmentInRent.FixedAsset AS FixedAsset,
	InvestmentInRent.FinancialAccountingGroup AS FinancialAccountingGroup,
	Contracts.LineOfBusiness AS LineOfBusiness,
	Contracts.Department AS Department,
	Contracts.Partner AS Partner,
	Contracts.Counterparty AS Counterparty,
	InvestmentInRent.Contract AS Contract,
	ISNULL(Contracts.ContractRateOption,
			VALUE(Enum.ContractRateOptions.Mutable)) AS ContractRateOption,
	InvestmentInRent.InterestDiscountBalance AS Sum,
	InvestmentInRent.InterestDiscountManBalance AS SumMan,
	InvestmentInRent.InterestDiscountLocalBalance AS SumCompl,
	0 AS IncomeMan,
	0 AS ExpenseMan,
	0 AS IncomeCompl,
	0 AS ExpenseCompl
FROM
	AccumulationRegister.InvestmentInRent.Balance(
			&amp;Period,
			Currency &lt;&gt; &amp;CurrencyOfMan
				OR Currency &lt;&gt; Organization.LocalAccountingCurrency {(Organization).*, (Contract.Department).*}) AS InvestmentInRent
	LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON InvestmentInRent.Contract = Contracts.Ref

UNION ALL

SELECT
	InvestmentInRent.Period AS Period,
	BEGINOFPERIOD(InvestmentInRent.Period, DAY) AS BalanceDate,
	InvestmentInRent.Recorder AS Recorder,
	InvestmentInRent.Currency AS Currency,
	InvestmentInRent.Organization AS Organization,
	InvestmentInRent.FixedAsset AS FixedAsset,
	InvestmentInRent.FinancialAccountingGroup AS FinancialAccountingGroup,
	Contracts.LineOfBusiness AS LineOfBusiness,
	Contracts.Department AS Department,
	Contracts.Partner AS Partner,
	Contracts.Counterparty AS Counterparty,
	InvestmentInRent.Contract AS Contract,
	ISNULL(Contracts.ContractRateOption,
			VALUE(Enum.ContractRateOptions.Mutable)) AS ContractRateOption,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InvestmentInRent.InterestDiscount
		ELSE -InvestmentInRent.InterestDiscount
	END AS Sum,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InvestmentInRent.InterestDiscountMan
		ELSE -InvestmentInRent.InterestDiscountMan
	END AS SumMan,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InvestmentInRent.InterestDiscountLocal
		ELSE -InvestmentInRent.InterestDiscountLocal
	END AS SumCompl,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(InvestmentInRent.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN InvestmentInRent.InterestDiscountMan
		ELSE 0
	END AS IncomeMan,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(InvestmentInRent.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -InvestmentInRent.InterestDiscountMan
		ELSE 0
	END AS ExpenseMan,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(InvestmentInRent.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN InvestmentInRent.InterestDiscountLocal
		ELSE 0
	END AS IncomeCompl,
	CASE
		WHEN InvestmentInRent.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(InvestmentInRent.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -InvestmentInRent.InterestDiscountLocal
		ELSE 0
	END AS ExpenseCompl
FROM
	AccumulationRegister.InvestmentInRent AS InvestmentInRent
	LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON InvestmentInRent.Contract = Contracts.Ref
WHERE
	InvestmentInRent.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND (InvestmentInRent.Currency &lt;&gt; &amp;CurrencyOfMan OR InvestmentInRent.Currency &lt;&gt; InvestmentInRent.Organization.LocalAccountingCurrency)
	AND (InvestmentInRent.InterestDiscount &lt;&gt; 0 OR InvestmentInRent.InterestDiscountLocal &lt;&gt; 0 OR InvestmentInRent.InterestDiscountMan &lt;&gt; 0)
{WHERE
	InvestmentInRent.Recorder,
	InvestmentInRent.Organization.*,
	Contract.Department.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceAndTurnovers.Period AS Period,
	BalanceAndTurnovers.BalanceDate AS BalanceDate,
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.FixedAsset AS Dimension,
	BalanceAndTurnovers.FixedAsset AS AccountingDimensionByPartners,
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Partner AS Partner,
	BalanceAndTurnovers.Counterparty AS Counterparty,
	BalanceAndTurnovers.Contract AS Contract,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	SUM(BalanceAndTurnovers.Sum) AS Sum,
	SUM(BalanceAndTurnovers.SumMan) AS SumMan,
	SUM(BalanceAndTurnovers.SumCompl) AS SumCompl,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END) AS SumManBefore,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END) AS SumComplBefore,
	SUM(BalanceAndTurnovers.IncomeMan) AS IncomeMan,
	SUM(BalanceAndTurnovers.ExpenseMan) AS ExpenseMan,
	SUM(BalanceAndTurnovers.IncomeCompl) AS IncomeCompl,
	SUM(BalanceAndTurnovers.ExpenseCompl) AS ExpenseCompl,
	UNDEFINED AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	BalanceAndTurnovers.ContractRateOption AS ContractRateOption,
	CASE WHEN BalanceAndTurnovers.ContractRateOption = VALUE(Enum.ContractRateOptions.SpecifiedInContract)
		THEN BalanceAndTurnovers.Contract
		ELSE UNDEFINED
	END AS ContractWithFixedCourse,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind,
	"InvestmentInRent" AS RevaluationSection,
	1000 AS ProcedureOfRevaluationSection
{SELECT
	RevaluationSection,
	Period,
	BalanceDate,
	Recorder,
	Currency.*,
	Dimension.*,
	Organization.*,
	LocalAccountingCurrency.*,
	Partner.*,
	Counterparty.*,
	Contract.*,
	LineOfBusiness.*,
	Sum,
	SumMan,
	SumCompl,
	SumManBefore,
	SumComplBefore,
	IncomeMan,
	ExpenseMan,
	IncomeCompl,
	ExpenseCompl,
	ContractRateOption,
	ContractWithFixedCourse,
	ContractKind
}
FROM
	TTBalancesAndRevolutions AS BalanceAndTurnovers
WHERE
	BalanceAndTurnovers.ContractRateOption &lt;&gt; VALUE(Enum.ContractRateOptions.FixedAsOfShipmentDate)
{WHERE
	"InvestmentInRent" AS RevaluationSection,
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.Counterparty AS Dimension,
	BalanceAndTurnovers.LineOfBusiness.*,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Department.*,
	BalanceAndTurnovers.Sum,
	BalanceAndTurnovers.SumMan,
	BalanceAndTurnovers.SumCompl,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END AS SumManBefore,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END AS SumComplBefore,
	BalanceAndTurnovers.IncomeCompl,
	BalanceAndTurnovers.ExpenseCompl,
	BalanceAndTurnovers.IncomeMan,
	BalanceAndTurnovers.ExpenseMan,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind}

GROUP BY
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.BalanceDate,
	BalanceAndTurnovers.Recorder,
	BalanceAndTurnovers.Currency,
	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.FixedAsset,
	BalanceAndTurnovers.Partner,
	BalanceAndTurnovers.Counterparty,
	BalanceAndTurnovers.Contract,
	BalanceAndTurnovers.LineOfBusiness,
	BalanceAndTurnovers.ContractRateOption,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency
	
UNION ALL

SELECT
	DATETIME(1, 1, 1) AS Period,
	DATETIME(1, 1, 1) AS BalanceDate,
	UNDEFINED AS Recorder,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	UNDEFINED AS Dimension,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.Currencies.EmptyRef) AS LocalAccountingCurrency,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef) AS Counterparty,
	VALUE(Catalog.CounterpartyContracts.EmptyRef) AS Contract,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	0.00 AS Sum,
	0.00 AS SumMan,
	0.00 AS SumCompl,
	0.00 AS SumManBefore,
	0.00 AS SumComplBefore,
	0.00 AS IncomeMan,
	0.00 AS ExpenseMan,
	0.00 AS IncomeCompl,
	0.00 AS ExpenseCompl,
	UNDEFINED AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	VALUE(Enum.ContractRateOptions.Mutable) AS ContractRateOption,
	UNDEFINED AS ContractWithFixedCourse,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind,
	"InvestmentInRent" AS RevaluationSection,
	1100 AS ProcedureOfRevaluationSection
WHERE
	FALSE

ORDER BY
	Period</query>
