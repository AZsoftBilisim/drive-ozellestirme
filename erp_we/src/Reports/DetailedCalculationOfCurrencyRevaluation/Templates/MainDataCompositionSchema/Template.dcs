		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ExchangeRateOfSettlementsUnderContractsCutOfLatest.Period AS Period,
	ISNULL(CounterpartyContracts.Organization.LocalAccountingCurrency, IntercompanyContracts.Organization.LocalAccountingCurrency) AS BaseCurrency,
	ISNULL(CounterpartyContracts.ARAPCurrency, IntercompanyContracts.ARAPCurrency) AS Currency,
	ExchangeRateOfSettlementsUnderContractsCutOfLatest.Contract AS Contract,
	ExchangeRateOfSettlementsUnderContractsCutOfLatest.CourseNumerator AS CourseNumerator,
	ExchangeRateOfSettlementsUnderContractsCutOfLatest.CourseDenominator AS CourseDenominator
INTO TTCourseOnContracts
FROM
	InformationRegister.ARAPAccountingExchangeRatesForContracts.SliceLast(&amp;EndOfPeriod {(&amp;EndOfPeriod)}, Contract = &amp;Contract) AS ExchangeRateOfSettlementsUnderContractsCutOfLatest
		LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON ExchangeRateOfSettlementsUnderContractsCutOfLatest.Contract = CounterpartyContracts.Ref
		LEFT JOIN Catalog.IntercompanyContracts AS IntercompanyContracts
		ON ExchangeRateOfSettlementsUnderContractsCutOfLatest.Contract = IntercompanyContracts.Ref
;

////////////////////////////////////////////////////////////////////////////////

SELECT
	&amp;DateOfCourse AS ExchangeRateDateManagFB,
	ExchangeRates.BaseCurrency AS BaseCurrencyOfManCoExchangeRate,
	ExchangeRates.Currency AS ExchangeRateCurrencyManagFB,
	UNDEFINED AS ContractManCO,
	ExchangeRates.CourseNumerator AS CourseManCo,
	ExchangeRates.CourseDenominator AS MultiplicityOfManCo
{SELECT
	ExchangeRateDateManagFB,
	BaseCurrencyOfManCoExchangeRate.*,
	ExchangeRateCurrencyManagFB.*,
	ContractManCO,
	CourseManCo,
	MultiplicityOfManCo}
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod {&amp;EndOfPeriod}, Currency = &amp;CurrencyOfMan AND BaseCurrency = &amp;BaseCurrency) AS ExchangeRates

UNION ALL

SELECT
	&amp;DateOfCourse AS ExchangeRateDateManagFB,
	ExchangeRates.BaseCurrency AS BaseCurrencyOfManCoExchangeRate,
	ExchangeRates.Currency AS ExchangeRateCurrencyManagFB,
	CourseOnContracts.Contract AS ContractManCO,
	CASE WHEN CourseOnContracts.BaseCurrency = &amp;BaseCurrency
	            AND CourseOnContracts.Currency = &amp;CurrencyOfMan
		THEN CourseOnContracts.CourseNumerator
		ELSE ExchangeRates.CourseNumerator
	END AS CourseManCo,
	CASE WHEN CourseOnContracts.BaseCurrency = &amp;BaseCurrency
	            AND CourseOnContracts.Currency = &amp;CurrencyOfMan
		THEN CourseOnContracts.CourseDenominator
		ELSE ExchangeRates.CourseDenominator
	END AS MultiplicityOfManCo
FROM
	TTCourseOnContracts AS CourseOnContracts,
	InformationRegister.RelativeExchangeRates.SliceLast(
			&amp;EndOfPeriod {(&amp;EndOfPeriod)},
			Currency = &amp;CurrencyOfMan
				AND BaseCurrency = &amp;BaseCurrency) AS ExchangeRates
</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
