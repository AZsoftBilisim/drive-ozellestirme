				<field xsi:type="DataSetFieldField">
					<dataPath>ContractKind</dataPath>
					<field>ContractKind</field>
				</field>
				<dataSource>DataSource1</dataSource>
				<query>

// !!! TAGS ARE USED !!!

SELECT ALLOWED
	&amp;BeginOfPeriod AS Period,
	BEGINOFPERIOD(&amp;BeginOfPeriod, DAY) AS BalanceDate,
	UNDEFINED AS Recorder,
	GoodsForRegistration.Currency AS Currency,
	GoodsForRegistration.Organization AS Organization,
	GoodsForRegistration.Products AS Products,
	GoodsForRegistration.Purpose AS Purpose,
	GoodsForRegistration.CCDNumber AS CCDNumber,
	GoodsForRegistration.DocumentAcquisitions AS DocumentAcquisitions,
	ISNULL(Contracts.Ref, UNDEFINED) AS Contract,
	ISNULL(Contracts.FinancialAccountingGroup, UNDEFINED) AS FinancialAccountingGroup,
	ISNULL(Contracts.ContractRateOption, UNDEFINED) AS ContractRateOption,
	ISNULL(Contracts.Counterparty, UNDEFINED) AS Counterparty,
	ISNULL(Contracts.Partner, UNDEFINED) AS Partner,
	ISNULL(Contracts.LineOfBusiness, UNDEFINED) AS LineOfBusiness,
	GoodsForRegistration.AmountIncludingVATBalance AS Sum,
	GoodsForRegistration.SumManBalance AS SumMan,
	GoodsForRegistration.SumComplBalance AS SumCompl,
	0 AS IncomeMan,
	0 AS ExpenseMan,
	0 AS IncomeCompl,
	0 AS ExpenseCompl
INTO TTBalancesAndRevolutions
FROM
	AccumulationRegister.GoodsAndServicesToRegisterPurchasingReportsToConsignor.Balance(
			&amp;Period,
			Currency &lt;&gt; &amp;CurrencyOfMan
				OR Currency &lt;&gt; Organization.LocalAccountingCurrency {(Organization).*, (Purpose).* AS Purpose, (Currency).* AS Currency}) AS GoodsForRegistration
	INNER JOIN Catalog.Assignments AS Assignments
		ON GoodsForRegistration.Purpose = Assignments.Ref
	LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON Assignments.Contract = Contracts.Ref
WHERE
	ISNULL(Contracts.RevalueGoodsAndServicesForConsignmentNotification, FALSE)

UNION ALL

SELECT
	GoodsForRegistration.Period,
	BEGINOFPERIOD(GoodsForRegistration.Period, DAY),
	GoodsForRegistration.Recorder,
	GoodsForRegistration.Currency AS Currency,
	GoodsForRegistration.Organization AS Organization,
	GoodsForRegistration.Products AS Products,
	GoodsForRegistration.Purpose AS Purpose,
	GoodsForRegistration.CCDNumber AS CCDNumber,
	GoodsForRegistration.DocumentAcquisitions AS DocumentAcquisitions,
	ISNULL(Contracts.Ref, UNDEFINED) AS Contract,
	ISNULL(Contracts.FinancialAccountingGroup, UNDEFINED) AS FinancialAccountingGroup,
	ISNULL(Contracts.ContractRateOption, UNDEFINED) AS ContractRateOption,
	ISNULL(Contracts.Counterparty, UNDEFINED) AS Counterparty,
	ISNULL(Contracts.Partner, UNDEFINED) AS Partner,
	ISNULL(Contracts.LineOfBusiness, UNDEFINED) AS LineOfBusiness,
	CASE
		WHEN GoodsForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN GoodsForRegistration.AmountIncludingVAT
		ELSE -GoodsForRegistration.AmountIncludingVAT
	END AS Sum,
	CASE
		WHEN GoodsForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN GoodsForRegistration.SumMan
		ELSE -GoodsForRegistration.SumMan
	END AS SumMan,
	CASE
		WHEN GoodsForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN GoodsForRegistration.SumCompl
		ELSE -GoodsForRegistration.SumCompl
	END AS SumCompl,
	CASE
		WHEN GoodsForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(GoodsForRegistration.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN GoodsForRegistration.SumMan
		ELSE 0
	END AS IncomeMan,
	CASE
		WHEN GoodsForRegistration.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(GoodsForRegistration.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -GoodsForRegistration.SumMan
		ELSE 0
	END AS ExpenseMan,
	CASE
		WHEN GoodsForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(GoodsForRegistration.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN GoodsForRegistration.SumCompl
		ELSE 0
	END AS IncomeCompl,
	CASE
		WHEN GoodsForRegistration.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(GoodsForRegistration.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -GoodsForRegistration.SumCompl
		ELSE 0
	END AS ExpenseCompl
FROM
	AccumulationRegister.GoodsAndServicesToRegisterPurchasingReportsToConsignor AS GoodsForRegistration
	INNER JOIN Catalog.Assignments AS Assignments
		ON GoodsForRegistration.Purpose = Assignments.Ref
	LEFT JOIN Catalog.CounterpartyContracts AS Contracts
		ON Assignments.Contract = Contracts.Ref
WHERE
	GoodsForRegistration.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND ISNULL(Contracts.RevalueGoodsAndServicesForConsignmentNotification, FALSE)
	AND (GoodsForRegistration.Currency &lt;&gt; &amp;CurrencyOfMan OR GoodsForRegistration.Currency &lt;&gt; GoodsForRegistration.Organization.LocalAccountingCurrency)
{WHERE
	GoodsForRegistration.Recorder,
	GoodsForRegistration.Organization.* AS Organization,
	GoodsForRegistration.Currency.* AS Currency}
;



////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceAndTurnovers.Period AS Period,
	BalanceAndTurnovers.BalanceDate AS BalanceDate,
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.Contract AS Dimension,
	UNDEFINED AS AccountingDimensionByPartners,


	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Partner AS Partner,
	BalanceAndTurnovers.Counterparty AS Counterparty,
	BalanceAndTurnovers.Contract AS Contract,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	UNDEFINED AS Department,
	SUM(BalanceAndTurnovers.Sum) AS Sum,
	SUM(BalanceAndTurnovers.SumMan) AS SumMan,
	SUM(BalanceAndTurnovers.SumCompl) AS SumCompl,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END) AS SumManBefore,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END) AS SumComplBefore,
	SUM(BalanceAndTurnovers.IncomeMan) AS IncomeMan,
	SUM(BalanceAndTurnovers.ExpenseMan) AS ExpenseMan,
	SUM(BalanceAndTurnovers.IncomeCompl) AS IncomeCompl,
	SUM(BalanceAndTurnovers.ExpenseCompl) AS ExpenseCompl,


	UNDEFINED AS ARAPObject,
	BalanceAndTurnovers.DocumentAcquisitions AS ARAPDocument,
	BalanceAndTurnovers.ContractRateOption AS ContractRateOption,
	CASE WHEN BalanceAndTurnovers.ContractRateOption = VALUE(Enum.ContractRateOptions.SpecifiedInContract)
		THEN BalanceAndTurnovers.Contract
		ELSE UNDEFINED
	END AS ContractWithFixedCourse,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind,
	"SettlementsWithCommittee" AS RevaluationSection,
	300 AS ProcedureOfRevaluationSection
{SELECT
	RevaluationSection,
	Period,
	BalanceDate,
	Recorder,
	Currency.*,
	Dimension.*,
	Contract.*,


	Organization.*,
	LocalAccountingCurrency.*,
	Partner.*,
	Counterparty.*,
	LineOfBusiness.*,
	Sum,
	SumMan,
	SumCompl,
	SumManBefore,
	SumComplBefore,
	IncomeCompl,
	ExpenseCompl,
	IncomeMan,
	ExpenseMan,
	ContractRateOption,
	ContractWithFixedCourse,
	ContractKind,
	ProcedureOfRevaluationSection}
FROM
	TTBalancesAndRevolutions AS BalanceAndTurnovers


	
{WHERE
	"SettlementsWithCommittee" AS RevaluationSection,
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.Contract.* AS Dimension,


	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.LineOfBusiness.*,
	BalanceAndTurnovers.Sum,
	BalanceAndTurnovers.SumMan,
	BalanceAndTurnovers.SumCompl,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END AS SumManBefore,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END AS SumComplBefore,
	BalanceAndTurnovers.IncomeCompl,
	BalanceAndTurnovers.ExpenseCompl,
	BalanceAndTurnovers.IncomeMan,
	BalanceAndTurnovers.ExpenseMan,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind}

GROUP BY
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.BalanceDate,
	BalanceAndTurnovers.Recorder,
	BalanceAndTurnovers.Currency,


	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.Partner,
	BalanceAndTurnovers.Counterparty,
	BalanceAndTurnovers.Contract,
	BalanceAndTurnovers.LineOfBusiness,
	BalanceAndTurnovers.DocumentAcquisitions,
	BalanceAndTurnovers.ContractRateOption
	
ORDER BY
	Period</query>
				<autoFillFields>false</autoFillFields>
			</item>
