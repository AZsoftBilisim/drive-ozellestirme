			<field xsi:type="DataSetFieldField">
				<dataPath>Department</dataPath>
				<field>Department</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>StartDateOfApplication67FL</dataPath>
				<field>StartDateOfApplication67FL</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>

// !!! TAGS ARE USED !!!

SELECT ALLOWED
	&amp;BeginOfPeriod AS Period,
	BEGINOFPERIOD(&amp;BeginOfPeriod, DAY) AS BalanceDate,
	UNDEFINED AS Recorder,
	Calculations.Currency AS Currency,
	Calculations.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Calculations.ARAPObject.FinancialAccountingGroup AS FinancialAccountingGroup,
	Dimension.Organization AS Organization,
	Dimension.Partner AS Partner,
	Dimension.Counterparty AS Counterparty,
	Dimension.Contract AS Contract,
	Dimension.LineOfBusiness AS LineOfBusiness,
	Calculations.ARAPObject.Department AS Department,
	Calculations.DebtBalance AS Sum,
	Calculations.ARAPManBalance AS SumMan,
	Calculations.DebtLocalBalance AS SumCompl,
	0 AS IncomeMan,
	0 AS ExpenseMan,
	0 AS IncomeCompl,
	0 AS ExpenseCompl,


	-Calculations.PrepaymentManBalance AS PrepaymentMan,
	-Calculations.PrepaymentLocalBalance AS PrepaymentLocal,
	Calculations.ARAPObject AS ARAPObject,
	Calculations.ARAPDocument AS ARAPDocument,
	ISNULL(ISNULL(CounterpartyContracts.ContractRateOption,
					IntercompanyContracts.ContractRateOption),
		VALUE(Enum.ContractRateOptions.Mutable)) AS ContractRateOption,
	FALSE AS ExchangeDifferenceCalculation
INTO TTBalancesAndRevolutions
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(
			&amp;Period,
			Currency &lt;&gt; &amp;CurrencyOfMan
				OR Currency &lt;&gt; AccountingDimensionByPartners.Organization.LocalAccountingCurrency {(AccountingDimensionByPartners).*, (ARAPObject).*, (ARAPDocument).*, (Currency).*}) AS Calculations
	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS Dimension
		LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON Dimension.Contract = CounterpartyContracts.Ref
		LEFT JOIN Catalog.IntercompanyContracts AS IntercompanyContracts
		ON Dimension.Contract = IntercompanyContracts.Ref
	ON Calculations.AccountingDimensionByPartners = Dimension.DimensionKey


{WHERE
	Dimension.Organization.*,
	Dimension.Partner.*,
	Dimension.Counterparty.*,
	Dimension.Contract.*,
	Dimension.LineOfBusiness.*,
	Calculations.ARAPObject.Department.*}

UNION ALL

SELECT
	Calculations.Period,
	BEGINOFPERIOD(Calculations.Period, DAY),
	Calculations.DocumentRecorder,
	Calculations.Currency,
	Calculations.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Calculations.ARAPObject.FinancialAccountingGroup AS FinancialAccountingGroup,
	Dimension.Organization AS Organization,
	Dimension.Partner AS Partner,
	Dimension.Counterparty AS Counterparty,
	Dimension.Contract AS Contract,
	Dimension.LineOfBusiness AS LineOfBusiness,
	Calculations.ARAPObject.Department AS Department,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Calculations.Debt
		ELSE -Calculations.Debt
	END AS Debt,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Calculations.ARAPMan
		ELSE -Calculations.ARAPMan
	END AS ARAPMan,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Calculations.DebtLocal
		ELSE -Calculations.DebtLocal
	END AS DebtLocal,
	CASE
		WHEN VALUETYPE(Calculations.DocumentRecorder) = TYPE(Document.ExchangeDifferenceCalculation)
				AND (Calculations.RecordType = VALUE(AccumulationRecordType.Receipt) AND Calculations.ARAPMan &lt;&gt; 0
					OR Calculations.RecordType = VALUE(AccumulationRecordType.Expense) AND Calculations.PrepaymentMan &lt;&gt; 0)
			THEN
				Calculations.ARAPMan + Calculations.PrepaymentMan
		ELSE 0
	END AS IncomeMan,
	CASE
		WHEN VALUETYPE(Calculations.DocumentRecorder) = TYPE(Document.ExchangeDifferenceCalculation)
				AND (Calculations.RecordType = VALUE(AccumulationRecordType.Expense) AND Calculations.ARAPMan &lt;&gt; 0
					OR Calculations.RecordType = VALUE(AccumulationRecordType.Receipt) AND Calculations.PrepaymentMan &lt;&gt; 0)
			THEN
				-(Calculations.ARAPMan + Calculations.PrepaymentMan)
		ELSE 0
	END AS ExpenseMan,
	CASE
		WHEN VALUETYPE(Calculations.DocumentRecorder) = TYPE(Document.ExchangeDifferenceCalculation)
				AND (Calculations.RecordType = VALUE(AccumulationRecordType.Receipt) AND Calculations.DebtLocal &lt;&gt; 0
					OR Calculations.RecordType = VALUE(AccumulationRecordType.Expense) AND Calculations.PrepaymentLocal &lt;&gt; 0)
			THEN
				Calculations.DebtLocal + Calculations.PrepaymentLocal
		ELSE 0
	END AS IncomeCompl,
	CASE
		WHEN VALUETYPE(Calculations.DocumentRecorder) = TYPE(Document.ExchangeDifferenceCalculation)
				AND (Calculations.RecordType = VALUE(AccumulationRecordType.Expense) AND Calculations.DebtLocal &lt;&gt; 0
					OR Calculations.RecordType = VALUE(AccumulationRecordType.Receipt) AND Calculations.PrepaymentLocal &lt;&gt; 0)
			THEN
				-(Calculations.DebtLocal + Calculations.PrepaymentLocal)
		ELSE 0
	END AS ExpenseCompl,


	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN -Calculations.PrepaymentMan
		ELSE Calculations.PrepaymentMan
	END AS PrepaymentMan,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN -Calculations.PrepaymentLocal
		ELSE Calculations.PrepaymentLocal
	END AS PrepaymentLocal,
	Calculations.ARAPObject,
	Calculations.ARAPDocument,
	ISNULL(ISNULL(CounterpartyContracts.ContractRateOption,
					IntercompanyContracts.ContractRateOption),
		VALUE(Enum.ContractRateOptions.Mutable)) AS ContractRateOption,
	VALUETYPE(Calculations.DocumentRecorder) = TYPE(Document.ExchangeDifferenceCalculation) AS ExchangeDifferenceCalculation
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates AS Calculations
	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS Dimension
		LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON Dimension.Contract = CounterpartyContracts.Ref
		LEFT JOIN Catalog.IntercompanyContracts AS IntercompanyContracts
		ON Dimension.Contract = IntercompanyContracts.Ref
	ON Calculations.AccountingDimensionByPartners = Dimension.DimensionKey
WHERE
	Calculations.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND (Calculations.Currency &lt;&gt; &amp;CurrencyOfMan OR Calculations.Currency &lt;&gt; AccountingDimensionByPartners.Organization.LocalAccountingCurrency)
{WHERE
	Calculations.DocumentRecorder,
	Calculations.Currency.*,
	Calculations.Period,
	Calculations.AccountingDimensionByPartners.*,
	Calculations.ARAPObject.*,
	Calculations.ARAPDocument.*,
	Dimension.Organization.*,
	Dimension.Partner.*,
	Dimension.Counterparty.*,
	Dimension.Contract.*,
	Dimension.LineOfBusiness.*}


;




////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceAndTurnovers.Period AS Period,
	BalanceAndTurnovers.BalanceDate AS BalanceDate,
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.Counterparty AS Dimension,
	BalanceAndTurnovers.AccountingDimensionByPartners AS AccountingDimensionByPartners,


	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Partner AS Partner,
	BalanceAndTurnovers.Counterparty AS Counterparty,
	BalanceAndTurnovers.Contract AS Contract,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	BalanceAndTurnovers.Department AS Department,
	SUM(BalanceAndTurnovers.Sum) AS Sum,
	SUM(BalanceAndTurnovers.SumMan) AS SumMan,
	SUM(BalanceAndTurnovers.SumCompl) AS SumCompl,
	SUM(CASE WHEN BalanceAndTurnovers.ExchangeDifferenceCalculation THEN 0 ELSE BalanceAndTurnovers.SumMan END) AS SumManBefore,
	SUM(CASE WHEN BalanceAndTurnovers.ExchangeDifferenceCalculation THEN 0 ELSE BalanceAndTurnovers.SumCompl END) AS SumComplBefore,
	SUM(BalanceAndTurnovers.IncomeMan) AS IncomeMan,
	SUM(BalanceAndTurnovers.ExpenseMan) AS ExpenseMan,
	SUM(BalanceAndTurnovers.IncomeCompl) AS IncomeCompl,
	SUM(BalanceAndTurnovers.ExpenseCompl) AS ExpenseCompl,


	BalanceAndTurnovers.ARAPObject AS ARAPObject,
	BalanceAndTurnovers.ARAPDocument AS ARAPDocument,
	BalanceAndTurnovers.ContractRateOption AS ContractRateOption,
	CASE WHEN BalanceAndTurnovers.ContractRateOption = VALUE(Enum.ContractRateOptions.SpecifiedInContract)
		THEN BalanceAndTurnovers.Contract
		ELSE UNDEFINED
	END AS ContractWithFixedCourse,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind,
	"CustomersARAPAccounting" AS RevaluationSection,
	100 AS ProcedureOfRevaluationSection
{SELECT
	RevaluationSection,
	Period,
	BalanceDate,
	Recorder,
	Currency.*,
	Dimension.*,
	AccountingDimensionByPartners.*,


	Organization.*,
	LocalAccountingCurrency.*,
	Partner.*,
	Counterparty.*,
	Contract.*,
	LineOfBusiness.*,
	Sum,
	SumMan,
	SumCompl,
	SumManBefore,
	SumComplBefore,
	IncomeMan,
	ExpenseMan,
	IncomeCompl,
	ExpenseCompl,


	ARAPObject.*,
	ARAPDocument.*,
	ContractRateOption,
	ContractWithFixedCourse,
	ContractKind,
	ProcedureOfRevaluationSection}
FROM
	TTBalancesAndRevolutions AS BalanceAndTurnovers


WHERE
	BalanceAndTurnovers.ContractRateOption &lt;&gt; VALUE(Enum.ContractRateOptions.FixedAsOfShipmentDate)
{WHERE
	"CustomersARAPAccounting" AS RevaluationSection,
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.Counterparty.* AS Dimension,


	BalanceAndTurnovers.Organization.*,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Partner.*,
	BalanceAndTurnovers.Counterparty.*,
	BalanceAndTurnovers.Contract.*,
	BalanceAndTurnovers.LineOfBusiness.*,
	BalanceAndTurnovers.Department.*,
	BalanceAndTurnovers.Currency.*,
	BalanceAndTurnovers.Sum,
	BalanceAndTurnovers.SumMan,
	BalanceAndTurnovers.SumCompl,
	CASE WHEN BalanceAndTurnovers.ExchangeDifferenceCalculation THEN 0 ELSE BalanceAndTurnovers.SumMan END AS SumManBefore,
	CASE WHEN BalanceAndTurnovers.ExchangeDifferenceCalculation THEN 0 ELSE BalanceAndTurnovers.SumCompl END AS SumComplBefore,
	BalanceAndTurnovers.IncomeMan,
	BalanceAndTurnovers.ExpenseMan,
	BalanceAndTurnovers.IncomeCompl,
	BalanceAndTurnovers.ExpenseCompl,


	BalanceAndTurnovers.ARAPObject AS ARAPObject,
	BalanceAndTurnovers.ARAPDocument,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind}

GROUP BY
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.BalanceDate,
	BalanceAndTurnovers.Recorder,
	BalanceAndTurnovers.Currency,
	BalanceAndTurnovers.AccountingDimensionByPartners,


	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.Partner,
	BalanceAndTurnovers.Counterparty,
	BalanceAndTurnovers.Contract,
	BalanceAndTurnovers.LineOfBusiness,
	BalanceAndTurnovers.Department,
	BalanceAndTurnovers.ARAPObject,
	BalanceAndTurnovers.ARAPDocument,
	BalanceAndTurnovers.ContractRateOption
	
ORDER BY
	Period</query>
			<autoFillFields>false</autoFillFields>
		</item>
		<item xsi:type="DataSetQuery">
			<name>VendorsARAPAccounting</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BalanceDate</dataPath>
				<field>BalanceDate</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Balance date</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>تاریخ مانده</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Data del saldo</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Data pozostałości</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Дата остатка</v8:content>
					</v8:item>
