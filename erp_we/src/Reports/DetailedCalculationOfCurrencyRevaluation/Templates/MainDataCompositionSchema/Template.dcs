							<v8:content>Характер договора</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Sözleşme özelliği</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Đặc tính hợp đồng</v8:content>
						</v8:item>
					</title>
				</field>
				<dataSource>DataSource1</dataSource>
				<query>

// !!! TAGS ARE USED !!!

SELECT ALLOWED
	&amp;BeginOfPeriod AS Period,
	BEGINOFPERIOD(&amp;BeginOfPeriod, DAY) AS BalanceDate,
	UNDEFINED AS Recorder,
	Cash.Currency AS Currency,
	Cash.AdvanceHolder AS AdvanceHolder,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	Cash.SumBalance AS Sum,
	Cash.SumManBalance AS SumMan,
	Cash.SumComplBalance AS SumCompl,
	0 AS IncomeMan,
	0 AS ExpenseMan,
	0 AS IncomeCompl,
	0 AS ExpenseCompl
INTO TTBalancesAndRevolutions
FROM
	AccumulationRegister.AdvanceHolderCash.Balance(
			&amp;Period,
			Currency &lt;&gt; &amp;CurrencyOfMan
				OR Currency &lt;&gt; Organization.LocalAccountingCurrency {(Organization).*, (AdvanceHolder).*, (Currency).*, (Department).*, (IssuancePurpose).*}) AS Cash

UNION ALL

SELECT
	Cash.Period,
	BEGINOFPERIOD(Cash.Period, DAY),
	Cash.Recorder,
	Cash.Currency AS Currency,
	Cash.AdvanceHolder AS AdvanceHolder,
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	CASE
		WHEN Cash.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Cash.Sum
		ELSE -Cash.Sum
	END AS Sum,
	CASE
		WHEN Cash.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Cash.SumMan
		ELSE -Cash.SumMan
	END AS SumMan,
	CASE
		WHEN Cash.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Cash.SumCompl
		ELSE -Cash.SumCompl
	END AS SumCompl,
	CASE
		WHEN Cash.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(Cash.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN Cash.SumMan
		ELSE 0
	END AS IncomeMan,
	CASE
		WHEN Cash.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(Cash.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -Cash.SumMan
		ELSE 0
	END AS ExpenseMan,
	CASE
		WHEN Cash.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(Cash.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN Cash.SumCompl
		ELSE 0
	END AS IncomeCompl,
	CASE
		WHEN Cash.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(Cash.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -Cash.SumCompl
		ELSE 0
	END AS ExpenseCompl
FROM
	AccumulationRegister.AdvanceHolderCash AS Cash
WHERE
	Cash.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND (Cash.Currency &lt;&gt; &amp;CurrencyOfMan OR Cash.Currency &lt;&gt; Cash.Organization.LocalAccountingCurrency)
{WHERE
	Cash.Recorder,
	Cash.Currency.*,
	Cash.Organization.*,
	Cash.Department.*,
	Cash.AdvanceHolder.*,
	Cash.IssuancePurpose.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Department AS Department,
	BalanceAndTurnovers.AdvanceHolder AS AdvanceHolder,
	SUM(BalanceAndTurnovers.Sum) AS Sum,
	SUM(BalanceAndTurnovers.SumMan) AS SumMan,
	SUM(BalanceAndTurnovers.SumCompl) AS SumCompl,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END) AS SumManBefore,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END) AS SumComplBefore,
	SUM(BalanceAndTurnovers.IncomeMan) AS IncomeMan,
	SUM(BalanceAndTurnovers.ExpenseMan) AS ExpenseMan,
	SUM(BalanceAndTurnovers.IncomeCompl) AS IncomeCompl,
	SUM(BalanceAndTurnovers.ExpenseCompl) AS ExpenseCompl
INTO TTCreditBalancesOnAccountHolder
FROM
	TTBalancesAndRevolutions AS BalanceAndTurnovers
	
{WHERE
	BalanceAndTurnovers.AdvanceHolder AS Dimension,
	BalanceAndTurnovers.LineOfBusiness.*,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Sum,
	BalanceAndTurnovers.SumMan,
	BalanceAndTurnovers.SumCompl,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END AS SumManBefore,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END AS SumComplBefore,
	BalanceAndTurnovers.IncomeCompl,
	BalanceAndTurnovers.ExpenseCompl,
	BalanceAndTurnovers.IncomeMan,
	BalanceAndTurnovers.ExpenseMan}

GROUP BY
	BalanceAndTurnovers.Currency,
	BalanceAndTurnovers.AdvanceHolder,
	BalanceAndTurnovers.Department,
	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.LineOfBusiness

HAVING
	SUM(BalanceAndTurnovers.Sum) &lt; 0

INDEX BY
	BalanceAndTurnovers.Currency,
	BalanceAndTurnovers.LineOfBusiness,
	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.Department,
	BalanceAndTurnovers.AdvanceHolder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceAndTurnovers.Period AS Period,
	BalanceAndTurnovers.BalanceDate AS BalanceDate,
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.AdvanceHolder AS Dimension,
	BalanceAndTurnovers.AdvanceHolder AS AdvanceHolder,


	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	UNDEFINED AS Partner,
	UNDEFINED AS Counterparty,
	UNDEFINED AS Contract,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	BalanceAndTurnovers.Department AS Department,
	SUM(BalanceAndTurnovers.Sum) AS Sum,
	SUM(BalanceAndTurnovers.SumMan) AS SumMan,
	SUM(BalanceAndTurnovers.SumCompl) AS SumCompl,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END) AS SumManBefore,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END) AS SumComplBefore,
	SUM(BalanceAndTurnovers.IncomeMan) AS IncomeMan,
	-SUM(BalanceAndTurnovers.ExpenseMan) AS ExpenseMan,
	SUM(BalanceAndTurnovers.IncomeCompl) AS IncomeCompl,
	-SUM(BalanceAndTurnovers.ExpenseCompl) AS ExpenseCompl,
	UNDEFINED AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	VALUE(Enum.ContractRateOptions.Mutable) AS ContractRateOption,
	UNDEFINED AS ContractWithFixedCourse,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind,
	"AdvanceHolderCash" AS RevaluationSection,
	500 AS ProcedureOfRevaluationSection
{SELECT
	RevaluationSection,
	Period,
	BalanceDate,
	Recorder,
	Currency.*,
	Dimension.*,
	AdvanceHolder.*,


	Organization.*,
	LocalAccountingCurrency.*,
	Partner.*,
	Counterparty.*,
	Contract.*,
	LineOfBusiness.*,
	Sum,
	SumMan,
	SumCompl,
	SumManBefore,
	SumComplBefore,
	IncomeMan,
	ExpenseMan,
	IncomeCompl,
	ExpenseCompl,
	ContractRateOption,
	ContractWithFixedCourse,
	ContractKind,
	ProcedureOfRevaluationSection}
FROM
	TTBalancesAndRevolutions AS BalanceAndTurnovers
	INNER JOIN TTCreditBalancesOnAccountHolder AS CreditBalance
	ON BalanceAndTurnovers.Currency = CreditBalance.Currency
		AND BalanceAndTurnovers.LineOfBusiness = CreditBalance.LineOfBusiness
		AND BalanceAndTurnovers.Organization = CreditBalance.Organization
		AND BalanceAndTurnovers.Department = CreditBalance.Department
		AND BalanceAndTurnovers.AdvanceHolder = CreditBalance.AdvanceHolder
	
{WHERE
	"AdvanceHolderCash" AS RevaluationSection,
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.AdvanceHolder AS Dimension,


	BalanceAndTurnovers.LineOfBusiness.*,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Sum,
	BalanceAndTurnovers.SumMan,
	BalanceAndTurnovers.SumCompl,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END AS SumManBefore,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END AS SumComplBefore,
	BalanceAndTurnovers.IncomeCompl,
	BalanceAndTurnovers.ExpenseCompl,
	BalanceAndTurnovers.IncomeMan,
	BalanceAndTurnovers.ExpenseMan,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind}

GROUP BY
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.BalanceDate,
	BalanceAndTurnovers.Recorder,
	BalanceAndTurnovers.Currency,
	BalanceAndTurnovers.AdvanceHolder,
	BalanceAndTurnovers.Department,
	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.LineOfBusiness
	
ORDER BY
	Period</query>
				<autoFillFields>false</autoFillFields>
			</item>
