				<dataSource>DataSource1</dataSource>
				<query>

// !!! TAGS ARE USED !!!

SELECT ALLOWED
	&amp;BeginOfPeriod AS Period,
	BEGINOFPERIOD(&amp;BeginOfPeriod, DAY) AS BalanceDate,
	UNDEFINED AS Recorder,
	ServicesForRegistration.Currency AS Currency,
	ServicesForRegistration.Organization AS Organization,
	ServicesForRegistration.ItemsLocationAttributes AS ItemsLocationAttributes,
	ServicesForRegistration.Terms AS Terms,
	ServicesForRegistration.DocumentSales AS DocumentSales,
	Terms1.FinancialAccountingGroup AS FinancialAccountingGroup,
	Terms1.Counterparty AS Counterparty,
	Terms1.Partner AS Partner,
	Terms1.LineOfBusiness AS LineOfBusiness,
	ServicesForRegistration.RevenueAmountBalance AS Sum,
	ServicesForRegistration.RevenueAmountManBalance AS SumMan,
	ServicesForRegistration.RevenueAmountExclVATLocalBalance AS SumCompl,
	0 AS IncomeMan,
	0 AS ExpenseMan,
	0 AS IncomeCompl,
	0 AS ExpenseCompl
INTO TTBalancesAndRevolutions
FROM
	AccumulationRegister.ServicesForRegistrationOfReportsToPrincipal.Balance(
			&amp;Period,
			Currency &lt;&gt; &amp;CurrencyOfMan
				OR Currency &lt;&gt; Organization.LocalAccountingCurrency {(Organization).*, (Terms).* AS Terms, (Currency).* AS Currency}) AS ServicesForRegistration
	INNER JOIN Catalog.TermsOfPurchaseFromVendors AS Terms1
		ON ServicesForRegistration.Terms = Terms1.Ref
WHERE
	ISNULL(Terms1.RevalueServicesForConsignmentNotification, FALSE)

UNION ALL

SELECT
	ServicesForRegistration.Period,
	BEGINOFPERIOD(ServicesForRegistration.Period, DAY),
	ServicesForRegistration.Recorder,
	ServicesForRegistration.Currency AS Currency,
	ServicesForRegistration.Organization AS Organization,
	ServicesForRegistration.ItemsLocationAttributes AS ItemsLocationAttributes,
	ServicesForRegistration.Terms AS Terms,
	ServicesForRegistration.DocumentSales AS DocumentSales,
	Terms1.FinancialAccountingGroup AS FinancialAccountingGroup,
	Terms1.Counterparty AS Counterparty,
	Terms1.Partner AS Partner,
	Terms1.LineOfBusiness AS LineOfBusiness,
	CASE
		WHEN ServicesForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN ServicesForRegistration.RevenueAmount
		ELSE -ServicesForRegistration.RevenueAmount
	END AS Sum,
	CASE
		WHEN ServicesForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN ServicesForRegistration.RevenueAmountMan
		ELSE -ServicesForRegistration.RevenueAmountMan
	END AS SumMan,
	CASE
		WHEN ServicesForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN ServicesForRegistration.RevenueAmountExclVATLocal
		ELSE -ServicesForRegistration.RevenueAmountExclVATLocal
	END AS SumCompl,
	CASE
		WHEN ServicesForRegistration.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(ServicesForRegistration.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -ServicesForRegistration.RevenueAmountMan
		ELSE 0
	END AS IncomeMan,
	CASE
		WHEN ServicesForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(ServicesForRegistration.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN ServicesForRegistration.RevenueAmountMan
		ELSE 0
	END AS ExpenseMan,
	CASE
		WHEN ServicesForRegistration.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(ServicesForRegistration.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -ServicesForRegistration.RevenueAmountExclVATLocal
		ELSE 0
	END AS IncomeCompl,
	CASE
		WHEN ServicesForRegistration.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(ServicesForRegistration.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN ServicesForRegistration.RevenueAmountExclVATLocal
		ELSE 0
	END AS ExpenseCompl
FROM
	AccumulationRegister.ServicesForRegistrationOfReportsToPrincipal AS ServicesForRegistration
	INNER JOIN Catalog.TermsOfPurchaseFromVendors AS Terms1
		ON ServicesForRegistration.Terms = Terms1.Ref
WHERE
	ServicesForRegistration.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND ISNULL(Terms1.RevalueServicesForConsignmentNotification, FALSE)
	AND (ServicesForRegistration.Currency &lt;&gt; &amp;CurrencyOfMan OR ServicesForRegistration.Currency &lt;&gt; ServicesForRegistration.Organization.LocalAccountingCurrency)
{WHERE
	ServicesForRegistration.Recorder,
	ServicesForRegistration.Organization.* AS Organization,
	ServicesForRegistration.Currency.* AS Currency}
;



////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceAndTurnovers.Period AS Period,
	BalanceAndTurnovers.BalanceDate AS BalanceDate,
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.Terms AS Dimension,
	UNDEFINED AS AccountingDimensionByPartners,


	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Partner AS Partner,
	BalanceAndTurnovers.Counterparty AS Counterparty,
	UNDEFINED AS Contract,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	UNDEFINED AS Department,
	SUM(BalanceAndTurnovers.Sum) AS Sum,
	SUM(BalanceAndTurnovers.SumMan) AS SumMan,
	SUM(BalanceAndTurnovers.SumCompl) AS SumCompl,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END) AS SumManBefore,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END) AS SumComplBefore,
	SUM(BalanceAndTurnovers.IncomeMan) AS IncomeMan,
	SUM(BalanceAndTurnovers.ExpenseMan) AS ExpenseMan,
	SUM(BalanceAndTurnovers.IncomeCompl) AS IncomeCompl,
	SUM(BalanceAndTurnovers.ExpenseCompl) AS ExpenseCompl,


	UNDEFINED AS ARAPObject,
	BalanceAndTurnovers.DocumentSales AS ARAPDocument,
	VALUE(Enum.ContractRateOptions.Mutable) AS ContractRateOption,
	UNDEFINED AS ContractWithFixedCourse,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind,
	"SettlementsWithCommittee" AS RevaluationSection,
	300 AS ProcedureOfRevaluationSection
{SELECT
	RevaluationSection,
	Period,
	BalanceDate,
	Recorder,
	Currency.*,
	Dimension.*,
	Contract.*,


	Organization.*,
	LocalAccountingCurrency.*,
	Partner.*,
	Counterparty.*,
	LineOfBusiness.*,
	Sum,
	SumMan,
	SumCompl,
	SumManBefore,
	SumComplBefore,
	IncomeCompl,
	ExpenseCompl,
	IncomeMan,
	ExpenseMan,
	ContractRateOption,
	ContractWithFixedCourse,
	ContractKind,
	ProcedureOfRevaluationSection}
FROM
	TTBalancesAndRevolutions AS BalanceAndTurnovers


	
{WHERE
	"SettlementsWithCommittee" AS RevaluationSection,
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.Terms.* AS Dimension,


	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.LineOfBusiness.*,
	BalanceAndTurnovers.Sum,
	BalanceAndTurnovers.SumMan,
	BalanceAndTurnovers.SumCompl,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END AS SumManBefore,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END AS SumComplBefore,
	BalanceAndTurnovers.IncomeCompl,
	BalanceAndTurnovers.ExpenseCompl,
	BalanceAndTurnovers.IncomeMan,
	BalanceAndTurnovers.ExpenseMan,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind}

GROUP BY
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.BalanceDate,
	BalanceAndTurnovers.Recorder,
	BalanceAndTurnovers.Currency,


	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.Partner,
	BalanceAndTurnovers.Counterparty,
	BalanceAndTurnovers.Terms,
	BalanceAndTurnovers.LineOfBusiness,
	BalanceAndTurnovers.DocumentSales
	
ORDER BY
	Period</query>
				<autoFillFields>false</autoFillFields>
			</item>
		</item>
