	<calculatedField>
		<dataPath>LocalAccrualIsRequired</dataPath>
		<expression>Case When Sum = 0 Then 0 Else Cast(Sum*LocalCourse/MultiplicityOfLocal, "Number(31,2)") - SumCompl End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Accrual is required local</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>محاسبه لازم است (محلی)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>È necessario maturare contabilità regolamentata</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
