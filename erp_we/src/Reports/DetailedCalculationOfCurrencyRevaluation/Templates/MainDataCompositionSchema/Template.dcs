			<dataSource>DataSource1</dataSource>
			<query>
SELECT ALLOWED
	&amp;BeginOfPeriod AS Period,
	BEGINOFPERIOD(&amp;BeginOfPeriod, DAY) AS BalanceDate,
	UNDEFINED AS Recorder,
	DiscountRates_.Currency AS Currency,
	DiscountRates_.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	DiscountRates_.ARAPObject AS ARAPObject,
	DiscountRates_.ARAPObject.Organization AS Organization,
	DiscountRates_.ARAPObject.FinancialAccountingGroup AS FinancialAccountingGroup,
	DiscountRates_.ARAPObject.LineOfBusiness AS LineOfBusiness,
	DiscountRates_.ARAPObject.Department AS Department,
	DiscountRates_.ARAPObject.Partner AS Partner,
	DiscountRates_.ARAPObject.Counterparty AS Counterparty,
	DiscountRates_.ARAPObject.Contract AS Contract,
	DiscountRates_.ARAPDocument AS ARAPDocument,
	ISNULL(ISNULL(CounterpartyContracts.ContractRateOption,
					IntercompanyContracts.ContractRateOption),
			VALUE(Enum.ContractRateOptions.Mutable)) AS ContractRateOption,
	DiscountRates_.DiscountingAmountBalance AS Sum,
	DiscountRates_.DiscountingAmountManBalance AS SumMan,
	DiscountRates_.DiscountingAmountComplBalance AS SumCompl,
	0 AS IncomeMan,
	0 AS ExpenseMan,
	0 AS IncomeCompl,
	0 AS ExpenseCompl
INTO TTBalancesAndRevolutions
FROM
	AccumulationRegister.DiscountInterestExpense.Balance(
			&amp;Period,
			Currency &lt;&gt; &amp;CurrencyOfMan
				OR Currency &lt;&gt; ARAPObject.Organization.LocalAccountingCurrency {(ARAPObject.Organization).*, (ARAPObject.Department).*}) AS DiscountRates_
	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS Dimension
		LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON Dimension.Contract = CounterpartyContracts.Ref
		LEFT JOIN Catalog.IntercompanyContracts AS IntercompanyContracts
		ON Dimension.Contract = IntercompanyContracts.Ref
	ON DiscountRates_.AccountingDimensionByPartners = Dimension.DimensionKey

UNION ALL

SELECT
	DiscountRates_.Period AS Period,
	BEGINOFPERIOD(DiscountRates_.Period, DAY) AS BalanceDate,
	DiscountRates_.Recorder AS Recorder,
	DiscountRates_.Currency AS Currency,
	DiscountRates_.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	DiscountRates_.ARAPObject AS ARAPObject,
	ARAPObjects.Organization AS Organization,
	ARAPObjects.FinancialAccountingGroup AS FinancialAccountingGroup,
	ARAPObjects.LineOfBusiness AS LineOfBusiness,
	ARAPObjects.Department AS Department,
	ARAPObjects.Partner AS Partner,
	ARAPObjects.Counterparty AS Counterparty,
	ARAPObjects.Contract AS Contract,
	DiscountRates_.ARAPDocument AS ARAPDocument,
	ISNULL(ISNULL(CounterpartyContracts.ContractRateOption,
	                  IntercompanyContracts.ContractRateOption),
	         VALUE(Enum.ContractRateOptions.Mutable)) AS ContractRateOption,
	CASE
		WHEN DiscountRates_.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN DiscountRates_.DiscountingAmount
		ELSE -DiscountRates_.DiscountingAmount
	END AS Sum,
	CASE
		WHEN DiscountRates_.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN DiscountRates_.DiscountingAmountMan
		ELSE -DiscountRates_.DiscountingAmountMan
	END AS SumMan,
	CASE
		WHEN DiscountRates_.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN DiscountRates_.DiscountingAmountCompl
		ELSE -DiscountRates_.DiscountingAmountCompl
	END AS SumCompl,
	CASE
		WHEN DiscountRates_.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(DiscountRates_.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN DiscountRates_.DiscountingAmountMan
		ELSE 0
	END AS IncomeMan,
	CASE
		WHEN DiscountRates_.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(DiscountRates_.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -DiscountRates_.DiscountingAmountMan
		ELSE 0
	END AS ExpenseMan,
	CASE
		WHEN DiscountRates_.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(DiscountRates_.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN DiscountRates_.DiscountingAmountCompl
		ELSE 0
	END AS IncomeCompl,
	CASE
		WHEN DiscountRates_.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(DiscountRates_.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -DiscountRates_.DiscountingAmountCompl
		ELSE 0
	END AS ExpenseCompl
FROM
	AccumulationRegister.DiscountInterestExpense AS DiscountRates_
	LEFT JOIN Catalog.ARAPObjects AS ARAPObjects
	ON DiscountRates_.ARAPObject = ARAPObjects.Ref
	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS Dimension
		LEFT JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON Dimension.Contract = CounterpartyContracts.Ref
		LEFT JOIN Catalog.IntercompanyContracts AS IntercompanyContracts
		ON Dimension.Contract = IntercompanyContracts.Ref
	ON DiscountRates_.AccountingDimensionByPartners = Dimension.DimensionKey
WHERE
	DiscountRates_.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND (DiscountRates_.Currency &lt;&gt; &amp;CurrencyOfMan OR DiscountRates_.Currency &lt;&gt; ARAPObjects.Organization.LocalAccountingCurrency)
{WHERE
	DiscountRates_.Recorder,
	ARAPObjects.Organization.*,
	ARAPObjects.Department.*}
;



////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceAndTurnovers.Period AS Period,
	BalanceAndTurnovers.BalanceDate AS BalanceDate,
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.Counterparty AS Dimension,
	BalanceAndTurnovers.AccountingDimensionByPartners AS AccountingDimensionByPartners,


	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Partner AS Partner,
	BalanceAndTurnovers.Counterparty AS Counterparty,
	BalanceAndTurnovers.Contract AS Contract,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	BalanceAndTurnovers.Department AS Department,
	SUM(BalanceAndTurnovers.Sum) AS Sum,
	SUM(BalanceAndTurnovers.SumMan) AS SumMan,
	SUM(BalanceAndTurnovers.SumCompl) AS SumCompl,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END) AS SumManBefore,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END) AS SumComplBefore,
	SUM(BalanceAndTurnovers.IncomeMan) AS IncomeMan,
	SUM(BalanceAndTurnovers.ExpenseMan) AS ExpenseMan,
	SUM(BalanceAndTurnovers.IncomeCompl) AS IncomeCompl,
	SUM(BalanceAndTurnovers.ExpenseCompl) AS ExpenseCompl,


	
	BalanceAndTurnovers.ARAPObject AS ARAPObject,
	BalanceAndTurnovers.ARAPDocument AS ARAPDocument,
	BalanceAndTurnovers.ContractRateOption AS ContractRateOption,
	CASE WHEN BalanceAndTurnovers.ContractRateOption = VALUE(Enum.ContractRateOptions.SpecifiedInContract)
		THEN BalanceAndTurnovers.Contract
		ELSE UNDEFINED
	END AS ContractWithFixedCourse,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind,
	"DiscountInterestExpense" AS RevaluationSection,
	1000 AS ProcedureOfRevaluationSection
{SELECT
	RevaluationSection,
	Period,
	BalanceDate,
	Recorder,
	Currency.*,
	Dimension.*,


	Organization.*,
	LocalAccountingCurrency.*,
	Partner.*,
	Counterparty.*,
	Contract.*,
	LineOfBusiness.*,
	Department.*,
	Sum,
	SumMan,
	SumCompl,
	SumManBefore,
	SumComplBefore,
	IncomeMan,
	ExpenseMan,
	IncomeCompl,
	ExpenseCompl,
	ContractRateOption,
	ContractWithFixedCourse,
	ContractKind
}
FROM
	TTBalancesAndRevolutions AS BalanceAndTurnovers


WHERE
	BalanceAndTurnovers.ContractRateOption &lt;&gt; VALUE(Enum.ContractRateOptions.FixedAsOfShipmentDate)
{WHERE
	"DiscountInterestExpense" AS RevaluationSection,
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.Counterparty AS Dimension,


	BalanceAndTurnovers.LineOfBusiness.*,
	BalanceAndTurnovers.Department.*,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Department.*,
	BalanceAndTurnovers.Sum,
	BalanceAndTurnovers.SumMan,
	BalanceAndTurnovers.SumCompl,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END AS SumManBefore,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END AS SumComplBefore,
	BalanceAndTurnovers.IncomeCompl,
	BalanceAndTurnovers.ExpenseCompl,
	BalanceAndTurnovers.IncomeMan,
	BalanceAndTurnovers.ExpenseMan,
	VALUE(Enum.ContractKindsOfFinancialInstruments.EmptyRef) AS ContractKind}

GROUP BY
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.BalanceDate,
	BalanceAndTurnovers.Recorder,
	BalanceAndTurnovers.Currency,
	BalanceAndTurnovers.ARAPObject,
	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.Partner,
	BalanceAndTurnovers.Counterparty,
	BalanceAndTurnovers.Contract,


	BalanceAndTurnovers.LineOfBusiness,
	BalanceAndTurnovers.Department,
	BalanceAndTurnovers.ARAPDocument,
	BalanceAndTurnovers.ContractRateOption,
	BalanceAndTurnovers.AccountingDimensionByPartners,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency
	
ORDER BY
	Period</query>
			<autoFillFields>false</autoFillFields>
		</item>
