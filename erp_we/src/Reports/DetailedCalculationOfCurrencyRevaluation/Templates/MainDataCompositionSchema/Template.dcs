			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Counterparty</dataPath>
				<field>Counterparty</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>AccountingDimensionByPartners</dataPath>
				<field>AccountingDimensionByPartners</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>RevaluationSection</dataPath>
				<field>RevaluationSection</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BalanceDate</dataPath>
				<field>BalanceDate</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Recorder</dataPath>
				<field>Recorder</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Dimension</dataPath>
				<field>Dimension</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>GLAccount</dataPath>
				<field>GLAccount</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>LocalAccountingCurrency</dataPath>
				<field>LocalAccountingCurrency</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Sum</dataPath>
				<field>Sum</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SumMan</dataPath>
				<field>SumMan</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SumCompl</dataPath>
				<field>SumCompl</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SumManBefore</dataPath>
				<field>SumManBefore</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SumComplBefore</dataPath>
				<field>SumComplBefore</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>IncomeMan</dataPath>
				<field>IncomeMan</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ExpenseMan</dataPath>
				<field>ExpenseMan</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>IncomeCompl</dataPath>
				<field>IncomeCompl</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ExpenseCompl</dataPath>
				<field>ExpenseCompl</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>AmountFA</dataPath>
				<field>AmountFA</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>AmountFABefore</dataPath>
				<field>AmountFABefore</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>IncomeWELL</dataPath>
				<field>IncomeWELL</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ConsumptionWELL</dataPath>
				<field>ConsumptionWELL</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ContractRateOption</dataPath>
				<field>ContractRateOption</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ContractWithFixedCourse</dataPath>
				<field>ContractWithFixedCourse</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ContractKind</dataPath>
				<field>ContractKind</field>
				<useRestriction>
					<field>true</field>
					<condition>true</condition>
					<group>true</group>
					<order>true</order>
				</useRestriction>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ProcedureOfRevaluationSection</dataPath>
				<field>ProcedureOfRevaluationSection</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>

// !!! TAGS ARE USED !!!


SELECT ALLOWED
	&amp;BeginOfPeriod AS Period,
	BEGINOFPERIOD(&amp;BeginOfPeriod, DAY) AS BalanceDate,
	UNDEFINED AS Recorder,
	Calculations.Contract.ARAPCurrency AS Currency,
	Calculations.Contract AS Contract,
	Calculations.Contract.FinancialAccountingGroup AS FinancialAccountingGroup,
	CASE WHEN VALUETYPE(Calculations.Contract) = TYPE(Catalog.LoanAndDepositContracts)
			THEN Calculations.Contract.ContractKind 
			ELSE UNDEFINED
	END AS ContractKind,
	Calculations.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Dimension.Organization AS Organization,
	Dimension.Partner AS Partner,
	Dimension.Counterparty AS Counterparty,
	Dimension.LineOfBusiness AS LineOfBusiness,
	Calculations.Contract.Department AS Department,
	Calculations.AmountType AS AmountType,


	Calculations.SumBalance AS Sum,
	Calculations.SumManBalance AS SumMan,
	Calculations.SumComplBalance AS SumCompl,
	0 AS IncomeMan,
	0 AS ExpenseMan,
	0 AS IncomeCompl,
	0 AS ExpenseCompl
INTO TTBalancesAndRevolutions
FROM
	AccumulationRegister.FinancialInstrumentsARAP.Balance(
			&amp;Period,
			(&amp;UseLoanAndDepositContracts AND VALUETYPE(Contract) = TYPE(Catalog.LoanAndDepositContracts)
				OR &amp;UseTheLease AND VALUETYPE(Contract) = TYPE(Catalog.LeaseContract)
			)
			AND (Contract.ARAPCurrency &lt;&gt; &amp;CurrencyOfMan
				OR Contract.ARAPCurrency &lt;&gt; AccountingDimensionByPartners.Organization.LocalAccountingCurrency) {(AccountingDimensionByPartners.Organization).* AS Organization,(Contract).* AS Contract, (Contract.ARAPCurrency).* AS Currency, (Contract.Department).* AS Department, AmountType}) AS Calculations
	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS Dimension
	ON Calculations.AccountingDimensionByPartners = Dimension.DimensionKey


	
{WHERE
	Dimension.Organization.*,
	Dimension.Partner.*,
	Dimension.Counterparty.*,
	Dimension.LineOfBusiness.*,
	Calculations.AmountType}

UNION ALL

SELECT
	Calculations.Period AS Period,
	BEGINOFPERIOD(Calculations.Period, DAY) AS BalanceDate,
	Calculations.Recorder AS Recorder,
	Calculations.Contract.ARAPCurrency AS Currency,
	Calculations.Contract AS Contract,
	Calculations.Contract.FinancialAccountingGroup AS FinancialAccountingGroup,
	Calculations.Contract.ContractKind AS ContractKind,
	Calculations.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Dimension.Organization AS Organization,
	Dimension.Partner AS Partner,
	Dimension.Counterparty AS Counterparty,
	Dimension.LineOfBusiness AS LineOfBusiness,
	Calculations.Contract.Department AS Department,
	Calculations.AmountType AS AmountType,


	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Calculations.Sum
		ELSE -Calculations.Sum
	END AS Sum,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Calculations.SumMan
		ELSE -Calculations.SumMan
	END AS SumMan,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN Calculations.SumCompl
		ELSE -Calculations.SumCompl
	END AS SumCompl,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(Calculations.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN Calculations.SumMan
		ELSE 0
	END AS IncomeMan,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(Calculations.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -Calculations.SumMan
		ELSE 0
	END AS ExpenseMan,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(Calculations.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN Calculations.SumCompl
		ELSE 0
	END AS IncomeCompl,
	CASE
		WHEN Calculations.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(Calculations.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
			THEN -Calculations.SumCompl
		ELSE 0
	END AS ExpenseCompl
FROM
	AccumulationRegister.FinancialInstrumentsARAP AS Calculations
	LEFT JOIN InformationRegister.AccountingDimensionByPartners AS Dimension
	ON Calculations.AccountingDimensionByPartners = Dimension.DimensionKey
WHERE
	(&amp;UseLoanAndDepositContracts AND VALUETYPE(Calculations.Contract) = TYPE(Catalog.LoanAndDepositContracts)
		OR &amp;UseTheLease AND VALUETYPE(Calculations.Contract) = TYPE(Catalog.LeaseContract)
	)
	AND Calculations.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND (Calculations.Contract.ARAPCurrency &lt;&gt; &amp;CurrencyOfMan OR Calculations.Contract.ARAPCurrency &lt;&gt; Dimension.Organization.LocalAccountingCurrency)
{WHERE
	Calculations.Contract.ARAPCurrency.* AS Currency,
	Calculations.Contract AS Contract,
	Calculations.Period,
	Calculations.AccountingDimensionByPartners.*,
	Dimension.Organization.*,
	Dimension.Partner.*,
	Dimension.Counterparty.*,
	Dimension.LineOfBusiness.*,
	Calculations.Contract.Department.* AS Department,
	Calculations.AmountType}


;



////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceAndTurnovers.Period AS Period,
	BalanceAndTurnovers.BalanceDate AS BalanceDate,
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.Contract AS Dimension,
	BalanceAndTurnovers.Contract AS Contract,


	BalanceAndTurnovers.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Partner AS Partner,
	BalanceAndTurnovers.Counterparty AS Counterparty,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	BalanceAndTurnovers.Department AS Department,
	BalanceAndTurnovers.AmountType AS AmountType,
	SUM(BalanceAndTurnovers.Sum) AS Sum,
	SUM(BalanceAndTurnovers.SumMan) AS SumMan,
	SUM(BalanceAndTurnovers.SumCompl) AS SumCompl,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END) AS SumManBefore,
	SUM(CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END) AS SumComplBefore,
	SUM(BalanceAndTurnovers.IncomeMan) AS IncomeMan,
	SUM(BalanceAndTurnovers.ExpenseMan) AS ExpenseMan,
	SUM(BalanceAndTurnovers.IncomeCompl) AS IncomeCompl,
	SUM(BalanceAndTurnovers.ExpenseCompl) AS ExpenseCompl,


	UNDEFINED AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	VALUE(Enum.ContractRateOptions.Mutable) AS ContractRateOption,
	UNDEFINED AS ContractWithFixedCourse,
	BalanceAndTurnovers.ContractKind AS ContractKind,
	"FinancialInstrumentsARAP" AS RevaluationSection,
	900 AS ProcedureOfRevaluationSection
{SELECT
	RevaluationSection,
	Period,
	BalanceDate,
	Recorder,
	Currency.*,
	Dimension.*,


	Contract.*,
	AccountingDimensionByPartners.*,
	Organization.*,
	LocalAccountingCurrency.*,
	Partner.*,
	Counterparty.*,
	LineOfBusiness.*,
	Department.*,
	AmountType,
	Sum,
	SumMan,
	SumCompl,
	SumManBefore,
	SumComplBefore,
	IncomeMan,
	ExpenseMan,
	IncomeCompl,
	ExpenseCompl,


	ContractRateOption,
	ContractWithFixedCourse,
	ContractKind,
	ProcedureOfRevaluationSection}
FROM
	TTBalancesAndRevolutions AS BalanceAndTurnovers


{WHERE
	"FinancialInstrumentsARAP" AS RevaluationSection,


	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.Organization.*,
	BalanceAndTurnovers.Organization.LocalAccountingCurrency AS LocalAccountingCurrency,
	BalanceAndTurnovers.Partner.*,
	BalanceAndTurnovers.Counterparty.*,
	BalanceAndTurnovers.LineOfBusiness.*,
	BalanceAndTurnovers.ContractKind,
	BalanceAndTurnovers.Sum,
	BalanceAndTurnovers.SumMan,
	BalanceAndTurnovers.SumCompl,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumMan END AS SumManBefore,
	CASE WHEN VALUETYPE(BalanceAndTurnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation) THEN 0 ELSE BalanceAndTurnovers.SumCompl END AS SumComplBefore,
	BalanceAndTurnovers.IncomeCompl,
	BalanceAndTurnovers.ExpenseCompl,


	BalanceAndTurnovers.IncomeMan,
	BalanceAndTurnovers.ExpenseMan}

GROUP BY
	BalanceAndTurnovers.Period,
	BalanceAndTurnovers.BalanceDate,
	BalanceAndTurnovers.Recorder,
	BalanceAndTurnovers.Currency,
	BalanceAndTurnovers.Contract,


	BalanceAndTurnovers.AccountingDimensionByPartners,
	BalanceAndTurnovers.Organization,
	BalanceAndTurnovers.Partner,
	BalanceAndTurnovers.Counterparty,
	BalanceAndTurnovers.LineOfBusiness,
	BalanceAndTurnovers.ContractKind,
	BalanceAndTurnovers.Department,
	BalanceAndTurnovers.AmountType
	
ORDER BY
	Period</query>
			<autoFillFields>false</autoFillFields>
		</item>
		<item xsi:type="DataSetQuery">
			<name>DiscountRates_</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Counterparty</dataPath>
				<field>Counterparty</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Counterparty</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
