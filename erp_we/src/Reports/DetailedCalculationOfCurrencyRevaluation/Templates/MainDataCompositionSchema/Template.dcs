		<group>BankAccount</group>
		<group>MonetaryDocument</group>
		<group>MonetaryDocument Hierarchy</group>
		<group>Contract</group>
		<group>CashAccount</group>
		<group>CashRegister</group>
		<group>Counterparty</group>
		<group>LineOfBusiness</group>
		<group>LineOfBusiness Hierarchy</group>
		<group>Organization</group>
		<group>Partner</group>
		<group>Partner Hierarchy</group>
		<group>AdvanceHolder</group>
		<group>AdvanceHolder Hierarchy</group>
		<group>Department</group>
		<group>Department Hierarchy</group>
		<group>Recipient</group>
		<group>RevaluationSection</group>
		<group>ARAPDocument</group>
		<group>GLAccount</group>
		<group>GLAccount Hierarchy</group>
		<group>AmountType</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>TAAccrualIsRequired</dataPath>
		<expression>TAAccrualIsRequired</expression>
		<group>Period</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>TAAccrualIsRequired</dataPath>
		<expression>Case When Sum(AmountFA) = 0 Or Min(StartDateOfApplication67FL) &gt; Min(Period) Then 0
    Else
        Case
            When (Min(RevaluationSection) = "CustomersARAPAccounting"
                    Or Min(RevaluationSection) = "VendorsARAPAccounting"
                    Or Min(RevaluationSection) = "FinancialInstrumentsARAP")
                And Sum(AmountFA) &lt;&gt; Cast(Sum(Sum)*LocalCoCourse/MultiplicityOfLocalCo, "Number(31,2)")
                Then Cast(Sum(Sum)*LocalCoCourse/MultiplicityOfLocalCo, "Number(31,2)") - Sum(AmountFA)
            Else
                0
        End
End</expression>
		<group>Dimension</group>
		<group>Dimension Hierarchy</group>
		<group>BankAccount</group>
		<group>MonetaryDocument</group>
		<group>Contract</group>
		<group>CashAccount</group>
		<group>CashRegister</group>
		<group>Counterparty</group>
		<group>LineOfBusiness</group>
		<group>LineOfBusiness Hierarchy</group>
		<group>ARAPObject</group>
		<group>Organization</group>
		<group>Partner</group>
		<group>Partner Hierarchy</group>
		<group>AdvanceHolder</group>
		<group>Department</group>
		<group>Department Hierarchy</group>
		<group>Recipient</group>
		<group>RevaluationSection</group>
		<group>ARAPDocument</group>
		<group>GLAccount</group>
		<group>GLAccount Hierarchy</group>
		<group>AmountType</group>
		<group>Overall</group>
	</totalField>
