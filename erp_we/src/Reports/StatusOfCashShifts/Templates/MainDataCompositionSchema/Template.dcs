		<dataSource>DataSource1</dataSource>
		<query>// The request text is filled in automatically in the module of the state object of the Cash shifts


////////////////////////////////////////////////////////////////////////////////
SELECT
	VALUE(Document.CashRegisterShift.EmptyRef) AS CashRegisterShift,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Enum.CashRegisterShiftStatuses.EmptyRef) AS ShiftState,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	VALUE(Catalog.CashRegisters.EmptyRef) AS CashRegister,
	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATTaxation,
	VALUE(Document.RetailSalesReport.EmptyRef) AS SalesReturnsReport,
	"" AS StateOfSalesReturnsReport
FROM
	Document.CashRegisterShift AS DocumentCashRegisterShift
{WHERE
	(DocumentCashRegisterShift.Organization = &amp;Organization),
	(DocumentCashRegisterShift.CashRegister = &amp;CashRegister),
	(DocumentCashRegisterShift.CashRegister.Warehouse = &amp;Warehouse),
	(DocumentCashRegisterShift.Date &gt;= &amp;BeginOfPeriod),
	(DocumentCashRegisterShift.Date &lt;= &amp;EndOfPeriod)}</query>
	</dataSet>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Okres</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">ThisMonth</v8:variant>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
