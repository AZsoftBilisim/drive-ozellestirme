	<totalField>
		<dataPath>DebtOfSupplier</dataPath>
		<expression>Sum(DebtOfSupplier)</expression>
	</totalField>
	<totalField>
		<dataPath>DaysCount</dataPath>
		<expression>Max(DaysCount)</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompany</dataPath>
		<expression>Sum(AccountsPayableOfCompany)</expression>
	</totalField>
	<totalField>
		<dataPath>OurDebtOverdue</dataPath>
		<expression>Sum(OurDebtOverdue)</expression>
	</totalField>
	<totalField>
		<dataPath>LowerBoundOfInterval</dataPath>
		<expression>Max(LowerBoundOfInterval)</expression>
		<group>Partner</group>
		<group>Partner Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>ToReceive</dataPath>
		<expression>Sum(ToReceive)</expression>
	</totalField>
	<totalField>
		<dataPath>LowerBoundOfInterval</dataPath>
		<expression>Avg(LowerBoundOfInterval)</expression>
	</totalField>
	<totalField>
		<dataPath>OurDebtInTheReportCurrency</dataPath>
		<expression>Sum(OurDebtInTheReportCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>OurDebtOverdueInTheReportCurrency</dataPath>
		<expression>Sum(OurDebtOverdueInTheReportCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>SupplierDebtInTheReportCurrency</dataPath>
		<expression>Sum(SupplierDebtInTheReportCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>ToReceiveInTheReportCurrency</dataPath>
		<expression>Sum(ToReceiveInTheReportCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfOverdueDebt</dataPath>
		<expression>Case When Sum(AccountsPayableOfCompany) &lt;&gt; 0 Then Sum(OurDebtOverdue) / Sum(AccountsPayableOfCompany) * 100 Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfOverdueDebtInReportCurrency</dataPath>
		<expression>Case When Sum(OurDebtInTheReportCurrency) &lt;&gt; 0 Then Sum(OurDebtOverdueInTheReportCurrency) / Sum(OurDebtInTheReportCurrency) * 100 Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtShare</dataPath>
		<expression>Case
    When EvalExpression("Sum(OurDebtInTheReportCurrency)", , "Overall") &lt;&gt; 0
        Then Sum(OurDebtInTheReportCurrency) * 100 / EvalExpression("Sum(OurDebtInTheReportCurrency)", , "Overall")
    Else 0
End</expression>
	</totalField>
