		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.SecondPeriod AS Period,
	CompanyGoods.Recorder AS Recorder,
	CompanyGoods.Organization AS Organization,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Characteristic AS Characteristic,
	DimensionOfProductItem.Purpose AS Purpose,
	DimensionOfProductItem.Series AS Series,
	DimensionOfProductItem.WarehouseArea AS Warehouse,
	DimensionOfProductItem.Contract AS Contract,
	CASE
		WHEN &amp;ReportVariant = "MovementOfGoodsTransferredToCommission25"
			THEN DimensionOfProductItem.Contract.PriceTypeAccountingPriceType
		ELSE &amp;PriceKind
	END AS PriceKind,
	CASE
		WHEN DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
			THEN DimensionOfProductItem.Partner
		ELSE UNDEFINED
	END AS Partner,
	SUM(CompanyGoods.CountOpeningBalance) AS CountOpeningBalance,
	SUM(CompanyGoods.CountReceipt) AS CountReceipt,
	SUM(CompanyGoods.CountExpense) AS CountExpense,
	SUM(CompanyGoods.CountClosingBalance) AS CountClosingBalance
INTO BalanceAndTurnovers
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(, , Auto, , {(ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.Characteristic).* AS Characteristic, (ItemsLocationAttributes.WarehouseArea).* AS Warehouse, (ItemsLocationAttributes.Contract).* AS Contract, (ItemsLocationAttributes.Partner).* AS Partner, ((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS CompanyGoods
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON CompanyGoods.ItemsLocationAttributes = DimensionOfProductItem.Ref
			AND (&amp;ReportVariant = ""
					AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
				OR &amp;ReportVariant = "MovementOfGoodsTransferred"
					AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
					AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.TransferToCustody)
				OR &amp;ReportVariant = "MovementOfGoodsTransferredToCommission25"
					AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
					AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.WithConsignee)
					AND DimensionOfProductItem.Contract.ConsignmentSales25
				)
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.WarehouseArea.* AS Warehouse,
	DimensionOfProductItem.Contract.* AS Contract,
	DimensionOfProductItem.Partner.* AS Partner,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

GROUP BY
	CompanyGoods.SecondPeriod,
	CompanyGoods.Recorder,
	CompanyGoods.Organization,
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Characteristic,
	DimensionOfProductItem.Purpose,
	DimensionOfProductItem.Series,
	DimensionOfProductItem.WarehouseArea,
	DimensionOfProductItem.Contract,
	CASE
		WHEN &amp;ReportVariant = "MovementOfGoodsTransferredToCommission25"
			THEN DimensionOfProductItem.Contract.PriceTypeAccountingPriceType
		ELSE &amp;PriceKind
	END,
	CASE
		WHEN DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
			THEN DimensionOfProductItem.Partner
		ELSE UNDEFINED
	END

UNION ALL

SELECT
	CompanyGoods.SecondPeriod,
	CompanyGoods.Recorder,
	CompanyGoods.Organization,
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Characteristic,
	DimensionOfProductItem.Purpose,
	DimensionOfProductItem.Series,
	DimensionOfProductItem.WarehouseArea,
	DimensionOfProductItem.Contract,
	DimensionOfProductItem.Contract.PriceTypeAccountingPriceType AS PriceKind,
	CASE
		WHEN DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
			THEN DimensionOfProductItem.Partner
		ELSE UNDEFINED
	END AS Partner,
	SUM(CompanyGoods.CountOpeningBalance),
	SUM(CompanyGoods.CountReceipt),
	SUM(CompanyGoods.CountExpense),
	SUM(CompanyGoods.CountClosingBalance)
FROM
	AccumulationRegister.CompanySafeStock.BalanceAndTurnovers(, , Auto, , {(ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.Characteristic).* AS Characteristic, (ItemsLocationAttributes.WarehouseArea).* AS Warehouse, (ItemsLocationAttributes.Contract).* AS Contract, (ItemsLocationAttributes.Partner).* AS Partner, ((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS CompanyGoods
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON CompanyGoods.ItemsLocationAttributes = DimensionOfProductItem.Ref
			AND (&amp;ReportVariant = ""
					AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
				OR &amp;ReportVariant = "MovementOfGoodsTransferred"
					AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
					AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.TransferToCustody)
				OR &amp;ReportVariant = "MovementOfGoodsTransferredToCommission25"
					AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
					AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.WithConsignee)
					AND DimensionOfProductItem.Contract.ConsignmentSales25
				)
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.WarehouseArea.* AS Warehouse,
	DimensionOfProductItem.Contract.* AS Contract,
	DimensionOfProductItem.Partner.* AS Partner,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

GROUP BY
	CompanyGoods.SecondPeriod,
	CompanyGoods.Recorder,
	CompanyGoods.Organization,
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Characteristic,
	DimensionOfProductItem.Purpose,
	DimensionOfProductItem.Series,
	DimensionOfProductItem.WarehouseArea,
	DimensionOfProductItem.Contract,
	DimensionOfProductItem.Contract.PriceTypeAccountingPriceType,
	CASE
		WHEN DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
			THEN DimensionOfProductItem.Partner
		ELSE UNDEFINED
	END
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	T.PriceKind AS PriceKind
INTO TypesOfContractPrices
FROM
	BalanceAndTurnovers AS T

GROUP BY
	T.PriceKind
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Price_Table.Period AS Period,
	Price_Table.Recorder AS Recorder,
	Price_Table.Products AS Products,
	Price_Table.Characteristic AS Characteristic,
	Price_Table.PriceKind AS PriceKind,
	&amp;CurrentPrice AS Price,
	&amp;OldPrice AS OldPrice,
	&amp;Delta AS Delta
INTO ChangesOfPrices
FROM
	(SELECT
		MAX(ItemsPrices.Period) AS Period,
		MAX(PricesBeforeChanges.Period) AS DateOfLastChange,
		ItemsPrices.Recorder AS Recorder,
		ItemsPrices.PriceKind AS PriceKind,
		ItemsPrices.Products AS Products,
		ItemsPrices.Characteristic AS Characteristic
	FROM
		InformationRegister.ItemsPrices AS ItemsPrices
			LEFT JOIN InformationRegister.ItemsPrices AS PricesBeforeChanges
			ON ItemsPrices.Period &gt; PricesBeforeChanges.Period
				AND ItemsPrices.Products = PricesBeforeChanges.Products
				AND ItemsPrices.Characteristic = PricesBeforeChanges.Characteristic
				AND PricesBeforeChanges.PriceKind IN
						(SELECT
							T.PriceKind
						FROM
							TypesOfContractPrices AS T)
	WHERE
		ItemsPrices.PriceKind IN
				(SELECT
					T.PriceKind
				FROM
					TypesOfContractPrices AS T)
	{WHERE
		ItemsPrices.Products.* AS Products,
		ItemsPrices.Characteristic.* AS Characteristic,
		ItemsPrices.Period &lt;= &amp;EndOfPeriod}
	
	GROUP BY
		ItemsPrices.Recorder,
		ItemsPrices.PriceKind,
		ItemsPrices.Products,
		ItemsPrices.Characteristic
		
	) AS Price_Table
		LEFT JOIN InformationRegister.ItemsPrices AS PricesOfProduct
		ON Price_Table.Period = PricesOfProduct.Period
			AND Price_Table.Products = PricesOfProduct.Products
			AND Price_Table.Characteristic = PricesOfProduct.Characteristic
			AND Price_Table.PriceKind = PricesOfProduct.PriceKind
		LEFT JOIN InformationRegister.ItemsPrices AS PricesOfProductB
		ON Price_Table.DateOfLastChange = PricesOfProductB.Period
			AND Price_Table.Products = PricesOfProductB.Products
			AND Price_Table.Characteristic = PricesOfProductB.Characteristic
			AND Price_Table.PriceKind = PricesOfProductB.PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ChangesOfPrices.Period AS Period,
	ChangesOfPrices.Recorder AS Recorder,
	ChangesOfPrices.PriceKind AS PriceKind,
	ChangesOfPrices.Delta AS Delta,
	ChangesOfPrices.Price AS Price,
	ChangesOfPrices.OldPrice AS OldPrice,
	ChangesOfPrices.Products AS Products,
	ChangesOfPrices.Characteristic AS Characteristic,
	GoodsOfOrganizationsBalancesAndTurnover.Warehouse AS Warehouse,
	GoodsOfOrganizationsBalancesAndTurnover.Contract AS Contract,
	GoodsOfOrganizationsBalancesAndTurnover.Partner AS Partner,
	GoodsOfOrganizationsBalancesAndTurnover.Organization AS Organization,
	GoodsOfOrganizationsBalancesAndTurnover.Purpose AS Purpose,
	GoodsOfOrganizationsBalancesAndTurnover.Series AS Series,
	MAX(GoodsOfOrganizationsBalancesAndTurnover.Period) AS PeriodMaximum
INTO NearestRemnantsByProductType
FROM
	ChangesOfPrices AS ChangesOfPrices
		LEFT JOIN BalanceAndTurnovers AS GoodsOfOrganizationsBalancesAndTurnover
		ON ChangesOfPrices.Period &gt;= GoodsOfOrganizationsBalancesAndTurnover.Period
			AND ChangesOfPrices.Products = GoodsOfOrganizationsBalancesAndTurnover.Products
			AND ChangesOfPrices.Characteristic = GoodsOfOrganizationsBalancesAndTurnover.Characteristic
			AND ChangesOfPrices.PriceKind = GoodsOfOrganizationsBalancesAndTurnover.PriceKind

GROUP BY
	ChangesOfPrices.Period,
	ChangesOfPrices.Recorder,
	ChangesOfPrices.PriceKind,
	ChangesOfPrices.Delta,
	ChangesOfPrices.Price,
	ChangesOfPrices.OldPrice,
	ChangesOfPrices.Products,
	ChangesOfPrices.Characteristic,
	GoodsOfOrganizationsBalancesAndTurnover.Purpose,
	GoodsOfOrganizationsBalancesAndTurnover.Series,
	GoodsOfOrganizationsBalancesAndTurnover.Warehouse,
	GoodsOfOrganizationsBalancesAndTurnover.Contract,
	GoodsOfOrganizationsBalancesAndTurnover.Partner,
	GoodsOfOrganizationsBalancesAndTurnover.Organization

HAVING
	NOT MAX(GoodsOfOrganizationsBalancesAndTurnover.Period) IS NULL
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	MAX(T.Recorder) AS Recorder,
	T.Period AS Period,
	T.Products AS Products,
	T.Characteristic AS Characteristic,
	T.Purpose AS Purpose,
	T.Series AS Series,
	T.Warehouse AS Warehouse,
	T.Contract AS Contract,
	T.Organization AS Organization,
	T.PriceKind AS PriceKind
INTO RegistrarMaximumByPeriod
FROM
	BalanceAndTurnovers AS T
WHERE
	(T.Period, T.Products, T.Characteristic, T.Purpose, T.Series, T.Warehouse, T.Contract, T.Organization, T.PriceKind) IN
			(SELECT
				T.PeriodMaximum,
				T.Products,
				T.Characteristic,
				T.Purpose,
				T.Series,
				T.Warehouse,
				T.Contract,
				T.Organization,
				T.PriceKind
			FROM
				NearestRemnantsByProductType AS T)

GROUP BY
	T.Period,
	T.Products,
	T.Characteristic,
	T.Purpose,
	T.Series,
	T.Warehouse,
	T.Contract,
	T.Organization,
	T.PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	T.Period AS Period,
	T.Recorder AS Recorder,
	T.Delta AS Delta,
	T.PriceKind AS PriceKind,
	T.Price AS Price,
	T.OldPrice AS OldPrice,
	T.Products AS Products,
	T.Characteristic AS Characteristic,
	T.Purpose AS Purpose,
	T.Series AS Series,
	T.Warehouse AS Warehouse,
	T.Contract AS Contract,
	T.Partner AS Partner,
	T.Organization AS Organization,
	T.PeriodMaximum AS PeriodMaximum,
	RegistrarMaximumByPeriod.Recorder AS LoggerMax
INTO NearestRemnantsByProductName
FROM
	NearestRemnantsByProductType AS T
		LEFT JOIN RegistrarMaximumByPeriod AS RegistrarMaximumByPeriod
		ON T.Products = RegistrarMaximumByPeriod.Products
			AND T.Characteristic = RegistrarMaximumByPeriod.Characteristic
			AND T.Purpose = RegistrarMaximumByPeriod.Purpose
			AND T.Series = RegistrarMaximumByPeriod.Series
			AND T.Warehouse = RegistrarMaximumByPeriod.Warehouse
			AND T.Contract = RegistrarMaximumByPeriod.Contract
			AND T.Organization = RegistrarMaximumByPeriod.Organization
			AND T.PeriodMaximum = RegistrarMaximumByPeriod.Period
			AND T.PriceKind = RegistrarMaximumByPeriod.PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CompanyGoods.Period AS MovementPeriod,
	CompanyGoods.Recorder AS Recorder,
	CompanyGoods.Products AS Products,
	CompanyGoods.Characteristic AS Characteristic,
	CompanyGoods.Purpose AS Purpose,
	CompanyGoods.Series AS Series,
	CompanyGoods.Warehouse AS Warehouse,
	CompanyGoods.Contract AS Contract,
	CompanyGoods.PriceKind AS PriceKind,
	CompanyGoods.Partner AS Partner,
	CompanyGoods.Organization AS Organization,
	CompanyGoods.CountOpeningBalance AS CountOpeningBalance,
	CompanyGoods.CountReceipt AS CountReceipt,
	CompanyGoods.CountExpense AS CountExpense,
	CompanyGoods.CountClosingBalance AS CountClosingBalance,
	MAX(ItemsPrices.Period) AS PeriodMaximum
INTO TableProductsOfOrganizationsMaximumPeriod
FROM
	BalanceAndTurnovers AS CompanyGoods
		LEFT JOIN ChangesOfPrices AS ItemsPrices
		ON CompanyGoods.Products = ItemsPrices.Products
			AND CompanyGoods.Characteristic = ItemsPrices.Characteristic
			AND CompanyGoods.Period &gt; ItemsPrices.Period
			AND CompanyGoods.PriceKind = ItemsPrices.PriceKind

GROUP BY
	CompanyGoods.Period,
	CompanyGoods.Recorder,
	CompanyGoods.Products,
	CompanyGoods.Characteristic,
	CompanyGoods.Purpose,
	CompanyGoods.Series,
	CompanyGoods.Warehouse,
	CompanyGoods.Contract,
	CompanyGoods.PriceKind,
	CompanyGoods.Partner,
	CompanyGoods.Organization,
	CompanyGoods.CountOpeningBalance,
	CompanyGoods.CountReceipt,
	CompanyGoods.CountExpense,
	CompanyGoods.CountClosingBalance
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TypesOfPrices.PriceCurrency AS Currency,
	TableProductsOfOrganizationsMaximumPeriod.MovementPeriod AS SecondPeriod,
	BEGINOFPERIOD(TableProductsOfOrganizationsMaximumPeriod.MovementPeriod, MINUTE) AS MinutePeriod,
	BEGINOFPERIOD(TableProductsOfOrganizationsMaximumPeriod.MovementPeriod, HOUR) AS HourPeriod,
	BEGINOFPERIOD(TableProductsOfOrganizationsMaximumPeriod.MovementPeriod, DAY) AS DayPeriod,
	BEGINOFPERIOD(TableProductsOfOrganizationsMaximumPeriod.MovementPeriod, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(TableProductsOfOrganizationsMaximumPeriod.MovementPeriod, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(TableProductsOfOrganizationsMaximumPeriod.MovementPeriod, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(TableProductsOfOrganizationsMaximumPeriod.MovementPeriod, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(TableProductsOfOrganizationsMaximumPeriod.MovementPeriod, YEAR) AS YearPeriod,
	CASE
		WHEN TableProductsOfOrganizationsMaximumPeriod.Recorder = UNDEFINED
			THEN NULL
		ELSE TableProductsOfOrganizationsMaximumPeriod.Recorder
	END AS Recorder,
	TableProductsOfOrganizationsMaximumPeriod.Warehouse AS Warehouse,
	TableProductsOfOrganizationsMaximumPeriod.Contract AS Contract,
	TableProductsOfOrganizationsMaximumPeriod.Partner AS Partner,
	TableProductsOfOrganizationsMaximumPeriod.Organization AS Organization,
	TableProductsOfOrganizationsMaximumPeriod.Products AS Products,
	TableProductsOfOrganizationsMaximumPeriod.Characteristic AS Characteristic,
	TableProductsOfOrganizationsMaximumPeriod.Purpose AS Purpose,
	TableProductsOfOrganizationsMaximumPeriod.Series AS Series,
	CASE
		WHEN ItemsPrices.Price IS NULL
			THEN FALSE
		ELSE TRUE
	END AS PriceIsSet,
	ISNULL(TableProductsOfOrganizationsMaximumPeriod.CountOpeningBalance, 0) AS CountOpeningBalance,
	ISNULL(TableProductsOfOrganizationsMaximumPeriod.CountReceipt, 0) AS CountReceipt,
	ISNULL(TableProductsOfOrganizationsMaximumPeriod.CountExpense, 0) AS CountExpense,
	ISNULL(TableProductsOfOrganizationsMaximumPeriod.CountClosingBalance, 0) AS CountClosingBalance,
	ISNULL(ItemsPrices.Price * TableProductsOfOrganizationsMaximumPeriod.CountOpeningBalance, 0) AS SumOpeningBalance,
	ISNULL(ItemsPrices.Price * TableProductsOfOrganizationsMaximumPeriod.CountReceipt, 0) AS SumReceipt,
	ISNULL(ItemsPrices.Price * TableProductsOfOrganizationsMaximumPeriod.CountExpense, 0) AS SumExpense,
	ISNULL(ItemsPrices.Price * TableProductsOfOrganizationsMaximumPeriod.CountClosingBalance, 0) AS SumClosingBalance
FROM
	TableProductsOfOrganizationsMaximumPeriod AS TableProductsOfOrganizationsMaximumPeriod
		LEFT JOIN ChangesOfPrices AS ItemsPrices
		ON TableProductsOfOrganizationsMaximumPeriod.Products = ItemsPrices.Products
			AND TableProductsOfOrganizationsMaximumPeriod.Characteristic = ItemsPrices.Characteristic
			AND TableProductsOfOrganizationsMaximumPeriod.PeriodMaximum = ItemsPrices.Period
			AND TableProductsOfOrganizationsMaximumPeriod.PriceKind = ItemsPrices.PriceKind
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = TableProductsOfOrganizationsMaximumPeriod.PriceKind
{WHERE
	TableProductsOfOrganizationsMaximumPeriod.Products.* AS Products,
	TableProductsOfOrganizationsMaximumPeriod.Characteristic.* AS Characteristic}

UNION ALL

SELECT
	TypesOfPrices.PriceCurrency,
	NearestRemnantsByProductName.Period,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, MINUTE),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, HOUR),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, DAY),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, WEEK),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, TENDAYS),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, MONTH),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, QUARTER),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, YEAR),
	CASE
		WHEN NearestRemnantsByProductName.Recorder = UNDEFINED
			THEN NULL
		ELSE NearestRemnantsByProductName.Recorder
	END,
	NearestRemnantsByProductName.Warehouse,
	NearestRemnantsByProductName.Contract,
	NearestRemnantsByProductName.Partner,
	NearestRemnantsByProductName.Organization,
	NearestRemnantsByProductName.Products,
	NearestRemnantsByProductName.Characteristic,
	NearestRemnantsByProductName.Purpose,
	NearestRemnantsByProductName.Series,
	CASE
		WHEN NearestRemnantsByProductName.Price IS NULL
			THEN FALSE
		ELSE TRUE
	END AS PriceIsSet,
	ISNULL(GoodsOfOrganizationsBalancesAndTurnover.CountClosingBalance, 0),
	0,
	0,
	ISNULL(GoodsOfOrganizationsBalancesAndTurnover.CountClosingBalance, 0),
	ISNULL(NearestRemnantsByProductName.OldPrice * GoodsOfOrganizationsBalancesAndTurnover.CountClosingBalance, 0),
	CASE
		WHEN NearestRemnantsByProductName.Delta &gt; 0
			THEN ISNULL(NearestRemnantsByProductName.Delta * GoodsOfOrganizationsBalancesAndTurnover.CountClosingBalance, 0)
		ELSE 0
	END,
	CASE
		WHEN NearestRemnantsByProductName.Delta &lt; 0
			THEN ISNULL(-NearestRemnantsByProductName.Delta * GoodsOfOrganizationsBalancesAndTurnover.CountClosingBalance, 0)
		ELSE 0
	END,
	ISNULL(NearestRemnantsByProductName.Price * GoodsOfOrganizationsBalancesAndTurnover.CountClosingBalance, 0)
FROM
	NearestRemnantsByProductName AS NearestRemnantsByProductName
		LEFT JOIN BalanceAndTurnovers AS GoodsOfOrganizationsBalancesAndTurnover
		ON NearestRemnantsByProductName.PeriodMaximum = GoodsOfOrganizationsBalancesAndTurnover.Period
			AND NearestRemnantsByProductName.LoggerMax = GoodsOfOrganizationsBalancesAndTurnover.Recorder
			AND NearestRemnantsByProductName.Products = GoodsOfOrganizationsBalancesAndTurnover.Products
			AND NearestRemnantsByProductName.Characteristic = GoodsOfOrganizationsBalancesAndTurnover.Characteristic
			AND NearestRemnantsByProductName.Purpose = GoodsOfOrganizationsBalancesAndTurnover.Purpose
			AND NearestRemnantsByProductName.Series = GoodsOfOrganizationsBalancesAndTurnover.Series
			AND NearestRemnantsByProductName.Warehouse = GoodsOfOrganizationsBalancesAndTurnover.Warehouse
			AND NearestRemnantsByProductName.Contract = GoodsOfOrganizationsBalancesAndTurnover.Contract
			AND NearestRemnantsByProductName.Organization = GoodsOfOrganizationsBalancesAndTurnover.Organization
			AND NearestRemnantsByProductName.PriceKind = GoodsOfOrganizationsBalancesAndTurnover.PriceKind
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON TypesOfPrices.Ref = NearestRemnantsByProductName.PriceKind
WHERE
	GoodsOfOrganizationsBalancesAndTurnover.CountClosingBalance &lt;&gt; 0
{WHERE
	GoodsOfOrganizationsBalancesAndTurnover.Products.* AS Products,
	GoodsOfOrganizationsBalancesAndTurnover.Characteristic.* AS Characteristic,
	GoodsOfOrganizationsBalancesAndTurnover.Period &lt;= &amp;EndOfPeriod}</query>
	</dataSet>
