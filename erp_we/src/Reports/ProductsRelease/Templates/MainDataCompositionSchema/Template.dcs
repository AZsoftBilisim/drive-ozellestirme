		<field xsi:type="DataSetFieldField">
			<dataPath>Recorder</dataPath>
			<field>Recorder</field>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// !!! TAGS ARE USED !!!

SELECT ALLOWED
	OutputTurnover_.Organization AS Organization,
	OutputTurnover_.ItemsLocationAttributes.Products AS Products,
	OutputTurnover_.ItemsLocationAttributes.Characteristic AS Characteristic,
	OutputTurnover_.ItemsLocationAttributes.Series AS Series,
	ProductAttributes.UnitOfMeasure AS StorageUnit,
	ProductAttributes.UnitForReports AS UnitForReports,
	ProductAttributes.AnalyticalGroup AS ProductsGroup,
	OutputTurnover_.Department AS ManufacturerDivision,
	CASE
		WHEN TRUE
			THEN UNDEFINED
	END AS Toller,
	OutputTurnover_.ItemsLocationAttributes AS ItemsLocationAttributes,
	OutputTurnover_.ReferenceOrder AS ReferenceOrder,
	OutputTurnover_.Recorder AS Recorder,
	CASE
		WHEN TRUE
			THEN NULL
	END	AS DocumentOfProductionIssue,
	CASE


		WHEN TRUE
			THEN UNDEFINED
	END AS ProductionOrder21,
	CASE
		WHEN OutputTurnover_.ReferenceOrder REFS Document.ProductionStage2_2
			THEN CAST(OutputTurnover_.ReferenceOrder AS Document.ProductionStage2_2).ReferenceOrder
		WHEN TRUE
			THEN UNDEFINED
	END AS ProductionOrder,
	OutputTurnover_.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	OutputTurnover_.BillOfMaterials AS BillOfMaterials,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN OutputTurnover_.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN OutputTurnover_.ItemsLocationAttributes.Products.UnitFactorForReports &lt;&gt; 0
						THEN OutputTurnover_.CountTurnover / OutputTurnover_.ItemsLocationAttributes.Products.UnitFactorForReports
					ELSE 0
				END
	END AS Released,
	CASE
		WHEN OutputTurnover_.ExpenseItem NOT IN(
				UNDEFINED,
				VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef),
				VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
			THEN OutputTurnover_.CountTurnover
		ELSE 0
	END AS WrittenOffAsExpenses,
	CASE
		WHEN OutputTurnover_.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
			THEN VALUE(Enum.BusinessTransactions.ProductsReleaseToBusinessUnit)
		ELSE VALUE(Enum.BusinessTransactions.ProductsReleaseToWarehouse)
	END AS DirectionOfProductionIssue,
	CASE
		WHEN OutputTurnover_.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
			THEN 2
		ELSE 1
	END AS DirectionAndOrder,
	OutputTurnover_.ItemsLocationAttributes.StorageLocation AS Recipient,
	CASE
		WHEN OutputTurnover_.ExpenseItem REFS ChartOfCharacteristicTypes.ExpenseItems
			THEN OutputTurnover_.DimensionOfExpenses
		ELSE OutputTurnover_.AssetsLiabilitiesDimension
	END AS DimensionOfExpenses,
	OutputTurnover_.ExpenseItem,
	OutputTurnover_.InventoryOwnerAttribute.InventoryType AS InventoryType
FROM
	AccumulationRegister.ProductsRelease.Turnovers(, , Recorder) AS OutputTurnover_
	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	ON OutputTurnover_.ItemsLocationAttributes = Dimension.Ref
	LEFT JOIN Catalog.Products AS ProductAttributes
	ON Dimension.Products = ProductAttributes.Ref
	
	
	</query>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        Products.UnitOfMeasure
    When &amp;QuantityUnits = 1 Then
        Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità di misura</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>J. m.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ед. изм.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ölçü birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị tính</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        StorageUnit
    When &amp;QuantityUnits = 1 Then
        UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị tính báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>Released</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(Released)
End</expression>
	</totalField>
	<totalField>
		<dataPath>WrittenOffAsExpenses</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(WrittenOffAsExpenses)
End</expression>
	</totalField>
