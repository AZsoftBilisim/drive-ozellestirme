		<dataSource>DataSource1</dataSource>
		<query>SELECT
	BEGINOFPERIOD(&amp;BeginOfPeriod, MONTH) AS Period
INTO PeriodsByMonth
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	MAX(Standards.Date) AS Date,
	Standards.Organization AS Organization,
	Standards.Department AS Department,
	PeriodsByMonth.Period AS Period
INTO LatestRegulatoryDates
FROM
	PeriodsByMonth AS PeriodsByMonth
		LEFT JOIN Document.SetProductionExpenseStandards AS Standards
		ON PeriodsByMonth.Period &gt;= Standards.ValidityStartDate
		AND NOT Standards.DeletionMark
{WHERE
	Standards.Organization.*,
	Standards.Department.*}
GROUP BY
	PeriodsByMonth.Period,
	Standards.Organization,
	Standards.Department

INDEX BY
	Date,
	Organization,
	Department
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	LatestRegulatoryDates.Period AS Period,
	LatestRegulatoryDates.Organization AS Organization,
	LatestRegulatoryDates.Department AS Department,
	MAX(Standards.Ref) AS Ref
INTO CurrentDocumentsByPeriod
FROM
	LatestRegulatoryDates AS LatestRegulatoryDates
		INNER JOIN Document.SetProductionExpenseStandards AS Standards
		ON LatestRegulatoryDates.Date = Standards.Date
		AND LatestRegulatoryDates.Organization = Standards.Organization
		AND LatestRegulatoryDates.Department = Standards.Department
		AND NOT Standards.DeletionMark
GROUP BY
	LatestRegulatoryDates.Period,
	LatestRegulatoryDates.Organization,
	LatestRegulatoryDates.Department
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CostAllocationRulesFilterByMaterials.Ref AS Ref,
	CostAllocationRulesFilterByMaterials.Material AS SelectionPosition
INTO SelectionPositions
FROM
	Catalog.CostAllocationRules.FilterByMaterials AS CostAllocationRulesFilterByMaterials

UNION ALL

SELECT
	CostAllocationRulesFilterByActivityKind.Ref,
	CostAllocationRulesFilterByActivityKind.WorkKind
FROM
	Catalog.CostAllocationRules.FilterByActivityKind AS CostAllocationRulesFilterByActivityKind

UNION ALL

SELECT
	CostAllocationRulesFilterByProducts.Ref,
	CostAllocationRulesFilterByProducts.ManufacturedProduct
FROM
	Catalog.CostAllocationRules.FilterByProducts AS CostAllocationRulesFilterByProducts
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	OtherWorkInProgressExpensesTurnovers.Organization AS Organization,
	OtherWorkInProgressExpensesTurnovers.Department AS Department,
	OtherWorkInProgressExpensesTurnovers.ExpenseItem AS ExpenseItem,
	BEGINOFPERIOD(OtherWorkInProgressExpensesTurnovers.Period, MONTH) AS Period,
	OtherWorkInProgressExpensesTurnovers.CostReceipt AS Cost,
	OtherWorkInProgressExpensesTurnovers.ProductCostElement AS ProductCostElement,
	ISNULL(ItemByItemCostAllocationSettings_CostAllocationRules.Ref,
		OtherWorkInProgressExpensesTurnovers.ExpenseItem.CostAllocationRuleManag) AS
		AllocatedAccordingToRule,
	ISNULL(ItemByItemCostAllocationSettings_CostAllocationRules.BaseOfAllocationByLots,
		OtherWorkInProgressExpensesTurnovers.ExpenseItem.CostAllocationRuleManag.BaseOfAllocationByLots) AS
		AllocationBase,
	ISNULL(SelectionPositions.SelectionPosition, UNDEFINED) AS SelectionPosition
INTO AmountsByItem
FROM
	AccumulationRegister.OtherWorkInProgressExpenses.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Month,
		{(Organization).*} {(Department).*} {(ExpenseItem).*} {(ProductCostElement).*}) AS
		OtherWorkInProgressExpensesTurnovers
		LEFT JOIN SelectionPositions AS SelectionPositions
		ON OtherWorkInProgressExpensesTurnovers.ExpenseItem.CostAllocationRuleManag = SelectionPositions.Ref
		LEFT JOIN InformationRegister.SettingsOfItemizedExpensesAllocation AS
			SettingsOfItemizedExpensesAllocation
		ON OtherWorkInProgressExpensesTurnovers.ExpenseItem = SettingsOfItemizedExpensesAllocation.ExpenseItem
		AND OtherWorkInProgressExpensesTurnovers.Organization = SettingsOfItemizedExpensesAllocation.Organization
		AND
			OtherWorkInProgressExpensesTurnovers.Department = SettingsOfItemizedExpensesAllocation.Department
		LEFT JOIN Catalog.CostAllocationRules AS
			ItemByItemCostAllocationSettings_CostAllocationRules
		ON SettingsOfItemizedExpensesAllocation.SettingsManAccounting = ItemByItemCostAllocationSettings_CostAllocationRules.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(DD.Period, MONTH) AS Period,
	DD.Organization AS Organization,
	DD.Department AS Department,
	DD.WorkKind AS WorkKind,
	DD.CountReceipt AS Count,
	DD.StandardCostReceipt AS StandardCost,
	DD.CostReceipt AS Cost
INTO DataOnLaborCosts
FROM
	AccumulationRegister.WIPLaborCosts.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Month,
		ProductionLot &lt;&gt; UNDEFINED {(Organization).*} {(Department).*}) AS DD

INDEX BY
	Period,
	Organization,
	Department
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(DD.Period, MONTH) AS Period,
	DD.Organization AS Organization,
	Dimension.StorageLocation AS Department,
	Dimension.Products AS Products,
	SUM(DD.Cost) AS Cost,
	SUM(DD.Count) AS Count,
	SUM(&amp;VolumeM3 * DD.Count) AS VolumeM3,
	SUM(&amp;Weight * DD.Count) AS Weight
INTO DataOnMaterialCosts
FROM
	AccumulationRegister.InventoryCost AS DD
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
		ON Dimension.Ref = DD.ItemsLocationAttributes
		AND Dimension.ProductCostElement &lt;&gt; VALUE(Catalog.ProductCostElements.EmptyRef)
		INNER JOIN Catalog.Products AS SN
		ON Dimension.Products = SN.Ref
WHERE
	DD.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND DD.RecordType = VALUE(AccumulationRecordType.Receipt)
	AND DD.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ExpensingToProductionLots),
		VALUE(Enum.BusinessTransactions.AllocationOfExpensesForProductionLots),
		VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost))
{WHERE
	DD.Organization.*,
	Dimension.StorageLocation.* AS Department}
GROUP BY
	BEGINOFPERIOD(DD.Period, MONTH),
	DD.Organization,
	Dimension.StorageLocation,
	Dimension.Products

INDEX BY
	Period,
	Organization,
	Department
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DD.Organization AS Organization,
	DD.Department AS Department,
	&amp;VolumeM3 * DD.CountTurnover AS VolumeM3,
	DD.Period AS Period,
	DD.ItemsLocationAttributes.Products AS Products,
	DD.ItemsLocationAttributes.Characteristic AS Characteristic,
	CASE
		WHEN &amp;UsePriceManagementSystem25
			THEN ISNULL(CASE
				WHEN
					ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
					THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
				ELSE DD.ItemsLocationAttributes.Characteristic.ItemsCharacteristicForPricing
			END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		ELSE NULL
	END AS PricingVariant,
	CASE
		WHEN &amp;UsePriceManagementSystem25
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		ELSE NULL
	END AS PricingBatch,
	CASE
		WHEN &amp;UsePriceManagementSystem25
			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		ELSE NULL
	END AS PricingPackage,
	&amp;Weight * DD.CountTurnover AS Weight,
	DD.CountTurnover AS Count
INTO ProductDataWithoutCost
FROM
	AccumulationRegister.ProductsRelease.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Day, {(Organization).*}
		{(Department).*}) AS DD
		INNER JOIN Catalog.Products AS SN
		ON DD.ItemsLocationAttributes.Products = SN.Ref
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON ItemKinds.Ref = DD.ItemsLocationAttributes.Products.ProductKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductData_6.Period AS Period,
	PSCurrency.Value AS PSCurrency,
	CurrencyMA.Value AS CurrencyMA,
	MAX(PSCurrencyRates.Period) AS LastPSPeriod,
	MAX(MaExchangeRates_.Period) AS LastPeriodOfMa
INTO CoursePeriods
FROM
	ProductDataWithoutCost AS ProductData_6
		LEFT JOIN Constant.PlannedPriceCurrencyOfProductsMaterialsAndLabor AS PSCurrency
		ON TRUE
		LEFT JOIN Constant.ManagementAccountingCurrency AS CurrencyMA
		ON TRUE
		LEFT JOIN InformationRegister.RelativeExchangeRates AS PSCurrencyRates
		ON PSCurrencyRates.Currency = PSCurrency.Value
		AND PSCurrencyRates.BaseCurrency = ProductData_6.Organization.LocalAccountingCurrency
		AND PSCurrencyRates.Period &lt;= ProductData_6.Period
		LEFT JOIN InformationRegister.RelativeExchangeRates AS MaExchangeRates_
		ON MaExchangeRates_.Currency = CurrencyMA.Value
		AND MaExchangeRates_.BaseCurrency = ProductData_6.Organization.LocalAccountingCurrency
		AND MaExchangeRates_.Period &lt;= ProductData_6.Period
GROUP BY
	ProductData_6.Period,
	PSCurrency.Value,
	CurrencyMA.Value
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductData_6.Period AS Period,
	ProductData_6.Products AS Products,
	ProductData_6.Characteristic AS Characteristic,
	NULL AS PricingVariant,
	NULL AS PricingBatch,
	NULL AS PricingPackage,
	Prices.PriceKind AS PriceKind,
	MAX(Prices.Period) AS LastPeriod
INTO PricePeriods
FROM
	ProductDataWithoutCost AS ProductData_6
		INNER JOIN Constant.PriceKindOfPlannedCostOfMaterialsAndWorks AS TypeOfPSPrice
		ON TRUE
		LEFT JOIN InformationRegister.ItemsPrices AS Prices
		ON ProductData_6.Products = Prices.Products
		AND ProductData_6.Characteristic = Prices.Characteristic
		AND Prices.PriceKind = TypeOfPSPrice.Value
		AND Prices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		AND Prices.Period &lt;= ProductData_6.Period
WHERE
	CASE
		WHEN &amp;UsePriceManagementSystem25
			THEN Prices.Period &lt; &amp;DateOfTransitionToPricingVersion25
		ELSE TRUE
	END
GROUP BY
	ProductData_6.Period,
	ProductData_6.Products,
	ProductData_6.Characteristic,
	Prices.PriceKind

UNION ALL

SELECT
	ProductData_6.Period AS Period,
	ProductData_6.Products AS Products,
	ProductData_6.Characteristic AS Characteristic,
	ProductData_6.PricingVariant AS PricingVariant,
	ProductData_6.PricingBatch AS PricingBatch,
	ProductData_6.PricingPackage AS PricingPackage,
	Prices.PriceKind AS PriceKind,
	MAX(Prices.Period) AS LastPeriod
FROM
	ProductDataWithoutCost AS ProductData_6
		INNER JOIN Constant.PriceKindOfPlannedCostOfMaterialsAndWorks AS TypeOfPSPrice
		ON TRUE
		LEFT JOIN InformationRegister.ItemsPrices25 AS Prices
		ON ProductData_6.Products = Prices.Products
		AND ProductData_6.PricingVariant = Prices.PricingVariant
		AND ProductData_6.PricingBatch = Prices.PricingBatch
		AND ProductData_6.PricingPackage = Prices.PricingPackage
		AND Prices.PriceKind = TypeOfPSPrice.Value
		AND Prices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		AND Prices.Period &lt;= ProductData_6.Period
WHERE
	CASE
		WHEN &amp;UsePriceManagementSystem25
			THEN Prices.Period &gt;= &amp;DateOfTransitionToPricingVersion25
		ELSE FALSE
	END
GROUP BY
	ProductData_6.Period,
	ProductData_6.Products,
	ProductData_6.Characteristic,
	ProductData_6.PricingVariant,
	ProductData_6.PricingBatch,
	ProductData_6.PricingPackage,
	Prices.PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductData_6.Organization.RegistrationCountry AS RegistrationCountry,
	ProductData_6.Products AS Products,
	MAX(ProductsVATRates.Period) AS Period
INTO PeriodsOfProductVATRates
FROM
	ProductDataWithoutCost AS ProductData_6
		LEFT JOIN InformationRegister.ProductsVATRates AS ProductsVATRates
		ON ProductData_6.Organization.RegistrationCountry = ProductsVATRates.Country
		AND ProductData_6.Products = ProductsVATRates.Products
		AND ProductData_6.Period &gt;= ProductsVATRates.Period
GROUP BY
	ProductData_6.Organization.RegistrationCountry,
	ProductData_6.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductData_6.Organization.RegistrationCountry AS RegistrationCountry,
	MAX(BasicVATRates.Period) AS Period
INTO PeriodsOfBasicVATRates
FROM
	ProductDataWithoutCost AS ProductData_6
		LEFT JOIN InformationRegister.BasicVATRates AS BasicVATRates
		ON ProductData_6.Organization.RegistrationCountry = BasicVATRates.Country
		AND ProductData_6.Period &gt;= BasicVATRates.Period
GROUP BY
	ProductData_6.Organization.RegistrationCountry
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(Data.Period, MONTH) AS Period,
	Data.Organization AS Organization,
	Data.Department AS Department,
	Data.Products AS Products,
	SUM(Data.VolumeM3) AS VolumeM3,
	SUM(Data.Weight) AS Weight,
	SUM(Data.Count) AS Count,
	SUM(ISNULL(ISNULL(Prices.Price, Prices25.Price), 0) * CASE
		WHEN Prices.Currency = MaExchangeRates_.Currency
			THEN 1
		ELSE CASE
			WHEN ISNULL(PSCurrencyRates.CourseDenominator, 0) * MaExchangeRates_.CourseNumerator = 0
				THEN 1
			ELSE PSCurrencyRates.CourseNumerator * MaExchangeRates_.CourseDenominator / (PSCurrencyRates.CourseDenominator *
				MaExchangeRates_.CourseNumerator)
		END
	END * CASE
		WHEN PricePeriods.PriceKind.Ref IS NULL
			THEN 1
		WHEN PricePeriods.PriceKind.PriceIncludesVAT
			THEN 1
		ELSE ((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate,
			VALUE(Catalog.VATRates.EmptyRef)))).Rate1 + 100) / 100
	END * Data.Count) AS Cost
INTO ProductData_6
FROM
	ProductDataWithoutCost AS Data
		LEFT JOIN CoursePeriods AS CoursePeriods
		ON Data.Period = CoursePeriods.Period
		LEFT JOIN InformationRegister.RelativeExchangeRates AS PSCurrencyRates
		ON PSCurrencyRates.Currency = CoursePeriods.PSCurrency
		AND PSCurrencyRates.BaseCurrency = Data.Organization.LocalAccountingCurrency
		AND PSCurrencyRates.Period &lt;= CoursePeriods.LastPSPeriod
		LEFT JOIN InformationRegister.RelativeExchangeRates AS MaExchangeRates_
		ON MaExchangeRates_.Currency = CoursePeriods.CurrencyMA
		AND MaExchangeRates_.BaseCurrency = Data.Organization.LocalAccountingCurrency
		AND MaExchangeRates_.Period &lt;= CoursePeriods.LastPeriodOfMa
		LEFT JOIN PricePeriods AS PricePeriods
		ON Data.Period = PricePeriods.Period
		AND Data.Products = PricePeriods.Products
		AND Data.Characteristic = PricePeriods.Characteristic
		LEFT JOIN InformationRegister.ItemsPrices AS Prices
		ON PricePeriods.Products = Prices.Products
		AND PricePeriods.Characteristic = Prices.Characteristic
		AND PricePeriods.PriceKind = Prices.PriceKind
		AND PricePeriods.LastPeriod = Prices.Period
		LEFT JOIN InformationRegister.ItemsPrices25 AS Prices25
		ON PricePeriods.Products = Prices25.Products
		AND PricePeriods.PricingVariant = Prices25.PricingVariant
		AND PricePeriods.PricingBatch = Prices25.PricingBatch
		AND PricePeriods.PricingPackage = Prices25.PricingPackage
		AND PricePeriods.PriceKind = Prices25.PriceKind
		AND PricePeriods.LastPeriod = Prices25.Period
		LEFT JOIN PeriodsOfProductVATRates AS PeriodsOfProductVATRates
		ON Data.Period = PeriodsOfProductVATRates.Period
		AND Data.Products = PeriodsOfProductVATRates.Products
		AND Data.Organization.RegistrationCountry = PeriodsOfProductVATRates.RegistrationCountry
		LEFT JOIN InformationRegister.ProductsVATRates AS ProductsVATRates
		ON PeriodsOfProductVATRates.RegistrationCountry = ProductsVATRates.Country
		AND PeriodsOfProductVATRates.Products = ProductsVATRates.Products
		AND PeriodsOfProductVATRates.Period = ProductsVATRates.Period
		LEFT JOIN PeriodsOfBasicVATRates AS PeriodsOfBasicVATRates
		ON Data.Period = PeriodsOfProductVATRates.Period
		AND Data.Organization.RegistrationCountry = PeriodsOfBasicVATRates.RegistrationCountry
		LEFT JOIN InformationRegister.BasicVATRates AS BasicVATRates
		ON PeriodsOfBasicVATRates.RegistrationCountry = BasicVATRates.Country
		AND PeriodsOfBasicVATRates.Period = BasicVATRates.Period
GROUP BY
	BEGINOFPERIOD(Data.Period, MONTH),
	Data.Organization,
	Data.Department,
	Data.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AmountsByItem.Organization AS Organization,
	AmountsByItem.Department AS Department,
	AmountsByItem.ExpenseItem AS ExpenseItem,
	AmountsByItem.Period AS Period,
	AmountsByItem.Cost AS Amount_Expense,
	AmountsByItem.ProductCostElement AS ProductCostElement,
	SUM(CASE
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.TotalPayrollExpenses)
			THEN ISNULL(DataOnLaborCosts.Cost, 0)
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.NumberOfWorksOfSpecifiedKinds)
			THEN ISNULL(DataOnLaborCosts.Count, 0)
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.StandardRemunerationLevel)
			THEN ISNULL(DataOnLaborCosts.StandardCost, 0)
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsQuantity)
			THEN ISNULL(ProductData_6.Count, 0)
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsWeight)
			THEN ISNULL(ProductData_6.Weight, 0)
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsVolume)
			THEN ISNULL(ProductData_6.VolumeM3, 0)
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.TargetProductCost)
			THEN ISNULL(ProductData_6.Cost, 0)
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.QuantityOfSpecifiedMaterials)
			THEN ISNULL(DataOnMaterialCosts.Count, 0)
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VolumeOfSpecifiedMaterials)
			THEN ISNULL(DataOnMaterialCosts.VolumeM3, 0)
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.WeightOfSpecifiedMaterials)
			THEN ISNULL(DataOnMaterialCosts.Weight, 0)
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.MaterialCostsAmount)
			THEN ISNULL(DataOnMaterialCosts.Cost, 0)
		ELSE 0
	END) AS Base,
	CASE
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.TotalPayrollExpenses)
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.NumberOfWorksOfSpecifiedKinds)
			THEN &amp;PresentationPieces
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.StandardRemunerationLevel)
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsQuantity)
			THEN &amp;PresentationPieces
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsWeight)
			THEN ISNULL(UnitOfMeasureForWeight.Value.Code, "")
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsVolume)
			THEN ISNULL(UnitOfMeasureForVolume.Value.Code, "")
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.TargetProductCost)
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.QuantityOfSpecifiedMaterials)
			THEN &amp;PresentationPieces
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VolumeOfSpecifiedMaterials)
			THEN ISNULL(UnitOfMeasureForVolume.Value.Code, "")
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.WeightOfSpecifiedMaterials)
			THEN ISNULL(UnitOfMeasureForWeight.Value.Code, "")
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.MaterialCostsAmount)
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		ELSE &amp;BaseIsNotSpecified
	END AS UnitOfMeasure
INTO OtherExpensesWithBases
FROM
	AmountsByItem AS AmountsByItem
		LEFT JOIN DataOnLaborCosts AS DataOnLaborCosts
		ON AmountsByItem.AllocationBase IN (&amp;ByLaborCosts)
		AND CASE
			WHEN AmountsByItem.AllocationBase IN (&amp;BySpecifiedPositions)
				THEN DataOnLaborCosts.WorkKind = AmountsByItem.SelectionPosition
				OR AmountsByItem.SelectionPosition = UNDEFINED
			ELSE TRUE
		END
		AND AmountsByItem.Organization = DataOnLaborCosts.Organization
		AND AmountsByItem.Department = DataOnLaborCosts.Department
		AND AmountsByItem.Period = DataOnLaborCosts.Period
		LEFT JOIN DataOnMaterialCosts AS DataOnMaterialCosts
		ON AmountsByItem.AllocationBase IN (&amp;ByMaterialCosts)
		AND CASE
			WHEN AmountsByItem.AllocationBase IN (&amp;BySpecifiedPositions)
				THEN DataOnMaterialCosts.Products = AmountsByItem.SelectionPosition
				OR AmountsByItem.SelectionPosition = UNDEFINED
			ELSE TRUE
		END
		AND AmountsByItem.Organization = DataOnMaterialCosts.Organization
		AND AmountsByItem.Department = DataOnMaterialCosts.Department
		AND AmountsByItem.Period = DataOnMaterialCosts.Period
		LEFT JOIN ProductData_6 AS ProductData_6
		ON AmountsByItem.AllocationBase IN (&amp;ByProducts)
		AND AmountsByItem.Department = ProductData_6.Department
		AND AmountsByItem.Period = ProductData_6.Period
		AND AmountsByItem.Organization = ProductData_6.Organization
		LEFT JOIN Constant.UnitOfMeasureForWeight AS UnitOfMeasureForWeight
		ON TRUE
		LEFT JOIN Constant.ManagementAccountingCurrency AS ManagementAccountingCurrency
		ON TRUE
		LEFT JOIN Constant.UnitOfMeasureForVolume AS UnitOfMeasureForVolume
		ON TRUE
GROUP BY
	AmountsByItem.ExpenseItem,
	AmountsByItem.Department,
	AmountsByItem.Organization,
	AmountsByItem.Period,
	AmountsByItem.ProductCostElement,
	AmountsByItem.Cost,
	CASE
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.TotalPayrollExpenses)
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.NumberOfWorksOfSpecifiedKinds)
			THEN &amp;PresentationPieces
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.StandardRemunerationLevel)
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsQuantity)
			THEN &amp;PresentationPieces
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsWeight)
			THEN ISNULL(UnitOfMeasureForWeight.Value.Code, "")
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.ProductsVolume)
			THEN ISNULL(UnitOfMeasureForVolume.Value.Code, "")
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.TargetProductCost)
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.QuantityOfSpecifiedMaterials)
			THEN &amp;PresentationPieces
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VolumeOfSpecifiedMaterials)
			THEN ISNULL(UnitOfMeasureForVolume.Value.Code, "")
		WHEN AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.WeightOfSpecifiedMaterials)
			THEN ISNULL(UnitOfMeasureForWeight.Value.Code, "")
		WHEN
			AmountsByItem.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.MaterialCostsAmount)
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		ELSE &amp;BaseIsNotSpecified
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	T.Organization AS Organization,
	T.Department AS Department
INTO BusinessUnits
FROM
	CurrentDocumentsByPeriod AS T

UNION ALL

SELECT DISTINCT
	OtherExpensesWithBases.Organization,
	OtherExpensesWithBases.Department
FROM
	OtherExpensesWithBases AS OtherExpensesWithBases
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	NestedQuery.Period AS Period,
	NestedQuery.Organization AS Organization,
	NestedQuery.Department AS Department
INTO DetailedPeriods
FROM
	(SELECT
		PeriodsByMonth.Period AS Period,
		BusinessUnits.Organization AS Organization,
		BusinessUnits.Department AS Department
	FROM
		PeriodsByMonth AS PeriodsByMonth
			LEFT JOIN BusinessUnits AS BusinessUnits
			ON TRUE

	UNION ALL

	SELECT
		PeriodsByMonth.Period,
		BusinessUnits.Organization,
		BusinessUnits.Department
	FROM
		PeriodsByMonth AS PeriodsByMonth
			LEFT JOIN BusinessUnits AS BusinessUnits
			ON TRUE) AS NestedQuery
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	FixedCostRates.Sum AS Sum,
	ValuesOfBases.Value_ AS Base,
	CASE
		WHEN VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Enum.TypesOfCostAllocatingBase)
		AND ValuesOfBases.AllocatedAccordingToRule IN (VALUE(Enum.TypesOfCostAllocatingBase.StandardRemunerationLevel),
			VALUE(Enum.TypesOfCostAllocatingBase.TargetProductCost),
			VALUE(Enum.TypesOfCostAllocatingBase.TotalPayrollExpenses),
			VALUE(Enum.TypesOfCostAllocatingBase.MaterialCostsAmount))
			THEN ISNULL(ManagementAccountingCurrency.Value.Description, "")
		WHEN VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Enum.TypesOfCostAllocatingBase)
		AND ValuesOfBases.AllocatedAccordingToRule = VALUE(Enum.TypesOfCostAllocatingBase.ProductsVolume)
		OR VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Catalog.CostAllocationRules)
		AND
			ValuesOfBases.AllocatedAccordingToRule.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VolumeOfSpecifiedMaterials)
			THEN ISNULL(UnitOfMeasureForVolume.Value.Code, "")
		WHEN VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Enum.TypesOfCostAllocatingBase)
		AND ValuesOfBases.AllocatedAccordingToRule = VALUE(Enum.TypesOfCostAllocatingBase.ProductsWeight)
		OR VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Catalog.CostAllocationRules)
		AND
			ValuesOfBases.AllocatedAccordingToRule.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.WeightOfSpecifiedMaterials)
			THEN ISNULL(UnitOfMeasureForWeight.Value.Code, "")
		WHEN VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Catalog.CostAllocationRules)
		AND ValuesOfBases.AllocatedAccordingToRule.AllocationBase IN
		(VALUE(Enum.TypesOfCostAllocatingBase.NumberOfWorksOfSpecifiedKinds),
			VALUE(Enum.TypesOfCostAllocatingBase.QuantityOfSpecifiedMaterials))
		OR VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Enum.TypesOfCostAllocatingBase)
		AND ValuesOfBases.AllocatedAccordingToRule IN
		(VALUE(Enum.TypesOfCostAllocatingBase.NumberOfWorksOfSpecifiedKinds),
			VALUE(Enum.TypesOfCostAllocatingBase.QuantityOfSpecifiedMaterials),
			VALUE(Enum.TypesOfCostAllocatingBase.ProductsQuantity))
			THEN &amp;PresentationPieces
		ELSE &amp;BaseIsNotSpecified
	END AS UnitOfMeasure,
	VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) AS TypeOfDistributionRule,
	CurrentDocumentsNorm.Ref AS Ref,
	FixedCostRates.NormativeStandard AS NormativeStandard,
	FixedCostRates.ExpenseItem AS ExpenseItem,
	FixedCostRates.ProductCostElement AS ProductCostElement,
	CurrentDocumentsNorm.Period AS Period,
	FixedCostRates.Ref.Organization AS Organization,
	FixedCostRates.Ref.Department AS Department
INTO StandardsForDivisions
FROM
	CurrentDocumentsByPeriod AS CurrentDocumentsNorm
		INNER JOIN Document.SetProductionExpenseStandards.FixedCostRates AS
			FixedCostRates
		ON FixedCostRates.Ref = CurrentDocumentsNorm.Ref
		AND FixedCostRates.Ref.Organization = CurrentDocumentsNorm.Organization
		AND FixedCostRates.Ref.Department = CurrentDocumentsNorm.Department
		INNER JOIN ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
		ON FixedCostRates.ExpenseItem = ExpenseItems.Ref
		LEFT JOIN Catalog.CostAllocationRules AS CostAllocationRules
		ON ExpenseItems.CostAllocationRuleManag = CostAllocationRules.Ref
		LEFT JOIN InformationRegister.SettingsOfItemizedExpensesAllocation AS
			SettingsOfItemizedExpensesAllocation
		ON FixedCostRates.ExpenseItem = SettingsOfItemizedExpensesAllocation.ExpenseItem
		AND CurrentDocumentsNorm.Organization = SettingsOfItemizedExpensesAllocation.Organization
		AND CurrentDocumentsNorm.Department = SettingsOfItemizedExpensesAllocation.Department
		LEFT JOIN Catalog.CostAllocationRules AS
			ItemByItemCostAllocationSettings_CostAllocationRules
		ON SettingsOfItemizedExpensesAllocation.SettingsManAccounting = ItemByItemCostAllocationSettings_CostAllocationRules.Ref
		INNER JOIN Document.SetProductionExpenseStandards.AllocationBaseValues AS ValuesOfBases
		ON CurrentDocumentsNorm.Ref = ValuesOfBases.Ref
		AND CASE
			WHEN ItemByItemCostAllocationSettings_CostAllocationRules.BaseOfAllocationByLots IS NULL
				THEN ValuesOfBases.AllocatedAccordingToRule = CostAllocationRules.BaseOfAllocationByLots
				OR ValuesOfBases.AllocatedAccordingToRule = CostAllocationRules.Ref
			ELSE
				ValuesOfBases.AllocatedAccordingToRule = ItemByItemCostAllocationSettings_CostAllocationRules.BaseOfAllocationByLots
		END
		LEFT JOIN Constant.UnitOfMeasureForWeight AS UnitOfMeasureForWeight
		ON TRUE
		LEFT JOIN Constant.ManagementAccountingCurrency AS ManagementAccountingCurrency
		ON TRUE
		LEFT JOIN Constant.UnitOfMeasureForVolume AS UnitOfMeasureForVolume
		ON TRUE
{WHERE
	FixedCostRates.ExpenseItem.*,
	FixedCostRates.ProductCostElement.*}

UNION ALL

SELECT
	VariableCostRates.Sum,
	ValuesOfBases.Value_,
	CASE
		WHEN VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Enum.TypesOfCostAllocatingBase)
		AND ValuesOfBases.AllocatedAccordingToRule IN (VALUE(Enum.TypesOfCostAllocatingBase.StandardRemunerationLevel),
			VALUE(Enum.TypesOfCostAllocatingBase.TargetProductCost),
			VALUE(Enum.TypesOfCostAllocatingBase.TotalPayrollExpenses),
			VALUE(Enum.TypesOfCostAllocatingBase.MaterialCostsAmount))
			THEN ManagementAccountingCurrency.Value.Description
		WHEN VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Enum.TypesOfCostAllocatingBase)
		AND ValuesOfBases.AllocatedAccordingToRule = VALUE(Enum.TypesOfCostAllocatingBase.ProductsVolume)
		OR VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Catalog.CostAllocationRules)
		AND
			ValuesOfBases.AllocatedAccordingToRule.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.VolumeOfSpecifiedMaterials)
			THEN UnitOfMeasureForVolume.Value.Code
		WHEN VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Enum.TypesOfCostAllocatingBase)
		AND ValuesOfBases.AllocatedAccordingToRule = VALUE(Enum.TypesOfCostAllocatingBase.ProductsWeight)
		OR VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Catalog.CostAllocationRules)
		AND
			ValuesOfBases.AllocatedAccordingToRule.AllocationBase = VALUE(Enum.TypesOfCostAllocatingBase.WeightOfSpecifiedMaterials)
			THEN UnitOfMeasureForWeight.Value.Code
		WHEN VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Catalog.CostAllocationRules)
		AND ValuesOfBases.AllocatedAccordingToRule.AllocationBase IN
		(VALUE(Enum.TypesOfCostAllocatingBase.NumberOfWorksOfSpecifiedKinds),
			VALUE(Enum.TypesOfCostAllocatingBase.QuantityOfSpecifiedMaterials))
		OR VALUETYPE(ValuesOfBases.AllocatedAccordingToRule) = TYPE(Enum.TypesOfCostAllocatingBase)
		AND ValuesOfBases.AllocatedAccordingToRule IN
		(VALUE(Enum.TypesOfCostAllocatingBase.NumberOfWorksOfSpecifiedKinds),
			VALUE(Enum.TypesOfCostAllocatingBase.QuantityOfSpecifiedMaterials),
			VALUE(Enum.TypesOfCostAllocatingBase.ProductsQuantity))
			THEN &amp;PresentationPieces
		ELSE &amp;BaseIsNotSpecified
	END,
	VALUETYPE(ValuesOfBases.AllocatedAccordingToRule),
	CurrentDocumentsNorm.Ref,
	VariableCostRates.NormativeStandard,
	VariableCostRates.ExpenseItem,
	VariableCostRates.ProductCostElement,
	CurrentDocumentsNorm.Period,
	VariableCostRates.Ref.Organization,
	VariableCostRates.Ref.Department
FROM
	CurrentDocumentsByPeriod AS CurrentDocumentsNorm
		INNER JOIN Document.SetProductionExpenseStandards.VariableCostRates AS
			VariableCostRates
		ON CurrentDocumentsNorm.Ref = VariableCostRates.Ref
		INNER JOIN ChartOfCharacteristicTypes.ExpenseItems AS ExpenseItems
		ON VariableCostRates.ExpenseItem = ExpenseItems.Ref
		LEFT JOIN Catalog.CostAllocationRules AS CostAllocationRules
		ON ExpenseItems.CostAllocationRuleManag = CostAllocationRules.Ref
		LEFT JOIN InformationRegister.SettingsOfItemizedExpensesAllocation AS
			SettingsOfItemizedExpensesAllocation
		ON VariableCostRates.ExpenseItem = SettingsOfItemizedExpensesAllocation.ExpenseItem
		AND CurrentDocumentsNorm.Organization = SettingsOfItemizedExpensesAllocation.Organization
		AND CurrentDocumentsNorm.Department = SettingsOfItemizedExpensesAllocation.Department
		LEFT JOIN Catalog.CostAllocationRules AS
			ItemByItemCostAllocationSettings_CostAllocationRules
		ON SettingsOfItemizedExpensesAllocation.SettingsManAccounting = ItemByItemCostAllocationSettings_CostAllocationRules.Ref
		INNER JOIN Document.SetProductionExpenseStandards.AllocationBaseValues AS ValuesOfBases
		ON CurrentDocumentsNorm.Ref = ValuesOfBases.Ref
		AND CASE
			WHEN ItemByItemCostAllocationSettings_CostAllocationRules.BaseOfAllocationByLots IS NULL
				THEN CostAllocationRules.BaseOfAllocationByLots = ValuesOfBases.AllocatedAccordingToRule
				OR CostAllocationRules.Ref = ValuesOfBases.AllocatedAccordingToRule
			ELSE
				ValuesOfBases.AllocatedAccordingToRule = ItemByItemCostAllocationSettings_CostAllocationRules.BaseOfAllocationByLots
		END
		LEFT JOIN Constant.UnitOfMeasureForWeight AS UnitOfMeasureForWeight
		ON TRUE
		LEFT JOIN Constant.ManagementAccountingCurrency AS ManagementAccountingCurrency
		ON TRUE
		LEFT JOIN Constant.UnitOfMeasureForVolume AS UnitOfMeasureForVolume
		ON TRUE
{WHERE
	VariableCostRates.ExpenseItem.*,
	VariableCostRates.ProductCostElement.*}

INDEX BY
	Period,
	Organization,
	Department
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	PeriodsByMonth.Period AS Period,
	OtherExpensesWithBases.Organization AS Organization,
	OtherExpensesWithBases.Department AS Department,
	OtherExpensesWithBases.ProductCostElement AS ProductCostElement,
	OtherExpensesWithBases.ExpenseItem AS ExpenseItem,
	ISNULL(OtherExpensesWithBases.UnitOfMeasure, "") AS UnitOfMeasure,
	ISNULL(OtherExpensesWithBases.Amount_Expense, 0) AS ExpenseAmountFact,
	CAST(CASE
		WHEN NOT ISNULL(OtherExpensesWithBases.Base, 0) = 0
			THEN OtherExpensesWithBases.Amount_Expense / OtherExpensesWithBases.Base
		ELSE 0
	END AS NUMBER(31, 2)) AS StandardFact,
	0 AS StandardPlan,
	0 AS AmountOfExpensePlan,
	0 AS BasePlan,
	OtherExpensesWithBases.Base AS BaseFact
INTO PreliminaryData
{SELECT
	Period,
	Organization.*,
	Department.*,
	ProductCostElement.*,
	ExpenseItem.*,
	UnitOfMeasure,
	ExpenseAmountFact,
	StandardFact,
	StandardPlan,
	AmountOfExpensePlan}
FROM
	PeriodsByMonth AS PeriodsByMonth
		{LEFT JOIN OtherExpensesWithBases AS OtherExpensesWithBases
		ON PeriodsByMonth.Period = OtherExpensesWithBases.Period}

UNION ALL

SELECT
	DetailedPeriods.Period,
	ISNULL(StandardsForDivisions.Organization, DetailedPeriods.Organization),
	ISNULL(StandardsForDivisions.Department, DetailedPeriods.Department),
	ISNULL(StandardsForDivisions.ProductCostElement, VALUE(Catalog.ProductCostElements.EmptyRef)),
	ISNULL(StandardsForDivisions.ExpenseItem, VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)),
	ISNULL(StandardsForDivisions.UnitOfMeasure, ""),
	0,
	0,
	SUM(ISNULL(StandardsForDivisions.NormativeStandard, 0)),
	SUM(ISNULL(StandardsForDivisions.Sum, 0)),
	ISNULL(StandardsForDivisions.Base, 0),
	0
FROM
	DetailedPeriods AS DetailedPeriods
		{LEFT JOIN StandardsForDivisions AS StandardsForDivisions
		ON DetailedPeriods.Period = StandardsForDivisions.Period
		AND DetailedPeriods.Organization = StandardsForDivisions.Organization
		AND DetailedPeriods.Department = StandardsForDivisions.Department}
GROUP BY
	DetailedPeriods.Period,
	ISNULL(StandardsForDivisions.Organization, DetailedPeriods.Organization),
	ISNULL(StandardsForDivisions.Department, DetailedPeriods.Department),
	ISNULL(StandardsForDivisions.ProductCostElement, VALUE(Catalog.ProductCostElements.EmptyRef)),
	ISNULL(StandardsForDivisions.ExpenseItem, VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)),
	ISNULL(StandardsForDivisions.UnitOfMeasure, ""),
	ISNULL(StandardsForDivisions.Base, 0)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	T.Period AS Period,
	T.Organization AS Organization,
	T.Department AS Department,
	T.ProductCostElement AS ProductCostElement,
	T.ExpenseItem AS ExpenseItem,
	SUM(T.Real) AS Real,
	SUM(T.Plan) AS Plan,
	T.Factor AS Factor,
	T.IndicatorPresentation AS IndicatorPresentation
{SELECT
	Period,
	Organization.*,
	Department.*,
	ProductCostElement.*,
	ExpenseItem.*,
	Real,
	Plan,
	Factor,
	IndicatorPresentation}
FROM
	(SELECT
		PreliminaryData.Period AS Period,
		PreliminaryData.Organization AS Organization,
		PreliminaryData.Department AS Department,
		PreliminaryData.ProductCostElement AS ProductCostElement,
		PreliminaryData.ExpenseItem AS ExpenseItem,
		PreliminaryData.StandardFact AS Real,
		PreliminaryData.StandardPlan AS Plan,
		1 AS Factor,
		&amp;NormativeStandard + ", " + CurrencyOfManAccounting.Value.Description AS IndicatorPresentation
	FROM
		PreliminaryData AS PreliminaryData
			LEFT JOIN Constant.ManagementAccountingCurrency AS CurrencyOfManAccounting
			ON TRUE
	{WHERE
		1 AS Factor}

	UNION ALL

	SELECT
		PreliminaryData.Period,
		PreliminaryData.Organization,
		PreliminaryData.Department,
		PreliminaryData.ProductCostElement,
		PreliminaryData.ExpenseItem,
		PreliminaryData.BaseFact,
		PreliminaryData.BasePlan,
		2,
		&amp;BaseSize + ", " + PreliminaryData.UnitOfMeasure
	FROM
		PreliminaryData AS PreliminaryData
	{WHERE
		2 AS Factor}

	UNION ALL

	SELECT
		PreliminaryData.Period,
		PreliminaryData.Organization,
		PreliminaryData.Department,
		PreliminaryData.ProductCostElement,
		PreliminaryData.ExpenseItem,
		PreliminaryData.ExpenseAmountFact,
		PreliminaryData.AmountOfExpensePlan,
		3,
		&amp;Amount_Expense + ", " + CurrencyOfManAccounting.Value.Description
	FROM
		PreliminaryData AS PreliminaryData
			LEFT JOIN Constant.ManagementAccountingCurrency AS CurrencyOfManAccounting
			ON TRUE
	{WHERE
		3 AS Factor}) AS T
GROUP BY
	T.Organization,
	T.Period,
	T.ProductCostElement,
	T.Department,
	T.ExpenseItem,
	T.IndicatorPresentation,
	T.Factor</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
