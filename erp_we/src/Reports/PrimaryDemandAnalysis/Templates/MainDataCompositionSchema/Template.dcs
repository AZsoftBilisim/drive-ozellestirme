	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;


////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SalesOpportunitiesToCustomerPrimaryDemand.DescriptionText,
	SalesOpportunitiesToCustomerPrimaryDemand.SatisfactionPercentage,
	SalesOpportunitiesToCustomerPrimaryDemand.ReasonForNonFulfillment,
	SalesOpportunitiesToCustomerPrimaryDemand.Ref AS SalesOpportunity,
	SalesOpportunitiesToCustomer.EmployeeResponsible AS Manager,
	SalesOpportunitiesToCustomer.Partner,
	SalesOpportunitiesToCustomer.SalesOpportunityKind,
	CustomerOpportunityKinds.SalesOpportunityType,
	SalesOpportunitiesToCustomer.ReasonForLosingSalesOpportunity,
	SalesOpportunitiesToCustomer.Status,
	SalesOpportunitiesToCustomer.CustomerTermsOfSales,
	SalesOpportunitiesToCustomerPrimaryDemand.Sum,
	SalesOpportunitiesToCustomer.StartDate,
	SalesOpportunitiesToCustomer.EndDate,
	CAST(SalesOpportunitiesToCustomerPrimaryDemand.Sum * SalesOpportunitiesToCustomerPrimaryDemand.SatisfactionPercentage / 100 AS NUMBER(31,2)) AS FulfilledDemandAmount,
	CAST(SalesOpportunitiesToCustomerPrimaryDemand.Sum - SalesOpportunitiesToCustomerPrimaryDemand.Sum * SalesOpportunitiesToCustomerPrimaryDemand.SatisfactionPercentage / 100 AS NUMBER(31,2)) AS UnfulfilledDemandAmount,
	SalesOpportunitiesToCustomer.PrimaryDemandCurrency,
	SalesOpportunitiesToCustomerPrimaryDemand.Comment
FROM
	Catalog.SalesOpportunitiesToCustomer.PrimaryDemand AS SalesOpportunitiesToCustomerPrimaryDemand
		LEFT JOIN Catalog.SalesOpportunitiesToCustomer AS SalesOpportunitiesToCustomer
			LEFT JOIN Catalog.CustomerOpportunityKinds AS CustomerOpportunityKinds
			ON SalesOpportunitiesToCustomer.SalesOpportunityKind = CustomerOpportunityKinds.Ref
		ON SalesOpportunitiesToCustomerPrimaryDemand.Ref = SalesOpportunitiesToCustomer.Ref
WHERE
	NOT SalesOpportunitiesToCustomer.DeletionMark
	AND SalesOpportunitiesToCustomer.Closed_
{WHERE
	(SalesOpportunitiesToCustomer.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	(CAST(SalesOpportunitiesToCustomerPrimaryDemand.Sum * SalesOpportunitiesToCustomerPrimaryDemand.SatisfactionPercentage / 100 AS NUMBER(31,2))) AS FulfilledDemandAmount,
	(CAST(SalesOpportunitiesToCustomerPrimaryDemand.Sum - SalesOpportunitiesToCustomerPrimaryDemand.Sum * SalesOpportunitiesToCustomerPrimaryDemand.SatisfactionPercentage / 100 AS NUMBER(31,2))) AS UnfulfilledDemandAmount}</query>
	</dataSet>
