		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	DeliveryTurnover.Organization AS Organization,
	DeliveryTurnover.DeliveryType AS DeliveryType,
	DeliveryTurnover.DeliveryMethod AS DeliveryMethod,
	DeliveryTurnover.Sender AS Sender,
	DeliveryTurnover.SenderPoint AS SenderPoint,
	DeliveryTurnover.Sender_Area AS Sender_Area,
	DeliveryTurnover.Recipient AS Recipient,
	DeliveryTurnover.RecipientPoint AS RecipientPoint,
	DeliveryTurnover.Recipient_Area AS Recipient_Area,
	DeliveryTurnover.PlanningDocument AS PlanningDocument,
	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	DeliveryTurnover.DateOfShipment AS DateOfShipment,
	DeliveryTurnover.Trip AS Trip,
	DeliveryTurnover.Products AS Products,
	DeliveryTurnover.Characteristic AS Characteristic,
	DeliveryTurnover.Series AS Series,
	DeliveryTurnover.RowCode AS RowCode,
	DeliveryTurnover.Arm AS Arm,
	DeliveryTurnover.Carrier AS Carrier,
	DeliveryTurnover.Package AS Package,
	DeliveryTurnover.ToDeliverTurnover AS ToDeliverTurnover,
	DeliveryTurnover.ToTripTurnover AS ToTripTurnover,
	DeliveryTurnover.InTripTurnover AS InTripTurnover,
	DeliveryTurnover.InTransitTurnover AS InTransitTurnover,
	DeliveryTurnover.DeliveredTurnover AS DeliveredTurnover,
	DeliveryTurnover.CanceledTurnover AS CanceledTurnover,
	DeliveryTurnover.ForAssemblyTurnover AS ForAssemblyTurnover,
	DeliveryTurnover.KittingIsScheduledTurnover AS KittingIsScheduledTurnover,
	DeliveryTurnover.AssemblyInProgressTurnover AS AssemblyInProgressTurnover,
	DeliveryTurnover.AssembledTurnover AS AssembledTurnover,
	DeliveryTurnover.Recorder AS Recorder
{SELECT
	Organization.*,
	DeliveryType.*,
	DeliveryMethod.*,
	Sender.*,
	SenderPoint.*,
	Sender_Area.*,
	Recipient.*,
	RecipientPoint.* AS DeliveryPoint,
	Recipient_Area.* AS Recipient_Area,
	PlanningDocument.*,
	ReferenceOrder.*,
	DateOfShipment,
	Trip.*,
	Products.*,
	Characteristic.*,
	Series.*,
	RowCode,
	Arm,
	Carrier.*,
	Package.*,
	ToDeliverTurnover AS ToDeliver,
	ToTripTurnover AS ToTrip,
	InTripTurnover AS InTrip,
	InTransitTurnover AS InTransit,
	DeliveredTurnover AS Delivered,
	CanceledTurnover AS Canceled,
	ForAssemblyTurnover AS ForAssembly,
	KittingIsScheduledTurnover AS KittingIsScheduled,
	AssemblyInProgressTurnover AS AssemblyInProgress,
	AssembledTurnover AS Assembled,
	Recorder.*}
FROM
	AccumulationRegister.Delivery.Turnovers(, , Auto, {(DateOfShipment BETWEEN &amp;ShipmentDateStart AND &amp;ShipmentDateEnd), (ReferenceOrder = &amp;ReferenceOrder), (Organization).* AS Organization, (DeliveryType) AS DeliveryType, (DeliveryMethod) AS DeliveryMethod, (Sender).* AS Sender, (SenderPoint).* AS SenderPoint, (Sender_Area).* AS Sender_Area, (Recipient).* AS Recipient, (RecipientPoint).* AS DeliveryPoint, (Recipient_Area).* AS Recipient_Area, (PlanningDocument).* AS PlanningDocument, (ReferenceOrder).* AS ReferenceOrder, (Trip).* AS Trip, (Products).* AS Products, (Characteristic).* AS Characteristic, (Series).* AS Series, (RowCode) AS RowCode, (Arm) AS Arm, (Carrier).* AS Carrier, (Package).* AS Package}) AS DeliveryTurnover</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>ScheduleDeliveries</dataPath>
		<expression>ToDeliver - ToTrip</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Schedule delivery</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>زمان‌بندی تحویل</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Запланировать доставку</v8:content>
			</v8:item>
			<v8:item>
