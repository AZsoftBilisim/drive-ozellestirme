				<v8:content>Документ</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Belge</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chứng từ</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Document</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Document</v8:content>
			</v8:item>
		</title>
		<presentationExpression>Presentation(Case
	When Stage = Undefined And ReferenceOrder = Undefined
		Then "Entering availability"
	When Stage = Undefined
		Then ReferenceOrder
	Else Presentation(ReferenceOrder) + ", " + Presentation(Stage)
End)</presentationExpression>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.ProductionStage2_2</v8:Type>
			<v8:Type>xs:string</v8:Type>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.ProductionOrder2_2</v8:Type>
			<v8:StringQualifiers>
				<v8:Length>0</v8:Length>
				<v8:AllowedLength>Variable</v8:AllowedLength>
			</v8:StringQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ItSDowntime</dataPath>
		<expression>Case 
	When Not ConsiderAvailability And BusySummary = 0 Then True 
	When ConsiderAvailability And BusySummary = 0 And AvailableInSummary &gt; 0 Then True 
	Else False 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Downtime</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>زمان توقف</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Простои</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kesinti süresi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Nhàn rỗi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Downtime</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Downtime</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ThisIsInaccessibility</dataPath>
		<expression>Case 
	When BusySummary = 0 And (Not ConsiderAvailability Or AvailableInSummary = 0) Then True 
	Else False 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unavailability</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>عدم دسترس‌پذیری</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Недоступность</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Erişilemezlik</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Không khả dụng</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unavailability</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Unavailability</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ThisIsPartialDownload</dataPath>
		<expression>Case 
	When BusySummary &gt; 0 Then 
		Case When Not ConsiderAvailability Then True 
			  When  ParallelLoad And AvailableInSummary &lt;&gt; 0 Then Round(100 - BusySummary/AvailableInSummary*100, 1) &gt; 0
			  Else (AvailableInSummary - BusySummary) &gt; 0
		End 	
	Else False 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Partial load</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>بار جزئی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Частичная загрузка</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kısmi yük</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Bận một phần</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Partial load</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Partial load</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ThisIsFullDownload</dataPath>
		<expression>Case 
	When ConsiderAvailability And BusySummary &gt; 0 Then 
		Case When ParallelLoad And AvailableInSummary &lt;&gt; 0 Then Round(100 - BusySummary/AvailableInSummary*100, 1) = 0
			  Else (AvailableInSummary - BusySummary) = 0
		End 	
	Else False 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Full load</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>بار کامل</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Полная загрузка</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Tam yük</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Bận kín</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Full load</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Full load</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ThisIsOverload</dataPath>
		<expression>Case 
	When ConsiderAvailability Then 
		Case When ParallelLoad And AvailableInSummary &lt;&gt; 0 Then Round(100 - BusySummary/AvailableInSummary*100, 1) &lt; 0
			  Else (AvailableInSummary - BusySummary) &lt; 0
		End 	
	Else False 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Overload</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>اضافه‌بار</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Перегрузка</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Fazla yük</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Quá tải</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Overload</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Overload</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<totalField>
		<dataPath>Available</dataPath>
		<expression>Max(Available)</expression>
	</totalField>
	<totalField>
		<dataPath>Busy</dataPath>
		<expression>Case
	When ParallelLoad And Max(Available) &lt;&gt; 0
		Then Round(Sum(Busy)/Max(Available)*100, 1)
	Else Sum(Busy)
End</expression>
	</totalField>
	<totalField>
		<dataPath>FreelyGiven</dataPath>
		<expression>Case
	When Not ConsiderAvailability
		Then 0
	When ParallelLoad And Max(Available) &lt;&gt; 0
		Then Round(100 - Sum(Busy)/Max(Available)*100, 1)
	Else (Max(Available) - Sum(Busy)) / 3600
End</expression>
		<group>WorkCenterType</group>
		<group>UnitOfMeasure</group>
		<group>SchedulePeriod</group>
	</totalField>
	<totalField>
		<dataPath>AvailableGiven</dataPath>
		<expression>Sum(AvailableGiven)</expression>
	</totalField>
	<totalField>
		<dataPath>OccupiedGiven</dataPath>
		<expression>Case
	When ParallelLoad And Max(AvailableGiven) &lt;&gt; 0
		Then Round(Sum(OccupiedGiven)/Max(AvailableGiven)*100, 1)
	Else Sum(OccupiedGiven)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ConsiderAvailability</dataPath>
		<expression>Min(ConsiderAvailability)</expression>
	</totalField>
	<totalField>
		<dataPath>FreelyGiven</dataPath>
		<expression>Case
	When ValueType(Document) = Type("Document.ProductionStage2_2")
		Or ValueType(Document) = Type("Catalog.ProductionStages")
		Or ValueType(Document) = Type("Document.ProductionOrder")
		Then 0
	Else
		Case
			When Not ConsiderAvailability
				Then 0
			When ParallelLoad And Max(Available) &lt;&gt; 0
				Then Round(100 - Sum(Busy)/Max(Available)*100, 1)
			Else (Max(Available) - Sum(Busy)) / 3600
End
End</expression>
		<group>Document</group>
	</totalField>
