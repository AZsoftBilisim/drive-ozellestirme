			</v8:StringQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>Document</dataPath>
		<expression>Case
	When Stage = Undefined
		Then ReferenceOrder
	Else Stage
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Document</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>سند</v8:content>
			</v8:item>
			<v8:item>
