	<calculatedField>
		<dataPath>FreelyGiven</dataPath>
		<expression>Case
	When Not ConsiderAvailability
		Then 0
	When ParallelLoad And Available &lt;&gt; 0
		Then Round(100 - Busy/Available*100, 1)
	Else (Available - Busy) / 3600
End</expression>
