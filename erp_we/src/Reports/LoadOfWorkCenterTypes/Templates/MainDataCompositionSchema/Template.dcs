	<calculatedField>
		<dataPath>UnitOfMeasure</dataPath>
		<expression>Case
	When ParallelLoad
		Then "%"
	Else NStr("ru = 'ч'; vi = 'giờ'; en = 'h'; it = 'h'; pl = 'h'; tr = 's'")
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
