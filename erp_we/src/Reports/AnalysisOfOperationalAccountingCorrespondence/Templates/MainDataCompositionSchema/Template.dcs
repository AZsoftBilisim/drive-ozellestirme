	<settingsVariant>
		<dcsset:name>CorrespondenceAnalysisChessBulletin</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Correspondence analysis, articulation statement</v8:content>
			</v8:item>
