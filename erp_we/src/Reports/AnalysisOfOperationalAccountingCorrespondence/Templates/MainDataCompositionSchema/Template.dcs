			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Analiza korespondencji, zestawienie szachowe</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Анализ корреспонденций, шахматная ведомость</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
