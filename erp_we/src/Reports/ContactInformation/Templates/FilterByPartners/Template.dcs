				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Sınıflandırma</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Phân loại</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CatalogPartners.Ref AS Partner,
	SegmentPartners.Segment AS Segment,
	CASE
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.AClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.XClass)
			THEN &amp;AXLine
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.AClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.YClass)
			THEN &amp;AYLine
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.AClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.ZClass)
			THEN &amp;AZLine
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.BClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.XClass)
			THEN &amp;BXLine
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.BClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.YClass)
			THEN &amp;LineBY
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.BClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.ZClass)
			THEN &amp;BZLine
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.CClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.XClass)
			THEN &amp;CXLine
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.CClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.YClass)
			THEN &amp;CYLine
		WHEN ABCSliceLast.Class = VALUE(Enum.ABCClassification.CClass)
				AND XYZSliceLast.Class = VALUE(Enum.XYZClassification.ZClass)
			THEN &amp;CZLine
		ELSE &amp;LineNotClassified
	END AS Classification
{SELECT
	Partner,
	Segment.*}
FROM
	Catalog.Partners AS CatalogPartners
		{LEFT JOIN InformationRegister.SegmentPartners AS SegmentPartners
		ON CatalogPartners.Ref = SegmentPartners.Partner}
		LEFT JOIN InformationRegister.ABCXYZCustomerClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.ABC)) AS ABCSliceLast
		ON (ABCSliceLast.Partner = CatalogPartners.Ref)
		LEFT JOIN InformationRegister.ABCXYZCustomerClassification.SliceLast(
				,
				ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.Revenue)
					AND ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)) AS XYZSliceLast
		ON (XYZSliceLast.Partner = CatalogPartners.Ref)
{WHERE
	CatalogPartners.Ref.* AS Partner,
	CatalogPartners.BusinessRegion.*,
	CatalogPartners.Description AS WorkName,
	CatalogPartners.DescriptionFull AS PublicName,
	CatalogPartners.MainManager.*,
	CatalogPartners.RegistrationDate,
	CatalogPartners.Client AS IsClient,
	CatalogPartners.Vendor AS ThisIsSupplier,
	CatalogPartners.Competitor AS ItSCompetitor,
	CatalogPartners.OtherRelations,
	CatalogPartners.ServedBySalesRepresentatives,
	SegmentPartners.Segment,
	CatalogPartners.Parent}</query>
	</dataSet>
