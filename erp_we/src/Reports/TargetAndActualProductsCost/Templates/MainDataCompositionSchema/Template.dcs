		<sourceDataSet>DataSet1</sourceDataSet>
		<destinationDataSet>ProductionIssue</destinationDataSet>
		<sourceExpression>ManufacturedProduct</sourceExpression>
		<destinationExpression>ManufacturedProduct</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>DataSet1</sourceDataSet>
		<destinationDataSet>ProductionIssue</destinationDataSet>
