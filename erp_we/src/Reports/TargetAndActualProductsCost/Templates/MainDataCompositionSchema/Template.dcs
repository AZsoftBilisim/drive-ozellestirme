		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductionIssue.Recorder AS Recorder,
	ProductionIssue.ItemsLocationAttributes.Products AS ManufacturedProduct,
	ProductionIssue.ItemsLocationAttributes.Characteristic AS ItemVariant,
	ProductionIssue.ItemsLocationAttributes.Purpose AS AssignmentOfProducts,
	ProductionIssue.Organization AS Organization,
	CASE
		WHEN ProductionIssue.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
			THEN ProductionIssue.ItemsLocationAttributes.Department
		ELSE ProductionIssue.ItemsLocationAttributes.WarehouseArea.Department
	END AS ProductDepartment,
	ProductionIssue.ItemsLocationAttributes.Series AS ProductionSeries_,
	ProductionIssue.SecondPeriod AS Period,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductionIssue.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN ProductionIssue.ItemsLocationAttributes.Products.UnitFactorForReports &lt;&gt; 0
						THEN ProductionIssue.CountTurnover / ProductionIssue.ItemsLocationAttributes.Products.UnitFactorForReports
					ELSE 0
				END
	END AS ProductsQuantity
INTO Releases
FROM
	AccumulationRegister.ProductsRelease.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, ) AS ProductionIssue
		LEFT JOIN Constants AS Constants
		ON (TRUE)
{WHERE
	((ProductionIssue.ItemsLocationAttributes.Products, ProductionIssue.ItemsLocationAttributes.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

INDEX BY
	Recorder,
	ManufacturedProduct,
	ItemVariant,
	AssignmentOfProducts

;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Releases.Recorder AS Lot
INTO ProductBatches
FROM
	Releases AS Releases

GROUP BY
	Releases.Recorder
	
INDEX BY
	Lot
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Releases.Recorder AS Lot,
	ENDOFPERIOD(Releases.Period, DAY) AS Period,
	Releases.ManufacturedProduct AS ManufacturedProduct,
	Releases.ItemVariant AS ItemVariant,
	Releases.AssignmentOfProducts AS AssignmentOfProducts,
	Releases.Organization AS Organization
INTO ReleaseDates_
FROM
	Releases AS Releases
	
INDEX BY
	Lot,
	Period,
	ManufacturedProduct,
	ItemVariant,
	AssignmentOfProducts,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ReleaseDates_.Lot AS Lot,
	ReleaseDates_.ManufacturedProduct AS ManufacturedProduct,
	ReleaseDates_.ItemVariant AS ItemVariant,
	ReleaseDates_.AssignmentOfProducts AS AssignmentOfProducts,
	MAX(Multipliers.StandardCostEstimate.Date) AS CalculationDate,
	TRUE AS OrderCosting,
	Multipliers.StandardCostEstimate.Organization AS Organization
	
INTO OrderCalculations
FROM
	ReleaseDates_ AS ReleaseDates_
		INNER JOIN InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS Multipliers
		ON ReleaseDates_.ManufacturedProduct = Multipliers.ManufacturedProduct
			AND ReleaseDates_.ItemVariant = Multipliers.ItemVariant
			AND ReleaseDates_.AssignmentOfProducts = Multipliers.Purpose
			AND ReleaseDates_.Lot = Multipliers.LotProductBOM
			AND ReleaseDates_.Period &gt;= Multipliers.StandardCostEstimate.Date
			AND ReleaseDates_.Organization = Multipliers.StandardCostEstimate.Organization
			AND Multipliers.SemiFinishedProduct = VALUE(Catalog.Products.EmptyRef)

GROUP BY
	ReleaseDates_.ManufacturedProduct,
	ReleaseDates_.ItemVariant,
	ReleaseDates_.AssignmentOfProducts,
	ReleaseDates_.Lot,
	Multipliers.StandardCostEstimate.Organization
	
INDEX BY
	Lot,
	ManufacturedProduct,
	ItemVariant,
	AssignmentOfProducts
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	MAX(Multipliers.StandardCostEstimate.Date) AS CalculationDate,
	ReleaseDates_.ManufacturedProduct AS ManufacturedProduct,
	ReleaseDates_.ItemVariant AS ItemVariant,
	ReleaseDates_.AssignmentOfProducts AS AssignmentOfProducts,
	ReleaseDates_.Lot AS Lot,
	FALSE AS OrderCosting,
	ReleaseDates_.Organization AS Organization
INTO SpecificationCalculations
FROM
	ReleaseDates_ AS ReleaseDates_
		INNER JOIN InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS Multipliers
		ON ReleaseDates_.ManufacturedProduct = Multipliers.ManufacturedProduct
			AND ReleaseDates_.ItemVariant = Multipliers.ItemVariant
			AND ReleaseDates_.Period &gt;= Multipliers.StandardCostEstimate.Date
			AND (VALUETYPE(Multipliers.LotProductBOM) = TYPE(Catalog.BillsOfMaterials))
			AND ReleaseDates_.Organization = Multipliers.StandardCostEstimate.Organization
			AND Multipliers.SemiFinishedProduct = VALUE(Catalog.Products.EmptyRef)
			
		LEFT JOIN OrderCalculations AS OrderCalculations
		ON ReleaseDates_.ManufacturedProduct = OrderCalculations.ManufacturedProduct
			AND ReleaseDates_.ItemVariant = OrderCalculations.ItemVariant
			AND ReleaseDates_.AssignmentOfProducts = OrderCalculations.AssignmentOfProducts
			AND ReleaseDates_.Lot = OrderCalculations.Lot
WHERE
	OrderCalculations.CalculationDate IS NULL

GROUP BY
	ReleaseDates_.ManufacturedProduct,
	ReleaseDates_.ItemVariant,
	ReleaseDates_.AssignmentOfProducts,
	ReleaseDates_.Lot,
	ReleaseDates_.Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	OrderCalculations.Lot AS Lot,
	OrderCalculations.CalculationDate AS CalculationDate,
	OrderCalculations.ManufacturedProduct AS ManufacturedProduct,
	OrderCalculations.ItemVariant AS ItemVariant,
	OrderCalculations.AssignmentOfProducts AS AssignmentOfProducts,
	OrderCalculations.OrderCosting AS OrderCosting,
	OrderCalculations.Organization AS Organization
INTO RecentCalculations
FROM
	OrderCalculations AS OrderCalculations

UNION ALL

SELECT
	SpecificationCalculations.Lot,
	SpecificationCalculations.CalculationDate,
	SpecificationCalculations.ManufacturedProduct,
	SpecificationCalculations.ItemVariant,
	SpecificationCalculations.AssignmentOfProducts,
	SpecificationCalculations.OrderCosting,
	SpecificationCalculations.Organization
FROM
	SpecificationCalculations AS SpecificationCalculations

INDEX BY
	Lot,
	CalculationDate,
	ManufacturedProduct,
	ItemVariant,
	AssignmentOfProducts,
	OrderCosting,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RecentCalculations.Lot AS Lot,
	RecentCalculations.ManufacturedProduct AS ManufacturedProduct,
	RecentCalculations.ItemVariant AS ItemVariant,
	RecentCalculations.AssignmentOfProducts AS AssignmentOfProducts,
	Multipliers.StandardCostEstimate AS StandardCostEstimate,
	RecentCalculations.Organization AS Organization,
	RecentCalculations.OrderCosting AS OrderCosting,
	RecentCalculations.AssignmentOfProducts = Multipliers.Purpose AS AssignmentConverges
INTO LatestProductCalculationsPreliminary
FROM
	InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS Multipliers
		INNER JOIN RecentCalculations AS RecentCalculations
		ON (RecentCalculations.ManufacturedProduct = Multipliers.ManufacturedProduct)
			AND (RecentCalculations.ItemVariant = Multipliers.ItemVariant)
			AND (RecentCalculations.AssignmentOfProducts = Multipliers.Purpose
				OR Multipliers.Purpose = VALUE(Catalog.Assignments.EmptyRef))
			AND (CASE
				WHEN RecentCalculations.OrderCosting
					THEN RecentCalculations.Lot = Multipliers.LotProductBOM
				ELSE TRUE
			END)
			AND (RecentCalculations.CalculationDate = Multipliers.StandardCostEstimate.Date)
			AND (RecentCalculations.Organization = Multipliers.StandardCostEstimate.Organization)
			AND (Multipliers.SemiFinishedProduct = VALUE(Catalog.Products.EmptyRef))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	VZ.Lot AS Lot,
	VZ.ManufacturedProduct AS ManufacturedProduct,
	VZ.ItemVariant AS ItemVariant,
	VZ.AssignmentOfProducts AS AssignmentOfProducts,
	VZ.Organization AS Organization,
	VZ.OrderCosting AS OrderCosting,
	MAX(VZ.AssignmentConverges) AS AssignmentConverges
INTO MeasurementsWithSuitableAssignments
FROM
	LatestProductCalculationsPreliminary AS VZ

GROUP BY
	VZ.Lot,
	VZ.ManufacturedProduct,
	VZ.ItemVariant,
	VZ.AssignmentOfProducts,
	VZ.Organization,
	VZ.OrderCosting

INDEX BY
	Lot,
	ManufacturedProduct,
	ItemVariant,
	AssignmentOfProducts,
	Organization,
	OrderCosting,
	AssignmentConverges
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DD.Lot AS Lot,
	DD.ManufacturedProduct AS ManufacturedProduct,
	DD.ItemVariant AS ItemVariant,
	DD.AssignmentOfProducts AS AssignmentOfProducts,
	MAX(DD.StandardCostEstimate) AS StandardCostEstimate,
	DD.Organization AS Organization,
	DD.OrderCosting AS OrderCosting,
	DD.AssignmentConverges AS FilterByAssignment
INTO LatestProductCalculations
FROM
	LatestProductCalculationsPreliminary AS DD
		INNER JOIN MeasurementsWithSuitableAssignments AS ISPN
		ON DD.Lot = ISPN.Lot
			AND DD.ManufacturedProduct = ISPN.ManufacturedProduct
			AND DD.ItemVariant = ISPN.ItemVariant
			AND DD.AssignmentOfProducts = ISPN.AssignmentOfProducts
			AND DD.Organization = ISPN.Organization
			AND DD.OrderCosting = ISPN.OrderCosting
			AND DD.AssignmentConverges = ISPN.AssignmentConverges

GROUP BY
	DD.Lot,
	DD.ManufacturedProduct,
	DD.ItemVariant,
	DD.AssignmentOfProducts,
	DD.Organization,
	DD.OrderCosting,
	DD.AssignmentConverges

INDEX BY
	Lot,
	ManufacturedProduct,
	ItemVariant,
	AssignmentOfProducts
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	LatestProductCalculations.Lot AS Lot,
	LatestProductCalculations.ManufacturedProduct AS ManufacturedProduct,
	LatestProductCalculations.ItemVariant AS ItemVariant,
	LatestProductCalculations.AssignmentOfProducts AS AssignmentOfProducts,
	LatestProductCalculations.StandardCostEstimate AS StandardCostEstimate,
	LatestProductCalculations.OrderCosting AS OrderCosting,
	SUM(Releases.ProductsQuantity) AS ProductQuantityActual,
	LatestProductCalculations.Organization AS Organization,
	Releases.ProductionSeries_ AS ProductionSeries_,
	LatestProductCalculations.FilterByAssignment AS FilterByAssignment
INTO ProductCostings
FROM
	Releases AS Releases
		
		INNER JOIN LatestProductCalculations AS LatestProductCalculations
		ON Releases.ManufacturedProduct 					= LatestProductCalculations.ManufacturedProduct
			AND Releases.ItemVariant	= LatestProductCalculations.ItemVariant
			AND Releases.AssignmentOfProducts		= LatestProductCalculations.AssignmentOfProducts
			AND Releases.Recorder				= LatestProductCalculations.Lot

GROUP BY
	LatestProductCalculations.StandardCostEstimate,
	LatestProductCalculations.ManufacturedProduct,
	LatestProductCalculations.ItemVariant,
	LatestProductCalculations.AssignmentOfProducts,
	LatestProductCalculations.Lot,
	LatestProductCalculations.OrderCosting,
	LatestProductCalculations.Organization,
	Releases.ProductionSeries_,
	LatestProductCalculations.FilterByAssignment
	
INDEX BY
	Lot,
	ManufacturedProduct,
	ItemVariant,
	AssignmentOfProducts
;


////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	NestedQuery.Organization AS Organization,
	NestedQuery.ProductDepartment AS ProductDepartment,
	NestedQuery.ManufacturedProduct AS ManufacturedProduct,
	NestedQuery.ItemVariant AS ItemVariant,
	NestedQuery.ProductUnitOfMeasure AS ProductUnitOfMeasure,
	NestedQuery.ProductionSeries_ AS ProductionSeries_,
	NestedQuery.AssignmentOfProducts AS AssignmentOfProducts,
	SUM(NestedQuery.CostMaterialCosts) AS CostMaterialCosts,
	SUM(NestedQuery.CostOfLaborCosts) AS CostOfLaborCosts,
	SUM(NestedQuery.CostArticleByArticle) AS CostArticleByArticle,
	SUM(NestedQuery.AddExpensesForGoods) AS AdditionalExpenseCost,
	SUM(NestedQuery.OffBalanceSheet) AS OffBalanceCost,	
	NestedQuery.Recorder AS Recorder
INTO AllProductionCosts
FROM
	(SELECT
		DD.Organization AS Organization,
		CASE
			WHEN DD.CorItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Department)
				THEN DD.CorItemsLocationAttributes.Department
			ELSE DD.CorItemsLocationAttributes.WarehouseArea.Department
		END AS ProductDepartment,
		DD.CorItemsLocationAttributes.Products AS ManufacturedProduct,
		DD.CorItemsLocationAttributes.Characteristic AS ItemVariant,
		DD.CorItemsLocationAttributes.Products.UnitOfMeasure AS ProductUnitOfMeasure,
		DD.CorItemsLocationAttributes.Series AS ProductionSeries_,
		DD.CorItemsLocationAttributes.Purpose AS AssignmentOfProducts,
		CASE
			WHEN &amp;Cost_Data = 1
				THEN DD.Cost + DD.AddExpensesForGoods + DD.LaborCosts + DD.ItemizedFixedCostsIncludingVAT + DD.ItemizedVariableCostsIncludingVAT
			WHEN &amp;Cost_Data = 2
				THEN DD.CostExcludingVAT + DD.AdditionalExpensesExcludingVAT + DD.LaborCosts + DD.ItemizedFixedCostsExcludingVAT + DD.ItemizedVariableCostsExcludingVAT
			ELSE
				DD.LocalCost + DD.AddExpensesLocal + DD.LaborCostsLocal + DD.ItemizedFixedCostsCompl + DD.ItemizedVariableCostsCompl
		END AS CostMaterialCosts,
		0 AS CostOfLaborCosts,
		0 AS CostArticleByArticle,
		CASE
			WHEN &amp;Cost_Data = 1
				THEN ISNULL(DD.AddExpensesForGoods, 0)
			WHEN &amp;Cost_Data = 2
				THEN ISNULL(DD.AdditionalExpensesExcludingVAT, 0)
			ELSE
				ISNULL(DD.AddExpensesLocal, 0)
		END AS AddExpensesForGoods,
		CASE
			WHEN &amp;Cost_Data = 3
				THEN ISNULL(DD.OffBalanceCostLocal, 0)
			ELSE
				ISNULL(DD.OffBalanceCost, 0)
		END AS OffBalanceSheet,
		DD.Recorder AS Recorder
	FROM
		ProductBatches AS ProductBatches
			INNER JOIN AccumulationRegister.InventoryCost AS DD
			ON ProductBatches.Lot = DD.Recorder
			LEFT JOIN Constants AS Constants
			ON (TRUE)
	WHERE
		DD.RecordType = VALUE(AccumulationRecordType.Expense)
		AND DD.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress)
		AND NOT DD.ItemsLocationAttributes.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
		AND DD.Period &gt;= &amp;DateOfMigrationToBatchAccounting22
		AND DD.Active
		AND &amp;BatchAccountingVersion22
	{WHERE
		((DD.CorItemsLocationAttributes.Products, DD.CorItemsLocationAttributes.Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)) AS Field2}
	
	UNION ALL
	
	SELECT
		UnfinishedProductionCosts.Organization,
		CASE
			WHEN NOT Constants.UseProductionManagement2_2
				THEN UNDEFINED
			WHEN UnfinishedProductionCosts.ProductsAccountingDimension.StorageType = VALUE(Enum.StorageLocationTypes.Department)
				THEN UnfinishedProductionCosts.ProductsAccountingDimension.Department
			ELSE UnfinishedProductionCosts.ProductsAccountingDimension.WarehouseArea.Department
		END AS ProductDepartment,
		UnfinishedProductionCosts.ProductsAccountingDimension.Products AS ManufacturedProduct,
		UnfinishedProductionCosts.ProductsAccountingDimension.Characteristic AS ItemVariant,
		UnfinishedProductionCosts.ProductsAccountingDimension.Products.UnitOfMeasure AS ProductUnitOfMeasure,
		UnfinishedProductionCosts.ProductsAccountingDimension.Series AS ProductionSeries_,
		UnfinishedProductionCosts.ProductsAccountingDimension.Purpose AS AssignmentOfProducts,
		0,
		0,
		CASE WHEN &amp;Cost_Data = 1 THEN
			UnfinishedProductionCosts.Cost
		WHEN &amp;Cost_Data = 2 THEN
			UnfinishedProductionCosts.CostExcludingVAT
		WHEN &amp;Cost_Data = 3 THEN
			UnfinishedProductionCosts.LocalCost
		ELSE
			0
		END,
		0,
		0,
		ProductBatches.Lot
	FROM
		ProductBatches AS ProductBatches
			INNER JOIN AccumulationRegister.OtherWorkInProgressExpenses AS UnfinishedProductionCosts
			ON ProductBatches.Lot = UnfinishedProductionCosts.Recorder
			LEFT JOIN Constants AS Constants
			ON (TRUE)
	WHERE
		UnfinishedProductionCosts.RecordType = VALUE(AccumulationRecordType.Expense)
		AND (UnfinishedProductionCosts.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
	{WHERE
		((UnfinishedProductionCosts.ManufacturedProduct, UnfinishedProductionCosts.ItemVariant) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
					
	UNION ALL

	SELECT
		UnfinishedProductionCosts.Organization AS Organization,
		CASE
			WHEN NOT Constants.UseProductionManagement2_2
				THEN UNDEFINED
			WHEN UnfinishedProductionCosts.CorDimensionOfProductsAccounting.StorageType = VALUE(Enum.StorageLocationTypes.Department)
				THEN UnfinishedProductionCosts.CorDimensionOfProductsAccounting.Department
			ELSE UnfinishedProductionCosts.CorDimensionOfProductsAccounting.WarehouseArea.Department
		END AS ProductDepartment,
		UnfinishedProductionCosts.CorDimensionOfProductsAccounting.Products AS ManufacturedProduct,
		UnfinishedProductionCosts.CorDimensionOfProductsAccounting.Characteristic AS ItemVariant,
		UnfinishedProductionCosts.CorDimensionOfProductsAccounting.Products.UnitOfMeasure AS ProductUnitOfMeasure,
		UnfinishedProductionCosts.CorDimensionOfProductsAccounting.Series AS ProductionSeries_,
		UnfinishedProductionCosts.CorDimensionOfProductsAccounting.Purpose AS AssignmentOfProducts,
		0,
		CASE
			WHEN &amp;Cost_Data = 1
				THEN UnfinishedProductionCosts.Cost
			WHEN &amp;Cost_Data = 2
				THEN UnfinishedProductionCosts.Cost
			ELSE
				UnfinishedProductionCosts.LocalCost
		END AS CostOfCosts,
		0,
		0,
		0,
		UnfinishedProductionCosts.Recorder
	FROM
		ProductBatches AS ProductBatches
			INNER JOIN AccumulationRegister.WIPLaborCosts AS UnfinishedProductionCosts
			ON ProductBatches.Lot = UnfinishedProductionCosts.Recorder
			LEFT JOIN Constants AS Constants
			ON (TRUE)
	WHERE
		UnfinishedProductionCosts.RecordType = VALUE(AccumulationRecordType.Expense)
		AND (UnfinishedProductionCosts.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
	{WHERE
		((UnfinishedProductionCosts.CorDimensionOfProductsAccounting.Products, UnfinishedProductionCosts.CorDimensionOfProductsAccounting.Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
) AS NestedQuery

GROUP BY
	NestedQuery.Organization,
	NestedQuery.ProductDepartment,
	NestedQuery.ManufacturedProduct,
	NestedQuery.ItemVariant,
	NestedQuery.ProductUnitOfMeasure,
	NestedQuery.ProductionSeries_,
	NestedQuery.AssignmentOfProducts,
	NestedQuery.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	LaborCosts.Recorder AS ProductsBatch,
	LaborCosts.ProductionSeries_ AS ProductionSeries_,
	LaborCosts.ManufacturedProduct AS ManufacturedProduct,
	LaborCosts.ItemVariant AS ItemVariant,
	LaborCosts.AssignmentOfProducts AS AssignmentOfProducts,
	LaborCosts.Organization AS Organization,
	LaborCosts.ProductDepartment AS ProductDepartment,
	LaborCosts.ProductUnitOfMeasure AS ProductUnitOfMeasure,
	&amp;LineLaborCosts AS CostKind,
	LaborCosts.CostOfLaborCosts AS CostOfCosts
INTO Costs
FROM
	AllProductionCosts AS LaborCosts
WHERE
	NOT LaborCosts.CostOfLaborCosts = 0

UNION ALL

SELECT
	Itemized.Recorder,
	Itemized.ProductionSeries_,
	Itemized.ManufacturedProduct,
	Itemized.ItemVariant,
	Itemized.AssignmentOfProducts,
	Itemized.Organization,
	Itemized.ProductDepartment,
	Itemized.ProductUnitOfMeasure,
	&amp;LineItemized,
	Itemized.CostArticleByArticle
FROM
	AllProductionCosts AS Itemized
WHERE
	NOT Itemized.CostArticleByArticle = 0

UNION ALL

SELECT
	MaterialCosts.Recorder,
	MaterialCosts.ProductionSeries_,
	MaterialCosts.ManufacturedProduct,
	MaterialCosts.ItemVariant,
	MaterialCosts.AssignmentOfProducts,
	MaterialCosts.Organization,
	MaterialCosts.ProductDepartment,
	MaterialCosts.ProductUnitOfMeasure,
	&amp;LineMaterial,
	MaterialCosts.CostMaterialCosts
FROM
	AllProductionCosts AS MaterialCosts
WHERE
	NOT MaterialCosts.CostMaterialCosts = 0

UNION ALL

SELECT
	AddExpensesForGoods.Recorder,
	AddExpensesForGoods.ProductionSeries_,
	AddExpensesForGoods.ManufacturedProduct,
	AddExpensesForGoods.ItemVariant,
	AddExpensesForGoods.AssignmentOfProducts,
	AddExpensesForGoods.Organization,
	AddExpensesForGoods.ProductDepartment,
	AddExpensesForGoods.ProductUnitOfMeasure,
	&amp;LineAddExpenses,
	AddExpensesForGoods.AdditionalExpenseCost
FROM
	AllProductionCosts AS AddExpensesForGoods
WHERE
	NOT AddExpensesForGoods.AdditionalExpenseCost = 0

UNION ALL

SELECT
	OffBalance.Recorder,
	OffBalance.ProductionSeries_,
	OffBalance.ManufacturedProduct,
	OffBalance.ItemVariant,
	OffBalance.AssignmentOfProducts,
	OffBalance.Organization,
	OffBalance.ProductDepartment,
	OffBalance.ProductUnitOfMeasure,
	&amp;RowOffBalance,
	OffBalance.OffBalanceCost
FROM
	AllProductionCosts AS OffBalance
WHERE
	NOT OffBalance.OffBalanceCost = 0
	AND &amp;DisplayOffBalance = TRUE
	
INDEX BY
	ProductsBatch,
	ProductionSeries_,
	ManufacturedProduct,
	ItemVariant,
	AssignmentOfProducts
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductCostings.StandardCostEstimate AS StandardCostEstimate,
	MultiplesOfLotsAndSemiFinishedProducts.LotProductBOM AS CalculationBatchOfProducts,
	ProductCostings.ManufacturedProduct AS ManufacturedProduct,
	ProductCostings.ItemVariant AS ItemVariant,
	ProductCostings.AssignmentOfProducts AS Purpose,
	ProductCostings.Lot AS LotProductBOM,
	MultiplesOfLotsAndSemiFinishedProducts.Purpose AS CalculationPurposeOfProducts,
	ProductCostings.ProductQuantityActual / MultiplesOfLotsAndSemiFinishedProducts.QuantityOfSemiFinishedProduct AS CostShare,
	MultiplesOfLotsAndSemiFinishedProducts.Numerator * ProductCostings.ProductQuantityActual / MultiplesOfLotsAndSemiFinishedProducts.QuantityOfSemiFinishedProduct AS Numerator,
	MultiplesOfLotsAndSemiFinishedProducts.Denominator AS Denominator,
	ProductCostings.OrderCosting AS OrderCosting,
	ProductCostings.ProductQuantityActual AS ProductQuantityActual,
	ProductCostings.Organization AS Organization,
	ProductCostings.ProductionSeries_ AS ProductionSeries_,
	MultiplesOfLotsAndSemiFinishedProducts.KeyLot AS KeyLot
INTO SharesOfCostOfPlannedData
FROM
	ProductCostings AS ProductCostings
		INNER JOIN InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS MultiplesOfLotsAndSemiFinishedProducts
		ON ProductCostings.ManufacturedProduct = MultiplesOfLotsAndSemiFinishedProducts.ManufacturedProduct
			AND ProductCostings.ItemVariant = MultiplesOfLotsAndSemiFinishedProducts.ItemVariant
			AND ProductCostings.StandardCostEstimate = MultiplesOfLotsAndSemiFinishedProducts.StandardCostEstimate
			AND (ProductCostings.AssignmentOfProducts = MultiplesOfLotsAndSemiFinishedProducts.Purpose
				OR NOT ProductCostings.FilterByAssignment)
			AND (CASE
				WHEN ProductCostings.OrderCosting
					THEN MultiplesOfLotsAndSemiFinishedProducts.LotProductBOM = ProductCostings.Lot
				ELSE TRUE
			END)
			AND (MultiplesOfLotsAndSemiFinishedProducts.SemiFinishedProduct = VALUE(Catalog.Products.EmptyRef))

INDEX BY
	StandardCostEstimate,
	CalculationBatchOfProducts
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SharesOfCostOfPlannedData.StandardCostEstimate AS StandardCostEstimate,
	SharesOfCostOfPlannedData.ManufacturedProduct AS ManufacturedProduct,
	SharesOfCostOfPlannedData.ItemVariant AS ItemVariant,
	SharesOfCostOfPlannedData.Purpose AS Purpose,
	SharesOfCostOfPlannedData.LotProductBOM AS LotProductBOM,
	PlannedMaterialCosts.Department AS Department,
	&amp;LineMaterial AS CostKind,
	SUM(CASE WHEN &amp;Cost_Data = 1
				THEN PlannedMaterialCosts.Cost
			WHEN &amp;Cost_Data = 2
				THEN PlannedMaterialCosts.CostExcludingVAT
			ELSE
				PlannedMaterialCosts.LocalCost
			END * SharesOfCostOfPlannedData.Numerator / SharesOfCostOfPlannedData.Denominator) AS Cost,
	SharesOfCostOfPlannedData.ProductQuantityActual AS ProductQuantityActual,
	SharesOfCostOfPlannedData.Organization AS Organization,
	SharesOfCostOfPlannedData.ProductionSeries_ AS ProductionSeries_,
	SharesOfCostOfPlannedData.KeyLot AS KeyLot
INTO ScheduledData
FROM
	SharesOfCostOfPlannedData AS SharesOfCostOfPlannedData
		INNER JOIN AccumulationRegister.PlannedMaterialCosts AS PlannedMaterialCosts
		ON SharesOfCostOfPlannedData.StandardCostEstimate = PlannedMaterialCosts.StandardCostEstimate
			AND SharesOfCostOfPlannedData.CalculationBatchOfProducts = PlannedMaterialCosts.LotBOM
			AND SharesOfCostOfPlannedData.KeyLot = PlannedMaterialCosts.KeyLot

GROUP BY
	SharesOfCostOfPlannedData.StandardCostEstimate,
	SharesOfCostOfPlannedData.ManufacturedProduct,
	SharesOfCostOfPlannedData.ItemVariant,
	SharesOfCostOfPlannedData.Purpose,
	SharesOfCostOfPlannedData.LotProductBOM,
	SharesOfCostOfPlannedData.KeyLot,
	PlannedMaterialCosts.Department,
	SharesOfCostOfPlannedData.ProductQuantityActual,
	SharesOfCostOfPlannedData.Organization,
	SharesOfCostOfPlannedData.ProductionSeries_

UNION ALL

SELECT
	SharesOfCostOfPlannedData.StandardCostEstimate,
	SharesOfCostOfPlannedData.ManufacturedProduct,
	SharesOfCostOfPlannedData.ItemVariant,
	SharesOfCostOfPlannedData.Purpose,
	SharesOfCostOfPlannedData.LotProductBOM,
	PlannedLaborCosts.Department,
	&amp;LineLaborCosts,
	SUM(CASE WHEN &amp;Cost_Data = 3
				THEN PlannedLaborCosts.LocalCost
			ELSE
				PlannedLaborCosts.Cost
			END * SharesOfCostOfPlannedData.Numerator / SharesOfCostOfPlannedData.Denominator),
	SharesOfCostOfPlannedData.ProductQuantityActual,
	SharesOfCostOfPlannedData.Organization,
	SharesOfCostOfPlannedData.ProductionSeries_,
	SharesOfCostOfPlannedData.KeyLot AS KeyLot
FROM
	SharesOfCostOfPlannedData AS SharesOfCostOfPlannedData
		INNER JOIN AccumulationRegister.PlannedLaborCosts AS PlannedLaborCosts
		ON SharesOfCostOfPlannedData.StandardCostEstimate = PlannedLaborCosts.StandardCostEstimate
			AND SharesOfCostOfPlannedData.CalculationBatchOfProducts = PlannedLaborCosts.LotBOM
			AND SharesOfCostOfPlannedData.KeyLot = PlannedLaborCosts.KeyLot

GROUP BY
	SharesOfCostOfPlannedData.StandardCostEstimate,
	SharesOfCostOfPlannedData.ManufacturedProduct,
	SharesOfCostOfPlannedData.ItemVariant,
	SharesOfCostOfPlannedData.Purpose,
	SharesOfCostOfPlannedData.LotProductBOM,
	PlannedLaborCosts.Department,
	SharesOfCostOfPlannedData.ProductQuantityActual,
	SharesOfCostOfPlannedData.Organization,
	SharesOfCostOfPlannedData.ProductionSeries_,
	SharesOfCostOfPlannedData.KeyLot

UNION ALL

SELECT
	SharesOfCostOfPlannedData.StandardCostEstimate,
	SharesOfCostOfPlannedData.ManufacturedProduct,
	SharesOfCostOfPlannedData.ItemVariant,
	SharesOfCostOfPlannedData.Purpose,
	SharesOfCostOfPlannedData.LotProductBOM,
	PlannedOtherCosts.Department,
	&amp;LineItemized,
	SUM(CASE WHEN &amp;Cost_Data = 1
				THEN PlannedOtherCosts.Cost
			WHEN &amp;Cost_Data = 2
				THEN PlannedOtherCosts.CostExcludingVAT
			ELSE
				PlannedOtherCosts.LocalCost
			END * SharesOfCostOfPlannedData.Numerator / SharesOfCostOfPlannedData.Denominator),
	SharesOfCostOfPlannedData.ProductQuantityActual,
	SharesOfCostOfPlannedData.Organization,
	SharesOfCostOfPlannedData.ProductionSeries_,
	SharesOfCostOfPlannedData.KeyLot AS KeyLot
FROM
	SharesOfCostOfPlannedData AS SharesOfCostOfPlannedData
		INNER JOIN AccumulationRegister.PlannedOtherCosts AS PlannedOtherCosts
		ON SharesOfCostOfPlannedData.StandardCostEstimate = PlannedOtherCosts.StandardCostEstimate
			AND SharesOfCostOfPlannedData.CalculationBatchOfProducts = PlannedOtherCosts.LotBOM
			AND SharesOfCostOfPlannedData.KeyLot = PlannedOtherCosts.KeyLot

GROUP BY
	SharesOfCostOfPlannedData.StandardCostEstimate,
	SharesOfCostOfPlannedData.ManufacturedProduct,
	SharesOfCostOfPlannedData.ItemVariant,
	SharesOfCostOfPlannedData.Purpose,
	SharesOfCostOfPlannedData.LotProductBOM,
	PlannedOtherCosts.Department,
	SharesOfCostOfPlannedData.ProductQuantityActual,
	SharesOfCostOfPlannedData.Organization,
	SharesOfCostOfPlannedData.ProductionSeries_,
	SharesOfCostOfPlannedData.KeyLot
	
UNION ALL

SELECT
	SharesOfCostOfPlannedData.StandardCostEstimate AS StandardCostEstimate,
	SharesOfCostOfPlannedData.ManufacturedProduct AS ManufacturedProduct,
	SharesOfCostOfPlannedData.ItemVariant AS ItemVariant,
	SharesOfCostOfPlannedData.Purpose AS Purpose,
	SharesOfCostOfPlannedData.LotProductBOM AS LotProductBOM,
	PlannedMaterialCosts.Department AS Department,
	&amp;RowOffBalance AS CostKind,
	SUM(CASE
			WHEN &amp;Cost_Data = 3
				THEN ISNULL(PlannedMaterialCosts.OffBalanceCostLocal, 0)
			ELSE
				ISNULL(PlannedMaterialCosts.OffBalanceCost, 0)
		END) AS OffBalanceSheet,
	SharesOfCostOfPlannedData.ProductQuantityActual AS ProductQuantityActual,
	SharesOfCostOfPlannedData.Organization AS Organization,
	SharesOfCostOfPlannedData.ProductionSeries_ AS ProductionSeries_,
	SharesOfCostOfPlannedData.KeyLot AS KeyLot
FROM
	SharesOfCostOfPlannedData AS SharesOfCostOfPlannedData
		INNER JOIN AccumulationRegister.PlannedMaterialCosts AS PlannedMaterialCosts
		ON SharesOfCostOfPlannedData.StandardCostEstimate = PlannedMaterialCosts.StandardCostEstimate
			AND SharesOfCostOfPlannedData.CalculationBatchOfProducts = PlannedMaterialCosts.LotBOM
			AND SharesOfCostOfPlannedData.KeyLot = PlannedMaterialCosts.KeyLot
WHERE
	&amp;DisplayOffBalance = TRUE

GROUP BY
	SharesOfCostOfPlannedData.StandardCostEstimate,
	SharesOfCostOfPlannedData.ManufacturedProduct,
	SharesOfCostOfPlannedData.ItemVariant,
	SharesOfCostOfPlannedData.Purpose,
	SharesOfCostOfPlannedData.LotProductBOM,
	PlannedMaterialCosts.Department,
	SharesOfCostOfPlannedData.ProductQuantityActual,
	SharesOfCostOfPlannedData.Organization,
	SharesOfCostOfPlannedData.ProductionSeries_,
	SharesOfCostOfPlannedData.KeyLot
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	NestedQuery.Organization AS Organization,
	NestedQuery.ProductDepartment AS ProductDepartment,
	NestedQuery.ManufacturedProduct AS ManufacturedProduct,
	NestedQuery.ItemVariant AS ItemVariant,
	NestedQuery.ProductUnitOfMeasure AS ProductUnitOfMeasure,
	NestedQuery.AssignmentOfProducts AS AssignmentOfProducts,
	NestedQuery.CostKind AS ExpenseType,
	NestedQuery.ProductsBatch AS ProductsBatch,
	NestedQuery.ProductQuantityActual AS ProductQuantityActual,
	NestedQuery.StandardCostEstimate AS StandardCostEstimate,
	&amp;GroupVariance AS GroupVariance,
	SUM(NestedQuery.CostFact) AS CostFact,
	SUM(NestedQuery.CostPlan) AS CostPlan,
	CASE
		WHEN VALUETYPE(NestedQuery.StandardCostEstimate) = TYPE(Document.StandardCosting2_2)
				AND NOT NestedQuery.StandardCostEstimate = VALUE(Document.StandardCosting2_2.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS CostingIsFound,
	NestedQuery.ProductionSeries_ AS ProductionSeries_
FROM
	(SELECT
		Costs.Organization AS Organization,
		Costs.ProductDepartment AS ProductDepartment,
		Costs.ManufacturedProduct AS ManufacturedProduct,
		Costs.ItemVariant AS ItemVariant,
		Costs.ProductUnitOfMeasure AS ProductUnitOfMeasure,
		Costs.AssignmentOfProducts AS AssignmentOfProducts,
		Costs.CostKind AS CostKind,
		0 AS CostPlan,
		Costs.ProductsBatch AS ProductsBatch,
		ProductCostings.ProductQuantityActual AS ProductQuantityActual,
		ProductCostings.StandardCostEstimate AS StandardCostEstimate,
		SUM(Costs.CostOfCosts) AS CostFact,
		Costs.ProductionSeries_ AS ProductionSeries_
	FROM
		Costs AS Costs
			LEFT JOIN ProductCostings AS ProductCostings
			ON (ProductCostings.ManufacturedProduct = Costs.ManufacturedProduct)
				AND (ProductCostings.ItemVariant = Costs.ItemVariant)
				AND (ProductCostings.AssignmentOfProducts = Costs.AssignmentOfProducts)
				AND (ProductCostings.Lot = Costs.ProductsBatch)
				AND Costs.ProductionSeries_ = ProductCostings.ProductionSeries_
	
	GROUP BY
		Costs.ProductDepartment,
		Costs.ManufacturedProduct,
		Costs.Organization,
		Costs.ItemVariant,
		Costs.ProductUnitOfMeasure,
		Costs.CostKind,
		Costs.AssignmentOfProducts,
		ProductCostings.StandardCostEstimate,
		Costs.ProductsBatch,
		ProductCostings.ProductQuantityActual,
		Costs.ProductionSeries_
	
	UNION ALL
	
	SELECT
		ScheduledData.Organization,
		ScheduledData.Department,
		ScheduledData.ManufacturedProduct,
		ScheduledData.ItemVariant,
		ScheduledData.ManufacturedProduct.UnitOfMeasure,
		ScheduledData.Purpose,
		ScheduledData.CostKind,
		ScheduledData.Cost,
		ScheduledData.LotProductBOM,
		ScheduledData.ProductQuantityActual,
		ScheduledData.StandardCostEstimate,
		0,
		ScheduledData.ProductionSeries_
	FROM
		ScheduledData AS ScheduledData) AS NestedQuery

GROUP BY
	NestedQuery.Organization,
	NestedQuery.ProductDepartment,
	NestedQuery.ManufacturedProduct,
	NestedQuery.ItemVariant,
	NestedQuery.ProductUnitOfMeasure,
	NestedQuery.AssignmentOfProducts,
	NestedQuery.CostKind,
	NestedQuery.ProductsBatch,
	NestedQuery.StandardCostEstimate,
	NestedQuery.ProductQuantityActual,
	NestedQuery.ProductionSeries_</query>
	</dataSet>
