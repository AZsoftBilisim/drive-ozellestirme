	<totalField>
		<dataPath>Deviation</dataPath>
		<expression>Sum(Deviation)</expression>
	</totalField>
	<totalField>
		<dataPath>DeviationByOne</dataPath>
		<expression>Sum(DeviationByOne)</expression>
	</totalField>
	<totalField>
		<dataPath>CostPlan</dataPath>
		<expression>Sum(CostPlan)</expression>
	</totalField>
	<totalField>
		<dataPath>CostFact</dataPath>
		<expression>Sum(CostFact)</expression>
	</totalField>
	<totalField>
		<dataPath>ProductsQuantity</dataPath>
		<expression>Sum(ProductsQuantity)</expression>
	</totalField>
	<totalField>
		<dataPath>VariancePercentage</dataPath>
		<expression>Case When EvalExpression("Sum(CostFact)","ProductsBatch") &lt;&gt; 0 Then
    100*EvalExpression("Sum(Deviation)", "ProductsBatch")/EvalExpression("Sum(CostFact)","ProductsBatch")
Else
    0
End</expression>
	</totalField>
	<totalField>
		<dataPath>VariancePercentage</dataPath>
		<expression>Case When EvalExpression("Sum(CostFact)","ManufacturedProduct") &lt;&gt; 0 Then
    100*EvalExpression("Sum(Deviation)", "ManufacturedProduct")/EvalExpression("Sum(CostFact)","ManufacturedProduct")
Else
    0
End</expression>
		<group>ManufacturedProduct</group>
	</totalField>
