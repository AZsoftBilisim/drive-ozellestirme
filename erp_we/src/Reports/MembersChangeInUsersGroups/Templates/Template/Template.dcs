							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>کاربر غیرفعال (با رنگ خاکستری مشخص شده).</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>серый цвет пользователя, если пользователь не активен.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>kullanıcı eğer aktif değil ise gri renkte gösterilir.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>màu xám của người sử dụng, nếu chưa kích hoạt người sử dụng.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Inactive user (highlighted gray).</v8:content>
							</v8:item>
