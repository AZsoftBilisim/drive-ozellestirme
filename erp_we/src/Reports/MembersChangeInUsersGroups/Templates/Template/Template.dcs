								<v8:content>External user's activity was changed.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>فعالیت کاربر خارجی تغییر کرد.</v8:content>
							</v8:item>
							<v8:item>
