	<settingsVariant>
		<dcsset:name>ChangeABCXYZClassificationOfCustomers</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Change ABC/XYZ distribution of customers</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تغییر توزیع ABC/XYZ مشتریان</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Modifica ABC/XYZ - distribuzione dei clienti</v8:content>
