		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ABCXYZCustomerClassificationSliceLast.Partner AS Partner,
	ABCXYZCustomerClassificationSliceLast.Class AS Class,
	ABCXYZCustomerClassificationSliceLast.ClassificationParameterValue AS ClassificationParameterValue,
	&amp;LineCur AS Classification
INTO CurrentABC
FROM
	InformationRegister.ABCXYZCustomerClassification.SliceLast(&amp;CurrentPeriod, ) AS ABCXYZCustomerClassificationSliceLast
WHERE
	ABCXYZCustomerClassificationSliceLast.ClassificationType = VALUE(Enum.TypesOfClassification.ABC)
	AND ABCXYZCustomerClassificationSliceLast.ClassificationParameterType = &amp;ClassificationParameterType

;
////////////////////////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ABCXYZCustomerClassificationSliceLast.Partner AS Partner,
	ABCXYZCustomerClassificationSliceLast.Class AS Class,
	ABCXYZCustomerClassificationSliceLast.ClassificationParameterValue AS ClassificationParameterValue,
	&amp;PreviousLine AS Classification
INTO PreviousABC
FROM
	InformationRegister.ABCXYZCustomerClassification.SliceLast(&amp;PreviousPeriod, ) AS ABCXYZCustomerClassificationSliceLast
WHERE
	ABCXYZCustomerClassificationSliceLast.ClassificationType = VALUE(Enum.TypesOfClassification.ABC)
	AND ABCXYZCustomerClassificationSliceLast.ClassificationParameterType = &amp;ClassificationParameterType

;
////////////////////////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ABCXYZCustomerClassificationSliceLast.Partner AS Partner,
	ABCXYZCustomerClassificationSliceLast.Class AS Class,
	&amp;LineCur AS Classification
INTO CurrentXYZ
FROM
	InformationRegister.ABCXYZCustomerClassification.SliceLast(&amp;CurrentPeriod, ) AS ABCXYZCustomerClassificationSliceLast
WHERE
	ABCXYZCustomerClassificationSliceLast.ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)
	AND ABCXYZCustomerClassificationSliceLast.ClassificationParameterType = &amp;ClassificationParameterType

;
////////////////////////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ABCXYZCustomerClassificationSliceLast.Partner AS Partner,
	ABCXYZCustomerClassificationSliceLast.Class AS Class,
	&amp;PreviousLine AS Classification
INTO PreviousXYZ
FROM
	InformationRegister.ABCXYZCustomerClassification.SliceLast(&amp;PreviousPeriod, ) AS ABCXYZCustomerClassificationSliceLast
WHERE
	ABCXYZCustomerClassificationSliceLast.ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)
	AND ABCXYZCustomerClassificationSliceLast.ClassificationParameterType = &amp;ClassificationParameterType

;
////////////////////////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ISNULL(CurrentXYZ.Class, VALUE(Enum.XYZClassification.EmptyRef)) AS CurrentXYZ,
	ISNULL(CurrentABC.Class, VALUE(Enum.ABCClassification.EmptyRef)) AS CurrentABC,
	ISNULL(CurrentABC.ClassificationParameterValue, 0) AS CurrentValueOfClassificationParameter,
	ISNULL(PreviousXYZ.Class, VALUE(Enum.XYZClassification.EmptyRef)) AS PreviousXYZ,
	ISNULL(PreviousABC.Class, VALUE(Enum.ABCClassification.EmptyRef)) AS PreviousABC,
	ISNULL(PreviousABC.ClassificationParameterValue, 0) AS PreviousClassificationParameterValue,
	Partners.Ref AS Partner
{SELECT
	CurrentXYZ,
	CurrentABC,
	CurrentValueOfClassificationParameter,
	PreviousXYZ,
	PreviousABC,
	PreviousClassificationParameterValue,
	Partner.*}
FROM
	Catalog.Partners AS Partners
		LEFT JOIN CurrentABC
		ON Partners.Ref = CurrentABC.Partner
		LEFT JOIN PreviousABC
		ON Partners.Ref = PreviousABC.Partner
		LEFT JOIN  CurrentXYZ
		ON Partners.Ref = CurrentXYZ.Partner
		LEFT JOIN PreviousXYZ
		ON Partners.Ref = PreviousXYZ.Partner
WHERE
	(NOT Partners.DeletionMark) AND (NOT Partners.Predefined)
{WHERE
	(ISNULL(CurrentXYZ.Class, VALUE(Enum.XYZClassification.EmptyRef))).* AS CurrentXYZ,
	(ISNULL(CurrentABC.Class, VALUE(Enum.ABCClassification.EmptyRef))).* AS ThoseOfABC,
	CurrentABC.ClassificationParameterValue AS CurrentValueOfClassificationParameter,
	(ISNULL(PreviousXYZ.Class, VALUE(Enum.XYZClassification.EmptyRef))).* AS PreviousXYZ,
	(ISNULL(PreviousABC.Class, VALUE(Enum.ABCClassification.EmptyRef))).* AS PreviousABC,
	PreviousABC.ClassificationParameterValue AS PreviousClassificationParameterValue,
	Partners.Ref.* AS Partner}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
