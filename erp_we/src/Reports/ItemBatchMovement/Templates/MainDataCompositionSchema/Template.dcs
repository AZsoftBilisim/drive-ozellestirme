			</v8:item>
		</title>
		<presentationExpression>Sender.Description
+ Case When WareroomOfSender &lt;&gt; Value(Catalog.Warerooms.EmptyRef)
    Then " / " + IsNull(WareroomOfSender.Description, "") Else "" End</presentationExpression>
	</calculatedField>
	<calculatedField>
		<dataPath>RecipientPresentation</dataPath>
		<expression>Recipient</expression>
