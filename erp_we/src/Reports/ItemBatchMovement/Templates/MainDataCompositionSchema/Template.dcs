		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	GoodsBatchMovement.Products AS Products,
	GoodsBatchMovement.Characteristic AS Characteristic,
	GoodsBatchMovement.Series AS Series,
	GoodsBatchMovement.Document AS Document,
	GoodsBatchMovement.Period AS Date,
	GoodsBatchMovement.Sender AS Sender,
	GoodsBatchMovement.WareroomOfSender AS WareroomOfSender,
	GoodsBatchMovement.Recipient AS Recipient,
	GoodsBatchMovement.WareroomOfRecipient AS WareroomOfRecipient,
	GoodsBatchMovement.RecipientCharacteristic AS RecipientCharacteristic,
	GoodsBatchMovement.WarehouseOperation AS Operation,
	CASE
		WHEN GoodsBatchMovement.WarehouseOperation IN (&amp;GoodsReceiptOperations)
				OR GoodsBatchMovement.WarehouseOperation = VALUE(Enum.WarehouseTransactions.DamageRecord)
					AND NOT GoodsBatchMovement.Recipient REFS Catalog.Products
			THEN GoodsBatchMovement.Count
		ELSE 0
	END AS Received,
	CASE
		WHEN GoodsBatchMovement.WarehouseOperation IN (&amp;TransferOperations)
			THEN GoodsBatchMovement.Count
		ELSE 0
	END AS Transferred,
	CASE
		WHEN GoodsBatchMovement.WarehouseOperation IN (&amp;ExpenseTransactions)
				OR GoodsBatchMovement.WarehouseOperation = VALUE(Enum.WarehouseTransactions.DamageRecord)
					AND GoodsBatchMovement.Recipient REFS Catalog.Products
			THEN GoodsBatchMovement.Count
		ELSE 0
	END AS Spent
FROM
	AccumulationRegister.GoodsBatchMovement AS GoodsBatchMovement
WHERE
	GoodsBatchMovement.ThisIsWarehouseRecord
	AND (CASE
			WHEN &amp;Products = VALUE(Catalog.Products.EmptyRef)
				THEN GoodsBatchMovement.Series = &amp;Series
			WHEN &amp;Series = VALUE(Catalog.ItemsBatches.EmptyRef)
				THEN GoodsBatchMovement.Products = &amp;Products
			ELSE GoodsBatchMovement.Products = &amp;Products
				AND GoodsBatchMovement.Series = &amp;Series
		END)
	AND (&amp;ConsigneeOrSender IN (UNDEFINED, VALUE(Catalog.BusinessStructure.EmptyRef), VALUE(Catalog.Partners.EmptyRef), VALUE(Catalog.Warehouses.EmptyRef))
			OR GoodsBatchMovement.Sender = &amp;ConsigneeOrSender
			OR GoodsBatchMovement.Recipient = &amp;ConsigneeOrSender)
	AND (NOT &amp;UseSenderOrRecipientWareroom
			OR GoodsBatchMovement.Sender = &amp;ConsigneeOrSender
				AND GoodsBatchMovement.WareroomOfSender = &amp;ShippingOrReceivingWareroom
			OR GoodsBatchMovement.Recipient = &amp;ConsigneeOrSender
				AND GoodsBatchMovement.WareroomOfRecipient = &amp;ShippingOrReceivingWareroom)</query>
	</dataSet>
	<calculatedField>
		<dataPath>SenderPresentation</dataPath>
		<expression>Sender</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
