				<v8:content>Người nhận</v8:content>
			</v8:item>
		</title>
		<presentationExpression>Recipient.Description
+ Case When WareroomOfRecipient &lt;&gt; Value(Catalog.Warerooms.EmptyRef)
    Then " / " + IsNull(WareroomOfRecipient.Description, "") Else "" End
</presentationExpression>
	</calculatedField>
