			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterAccountingAnalyticsForPartners.Organization AS Organization,
	RegisterAccountingAnalyticsForPartners.Partner AS Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty AS Counterparty,
	RegisterAccountingAnalyticsForPartners.Contract AS Contract, 
	RegisterAccountingAnalyticsForPartners.LineOfBusiness AS LineOfBusinessOfAnalytics, 
	RegisterAccountingAnalyticsForPartners.DimensionKey AS DimensionKey
	
INTO RevisingAccountingForPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
;
///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ARAPObjects.Organization AS Organization,
	ARAPObjects.Partner AS Partner,
	ARAPObjects.Counterparty AS Counterparty,
	ARAPObjects.Contract AS Contract, 
	ARAPObjects.LineOfBusiness AS LineOfBusinessOfARAPObject,
	ARAPObjects.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness AS ARAPAccountingRegistersAreNotDividedByLinesOfBusiness,
	ARAPObjects.Ref AS ARAPObject,
	ARAPObjects.Object AS Object
	
INTO ARAPObjects
FROM
	Catalog.ARAPObjects AS ARAPObjects
;
///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CustomersARAPAccounting.Period AS Period,
	CASE WHEN CustomersARAPAccounting.Recorder = UNDEFINED THEN 
		NULL
	ELSE
		CASE WHEN VALUETYPE(ARAPObjects.Object) IN (TYPE(Document.BankAccountReceiptNote),
														TYPE(Document.BankAccountIssue),
														TYPE(Document.CashAccountReceiptNote),
														TYPE(Document.CashVoucher),
														TYPE(Document.PaymentCardTransaction),
														TYPE(Document.OBEntry))
					AND CustomersARAPAccounting.Recorder = &amp;CurrentDocument
				THEN ARAPObjects.Object
			ELSE CustomersARAPAccounting.Recorder
		END
	END AS Recorder,
	CustomersARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CASE WHEN VALUETYPE(ARAPObjects.Object) IN (TYPE(Document.BankAccountReceiptNote),
														TYPE(Document.BankAccountIssue),
														TYPE(Document.CashAccountReceiptNote),
														TYPE(Document.CashVoucher),
														TYPE(Document.PaymentCardTransaction),
														TYPE(Document.OBEntry))
					AND CustomersARAPAccounting.Recorder = &amp;CurrentDocument
				THEN CustomersARAPAccounting.Recorder 
			ELSE ARAPObjects.Object
	END AS SalesOrder,
	CustomersARAPAccounting.Currency AS Currency,
	
	DimensionByPartners.Partner AS Partner,
	DimensionByPartners.Organization AS Organization,
	DimensionByPartners.Counterparty AS Counterparty,
	DimensionByPartners.Contract AS Contract,   
	CASE WHEN NOT ARAPObjects.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN DimensionByPartners.LineOfBusinessOfAnalytics
		ELSE ARAPObjects.LineOfBusinessOfARAPObject
	END AS LineOfBusiness,
	
	// Our duty	
	CASE WHEN CustomersARAPAccounting.SumOpeningBalance &lt; 0 THEN
		-CustomersARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS AccountsPayableOfCompanyOpeningBalance,
		
	CASE WHEN CustomersARAPAccounting.SumClosingBalance &lt; 0 THEN
		-CustomersARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS AccountsPayableOfCompanyClosingBalance,
	
	// Our debt (overdue)
	CASE WHEN CustomersARAPAccounting.SumOpeningBalance &lt; 0
		AND CustomersARAPAccounting.ToShipOpeningBalance &lt; 0
		AND (CustomersARAPAccounting.Period &lt; &amp;ReportDate AND BEGINOFPERIOD(CustomersARAPAccounting.Period, DAY) = BEGINOFPERIOD(&amp;ReportDate, DAY) OR CustomersARAPAccounting.Period &lt;&gt; &amp;ReportDate)
	THEN
		CASE WHEN (-CustomersARAPAccounting.SumOpeningBalance) &gt; (-CustomersARAPAccounting.ToShipOpeningBalance) THEN
			-CustomersARAPAccounting.ToShipOpeningBalance
		ELSE
			-CustomersARAPAccounting.SumOpeningBalance
		END
	ELSE
		0
	END AS OurDebtOverdueOpeningBalance,
	
	CASE WHEN CustomersARAPAccounting.SumClosingBalance &lt; 0
		AND CustomersARAPAccounting.ToShipClosingBalance &lt; 0
		AND (CustomersARAPAccounting.Period &lt; &amp;ReportDate AND BEGINOFPERIOD(CustomersARAPAccounting.Period, DAY) = BEGINOFPERIOD(&amp;ReportDate, DAY) OR CustomersARAPAccounting.Period &lt;&gt; &amp;ReportDate)
	THEN
		CASE WHEN (-CustomersARAPAccounting.SumClosingBalance) &gt; (-CustomersARAPAccounting.ToShipClosingBalance) THEN
			-CustomersARAPAccounting.ToShipClosingBalance
		ELSE
			-CustomersARAPAccounting.SumClosingBalance
		END
	ELSE
		0
	END AS OurDebtOverdueClosingBalance,
	
	// The debt of the client
	CASE WHEN CustomersARAPAccounting.SumOpeningBalance &gt; 0 THEN
		CustomersARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS CustomerAccountsReceivableOpeningBalance,
	
	CASE WHEN CustomersARAPAccounting.SumClosingBalance &gt; 0 THEN
		CustomersARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS CustomerAccountsReceivableClosingBalance,
	
	// Customer's debt (overdue)
	CASE WHEN CustomersARAPAccounting.SumOpeningBalance &gt; 0
		AND CustomersARAPAccounting.AmountDueOpeningBalance &gt; 0
		AND (CustomersARAPAccounting.Period &lt; &amp;ReportDate AND BEGINOFPERIOD(CustomersARAPAccounting.Period, DAY) = BEGINOFPERIOD(&amp;ReportDate, DAY) OR CustomersARAPAccounting.Period &lt;&gt; &amp;ReportDate)
	THEN
		CASE WHEN CustomersARAPAccounting.SumOpeningBalance &gt; CustomersARAPAccounting.AmountDueOpeningBalance THEN
			CustomersARAPAccounting.AmountDueOpeningBalance
		ELSE
			CustomersARAPAccounting.SumOpeningBalance
		END
	ELSE
		0
	END AS OverdueCustomerDebtOpeningBalance,
	
	CASE WHEN CustomersARAPAccounting.SumClosingBalance &gt; 0
		AND CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
		AND (CustomersARAPAccounting.Period &lt; &amp;ReportDate AND BEGINOFPERIOD(CustomersARAPAccounting.Period, DAY) = BEGINOFPERIOD(&amp;ReportDate, DAY) OR CustomersARAPAccounting.Period &lt;&gt; &amp;ReportDate)
	THEN
		CASE WHEN CustomersARAPAccounting.SumClosingBalance &gt; CustomersARAPAccounting.AmountDueClosingBalance THEN
			CustomersARAPAccounting.AmountDueClosingBalance
		ELSE
			CustomersARAPAccounting.SumClosingBalance
		END
	ELSE
		0
	END AS OverdueCustomerDebtClosingBalance,
	
	CASE WHEN CustomersARAPAccounting.SumTurnover &lt; 0 THEN
		-CustomersARAPAccounting.SumTurnover
	ELSE
		CustomersARAPAccounting.SumTurnover
	END AS Sum,
	
	CASE
		WHEN ISNULL(CustomersARAPAccounting.SumOpeningBalance, 0) &gt; 0 AND ISNULL(CustomersARAPAccounting.BeingShippedOpeningBalance, 0) &lt;= 0
			THEN ISNULL(CustomersARAPAccounting.SumOpeningBalance, 0)
		WHEN ISNULL(CustomersARAPAccounting.SumOpeningBalance, 0) &gt;= 0 AND ISNULL(CustomersARAPAccounting.BeingShippedOpeningBalance, 0) &gt; 0
			THEN ISNULL(CustomersARAPAccounting.SumOpeningBalance, 0) + ISNULL(CustomersARAPAccounting.BeingShippedOpeningBalance, 0)
		ELSE 0
	END AS CustomerDebtTotalOpeningBalance,
	CASE
		WHEN ISNULL(CustomersARAPAccounting.SumClosingBalance, 0) &gt; 0 AND ISNULL(CustomersARAPAccounting.BeingShippedClosingBalance, 0) &lt;= 0
			THEN ISNULL(CustomersARAPAccounting.SumClosingBalance, 0)
		WHEN ISNULL(CustomersARAPAccounting.SumClosingBalance, 0) &gt;= 0 AND ISNULL(CustomersARAPAccounting.BeingShippedClosingBalance, 0) &gt; 0
			THEN ISNULL(CustomersARAPAccounting.SumClosingBalance, 0) + ISNULL(CustomersARAPAccounting.BeingShippedClosingBalance, 0)
		ELSE 0
	END AS CustomerDebtTotalClosingBalance
	
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(, , Recorder, ,
		AccountingDimensionByPartners IN (
			SELECT
				DimensionKey
			FROM
				RevisingAccountingForPartners AS RevisingAccountingForPartners
			) {ARAPObject IN (&amp;CustomerOrderSelection)}
	) AS CustomersARAPAccounting
	
	INNER JOIN
		RevisingAccountingForPartners AS DimensionByPartners
	ON
		CustomersARAPAccounting.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	INNER JOIN
		ARAPObjects AS ARAPObjects
	ON
		ARAPObjects.ARAPObject = CustomersARAPAccounting.ARAPObject	
WHERE
	(CustomersARAPAccounting.SumTurnover &lt;&gt; 0 OR CustomersARAPAccounting.BeingShippedTurnover &lt;&gt; 0)
	AND DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND (&amp;CurrentDocument = UNDEFINED
		OR NOT VALUETYPE(ARAPObjects.Object) IN (TYPE(Document.BankAccountReceiptNote),
														TYPE(Document.BankAccountIssue),
														TYPE(Document.CashAccountReceiptNote),
														TYPE(Document.CashVoucher),
														TYPE(Document.PaymentCardTransaction),
														TYPE(Document.OBEntry))

		OR (VALUETYPE(ARAPObjects.Object) IN (TYPE(Document.BankAccountReceiptNote),
														TYPE(Document.BankAccountIssue),
														TYPE(Document.CashAccountReceiptNote),
														TYPE(Document.CashVoucher),
														TYPE(Document.PaymentCardTransaction),
														TYPE(Document.OBEntry))
														
					AND CustomersARAPAccounting.Recorder = &amp;CurrentDocument))
{WHERE
	DimensionByPartners.Partner IN (
		SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}</query>
		</item>
