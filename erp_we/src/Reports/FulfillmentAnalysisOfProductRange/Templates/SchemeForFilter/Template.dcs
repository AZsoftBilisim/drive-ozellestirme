		<field xsi:type="DataSetFieldField">
			<dataPath>PlanningObject</dataPath>
			<field>PlanningObject</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ProductMixQuotasSliceLast.PlanningObject AS StoreFormat,
	Shops.Warehouse AS Store,
	ProductMixQuotasSliceLast.ProductCategory.Owner AS ProductKind,
	ProductMixQuotasSliceLast.ProductCategory AS ProductCategory,
	ProductMixQuotasSliceLast.Brand AS Brand,
	TRUE AS ProductRangeIsBeingPerformed,
	ProductMixQuotasSliceLast.ItemsCollection
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast(&amp;Period, ) AS Shops
		INNER JOIN InformationRegister.ProductMixQuotas.SliceLast(&amp;Period, ) AS ProductMixQuotasSliceLast
		ON Shops.StoreFormat = ProductMixQuotasSliceLast.PlanningObject</query>
	</dataSet>
