				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönemler</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.AdvanceHolder AS AdvanceHolder,
	Cash.IssuancePurpose AS IssuancePurpose,
	Cash.Currency AS Currency,
	CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	
	Cash.SumOpeningBalance AS SumOpeningBalance,
	Cash.SumReceipt AS SumReceipt,
	Cash.SumExpense AS SumExpense,
	Cash.SumClosingBalance AS SumClosingBalance
	
{SELECT
	Organization.*,
	Department.*,
	AdvanceHolder.*,
	IssuancePurpose.*,
	Currency.*,
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	SumOpeningBalance,
	SumReceipt,
	SumExpense,
	SumClosingBalance
}
FROM
	AccumulationRegister.AdvanceHolderCash.BalanceAndTurnovers(, , Auto, , 
		{Organization.*}
		{Department.*}
		{AdvanceHolder.*}
		{IssuancePurpose.*}
		{Currency.*}
	) AS Cash
WHERE
	&amp;ReportData = 1
{WHERE
	(CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END).* AS Recorder,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod
}

UNION ALL

SELECT
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.AdvanceHolder AS AdvanceHolder,
	Cash.IssuancePurpose AS IssuancePurpose,
	&amp;ManagementAccountingCurrency AS Currency,
	CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	
	Cash.SumManOpeningBalance AS SumOpeningBalance,
	Cash.SumManReceipt AS SumReceipt,
	Cash.SumManExpense AS SumExpense,
	Cash.SumManClosingBalance AS SumClosingBalance
	
FROM
	AccumulationRegister.AdvanceHolderCash.BalanceAndTurnovers(, , Auto, , 
		{Organization.*}
		{Department.*}
		{AdvanceHolder.*}
		{IssuancePurpose.*}
		{Currency.*}
	) AS Cash
WHERE
	&amp;ReportData = 2
{WHERE
	(CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END).* AS Recorder,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod
}

UNION ALL

SELECT
	Cash.Organization AS Organization,
	Cash.Department AS Department,
	Cash.AdvanceHolder AS AdvanceHolder,
	Cash.IssuancePurpose AS IssuancePurpose,
	Cash.Organization.LocalAccountingCurrency AS Currency,
	CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	
	Cash.SumComplOpeningBalance AS SumOpeningBalance,
	Cash.SumComplReceipt AS SumReceipt,
	Cash.SumComplExpense AS SumExpense,
	Cash.SumComplClosingBalance AS SumClosingBalance
	
FROM
	AccumulationRegister.AdvanceHolderCash.BalanceAndTurnovers(, , Auto, , 
		{Organization.*}
		{Department.*}
		{AdvanceHolder.*}
		{IssuancePurpose.*}
		{Currency.*}
	) AS Cash
WHERE
	&amp;ReportData = 3
{WHERE
	(CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END).* AS Recorder,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod
}</query>
	</dataSet>
	<totalField>
		<dataPath>SumOpeningBalance</dataPath>
		<expression>Case
    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And Sum(SumOpeningBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumOpeningBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(SumOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumReceipt</dataPath>
		<expression>Case
    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And Sum(SumReceipt) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumReceipt), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(SumReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumExpense</dataPath>
		<expression>Case
    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And Sum(SumExpense) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumExpense), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(SumExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumClosingBalance</dataPath>
		<expression>Case
    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And Sum(SumClosingBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumClosingBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(SumClosingBalance)
End
</expression>
	</totalField>
