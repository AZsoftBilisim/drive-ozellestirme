			<field>VATActivityType</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusiness</dataPath>
			<field>LineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ExpenseItem</dataPath>
			<field>ExpenseItem</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DimensionOfExpenses</dataPath>
			<field>DimensionOfExpenses</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	&amp;LineAssetsMinusLiabilities AS AssetsMinusLiabilities,
	VALUE(Enum.KindsOfBalanceSheetStatementItems.AssetBalanceSheetName) AS IndicatorType,
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceGoodsAtWholesaleWarehouses) AS Factor,
		
	CostAccounting_.Organization AS Organization,
	&amp;ManagementAccountingCurrency AS Currency,
	&amp;ReportCurrency AS ReportCurrency,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.Products.EmptyRef) AS Dimension,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
		
	CostAccounting_.SecondPeriod AS SecondPeriod,
	CostAccounting_.DayPeriod AS DayPeriod,
	CostAccounting_.WeekPeriod AS WeekPeriod,
	CostAccounting_.TenDaysPeriod AS TenDaysPeriod,
	CostAccounting_.MonthPeriod AS MonthPeriod,
	CostAccounting_.QuarterPeriod AS QuarterPeriod,
	CostAccounting_.HalfYearPeriod AS HalfYearPeriod,
	CostAccounting_.YearPeriod AS YearPeriod,
	
	CostAccounting_.Recorder AS Recorder,
	VALUETYPE(CostAccounting_.Recorder) AS TypeOfRegistrar,
	
	CostAccounting_.CostOpeningBalance AS SumOpeningBalance,
	CostAccounting_.CostClosingBalance AS SumClosingBalance,
	0 AS Update,
	0 AS Increase,
	0 AS Decrease,
	CostAccounting_.CostOpeningBalance AS AmountInitialBalanceInCurrency,
	CostAccounting_.CostClosingBalance AS AmountFinalBalanceInCurrency,
	0 AS ChangeInCurrency
FROM
	AccumulationRegister.InventoryCost.BalanceAndTurnovers(, , Auto, , ) AS CostAccounting_

UNION ALL

SELECT
	&amp;LineAssetsMinusLiabilities AS AssetsMinusLiabilities,
	VALUE(Enum.KindsOfBalanceSheetStatementItems.AssetBalanceSheetName) AS IndicatorType,
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceGoodsAtWholesaleWarehouses) AS Factor,
		
	OtherExpenses.Organization AS Organization,
	&amp;ManagementAccountingCurrency AS Currency,
	&amp;ReportCurrency AS ReportCurrency,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.Products.EmptyRef) AS Dimension,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
		
	OtherExpenses.SecondPeriod AS SecondPeriod,
	OtherExpenses.DayPeriod AS DayPeriod,
	OtherExpenses.WeekPeriod AS WeekPeriod,
	OtherExpenses.TenDaysPeriod AS TenDaysPeriod,
	OtherExpenses.MonthPeriod AS MonthPeriod,
	OtherExpenses.QuarterPeriod AS QuarterPeriod,
	OtherExpenses.HalfYearPeriod AS HalfYearPeriod,
	OtherExpenses.YearPeriod AS YearPeriod,
	
	OtherExpenses.Recorder AS Recorder,
	VALUETYPE(OtherExpenses.Recorder) AS TypeOfRegistrar,
	
	OtherExpenses.SumOpeningBalance AS SumOpeningBalance,
	OtherExpenses.SumClosingBalance AS SumClosingBalance,
	0 AS Update,
	0 AS Increase,
	0 AS Decrease,
	OtherExpenses.SumOpeningBalance AS AmountInitialBalanceInCurrency,
	OtherExpenses.SumClosingBalance AS AmountFinalBalanceInCurrency,
	0 AS ChangeInCurrency
FROM
	AccumulationRegister.OtherExpenses.BalanceAndTurnovers(, , Auto, , ) AS OtherExpenses

UNION ALL

SELECT
	&amp;LineAssetsMinusLiabilities AS AssetsMinusLiabilities,
	VALUE(Enum.KindsOfBalanceSheetStatementItems.AssetBalanceSheetName) AS IndicatorType,
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceGoodsAtWholesaleWarehouses) AS Factor,
		
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	&amp;ManagementAccountingCurrency AS Currency,
	&amp;ReportCurrency AS ReportCurrency,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.Products.EmptyRef) AS Dimension,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	
	DATETIME(1,1,1) AS SecondPeriod,
	DATETIME(1,1,1) AS DayPeriod,
	DATETIME(1,1,1) AS WeekPeriod,
	DATETIME(1,1,1) AS TenDaysPeriod,
	DATETIME(1,1,1) AS MonthPeriod,
	DATETIME(1,1,1) AS QuarterPeriod,
	DATETIME(1,1,1) AS HalfYearPeriod,
	DATETIME(1,1,1) AS YearPeriod,
	
	CustomersARAPAccountingByDueDates.DocumentRecorder AS Recorder,
	VALUETYPE(CustomersARAPAccountingByDueDates.DocumentRecorder) AS TypeOfRegistrar,
	
	0 AS SumOpeningBalance,
	0 AS SumClosingBalance,
	0 AS Update,
	0 AS Increase,
	0 AS Decrease,
	0 AS AmountInitialBalanceInCurrency,
	0 AS AmountFinalBalanceInCurrency,
	0 AS ChangeInCurrency
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates AS CustomersARAPAccountingByDueDates</query>
	</dataSet>
