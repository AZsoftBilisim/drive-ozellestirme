   When TechnicalOperation = Value(Catalog.ManufacturingOperations.EmptyRef)
      Then Value(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
   Else TechnicalOperation.UnitOfMeasure
End</expression>
		<title xsi:type="v8:LocalStringType">
