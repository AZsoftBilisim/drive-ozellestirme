		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ProductionOperation2_2Protocol.Ref        AS Ref,
	ProductionOperation2_2Protocol.EmployeeResponsible AS Inspector,
	ProductionOperation2_2Protocol.Comment   AS ReasonForDefects
FROM
	Document.ProductionOperation2_2.Protocol AS ProductionOperation2_2Protocol
WHERE
	ProductionOperation2_2Protocol.Event = VALUE(Enum.RoutingOperationProtocolEvents.DefectiveGoods)
	AND ProductionOperation2_2Protocol.Ref.Posted = TRUE

GROUP BY
	ProductionOperation2_2Protocol.Ref,
	ProductionOperation2_2Protocol.EmployeeResponsible,
	ProductionOperation2_2Protocol.Comment</query>
