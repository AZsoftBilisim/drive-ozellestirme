		<field xsi:type="DataSetFieldField">
			<dataPath>Department</dataPath>
			<field>Department</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Business unit</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>واحد تجاری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Reparto</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Dział</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Подразделение</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Departman</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Bộ phận</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Operations.Department                                      AS Department,
	Operations.Stage                                               AS Stage,
	Operations.Operation                                           AS TechnicalOperation,
	VALUE(Document.ShiftTask.EmptyRef)              AS ShiftTask,
	DATETIME(1, 1, 1)                                          AS TaskDate_,
	DATETIME(1, 1, 1)                                          AS ExecutionStarted,
	DATETIME(1, 1, 1)                                          AS ExecutionEnd,
	CASE
		WHEN Operations.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
			THEN Operations.ProductionOperation
		ELSE VALUE(Document.ProductionOperation2_2.EmptyRef)
	END                                                       AS ProductionOperation,
	VALUE(Catalog.Persons.EmptyRef)            AS Performer,
	VALUE(Catalog.WorkCenters.EmptyRef)             AS WorkCenter,
	VALUE(Catalog.WorkCenterTypes.EmptyRef)        AS WorkCenterType,
	MAX(Operations.Required2)                                AS Required2,
	SUM(Operations.Scheduled)                               AS Plan,
	0                                                           AS Assigned_,
	0                                                           AS Running,
	0                                                           AS Completed2,
	0                                                           AS DefectiveGoods,
	0                                                           AS NotCompleted,
	0                                                           AS Skipped3,
	0                                                           AS Retry,
	0                                                           AS UnderControl,
	0                                                           AS UnderRevision,
	FALSE                                                        AS ControlAgain,
	1                                                           AS Priority,
	Operations.OperationNumber                                      AS OperationNumber,
	Operations.NextOperation                             AS NextOperation
FROM
	InformationRegister.QueueOfProductionOperations AS Operations
	
GROUP BY
	Operations.Department,
	Operations.Stage,
	Operations.Operation,
	CASE
		WHEN Operations.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
			THEN Operations.ProductionOperation
		ELSE VALUE(Document.ProductionOperation2_2.EmptyRef)
	END,
	Operations.OperationNumber,
	Operations.NextOperation
	
UNION ALL

SELECT
	Operations.Department                                      AS Department,
	Operations.Stage                                               AS Stage,
	Operations.Operation                                           AS TechnicalOperation,
	VALUE(Document.ShiftTask.EmptyRef)              AS ShiftTask,
	DATETIME(1, 1, 1)                                          AS TaskDate_,
	DATETIME(1, 1, 1)                                          AS ExecutionStarted,
	DATETIME(1, 1, 1)                                          AS ExecutionEnd,
	CASE
		WHEN Operations.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
			THEN Operations.Ref
		ELSE VALUE(Document.ProductionOperation2_2.EmptyRef)
	END                                                       AS ProductionOperation,
	VALUE(Catalog.Persons.EmptyRef)            AS Performer,
	VALUE(Catalog.WorkCenters.EmptyRef)             AS WorkCenter,
	VALUE(Catalog.WorkCenterTypes.EmptyRef)        AS WorkCenterType,
	SUM(Operations.Count - Operations.CountCanceled)    AS Required2,
	SUM(Operations.Count - Operations.CountCanceled)    AS Plan,
	0                                                           AS Assigned_,
	0                                                           AS Running,
	0                                                           AS Completed2,
	0                                                           AS DefectiveGoods,
	0                                                           AS NotCompleted,
	0                                                           AS Skipped3,
	0                                                           AS Retry,
	0                                                           AS UnderControl,
	0                                                           AS UnderRevision,
	FALSE                                                        AS ControlAgain,
	2                                                           AS Priority,
	Operations.OperationNumber                                      AS OperationNumber,
	Operations.NextOperation                             AS NextOperation
FROM
	Document.ProductionOperation2_2 AS Operations
WHERE
	Operations.Posted
	AND Operations.Status IN (
			VALUE(Enum.ProductionOperationStatuses.Executed),
			VALUE(Enum.ProductionOperationStatuses.IsSkipped))
	AND NOT TRUE IN (SELECT TOP 1
					TRUE
				FROM
					InformationRegister.QueueOfProductionOperations AS Queue
				WHERE
					Operations.Stage = Queue.Stage)
GROUP BY
	Operations.Department,
	Operations.Stage,
	Operations.Operation,
	CASE
		WHEN Operations.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
			THEN Operations.Ref
		ELSE VALUE(Document.ProductionOperation2_2.EmptyRef)
	END,
	Operations.OperationNumber,
	Operations.NextOperation

UNION ALL

SELECT
	Operations.Department                                      AS Department,
	Operations.Stage                                               AS Stage,
	Operations.Operation                                           AS TechnicalOperation,
	Operations.ShiftTask                                     AS ShiftTask,
	Operations.ShiftTask.Date                                AS TaskDate_,
	DATETIME(1, 1, 1)                                          AS ExecutionStarted,
	DATETIME(1, 1, 1)                                          AS ExecutionEnd,
	CASE
		WHEN Queue.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
			THEN Queue.ProductionOperation
		ELSE VALUE(Document.ProductionOperation2_2.EmptyRef)
	END                                                       AS ProductionOperation,
	CASE
		WHEN Operations.Performer IN (UNDEFINED, VALUE(Catalog.Teams.EmptyRef))
			THEN VALUE(Catalog.Persons.EmptyRef)
		ELSE Operations.Performer
	END                                                       AS Performer,
	Operations.WorkCenter                                       AS WorkCenter,
	Operations.WorkCenterType                                  AS WorkCenterType,
	0                                                           AS Required2,
	0                                                           AS Plan,
	Operations.Count                                         AS Assigned_,
	0                                                           AS Running,
	0                                                           AS Completed2,
	0                                                           AS DefectiveGoods,
	0                                                           AS NotCompleted,
	0                                                           AS Skipped3,
	0                                                           AS Retry,
	0                                                           AS UnderControl,
	0                                                           AS UnderRevision,
	FALSE                                                        AS ControlAgain,
	1                                                           AS Priority,
	Operations.OperationNumber                                      AS OperationNumber,
	Operations.NextOperation                             AS NextOperation
FROM
	InformationRegister.OperationsToCreateShiftTasks AS Operations
	
	LEFT JOIN InformationRegister.QueueOfProductionOperations AS Queue
	ON Operations.Stage = Queue.Stage
		AND Operations.Operation = Queue.Operation
		AND Operations.OperationID = Queue.OperationID
		AND Queue.MainEntry_
	
WHERE
	Operations.ShiftTask &lt;&gt; VALUE(Document.ShiftTask.EmptyRef)

UNION ALL

SELECT
	Operations.Department                                      AS Department,
	Operations.Stage                                               AS Stage,
	Operations.Operation                                           AS TechnicalOperation,
	Operations.ShiftTask                                     AS ShiftTask,
	ISNULL(Operations.ShiftTask.Date, DATETIME(1, 1, 1))  AS TaskDate_,
	Operations.ExecutionStarted                                   AS ExecutionStarted,
	Operations.ExecutionEnd                                AS ExecutionEnd,
	Operations.Ref                                             AS ProductionOperation,
	CASE
		WHEN Operations.Performer IN (UNDEFINED, VALUE(Catalog.Teams.EmptyRef))
			THEN VALUE(Catalog.Persons.EmptyRef)
		ELSE Operations.Performer
	END                                                       AS Performer,
	CASE
		WHEN Operations.WorkCenter REFS Catalog.WorkCenters
			THEN Operations.WorkCenter
		ELSE
			VALUE(Catalog.WorkCenters.EmptyRef)
	END                                                       AS WorkCenter,
	CASE
		WHEN Operations.WorkCenter REFS Catalog.WorkCenterTypes
			THEN Operations.WorkCenter
		ELSE
			ISNULL(Operations.WorkCenter.WorkCenterType, VALUE(Catalog.WorkCenterTypes.EmptyRef))
	END                                                       AS WorkCenterType,
	0                                                           AS Required2,
	0                                                           AS Plan,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.CreatedOn_)
			THEN Operations.Count
				- Operations.CountCanceled
		ELSE 0
	END                                                       AS Assigned_,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.Running)
			THEN Operations.Count
				- Operations.FollowUp
				- Operations.QuantityUnderRevision
				- Operations.DefectiveGoodsCount
				- Operations.CountReal
				- Operations.CountCanceled
		ELSE 0
	END                                                       AS Running,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.Executed)
				OR Operations.Status = VALUE(Enum.ProductionOperationStatuses.Running)
			THEN Operations.CountReal
		ELSE 0
	END                                                       AS Completed2,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.Executed)
				OR Operations.Status = VALUE(Enum.ProductionOperationStatuses.Running)
			THEN Operations.DefectiveGoodsCount
		ELSE 0
	END                                                       AS DefectiveGoods,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.NotExecuted)
			THEN Operations.Count
		ELSE Operations.CountCanceled
	END                                                       AS NotCompleted,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.IsSkipped)
			THEN Operations.Count
				- Operations.CountCanceled
		ELSE 0
	END                                                       AS Skipped3,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.Executed)
				AND Operations.RepetitionIsRequired
			THEN Operations.CountReal
		ELSE 0
	END                                                       AS Retry,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.Executed)
				OR Operations.Status = VALUE(Enum.ProductionOperationStatuses.Running)
			THEN Operations.FollowUp
		ELSE 0
	END                                                       AS UnderControl,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.Executed)
				OR Operations.Status = VALUE(Enum.ProductionOperationStatuses.Running)
			THEN Operations.QuantityUnderRevision
		ELSE 0
	END                                                       AS UnderRevision,
	CASE
		WHEN Operations.Status = VALUE(Enum.ProductionOperationStatuses.Executed)
				OR Operations.Status = VALUE(Enum.ProductionOperationStatuses.Running)
			THEN Operations.ControlAgain
		ELSE FALSE
	END                                                       AS ControlAgain,
	CASE
		WHEN Queue.OperationNumber IS NULL
			THEN 2
		ELSE 1
	END                                                                      AS Priority,
	ISNULL(Queue.OperationNumber, Operations.OperationNumber)                    AS OperationNumber,
	ISNULL(Queue.NextOperation, Operations.NextOperation)  AS NextOperation
FROM
	Document.ProductionOperation2_2 AS Operations
		LEFT JOIN InformationRegister.QueueOfProductionOperations AS Queue
		ON Operations.Department = Queue.Department
			AND Operations.Stage = Queue.Stage
			AND Operations.Operation = Queue.Operation
			AND Operations.OperationID = Queue.OperationID
			AND Queue.MainEntry_
WHERE
	Operations.Posted</query>
	</dataSet>
