			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị tính</v8:content>
			</v8:item>
		</title>
		<presentationExpression>Case
	When TechnicalOperation = Value(Catalog.ManufacturingOperations.EmptyRef)
		Then NStr("ru = 'операции'; vi = 'giao dịch'; en = 'operations'; it = 'operations'; pl = 'operations'; tr = 'işlemler'")
	Else
	Case
		When TechnicalOperation.UnitOfMeasure = Value(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			Then  NStr("ru = 'операции'; vi = 'giao dịch'; en = 'operations'; it = 'operations'; pl = 'operations'; tr = 'işlemler'")
		Else TechnicalOperation.UnitOfMeasure.Description
	End
End</presentationExpression>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:use>false</dcscor:use>
				<dcscor:parameter>HorizontalAlign</dcscor:parameter>
				<dcscor:value xsi:type="v8ui:HorizontalAlign">Right</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<totalField>
		<dataPath>Completed2</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(Completed2)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Running</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(Running)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Assigned_</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(Assigned_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>NotCompleted</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(NotCompleted)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Skipped3</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(Skipped3)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Retry</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(Retry)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToAssign</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1 Or Sum(Plan) + Sum(Retry) - Sum(Assigned_) - Sum(Running) - Sum(Completed2) -Sum(DefectiveGoods) -Sum(UnderRevision) -Sum(UnderControl) - Sum(Skipped3) &lt; 0
		Then 0
	Else Sum(Plan) + Sum(Retry) - Sum(Assigned_) - Sum(Running) - Sum(Completed2) -Sum(DefectiveGoods) -Sum(UnderRevision) -Sum(UnderControl) - Sum(Skipped3)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DefectiveGoods</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(DefectiveGoods)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Inspector</dataPath>
		<expression>Inspector</expression>
		<group>Operation</group>
	</totalField>
	<totalField>
		<dataPath>ReasonForDefects</dataPath>
		<expression>JoinStrings(ReasonForDefects,",","")</expression>
		<group>Operation</group>
	</totalField>
	<totalField>
		<dataPath>UnderControl</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(UnderControl)
End</expression>
	</totalField>
	<totalField>
		<dataPath>UnderRevision</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(UnderRevision)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ControlAgain</dataPath>
		<expression>Max(ControlAgain)</expression>
		<group>Operation</group>
	</totalField>
	<totalField>
		<dataPath>Required2</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(Required2)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Plan</dataPath>
		<expression>Case
	When Count(Distinct UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(Plan)
End</expression>
	</totalField>
	<settingsVariant>
		<dcsset:name>ProgressOfStageOperations</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Routing operation progress</v8:content>
			</v8:item>
			<v8:item>
