				<v8:content>پیشرفت عملیات مسیریابی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Processo di esecuzione delle operazioni di produzione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Postęp operacji produkcyjnych</v8:content>
			</v8:item>
