	<calculatedField>
		<dataPath>LowerVarianceLimit</dataPath>
		<expression>Case When &amp;QuantityUnits = 0 Then
    LowerVarianceLimit
When &amp;QuantityUnits = 1 Then
    Case When UnitFactorForReports = 0 Then
        0
    Else
        Case When &amp;QuantityUnits = 0 Then
    LowerVarianceLimit
When &amp;QuantityUnits = 1 Then
    Case When UnitFactorForReports = 0 Then
        0
    Else
        LowerVarianceLimit / UnitFactorForReports
    End
End / UnitFactorForReports
    End
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
