		<field xsi:type="DataSetFieldField">
			<dataPath>ControlledLotReference</dataPath>
			<field>ControlledLotReference</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Controlled lot</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
