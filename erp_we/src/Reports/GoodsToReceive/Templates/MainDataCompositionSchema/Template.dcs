					<v8:content>Контролируемая партия</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Kontrole tabi lot</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Controlled lot</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Controlled lot</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Controlled lot</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ToReceive.Recorder AS Recorder,
	ToReceive.SecondPeriod AS SecondPeriod,
	ToReceive.DayPeriod AS DayPeriod,
	ToReceive.WeekPeriod AS WeekPeriod,
	ToReceive.TenDaysPeriod AS TenDaysPeriod,
	ToReceive.MonthPeriod AS MonthPeriod,
	ToReceive.QuarterPeriod AS QuarterPeriod,
	ToReceive.HalfYearPeriod AS HalfYearPeriod,
	ToReceive.YearPeriod AS YearPeriod,
	
	ToReceive.Sender AS Sender,
	ToReceive.DocumentInflow AS ReferenceOrder,
	ToReceive.Warehouse AS Warehouse,
	ToReceive.Products AS Products,
	ToReceive.Products.UnitOfMeasure AS StorageUnit,
	ToReceive.Products.UnitForReports AS UnitForReports,
	ToReceive.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	ToReceive.Characteristic AS Characteristic,
	ToReceive.Purpose AS Purpose,
	ToReceive.ControlledLotReference AS ControlledLotReference,
	
	ToReceive.GoodsReceiptNotesToRegisterReceipt AS ToReceive,
	ToReceive.GoodsReceiptNotesToRegisterExpense AS Accepted,
	
	ToReceive.GoodsReceiptNotesToRegisterOpeningBalance AS GoodsReceiptNotesToRegisterOpeningBalance1, // To calculate the balances
	CASE
		WHEN ToReceive.GoodsReceiptNotesToRegisterClosingBalance &gt; 0
			THEN ToReceive.GoodsReceiptNotesToRegisterClosingBalance
		ELSE 0
	END AS RemainsToReceive,

	ToReceive.GoodsReceiptNotesToRegisterOpeningBalance AS GoodsReceiptNotesToRegisterOpeningBalance2, // To calculate the balances
	CASE
		WHEN ToReceive.GoodsReceiptNotesToRegisterClosingBalance &gt; 0
			THEN 0
		ELSE -ToReceive.GoodsReceiptNotesToRegisterClosingBalance
	END AS Overdelivery,
	
	CASE
		WHEN ToReceive.Products.UnitOfMeasure.MeasuredValueType IN (VALUE(Enum.TypesOfMeasuredValues.Weight), VALUE(Enum.TypesOfMeasuredValues.VolumeM3), VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement), VALUE(Enum.TypesOfMeasuredValues.Length))
			THEN -ToReceive.GoodsReceiptNotesToRegisterReceipt * (AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Value / 100)
		ELSE 0
	END AS LowerVarianceLimit,
	CASE
		WHEN ToReceive.Products.UnitOfMeasure.MeasuredValueType IN (VALUE(Enum.TypesOfMeasuredValues.Weight), VALUE(Enum.TypesOfMeasuredValues.VolumeM3), VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement), VALUE(Enum.TypesOfMeasuredValues.Length))
			THEN ToReceive.GoodsReceiptNotesToRegisterReceipt * (AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Value / 100)
		ELSE 0
	END AS TopVarianceLimit,
	
	ToReceive.AcceptsOpeningBalance AS AcceptsOpeningBalance, // To calculate the balances
	ToReceive.AcceptsClosingBalance AS Accepts,
	
	ToReceive.ToRegisterGoodsReceiptsOpeningBalance AS ToRegisterGoodsReceiptsOpeningBalance,  // To calculate the balances
	ToReceive.ToRegisterGoodsReceiptsClosingBalance AS ToRegisterGoodsReceipts,
	ToReceive.ToRegisterReceiptsByReferenceOpeningBalance AS ToRegistrationOfReceiptsByReferencesOpeningBalance,
	ToReceive.ToRegisterReceiptsByReferenceClosingBalance AS ToRegistrationOfReceiptsByReferences
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	Sender.*,
	ReferenceOrder.*,
	Warehouse.*,
	Products.*,
	StorageUnit.*,
	UnitForReports.*,
	UnitFactorForReports,
	ProductsWeight,
	ProductsVolume,
	Characteristic.*,
	Purpose.*,
	ControlledLotReference.*,
	ToReceive,
	Accepted,
	GoodsReceiptNotesToRegisterOpeningBalance1,
	RemainsToReceive,
	GoodsReceiptNotesToRegisterOpeningBalance2,
	Overdelivery,
	LowerVarianceLimit,
	TopVarianceLimit,
	AcceptsOpeningBalance,
	Accepts,
	ToRegisterGoodsReceiptsOpeningBalance,
	ToRegisterGoodsReceipts}
FROM
	AccumulationRegister.GoodsToReceive.BalanceAndTurnovers(, , Auto, , {(Sender).* AS Sender, (DocumentInflow).* AS ReferenceOrder, (Warehouse) AS Warehouse}) AS ToReceive
		INNER JOIN Constant.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving AS AllowableDeviationOfMeasuringGoodsShipmentAndReceiving
		ON (TRUE)
{WHERE
	ToReceive.Recorder.*,
	ToReceive.SecondPeriod,
	ToReceive.DayPeriod,
	ToReceive.WeekPeriod,
	ToReceive.TenDaysPeriod,
	ToReceive.MonthPeriod,
	ToReceive.QuarterPeriod,
	ToReceive.HalfYearPeriod,
	ToReceive.YearPeriod,
	ToReceive.Products.*,
	ToReceive.Products.UnitOfMeasure.* AS StorageUnit,
	ToReceive.Products.UnitForReports.* AS UnitForReports,
	ToReceive.Products.UnitFactorForReports AS UnitFactorForReports,
	(&amp;QueryTextItemWeight) AS ProductsWeight,
	(&amp;QueryTextTheVolumeOfTheItem) AS ProductsVolume,
	ToReceive.Characteristic.*,
	ToReceive.Purpose.*,
	ToReceive.ControlledLotReference.*,
	ToReceive.GoodsReceiptNotesToRegisterReceipt AS ToReceive,
	ToReceive.GoodsReceiptNotesToRegisterExpense AS Accepted,
	ToReceive.GoodsReceiptNotesToRegisterOpeningBalance AS GoodsReceiptNotesToRegisterOpeningBalance1,
	(CASE
			WHEN ToReceive.GoodsReceiptNotesToRegisterClosingBalance &gt; 0
				THEN ToReceive.GoodsReceiptNotesToRegisterClosingBalance
			ELSE 0
		END) AS RemainsToReceive,
	ToReceive.GoodsReceiptNotesToRegisterOpeningBalance AS GoodsReceiptNotesToRegisterOpeningBalance2,
	(CASE
			WHEN ToReceive.GoodsReceiptNotesToRegisterClosingBalance &gt; 0
				THEN 0
			ELSE -ToReceive.GoodsReceiptNotesToRegisterClosingBalance
		END) AS Overdelivery,
	(CASE
			WHEN ToReceive.Products.UnitOfMeasure.MeasuredValueType IN (VALUE(Enum.TypesOfMeasuredValues.Weight), VALUE(Enum.TypesOfMeasuredValues.VolumeM3), VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement), VALUE(Enum.TypesOfMeasuredValues.Length))
				THEN -ToReceive.GoodsReceiptNotesToRegisterReceipt * (AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Value / 100)
			ELSE 0
		END) AS LowerVarianceLimit,
	(CASE
			WHEN ToReceive.Products.UnitOfMeasure.MeasuredValueType IN (VALUE(Enum.TypesOfMeasuredValues.Weight), VALUE(Enum.TypesOfMeasuredValues.VolumeM3), VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement), VALUE(Enum.TypesOfMeasuredValues.Length))
				THEN ToReceive.GoodsReceiptNotesToRegisterReceipt * (AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Value / 100)
			ELSE 0
		END) AS TopVarianceLimit,
	ToReceive.AcceptsOpeningBalance,
	ToReceive.AcceptsClosingBalance AS Accepts,
	ToReceive.ToRegisterGoodsReceiptsOpeningBalance AS ToRegisterGoodsReceiptsOpeningBalance,
	ToReceive.ToRegisterGoodsReceiptsClosingBalance AS ToRegisterGoodsReceipts,
	ToReceive.ToRegisterReceiptsByReferenceOpeningBalance AS ToRegistrationOfReceiptsByReferencesOpeningBalance,
	ToReceive.ToRegisterReceiptsByReferenceClosingBalance AS ToRegistrationOfReceiptsByReferences
	}</query>
	</dataSet>
	<calculatedField>
		<dataPath>ToReceive</dataPath>
		<expression>Case When &amp;QuantityUnits = 0 Then
	ToReceive
When &amp;QuantityUnits = 1 Then
	Case When UnitFactorForReports = 0 Then
		0
	Else
		ToReceive / UnitFactorForReports
	End
End</expression>
