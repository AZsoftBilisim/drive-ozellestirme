	<totalField>
		<dataPath>ToReceive</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(ToReceive)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Accepted</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Accepted)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Accepts</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Accepts)
End</expression>
	</totalField>
	<totalField>
		<dataPath>RemainsToReceive</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(RemainsToReceive)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Overdelivery</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Overdelivery)
End</expression>
	</totalField>
