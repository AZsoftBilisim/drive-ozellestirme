		<field xsi:type="DataSetFieldField">
			<dataPath>ChartOfAccounts</dataPath>
			<field>ChartOfAccounts</field>
			<inputParameters>
				<dcscor:item>
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>ChoiceParameters</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameters">
						<dcscor:item>
							<dcscor:choiceParameter>Filter.DeletionMark</dcscor:choiceParameter>
							<dcscor:value xsi:type="xs:boolean">false</dcscor:value>
						</dcscor:item>
					</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	InternationalTurnoverDrCr.AccountDr AS AccountDr,
	InternationalTurnoverDrCr.AccountCr AS AccountCr,
	InternationalTurnoverDrCr.CurrencyDr AS CurrencyDr,
	InternationalTurnoverDrCr.CurrencyCr AS CurrencyCr,
	InternationalTurnoverDrCr.SumTurnover AS SumTurnover,
	InternationalTurnoverDrCr.PresentationAmountTurnover AS PresentationAmountTurnover,
	InternationalTurnoverDrCr.CurrencyAmountTurnoverDr AS CurrencyAmountTurnoverDr,
	InternationalTurnoverDrCr.CurrencyAmountTurnoverCr AS CurrencyAmountTurnoverCr,
	InternationalTurnoverDrCr.Recorder AS Recorder,
	InternationalTurnoverDrCr.ExtDimensionDr1 AS ExtDimensionDr1,
	InternationalTurnoverDrCr.ExtDimensionDr2 AS ExtDimensionDr2,
	InternationalTurnoverDrCr.ExtDimensionDr3 AS ExtDimensionDr3,
	InternationalTurnoverDrCr.ExtDimensionCr1 AS ExtDimensionCr1,
	InternationalTurnoverDrCr.ExtDimensionCr2 AS ExtDimensionCr2,
	InternationalTurnoverDrCr.ExtDimensionCr3 AS ExtDimensionCr3,
	InternationalTurnoverDrCr.Organization AS Organization,
	InternationalTurnoverDrCr.ChartOfAccounts AS ChartOfAccounts,
	InternationalTurnoverDrCr.DepartmentDr AS DepartmentDr,
	InternationalTurnoverDrCr.DepartmentCr AS DepartmentCr,
	InternationalTurnoverDrCr.LineOfBusinessDr AS LineOfBusinessDr,
	InternationalTurnoverDrCr.LineOfBusinessCr AS LineOfBusinessCr
{SELECT
	AccountDr.*,
	AccountCr.*,
	CurrencyDr.*,
	CurrencyCr.*,
	SumTurnover,
	PresentationAmountTurnover,
	CurrencyAmountTurnoverDr,
	CurrencyAmountTurnoverCr,
	Recorder.*,
	ExtDimensionDr1.*,
	ExtDimensionDr2.*,
	ExtDimensionDr3.*,
	ExtDimensionCr1.*,
	ExtDimensionCr2.*,
	ExtDimensionCr3.*,
	Organization.*,
	ChartOfAccounts.*,
	DepartmentDr.*,
	DepartmentCr.*,
	LineOfBusinessDr.*,
	LineOfBusinessCr.*}
FROM
	AccountingRegister.International.DrCrTurnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto, {(AccountDr).*}, {(&amp;ExtDimensionTypeDr)}, {(AccountCr).*}, {(&amp;ExtDimensionTypeCr)}, NOT ChartOfAccounts.DeletionMark AND ChartOfAccounts = &amp;ChartOfAccounts {(Organization).*}) AS InternationalTurnoverDrCr
{WHERE
	InternationalTurnoverDrCr.AccountDr.*,
	InternationalTurnoverDrCr.AccountCr.*,
	InternationalTurnoverDrCr.ExtDimensionDr1.*,
	InternationalTurnoverDrCr.ExtDimensionDr2.*,
	InternationalTurnoverDrCr.ExtDimensionDr3.*,
	InternationalTurnoverDrCr.ExtDimensionCr1.*,
	InternationalTurnoverDrCr.ExtDimensionCr2.*,
	InternationalTurnoverDrCr.ExtDimensionCr3.*,
	InternationalTurnoverDrCr.Organization.*,
	InternationalTurnoverDrCr.ChartOfAccounts.*,
	InternationalTurnoverDrCr.DepartmentDr.*,
	InternationalTurnoverDrCr.DepartmentCr.*,
	InternationalTurnoverDrCr.LineOfBusinessDr.*,
	InternationalTurnoverDrCr.LineOfBusinessCr.*,
	InternationalTurnoverDrCr.CurrencyDr.*,
	InternationalTurnoverDrCr.CurrencyCr.*,
	InternationalTurnoverDrCr.SumTurnover,
	InternationalTurnoverDrCr.PresentationAmountTurnover,
	InternationalTurnoverDrCr.CurrencyAmountTurnoverDr,
	InternationalTurnoverDrCr.CurrencyAmountTurnoverCr}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
