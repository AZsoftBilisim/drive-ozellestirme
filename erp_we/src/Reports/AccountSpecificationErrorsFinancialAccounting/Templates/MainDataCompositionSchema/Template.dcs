		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PostingTemplates.Ref AS PostingTemplate,
	PostingTemplates.Operation AS BusinessOperation,
	PostingTemplates.DrAccountDefault AS DrAccountDefault,
	PostingTemplates.CrAccountDefault AS CrAccountDefault,
	PostingTemplates.AccountSpecificationSourceTypeDr AS AccountSpecificationSourceTypeDr,
	PostingTemplates.AccountSpecificationSourceTypeCr AS AccountSpecificationSourceTypeCr
INTO ValidTransactionTemplates
FROM
	Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
	INNER JOIN
		InformationRegister.RulesOfPostingsInFinancialAccounting AS ReflectionRules
	ON
		ReflectionRules.PostingGenerationSetting = &amp;PostingGenerationSetting
		AND PostingTemplates.Ref = ReflectionRules.PostingTemplate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ValidTransactionTemplates.PostingTemplate AS PostingTemplate,
	ValidTransactionTemplates.BusinessOperation AS BusinessOperation,
	VALUE(Enum.AccountingMovementKinds.Debit) AS RecordType,
	ValidTransactionTemplates.DrAccountDefault AS DefaultAccount,
	ValidTransactionTemplates.AccountSpecificationSourceTypeDr AS AccountSpecificationSource
INTO PostingTemplates
FROM
	ValidTransactionTemplates AS ValidTransactionTemplates
WHERE
	ValidTransactionTemplates.AccountSpecificationSourceTypeDr &lt;&gt; VALUE(Enum.AccountSpecificationSourceTypes.EmptyRef)

UNION ALL

SELECT
	ValidTransactionTemplates.PostingTemplate AS PostingTemplate,
	ValidTransactionTemplates.BusinessOperation AS BusinessOperation,
	VALUE(Enum.AccountingMovementKinds.Credit) AS RecordType,
	ValidTransactionTemplates.CrAccountDefault AS DefaultAccount,
	ValidTransactionTemplates.AccountSpecificationSourceTypeCr AS AccountSpecificationSource
FROM
	ValidTransactionTemplates AS ValidTransactionTemplates
WHERE
	ValidTransactionTemplates.AccountSpecificationSourceTypeCr &lt;&gt; VALUE(Enum.AccountSpecificationSourceTypes.EmptyRef)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PostingTemplates.PostingTemplate AS PostingTemplate,
	PostingTemplates.BusinessOperation AS BusinessOperation,
	PostingTemplates.RecordType AS RecordType,
	PostingTemplates.DefaultAccount AS DefaultAccount,
	PostingTemplates.AccountSpecificationSource AS AccountSpecificationSource,
	FinancialAccountingGroups.Ref AS FinancialAccountingGroup
INTO FinancialAccountingGroups
FROM
	PostingTemplates AS PostingTemplates
	INNER JOIN
		Catalog.InventoryAccountingGroups AS FinancialAccountingGroups
	ON 
		(TRUE)
WHERE
	PostingTemplates.AccountSpecificationSource = VALUE(Enum.AccountSpecificationSourceTypes.FinancialAccountingGroupOfProducts)
	AND FinancialAccountingGroups.DeletionMark = FALSE
	AND NOT FinancialAccountingGroups.IsFolder

UNION ALL

SELECT
	PostingTemplates.PostingTemplate,
	PostingTemplates.BusinessOperation,
	PostingTemplates.RecordType,
	PostingTemplates.DefaultAccount,
	PostingTemplates.AccountSpecificationSource,
	FinancialAccountingGroups.Ref
FROM
	PostingTemplates AS PostingTemplates
	INNER JOIN
		Catalog.FinancialAccountingGroupsOfARAP AS FinancialAccountingGroups
	ON 
		(TRUE)
WHERE
	PostingTemplates.AccountSpecificationSource = VALUE(Enum.AccountSpecificationSourceTypes.FinancialAccountingGroupOfARAP)
	AND FinancialAccountingGroups.DeletionMark = FALSE
	AND NOT FinancialAccountingGroups.IsFolder

UNION ALL

SELECT
	PostingTemplates.PostingTemplate,
	PostingTemplates.BusinessOperation,
	PostingTemplates.RecordType,
	PostingTemplates.DefaultAccount,
	PostingTemplates.AccountSpecificationSource,
	FinancialAccountingGroups.Ref
FROM
	PostingTemplates AS PostingTemplates
	INNER JOIN
		Catalog.GroupsOfFinancialAccountingOfCash AS FinancialAccountingGroups
	ON
		(TRUE)
WHERE
	PostingTemplates.AccountSpecificationSource = VALUE(Enum.AccountSpecificationSourceTypes.FinancialAccountingGroupOfCash)
	AND FinancialAccountingGroups.DeletionMark = FALSE
	AND NOT FinancialAccountingGroups.IsFolder

UNION ALL

SELECT
	PostingTemplates.PostingTemplate,
	PostingTemplates.BusinessOperation,
	PostingTemplates.RecordType,
	PostingTemplates.DefaultAccount,
	PostingTemplates.AccountSpecificationSource,
	FinancialAccountingGroups.Ref
FROM
	PostingTemplates AS PostingTemplates
	INNER JOIN
		Catalog.IncomeExpensesAccountingGroups AS FinancialAccountingGroups
	ON
		(TRUE)
WHERE
	PostingTemplates.AccountSpecificationSource = VALUE(Enum.AccountSpecificationSourceTypes.FinancialAccountingGroupOfIncomeExpenses)
	AND FinancialAccountingGroups.DeletionMark = FALSE
	AND NOT FinancialAccountingGroups.IsFolder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	FinancialAccountingGroups.PostingTemplate AS PostingTemplate,
	FinancialAccountingGroups.BusinessOperation AS BusinessOperation,
	FinancialAccountingGroups.RecordType AS RecordType,
	FinancialAccountingGroups.DefaultAccount AS DefaultAccount,
	FinancialAccountingGroups.FinancialAccountingGroup AS FinancialAccountingGroup,
	FinancialAccountingGroups.AccountSpecificationSource AS AccountSpecificationSource,
	ISNULL(RulesForClarifyingInvoices.GLAccount, VALUE(ChartOfAccounts.International.EmptyRef)) AS GLAccount
FROM
	FinancialAccountingGroups AS FinancialAccountingGroups
	LEFT JOIN
		InformationRegister.RulesOfSpecifyingAccountsFinancialAccounting AS RulesForClarifyingInvoices
	ON 
		FinancialAccountingGroups.FinancialAccountingGroup = RulesForClarifyingInvoices.FinancialAccountingGroup
		AND FinancialAccountingGroups.PostingTemplate = RulesForClarifyingInvoices.PostingTemplate
		AND FinancialAccountingGroups.RecordType = RulesForClarifyingInvoices.RecordType
</query>
	</dataSet>
