		<dataPath>GLAccounts</dataPath>
		<expression>Count(Distinct GLAccount)</expression>
	</totalField>
	<parameter>
		<name>PostingGenerationSetting</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Posting schema</v8:content>
			</v8:item>
