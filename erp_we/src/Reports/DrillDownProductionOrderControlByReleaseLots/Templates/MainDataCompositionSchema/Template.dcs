	<parameter>
		<name>EmptyLinkKey</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Empty link key</v8:content>
			</v8:item>
			<v8:item>
