			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>MainProductCharacteristic</dataPath>
		<expression>String(MainProduct) + ", " + String(CharacteristicsOfMainProduct)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Main product, Variant</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>محصول اصلی، گونه</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Основное изделие, Характеристика</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Nihai ana ürün, Varyant</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Sản phẩm chính, Đặc tính</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Main product, Variant</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Main product, Variant</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then
	Sum(Case When ThisIsMainProduct Then Count Else 0 End)
Else
	Count
End</expression>
	</totalField>
	<totalField>
		<dataPath>Repetition</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then
    Max(Case When ThisIsMainProduct Then Repetition Else 0 End)
Else 
	Repetition
End</expression>
	</totalField>
	<totalField>
		<dataPath>MinimumBatch</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then
    Max(Case When ThisIsMainProduct Then MinimumBatch Else 0 End)
Else 
	MinimumBatch
End</expression>
	</totalField>
	<totalField>
		<dataPath>UnitOfMeasure</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then
    Max(Case When ThisIsMainProduct Then UnitOfMeasure Else Undefined End)
Else 
	UnitOfMeasure
End</expression>
	</totalField>
	<totalField>
		<dataPath>Warehouse</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then
    Case When Sum(Case When ThisIsMainProduct Then 1 Else 0 End) = 0 Then
        Value(Catalog.Warehouses.EmptyRef) 
    Else 
        Case When Count(Distinct EvalExpressionWithGroupArray("Warehouse",, "ThisIsMainProduct = True")) = 1 Then
            Max(Case When ThisIsMainProduct Then Warehouse Else Undefined End) 
        Else
            "&lt;Multiple warehouses&gt;" 
        End 
    End
Else
	Warehouse
End</expression>
	</totalField>
	<totalField>
		<dataPath>Purpose</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then
    Case When Sum(Case When ThisIsMainProduct Then 1 Else 0 End) = 0 Then
        Value(Catalog.Assignments.EmptyRef) 
    Else 
        Case When Count(Distinct EvalExpressionWithGroupArray("Purpose",, "ThisIsMainProduct = True")) = 1 Then
            Max(Case When ThisIsMainProduct Then Purpose Else Undefined End) 
        Else
            "&lt;Multiple assignments&gt;" 
        End 
    End
Else
	Purpose
End</expression>
	</totalField>
	<totalField>
		<dataPath>Document</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then
    Max(Case When ThisIsMainProduct Then Document Else Undefined End)
Else
    Case When EvalExpression("Count(Distinct Document)", "KeyLot") = 1 Then
        Value(Document.ProductionOrder2_2.EmptyRef)
    Else 
		Document
    End
End</expression>
	</totalField>
	<totalField>
		<dataPath>StartDate2</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then StartDate2 End</expression>
	</totalField>
	<totalField>
		<dataPath>DateOfProduction</dataPath>
		<expression>Case When Max(ThisIsMainProduct) Then DateOfProduction End</expression>
	</totalField>
	<totalField>
		<dataPath>ThisIsMainProduct</dataPath>
		<expression>ThisIsMainProduct</expression>
	</totalField>
