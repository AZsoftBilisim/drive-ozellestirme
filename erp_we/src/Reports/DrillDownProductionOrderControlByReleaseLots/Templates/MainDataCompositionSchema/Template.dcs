		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	OrderStructure.KeyLot AS KeyLot
INTO TTKeysLotReferences
FROM
	InformationRegister.OrderStructure AS OrderStructure
WHERE
	OrderStructure.ProductionOrder = &amp;ProductionOrder
	AND (OrderStructure.Scheduled &lt;&gt; 0
			OR OrderStructure.Launched &lt;&gt; 0
			OR OrderStructure.ReverseKittingScheduled &lt;&gt; 0
			OR OrderStructure.ReverseKittingStarted &lt;&gt; 0)
	AND OrderStructure.ConnectionKeyTransfer = &amp;EmptyLinkKey
{WHERE
	OrderStructure.Products.*,
	OrderStructure.Characteristic.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	OrderStructure.Products AS Products,
	OrderStructure.Characteristic AS Characteristic,
	ISNULL(MainProduct.Products, OrderStructure.Products) AS MainProduct,
	ISNULL(MainProduct.Characteristic, MainProduct.Characteristic) AS CharacteristicsOfMainProduct,
	OrderStructure.KeyLot AS KeyLot,
	CASE
		WHEN OrderStructure.Stage REFS Document.ProductionStage2_2
			THEN OrderStructure.Stage
		ELSE OrderStructure.ProductionOrder
	END AS Document,
	CASE
		WHEN OrderStructure.BillOfMaterials = VALUE(Catalog.BillsOfMaterials.EmptyRef)
			THEN &amp;TextWithoutBillOfMaterials
		ELSE OrderStructure.BillOfMaterials
	END AS BillOfMaterials,
	OrderStructure.Products.UnitOfMeasure AS UnitOfMeasure,
	OrderStructure.Purpose AS Purpose,
	OrderStructure.Warehouse AS Warehouse,
	OrderStructure.Scheduled + OrderStructure.Launched + OrderStructure.ReverseKittingScheduled + OrderStructure.ReverseKittingStarted AS Count,
	CASE
		WHEN OrderStructure.Scheduled &lt;&gt; 0 OR OrderStructure.ReverseKittingScheduled &lt;&gt; 0
			THEN &amp;TextIsPlanned
		WHEN OrderStructure.Launched &lt;&gt; 0 OR OrderStructure.ReverseKittingStarted &lt;&gt; 0
			THEN &amp;TextRunning
	END AS State,
	ScheduleDates.Begin AS StartDate2,
	ScheduleDates.Ending AS DateOfProduction,
	ISNULL(CASE
			WHEN OrderStructure.BillOfMaterials.ProductionIssueByCustomPortions
				THEN 0
			ELSE ProductsBOM.NumberOfPackagesPerStartingLotUnit
		END, 0) AS Repetition,
	ISNULL(OrderStructure.BillOfMaterials.MinimumReleaseLot, 0) * ISNULL(ProductsBOM.NumberOfPackagesPerStartingLotUnit, 0) AS MinimumBatch,
	MainProduct.Products IS NULL
		OR MainProduct.Products IN (OrderStructure.Products, VALUE(Catalog.Products.EmptyRef)) AS ThisIsMainProduct,
	OrderStructure.KeyProducts AS KeyProducts
{SELECT
	Products.*,
	Characteristic.*,
	Document.*,
	BillOfMaterials.*,
	UnitOfMeasure.*,
	Purpose.*,
	Warehouse.*,
	Count,
	State,
	StartDate2,
	DateOfProduction,
	Repetition,
	MinimumBatch,
	MainProduct.*,
	CharacteristicsOfMainProduct.*,
	KeyLot,
	ThisIsMainProduct,
	KeyProducts,
	ThisIsMainProduct}
FROM
	InformationRegister.OrderStructure AS OrderStructure
		LEFT JOIN InformationRegister.ProductsBOM AS MainProduct
		ON OrderStructure.BillOfMaterials = MainProduct.BillOfMaterials
			AND (MainProduct.Order = 1)
		LEFT JOIN InformationRegister.ProductsBOM AS ProductsBOM
		ON OrderStructure.BillOfMaterials = ProductsBOM.BillOfMaterials
			AND OrderStructure.Products.ProductKind = ProductsBOM.ProductKind
			AND (ProductsBOM.Products IN (OrderStructure.Products, VALUE(Catalog.Products.EmptyRef)))
			AND (ProductsBOM.Characteristic IN (OrderStructure.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)))
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleDates
		ON OrderStructure.ProductionOrder = ScheduleDates.ProductionOrder
			AND OrderStructure.KeyLot = ScheduleDates.KeyLot
			AND (ScheduleDates.ScheduleStatus = 0)
			AND (ScheduleDates.Stage = VALUE(Catalog.ProductionStages.EmptyRef))
WHERE
	OrderStructure.KeyLot IN
			(SELECT
				TTKeysLotReferences.KeyLot AS KeyLot
			FROM
				TTKeysLotReferences AS TTKeysLotReferences)
	AND (OrderStructure.Scheduled &lt;&gt; 0
			OR OrderStructure.Launched &lt;&gt; 0
			OR OrderStructure.ReverseKittingScheduled &lt;&gt; 0
			OR OrderStructure.ReverseKittingStarted &lt;&gt; 0)
	AND (&amp;ShowSideIssue
			OR NOT ISNULL(ProductsBOM.SideExit, TRUE))
{WHERE
	(MainProduct.Products IS NULL
			OR MainProduct.Products IN (OrderStructure.Products, VALUE(Catalog.Products.EmptyRef))) AS ThisIsMainProduct}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>Blank</dataPath>
		<expression/>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<calculatedField>
		<dataPath>ProductsCharacteristic</dataPath>
		<expression>String(Products) + ", " + String(Characteristic)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
