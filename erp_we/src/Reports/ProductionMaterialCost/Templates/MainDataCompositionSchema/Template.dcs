			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Movement of materials and works at enterprise level</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>گردش مواد و کارها در سطح سازمان</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Movimenti di materiali e prodotti dell'impresa in produzione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Ruch materiałów i produkcji przedsiębiorstwa w produkcji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Движение материалов и продукции предприятия в производстве</v8:content>
