		<dataSource>DataSource1</dataSource>
		<query>SELECT
	"" AS Table,
	"" AS Content,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Sender,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Recipient,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS WarehouseDivision,
	UNDEFINED                                           AS Recorder,
	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ItemsLocationAttributes,
	VALUE(Catalog.InventoryKinds.EmptyRef) AS InventoryOwnerAttribute,
	VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef) AS FinancialAccountingDimension,
	VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef) AS LotVendorAttributes,
	VALUE(Enum.VATTaxationTypes.EmptyRef) AS VATActivityType,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	UNDEFINED AS Characteristic,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.ProductCostElements.EmptyRef) AS ProductCostElement,
	UNDEFINED                                           AS Lot,
	VALUE(Catalog.ProductionLots.EmptyRef)	AS ProductionLot,
	UNDEFINED                                           AS ProductionOrder,
	
	0 AS InitialBalanceQuantity,
	0 AS InitialBalanceCost,
	0 AS InitialBalanceOfPD,
	0 AS InitialBalanceOfTD,
	0 AS InitialBalanceOffBalanceSheet,
	
	0 AS ReceivedQuantity,
	0 AS ReceivedCost,
	0 AS ReceivedPD,
	0 AS TDHasBeenReceived,
	0 AS ReceivedOffBalanceSheet,
	
	0 AS PurchasedQuantity_,
	0 AS PurchasedValue,
	0 AS PurchasedPD,
	0 AS AcquiredByTD,
	0 AS PurchasedOffBalanceSheet,
	
	0 AS MovementsQuantity,
	0 AS MovingCost,
	0 AS PDMovements,
	0 AS TDMovements,
	0 AS OffBalanceSheetTransfers,
	
	0 AS InclusionExclusionOfVAT,
	
	0 AS AmountSpentOnProduction,
	0 AS SpentOnProductionCost,
	0 AS SpentOnProductionOfPD,
	0 AS SpentOnProductionOfTD,
	0 AS SpentOnProductionOffBalanceSheet,
	
	0 AS DebitedQuantity,
	0 AS DebitedCost,
	0 AS WrittenOffPD,
	0 AS TDWasWrittenOff,
	0 AS WrittenOffOffBalanceSheet,
	
	0 AS FinalRemainderQuantity,
	0 AS FinalRemainderCost,
	0 AS FinalBalanceOfPD,
	0 AS FinalBalanceOfTD,
	0 AS FinalBalanceIsOffBalance,
	
	0 AS QuantityTransmitted,
	0 AS TransferredCost,
	0 AS SubmittedByPD,
	0 AS SubmittedByTD,
	0 AS PassedOffBalanceSheet,
	
	0 AS ProducedQuantity,
	0 AS ProducedCost,
	0 AS ProducedByPD,
	0 AS ProducedByTD,
	0 AS ProducedOffBalanceSheet

		
{SELECT
		Table,
		Content,
		Organization.*,
		Department.*,
		Sender.*,
		Recipient.*,
		WarehouseDivision.*,
		Recorder.*,
		ItemsLocationAttributes.*,
		InventoryOwnerAttribute.*,
		FinancialAccountingDimension.*,
		LotVendorAttributes.*,
		VATActivityType.*,
		Products.*,
		Characteristic.*,
		Series.*,
		Purpose.*,
		LineOfBusiness.*,
		ProductCostElement.*,
		Lot.*,
		ProductionLot.*,
		ProductionOrder.*,
		InitialBalanceQuantity,
		InitialBalanceCost,
		InitialBalanceOfPD,
		InitialBalanceOfTD,
		InitialBalanceOffBalanceSheet,
		ReceivedQuantity,
		ReceivedCost,
		ReceivedPD,
		TDHasBeenReceived,
		ReceivedOffBalanceSheet,
		PurchasedQuantity_,
		PurchasedValue,
		PurchasedPD,
		AcquiredByTD,
		PurchasedOffBalanceSheet,
		MovementsQuantity,
		MovingCost,
		PDMovements,
		TDMovements,
		OffBalanceSheetTransfers,
		InclusionExclusionOfVAT,
		AmountSpentOnProduction,
		SpentOnProductionCost,
		SpentOnProductionOfPD,
		SpentOnProductionOfTD,
		SpentOnProductionOffBalanceSheet,
		DebitedQuantity,
		DebitedCost,
		WrittenOffPD,
		TDWasWrittenOff,
		WrittenOffOffBalanceSheet,
		FinalRemainderQuantity,
		FinalRemainderCost,
		FinalBalanceOfPD,
		FinalBalanceOfTD,
		FinalBalanceIsOffBalance,
		QuantityTransmitted,
		TransferredCost,
		SubmittedByPD,
		SubmittedByTD,
		PassedOffBalanceSheet,
		ProducedQuantity,
		ProducedCost,
		ProducedByPD,
		ProducedByTD,
		ProducedOffBalanceSheet}
{WHERE
	(VALUE(Catalog.Companies.EmptyRef)).* AS Organization,
	(VALUE(Catalog.BusinessStructure.EmptyRef)).* AS Department,
	(VALUE(Catalog.BusinessStructure.EmptyRef)).* AS Sender,
	(VALUE(Catalog.BusinessStructure.EmptyRef)).* AS Recipient,
	(VALUE(Catalog.BusinessStructure.EmptyRef)).* AS WarehouseDivision,
	(UNDEFINED).*                                           AS Recorder,
	(VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)).* AS ItemsLocationAttributes,
	(VALUE(Catalog.InventoryKinds.EmptyRef)).* AS InventoryOwnerAttribute,
	(VALUE(Catalog.BusinessStructure.EmptyRef)).* AS FinancialAccountingDimension,
	(VALUE(Catalog.KeysForLotVendorAttributes.EmptyRef)).* AS LotVendorAttributes,
	(VALUE(Enum.VATTaxationTypes.EmptyRef)).* AS VATActivityType,
	(VALUE(Catalog.Products.EmptyRef)).* AS Products,
	(UNDEFINED).* AS Characteristic,
	(VALUE(Catalog.ItemsBatches.EmptyRef)).* AS Series,
	(VALUE(Catalog.Assignments.EmptyRef)).* AS Purpose,
	(VALUE(Catalog.LinesOfBusiness.EmptyRef)).* AS LineOfBusiness,
	(VALUE(Catalog.ProductCostElements.EmptyRef)).* AS ProductCostElement,
	(UNDEFINED).*                                           AS Lot,
	(VALUE(Catalog.ProductionLots.EmptyRef)).*   AS ProductionLot,
	(UNDEFINED).*                                           AS ProductionOrder,
	
	0 AS InitialBalanceQuantity,
	0 AS InitialBalanceCost,
	0 AS InitialBalanceOfPD,
	0 AS InitialBalanceOfTD,
	0 AS InitialBalanceOffBalanceSheet,
	
	0 AS ReceivedQuantity,
	0 AS ReceivedCost,
	0 AS ReceivedPD,
	0 AS TDHasBeenReceived,
	0 AS ReceivedOffBalanceSheet,
	
	0 AS PurchasedQuantity_,
	0 AS PurchasedValue,
	0 AS PurchasedPD,
	0 AS AcquiredByTD,
	0 AS PurchasedOffBalanceSheet,
	
	0 AS MovementsQuantity,
	0 AS MovingCost,
	0 AS PDMovements,
	0 AS TDMovements,
	0 AS OffBalanceSheetTransfers,
	
	0 AS AmountSpentOnProduction,
	0 AS SpentOnProductionCost,
	0 AS SpentOnProductionOfPD,
	0 AS SpentOnProductionOfTD,
	0 AS SpentOnProductionOffBalanceSheet,
	
	0 AS DebitedQuantity,
	0 AS DebitedCost,
	0 AS WrittenOffPD,
	0 AS TDWasWrittenOff,
	0 AS WrittenOffOffBalanceSheet,
	
	0 AS FinalRemainderQuantity,
	0 AS FinalRemainderCost,
	0 AS FinalBalanceOfPD,
	0 AS FinalBalanceOfTD,
	0 AS FinalBalanceIsOffBalance,
	
	0 AS QuantityTransmitted,
	0 AS TransferredCost,
	0 AS SubmittedByPD,
	0 AS SubmittedByTD,
	0 AS PassedOffBalanceSheet,
	
	0 AS InclusionExclusionOfVAT,
	
	0 AS ProducedQuantity,
	0 AS ProducedCost,
	0 AS ProducedByPD,
	0 AS ProducedByTD,
	0 AS ProducedOffBalanceSheet}</query>
		<autoFillFields>false</autoFillFields>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<calculatedField>
		<dataPath>ItemsType</dataPath>
