		<field xsi:type="DataSetFieldField">
			<dataPath>FieldObjectOfOperation</dataPath>
			<field>FieldObjectOfOperation</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Asset</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دارایی</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Oggetto di esercizio</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Obiekt eksploatacji</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Объект эксплуатации</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Varlık</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đối tượng sử dụng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	SubAssets.Owner AS FieldObjectOfOperation,
	SubAssets.Ref AS NodeOfObjectOfOperation,
	CASE
		WHEN SubAssets.Owner.Status = VALUE(Enum.AssetStatuses.Disposed)
			THEN SubAssets.Owner.Status
		ELSE SubAssets.Status
	END AS Status,
	SubAssets.Class AS Class,
	SubAssets.Subclass AS Subclass,
	RMPlanSliceLast.RMType AS LastRepairTypeOfRepair,
	RMPlanSliceLast.Period AS LastRepairDate
FROM
	Catalog.SubAssets AS SubAssets
		LEFT JOIN InformationRegister.RMPlan.SliceLast({&amp;Period}, RMCycle) AS RMPlanSliceLast
		ON (RMPlanSliceLast.Asset = SubAssets.Ref)
WHERE
	NOT SubAssets.DeletionMark</query>
	</dataSet>
