		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RepairFacilities.Ref AS NodeOfObjectOfOperation,
	RepairFacilities.Owner AS FieldObjectOfOperation,
	RunningTimeValues.RunningTimeValue AS RunningTimeValue,
	RunningTimeValues.CalculateResidualLifetime AS CalculateResidualLifetime
INTO CurrentIndicatorsOfObjects
FROM
	Catalog.SubAssets AS RepairFacilities
		INNER JOIN Catalog.MaintenanceSchemes.RunningTimeValues AS RunningTimeValues
		ON RepairFacilities.Class = RunningTimeValues.Ref

WHERE
	NOT RepairFacilities.DeletionMark
	
INDEX BY
	NodeOfObjectOfOperation,
	RunningTimeValue
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CurrentIndicatorsOfObjects.NodeOfObjectOfOperation AS NodeOfObjectOfOperation,
	CurrentIndicatorsOfObjects.RunningTimeValue AS RunningTimeValue,
	CurrentIndicatorsOfObjects.CalculateResidualLifetime AS CalculateResidualLifetime,
	OperatingTimeParameters.AssignedResource AS AssignedResource
INTO OperatingTimeParameters
FROM
	CurrentIndicatorsOfObjects AS CurrentIndicatorsOfObjects
		LEFT JOIN Catalog.SubAssets.RunningTimeRecordingParameters AS OperatingTimeParameters
		ON CurrentIndicatorsOfObjects.NodeOfObjectOfOperation = OperatingTimeParameters.Ref
			AND CurrentIndicatorsOfObjects.RunningTimeValue = OperatingTimeParameters.RunningTimeValue

INDEX BY
	NodeOfObjectOfOperation,
	RunningTimeValue
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	OperatingTimeParameters.NodeOfObjectOfOperation AS NodeOfObjectOfOperation,
	OperatingTimeParameters.RunningTimeValue AS RunningTimeValue,
	ISNULL(DevelopmentsCut.Period, DATETIME(1, 1, 1, 0, 0, 0)) AS RegistrationDate,
	ISNULL(DevelopmentsCut.Value, 0) AS CurrentValue,
	ISNULL(DevelopmentsCut.AverageDailyValue, 0) AS AverageDailyValue,
	CASE
		WHEN OperatingTimeParameters.CalculateResidualLifetime
			THEN OperatingTimeParameters.AssignedResource
		ELSE 0
	END AS AssignedResource,
	CASE
		WHEN OperatingTimeParameters.CalculateResidualLifetime
			THEN OperatingTimeParameters.AssignedResource - ISNULL(DevelopmentsCut.Value, 0)
		ELSE 0
	END AS ResidualLifetime,
	CASE
		WHEN NOT OperatingTimeParameters.CalculateResidualLifetime
				OR DevelopmentsCut.AverageDailyValue IS NULL 
				OR DevelopmentsCut.AverageDailyValue = 0
			THEN DATETIME(1, 1, 1, 0, 0, 0)
		ELSE DATEADD(ISNULL(DevelopmentsCut.Period, DATETIME(1, 1, 1, 0, 0, 0)), DAY, (OperatingTimeParameters.AssignedResource - ISNULL(DevelopmentsCut.Value, 0)) / ISNULL(DevelopmentsCut.AverageDailyValue, 0))
	END AS AssignedResourceOutputDate,
	OperatingTimeParameters.CalculateResidualLifetime,
	CASE
		WHEN NOT OperatingTimeParameters.CalculateResidualLifetime
				OR DevelopmentsCut.AverageDailyValue IS NULL 
				OR DevelopmentsCut.AverageDailyValue = 0
			THEN 0
		ELSE (OperatingTimeParameters.AssignedResource - ISNULL(DevelopmentsCut.Value, 0)) / DevelopmentsCut.AverageDailyValue
	END AS ResidualLifetimeInDays
FROM
	OperatingTimeParameters AS OperatingTimeParameters
		LEFT JOIN InformationRegister.AssetActivityRecords.SliceLast({&amp;Period}
				,
				(Asset, RunningTimeValue) IN
					(SELECT
						OperatingTimeParameters.NodeOfObjectOfOperation,
						OperatingTimeParameters.RunningTimeValue
					FROM
						OperatingTimeParameters AS OperatingTimeParameters)) AS DevelopmentsCut
		ON OperatingTimeParameters.NodeOfObjectOfOperation = DevelopmentsCut.Asset
			AND OperatingTimeParameters.RunningTimeValue = DevelopmentsCut.RunningTimeValue</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>NodeListAndRepairs</sourceDataSet>
		<destinationDataSet>OperatingTime</destinationDataSet>
		<sourceExpression>NodeOfObjectOfOperation</sourceExpression>
		<destinationExpression>NodeOfObjectOfOperation</destinationExpression>
	</dataSetLink>
	<totalField>
		<dataPath>CurrentValue</dataPath>
		<expression>Sum(CurrentValue)</expression>
		<group>NodeOfObjectOfOperation</group>
	</totalField>
	<totalField>
		<dataPath>AverageDailyValue</dataPath>
		<expression>Sum(AverageDailyValue)</expression>
		<group>NodeOfObjectOfOperation</group>
	</totalField>
	<totalField>
		<dataPath>AssignedResource</dataPath>
		<expression>Sum(AssignedResource)</expression>
		<group>NodeOfObjectOfOperation</group>
	</totalField>
	<totalField>
		<dataPath>ResidualLifetime</dataPath>
		<expression>Sum(ResidualLifetime)</expression>
		<group>NodeOfObjectOfOperation</group>
	</totalField>
	<totalField>
		<dataPath>ResidualLifetimeInDays</dataPath>
		<expression>RMManagement.ResidualTimeResourceByLine(Sum(ResidualLifetimeInDays))</expression>
		<group>NodeOfObjectOfOperation</group>
	</totalField>
	<totalField>
		<dataPath>RegistrationDate</dataPath>
		<expression>Max(RegistrationDate)</expression>
		<group>NodeOfObjectOfOperation</group>
	</totalField>
	<totalField>
		<dataPath>AssignedResourceOutputDate</dataPath>
		<expression>Max(AssignedResourceOutputDate)</expression>
		<group>NodeOfObjectOfOperation</group>
	</totalField>
	<totalField>
		<dataPath>CalculateResidualLifetime</dataPath>
		<expression>Max(CalculateResidualLifetime)</expression>
	</totalField>
