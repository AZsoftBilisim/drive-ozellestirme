	<totalField>
		<dataPath>CustomerAccountsReceivable</dataPath>
		<expression>Sum(CustomerAccountsReceivable)</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueCustomerDebt</dataPath>
		<expression>Sum(OverdueCustomerDebt)</expression>
	</totalField>
	<totalField>
		<dataPath>DaysCount</dataPath>
		<expression>Max(DaysCount)</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompany</dataPath>
		<expression>Sum(AccountsPayableOfCompany)</expression>
	</totalField>
	<totalField>
		<dataPath>LowerBoundOfInterval</dataPath>
		<expression>Max(LowerBoundOfInterval)</expression>
		<group>Partner</group>
		<group>Partner Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>ToShip</dataPath>
		<expression>Sum(ToShip)</expression>
	</totalField>
	<totalField>
		<dataPath>CustomerDebtInTheReportCurrency</dataPath>
		<expression>Sum(CustomerDebtInTheReportCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueCustomerDebtInReportCurrency</dataPath>
		<expression>Sum(OverdueCustomerDebtInReportCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>OurDebtInTheReportCurrency</dataPath>
		<expression>Sum(OurDebtInTheReportCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>ForShipmentInTheReportCurrency</dataPath>
		<expression>Sum(ForShipmentInTheReportCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>LowerBoundOfInterval</dataPath>
		<expression>Avg(LowerBoundOfInterval)</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfOverdueDebt</dataPath>
		<expression>Case When Sum(CustomerAccountsReceivable) &lt;&gt; 0 Then Sum(OverdueCustomerDebt) / Sum(CustomerAccountsReceivable) * 100 Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfOverdueDebtInReportCurrency</dataPath>
		<expression>Case When Sum(CustomerDebtInTheReportCurrency) &lt;&gt; 0 Then Sum(OverdueCustomerDebtInReportCurrency) / Sum(CustomerDebtInTheReportCurrency) * 100 Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtShare</dataPath>
		<expression>Case
	When EvalExpression("Sum(CustomerDebtInTheReportCurrency)", , "Overall") &lt;&gt; 0
		Then Sum(CustomerDebtInTheReportCurrency) * 100 / EvalExpression("Sum(CustomerDebtInTheReportCurrency)", , "Overall")
	Else 0
End</expression>
	</totalField>
	<parameter>
