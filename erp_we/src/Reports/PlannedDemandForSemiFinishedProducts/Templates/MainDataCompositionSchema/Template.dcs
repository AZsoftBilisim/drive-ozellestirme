	<totalField>
		<dataPath>SurplusDeficitPercentage</dataPath>
		<expression>100 * Case When Sum(ConsumptionQuantity) = 0 And Sum(NumberOfSemiFinishedProducts) &lt;&gt; 0 Then 1 When Sum(ConsumptionQuantity) = 0 And Sum(NumberOfSemiFinishedProducts) = 0 Then 0 Else (Sum(NumberOfSemiFinishedProducts) - Sum(ConsumptionQuantity)) / Sum(ConsumptionQuantity)  End</expression>
