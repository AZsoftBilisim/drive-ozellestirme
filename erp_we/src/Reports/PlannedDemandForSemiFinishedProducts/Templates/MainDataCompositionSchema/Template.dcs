	<calculatedField>
		<dataPath>SurplusDeficitPercentage</dataPath>
		<expression>100 * Case When ConsumptionQuantity = 0 And NumberOfSemiFinishedProducts &lt;&gt; 0 Then 1 When ConsumptionQuantity = 0 And NumberOfSemiFinishedProducts = 0 Then 0 Else (NumberOfSemiFinishedProducts - ConsumptionQuantity) / ConsumptionQuantity  End</expression>
