				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CAST(OtherExpensesTurnover.DimensionOfExpenses AS Catalog.Assets) AS FixedAsset,
	OtherExpensesTurnover.ExpenseItem,
	OtherExpensesTurnover.LineOfBusiness,
	OtherExpensesTurnover.Department,
	OtherExpensesTurnover.Organization,
	
	CASE
		WHEN OtherExpensesTurnover.ExpenseItem.ExpensesOccur = VALUE(Enum.ExpenseTypes.CalculationOfNonCurrentAssetsVAlue)
			AND OtherExpensesTurnover.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
			THEN OtherExpensesTurnover.SumManReceipt
		ELSE 0
	END AS FormationOfCostOfMan,
	
	CASE
		WHEN OtherExpensesTurnover.ExpenseItem.ExpensesOccur = VALUE(Enum.ExpenseTypes.CalculationOfNonCurrentAssetsVAlue)
			AND OtherExpensesTurnover.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
			THEN OtherExpensesTurnover.SumComplReceipt
		ELSE 0
	END AS LocalValueGeneration,
	
	CASE
		WHEN OtherExpensesTurnover.ExpenseItem.ExpensesOccur = VALUE(Enum.ExpenseTypes.CalculationOfNonCurrentAssetsVAlue)
			AND OtherExpensesTurnover.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
			THEN 0
		ELSE OtherExpensesTurnover.SumManReceipt
	END AS OtherManCosts,
	
	CASE
		WHEN OtherExpensesTurnover.ExpenseItem.ExpensesOccur = VALUE(Enum.ExpenseTypes.CalculationOfNonCurrentAssetsVAlue)
			AND OtherExpensesTurnover.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToNonCurrentAssetCost)
			THEN 0
		ELSE OtherExpensesTurnover.SumComplReceipt
	END AS OtherLocalCosts
FROM
	AccumulationRegister.OtherExpenses.Turnovers(
			&amp;BeginOfPeriod, 
			&amp;EndOfPeriod,, 
			DimensionOfExpenses REFS Catalog.Assets {CAST(DimensionOfExpenses AS Catalog.Assets).* AS FixedAsset}) AS OtherExpensesTurnover</query>
	</dataSet>
	<totalField>
		<dataPath>LocalValueGeneration</dataPath>
		<expression>Sum(LocalValueGeneration)</expression>
	</totalField>
	<totalField>
		<dataPath>FormationOfCostOfMan</dataPath>
		<expression>Sum(FormationOfCostOfMan)</expression>
	</totalField>
	<totalField>
		<dataPath>OtherLocalCosts</dataPath>
		<expression>Sum(OtherLocalCosts)</expression>
	</totalField>
	<totalField>
		<dataPath>OtherManCosts</dataPath>
		<expression>Sum(OtherManCosts)</expression>
	</totalField>
	<parameter>
