		<field xsi:type="DataSetFieldField">
			<dataPath>DimensionOfExpenses</dataPath>
			<field>DimensionOfExpenses</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Expense dimension</v8:content>
				</v8:item>
