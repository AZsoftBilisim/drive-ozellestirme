	<settingsVariant>
		<dcsset:name>ExpenseStructureByFixedAssets</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Fixed assets costs breakdown</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تفکیک بهای دارایی‌های ثابت</v8:content>
