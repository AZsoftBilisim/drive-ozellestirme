			</title>
			<presentationExpression>Case
    When &amp;ReportFrequency = Value(Enum.Periodicity.Week)
        Then Format(DatePlan, "DLF=D") + " - " + Format(DatePlanEnd, "DLF=D")
    When &amp;ReportFrequency = Value(Enum.Periodicity.Month)
        Then Format(DatePlan, "DF='MMMM (yyyy)'")
    Else Format(DatePlan, "DF='dd.MM.yyyy (ddd)'")
End</presentationExpression>
