		<field xsi:type="DataSetFieldField">
			<dataPath>ProductionOrder</dataPath>
			<field>ProductionOrder</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<presentationExpression>NStr("ru = 'Заказ №'; vi = 'Đặt hàng số'; en = 'Order #'; it = 'Ordine №'; pl = 'Zamówienie nr'; tr = 'Sipariş №'") + ProductionOrder.Number + "; " + NStr("ru = 'дата потребности:'; vi = 'ngày yêu cầu:'; en = 'demand date:'; it = 'data del fabbisogno:'; pl = 'Data zapotrzebowania:'; tr = 'talep tarihi:'") + " " + Format(ProductionOrder.DemandDate, "DF='MM/dd/yy (ddd)'")</presentationExpression>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RegulatorySchedule.ProductionOrder                    AS ProductionOrder,
	NULL                                                     AS KeyProducts,
	RegulatorySchedule.Stage                                   AS ProductionStage,
	OrderStructure.BillOfMaterials                             AS BillOfMaterials,
	OrderStructure.Purpose                               AS Purpose,
	OrderStructure.Department                            AS Department,
	RegulatorySchedule.Stage                                   AS StageProduction,
	CAST(&amp;DesignationStep AS STRING(25))                AS StageProductionDesignation,
	1                                                        AS StageProductsProcedure,
	OrderStructure.Products.UnitOfMeasure            AS UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, WEEK)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, MONTH)
					ELSE &amp;EndOfPeriod
				END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END                                                    AS DatePlan,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, MONTH)
				ELSE &amp;BeginOfPeriod
			END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END                                                    AS DatePlanEnd,
	SUM(OrderStructure.Scheduled +
		OrderStructure.Launched)                            AS Count,
	OrderStructure.Products                             AS Products,
	OrderStructure.Characteristic                           AS Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
		ELSE BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
	END                                                    AS FinalScheduleDate,
	OrderStructure.DurationBeforeProductionIssue                    AS DurationBeforeProductionIssue,
	MAX(BEGINOFPERIOD(&amp;CurrentDate, DAY) &gt; 
		BEGINOFPERIOD(OrderProducts_.DemandDate, DAY)) AS ReleaseDateIsOverdue
FROM
	InformationRegister.TargetOrderStructureSchedule AS RegulatorySchedule
		LEFT JOIN InformationRegister.OrderStructure AS OrderStructure
		ON OrderStructure.ProductionOrder = RegulatorySchedule.ProductionOrder
		AND OrderStructure.KeyLot = RegulatorySchedule.KeyLot
		AND OrderStructure.Stage = RegulatorySchedule.Stage
		
		LEFT JOIN Document.ProductionOrder2_2.ManufacturedProduct AS OrderProducts_
		ON OrderProducts_.Ref = OrderStructure.ProductionOrder
		AND OrderProducts_.KeyProducts = OrderStructure.KeyProducts
		AND OrderProducts_.DemandDate &lt;&gt; DATETIME(1,1,1)
WHERE
	&amp;DisplayStages
	AND RegulatorySchedule.Stage &lt;&gt; VALUE(Catalog.ProductionStages.EmptyRef)
	AND (OrderStructure.Scheduled &lt;&gt; 0
	OR OrderStructure.Launched &lt;&gt; 0
	OR OrderStructure.AllocatedInFreeProductionLots &lt;&gt; 0
	OR OrderStructure.AllocatedInAssignedProductionLots &lt;&gt; 0)
	AND (&amp;ScheduleDateOption = 0
			AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Begin &gt;= &amp;BeginOfPeriod)
			AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Begin &lt;= &amp;EndOfPeriod)
		OR &amp;ScheduleDateOption = 1
			AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Ending &gt;= &amp;BeginOfPeriod)
			AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Ending &lt;= &amp;EndOfPeriod))

GROUP BY
	RegulatorySchedule.ProductionOrder,
	RegulatorySchedule.Stage,
	OrderStructure.BillOfMaterials,
	OrderStructure.Purpose,
	OrderStructure.Department,
	OrderStructure.Products.UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, WEEK)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, MONTH)
					ELSE &amp;EndOfPeriod
				END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, MONTH)
				ELSE &amp;BeginOfPeriod
			END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END,
	OrderStructure.Products,
	OrderStructure.Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
		ELSE BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
	END,
	OrderStructure.DurationBeforeProductionIssue

UNION ALL

SELECT
	OrderStructure.ProductionOrder                      AS ProductionOrder,
	MAX(CASE
				WHEN OrderStructure.LineKind IN (
							VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts),
							VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct))
					THEN OrderStructure.KeyProducts
	END)                                                   AS KeyProducts,
	OrderStructure.Stage                                     AS ProductionStage,
	OrderStructure.BillOfMaterials                             AS BillOfMaterials,
	OrderStructure.Purpose                               AS Purpose,
	OrderStructure.Department                            AS Department,
	OrderStructure.Products                             AS StageProduction,
	CAST(&amp;DesignationProduct AS STRING(25))             AS StageProductionDesignation,
	CASE
		WHEN OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts)
			THEN 3
		ELSE 2
	END                                                    AS StageProductsProcedure,
	OrderStructure.Products.UnitOfMeasure            AS UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, WEEK)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, MONTH)
					ELSE &amp;EndOfPeriod
				END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END                                                    AS DatePlan,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, MONTH)
				ELSE &amp;BeginOfPeriod
			END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END                                                    AS DatePlanEnd,
	SUM(OrderStructure.Scheduled)                     AS Count,
	OrderStructure.Products                             AS Products,
	OrderStructure.Characteristic                           AS Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
		ELSE BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
	END                                                    AS FinalScheduleDate,
	OrderStructure.DurationBeforeProductionIssue                    AS DurationBeforeProductionIssue,
	BEGINOFPERIOD(&amp;CurrentDate, DAY) &gt; 
		BEGINOFPERIOD(OrderProducts_.DemandDate, DAY) AS ReleaseDateIsOverdue
FROM
	InformationRegister.OrderStructure AS OrderStructure
	LEFT JOIN InformationRegister.TargetOrderStructureSchedule AS RegulatorySchedule
		ON OrderStructure.ProductionOrder = RegulatorySchedule.ProductionOrder
		AND OrderStructure.KeyLot = RegulatorySchedule.KeyLot
		AND OrderStructure.Stage = RegulatorySchedule.Stage
		
		LEFT JOIN Document.ProductionOrder2_2.ManufacturedProduct AS OrderProducts_
		ON OrderProducts_.Ref = OrderStructure.ProductionOrder
		AND OrderProducts_.KeyProducts = OrderStructure.KeyProducts
		AND OrderProducts_.DemandDate &lt;&gt; DATETIME(1,1,1)
		
		INNER JOIN Document.ProductionOrder2_2 AS Orders
		ON Orders.Ref = OrderStructure.ProductionOrder
		AND Orders.ProductionProcessType &lt;&gt; VALUE(Enum.ProductionProcessTypes.Disassembly)
WHERE
	&amp;DisplayProducts
	AND OrderStructure.Scheduled &lt;&gt; 0
	AND OrderStructure.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.Move)
	AND (&amp;ScheduleDateOption = 0
			AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Begin &gt;= &amp;BeginOfPeriod)
			AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Begin &lt;= &amp;EndOfPeriod)
		OR &amp;ScheduleDateOption = 1
			AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Ending &gt;= &amp;BeginOfPeriod)
			AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Ending &lt;= &amp;EndOfPeriod))

GROUP BY
	OrderStructure.ProductionOrder,
	OrderStructure.Stage,
	OrderStructure.BillOfMaterials,
	OrderStructure.Purpose,
	OrderStructure.Department,
	OrderStructure.LineKind,
	OrderStructure.Products.UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, WEEK)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, MONTH)
					ELSE &amp;EndOfPeriod
				END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, MONTH)
				ELSE &amp;BeginOfPeriod
			END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END,
	OrderStructure.Products,
	OrderStructure.Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
		ELSE BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
	END,
	OrderStructure.DurationBeforeProductionIssue,
	OrderProducts_.DemandDate

UNION ALL

SELECT
	OrderStructure.ProductionOrder                      AS ProductionOrder,
	MAX(OrderStructure.KeyProducts)               AS KeyProducts,
	OrderStructure.Stage                                     AS ProductionStage,
	OrderStructure.BillOfMaterials                             AS BillOfMaterials,
	OrderStructure.Purpose                               AS Purpose,
	OrderStructure.Department                            AS Department,
	OrderStructure.Products                             AS StageProduction,
	CAST(&amp;DesignationProduct AS STRING(25))             AS StageProductionDesignation,
	3                                                        AS StageProductsProcedure,
	OrderStructure.Products.UnitOfMeasure            AS UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, WEEK)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, MONTH)
					ELSE &amp;EndOfPeriod
				END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END                                                    AS DatePlan,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, MONTH)
				ELSE &amp;BeginOfPeriod
			END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END                                                    AS DatePlanEnd,
	SUM(OrderStructure.AllocatedInFreeProductionLots +
		OrderStructure.AllocatedInAssignedProductionLots)     AS Count,
	OrderStructure.Products                             AS Products,
	OrderStructure.Characteristic                           AS Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
		ELSE BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
	END                                                    AS FinalScheduleDate,
	OrderStructure.DurationBeforeProductionIssue                    AS DurationBeforeProductionIssue,
	BEGINOFPERIOD(&amp;CurrentDate, DAY) &gt; 
		BEGINOFPERIOD(OrderProducts_.DemandDate, DAY) AS ReleaseDateIsOverdue
FROM
	InformationRegister.OrderStructure AS OrderStructure
	LEFT JOIN InformationRegister.TargetOrderStructureSchedule AS RegulatorySchedule
		ON OrderStructure.ProductionOrder = RegulatorySchedule.ProductionOrder
		AND OrderStructure.KeyLot = RegulatorySchedule.KeyLot
		AND OrderStructure.Stage = RegulatorySchedule.Stage
		
		LEFT JOIN Document.ProductionOrder2_2.ManufacturedProduct AS OrderProducts_
		ON OrderProducts_.Ref = OrderStructure.ProductionOrder
		AND OrderProducts_.KeyProducts = OrderStructure.KeyProducts
		AND OrderProducts_.DemandDate &lt;&gt; DATETIME(1,1,1)
		
		INNER JOIN Document.ProductionOrder2_2 AS Orders
		ON Orders.Ref = OrderStructure.ProductionOrder
		AND Orders.ProductionProcessType &lt;&gt; VALUE(Enum.ProductionProcessTypes.Disassembly)
WHERE
	&amp;DisplayProducts
	AND (OrderStructure.AllocatedInFreeProductionLots &lt;&gt; 0
	OR OrderStructure.AllocatedInAssignedProductionLots &lt;&gt; 0)
	AND OrderStructure.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.Move)
	AND (&amp;ScheduleDateOption = 0
			AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Begin &gt;= &amp;BeginOfPeriod)
			AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Begin &lt;= &amp;EndOfPeriod)
		OR &amp;ScheduleDateOption = 1
			AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Ending &gt;= &amp;BeginOfPeriod)
			AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Ending &lt;= &amp;EndOfPeriod))

GROUP BY
	OrderStructure.ProductionOrder,
	OrderStructure.Stage,
	OrderStructure.BillOfMaterials,
	OrderStructure.Purpose,
	OrderStructure.Department,
	OrderStructure.Products.UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, WEEK)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, MONTH)
					ELSE &amp;EndOfPeriod
				END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, MONTH)
				ELSE &amp;BeginOfPeriod
			END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END,
	OrderStructure.Products,
	OrderStructure.Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
		ELSE BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
	END,
	OrderStructure.DurationBeforeProductionIssue,
	OrderProducts_.DemandDate

UNION ALL

SELECT
	OrderStructure.ProductionOrder                      AS ProductionOrder,
	MAX(OrderStructure.KeyProducts)               AS KeyProducts,
	OrderStructure.Stage                                     AS ProductionStage,
	OrderStructure.BillOfMaterials                             AS BillOfMaterials,
	OrderStructure.Purpose                               AS Purpose,
	OrderStructure.Department                            AS Department,
	OrderStructure.Products                             AS StageProduction,
	CAST(&amp;DesignationProduct AS STRING(25))             AS StageProductionDesignation,
	2                                                        AS StageProductsProcedure,
	OrderStructure.Products.UnitOfMeasure            AS UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, WEEK)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, MONTH)
					ELSE &amp;EndOfPeriod
				END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END                                                    AS DatePlan,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, MONTH)
				ELSE &amp;BeginOfPeriod
			END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END                                                    AS DatePlanEnd,
	SUM(OrderStructure.Launched - (OrderStructure.AllocatedInFreeProductionLots +
		OrderStructure.AllocatedInAssignedProductionLots))      AS Count,
	OrderStructure.Products                             AS Products,
	OrderStructure.Characteristic                           AS Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
		ELSE BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
	END                                                    AS FinalScheduleDate,
	OrderStructure.DurationBeforeProductionIssue                    AS DurationBeforeProductionIssue,
	FALSE AS ReleaseDateIsOverdue
FROM
	InformationRegister.OrderStructure AS OrderStructure
	LEFT JOIN InformationRegister.TargetOrderStructureSchedule AS RegulatorySchedule
		ON OrderStructure.ProductionOrder = RegulatorySchedule.ProductionOrder
		AND OrderStructure.KeyLot = RegulatorySchedule.KeyLot
		AND OrderStructure.Stage = RegulatorySchedule.Stage
		
		INNER JOIN Document.ProductionOrder2_2 AS Orders
		ON Orders.Ref = OrderStructure.ProductionOrder
		AND Orders.ProductionProcessType &lt;&gt; VALUE(Enum.ProductionProcessTypes.Disassembly)
WHERE
	&amp;DisplayProducts
	AND (OrderStructure.Launched &lt;&gt; 0 OR OrderStructure.AllocatedInFreeProductionLots &lt;&gt; 0
	OR OrderStructure.AllocatedInAssignedProductionLots &lt;&gt; 0)
	AND OrderStructure.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.Move)
	AND (&amp;ScheduleDateOption = 0
			AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Begin &gt;= &amp;BeginOfPeriod)
			AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Begin &lt;= &amp;EndOfPeriod)
		OR &amp;ScheduleDateOption = 1
			AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Ending &gt;= &amp;BeginOfPeriod)
			AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
				OR RegulatorySchedule.Ending &lt;= &amp;EndOfPeriod)) 

GROUP BY
	OrderStructure.ProductionOrder,
	OrderStructure.Stage,
	OrderStructure.BillOfMaterials,
	OrderStructure.Purpose,
	OrderStructure.Department,
	OrderStructure.Products.UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, WEEK)
					WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
						THEN BEGINOFPERIOD(RegulatorySchedule.Begin, MONTH)
					ELSE &amp;EndOfPeriod
				END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Begin, MONTH)
				ELSE &amp;BeginOfPeriod
			END
		ELSE CASE
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, DAY)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, WEEK)
				WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
					THEN ENDOFPERIOD(RegulatorySchedule.Ending, MONTH)
				ELSE &amp;EndOfPeriod
			END
	END,
	OrderStructure.Products,
	OrderStructure.Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN BEGINOFPERIOD(RegulatorySchedule.Begin, DAY)
		ELSE BEGINOFPERIOD(RegulatorySchedule.Ending, DAY)
	END,
	OrderStructure.DurationBeforeProductionIssue
HAVING
	SUM(OrderStructure.Launched - (OrderStructure.AllocatedInFreeProductionLots +
		OrderStructure.AllocatedInAssignedProductionLots)) &gt; 0</query>
	</dataSet>
	<calculatedField>
		<dataPath>TotalPlan</dataPath>
		<expression>Count</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Total plan</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>کل برنامه</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Totale piano</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Łącznie plan</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Итого план</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Toplam plan</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Tổng kế hoạch</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>DurationBeforeProductionIssue</dataPath>
		<expression>Max(DurationBeforeProductionIssue)</expression>
	</totalField>
	<totalField>
		<dataPath>FinalScheduleDate</dataPath>
		<expression>Case
	When &amp;ScheduleDateOption = 0
		Then Min(FinalScheduleDate)
	Else Max(FinalScheduleDate)
End</expression>
		<group>StageProduction</group>
	</totalField>
	<totalField>
		<dataPath>TotalPlan</dataPath>
		<expression>Sum(TotalPlan)</expression>
		<group>StageProduction</group>
	</totalField>
	<totalField>
		<dataPath>StageProductsProcedure</dataPath>
		<expression>Max(StageProductsProcedure)</expression>
	</totalField>
	<totalField>
		<dataPath>ReleaseDateIsOverdue</dataPath>
		<expression>Max(ReleaseDateIsOverdue)</expression>
	</totalField>
