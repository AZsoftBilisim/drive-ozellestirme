		<dataSource>DataSource1</dataSource>
		<query>// !!! TAGS ARE USED !!!

SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ProductionPlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ProductionPlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ProductionPlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ProductionPlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ProductionPlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ProductionPlansTurnovers.YearPeriod
		ELSE ProductionPlansTurnovers.DayPeriod
	END AS DynamicPeriod,
	ProductionPlansTurnovers.Department AS Department,
	ProductionPlansTurnovers.Products AS Products,
	ProductionPlansTurnovers.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN ProductionPlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	ProductionPlansTurnovers.Recorder AS Recorder,
	SUM(ProductionPlansTurnovers.CountTurnover) AS Count
INTO ProductionPlan
{SELECT
	Department.*}
FROM
	AccumulationRegister.ProductionPlans.Turnovers(
		{(&amp;BeginOfPeriod)},
		{(&amp;EndOfPeriod)},
		Auto,
		Scenario = &amp;Scenario
		{ProductionProcessType = &amp;ProductionProcessType}
		{(Department),
		((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment AS SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
		) AS ProductionPlansTurnovers

GROUP BY
	ProductionPlansTurnovers.Products,
	ProductionPlansTurnovers.Characteristic,
	CASE 
		WHEN &amp;SpecifyTargets
			THEN ProductionPlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	ProductionPlansTurnovers.Recorder,
	ProductionPlansTurnovers.Department,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ProductionPlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ProductionPlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ProductionPlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ProductionPlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ProductionPlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ProductionPlansTurnovers.YearPeriod
		ELSE ProductionPlansTurnovers.DayPeriod
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN OutputTurnover_.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN OutputTurnover_.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN OutputTurnover_.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN OutputTurnover_.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN OutputTurnover_.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN OutputTurnover_.YearPeriod
		ELSE OutputTurnover_.DayPeriod
	END AS DynamicPeriod,
	CASE
		WHEN OutputTurnover_.Recorder REFS Document.ProductionStage2_2
			THEN ISNULL(OutputTurnover_.Recorder.ReferenceOrder.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN OutputTurnover_.Recorder REFS Document.BackflushProduction
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		
		
		WHEN TRUE 
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END AS Department,
	OutputTurnover_.ItemsLocationAttributes.Products AS Products,
	OutputTurnover_.ItemsLocationAttributes.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN CASE
					WHEN NOT ManufacturedProduct.Purpose IS NULL
						THEN ManufacturedProduct.Purpose
					WHEN NOT SideAndIntermediateRelease.Purpose IS NULL
						THEN SideAndIntermediateRelease.Purpose
					WHEN TRUE
						THEN OutputTurnover_.ItemsLocationAttributes.Purpose
				END
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	OutputTurnover_.Recorder AS Recorder,
	SUM(OutputTurnover_.CountTurnover) AS FactQuantity
INTO Production
FROM
	AccumulationRegister.ProductsRelease.Turnovers(
		{(&amp;BeginOfPeriod)},
		{(&amp;EndOfPeriod)},
		Auto,
		{(CASE
			WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
				THEN (ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
					(SELECT DISTINCT
						ProductionPlan.Products,
						ProductionPlan.Characteristic
					FROM
					ProductionPlan AS ProductionPlan)
			ELSE TRUE
	END)}) AS OutputTurnover_
	LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS ManufacturedProduct
		ON ManufacturedProduct.Ref = OutputTurnover_.ReferenceOrder
		AND ManufacturedProduct.RowCode = OutputTurnover_.RowCode
	LEFT JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS SideAndIntermediateRelease
		ON SideAndIntermediateRelease.Ref = OutputTurnover_.ReferenceOrder
		AND SideAndIntermediateRelease.RowCode = OutputTurnover_.RowCode

{WHERE
	CASE
		WHEN OutputTurnover_.Recorder REFS Document.ProductionStage2_2
			THEN OutputTurnover_.Recorder.ReferenceOrder.ProductionProcessType = &amp;ProductionProcessType
				AND OutputTurnover_.Recorder.ReferenceOrder.ProductionProcessType &lt;&gt; VALUE(Enum.ProductionProcessTypes.Disassembly)
		ELSE TRUE
	END}
GROUP BY
	CASE
		WHEN OutputTurnover_.Recorder REFS Document.ProductionStage2_2
			THEN ISNULL(OutputTurnover_.Recorder.ReferenceOrder.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN OutputTurnover_.Recorder REFS Document.BackflushProduction
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		
		
		WHEN TRUE
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END,
	OutputTurnover_.ItemsLocationAttributes.Products,
	OutputTurnover_.ItemsLocationAttributes.Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN CASE
					WHEN NOT ManufacturedProduct.Purpose IS NULL
						THEN ManufacturedProduct.Purpose
					WHEN NOT SideAndIntermediateRelease.Purpose IS NULL
						THEN SideAndIntermediateRelease.Purpose
					WHEN TRUE
						THEN OutputTurnover_.ItemsLocationAttributes.Purpose 
				END
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	OutputTurnover_.Recorder,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN OutputTurnover_.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN OutputTurnover_.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN OutputTurnover_.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN OutputTurnover_.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN OutputTurnover_.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN OutputTurnover_.YearPeriod
		ELSE OutputTurnover_.DayPeriod
	END
;


////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE ProductionOrder.ProductionProcessType
		WHEN VALUE(Enum.ProductionProcessTypes.Disassembly)
			THEN 
			CASE &amp;Periodicity
				WHEN VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, WEEK)
				WHEN VALUE(Enum.Periodicity.TENDAYS)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, TENDAYS)
				WHEN VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, MONTH)
				WHEN VALUE(Enum.Periodicity.QUARTER)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, QUARTER)
				WHEN VALUE(Enum.Periodicity.HALFYEAR)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, HALFYEAR)
				WHEN VALUE(Enum.Periodicity.YEAR)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, YEAR)
				ELSE BEGINOFPERIOD(ProductionOrder.EarliestStartDate, DAY)
			END
		ELSE
			CASE &amp;Periodicity
				WHEN VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, WEEK)
				WHEN VALUE(Enum.Periodicity.TENDAYS)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, TENDAYS)
				WHEN VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, MONTH)
				WHEN VALUE(Enum.Periodicity.QUARTER)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, QUARTER)
				WHEN VALUE(Enum.Periodicity.HALFYEAR)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, HALFYEAR)
				WHEN VALUE(Enum.Periodicity.YEAR)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, YEAR)
				ELSE BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, DAY)
			END
	END AS DynamicPeriod,
	ProductionOrder.Department AS Department,
	ProductionOrderManufacturedProducts.Products AS Products,
	ProductionOrderManufacturedProducts.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets 
			THEN ProductionOrderManufacturedProducts.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	ProductionOrder.Ref AS Recorder,
	SUM(ProductionOrderManufacturedProducts.Count) AS OrderedQuantity
INTO Orders
FROM
	Document.ProductionOrder2_2.ManufacturedProduct AS ProductionOrderManufacturedProducts
		
		INNER JOIN Document.ProductionOrder2_2 AS ProductionOrder
		ON ProductionOrderManufacturedProducts.Ref = ProductionOrder.Ref
WHERE
	ProductionOrder.Posted
	AND ProductionOrder.Status &lt;&gt; VALUE(Enum.ProductionOrderStatuses2_2.BeingGenerated)
	AND ProductionOrderManufacturedProducts.Count &gt; 0
	AND NOT ProductionOrderManufacturedProducts.Canceled
	AND CASE
		WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
			THEN (ProductionOrderManufacturedProducts.Products, ProductionOrderManufacturedProducts.Characteristic) IN
				(SELECT DISTINCT
					ProductionPlan.Products,
					ProductionPlan.Characteristic
				FROM
					ProductionPlan AS ProductionPlan)
		ELSE TRUE
	END
	AND (CASE ProductionOrder.ProductionProcessType
			WHEN VALUE(Enum.ProductionProcessTypes.Disassembly)
				THEN ProductionOrder.EarliestStartDate
			ELSE CASE
				WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
					THEN ProductionOrder.EarliestStartDate
				ELSE ProductionOrder.DemandDate
			END
		END &gt;= &amp;BeginOfPeriod OR &amp;BeginOfPeriod = DATETIME(1,1,1))
	AND (CASE ProductionOrder.ProductionProcessType
			WHEN VALUE(Enum.ProductionProcessTypes.Disassembly)
				THEN ProductionOrder.EarliestStartDate
			ELSE CASE
				WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
					THEN ProductionOrder.EarliestStartDate
				ELSE ProductionOrder.DemandDate
			END
		END &lt;= &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
{WHERE
	ProductionOrder.ProductionProcessType = &amp;ProductionProcessType}

GROUP BY
	ProductionOrder.Department,
	ProductionOrderManufacturedProducts.Products,
	ProductionOrderManufacturedProducts.Characteristic,
	CASE
		WHEN &amp;SpecifyTargets 
			THEN ProductionOrderManufacturedProducts.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	ProductionOrder.Ref,
	CASE ProductionOrder.ProductionProcessType
		WHEN VALUE(Enum.ProductionProcessTypes.Disassembly)
			THEN 
			CASE &amp;Periodicity
				WHEN VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, WEEK)
				WHEN VALUE(Enum.Periodicity.TENDAYS)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, TENDAYS)
				WHEN VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, MONTH)
				WHEN VALUE(Enum.Periodicity.QUARTER)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, QUARTER)
				WHEN VALUE(Enum.Periodicity.HALFYEAR)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, HALFYEAR)
				WHEN VALUE(Enum.Periodicity.YEAR)
					THEN BEGINOFPERIOD(ProductionOrder.EarliestStartDate, YEAR)
				ELSE BEGINOFPERIOD(ProductionOrder.EarliestStartDate, DAY)
			END
		ELSE
			CASE &amp;Periodicity
				WHEN VALUE(Enum.Periodicity.WEEK)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, WEEK)
				WHEN VALUE(Enum.Periodicity.TENDAYS)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, TENDAYS)
				WHEN VALUE(Enum.Periodicity.MONTH)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, MONTH)
				WHEN VALUE(Enum.Periodicity.QUARTER)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, QUARTER)
				WHEN VALUE(Enum.Periodicity.HALFYEAR)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, HALFYEAR)
				WHEN VALUE(Enum.Periodicity.YEAR)
					THEN BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, YEAR)
				ELSE BEGINOFPERIOD(CASE
						WHEN ProductionOrder.DemandDate = DATETIME(1,1,1)
							THEN ProductionOrder.EarliestStartDate
						ELSE ProductionOrder.DemandDate
					END, DAY)
			END
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DynamicPeriod,
	NestedQuery.Department,
	NestedQuery.Products,
	NestedQuery.Characteristic,
	NestedQuery.Purpose,
	NestedQuery.Recorder,
	SUM(NestedQuery.PlanQuantity) AS PlanQuantity,
	SUM(NestedQuery.FactQuantity) AS FactQuantity,
	SUM(NestedQuery.OrderedQuantity) AS OrderedQuantity
INTO ProductionPlanFact
FROM
	(SELECT
		ProductionPlan.DynamicPeriod AS DynamicPeriod,
		ProductionPlan.Department AS Department,
		ProductionPlan.Products AS Products,
		ProductionPlan.Characteristic AS Characteristic,
		ProductionPlan.Purpose AS Purpose,
		ProductionPlan.Recorder AS Recorder,
		ProductionPlan.Count AS PlanQuantity,
		0 AS FactQuantity,
		0 AS OrderedQuantity
	FROM
		ProductionPlan AS ProductionPlan
	
	UNION ALL
	
	SELECT
		Production.DynamicPeriod,
		Production.Department,
		Production.Products,
		Production.Characteristic,
		Production.Purpose,
		Production.Recorder,
		0,
		Production.FactQuantity,
		0
	FROM
		Production AS Production
	
	UNION ALL
	
	SELECT
		Orders.DynamicPeriod,
		Orders.Department,
		Orders.Products,
		Orders.Characteristic,
		Orders.Purpose,
		Orders.Recorder,
		0,
		0,
		Orders.OrderedQuantity
	FROM
		Orders AS Orders
	) AS NestedQuery

GROUP BY
	NestedQuery.DynamicPeriod,
	NestedQuery.Characteristic,
	NestedQuery.Products,
	NestedQuery.Purpose,
	NestedQuery.Recorder,
	NestedQuery.Department
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProductionPlanFact.DynamicPeriod,
	ProductionPlanFact.Department AS ProductionDispatcherBusinessUnit,
	ProductionPlanFact.Products,
	ProductionPlanFact.Characteristic,
	ProductionPlanFact.Purpose,
	ProductionPlanFact.Recorder,
	SUM(ProductionPlanFact.PlanQuantity) AS PlanQuantity,
	SUM(ProductionPlanFact.FactQuantity) AS FactQuantity,
	100 * (CASE
		WHEN SUM(ProductionPlanFact.PlanQuantity) = 0
			THEN 0
		ELSE SUM(ProductionPlanFact.FactQuantity) / SUM(ProductionPlanFact.PlanQuantity)
	END) AS ExecutionOfPlanQuantity,
	SUM(ProductionPlanFact.OrderedQuantity) AS OrderedQuantity
FROM
	ProductionPlanFact AS ProductionPlanFact

GROUP BY
	ProductionPlanFact.DynamicPeriod,
	ProductionPlanFact.Products,
	ProductionPlanFact.Characteristic,
	ProductionPlanFact.Purpose,
	ProductionPlanFact.Recorder,
	ProductionPlanFact.Department</query>
	</dataSet>
	<totalField>
		<dataPath>Plan.Count</dataPath>
		<expression>Sum(Plan.Count)</expression>
	</totalField>
	<totalField>
		<dataPath>Real.Count</dataPath>
		<expression>Sum(Real.Count)</expression>
	</totalField>
	<totalField>
		<dataPath>PlanExecution.Count</dataPath>
		<expression>100 * (Case When Sum(Plan.Count) = 0 Then 0 Else Sum(Real.Count) / Sum(Plan.Count) End)</expression>
	</totalField>
	<totalField>
		<dataPath>Ordered.Count</dataPath>
		<expression>Sum(Ordered.Count)</expression>
	</totalField>
