		<field xsi:type="DataSetFieldField">
			<dataPath>ContractLineOfBusiness</dataPath>
			<field>ContractLineOfBusiness</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LoanAndDepositContracts THEN
			CAST(FinancialInstrumentsARAP.Contract AS Catalog.LoanAndDepositContracts).ContractKind
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LeaseContract THEN
			VALUE(Enum.ContractKindsOfFinancialInstruments.Lease)
	END AS ContractKind,
	FinancialInstrumentsARAP.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	FinancialInstrumentsARAP.Contract.LineOfBusiness,
	FinancialInstrumentsARAP.Contract,
	FinancialInstrumentsARAP.AmountType,
	FinancialInstrumentsARAP.ARAPDocument,
	FinancialInstrumentsARAP.Currency AS ARAPCurrency,
	
	CASE WHEN FinancialInstrumentsARAP.Recorder = UNDEFINED THEN
		NULL
	ELSE
		FinancialInstrumentsARAP.Recorder
	END AS Recorder,
	
	FinancialInstrumentsARAP.SecondPeriod AS SecondPeriod,
	FinancialInstrumentsARAP.DayPeriod AS DayPeriod,
	FinancialInstrumentsARAP.WeekPeriod AS WeekPeriod,
	FinancialInstrumentsARAP.TenDaysPeriod AS TenDaysPeriod,
	FinancialInstrumentsARAP.MonthPeriod AS MonthPeriod,
	FinancialInstrumentsARAP.QuarterPeriod AS QuarterPeriod,
	FinancialInstrumentsARAP.HalfYearPeriod AS HalfYearPeriod,
	FinancialInstrumentsARAP.YearPeriod AS YearPeriod,
	
	FinancialInstrumentsARAP.SumOpeningBalance AS DebtOpeningBalance,
	FinancialInstrumentsARAP.SumReceipt AS DebtIncrease_,
	FinancialInstrumentsARAP.SumExpense AS DebtReduction,
	FinancialInstrumentsARAP.SumClosingBalance AS DebtClosingBalance
FROM
	AccumulationRegister.FinancialInstrumentsARAP.BalanceAndTurnovers(,, Auto) AS FinancialInstrumentsARAP
	{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON FinancialInstrumentsARAP.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey}
WHERE
	&amp;SettlementsData = 1
{WHERE
	RegisterAccountingAnalyticsForPartners.Partner IN (
		SELECT SelectionByPartnerSegment.Partner
		FROM SelectionByPartnerSegment
		WHERE SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed),
	CASE
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LoanAndDepositContracts THEN
			CAST(FinancialInstrumentsARAP.Contract AS Catalog.LoanAndDepositContracts).ContractKind
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LeaseContract THEN
			VALUE(Enum.ContractKindsOfFinancialInstruments.Lease)
	END IN (&amp;FinancialInstrument)}
	
UNION ALL
	
SELECT
	CASE
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LoanAndDepositContracts THEN
			CAST(FinancialInstrumentsARAP.Contract AS Catalog.LoanAndDepositContracts).ContractKind
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LeaseContract THEN
			VALUE(Enum.ContractKindsOfFinancialInstruments.Lease)
	END AS ContractKind,
	FinancialInstrumentsARAP.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	FinancialInstrumentsARAP.Contract.LineOfBusiness,
	FinancialInstrumentsARAP.Contract,
	FinancialInstrumentsARAP.AmountType,
	FinancialInstrumentsARAP.ARAPDocument,
	FinancialInstrumentsARAP.Currency AS ARAPCurrency,
	
	CASE WHEN FinancialInstrumentsARAP.Recorder = UNDEFINED THEN
		NULL
	ELSE
		FinancialInstrumentsARAP.Recorder
	END AS Recorder,
	
	FinancialInstrumentsARAP.SecondPeriod AS SecondPeriod,
	FinancialInstrumentsARAP.DayPeriod AS DayPeriod,
	FinancialInstrumentsARAP.WeekPeriod AS WeekPeriod,
	FinancialInstrumentsARAP.TenDaysPeriod AS TenDaysPeriod,
	FinancialInstrumentsARAP.MonthPeriod AS MonthPeriod,
	FinancialInstrumentsARAP.QuarterPeriod AS QuarterPeriod,
	FinancialInstrumentsARAP.HalfYearPeriod AS HalfYearPeriod,
	FinancialInstrumentsARAP.YearPeriod AS YearPeriod,
	
	FinancialInstrumentsARAP.SumManOpeningBalance AS DebtOpeningBalance,
	FinancialInstrumentsARAP.SumManReceipt AS DebtIncrease_,
	FinancialInstrumentsARAP.SumManExpense AS DebtReduction,
	FinancialInstrumentsARAP.SumManClosingBalance AS DebtClosingBalance
FROM
	AccumulationRegister.FinancialInstrumentsARAP.BalanceAndTurnovers(,, Auto) AS FinancialInstrumentsARAP
	{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON FinancialInstrumentsARAP.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey}
WHERE
	&amp;SettlementsData = 2
{WHERE
	RegisterAccountingAnalyticsForPartners.Partner IN (
		SELECT SelectionByPartnerSegment.Partner
		FROM SelectionByPartnerSegment
		WHERE SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed),
	CASE
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LoanAndDepositContracts THEN
			CAST(FinancialInstrumentsARAP.Contract AS Catalog.LoanAndDepositContracts).ContractKind
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LeaseContract THEN
			VALUE(Enum.ContractKindsOfFinancialInstruments.Lease)
	END IN (&amp;FinancialInstrument)}
	
UNION ALL
	
SELECT
	CASE
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LoanAndDepositContracts THEN
			CAST(FinancialInstrumentsARAP.Contract AS Catalog.LoanAndDepositContracts).ContractKind
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LeaseContract THEN
			VALUE(Enum.ContractKindsOfFinancialInstruments.Lease)
	END AS ContractKind,
	FinancialInstrumentsARAP.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	FinancialInstrumentsARAP.Contract.LineOfBusiness,
	FinancialInstrumentsARAP.Contract,
	FinancialInstrumentsARAP.AmountType,
	FinancialInstrumentsARAP.ARAPDocument,
	FinancialInstrumentsARAP.Currency AS ARAPCurrency,
	
	CASE WHEN FinancialInstrumentsARAP.Recorder = UNDEFINED THEN
		NULL
	ELSE
		FinancialInstrumentsARAP.Recorder
	END AS Recorder,
	
	FinancialInstrumentsARAP.SecondPeriod AS SecondPeriod,
	FinancialInstrumentsARAP.DayPeriod AS DayPeriod,
	FinancialInstrumentsARAP.WeekPeriod AS WeekPeriod,
	FinancialInstrumentsARAP.TenDaysPeriod AS TenDaysPeriod,
	FinancialInstrumentsARAP.MonthPeriod AS MonthPeriod,
	FinancialInstrumentsARAP.QuarterPeriod AS QuarterPeriod,
	FinancialInstrumentsARAP.HalfYearPeriod AS HalfYearPeriod,
	FinancialInstrumentsARAP.YearPeriod AS YearPeriod,
	
	FinancialInstrumentsARAP.SumComplOpeningBalance AS DebtOpeningBalance,
	FinancialInstrumentsARAP.SumComplReceipt AS DebtIncrease_,
	FinancialInstrumentsARAP.SumComplExpense AS DebtReduction,
	FinancialInstrumentsARAP.SumComplClosingBalance AS DebtClosingBalance
FROM
	AccumulationRegister.FinancialInstrumentsARAP.BalanceAndTurnovers(,, Auto) AS FinancialInstrumentsARAP
	{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON FinancialInstrumentsARAP.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey}
WHERE
	&amp;SettlementsData = 3
{WHERE
	RegisterAccountingAnalyticsForPartners.Partner IN (
		SELECT SelectionByPartnerSegment.Partner
		FROM SelectionByPartnerSegment
		WHERE SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed),
	CASE
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LoanAndDepositContracts THEN
			CAST(FinancialInstrumentsARAP.Contract AS Catalog.LoanAndDepositContracts).ContractKind
		WHEN FinancialInstrumentsARAP.Contract REFS Catalog.LeaseContract THEN
			VALUE(Enum.ContractKindsOfFinancialInstruments.Lease)
	END IN (&amp;FinancialInstrument)}</query>
	</dataSet>
	<totalField>
		<dataPath>DebtOpeningBalance</dataPath>
		<expression>Case When
    &amp;SettlementsData = 1 And Count(Distinct ARAPCurrency) &gt; 1
        Then 0
    Else Sum(DebtOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtIncrease_</dataPath>
		<expression>Case When
    &amp;SettlementsData = 1 And Count(Distinct ARAPCurrency) &gt; 1
        Then 0
    Else Sum(DebtIncrease_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtReduction</dataPath>
		<expression>Case When
    &amp;SettlementsData = 1 And Count(Distinct ARAPCurrency) &gt; 1
        Then 0
    Else Sum(DebtReduction)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtClosingBalance</dataPath>
		<expression>Case When
    &amp;SettlementsData = 1 And Count(Distinct ARAPCurrency) &gt; 1
        Then 0
    Else Sum(DebtClosingBalance)
End</expression>
	</totalField>
