		<dataSource>DataSource1</dataSource>
		<query>SELECT
	FALSE AS DebitCredit,
	0 AS CorrespondenceNumber,
	VALUE(Catalog.FinancialAccountingChartsOfAccounts.EmptyRef) AS ChartOfAccounts,
	VALUE(Catalog.FinancialAccountingPostingGenerationSetting.EmptyRef) AS PostingGenerationSetting,
	DATETIME(0001, 01, 01) AS Period,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	UNDEFINED AS Recorder,
	VALUE(Enum.StatusesOfPostingsInFinancialAccounting.EmptyRef) AS ReflectionStatus,
	"" AS FinRecordID,
	UNDEFINED AS CorrespondenceKey,
	VALUE(ChartOfAccounts.International.EmptyRef) AS GLAccount,
	FALSE AS LongTerm,
	"" AS RegisterName,
	VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef) AS AccountingObject,
	UNDEFINED AS SettingObject1,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	0 AS SumMan,
	0 AS SumCompl,
	0 AS SumCurr,
	0 AS Count,
	0 AS ServiceAmountOfManDr,
	0 AS ServiceAmountOfManCr,
	0 AS ServiceAmountLocalDr,
	0 AS ServiceAmountOfLocalCr,
	FALSE AS AccountIDNotFilledIn,
	FALSE AS NoCorrespondence,
	FALSE AS BalanceIsBroken
	</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
