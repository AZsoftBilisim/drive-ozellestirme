		<dataSource>MainDataSource</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUETYPE(StateTable.OrderDocument) AS TypeOfOrder_,
	StateTable.OrderDocument AS ReferenceOrder,
	StateTable.EventDate,
	CASE
		WHEN NOT StateTable.OrderDocument.Posted
			THEN FALSE
		WHEN StateTable.EventDate &lt;&gt; DATETIME(1, 1, 1)
		AND &amp;UpdateDate &gt; StateTable.EventDate
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	StateTable.State AS State,
	StateTable.PayAmount AS PayAmount,
	CASE
		WHEN StateTable.AmountOfDebt &gt; 0
			THEN StateTable.AmountOfDebt
		ELSE 0
	END AS AmountOfClientSDebt,
	CASE
		WHEN StateTable.AmountOfDebt &lt; 0
			THEN -StateTable.AmountOfDebt
		ELSE 0
	END AS AmountOfClientSAdvances,
	StateTable.AmountByShipment AS AmountByShipment,
	StateTable.PayPercentage AS PayPercentage,
	StateTable.DebtPercentage AS DebtPercentage,
	StateTable.OrderShipmentPercentage AS OrderShipmentPercentage
FROM
	InformationRegister.SalesOrderStates AS StateTable
WHERE
	StateTable.OrderDocument IN
		(SELECT
			SelectionOfOrdersByPeriod.ReferenceOrder
		FROM
			SelectionOfOrdersByPeriod AS SelectionOfOrdersByPeriod)
{WHERE
	VALUETYPE(StateTable.OrderDocument) AS TypeOfOrder_,
	StateTable.OrderDocument.* AS ReferenceOrder,
	StateTable.OrderDocument.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
