			</field>
			<dataSource>MainDataSource</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterTable.Period AS Period,
	BEGINOFPERIOD(RegisterTable.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(RegisterTable.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(RegisterTable.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(RegisterTable.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterTable.Period, YEAR) AS YearPeriod,
	BEGINOFPERIOD(RegisterTable.Period, TENDAYS) AS TenDaysPeriod,
	RegisterTable.Recorder AS Recorder,
	VALUETYPE(RegisterTable.ReferenceOrder) AS TypeOfOrder_,
	RegisterTable.ReferenceOrder AS ReferenceOrder,
	RegisterTable.Products AS Products,
	CatalogProducts.UnitOfMeasure AS StorageUnit,
	CatalogProducts.UnitForReports AS UnitForReports,
	CatalogProducts.UnitFactorForReports AS UnitFactorForReports,
	RegisterTable.Characteristic AS Characteristic,
	RegisterTable.RowCode AS RowCode,
	RegisterTable.RowCode = 0 AS ExceedingOrder,
	RegisterTable.Warehouse AS Warehouse,
	RegisterTable.Series AS Series,
	RegisterTable.CancellationReason AS CancellationReason,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN RegisterTable.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN RegisterTable.Count / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS CanceledQuantityTurnover,
	RegisterTable.Count * &amp;QueryTextItemWeight AS CanceledWeight,
	RegisterTable.Count * &amp;QueryTextTheVolumeOfTheItem AS CanceledVolume,
	RegisterTable.Sum AS CancelledAmountTurnover
FROM
	AccumulationRegister.ShipmentAndReturnReferences AS RegisterTable
		INNER JOIN Catalog.Products AS CatalogProducts
		ON RegisterTable.Products = CatalogProducts.Ref
WHERE
	RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Canceled)
	AND CASE
		WHEN &amp;DocumentSelectionOption
			THEN RegisterTable.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
		ELSE RegisterTable.ReferenceOrder IN
		(SELECT
			SelectionOfOrdersByPeriod.ReferenceOrder
		FROM
			SelectionOfOrdersByPeriod AS SelectionOfOrdersByPeriod)
	END
{WHERE
	VALUETYPE(RegisterTable.ReferenceOrder) AS TypeOfOrder_,
	RegisterTable.ReferenceOrder.* AS ReferenceOrder,
	RegisterTable.Products.* AS Products,
	RegisterTable.Characteristic.* AS Characteristic,
	RegisterTable.Warehouse.* AS Warehouse,
	RegisterTable.Series.* AS Series,
	RegisterTable.CancellationReason AS CancellationReason,
	(RegisterTable.Products, RegisterTable.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
	RegisterTable.ReferenceOrder.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}</query>
		</item>
	</dataSet>
