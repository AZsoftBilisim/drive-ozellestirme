					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Stok segmenti</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Phân nhóm mặt hàng</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>MainDataSource</dataSource>
			<query>// Tags are used
SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUETYPE(RevenueAndCost.SalesOrder) AS TypeOfOrder_,
	RevenueAndCost.Period AS Period,
	RevenueAndCost.SalesOrder AS ReferenceOrder,
	RevenueAndCost.Recorder AS Recorder,
	RevenueAndCost.Warehouse AS Warehouse,
	RevenueAndCost.InventoryType AS InventoryType,
	RevenueAndCost.ItemsLocationAttributes.Products AS Products,
	RevenueAndCost.ItemsLocationAttributes.Products.UnitOfMeasure AS StorageUnit,
	RevenueAndCost.ItemsLocationAttributes.Products.UnitForReports AS UnitForReports,
	RevenueAndCost.ItemsLocationAttributes.Characteristic AS Characteristic,
	RevenueAndCost.ItemsLocationAttributes.Series AS Series,
	RevenueAndCost.RevenueAmount AS Revenue,
	RevenueAndCost.RevenueAmountExclVATLocal AS LocalRevenueExcludingVAT,
	RevenueAndCost.RevenueAmountIncludingVATLocal AS RevenueCompl,
	RevenueAndCost.RevenueAmountExcludingVAT AS RevenueExcludingVAT,
	CASE
		WHEN RevenueAndCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN RevenueAndCost.RevenueAmount
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.Cost, 0) AS NUMBER(31, 2))
		ELSE RevenueAndCost.Cost
	END AS Cost_,
	CASE
		WHEN RevenueAndCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN RevenueAndCost.RevenueAmountExcludingVAT
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.CostExcludingVAT, 0) AS NUMBER(31,
				2))
		ELSE RevenueAndCost.CostExcludingVAT
	END AS CostExcludingVAT_,
	CASE
		WHEN RevenueAndCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN RevenueAndCost.RevenueAmountExclVATLocal
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.LocalCost, 0) AS NUMBER(31,
				2))
		ELSE RevenueAndCost.LocalCost
	END AS CostLocal,
	CASE
		WHEN RevenueAndCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN RevenueAndCost.RevenueAmountExcludingVAT
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.CostMan, 0) AS NUMBER(31, 2))
		ELSE RevenueAndCost.CostMan
	END AS ManagementCost,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.AdditionalExpenseCost, 0) AS
				NUMBER(31, 2))
		ELSE RevenueAndCost.AddExpensesForGoods
	END AS AddExpensesForGoods,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.AddExpensesMan, 0) AS NUMBER(31,
				2))
		ELSE RevenueAndCost.AddExpensesMan
	END AS AddExpensesMan,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0) AS
				NUMBER(31, 2))
		ELSE RevenueAndCost.AdditionalExpensesExcludingVAT
	END AS AdditionalExpensesExcludingVAT,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.AddExpensesLocal, 0) AS NUMBER(31,
				2))
		ELSE RevenueAndCost.AddExpensesLocal
	END AS AddExpensesLocal,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.LaborCosts, 0) AS NUMBER(31, 2))
		ELSE RevenueAndCost.LaborCosts
	END AS LaborCosts,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.LaborCostsMan, 0) AS NUMBER(31,
				2))
		ELSE RevenueAndCost.LaborCostsMan
	END AS LaborCostsMan,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.LaborCostsLocal, 0) AS NUMBER(31,
				2))
		ELSE RevenueAndCost.LaborCostsLocal
	END AS LaborCostsLocal,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0) AS
				NUMBER(31, 2))
		ELSE RevenueAndCost.ItemizedFixedCostsIncludingVAT
	END AS ItemizedFixedCostsIncludingVAT,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0)
				AS NUMBER(31, 2))
		ELSE RevenueAndCost.ItemizedFixedCostsExcludingVAT
	END AS ItemizedFixedCostsExcludingVAT,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.ItemizedFixedCostsManag, 0) AS
				NUMBER(31, 2))
		ELSE RevenueAndCost.ItemizedFixedCostsManag
	END AS ItemizedFixedCostsManag,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.ItemizedFixedCostsCompl, 0) AS
				NUMBER(31, 2))
		ELSE RevenueAndCost.ItemizedFixedCostsCompl
	END AS ItemizedFixedCostsCompl,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0) AS
				NUMBER(31, 2))
		ELSE RevenueAndCost.ItemizedVariableCostsIncludingVAT
	END AS ItemizedVariableCostsIncludingVAT,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0)
				AS NUMBER(31, 2))
		ELSE RevenueAndCost.ItemizedVariableCostsExcludingVAT
	END AS ItemizedVariableCostsExcludingVAT,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.ItemizedVariableCostsManag, 0) AS
				NUMBER(31, 2))
		ELSE RevenueAndCost.ItemizedVariableCostsManag
	END AS ItemizedVariableCostsManag,
	CASE
		WHEN ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
			THEN CAST(RevenueAndCost.Count * ISNULL(CostOfProducts.ItemizedVariableCostsCompl, 0) AS
				NUMBER(31, 2))
		ELSE RevenueAndCost.ItemizedVariableCostsCompl
	END AS ItemizedVariableCostsCompl,
	CASE
		WHEN RevenueAndCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN 0
		WHEN
			RevenueAndCost.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
			THEN RevenueAndCost.Cost + RevenueAndCost.AddExpensesForGoods + RevenueAndCost.LaborCosts +
				RevenueAndCost.ItemizedFixedCostsIncludingVAT + RevenueAndCost.ItemizedVariableCostsIncludingVAT
		ELSE 0
	END AS Cost_Preliminary,
	CASE
		WHEN RevenueAndCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN 0
		WHEN
			RevenueAndCost.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
			THEN RevenueAndCost.CostExcludingVAT + RevenueAndCost.AdditionalExpensesExcludingVAT +
				RevenueAndCost.LaborCosts + RevenueAndCost.ItemizedFixedCostsExcludingVAT +
				RevenueAndCost.ItemizedVariableCostsExcludingVAT
		ELSE 0
	END AS PreliminaryCostPriceWithoutVAT,
	CASE
		WHEN RevenueAndCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN 0
		WHEN
			RevenueAndCost.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
			THEN RevenueAndCost.LocalCost + RevenueAndCost.AddExpensesLocal +
				RevenueAndCost.LaborCostsLocal + RevenueAndCost.ItemizedFixedCostsCompl +
				RevenueAndCost.ItemizedVariableCostsCompl
		ELSE 0
	END AS PreLocalCostPrice,
	CASE
		WHEN RevenueAndCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN 0
		WHEN
			RevenueAndCost.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing)
			THEN RevenueAndCost.CostMan + RevenueAndCost.AddExpensesMan +
				RevenueAndCost.LaborCostsMan + RevenueAndCost.ItemizedFixedCostsManag +
				RevenueAndCost.ItemizedVariableCostsManag
		ELSE 0
	END AS CostOfPreliminaryMan,
	RevenueAndCost.SellingExpensesIncludingVAT AS SellingExpensesIncludingVAT,
	RevenueAndCost.SellingExpensesExcludingVAT AS SellingExpensesExcludingVAT,
	RevenueAndCost.SellingExpensesLocal AS SellingExpensesLocal,
	RevenueAndCost.SellingExpensesMan AS SellingExpensesMan,
	RevenueAndCost.ExciseAmountInCurrencyMgmt AS ExciseAmountInCurrencyMgmt,
	RevenueAndCost.ExciseAmountInCurrencyLocal AS ExciseAmountInCurrencyLocal,
	RevenueAndCost.ProvisionForImpairmentLocal AS ProvisionForImpairmentLocal,
	RevenueAndCost.ProvisionForImpairmentMan AS ProvisionForImpairmentMan
INTO SalesTable_
FROM
	AccumulationRegister.RevenueAndCOGS AS RevenueAndCost
		LEFT JOIN Document.InventoryCostCalculation.Companies AS InventoryCostCalculation
		ON BEGINOFPERIOD(RevenueAndCost.Period, MONTH) = BEGINOFPERIOD(InventoryCostCalculation.Ref.Date, MONTH)
		AND RevenueAndCost.AccountingDimensionByPartners.Organization = InventoryCostCalculation.Organization
		AND InventoryCostCalculation.Ref.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
		AND InventoryCostCalculation.Ref.Posted
		LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON RevenueAndCost.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
		AND RevenueAndCost.AccountingDimensionByPartners.Organization = CostOfProducts.Organization
		AND RevenueAndCost.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
		AND CostOfProducts.Period = BEGINOFPERIOD(RevenueAndCost.Period, MONTH)
		AND RevenueAndCost.AccountingSection = CostOfProducts.AccountingSection
		AND ISNULL(InventoryCostCalculation.Ref.PreliminaryCalculation, FALSE)
WHERE
	CASE
		WHEN &amp;DocumentSelectionOption
			THEN RevenueAndCost.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
		ELSE RevenueAndCost.SalesOrder IN
		(SELECT
			SelectionOfOrdersByPeriod.ReferenceOrder
		FROM
			SelectionOfOrdersByPeriod AS SelectionOfOrdersByPeriod)
	END
{WHERE
	VALUETYPE(RevenueAndCost.SalesOrder) AS TypeOfOrder_,
	RevenueAndCost.SalesOrder.* AS ReferenceOrder,
	RevenueAndCost.ItemsLocationAttributes.Products.* AS Products,
	RevenueAndCost.ItemsLocationAttributes.Characteristic.* AS Characteristic,
	RevenueAndCost.Warehouse.* AS Warehouse,
	RevenueAndCost.ItemsLocationAttributes.Series.* AS Series,
	(RevenueAndCost.ItemsLocationAttributes.Products, RevenueAndCost.ItemsLocationAttributes.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
	RevenueAndCost.AccountingDimensionByPartners.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	VALUETYPE(Table.ReferenceOrder) AS TypeOfOrder_,
	Table.Period AS Period,
	Table.ReferenceOrder AS ReferenceOrder,
	Table.Recorder AS Recorder,
	Table.Warehouse AS Warehouse,
	Table.Products AS Products,
	Table.StorageUnit AS StorageUnit,
	Table.UnitForReports AS UnitForReports,
	Table.Characteristic AS Characteristic,
	Table.Series AS Series,
	CASE
		WHEN &amp;ReportData = 4
			THEN SUM(Table.ExciseAmountInCurrencyLocal)
		ELSE SUM(Table.ExciseAmountInCurrencyMgmt)
	END AS ExciseTaxAmount,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.Revenue)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.RevenueExcludingVAT)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.LocalRevenueExcludingVAT)
		ELSE SUM(Table.RevenueExcludingVAT)
	END AS Revenue,
	CASE
		WHEN &amp;ReportData = 4
			THEN SUM(Table.RevenueCompl) - SUM(Table.LocalRevenueExcludingVAT)
		ELSE SUM(Table.Revenue) - SUM(Table.RevenueExcludingVAT)
	END AS VATRevenue,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.Cost_)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.CostExcludingVAT_)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.CostLocal)
		ELSE SUM(Table.CostExcludingVAT_)
	END AS Cost_,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.AddExpensesForGoods)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.AdditionalExpensesExcludingVAT)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.AddExpensesLocal)
		ELSE SUM(Table.AdditionalExpensesExcludingVAT)
	END AS AddExpensesForGoods,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.LaborCosts)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.LaborCosts)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.LaborCostsLocal)
		ELSE SUM(Table.LaborCosts)
	END AS LaborCosts,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.ItemizedFixedCostsIncludingVAT)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.ItemizedFixedCostsExcludingVAT)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.ItemizedFixedCostsCompl)
		ELSE SUM(Table.ItemizedFixedCostsExcludingVAT)
	END AS ItemizedFixed,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.ItemizedVariableCostsIncludingVAT)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.ItemizedVariableCostsExcludingVAT)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.ItemizedVariableCostsCompl)
		ELSE SUM(Table.ItemizedVariableCostsExcludingVAT)
	END AS ItemizedVariable,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.SellingExpensesIncludingVAT)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.SellingExpensesExcludingVAT)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.SellingExpensesLocal)
		ELSE SUM(Table.SellingExpensesExcludingVAT)
	END AS SellingExpenses_,
	CASE
		WHEN &amp;ReportData = 1
			THEN 0
		WHEN &amp;ReportData = 2
			THEN 0
		WHEN &amp;ReportData = 4
			THEN SUM(Table.ProvisionForImpairmentLocal)
		ELSE 0
	END AS ProvisionForImpairment,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.Cost_Preliminary)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.PreliminaryCostPriceWithoutVAT)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.PreLocalCostPrice)
		ELSE SUM(Table.PreliminaryCostPriceWithoutVAT)
	END AS Cost_Preliminary,
	CASE
		WHEN &amp;ReportData = 1
			THEN SUM(Table.Cost_) + SUM(Table.AddExpensesForGoods) + SUM(Table.LaborCosts) +
				SUM(Table.ItemizedFixedCostsIncludingVAT) + SUM(Table.ItemizedVariableCostsIncludingVAT) -
				SUM(Table.Cost_Preliminary)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.CostExcludingVAT_) + SUM(Table.AdditionalExpensesExcludingVAT) + SUM(Table.LaborCosts) +
				SUM(Table.ItemizedFixedCostsExcludingVAT) + SUM(Table.ItemizedVariableCostsExcludingVAT) -
				SUM(Table.PreliminaryCostPriceWithoutVAT)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.CostLocal) + SUM(Table.AddExpensesLocal) + SUM(Table.LaborCostsLocal) +
				SUM(Table.ItemizedFixedCostsCompl) + SUM(Table.ItemizedVariableCostsCompl) +
				SUM(Table.ProvisionForImpairmentLocal) - SUM(Table.PreLocalCostPrice)
		ELSE SUM(Table.CostExcludingVAT_) + SUM(Table.AdditionalExpensesExcludingVAT) + SUM(Table.LaborCosts) +
			SUM(Table.ItemizedFixedCostsExcludingVAT) + SUM(Table.ItemizedVariableCostsExcludingVAT) -
			SUM(Table.PreliminaryCostPriceWithoutVAT)
	END AS CostDeviation_,
	CASE
		WHEN Table.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN 0
		WHEN &amp;ReportData = 1
			THEN SUM(Table.Revenue) - SUM(Table.Cost_) - SUM(Table.AddExpensesForGoods) -
				SUM(Table.LaborCosts) - SUM(Table.ItemizedFixedCostsIncludingVAT) - SUM(Table.ItemizedVariableCostsIncludingVAT)
				- SUM(Table.SellingExpensesIncludingVAT)
				- SUM(Table.ExciseAmountInCurrencyMgmt)
		WHEN &amp;ReportData = 2
			THEN SUM(Table.RevenueExcludingVAT) - SUM(Table.CostExcludingVAT_) - SUM(Table.AdditionalExpensesExcludingVAT) -
				SUM(Table.LaborCosts) - SUM(Table.ItemizedFixedCostsExcludingVAT) -
				SUM(Table.ItemizedVariableCostsExcludingVAT) - SUM(Table.SellingExpensesExcludingVAT)
				- SUM(Table.ExciseAmountInCurrencyMgmt)
		WHEN &amp;ReportData = 4
			THEN SUM(Table.LocalRevenueExcludingVAT) - SUM(Table.CostLocal) - SUM(Table.AddExpensesLocal) -
				SUM(Table.LaborCostsLocal) - SUM(Table.ItemizedFixedCostsCompl) -
				SUM(Table.ItemizedVariableCostsCompl) - SUM(Table.SellingExpensesLocal) -
				SUM(Table.ProvisionForImpairmentLocal)
				- SUM(Table.ExciseAmountInCurrencyLocal)
		ELSE SUM(Table.RevenueExcludingVAT) - SUM(Table.CostExcludingVAT_) - SUM(Table.AdditionalExpensesExcludingVAT) -
			SUM(Table.LaborCosts) - SUM(Table.ItemizedFixedCostsExcludingVAT) -
			SUM(Table.ItemizedVariableCostsExcludingVAT) - SUM(Table.SellingExpensesExcludingVAT)
			- SUM(Table.ExciseAmountInCurrencyMgmt)
	END AS GrossProfit,
	CASE
		WHEN Table.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN 0
		WHEN &amp;ReportData = 1
			THEN CAST(CASE
				WHEN SUM(Table.Revenue) &lt;&gt; 0
					THEN (SUM(Table.Revenue) - SUM(Table.Cost_) - SUM(Table.AddExpensesForGoods) -
						SUM(Table.LaborCosts) - SUM(Table.ItemizedFixedCostsIncludingVAT) -
						SUM(Table.ItemizedVariableCostsIncludingVAT) - SUM(Table.SellingExpensesIncludingVAT)
						- SUM(Table.ExciseAmountInCurrencyMgmt)
						- 0) / CASE
						WHEN SUM(Table.Revenue) &gt; 0
							THEN SUM(Table.Revenue)
						ELSE -1 * SUM(Table.Revenue)
					END
				ELSE 0
			END * 100 AS NUMBER(31, 2))
		WHEN &amp;ReportData = 2
			THEN CAST(CASE
				WHEN SUM(Table.RevenueExcludingVAT) &lt;&gt; 0
					THEN (SUM(Table.RevenueExcludingVAT) - SUM(Table.CostExcludingVAT_) - SUM(Table.AdditionalExpensesExcludingVAT) -
						SUM(Table.LaborCosts) - SUM(Table.ItemizedFixedCostsExcludingVAT) -
						SUM(Table.ItemizedVariableCostsExcludingVAT) - SUM(Table.SellingExpensesExcludingVAT)
						- SUM(Table.ExciseAmountInCurrencyMgmt)
						- 0) / CASE
						WHEN SUM(Table.RevenueExcludingVAT) &gt; 0
							THEN SUM(Table.RevenueExcludingVAT)
						ELSE -1 * SUM(Table.RevenueExcludingVAT)
					END
				ELSE 0
			END * 100 AS NUMBER(31, 2))
		WHEN &amp;ReportData = 4
			THEN CAST(CASE
				WHEN SUM(Table.LocalRevenueExcludingVAT) &lt;&gt; 0
					THEN (SUM(Table.LocalRevenueExcludingVAT) - SUM(Table.CostLocal) - SUM(Table.AddExpensesLocal) -
						SUM(Table.LaborCostsLocal) - SUM(Table.ItemizedFixedCostsCompl) -
						SUM(Table.ItemizedVariableCostsCompl) - SUM(Table.SellingExpensesLocal) -
						SUM(Table.ProvisionForImpairmentLocal)
						- SUM(Table.ExciseAmountInCurrencyLocal)
						- 0) / CASE
						WHEN SUM(Table.LocalRevenueExcludingVAT) &gt; 0
							THEN SUM(Table.LocalRevenueExcludingVAT)
						ELSE -1 * SUM(Table.LocalRevenueExcludingVAT)
					END
				ELSE 0
			END * 100 AS NUMBER(31, 2))
		ELSE CAST(CASE
			WHEN SUM(Table.RevenueExcludingVAT) &lt;&gt; 0
				THEN (SUM(Table.RevenueExcludingVAT) - SUM(Table.CostExcludingVAT_) - SUM(Table.AdditionalExpensesExcludingVAT) -
					SUM(Table.LaborCosts) - SUM(Table.ItemizedFixedCostsExcludingVAT) -
					SUM(Table.ItemizedVariableCostsExcludingVAT) - SUM(Table.SellingExpensesExcludingVAT)
					- SUM(Table.ExciseAmountInCurrencyMgmt)
					- 0) / CASE
					WHEN SUM(Table.RevenueExcludingVAT) &gt; 0
						THEN SUM(Table.RevenueExcludingVAT)
					ELSE -1 * SUM(Table.RevenueExcludingVAT)
				END
			ELSE 0
		END * 100 AS NUMBER(31, 2))
	END AS Profitability
FROM
	SalesTable_ AS Table
GROUP BY
	Table.Period,
	Table.ReferenceOrder,
	Table.Recorder,
	Table.Warehouse,
	Table.InventoryType,
	Table.Products,
	Table.StorageUnit,
	Table.UnitForReports,
	Table.Characteristic,
	Table.Series,
	VALUETYPE(Table.ReferenceOrder)</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>GoodsForIssue</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>MonthPeriod</dataPath>
				<field>MonthPeriod</field>
				<role>
					<dcscom:periodNumber>6</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>DayPeriod</dataPath>
				<field>DayPeriod</field>
				<role>
					<dcscom:periodNumber>3</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>TypeOfOrder_</dataPath>
				<field>TypeOfOrder_</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Reference type</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>نوع مرجع</v8:content>
