			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.Partners</v8:Type>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ItRemainsToShipQuantity</dataPath>
		<expression>QuantityToBeShippedTurnover - ShippedQuantityTurnover</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Left to ship (quantity)</v8:content>
			</v8:item>
