		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>Partner</dataPath>
		<expression>ReferenceOrder.Partner</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Partner</v8:content>
			</v8:item>
