			<field xsi:type="DataSetFieldField">
				<dataPath>Factor</dataPath>
				<field>Factor</field>
			</field>
			<dataSource>MainDataSource</dataSource>
			<query>// Tags are used
SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TurnoversByOrders.SecondPeriod AS Period,
	TurnoversByOrders.DayPeriod AS DayPeriod,
	TurnoversByOrders.WeekPeriod AS WeekPeriod,
	TurnoversByOrders.MonthPeriod AS MonthPeriod,
	TurnoversByOrders.HalfYearPeriod AS HalfYearPeriod,
	TurnoversByOrders.YearPeriod AS YearPeriod,
	TurnoversByOrders.TenDaysPeriod AS TenDaysPeriod,
	TurnoversByOrders.Recorder AS Recorder,
	TurnoversByOrders.ReferenceOrder AS ReferenceOrder,
	TurnoversByOrders.Products AS Products,
	TurnoversByOrders.Characteristic AS Characteristic,
	TurnoversByOrders.RowCode AS RowCode,
	TurnoversByOrders.RowCode = 0 AS ExceedingOrder,
	TurnoversByOrders.Warehouse AS Warehouse,
	TurnoversByOrders.Series AS Series,
	TurnoversByOrders.OrderedQuantityTurnover AS OrderedQuantityTurnover,
	TurnoversByOrders.Ordered_AmountTurnover AS Ordered_AmountTurnover,
	TurnoversByOrders.ForRegistrationQuantityTurnover AS ForRegistrationQuantityTurnover,
	TurnoversByOrders.AmountToBeProcessedTurnover AS AmountToBeProcessedTurnover,
	TurnoversByOrders.IssuedQuantityTurnover AS IssuedQuantityTurnover,
	TurnoversByOrders.IssuedAmountTurnover AS IssuedAmountTurnover,
	TurnoversByOrders.QuantityToBeShippedTurnover AS QuantityToBeShippedTurnover,
	TurnoversByOrders.AmountToBeShippedTurnover AS AmountToBeShippedTurnover,
	TurnoversByOrders.ShippedQuantityTurnover AS ShippedQuantityTurnover,
	TurnoversByOrders.ShippedAmountTurnover AS ShippedAmountTurnover,
	TurnoversByOrders.QuantityRequestedForReturnTurnover AS QuantityRequestedForReturnTurnover,
	TurnoversByOrders.AmountRequestedForReturnTurnover AS AmountRequestedForReturnTurnover,
	TurnoversByOrders.ForRegistrationOnReturnsQuantityTurnover AS ForRegistrationOnReturnsQuantityTurnover,
	TurnoversByOrders.AmountToBeProcessedForReturnsTurnover AS AmountToBeProcessedForReturnsTurnover,
	TurnoversByOrders.IssuedByReturnsQuantityTurnover AS IssuedByReturnsQuantityTurnover,
	TurnoversByOrders.IssuedByReturnsAmountTurnover AS IssuedByReturnsAmountTurnover,
	TurnoversByOrders.QuantityReadyForAcceptanceTurnover AS QuantityReadyForAcceptanceTurnover,
	TurnoversByOrders.AmountToBeAcceptedTurnover AS AmountToBeAcceptedTurnover,
	TurnoversByOrders.AcceptedOnReturnsQuantityTurnover AS AcceptedOnReturnsQuantityTurnover,
	TurnoversByOrders.AcceptedForReturnsAmountTurnover AS AcceptedForReturnsAmountTurnover,
	TurnoversByOrders.ShippedQuantityTurnover - TurnoversByOrders.IssuedQuantityTurnover -
		TurnoversByOrders.QuantityAccepted_Turnover - TurnoversByOrders.DeductedToPPPQuantityTurnover +
		TurnoversByOrders.RegisteredUpToPPPQuantityTurnover AS InTransitNumberOfTurnover,
	TurnoversByOrders.ShippedAmountTurnover - TurnoversByOrders.IssuedAmountTurnover -
		TurnoversByOrders.AcceptedAmountTurnover - TurnoversByOrders.DebitedToPPPAmountTurnover +
		TurnoversByOrders.RegisteredUpToPPPAmountTurnover AS EnRouteAmountOfTurnover
INTO TT_ShippingOrdersTurnover
FROM
	(SELECT
		RegisterTable.SecondPeriod AS SecondPeriod,
		RegisterTable.DayPeriod AS DayPeriod,
		RegisterTable.WeekPeriod AS WeekPeriod,
		RegisterTable.MonthPeriod AS MonthPeriod,
		RegisterTable.HalfYearPeriod AS HalfYearPeriod,
		RegisterTable.YearPeriod AS YearPeriod,
		RegisterTable.TenDaysPeriod AS TenDaysPeriod,
		RegisterTable.Recorder AS Recorder,
		RegisterTable.ReferenceOrder AS ReferenceOrder,
		RegisterTable.Products AS Products,
		RegisterTable.Characteristic AS Characteristic,
		RegisterTable.RowCode AS RowCode,
		RegisterTable.Warehouse AS Warehouse,
		RegisterTable.Series AS Series,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS OrderedQuantityTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS Ordered_AmountTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS ForRegistrationQuantityTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS AmountToBeProcessedTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS IssuedQuantityTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS IssuedAmountTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS QuantityToBeShippedTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS AmountToBeShippedTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS ShippedQuantityTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS ShippedAmountTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.TaxInvoicesRegistered)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS IssuedInvoicesQuantityTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.TaxInvoicesRegistered)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS IssuedInvoicesAmountTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ReceivedBeforeTransferOfTitleToGoods)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS RegisteredUpToPPPQuantityTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ReceivedBeforeTransferOfTitleToGoods)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS RegisteredUpToPPPAmountTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WrittenOffBeforeTransferOfTitleToGoods)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS DeductedToPPPQuantityTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WrittenOffBeforeTransferOfTitleToGoods)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS DebitedToPPPAmountTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RequestedForReturn)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS QuantityRequestedForReturnTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RequestedForReturn)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS AmountRequestedForReturnTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegisterForReturns)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS ForRegistrationOnReturnsQuantityTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegisterForReturns)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS AmountToBeProcessedForReturnsTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RegisteredOnReturns)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS IssuedByReturnsQuantityTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RegisteredOnReturns)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS IssuedByReturnsAmountTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ForReceiving)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS QuantityReadyForAcceptanceTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ForReceiving)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS AmountToBeAcceptedTurnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Accepted)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS QuantityAccepted_Turnover,
		SUM(CASE
			WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Accepted)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS AcceptedAmountTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.AcceptedOnReturns)
				THEN RegisterTable.CountTurnover
			ELSE 0
		END) AS AcceptedOnReturnsQuantityTurnover,
		SUM(CASE
			WHEN
				RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.AcceptedOnReturns)
				THEN RegisterTable.SumTurnover
			ELSE 0
		END) AS AcceptedForReturnsAmountTurnover
	FROM
		AccumulationRegister.ShipmentAndReturnReferences.Turnovers(,, Auto,
			CASE
				WHEN &amp;DocumentSelectionOption
					THEN TRUE
				ELSE ReferenceOrder IN
				(SELECT
					SelectionOfOrdersByPeriod.ReferenceOrder
				FROM
					SelectionOfOrdersByPeriod AS SelectionOfOrdersByPeriod)
			END
		AND Factor IN (VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.TaxInvoicesRegistered),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ReceivedBeforeTransferOfTitleToGoods),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WrittenOffBeforeTransferOfTitleToGoods),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RequestedForReturn),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegisterForReturns),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RegisteredOnReturns),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ForReceiving),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Accepted),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.AcceptedOnReturns)) {VALUETYPE(ReferenceOrder) AS
			TypeOfOrder_} {ReferenceOrder.* AS ReferenceOrder} {Products.* AS Products} {Characteristic.* AS
			Characteristic} {Warehouse.* AS Warehouse} {Series.* AS Series}
			{(Products, Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			{ReferenceOrder.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}) AS
			RegisterTable
	GROUP BY
		RegisterTable.SecondPeriod,
		RegisterTable.DayPeriod,
		RegisterTable.WeekPeriod,
		RegisterTable.MonthPeriod,
		RegisterTable.HalfYearPeriod,
		RegisterTable.YearPeriod,
		RegisterTable.TenDaysPeriod,
		RegisterTable.Recorder,
		RegisterTable.ReferenceOrder,
		RegisterTable.Products,
		RegisterTable.Characteristic,
		RegisterTable.RowCode,
		RegisterTable.Warehouse,
		RegisterTable.Series) AS TurnoversByOrders

INDEX BY
	Recorder,
	ReferenceOrder,
	Products,
	Characteristic,
	RowCode,
	Warehouse,
	Series
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableOfRevolutions.ReferenceOrder AS ReferenceOrder,
	TableOfRevolutions.RowCode AS RowCode,
	MAX(TableOfRevolutions.Warehouse) AS Warehouse,
	MAX(TableOfRevolutions.Series) AS Series
INTO TableSeriesWarehouses
FROM
	TT_ShippingOrdersTurnover AS TableOfRevolutions
GROUP BY
	TableOfRevolutions.ReferenceOrder,
	TableOfRevolutions.RowCode

INDEX BY
	ReferenceOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUETYPE(TurnoversByOrders.ReferenceOrder) AS TypeOfOrder_,
	TurnoversByOrders.Period AS Period,
	TurnoversByOrders.DayPeriod AS DayPeriod,
	TurnoversByOrders.WeekPeriod AS WeekPeriod,
	TurnoversByOrders.MonthPeriod AS MonthPeriod,
	TurnoversByOrders.HalfYearPeriod AS HalfYearPeriod,
	TurnoversByOrders.YearPeriod AS YearPeriod,
	TurnoversByOrders.TenDaysPeriod AS TenDaysPeriod,
	TurnoversByOrders.Recorder AS Recorder,
	TurnoversByOrders.ReferenceOrder AS ReferenceOrder,
	TurnoversByOrders.Products AS Products,
	CatalogProducts.UnitOfMeasure AS StorageUnit,
	CatalogProducts.UnitForReports AS UnitForReports,
	TurnoversByOrders.Characteristic AS Characteristic,
	TurnoversByOrders.RowCode AS RowCode,
	TurnoversByOrders.ExceedingOrder AS ExceedingOrder,
	CASE
		WHEN TurnoversByOrders.Warehouse = VALUE(Catalog.Warehouses.EmptyRef)
			THEN ISNULL(TableSeriesWarehouses.Warehouse, VALUE(Catalog.Warehouses.EmptyRef))
		ELSE TurnoversByOrders.Warehouse
	END AS Warehouse,
	CASE
		WHEN TurnoversByOrders.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
			THEN ISNULL(TableSeriesWarehouses.Series, VALUE(Catalog.ItemsBatches.EmptyRef))
		ELSE TurnoversByOrders.Series
	END AS Series,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.OrderedQuantityTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.OrderedQuantityTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS OrderedQuantityTurnover,
	TurnoversByOrders.OrderedQuantityTurnover * &amp;QueryTextItemWeight AS OrderedWeight,
	TurnoversByOrders.OrderedQuantityTurnover * &amp;QueryTextTheVolumeOfTheItem AS OrderedAmount,
	TurnoversByOrders.Ordered_AmountTurnover AS Ordered_AmountTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.ForRegistrationQuantityTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.ForRegistrationQuantityTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS ForRegistrationQuantityTurnover,
	TurnoversByOrders.ForRegistrationQuantityTurnover * &amp;QueryTextItemWeight AS ToDesignWeight,
	TurnoversByOrders.ForRegistrationQuantityTurnover * &amp;QueryTextTheVolumeOfTheItem AS ToDesignVolume,
	TurnoversByOrders.AmountToBeProcessedTurnover AS AmountToBeProcessedTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.IssuedQuantityTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.IssuedQuantityTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS IssuedQuantityTurnover,
	TurnoversByOrders.IssuedQuantityTurnover * &amp;QueryTextItemWeight AS IssuedWeight,
	TurnoversByOrders.IssuedQuantityTurnover * &amp;QueryTextTheVolumeOfTheItem AS IssuedVolume,
	TurnoversByOrders.IssuedAmountTurnover AS IssuedAmountTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.QuantityToBeShippedTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.QuantityToBeShippedTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS QuantityToBeShippedTurnover,
	TurnoversByOrders.QuantityToBeShippedTurnover * &amp;QueryTextItemWeight AS ToShipmentWeight,
	TurnoversByOrders.QuantityToBeShippedTurnover * &amp;QueryTextTheVolumeOfTheItem AS ForShipmentVolume,
	TurnoversByOrders.AmountToBeShippedTurnover AS AmountToBeShippedTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.ShippedQuantityTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.ShippedQuantityTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS ShippedQuantityTurnover,
	TurnoversByOrders.ShippedQuantityTurnover * &amp;QueryTextItemWeight AS ShippedWeight_,
	TurnoversByOrders.ShippedQuantityTurnover * &amp;QueryTextTheVolumeOfTheItem AS ShippedVolume,
	TurnoversByOrders.ShippedAmountTurnover AS ShippedAmountTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.QuantityRequestedForReturnTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.QuantityRequestedForReturnTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS QuantityRequestedForReturnTurnover,
	TurnoversByOrders.QuantityRequestedForReturnTurnover * &amp;QueryTextItemWeight AS DeclaredForReturnWeight,
	TurnoversByOrders.QuantityRequestedForReturnTurnover * &amp;QueryTextTheVolumeOfTheItem AS VolumeReturnedHasBeenRequested,
	TurnoversByOrders.AmountRequestedForReturnTurnover AS AmountRequestedForReturnTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.ForRegistrationOnReturnsQuantityTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.ForRegistrationOnReturnsQuantityTurnover /
						CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS ForRegistrationOnReturnsQuantityTurnover,
	TurnoversByOrders.ForRegistrationOnReturnsQuantityTurnover * &amp;QueryTextItemWeight AS
		ForRegistrationOnReturnsWeight,
	TurnoversByOrders.ForRegistrationOnReturnsQuantityTurnover * &amp;QueryTextTheVolumeOfTheItem AS
		ToBeProcessedForReturnsVolume,
	TurnoversByOrders.AmountToBeProcessedForReturnsTurnover AS AmountToBeProcessedForReturnsTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.IssuedByReturnsQuantityTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.IssuedByReturnsQuantityTurnover /
						CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS IssuedByReturnsQuantityTurnover,
	TurnoversByOrders.IssuedByReturnsQuantityTurnover * &amp;QueryTextItemWeight AS IssuedOnReturnsWeight,
	TurnoversByOrders.IssuedByReturnsQuantityTurnover * &amp;QueryTextTheVolumeOfTheItem AS
		IssuedOnReturnsVolume,
	TurnoversByOrders.IssuedByReturnsAmountTurnover AS IssuedByReturnsAmountTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.QuantityReadyForAcceptanceTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.QuantityReadyForAcceptanceTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS QuantityReadyForAcceptanceTurnover,
	TurnoversByOrders.QuantityReadyForAcceptanceTurnover * &amp;QueryTextItemWeight AS ForAcceptanceWeight,
	TurnoversByOrders.QuantityReadyForAcceptanceTurnover * &amp;QueryTextTheVolumeOfTheItem AS VolumeToBeAccepted,
	TurnoversByOrders.AmountToBeAcceptedTurnover AS AmountToBeAcceptedTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.AcceptedOnReturnsQuantityTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.AcceptedOnReturnsQuantityTurnover /
						CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS AcceptedOnReturnsQuantityTurnover,
	TurnoversByOrders.AcceptedOnReturnsQuantityTurnover * &amp;QueryTextItemWeight AS AcceptedForReturnsWeight,
	TurnoversByOrders.AcceptedOnReturnsQuantityTurnover * &amp;QueryTextTheVolumeOfTheItem AS AcceptedForVolumeReturns,
	TurnoversByOrders.AcceptedForReturnsAmountTurnover AS AcceptedForReturnsAmountTurnover,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TurnoversByOrders.InTransitNumberOfTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TurnoversByOrders.InTransitNumberOfTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS InTransitNumberOfTurnover,
	&amp;QueryTextItemWeight * TurnoversByOrders.InTransitNumberOfTurnover AS InWayOfWeight,
	&amp;QueryTextTheVolumeOfTheItem * TurnoversByOrders.InTransitNumberOfTurnover AS EnRouteVolume,
	TurnoversByOrders.EnRouteAmountOfTurnover AS EnRouteAmountOfTurnover
INTO OrdersGrouping
FROM
	TT_ShippingOrdersTurnover AS TurnoversByOrders
		LEFT JOIN TableSeriesWarehouses AS TableSeriesWarehouses
		ON TurnoversByOrders.ReferenceOrder = TableSeriesWarehouses.ReferenceOrder
		AND TurnoversByOrders.RowCode = TableSeriesWarehouses.RowCode
		INNER JOIN Catalog.Products AS CatalogProducts
		ON TurnoversByOrders.Products = CatalogProducts.Ref
{WHERE
	VALUETYPE(TurnoversByOrders.ReferenceOrder) AS TypeOfOrder_}

INDEX BY
	Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	OrdersGrouping.TypeOfOrder_ AS TypeOfOrder_,
	OrdersGrouping.Period AS Period,
	OrdersGrouping.DayPeriod AS DayPeriod,
	OrdersGrouping.WeekPeriod AS WeekPeriod,
	OrdersGrouping.MonthPeriod AS MonthPeriod,
	OrdersGrouping.HalfYearPeriod AS HalfYearPeriod,
	OrdersGrouping.YearPeriod AS YearPeriod,
	OrdersGrouping.TenDaysPeriod AS TenDaysPeriod,
	OrdersGrouping.Recorder AS Recorder,
	OrdersGrouping.ReferenceOrder AS ReferenceOrder,
	OrdersGrouping.Products AS Products,
	OrdersGrouping.StorageUnit AS StorageUnit,
	OrdersGrouping.UnitForReports AS UnitForReports,
	OrdersGrouping.Characteristic AS Characteristic,
	OrdersGrouping.RowCode AS RowCode,
	OrdersGrouping.ExceedingOrder AS ExceedingOrder,
	OrdersGrouping.Warehouse AS Warehouse,
	OrdersGrouping.Series AS Series,
	OrdersGrouping.OrderedQuantityTurnover AS OrderedQuantityTurnover,
	OrdersGrouping.OrderedWeight AS OrderedWeight,
	OrdersGrouping.OrderedAmount AS OrderedAmount,
	OrdersGrouping.Ordered_AmountTurnover AS Ordered_AmountTurnover,
	OrdersGrouping.ForRegistrationQuantityTurnover AS ForRegistrationQuantityTurnover,
	OrdersGrouping.ToDesignWeight AS ToDesignWeight,
	OrdersGrouping.ToDesignVolume AS ToDesignVolume,
	OrdersGrouping.AmountToBeProcessedTurnover AS AmountToBeProcessedTurnover,
	OrdersGrouping.IssuedQuantityTurnover AS IssuedQuantityTurnover,
	OrdersGrouping.IssuedWeight AS IssuedWeight,
	OrdersGrouping.IssuedVolume AS IssuedVolume,
	OrdersGrouping.IssuedAmountTurnover AS IssuedAmountTurnover,
	OrdersGrouping.QuantityToBeShippedTurnover AS QuantityToBeShippedTurnover,
	OrdersGrouping.ToShipmentWeight AS ToShipmentWeight,
	OrdersGrouping.ForShipmentVolume AS ForShipmentVolume,
	OrdersGrouping.AmountToBeShippedTurnover AS AmountToBeShippedTurnover,
	OrdersGrouping.ShippedQuantityTurnover AS ShippedQuantityTurnover,
	OrdersGrouping.ShippedWeight_ AS ShippedWeight_,
	OrdersGrouping.ShippedVolume AS ShippedVolume,
	OrdersGrouping.ShippedAmountTurnover AS ShippedAmountTurnover,
	OrdersGrouping.QuantityRequestedForReturnTurnover AS QuantityRequestedForReturnTurnover,
	OrdersGrouping.DeclaredForReturnWeight AS DeclaredForReturnWeight,
	OrdersGrouping.VolumeReturnedHasBeenRequested AS VolumeReturnedHasBeenRequested,
	OrdersGrouping.AmountRequestedForReturnTurnover AS AmountRequestedForReturnTurnover,
	OrdersGrouping.ForRegistrationOnReturnsQuantityTurnover AS ForRegistrationOnReturnsQuantityTurnover,
	OrdersGrouping.ForRegistrationOnReturnsWeight AS ForRegistrationOnReturnsWeight,
	OrdersGrouping.ToBeProcessedForReturnsVolume AS ToBeProcessedForReturnsVolume,
	OrdersGrouping.AmountToBeProcessedForReturnsTurnover AS AmountToBeProcessedForReturnsTurnover,
	OrdersGrouping.IssuedByReturnsQuantityTurnover AS IssuedByReturnsQuantityTurnover,
	OrdersGrouping.IssuedOnReturnsWeight AS IssuedOnReturnsWeight,
	OrdersGrouping.IssuedOnReturnsVolume AS IssuedOnReturnsVolume,
	OrdersGrouping.IssuedByReturnsAmountTurnover AS IssuedByReturnsAmountTurnover,
	OrdersGrouping.QuantityReadyForAcceptanceTurnover AS QuantityReadyForAcceptanceTurnover,
	OrdersGrouping.ForAcceptanceWeight AS ForAcceptanceWeight,
	OrdersGrouping.VolumeToBeAccepted AS VolumeToBeAccepted,
	OrdersGrouping.AmountToBeAcceptedTurnover AS AmountToBeAcceptedTurnover,
	OrdersGrouping.AcceptedOnReturnsQuantityTurnover AS AcceptedOnReturnsQuantityTurnover,
	OrdersGrouping.AcceptedForReturnsWeight AS AcceptedForReturnsWeight,
	OrdersGrouping.AcceptedForVolumeReturns AS AcceptedForVolumeReturns,
	OrdersGrouping.AcceptedForReturnsAmountTurnover AS AcceptedForReturnsAmountTurnover,
	OrdersGrouping.InTransitNumberOfTurnover AS InTransitNumberOfTurnover,
	OrdersGrouping.InWayOfWeight AS InWayOfWeight,
	OrdersGrouping.EnRouteVolume AS EnRouteVolume,
	OrdersGrouping.EnRouteAmountOfTurnover AS EnRouteAmountOfTurnover
FROM
	OrdersGrouping AS OrdersGrouping

</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>InventoryAllocation</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>ReferenceOrder</dataPath>
				<field>ReferenceOrder</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Reference</v8:content>
					</v8:item>
