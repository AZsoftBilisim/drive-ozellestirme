					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Sağlandı</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Đã đảm bảo</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>NotSupplied</dataPath>
				<field>NotSupplied</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Not supplied</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>تأمین‌نشده</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Non approvvigionato</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Nie zapełniono</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Не обеспечено</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Sağlanmadı</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Không đảm bảo</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>MainDataSource</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUETYPE(TableInventoryAllocation.ShipmentOrder) AS TypeOfOrder_,
	TableInventoryAllocation.ShipmentOrder.Date AS Period,
	TableInventoryAllocation.ShipmentOrder AS Recorder,
	TableInventoryAllocation.ShipmentOrder AS ReferenceOrder,
	TableInventoryAllocation.Products AS Products,
	TableInventoryAllocation.Products.UnitOfMeasure AS StorageUnit,
	TableInventoryAllocation.Products.UnitForReports AS UnitForReports,
	TableInventoryAllocation.Characteristic AS Characteristic,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	TableInventoryAllocation.Warehouse AS Warehouse,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN
				CASE
					WHEN TableInventoryAllocation.DemandCharacteristic IN(
							VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
							VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked))
						THEN TableInventoryAllocation.Count
					ELSE 0
				END
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableInventoryAllocation.Products.UnitFactorForReports &lt;&gt; 0
					THEN
						CASE
							WHEN TableInventoryAllocation.DemandCharacteristic IN(
									VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
									VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked))
								THEN TableInventoryAllocation.Count
							ELSE 0
						END / TableInventoryAllocation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS ReserveAsReceived,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN
				CASE
					WHEN TableInventoryAllocation.DemandCharacteristic =
							VALUE(Enum.DemandCharacteristics.ToSupply)
						THEN TableInventoryAllocation.Count
					ELSE 0
				END
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableInventoryAllocation.Products.UnitFactorForReports &lt;&gt; 0
					THEN
						CASE
							WHEN TableInventoryAllocation.DemandCharacteristic =
									VALUE(Enum.DemandCharacteristics.ToSupply)
								THEN TableInventoryAllocation.Count
							ELSE 0
						END / TableInventoryAllocation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS ToSupplyWithoutReserve,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN
				CASE
					WHEN TableInventoryAllocation.DemandCharacteristic =
							VALUE(Enum.DemandCharacteristics.SnoozeReservation)
						THEN TableInventoryAllocation.Count
					ELSE 0
				END
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableInventoryAllocation.Products.UnitFactorForReports &lt;&gt; 0
					THEN
						CASE
							WHEN TableInventoryAllocation.DemandCharacteristic =
									VALUE(Enum.DemandCharacteristics.SnoozeReservation)
								THEN TableInventoryAllocation.Count
							ELSE 0
						END / TableInventoryAllocation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS SnoozeReservation,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN
				CASE
					WHEN TableInventoryAllocation.DemandCharacteristic IN(
							VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
							VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked))
						THEN TableInventoryAllocation.Count
					ELSE 0
				END
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableInventoryAllocation.Products.UnitFactorForReports &lt;&gt; 0
					THEN
						CASE
							WHEN TableInventoryAllocation.DemandCharacteristic IN(
									VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
									VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked))
								THEN TableInventoryAllocation.Count
							ELSE 0
						END / TableInventoryAllocation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS ToReserve_,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN
				CASE
					WHEN TableInventoryAllocation.DemandCharacteristic =
							VALUE(Enum.DemandCharacteristics.NotProvide)
						THEN TableInventoryAllocation.Count
					ELSE 0
				END
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableInventoryAllocation.Products.UnitFactorForReports &lt;&gt; 0
					THEN
						CASE
							WHEN TableInventoryAllocation.DemandCharacteristic =
									VALUE(Enum.DemandCharacteristics.NotProvide)
								THEN TableInventoryAllocation.Count
							ELSE 0
						END / TableInventoryAllocation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS NotProvide,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN
				CASE
					WHEN TableInventoryAllocation.DemandCharacteristic IN(
								VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
								VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked),
								VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
								VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked))
							AND TableInventoryAllocation.InventoryState IN(
								VALUE(Enum.InventoryStates.InStock),
								VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
								VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking),
								VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
								VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
								VALUE(Enum.InventoryStates.ExpectedForReceiptNotSubjectToUnlocking),
								VALUE(Enum.InventoryStates.PendingSupplyApproval))
						THEN TableInventoryAllocation.Count
					ELSE 0
				END
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableInventoryAllocation.Products.UnitFactorForReports &lt;&gt; 0
					THEN
						CASE
							WHEN TableInventoryAllocation.DemandCharacteristic IN(
										VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
										VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked),
										VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
										VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked))
									AND TableInventoryAllocation.InventoryState IN(
										VALUE(Enum.InventoryStates.InStock),
										VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
										VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking),
										VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
										VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
										VALUE(Enum.InventoryStates.ExpectedForReceiptNotSubjectToUnlocking),
										VALUE(Enum.InventoryStates.PendingSupplyApproval))
								THEN TableInventoryAllocation.Count
							ELSE 0
						END / TableInventoryAllocation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS Reserved,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN
				CASE
					WHEN TableInventoryAllocation.DemandCharacteristic IN(
								VALUE(Enum.DemandCharacteristics.SnoozeReservation),
								VALUE(Enum.DemandCharacteristics.ToSupply))
							AND TableInventoryAllocation.InventoryState IN(
								VALUE(Enum.InventoryStates.InStock),
								VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
								VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking),
								VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
								VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
								VALUE(Enum.InventoryStates.ExpectedForReceiptNotSubjectToUnlocking),
								VALUE(Enum.InventoryStates.PendingSupplyApproval))
						THEN TableInventoryAllocation.Count
					ELSE 0
				END
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableInventoryAllocation.Products.UnitFactorForReports &lt;&gt; 0
					THEN
						CASE
							WHEN TableInventoryAllocation.DemandCharacteristic IN(
										VALUE(Enum.DemandCharacteristics.SnoozeReservation),
										VALUE(Enum.DemandCharacteristics.ToSupply))
									AND TableInventoryAllocation.InventoryState IN(
										VALUE(Enum.InventoryStates.InStock),
										VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
										VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking),
										VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
										VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
										VALUE(Enum.InventoryStates.ExpectedForReceiptNotSubjectToUnlocking),
										VALUE(Enum.InventoryStates.PendingSupplyApproval))
								THEN TableInventoryAllocation.Count
							ELSE 0
						END / TableInventoryAllocation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS Supplied,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN
				CASE
					WHEN TableInventoryAllocation.DemandCharacteristic IN(
								VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
								VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked),
								VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
								VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked),
								VALUE(Enum.DemandCharacteristics.SnoozeReservation),
								VALUE(Enum.DemandCharacteristics.ToSupply),
								VALUE(Enum.DemandCharacteristics.NotProvide))
							AND TableInventoryAllocation.InventoryState = VALUE(Enum.InventoryStates.NotProvided)
						THEN TableInventoryAllocation.Count
					ELSE 0
				END
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableInventoryAllocation.Products.UnitFactorForReports &lt;&gt; 0
					THEN
						CASE
							WHEN TableInventoryAllocation.DemandCharacteristic IN(
										VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
										VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked),
										VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
										VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked),
										VALUE(Enum.DemandCharacteristics.SnoozeReservation),
										VALUE(Enum.DemandCharacteristics.ToSupply),
										VALUE(Enum.DemandCharacteristics.NotProvide))
									AND TableInventoryAllocation.InventoryState = VALUE(Enum.InventoryStates.NotProvided)
								THEN TableInventoryAllocation.Count
							ELSE 0
						END / TableInventoryAllocation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS NotSupplied
FROM
	InformationRegister.InventoryAllocation AS TableInventoryAllocation
WHERE
	TableInventoryAllocation.ShipmentOrder IN
		(SELECT
			SelectionOfOrdersByPeriod.ReferenceOrder
		FROM
			SelectionOfOrdersByPeriod AS SelectionOfOrdersByPeriod)
{WHERE
	TableInventoryAllocation.ShipmentOrder.* AS ReferenceOrder,
	TableInventoryAllocation.Products.* AS Products,
	TableInventoryAllocation.Characteristic.* AS Characteristic,
	TableInventoryAllocation.Warehouse.* AS Warehouse,
	(TableInventoryAllocation.Products, TableInventoryAllocation.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed),
	TableInventoryAllocation.ShipmentOrder.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}</query>
		</item>
