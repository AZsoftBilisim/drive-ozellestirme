		<dataSource>MainDataSource</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUETYPE(StateTable.ReferenceOrder) AS TypeOfOrder_,
	StateTable.ReferenceOrder AS ReferenceOrder,
	StateTable.Warehouse AS Warehouse,
	StateTable.StateOfGoodsToShip AS ShipmentStatus,
	StateTable.DocumentStateToRegister AS StateOfRegistration,
	StateTable.StateOfGoodsToTransferOfTitleToGoods AS StateOfTransferOfOwnership,
	StateTable.StateOfGoodsRegisteredBasedOnReturns AS StateOfReturnsProcessing,
	StateTable.StateOfGoodsToReceive AS AcceptanceState
FROM
	InformationRegister.ShipmentAndReturnReferencesToFulfill AS StateTable
WHERE
	StateTable.ReferenceOrder IN
		(SELECT
			SelectionOfOrdersByPeriod.ReferenceOrder
		FROM
			SelectionOfOrdersByPeriod AS SelectionOfOrdersByPeriod)
{WHERE
	VALUETYPE(StateTable.ReferenceOrder) AS TypeOfOrder_,
	StateTable.ReferenceOrder.* AS ReferenceOrder,
	StateTable.Warehouse.* AS Warehouse,
	StateTable.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>Union</sourceDataSet>
		<destinationDataSet>StatesOfOrders</destinationDataSet>
		<sourceExpression>ReferenceOrder</sourceExpression>
		<destinationExpression>ReferenceOrder</destinationExpression>
		<required>false</required>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>Union</sourceDataSet>
		<destinationDataSet>StatesOfShipmentRegistration</destinationDataSet>
		<sourceExpression>Warehouse</sourceExpression>
		<destinationExpression>Warehouse</destinationExpression>
		<required>false</required>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>Union</sourceDataSet>
		<destinationDataSet>StatesOfShipmentRegistration</destinationDataSet>
		<sourceExpression>ReferenceOrder</sourceExpression>
		<destinationExpression>ReferenceOrder</destinationExpression>
		<required>false</required>
	</dataSetLink>
	<calculatedField>
		<dataPath>Manager</dataPath>
		<expression>ReferenceOrder.Manager</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
