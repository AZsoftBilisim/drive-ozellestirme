			<field xsi:type="DataSetFieldField">
				<dataPath>ControlledLotReference</dataPath>
				<field>ControlledLotReference</field>
				<useRestriction>
					<condition>true</condition>
				</useRestriction>
				<attributeUseRestriction>
					<condition>true</condition>
				</attributeUseRestriction>
			</field>
			<dataSource>MainDataSource</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VALUETYPE(TableOfRevolutions.DocumentShipments) AS TypeOfOrder_,
	TableOfRevolutions.DocumentShipments AS ReferenceOrder,
	TableOfRevolutions.Recorder AS Recorder,
	TableOfRevolutions.SecondPeriod AS Period,
	TableOfRevolutions.DayPeriod AS DayPeriod,
	TableOfRevolutions.WeekPeriod AS WeekPeriod,
	TableOfRevolutions.MonthPeriod AS MonthPeriod,
	TableOfRevolutions.HalfYearPeriod AS HalfYearPeriod,
	TableOfRevolutions.YearPeriod AS YearPeriod,
	TableOfRevolutions.TenDaysPeriod AS TenDaysPeriod,
	TableOfRevolutions.Warehouse AS Warehouse,
	TableOfRevolutions.Products AS Products,
	TableOfRevolutions.Characteristic AS Characteristic,
	TableOfRevolutions.Series AS Series,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipReceipt / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS ToBeShippedFromWarehouse,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipExpense / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS ShippedFromWarehouse,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS ItRemainsToShipFromWarehouse,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.AssemblyInProgressTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.AssemblyInProgressTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS AssemblyInProgress,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.AssembledReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.AssembledReceipt / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS Assembled,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ForAssemblyTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ForAssemblyTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END AS ItRemainsToCollect,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipReceipt / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextItemWeight AS ToBeShippedFromWarehouseWeight,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipExpense / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextItemWeight AS ShippedFromWarehouseWeight,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextItemWeight AS ItRemainsToShipWeightFromWarehouse,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.AssemblyInProgressTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.AssemblyInProgressTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextItemWeight AS WeightIsCollected,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.AssembledReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.AssembledReceipt / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextItemWeight AS CollectedWeight,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ForAssemblyTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ForAssemblyTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextItemWeight AS ItRemainsToCollectWeight,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipReceipt / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextTheVolumeOfTheItem AS ToBeShippedFromWarehouseVolume,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipExpense / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextTheVolumeOfTheItem AS ShippedFromWarehouseVolume,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ToShipTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ToShipTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextTheVolumeOfTheItem AS ItRemainsToShipVolumeFromWarehouse,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.AssemblyInProgressTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.AssemblyInProgressTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextTheVolumeOfTheItem AS AssemblyInProgressVolume,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.AssembledReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.AssembledReceipt / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextTheVolumeOfTheItem AS AssembledVolume,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfRevolutions.ForAssemblyTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN CatalogProducts.UnitFactorForReports &lt;&gt; 0
					THEN TableOfRevolutions.ForAssemblyTurnover / CatalogProducts.UnitFactorForReports
				ELSE 0
			END
	END * &amp;QueryTextTheVolumeOfTheItem AS ItRemainsToCollectVolume
FROM
	AccumulationRegister.GoodsForIssue.Turnovers(,, Auto,
		CASE
			WHEN &amp;DocumentSelectionOption
				THEN TRUE
			ELSE DocumentShipments IN
			(SELECT
				SelectionOfOrdersByPeriod.ReferenceOrder
			FROM
				SelectionOfOrdersByPeriod AS SelectionOfOrdersByPeriod)
		END {VALUETYPE(DocumentShipments) AS TypeOfOrder_}
		{(DocumentShipments).* AS ReferenceOrder}
		{(Products).* AS Products} {(Characteristic).* AS Characteristic} {(Warehouse).* AS Warehouse} {(Series).* AS
		Series}
		{(Products, Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			{DocumentShipments.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}) AS TableOfRevolutions
		INNER JOIN Catalog.Products AS CatalogProducts
		ON TableOfRevolutions.Products = CatalogProducts.Ref</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>GoodsToReceive</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>ReferenceOrder</dataPath>
				<field>ReferenceOrder</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Reference</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>مرجع</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Disposizione</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
