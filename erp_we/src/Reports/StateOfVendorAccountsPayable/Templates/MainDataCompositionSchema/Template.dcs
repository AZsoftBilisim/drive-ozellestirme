					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Đơn hàng đặt nhà cung cấp</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CreditAfterReceipt</dataPath>
				<field>CreditAfterReceipt</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Credit after receipt</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>اعتبار پس از دریافت</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Credito dopo l'arrivo</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Ma po wpływie</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Кредит после поступления</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Teslim alım sonrası kredi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Tín dụng sau khi nhận</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>// TAGS ARE USED!
SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DocumentData.Ref AS Ref,
	DocumentData.DocumentAmount AS DocumentAmount,
	DocumentData.AmountAdvanceBeforeConfirmation AS AmountAdvanceBeforeConfirmation,
	DocumentData.PrepaymentAmountBeforeReceipt AS PrepaymentAmountBeforeReceipt
INTO ARAPObjects
FROM
	Document.PurchaseOrder AS DocumentData



UNION ALL

SELECT
	DocumentData.Ref AS Ref,
	DocumentData.DocumentAmount AS DocumentAmount,
	DocumentData.AmountAdvanceBeforeConfirmation AS AmountAdvanceBeforeConfirmation,
	DocumentData.PrepaymentAmountBeforeReceipt AS PrepaymentAmountBeforeReceipt
FROM
	DocWP2_5 AS DocumentData
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VendorsARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	VendorsARAPAccounting.ARAPObject AS PurchaseOrder,
	VendorsARAPAccounting.ARAPObject.FinancialAccountingGroup AS FinancialAccountingGroup,
	VendorsARAPAccounting.Currency AS Currency,
	DimensionByPartners.Partner AS Partner,
	DimensionByPartners.Organization AS Organization,
	DimensionByPartners.Counterparty AS Counterparty,
	DimensionByPartners.Contract AS Contract,
	CASE WHEN NOT VendorsARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN DimensionByPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance &gt; 0
			THEN VendorsARAPAccounting.SumClosingBalance
		ELSE 0
	END AS DebtOfSupplier,
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance &lt; 0
			THEN -VendorsARAPAccounting.SumClosingBalance
		ELSE 0
	END AS AccountsPayableOfCompany,
	VendorsARAPAccounting.SumClosingBalance AS OurDebtBalance,
	VendorsARAPAccounting.BeingPaidClosingBalance AS BeingPaid,
	CASE
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &lt; 0
			THEN -VendorsARAPAccounting.AmountDueClosingBalance
		ELSE 0
	END AS AmountDue,
	CASE
		WHEN VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN VendorsARAPAccounting.AmountDueClosingBalance
		ELSE 0
	END AS ForCashReturn,
	CASE
		WHEN VendorsARAPAccounting.ToReceiveClosingBalance &gt; 0
			THEN VendorsARAPAccounting.ToReceiveClosingBalance
		ELSE 0
	END AS ToReceive,
	CASE
		WHEN ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0) &gt; 0
				AND VendorsARAPAccounting.AmountDueExpense + VendorsARAPAccounting.AmountDueClosingBalance &lt; ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0)
			THEN OrderDocument.AmountAdvanceBeforeConfirmation - (VendorsARAPAccounting.AmountDueExpense + VendorsARAPAccounting.AmountDueClosingBalance)
		ELSE 0
	END AS PrepaymentBeforeConfirmation,
	CASE
		WHEN ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0) &gt; 0
				AND ISNULL(OrderDocument.PrepaymentAmountBeforeReceipt, 0) &gt; 0
				AND VendorsARAPAccounting.AmountDueExpense + VendorsARAPAccounting.AmountDueClosingBalance &lt; ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0)
			THEN OrderDocument.PrepaymentAmountBeforeReceipt
		WHEN ISNULL(OrderDocument.PrepaymentAmountBeforeReceipt, 0) &gt; 0
				AND VendorsARAPAccounting.AmountDueExpense + VendorsARAPAccounting.AmountDueClosingBalance &lt; ISNULL(OrderDocument.PrepaymentAmountBeforeReceipt, 0) + ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0)
				AND VendorsARAPAccounting.AmountDueExpense + VendorsARAPAccounting.AmountDueClosingBalance &gt;= ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0)
			THEN OrderDocument.PrepaymentAmountBeforeReceipt + OrderDocument.AmountAdvanceBeforeConfirmation - (VendorsARAPAccounting.AmountDueExpense + VendorsARAPAccounting.AmountDueClosingBalance)
		ELSE 0
	END AS PrepaymentBeforeReceipt,
	CASE
		WHEN VendorsARAPAccounting.ARAPObject.Object &lt;&gt; UNDEFINED
				AND OrderDocument.Ref IS NULL 
				AND -VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN -VendorsARAPAccounting.AmountDueClosingBalance
		WHEN VendorsARAPAccounting.AmountDueExpense - ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0) - ISNULL(OrderDocument.PrepaymentAmountBeforeReceipt, 0) &gt; 0
			AND VendorsARAPAccounting.AmountDueExpense + VendorsARAPAccounting.AmountDueClosingBalance &lt;= ISNULL(OrderDocument.PrepaymentAmountBeforeReceipt, 0) + ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0)
			THEN VendorsARAPAccounting.AmountDueExpense - ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0) - ISNULL(OrderDocument.PrepaymentAmountBeforeReceipt, 0)
		WHEN VendorsARAPAccounting.AmountDueExpense - ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0) - ISNULL(OrderDocument.PrepaymentAmountBeforeReceipt, 0) &gt; 0
			AND VendorsARAPAccounting.AmountDueExpense + VendorsARAPAccounting.AmountDueClosingBalance &gt; ISNULL(OrderDocument.PrepaymentAmountBeforeReceipt, 0) + ISNULL(OrderDocument.AmountAdvanceBeforeConfirmation, 0)
			AND -VendorsARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN -VendorsARAPAccounting.AmountDueClosingBalance
		ELSE 0
	END AS CreditAfterReceipt
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(, ) AS VendorsARAPAccounting
		LEFT JOIN ARAPObjects AS OrderDocument
		ON VendorsARAPAccounting.ARAPObject.Object = OrderDocument.Ref
		{INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
WHERE
	DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND (VendorsARAPAccounting.AmountDueClosingBalance &lt;&gt; 0 OR VendorsARAPAccounting.ToReceiveClosingBalance &lt;&gt; 0)
{WHERE
	(DimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
		</item>
