			</title>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Rule</dataPath>
			<field>Rule</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Rule</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>قاعده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Правило</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Kural</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Quy tắc</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Rule</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Rule</v8:content>
				</v8:item>
			</title>
			<presentationExpression>String(Rule) + "
" +  Case When ValueIsFilled(FilterPresentation) Then FilterPresentation Else NStr("ru = '&lt;без отбора&gt;'; vi = '&lt;không lọc&gt;'; en = '&lt;No filter&gt;'; it = '&lt;senza selezione&gt;'; pl = '&lt;bez filtru&gt;'; tr = '&lt;filtresiz&gt;'") End</presentationExpression>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.RuleForCalculatingRelatedBudgetBalancesAndTurnovers</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>FilterPresentation</dataPath>
			<field>FilterPresentation</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CAST(CalculationsRules.Source AS Catalog.BudgetFlowItems) AS BudgetFlowItem,
	CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems) AS BudgetBalanceItem,
	CalculationsRules.Ref AS Rule,
	CalculationRulesDataCalculationSettings.FilterPresentation AS FilterPresentation,
	CalculationRulesDataCalculationSettings.ReverseSign AS Expense,
	CalculationRulesDataCalculationSettings.ZoomRatio AS ZoomRatio
{SELECT
	BudgetFlowItem.*,
	BudgetBalanceItem.*,
	Rule.*,
	FilterPresentation,
	ZoomRatio,
	Expense}
FROM
	Catalog.RuleForCalculatingRelatedBudgetBalancesAndTurnovers AS CalculationsRules
		LEFT JOIN Catalog.RuleForCalculatingRelatedBudgetBalancesAndTurnovers.DataCalculationSettings AS CalculationRulesDataCalculationSettings
		ON CalculationsRules.Ref = CalculationRulesDataCalculationSettings.Ref
WHERE
	CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems).IndicatorType = VALUE(Enum.BudgetBalanceItemType.Estimated_)
{WHERE
	CAST(CalculationsRules.Source AS Catalog.BudgetFlowItems).* AS BudgetFlowItem,
	CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems).* AS BudgetBalanceItem}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>InfluenceFactor</dataPath>
		<expression>Case When Expense Then -ZoomRatio Else ZoomRatio End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Influence factor</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>عامل تأثیر</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Rapporto di effetto</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Współczynnik wpływu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Коэффициент влияния</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Etki katsayısı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Hệ số ảnh ưởng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>InfluenceFactor</dataPath>
		<expression>Case When Rule.Receiver = BudgetBalanceItem Then InfluenceFactor Else 0 End</expression>
		<group>Rule</group>
	</totalField>
	<settingsVariant>
		<dcsset:name>LinksOfBudgetItemsAndIndicators</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Links of budget flow items and budget balance items</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پیوندهای اقلام جریان بودجه و اقلام مانده بودجه</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
