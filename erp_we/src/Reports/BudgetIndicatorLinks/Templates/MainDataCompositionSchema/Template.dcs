			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Związki artykułów i wyników budżetów</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Связи статей и показателей бюджетов</v8:content>
