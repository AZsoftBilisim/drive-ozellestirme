						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Relazioni tra articoli e indicatori di bilancio</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Związki artykułów i wyników budżetów</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Связи статей и показателей бюджетов</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Bütçe kalemleri ve bütçe dengesi kalemleri bağlantıları</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Mối liên hệ giữa các khoản mục và chỉ tiêu ngân sách</v8:content>
