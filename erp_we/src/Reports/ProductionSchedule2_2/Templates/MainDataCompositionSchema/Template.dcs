		<field xsi:type="DataSetFieldField">
			<dataPath>StageProduction</dataPath>
			<field>StageProduction</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Stage, semi-finished product, products</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مرحله، محصول نیمه‌ساخته، محصولات</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Fase, semilavorato, prodotto</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Etap, półfabrykat, wiersze pozycji</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Этап, полуфабрикат, продукция</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Aşama, yarı mamul ürün, imal edilen ürünler</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Công đoạn, bán thành phẩm, sản phẩm</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<presentationExpression>Case
	When StageProductionDesignation = &amp;DesignationStep
		Then Case
				When ValueIsFilled(StageProduction.StageName)
					Then StageProduction.StageName
				Else StageProduction.Description
			End
	When Not ValueIsFilled(Characteristic)
		Then Presentation(Products)
	Else Presentation(Products) + ", " + Presentation(Characteristic)
End</presentationExpression>
		</field>
