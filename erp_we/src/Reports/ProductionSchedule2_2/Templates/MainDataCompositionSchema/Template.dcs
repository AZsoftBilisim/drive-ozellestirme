		<field xsi:type="DataSetFieldField">
			<dataPath>Order</dataPath>
			<field>Order</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ScheduleOfProductionStages2_2.ProductionOrder           AS ProductionOrder,
	ScheduleOfProductionStages2_2.Stage                          AS Stage,
	ScheduleOfProductionStages2_2.BillOfMaterials                  AS BillOfMaterials,
	UNDEFINED                                              AS Purpose,
	ScheduleOfProductionStages2_2.Department                 AS Department,
	ScheduleOfProductionStages2_2.Stage                          AS StageProduction,
	CAST(&amp;DesignationStep AS STRING(25))                 AS StageProductionDesignation,
	1                                                         AS StageProductsProcedure,
	CASE
		WHEN MainProductSpecifications.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN MainProductSpecifications.Products.UnitOfMeasure
		ELSE MainProductSpecifications.Package
	END                                                     AS UnitOfMeasure,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN ScheduleOfProductionStages2_2.Begin
		ELSE ScheduleOfProductionStages2_2.Ending
	END                                                     AS ScheduleDatePlan,
	DATETIME(1, 1, 1)                                        AS ScheduleDateFact,
	
	MainProductSpecifications.NumberOfPackagesPerStartingLotUnit * ScheduleOfProductionStages2_2.QuantityOfBatches AS PlannedQuantity,
	0                                                         AS CountCanceled,
	0                                                         AS Quantity_Actual,
	
	MainProductSpecifications.Products                  AS Products,
	MainProductSpecifications.Characteristic                AS Characteristic,
	ScheduleOfProductionStages2_2.Order                       AS Order
INTO ProductionStages
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
		INNER JOIN InformationRegister.ProductsBOM AS MainProductSpecifications
		ON MainProductSpecifications.BillOfMaterials = ScheduleOfProductionStages2_2.BillOfMaterials
		AND MainProductSpecifications.Order = 1
WHERE
	&amp;DisplayStages
	AND &amp;DynamicStructureOfProductionOrders
	AND ScheduleOfProductionStages2_2.ScheduleStatus = &amp;ScheduleStatus
	AND ScheduleOfProductionStages2_2.Stage &lt;&gt; VALUE(Catalog.ProductionStages.EmptyRef)
	AND VALUETYPE(ScheduleOfProductionStages2_2.Stage) = TYPE(Catalog.ProductionStages)
	AND (&amp;ScheduleDateOption = 0
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Begin &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Begin &lt;= &amp;EndOfPeriod)
			OR &amp;ScheduleDateOption = 1
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &lt;= &amp;EndOfPeriod))
{WHERE
	ProductionOrder.*                      AS ProductionOrder,
	ScheduleOfProductionStages2_2.BillOfMaterials.* AS BillOfMaterials,
	Department.*                            AS Department,
	Products.*                             AS Products,
	Characteristic.*                           AS Characteristic
}

UNION ALL

SELECT
	ProductionStage2_2.ReferenceOrder                                     AS ProductionOrder,
	ProductionStage2_2.Ref                                           AS Stage,
	ProductionStage2_2.BillOfMaterials                                     AS BillOfMaterials,
	UNDEFINED                                                         AS Purpose,
	ProductionStage2_2.Department                                    AS Department,
	ProductionStage2_2.Ref                                           AS StageProduction,
	CAST(&amp;DesignationStep AS STRING(25))                            AS StageProductionDesignation,
	1                                                                    AS StageProductsProcedure,
	CASE
		WHEN ProductionStage2_2.PackagePlan &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				AND ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageActualData
				AND ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageCanceled
			THEN ProductionStage2_2.PackagePlan
		ELSE ProductionStage2_2.ProductionLot.MainProductProducts.UnitOfMeasure
	END                                                                AS UnitOfMeasure,
	CASE
		WHEN ScheduleOfProductionStages2_2.Begin IS NULL
			THEN DATETIME(1,1,1)
		WHEN &amp;ScheduleDateOption = 0
			THEN ScheduleOfProductionStages2_2.Begin
		ELSE ScheduleOfProductionStages2_2.Ending
	END                                                                AS ScheduleDatePlan,
	CASE
		WHEN NOT ProductionStage2_2.Status IN (
					VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
					VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			THEN DATETIME(1, 1, 1)
		WHEN &amp;ScheduleDateOption = 0
			THEN ProductionStage2_2.ActualStageStart
		WHEN ProductionStage2_2.ActualStageEnd = DATETIME(1, 1, 1)
			THEN ScheduleOfProductionStages2_2.Ending
		ELSE ProductionStage2_2.ActualStageEnd
	END                                                                AS ScheduleDateFact,
	
	CASE
		WHEN ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageActualData
				AND ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageCanceled
			THEN ProductionStage2_2.NumberOfPackagesPlan
		ELSE ProductionStage2_2.NumberOfPackagesPlan * ISNULL(&amp;PackagingFactorCanceled, 1)
	END                                                                AS PlannedQuantity,
	CASE
		WHEN ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageActualData
				AND ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageCanceled
			THEN ProductionStage2_2.NumberOfPackagesCanceled
		ELSE ProductionStage2_2.NumberOfPackagesCanceled * ISNULL(&amp;PackagingFactorCanceled, 1)
	END                                                                AS CountCanceled,
	CASE
		WHEN NOT ProductionStage2_2.Status IN (
					VALUE(Enum.StatusesOfProductionStages2_2.Initiated), 
					VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			THEN 0
		WHEN &amp;ScheduleDateOption = 0 
				AND ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageActualData
				AND ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageCanceled
			THEN ProductionStage2_2.NumberOfPackagesPlan
		WHEN &amp;ScheduleDateOption = 0
				AND (ProductionStage2_2.PackagePlan &lt;&gt; ProductionStage2_2.PackageActualData
					OR ProductionStage2_2.PackagePlan &lt;&gt; ProductionStage2_2.PackageCanceled)
			THEN ProductionStage2_2.NumberOfPackagesPlan * ISNULL(&amp;PackagingFactorPlan, 1)
		WHEN &amp;ScheduleDateOption = 1 
				AND ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageActualData
				AND ProductionStage2_2.PackagePlan = ProductionStage2_2.PackageCanceled
			THEN ProductionStage2_2.NumberOfPackagesReal
		ELSE ProductionStage2_2.NumberOfPackagesReal * ISNULL(&amp;PackagingFactorFact, 1)
	END                                                                AS Quantity_Actual,
	
	ProductionStage2_2.ProductionLot.MainProductProducts   AS Products,
	ProductionStage2_2.ProductionLot.MainProductCharacteristic AS Characteristic,
	CASE
		WHEN ProductionStage2_2.DynamicStructure
			THEN ISNULL(ScheduleOfProductionStages2_2.Order, 0)
		ELSE ISNULL(StandardScheduleOfProductionStages.DurationBeforeProductionIssue, 0)
	END AS Order
FROM
	Document.ProductionStage2_2 AS ProductionStage2_2
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
		ON ScheduleOfProductionStages2_2.Stage = ProductionStage2_2.Ref
		AND ScheduleOfProductionStages2_2.ScheduleStatus = &amp;ScheduleStatus
		
		LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS StandardScheduleOfProductionStages
		ON ProductionStage2_2.DynamicStructure = FALSE
		AND StandardScheduleOfProductionStages.ReferenceOrder = ProductionStage2_2.ReferenceOrder
		AND StandardScheduleOfProductionStages.ProductionStage = ProductionStage2_2.Ref
WHERE
	&amp;DisplayStages
	AND ProductionStage2_2.Posted
	AND (&amp;ScheduleDateOption = 0
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Begin &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Begin &lt;= &amp;EndOfPeriod)
			OR &amp;ScheduleDateOption = 0
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ProductionStage2_2.ActualStageStart &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ProductionStage2_2.ActualStageStart &lt;= &amp;EndOfPeriod)
			OR &amp;ScheduleDateOption = 1
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &lt;= &amp;EndOfPeriod)
			OR &amp;ScheduleDateOption = 1
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ProductionStage2_2.ActualStageEnd &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ProductionStage2_2.ActualStageEnd &lt;= &amp;EndOfPeriod))
{WHERE
	ProductionStage2_2.ReferenceOrder.*                      AS ProductionOrder,
	ProductionStage2_2.BillOfMaterials.*                             AS BillOfMaterials,
	ProductionStage2_2.Department.*                            AS Department,
	ProductionStage2_2.ProductionLot.MainProductProducts.*   AS Products,
	ProductionStage2_2.ProductionLot.MainProductCharacteristic.* AS Characteristic
}

;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	OrderStructure.ProductionOrder                                                         AS ProductionOrder,
	OrderStructure.Stage                                                                        AS ProductionStage,
	OrderStructure.BillOfMaterials                                                                AS BillOfMaterials,
	OrderStructure.Purpose                                                                  AS Purpose,
	OrderStructure.Department                                                               AS Department,
	OrderStructure.Warehouse                                                                       AS Recipient,
	OrderStructure.Products                                                                AS StageProduction,
	OrderStructure.LineKind =
		VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct) AS ThisIsASemiFinishedProduct,
	OrderStructure.Products.UnitOfMeasure  AS UnitOfMeasure,
	CAST(&amp;DesignationProduct AS STRING(25))                                                AS StageProductionDesignation,
	OrderStructure.Products                                                                AS Products,
	OrderStructure.Characteristic                                                              AS Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN ScheduleOfProductionStages2_2.Begin
		ELSE ScheduleOfProductionStages2_2.Ending
	END                                                                                       AS ScheduleDatePlan,
	SUM(OrderStructure.Scheduled)                                                        AS PlannedQuantity,
	DATETIME(1, 1, 1)                                                                          AS ScheduleDateFact,
	0                                                                                           AS Quantity_Actual,
	FALSE                                                                                        AS FlagCanceled,
	ScheduleOfProductionStages2_2.Order                                                         AS Order
INTO ManufacturedProduct
FROM
	InformationRegister.OrderStructure AS OrderStructure
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
		ON ScheduleOfProductionStages2_2.ProductionOrder    = OrderStructure.ProductionOrder
		AND ScheduleOfProductionStages2_2.KeyLot       = OrderStructure.KeyLot
		AND ScheduleOfProductionStages2_2.Stage = VALUE(Catalog.ProductionStages.EmptyRef)
		
		LEFT JOIN Document.ProductionOrder2_2 AS ProductionOrders
		ON OrderStructure.ProductionOrder = ProductionOrders.Ref
WHERE
	&amp;DisplayProducts
	AND &amp;DynamicStructureOfProductionOrders
	AND ScheduleOfProductionStages2_2.ScheduleStatus = &amp;ScheduleStatus
	AND (OrderStructure.LineKind IN (VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
									VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts))
			OR ProductionOrders.ProductionProcessType = VALUE(Enum.ProductionProcessTypes.Disassembly)
			AND OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.AvailableRelease))
	AND (&amp;ScheduleDateOption = 0
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Begin &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Begin &lt;= &amp;EndOfPeriod)
			OR &amp;ScheduleDateOption = 1
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &lt;= &amp;EndOfPeriod))
GROUP BY
	OrderStructure.ProductionOrder,
	OrderStructure.Stage,
	OrderStructure.BillOfMaterials,
	OrderStructure.Purpose,
	OrderStructure.Department,
	OrderStructure.Warehouse,
	OrderStructure.Products,
	OrderStructure.LineKind =
		VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
	OrderStructure.Products.UnitOfMeasure,
	CAST(&amp;DesignationProduct AS STRING(25)),
	OrderStructure.Characteristic,
	CASE
		WHEN &amp;ScheduleDateOption = 0
			THEN ScheduleOfProductionStages2_2.Begin
		ELSE ScheduleOfProductionStages2_2.Ending
	END,
	ScheduleOfProductionStages2_2.Order
HAVING
	SUM(OrderStructure.Scheduled) &gt; 0
{WHERE
	OrderStructure.ProductionOrder.*      AS ProductionOrder,
	ScheduleOfProductionStages2_2.BillOfMaterials.* AS BillOfMaterials,
	OrderStructure.Purpose.*               AS Purpose,
	OrderStructure.Department.*            AS Department,
	OrderStructure.Warehouse.*                    AS Recipient,
	OrderStructure.Products.*             AS Products,
	OrderStructure.Characteristic.*           AS Characteristic
}

UNION ALL

SELECT
	ProductionStage2_2.ReferenceOrder                                  AS ProductionOrder,
	ProductionStage2_2OutputProducts.Ref                         AS ProductionStage,
	ProductionStage2_2.BillOfMaterials                                  AS BillOfMaterials,
	ProductionStage2_2OutputProducts.Purpose                     AS Purpose,
	ProductionStage2_2OutputProducts.Department                  AS Department,
	ProductionStage2_2OutputProducts.Recipient                     AS Recipient,
	ProductionStage2_2OutputProducts.Products                   AS StageProduction,
	ProductionStage2_2OutputProducts.StageConsumer &lt;&gt;
		VALUE(Document.ProductionStage2_2.EmptyRef)           AS ThisIsASemiFinishedProduct,
	ProductionStage2_2OutputProducts.Products.UnitOfMeasure  AS UnitOfMeasure,
	CAST(&amp;DesignationProduct AS STRING(25))                      AS StageProductionDesignation,
	ProductionStage2_2OutputProducts.Products                   AS Products,
	ProductionStage2_2OutputProducts.Characteristic                 AS Characteristic,
	CASE
		WHEN ScheduleOfProductionStages2_2.Begin IS NULL
			THEN DATETIME(1,1,1)
		WHEN &amp;ScheduleDateOption = 0
			THEN ScheduleOfProductionStages2_2.Begin
		ELSE ScheduleOfProductionStages2_2.Ending
	END                                                             AS ScheduleDatePlan,
	ProductionStage2_2OutputProducts.Count                     AS PlannedQuantity,
	CASE
		WHEN NOT ProductionStage2_2.Status IN (
					VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
					VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			THEN DATETIME(1, 1, 1)
		WHEN &amp;ScheduleDateOption = 0
			THEN ProductionStage2_2.ActualStageStart
		WHEN ProductionStage2_2OutputProducts.Manufactured
			THEN ProductionStage2_2OutputProducts.ProductionDate
		WHEN ProductionStage2_2.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
			THEN ProductionStage2_2.ActualStageEnd
		ELSE DATETIME(1, 1, 1)
	END                                                             AS ScheduleDateFact,
	CASE
		WHEN NOT ProductionStage2_2.Status IN (
					VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
					VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			THEN 0
		WHEN &amp;ScheduleDateOption = 0
			THEN ProductionStage2_2OutputProducts.Count
		WHEN (ProductionStage2_2OutputProducts.Manufactured
				OR ProductionStage2_2.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			AND NOT ProductionStage2_2OutputProducts.Canceled
			THEN ProductionStage2_2OutputProducts.Count
		ELSE 0
	END                                                             AS Quantity_Actual,
	ISNULL(ProductionStage2_2OutputProducts.Canceled, FALSE)       AS FlagCanceled,
	CASE
		WHEN ProductionStage2_2.DynamicStructure
			THEN ISNULL(ScheduleOfProductionStages2_2.Order, 0)
		ELSE ISNULL(StandardScheduleOfProductionStages.DurationBeforeProductionIssue, 0)
	END AS Order
FROM
	Document.ProductionStage2_2.ManufacturedProducts AS ProductionStage2_2OutputProducts
		
		INNER JOIN Document.ProductionStage2_2 AS ProductionStage2_2
		ON ProductionStage2_2OutputProducts.Ref = ProductionStage2_2.Ref

		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
		ON ProductionStage2_2.ReferenceOrder = ScheduleOfProductionStages2_2.ProductionOrder
		 AND ProductionStage2_2OutputProducts.Ref = ScheduleOfProductionStages2_2.Stage
		 AND ScheduleOfProductionStages2_2.ScheduleStatus = &amp;ScheduleStatus
		
		LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS StandardScheduleOfProductionStages
		ON ProductionStage2_2.DynamicStructure = FALSE
		AND StandardScheduleOfProductionStages.ReferenceOrder = ProductionStage2_2.ReferenceOrder
		AND StandardScheduleOfProductionStages.ProductionStage = ProductionStage2_2.Ref
WHERE
	&amp;DisplayProducts
	AND ProductionStage2_2.Posted
	AND (&amp;ScheduleDateOption = 0
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Begin &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Begin &lt;= &amp;EndOfPeriod)
			OR &amp;ScheduleDateOption = 0
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ProductionStage2_2.ActualStageStart &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ProductionStage2_2.ActualStageStart &lt;= &amp;EndOfPeriod)
			OR &amp;ScheduleDateOption = 1
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ScheduleOfProductionStages2_2.Ending &lt;= &amp;EndOfPeriod)
			OR &amp;ScheduleDateOption = 1
				AND (&amp;BeginOfPeriod = DATETIME(1, 1, 1)
					OR ProductionStage2_2OutputProducts.ProductionDate &gt;= &amp;BeginOfPeriod)
				AND (&amp;EndOfPeriod = DATETIME(1, 1, 1)
					OR ProductionStage2_2OutputProducts.ProductionDate &lt;= &amp;EndOfPeriod))
{WHERE
	ProductionStage2_2.ReferenceOrder.*                  AS ProductionOrder,
	ScheduleOfProductionStages2_2.BillOfMaterials.*          AS BillOfMaterials,
	ProductionStage2_2OutputProducts.Purpose.*     AS Purpose,
	ProductionStage2_2OutputProducts.Department.*  AS Department,
	ProductionStage2_2OutputProducts.Recipient.*     AS Recipient,
	ProductionStage2_2OutputProducts.Products.*   AS Products,
	ProductionStage2_2OutputProducts.Characteristic.* AS Characteristic
}

INDEX BY
	ProductionOrder,
	Products,
	Characteristic,
	Purpose
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ProductionStages.ProductionOrder AS ProductionOrder
INTO References
FROM
	ProductionStages AS ProductionStages

UNION ALL

SELECT DISTINCT
	ManufacturedProduct.ProductionOrder         AS ProductionOrder
FROM
	ManufacturedProduct AS ManufacturedProduct

INDEX BY
	ProductionOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ProductionOrder2_2ManufacturedProduct.Ref                    AS ProductionOrder,
	ProductionOrder2_2ManufacturedProduct.Products              AS Products,
	ProductionOrder2_2ManufacturedProduct.Characteristic            AS Characteristic,
	CASE
		WHEN ProductionOrder2_2ManufacturedProduct.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
			THEN ProductionOrder2_2ManufacturedProduct.Department
		ELSE ProductionOrder2_2ManufacturedProduct.Warehouse
	END                                                     AS Warehouse,
	ProductionOrder2_2ManufacturedProduct.Purpose                AS Purpose
INTO ProductionOfOrders
FROM
	Document.ProductionOrder2_2.ManufacturedProduct AS ProductionOrder2_2ManufacturedProduct
WHERE
	ProductionOrder2_2ManufacturedProduct.Ref IN
			(SELECT
				References.ProductionOrder
			FROM
				References)

INDEX BY
	ProductionOrder,
	Products,
	Characteristic,
	Warehouse,
	Purpose
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ScheduleOfProductionStages2_2.ProductionOrder AS ProductionOrder,
	TRUE                                          AS ReleaseDateIsOverdue
INTO DelayOfOrders
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
		LEFT JOIN Document.ProductionStage2_2 AS ProductionStage2_2
		ON ScheduleOfProductionStages2_2.Stage = ProductionStage2_2.Ref
		INNER JOIN Document.ProductionOrder2_2 AS OrderDocument
		ON ScheduleOfProductionStages2_2.ProductionOrder = OrderDocument.Ref
		AND OrderDocument.ProductionProcessType &lt;&gt; VALUE(Enum.ProductionProcessTypes.Disassembly)
WHERE
	ScheduleOfProductionStages2_2.ProductionOrder IN
			(SELECT
				References.ProductionOrder
			FROM
				References)
	AND ScheduleOfProductionStages2_2.ScheduleStatus = &amp;ScheduleStatus
	AND BEGINOFPERIOD(CASE
						WHEN ProductionStage2_2.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
							THEN ProductionStage2_2.ActualStageEnd
						ELSE ScheduleOfProductionStages2_2.Ending
					END, DAY) &gt; BEGINOFPERIOD(ScheduleOfProductionStages2_2.ProductionOrder.DemandDate, DAY)

INDEX BY
	ProductionOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProductionStages.ProductionOrder                  AS ProductionOrder,
	ProductionStages.Stage                                 AS ProductionStage,
	ProductionStages.BillOfMaterials                         AS BillOfMaterials,
	ProductionStages.Purpose                           AS Purpose,
	ProductionStages.Department                        AS Department,
	UNDEFINED                                           AS Recipient,
	ProductionStages.StageProduction                        AS StageProduction,
	ProductionStages.StageProductionDesignation             AS StageProductionDesignation,
	ProductionStages.StageProductsProcedure                 AS StageProductsProcedure,
	ProductionStages.Products                         AS Products,
	ProductionStages.Characteristic                       AS Characteristic,
	ProductionStages.UnitOfMeasure                     AS UnitOfMeasure,
	BEGINOFPERIOD(ProductionStages.ScheduleDatePlan, DAY) AS ScheduleDatePlanFact,
	ProductionStages.Order                              AS Order,
	ProductionStages.PlannedQuantity                   AS CountPlan,
	ProductionStages.CountCanceled                   AS CountPlanCanceled,
	0                                                      AS CountReal
INTO StagesAndProducts
FROM
	ProductionStages AS ProductionStages
WHERE
	(&amp;BeginOfPeriod = DATETIME(1, 1, 1) OR ProductionStages.ScheduleDatePlan &gt;= &amp;BeginOfPeriod OR ProductionStages.ScheduleDatePlan = DATETIME(1,1,1))
	AND (&amp;EndOfPeriod = DATETIME(1, 1, 1) OR ProductionStages.ScheduleDatePlan &lt;= &amp;EndOfPeriod)
	AND ProductionStages.PlannedQuantity &lt;&gt; 0

UNION ALL

SELECT
	ProductionStages.ProductionOrder                  AS ProductionOrder,
	ProductionStages.Stage                                 AS ProductionStage,
	ProductionStages.BillOfMaterials                         AS BillOfMaterials,
	ProductionStages.Purpose                           AS Purpose,
	ProductionStages.Department                        AS Department,
	UNDEFINED                                           AS Recipient,
	ProductionStages.StageProduction                        AS StageProduction,
	ProductionStages.StageProductionDesignation             AS StageProductionDesignation,
	ProductionStages.StageProductsProcedure                 AS StageProductsProcedure,
	ProductionStages.Products                         AS Products,
	ProductionStages.Characteristic                       AS Characteristic,
	ProductionStages.UnitOfMeasure                     AS UnitOfMeasure,
	BEGINOFPERIOD(ProductionStages.ScheduleDateFact, DAY) AS ScheduleDatePlanFact,
	ProductionStages.Order                              AS Order,
	0                                                      AS CountPlan,
	0                                                      AS CountPlanCanceled,
	ProductionStages.Quantity_Actual                AS CountReal
FROM
	ProductionStages AS ProductionStages
WHERE
	(&amp;BeginOfPeriod = DATETIME(1, 1, 1) OR ProductionStages.ScheduleDateFact &gt;= &amp;BeginOfPeriod)
	AND (&amp;EndOfPeriod = DATETIME(1, 1, 1) OR ProductionStages.ScheduleDateFact &lt;= &amp;EndOfPeriod)
	AND ProductionStages.Quantity_Actual &lt;&gt; 0

UNION ALL

SELECT
	ManufacturedProduct.ProductionOrder                  AS ProductionOrder,
	ManufacturedProduct.ProductionStage                     AS ProductionStage,
	ManufacturedProduct.BillOfMaterials                         AS BillOfMaterials,
	ManufacturedProduct.Purpose                           AS Purpose,
	ManufacturedProduct.Department                        AS Department,
	ManufacturedProduct.Recipient                           AS Recipient,
	ManufacturedProduct.StageProduction                        AS StageProduction,
	ManufacturedProduct.StageProductionDesignation             AS StageProductionDesignation,
	CASE
		WHEN ManufacturedProduct.ThisIsASemiFinishedProduct
			THEN 2
		WHEN ProductionOfOrders.Products IS NULL
			THEN 3
		ELSE 4
	END                                          AS StageProductsProcedure,
	ManufacturedProduct.Products                         AS Products,
	ManufacturedProduct.Characteristic                       AS Characteristic,
	ManufacturedProduct.UnitOfMeasure                     AS UnitOfMeasure,
	BEGINOFPERIOD(ManufacturedProduct.ScheduleDatePlan, DAY) AS ScheduleDatePlanFact,
	ManufacturedProduct.Order                              AS Order,
	ManufacturedProduct.PlannedQuantity                   AS CountPlan,
	CASE
		WHEN ManufacturedProduct.FlagCanceled
			THEN ManufacturedProduct.PlannedQuantity
		ELSE 0
	END                                          AS CountPlanCanceled,
	0                                              AS CountReal
FROM
	ManufacturedProduct AS ManufacturedProduct
		LEFT JOIN ProductionOfOrders AS ProductionOfOrders
		ON ManufacturedProduct.ProductionOrder   = ProductionOfOrders.ProductionOrder
		 AND ManufacturedProduct.Products   = ProductionOfOrders.Products
		 AND ManufacturedProduct.Characteristic = ProductionOfOrders.Characteristic
		 AND ManufacturedProduct.Recipient     = ProductionOfOrders.Warehouse
		 AND ManufacturedProduct.Purpose     = ProductionOfOrders.Purpose
WHERE
	(&amp;BeginOfPeriod = DATETIME(1, 1, 1) OR ManufacturedProduct.ScheduleDatePlan &gt;= &amp;BeginOfPeriod OR ManufacturedProduct.ScheduleDatePlan = DATETIME(1,1,1))
	AND (&amp;EndOfPeriod = DATETIME(1, 1, 1) OR ManufacturedProduct.ScheduleDatePlan &lt;= &amp;EndOfPeriod)
	AND ManufacturedProduct.PlannedQuantity &lt;&gt; 0

UNION ALL

SELECT
	ManufacturedProduct.ProductionOrder                  AS ProductionOrder,
	ManufacturedProduct.ProductionStage                     AS ProductionStage,
	ManufacturedProduct.BillOfMaterials                         AS BillOfMaterials,
	ManufacturedProduct.Purpose                           AS Purpose,
	ManufacturedProduct.Department                        AS Department,
	ManufacturedProduct.Recipient                           AS Recipient,
	ManufacturedProduct.StageProduction                        AS StageProduction,
	ManufacturedProduct.StageProductionDesignation             AS StageProductionDesignation,
	CASE
		WHEN ManufacturedProduct.ThisIsASemiFinishedProduct
			THEN 2
		WHEN ProductionOfOrders.Products IS NULL
			THEN 3
		ELSE 4
	END                                          AS StageProductsProcedure,
	ManufacturedProduct.Products                         AS Products,
	ManufacturedProduct.Characteristic                       AS Characteristic,
	ManufacturedProduct.UnitOfMeasure                     AS UnitOfMeasure,
	BEGINOFPERIOD(ManufacturedProduct.ScheduleDateFact, DAY) AS ScheduleDatePlanFact,
	ManufacturedProduct.Order                              AS Order,
	0                                              AS CountPlan,
	0                                              AS CountPlanCanceled,
	ManufacturedProduct.Quantity_Actual                AS CountReal
FROM
	ManufacturedProduct AS ManufacturedProduct
		LEFT JOIN ProductionOfOrders AS ProductionOfOrders
		ON ManufacturedProduct.ProductionOrder   = ProductionOfOrders.ProductionOrder
		 AND ManufacturedProduct.Products   = ProductionOfOrders.Products
		 AND ManufacturedProduct.Characteristic = ProductionOfOrders.Characteristic
		 AND ManufacturedProduct.Recipient     = ProductionOfOrders.Warehouse
		 AND ManufacturedProduct.Purpose     = ProductionOfOrders.Purpose
WHERE
	(&amp;BeginOfPeriod = DATETIME(1, 1, 1) OR ManufacturedProduct.ScheduleDateFact &gt;= &amp;BeginOfPeriod) 
	AND (&amp;EndOfPeriod = DATETIME(1, 1, 1) OR ManufacturedProduct.ScheduleDateFact &lt;= &amp;EndOfPeriod) 
	AND ManufacturedProduct.Quantity_Actual &lt;&gt; 0

INDEX BY
	ProductionOrder,
	ProductionStage
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	StagesAndProducts.ProductionOrder                                    AS ProductionOrder,
	StagesAndProducts.ProductionStage                                       AS ProductionStage,
	StagesAndProducts.BillOfMaterials                                           AS BillOfMaterials,
	StagesAndProducts.Purpose                                             AS Purpose,
	StagesAndProducts.Department                                          AS Department,
	StagesAndProducts.Recipient                                             AS Recipient,
	StagesAndProducts.ProductionOrder.Department                      AS ProductionDispatcherBusinessUnit,
	StagesAndProducts.StageProduction                                          AS StageProduction,
	StagesAndProducts.StageProductionDesignation                               AS StageProductionDesignation,
	StagesAndProducts.StageProductsProcedure                                   AS StageProductsProcedure,
	StagesAndProducts.Products                                           AS Products,
	StagesAndProducts.Characteristic                                         AS Characteristic,
	StagesAndProducts.UnitOfMeasure                                       AS UnitOfMeasure,
	StagesAndProducts.CountPlan                                         AS CountPlan,
	StagesAndProducts.CountPlanCanceled                                 AS CountPlanCanceled,	
	StagesAndProducts.CountReal                                         AS CountReal,
	StagesAndProducts.Order                                                AS Order,
	CASE
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
			THEN BEGINOFPERIOD(StagesAndProducts.ScheduleDatePlanFact, DAY)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(StagesAndProducts.ScheduleDatePlanFact, WEEK)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(StagesAndProducts.ScheduleDatePlanFact, MONTH)
		ELSE &amp;EndOfPeriod
	END                                                                  AS ScheduleDate,
	CASE
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
			THEN ENDOFPERIOD(StagesAndProducts.ScheduleDatePlanFact, DAY)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(StagesAndProducts.ScheduleDatePlanFact, WEEK)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(StagesAndProducts.ScheduleDatePlanFact, MONTH)
		ELSE &amp;BeginOfPeriod
	END                                                                  AS ScheduleDateEnd,
	StagesAndProducts.ScheduleDatePlanFact                                    AS FinalScheduleDate,
	ISNULL(DelayOfOrders.ReleaseDateIsOverdue, FALSE)            AS ReleaseDateIsOverdue
FROM
	StagesAndProducts AS StagesAndProducts
		LEFT JOIN DelayOfOrders AS DelayOfOrders
		ON StagesAndProducts.ProductionOrder = DelayOfOrders.ProductionOrder</query>
	</dataSet>
