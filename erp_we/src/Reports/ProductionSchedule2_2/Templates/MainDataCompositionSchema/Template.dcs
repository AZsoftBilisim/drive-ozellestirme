		<field xsi:type="DataSetFieldField">
			<dataPath>ProductionOrder</dataPath>
			<field>ProductionOrder</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Production order</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>سفارش تولید</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Ordine di produzione</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Zlecenie produkcyjne</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заказ на производство</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Üretim emri</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đơn hàng sản xuất</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<presentationExpression>NStr("ru = 'Заказ №'; vi = 'Đặt hàng số'; en = 'Order #'; it = 'Ordine №'; pl = 'Zamówienie nr'; tr = 'Sipariş №'") + ProductionOrder.Number + "; " + NStr("ru = 'дата потребности:'; vi = 'ngày yêu cầu:'; en = 'demand date:'; it = 'data del fabbisogno:'; pl = 'Data zapotrzebowania:'; tr = 'talep tarihi:'") + " " + Format(ProductionOrder.DemandDate, "DF='dd.MM.yyyy (ddd)'")</presentationExpression>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:DocumentRef.ProductionOrder2_2</v8:Type>
			</valueType>
		</field>
