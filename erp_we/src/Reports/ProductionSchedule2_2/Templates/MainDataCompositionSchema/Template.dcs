    When ScheduleDate = DateTime(1,1,1)
        Then "Undefined"
    When &amp;ReportFrequency = Value(Enum.Periodicity.Week)
        Then Format(ScheduleDate, "DLF=D") + " - " + Format(ScheduleDateEnd, "DLF=D")
    When &amp;ReportFrequency = Value(Enum.Periodicity.Month)
        Then Format(ScheduleDate, "DF='MMMM (yyyy)'")
    Else Format(ScheduleDate, "DF='dd.MM.yyyy (ddd)'")
End</presentationExpression>
