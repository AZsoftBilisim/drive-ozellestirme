				<field>SellerDebtOpeningBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPDocument</dataPath>
				<field>ARAPDocument</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>LineOfBusiness</dataPath>
				<field>LineOfBusiness</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPObject</dataPath>
				<field>ARAPObject</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>DocumentOfARAPAccounting</dataPath>
				<field>DocumentOfARAPAccounting</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>AR/AP document</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>سند دریافتنی/پرداختنی</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Documento di calcoli</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Dokument rozliczeń</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Документ расчетов</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Mutabakat işlemleri belgesi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Chứng từ hạch toán</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	2 AS PaymentType_,
	VendorsARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization AS Customer,
	CAST(RegisterAccountingAnalyticsForPartners.Counterparty AS Catalog.Companies) AS Seller,
	CASE WHEN NOT VendorsARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	VendorsARAPAccounting.Currency AS Currency,
	VendorsARAPAccounting.ARAPObject AS DocumentOfARAPAccounting,
	
	CASE WHEN VendorsARAPAccounting.Recorder = UNDEFINED THEN
		NULL
	ELSE
		VendorsARAPAccounting.Recorder
	END AS Recorder,
	
	VendorsARAPAccounting.SecondPeriod AS SecondPeriod,
	VendorsARAPAccounting.DayPeriod AS DayPeriod,
	VendorsARAPAccounting.WeekPeriod AS WeekPeriod,
	VendorsARAPAccounting.TenDaysPeriod AS TenDaysPeriod,
	VendorsARAPAccounting.MonthPeriod AS MonthPeriod,
	VendorsARAPAccounting.QuarterPeriod AS QuarterPeriod,
	VendorsARAPAccounting.HalfYearPeriod AS HalfYearPeriod,
	VendorsARAPAccounting.YearPeriod AS YearPeriod,
	
	CASE WHEN VendorsARAPAccounting.SumOpeningBalance &gt; 0 THEN
		VendorsARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS SellerDebtOpeningBalance,
	
	CASE WHEN VendorsARAPAccounting.SumOpeningBalance &lt; 0 THEN
		-VendorsARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS BuyerSDebtOpeningBalance,
	
	VendorsARAPAccounting.SumOpeningBalance AS DebtOpeningBalance,
	VendorsARAPAccounting.SumReceipt AS DebtReduction,
	VendorsARAPAccounting.SumExpense AS DebtIncrease_,
	VendorsARAPAccounting.SumClosingBalance AS DebtClosingBalance,
	
	CASE WHEN VendorsARAPAccounting.SumClosingBalance &gt; 0 THEN
		VendorsARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS SellerDebtClosingBalance,
	
	CASE WHEN VendorsARAPAccounting.SumClosingBalance &lt; 0 THEN
		-VendorsARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS BuyerSDebtClosingBalance
	
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(
		,
		,
		Auto
	) AS VendorsARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData = 1 // In the settlement currency

UNION ALL

SELECT
	2 AS PaymentType_,
	VendorsARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization AS Customer,
	CAST(RegisterAccountingAnalyticsForPartners.Counterparty AS Catalog.Companies) AS Seller,
	CASE WHEN NOT VendorsARAPAccounting.PurchaseOrder.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.PurchaseOrder.LineOfBusiness
	END AS LineOfBusiness,	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		&amp;ManagementAccountingCurrency
	ELSE
		RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS Currency,
	VendorsARAPAccounting.PurchaseOrder AS DocumentOfARAPAccounting,
	
	CASE WHEN VendorsARAPAccounting.Recorder = UNDEFINED THEN
		NULL
	ELSE
		VendorsARAPAccounting.Recorder
	END AS Recorder,
	
	VendorsARAPAccounting.SecondPeriod AS SecondPeriod,
	VendorsARAPAccounting.DayPeriod AS DayPeriod,
	VendorsARAPAccounting.WeekPeriod AS WeekPeriod,
	VendorsARAPAccounting.TenDaysPeriod AS TenDaysPeriod,
	VendorsARAPAccounting.MonthPeriod AS MonthPeriod,
	VendorsARAPAccounting.QuarterPeriod AS QuarterPeriod,
	VendorsARAPAccounting.HalfYearPeriod AS HalfYearPeriod,
	VendorsARAPAccounting.YearPeriod AS YearPeriod,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance &gt; 0 THEN
			VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance
		ELSE
			0
		END
	ELSE // In the currency of the regl. accounting
		CASE WHEN VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance &gt; 0 THEN
			VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance
		ELSE
			0
		END
	END AS SellerDebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance &lt; 0 THEN
			-(VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance)
		ELSE
			0
		END
	ELSE // In the currency of the regl. accounting
		CASE WHEN VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance &lt; 0 THEN
			-(VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance)
		ELSE
			0
		END
	END AS BuyerSDebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance
	ELSE
		VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance
	END AS DebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		VendorsARAPAccounting.ARAPManReceipt + VendorsARAPAccounting.PrepaymentManReceipt
	ELSE
		VendorsARAPAccounting.DebtLocalReceipt + VendorsARAPAccounting.PrepaymentLocalReceipt
	END AS DebtIncrease_,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		VendorsARAPAccounting.ARAPManExpense + VendorsARAPAccounting.PrepaymentManExpense
	ELSE
		VendorsARAPAccounting.DebtLocalExpense + VendorsARAPAccounting.PrepaymentLocalExpense
	END AS DebtReduction,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance
	ELSE
		VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance
	END AS DebtClosingBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance &gt; 0 THEN
			VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance
		ELSE
			0
		END
	ELSE
		CASE WHEN VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance &gt; 0 THEN
			VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance
		ELSE
			0
		END
	END AS SellerDebtClosingBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance &lt; 0 THEN
			-(VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance)
		ELSE
			0
		END
	ELSE
		CASE WHEN VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance &lt; 0 THEN
			-(VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance)
		ELSE
			0
		END
	END AS BuyerSDebtClosingBalance

FROM
	AccumulationRegister.VendorsARAPAccountingByDocuments.BalanceAndTurnovers(
		,
		,
		Auto
	) AS VendorsARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData IN (2,3) // In the currency of upr. accounting, in the currency of regl. accounting</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>DebtClosingBalance</dataPath>
		<expression>Sum(DebtClosingBalance)</expression>
		<group>Currency</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>DebtOpeningBalance</dataPath>
		<expression>Sum(DebtOpeningBalance)</expression>
		<group>Currency</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>DebtIncrease_</dataPath>
		<expression>Sum(DebtIncrease_)</expression>
		<group>Currency</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>DebtReduction</dataPath>
		<expression>Sum(DebtReduction)</expression>
		<group>Currency</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>BuyerSDebtOpeningBalance</dataPath>
		<expression>Sum(BuyerSDebtOpeningBalance)</expression>
		<group>Currency</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>BuyerSDebtClosingBalance</dataPath>
		<expression>Sum(BuyerSDebtClosingBalance)</expression>
		<group>Currency</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>SellerDebtOpeningBalance</dataPath>
		<expression>Sum(SellerDebtOpeningBalance)</expression>
		<group>Currency</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>SellerDebtClosingBalance</dataPath>
		<expression>Sum(SellerDebtClosingBalance)</expression>
		<group>Currency</group>
		<group>Recorder</group>
	</totalField>
