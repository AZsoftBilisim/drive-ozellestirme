		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PricingVariant</dataPath>
			<field>PricingVariant</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PricingBatch</dataPath>
			<field>PricingBatch</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PricingPackage</dataPath>
			<field>PricingPackage</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Country</dataPath>
			<field>Country</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Characteristic AS Characteristic,
	ISNULL(CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE DimensionOfProductItem.Characteristic.ItemsCharacteristicForPricing
		END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS PricingPackage,
	GoodsTransferred.ItemsLocationAttributes,
	GoodsTransferred.Terms AS Terms,
	GoodsTransferred.Terms.Currency AS Currency,
	GoodsTransferred.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	GoodsTransferred.Organization AS Organization
INTO GoodsTransferred
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent.Balance({(&amp;PeriodEndBoundary)}, ) AS GoodsTransferred
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON (ItemKinds.Ref = GoodsTransferred.ItemsLocationAttributes.Products.ProductKind)
		{INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON GoodsTransferred.ItemsLocationAttributes = DimensionOfProductItem.Ref
			AND (DimensionOfProductItem.StorageLocation &lt;&gt; VALUE(Catalog.Partners.OurEnterprise))}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Products AS Products,
	ItemsPrices.Characteristic AS Characteristic,
	ItemsPrices.Currency AS Currency,
	CASE
		WHEN NOT &amp;QueryTextPackagingFactor1 IS NULL
				AND &amp;QueryTextPackagingFactor1 &lt;&gt; 0
			THEN ItemsPrices.Price / &amp;QueryTextPackagingFactor1
		ELSE ItemsPrices.Price
	END AS Price
INTO ItemsPrices
FROM
	InformationRegister.ItemsPrices.SliceLast(
			{(ENDOFPERIOD(&amp;EndOfPeriod, DAY))},
			(Products, Characteristic) IN
				(SELECT
					GoodsTransferred.Products,
					GoodsTransferred.Characteristic
				FROM
					GoodsTransferred AS GoodsTransferred)) AS ItemsPrices
WHERE
	NOT &amp;UsePriceManagementSystem25

UNION ALL

SELECT
	ItemsPrices.PriceKind,
	ItemsPrices.Products,
	GoodsTransferred.Characteristic,
	ItemsPrices.Currency,
	CASE
		WHEN NOT &amp;QueryTextPackagingFactor1 IS NULL
				AND &amp;QueryTextPackagingFactor1 &lt;&gt; 0
			THEN ItemsPrices.Price / &amp;QueryTextPackagingFactor1
		ELSE ItemsPrices.Price
	END
FROM
	InformationRegister.ItemsPrices25.SliceLast(
			{(ENDOFPERIOD(&amp;EndOfPeriod, DAY))},
			(Products, PricingVariant, PricingBatch, PricingPackage) IN
				(SELECT
					GoodsTransferred.Products,
					GoodsTransferred.PricingVariant,
					GoodsTransferred.PricingBatch,
					GoodsTransferred.PricingPackage
				FROM
					GoodsTransferred AS GoodsTransferred)) AS ItemsPrices
		LEFT JOIN GoodsTransferred AS GoodsTransferred
		ON ItemsPrices.Products = GoodsTransferred.Products
			AND ItemsPrices.PricingVariant = GoodsTransferred.PricingVariant
			AND ItemsPrices.PricingBatch = GoodsTransferred.PricingBatch
			AND ItemsPrices.PricingPackage = GoodsTransferred.PricingPackage
WHERE
	&amp;UsePriceManagementSystem25
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)}, BaseCurrency = &amp;BaseCurrency) AS ExchangeRates
WHERE
	ExchangeRates.CourseNumerator &lt;&gt; 0
	AND ExchangeRates.CourseDenominator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	GoodsTransferred.Currency AS Currency,
	GoodsTransferred.Terms AS Terms,
	GoodsTransferred.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	GoodsTransferred.Terms.PriceIncludesVAT AS PriceIncludesVAT,
	GoodsTransferred.Products AS Products,
	ISNULL(ProductsVATRates.VATRate, ISNULL(VATRatesForEmptyCountryProducts.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))) AS VATRate,
	GoodsTransferred.Characteristic AS Characteristic,
	GoodsTransferred.PricingVariant AS PricingVariant,
	GoodsTransferred.ItemsLocationAttributes,
	CASE
		WHEN NOT GoodsTransferred.Terms.PriceIncludesVAT
				AND GoodsTransferred.InventoryOwnerAttribute.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
			THEN CASE
					WHEN NOT GoodsTransferred.Terms.PriceIncludesVAT
							AND GoodsTransferred.InventoryOwnerAttribute.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
						THEN ((ISNULL(ProductsVATRates.VATRate, ISNULL(VATRatesForEmptyCountryProducts.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef))))).Rate1 + 100) / 100
					ELSE 1
				END
		ELSE 1
	END AS VATRate_2,
	CASE
		WHEN NOT AgreementWithCustomerGoods.PriceKind IS NULL 
			THEN AgreementWithCustomerGoods.PriceKind
		WHEN NOT CustomerTermsOfSales.PricesKind IS NULL 
			THEN CustomerTermsOfSales.PricesKind
		ELSE UNDEFINED
	END AS PriceKind,
	ISNULL(ExchangeRates.CourseNumerator, 0) AS CourseNumerator,
	ISNULL(ExchangeRates.CourseDenominator, 0) AS CourseDenominator,
	CASE
		WHEN NOT &amp;QueryTextPackagingFactor2 IS NULL 
				AND &amp;QueryTextPackagingFactor2 &lt;&gt; 0
			THEN ISNULL(AgreementWithCustomerGoods.Price, 0) / &amp;QueryTextPackagingFactor2
		ELSE ISNULL(AgreementWithCustomerGoods.Price, 0)
	END AS Price
INTO ProductsTypesOfPrices
FROM
	GoodsTransferred AS GoodsTransferred
		LEFT JOIN Catalog.TermsOfSale AS CustomerTermsOfSales
		ON GoodsTransferred.Terms = CustomerTermsOfSales.Ref
			AND (CustomerTermsOfSales.PricesKind &lt;&gt; VALUE(Catalog.TypesOfPrices.EmptyRef))
		LEFT JOIN Catalog.TermsOfSale.Goods AS AgreementWithCustomerGoods
		ON GoodsTransferred.Terms = AgreementWithCustomerGoods.Ref
			AND GoodsTransferred.Products = AgreementWithCustomerGoods.Products
			AND GoodsTransferred.Characteristic = AgreementWithCustomerGoods.Characteristic
			AND (AgreementWithCustomerGoods.PriceKind &lt;&gt; VALUE(Catalog.TypesOfPrices.EmptyRef)
				OR AgreementWithCustomerGoods.Price &lt;&gt; 0)
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON GoodsTransferred.Currency = ExchangeRates.Currency
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(&amp;EndOfPeriod)}) AS ProductsVATRates
		ON GoodsTransferred.Products = ProductsVATRates.Products
			AND GoodsTransferred.Organization.RegistrationCountry = ProductsVATRates.Country
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast({(&amp;EndOfPeriod)}) AS BasicVATRates
		ON GoodsTransferred.Organization.RegistrationCountry = BasicVATRates.Country
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(&amp;EndOfPeriod)}, Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS VATRatesForEmptyCountryProducts
		ON GoodsTransferred.ItemsLocationAttributes.Products = VATRatesForEmptyCountryProducts.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	GoodsTransferred.Terms AS Terms,
	GoodsTransferred.ItemsLocationAttributes,
	GoodsTransferred.InventoryOwnerAttribute,
	CASE
		WHEN GoodsTransferred.Price &lt;&gt; 0
			THEN GoodsTransferred.Price
		ELSE CAST(ISNULL(ItemsPrices.Price, 0) * CASE
					WHEN GoodsTransferred.CourseNumerator &lt;&gt; 0
							AND ExchangeRates.CourseDenominator &lt;&gt; 0
						THEN ISNULL(ExchangeRates.CourseNumerator, 0) * GoodsTransferred.CourseDenominator / (ISNULL(ExchangeRates.CourseDenominator, 1) *
							GoodsTransferred.CourseNumerator)
					ELSE 1
				END AS NUMBER(31,2))
	END * GoodsTransferred.VATRate_2 AS Price
INTO GoodsTransferredPrices
FROM
	ProductsTypesOfPrices AS GoodsTransferred
		LEFT JOIN ItemsPrices AS ItemsPrices
		ON GoodsTransferred.Products = ItemsPrices.Products
			AND (GoodsTransferred.Characteristic = ItemsPrices.Characteristic
				OR GoodsTransferred.PricingVariant = ItemsPrices.Characteristic)
			AND GoodsTransferred.PriceKind = ItemsPrices.PriceKind
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON (ItemsPrices.Currency = ExchangeRates.Currency)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsTransferredToCommissionAgent.Organization,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	DimensionOfProductItem.Characteristic AS Characteristic,
	DimensionOfProductItem.Partner AS Consignee,
	GoodsTransferredToCommissionAgent.Terms AS Terms,
	GoodsTransferredToCommissionAgent.Terms.Currency AS Currency,
	GoodsTransferredToCommissionAgent.InventoryOwnerAttribute,
	GoodsTransferredToCommissionAgent.CCDNumber,
	GoodsTransferredToCommissionAgent.CountBalance AS CountBalance,
	GoodsTransferredPrices.Price AS Price,
	CAST(GoodsTransferredToCommissionAgent.CountBalance * ISNULL(GoodsTransferredPrices.Price, 0) AS NUMBER(31,2)) AS SumClosingBalance,
	ISNULL(DatesOfConsignmentGoodsTransfer.TransferDate, DATETIME(1, 1, 1)) AS TransferDate,
	DATEDIFF(DatesOfConsignmentGoodsTransfer.TransferDate, &amp;CurrentDate, DAY) AS DaysCount
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent.Balance({(&amp;PeriodEndBoundary)}, ) AS GoodsTransferredToCommissionAgent
		{INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON GoodsTransferredToCommissionAgent.ItemsLocationAttributes = DimensionOfProductItem.Ref
			AND (DimensionOfProductItem.StorageLocation &lt;&gt; VALUE(Catalog.Partners.OurEnterprise))}
		{LEFT JOIN GoodsTransferredPrices AS GoodsTransferredPrices
		ON GoodsTransferredToCommissionAgent.ItemsLocationAttributes = GoodsTransferredPrices.ItemsLocationAttributes
			AND GoodsTransferredToCommissionAgent.Terms = GoodsTransferredPrices.Terms
			AND GoodsTransferredToCommissionAgent.InventoryOwnerAttribute = GoodsTransferredPrices.InventoryOwnerAttribute}
		{LEFT JOIN InformationRegister.DatesOfConsignmentGoodsTransfer AS DatesOfConsignmentGoodsTransfer
		ON GoodsTransferredToCommissionAgent.ItemsLocationAttributes = DatesOfConsignmentGoodsTransfer.ItemsLocationAttributes
			AND GoodsTransferredToCommissionAgent.InventoryOwnerAttribute = DatesOfConsignmentGoodsTransfer.InventoryOwnerAttribute
			AND GoodsTransferredToCommissionAgent.CCDNumber = DatesOfConsignmentGoodsTransfer.CCDNumber
			AND GoodsTransferredToCommissionAgent.Terms = DatesOfConsignmentGoodsTransfer.Terms
			AND GoodsTransferredToCommissionAgent.Organization = DatesOfConsignmentGoodsTransfer.Organization}
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.Partner.* AS Consignee,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DimensionOfProductItem.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
	</dataSet>
	<calculatedField>
		<dataPath>CountBalance</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        CountBalance
    When &amp;QuantityUnits = 1 Then
        CountBalance / UnitFactorForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
