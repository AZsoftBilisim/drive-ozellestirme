		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>TextColor</dcscor:parameter>
				<dcscor:value xmlns:d5p1="http://v8.1c.ru/8.1/data/ui/style" xsi:type="v8ui:Color">d5p1:SpecialTextColor</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MarkNegatives</dcscor:parameter>
				<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">15</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>15</v8:Digits>
				<v8:FractionDigits>3</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>ToRegisterClosingBalance</dataPath>
		<expression>Sum(ToRegisterClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>ToRegisterOpeningBalance</dataPath>
		<expression>Sum(ToRegisterOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>ToRegisterReceipt</dataPath>
		<expression>Sum(ToRegisterReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>ToRegisterExpense</dataPath>
		<expression>Sum(ToRegisterExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>ToReceiveClosingBalance</dataPath>
		<expression>Sum(ToReceiveClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>ToReceiveOpeningBalance</dataPath>
		<expression>Sum(ToReceiveOpeningBalance)</expression>
	</totalField>
