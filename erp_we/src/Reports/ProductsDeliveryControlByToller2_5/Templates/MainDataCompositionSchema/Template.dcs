			</title>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.PackagesAndUnitsOfMeasure</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// TAGS ARE USED!!!
 SELECT ALLOWED
	Orders.YearPeriod,
	Orders.TenDaysPeriod,
	Orders.DayPeriod,
	Orders.QuarterPeriod,
	Orders.MonthPeriod,
	Orders.MinutePeriod,
	Orders.WeekPeriod,
	Orders.HalfYearPeriod,
	Orders.SecondPeriod,
	Orders.HourPeriod,
	CASE
		WHEN Orders.Recorder = UNDEFINED
			THEN NULL
		ELSE Orders.Recorder
	END AS Recorder,
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.Partner AS Toller,
	DocumentsRegistry.Contract AS Contract,
	Orders.PurchaseOrder,
	DocumentsRegistry.IBDocumentDate AS IBDocumentDate,
	DocumentsRegistry.IBDocumentNumber AS IBDocumentNumber,
	Orders.Products,
	Orders.Products.UnitOfMeasure AS UnitOfMeasure,
	Orders.Characteristic,
	Orders.RowCode,
	Orders.Warehouse,

	Orders.ToRegisterOpeningBalance,
	CASE
		WHEN Orders.RowCode = 0
			THEN 0
		ELSE Orders.ToRegisterReceipt
	END AS ToRegisterReceipt,
	Orders.ToRegisterExpense,
	Orders.ToRegisterClosingBalance,

	Orders.ToReceiveOpeningBalance,
	CASE
		WHEN Orders.RowCode = 0
			THEN 0
		ELSE Orders.ToReceiveReceipt
	END AS ToReceiveReceipt,
	Orders.ToReceiveExpense,
	Orders.ToReceiveClosingBalance
INTO RegisterData
FROM
	AccumulationRegister.PurchaseOrders.BalanceAndTurnovers(
			{(&amp;StartDate)},
			{(&amp;EndDate)},
			Auto,,
			VALUETYPE(PurchaseOrder) = TYPE(Document.SubcontractOrder2_5)
			{PurchaseOrder.* AS PurchaseOrder,
			(RowCode = 0) AS ExceedingOrder,
			Products.* AS Products,
			Characteristic.* AS Characteristic,
			RowCode AS RowCode}
		) AS Orders
	
	LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	ON DocumentsRegistry.Ref = Orders.PurchaseOrder
	AND NOT DocumentsRegistry.AdditionalRecord
	
	LEFT JOIN Document.SubcontractOrder2_5.Services AS OrderingServices
	ON OrderingServices.Ref = Orders.PurchaseOrder
	AND OrderingServices.RowCode = Orders.RowCode

WHERE
	OrderingServices.Ref IS NULL

{WHERE
	Orders.Recorder.* AS Recorder,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.Partner.* AS Toller,
	DocumentsRegistry.Contract.* AS Contract}
;

////////////////////////////////////////////////////////////////////////////////
 SELECT DISTINCT
	RegisterData.PurchaseOrder AS PurchaseOrder,
	RegisterData.RowCode AS RowCode
INTO TTOrders
FROM
	RegisterData AS RegisterData
GROUP BY
	RegisterData.PurchaseOrder,
	RegisterData.RowCode

INDEX BY
	PurchaseOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	Orders.PurchaseOrder AS PurchaseOrder,
	Orders.RowCode AS RowCode,
	MAX(
		ISNULL(TSManufacturedProducts.DateOfReceipt,
			ISNULL(TSSideAndIntermediateRelease.DateOfReceipt, DATETIME(1, 1, 1)))) AS DeliveryTimePlan
INTO TTDeliveryTime
FROM
	TTOrders AS Orders
	
	LEFT JOIN Document.SubcontractOrder2_5.ManufacturedProducts AS TSManufacturedProducts
	ON Orders.PurchaseOrder = TSManufacturedProducts.Ref
	AND Orders.RowCode = TSManufacturedProducts.RowCode
	
	LEFT JOIN Document.SubcontractOrder2_5.SideAndIntermediateRelease AS TSSideAndIntermediateRelease
	ON Orders.PurchaseOrder = TSSideAndIntermediateRelease.Ref
	AND Orders.RowCode = TSSideAndIntermediateRelease.RowCode

WHERE
	NOT TSManufacturedProducts.Ref IS NULL
	OR NOT TSSideAndIntermediateRelease.Ref IS NULL

GROUP BY
	Orders.PurchaseOrder,
	Orders.RowCode

UNION ALL

SELECT
	Orders.PurchaseOrder AS PurchaseOrder,
	Orders.RowCode AS RowCode,
	MAX(
		ISNULL(TSManufacturedProducts.ProductionDate,
			ISNULL(TSSideAndIntermediateRelease.ProductionDate, DATETIME(1, 1, 1)))) AS DeliveryTimePlan
FROM
	TTOrders AS Orders
	
	INNER JOIN Document.SubcontractOrder2_5 AS DocOrderDocument
	ON Orders.PurchaseOrder = DocOrderDocument.Ref
	AND DocOrderDocument.GroupCosts = VALUE(Enum.CostGroupingsInTollingOrder.ByProductionStages)
	
	INNER JOIN Document.ProductionStage2_2 AS DocStage
	ON DocOrderDocument.Ref = DocStage.SubcontractOrder
	
	LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS TSManufacturedProducts
	ON DocStage.Ref = TSManufacturedProducts.Ref
	AND Orders.RowCode = TSManufacturedProducts.RowCode
	
	LEFT JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS TSSideAndIntermediateRelease
	ON DocStage.Ref = TSSideAndIntermediateRelease.Ref
	AND Orders.RowCode = TSSideAndIntermediateRelease.RowCode

WHERE
	NOT TSManufacturedProducts.Ref IS NULL
	OR NOT TSSideAndIntermediateRelease.Ref IS NULL

GROUP BY
	Orders.PurchaseOrder,
	Orders.RowCode

INDEX BY
	PurchaseOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	RegisterData.YearPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.DayPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.MonthPeriod,
	RegisterData.MinutePeriod,
	RegisterData.WeekPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.SecondPeriod,
	RegisterData.HourPeriod,
	RegisterData.Recorder,
	RegisterData.Organization,
	RegisterData.Toller,
	RegisterData.Contract,
	RegisterData.PurchaseOrder,
	RegisterData.IBDocumentDate,
	RegisterData.IBDocumentNumber,
	RegisterData.Products,
	RegisterData.UnitOfMeasure,
	RegisterData.Characteristic,
	RegisterData.RowCode,
	RegisterData.Warehouse,
	DeliveryTerm.DeliveryTimePlan AS DeliveryTimePlan,
	
	RegisterData.ToRegisterOpeningBalance,
	RegisterData.ToRegisterReceipt,
	RegisterData.ToRegisterExpense,
	RegisterData.ToRegisterClosingBalance,
	
	RegisterData.ToReceiveOpeningBalance,
	RegisterData.ToReceiveReceipt,
	RegisterData.ToReceiveExpense,
	RegisterData.ToReceiveClosingBalance
FROM
	RegisterData AS RegisterData
	
	LEFT JOIN TTDeliveryTime AS DeliveryTerm
	ON RegisterData.PurchaseOrder = DeliveryTerm.PurchaseOrder
	AND RegisterData.RowCode = DeliveryTerm.RowCode
	</query>
	</dataSet>
	<calculatedField>
		<dataPath>ReceivedLate</dataPath>
		<expression>Case
	When Not RowCode = 0
		And DayPeriod &gt; DeliveryTimePlan
		Then ToReceiveExpense
	Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
