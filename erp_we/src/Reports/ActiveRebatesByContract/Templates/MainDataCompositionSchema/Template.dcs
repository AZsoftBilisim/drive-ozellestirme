		<field xsi:type="DataSetFieldField">
			<dataPath>ValidOnDate</dataPath>
			<field>ValidOnDate</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ValidTo</dataPath>
			<field>ValidTo</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ISNULL(CustomerRebatesConditions.Organization, VALUE(Catalog.Companies.EmptyRef)) AS Organization,
	&amp;Counterparty AS Counterparty,
	&amp;Partner AS Partner,
	CustomerRebatesContractsTermsOfSales.TermDocument AS TermDocument,
	ISNULL(CustomerRebatesConditions.Kind, VALUE(Catalog.CustomerRebatesKinds.EmptyRef)) AS Kind,
	ISNULL(CustomerRebatesConditions.LongDesc, "") AS LongDesc,
	CustomerRebatesContractsTermsOfSales.ValidOnDate AS ValidOnDate,
	CustomerRebatesContractsTermsOfSales.ValidTo AS ValidTo
{SELECT
	Organization,
	Counterparty,
	Partner,
	TermDocument.*,
	Kind,
	LongDesc,
	ValidOnDate,
	ValidTo}
FROM
	InformationRegister.CustomerRebatesContractsTermsOfSales AS CustomerRebatesContractsTermsOfSales
		LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON CustomerRebatesContractsTermsOfSales.TermDocument = CustomerRebatesConditions.TermDocument
WHERE
	CustomerRebatesContractsTermsOfSales.Contract = &amp;Contract
{WHERE
	(&amp;BeginOfPeriod &lt;= CustomerRebatesContractsTermsOfSales.ValidTo),
	(&amp;EndOfPeriod &gt;= CustomerRebatesContractsTermsOfSales.ValidOnDate),
	(ISNULL(CustomerRebatesConditions.Organization, VALUE(Catalog.Companies.EmptyRef))) AS Organization,
	CustomerRebatesContractsTermsOfSales.TermDocument.* AS TermDocument,
	(ISNULL(CustomerRebatesConditions.Kind, VALUE(Catalog.CustomerRebatesKinds.EmptyRef))) AS Kind}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
