		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Analysis of VAT accruals from advance payments (received)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تحلیل محاسبات VAT از پیش‌پرداخت‌ها (دریافتی)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Analisi di imputazione IVA dagli anticipi (ricevuti)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Analiza naliczań VAT z zaliczek (otrzymanych)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Анализ начислений НДС с авансов (полученных)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
