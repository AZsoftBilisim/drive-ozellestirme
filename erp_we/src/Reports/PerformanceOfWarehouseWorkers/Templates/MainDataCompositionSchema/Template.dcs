		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ProductsInTurnoverCells.Period,
	ProductsInTurnoverCells.Recorder,
	ProductsInTurnoverCells.Recorder.ReceivingArea AS WarehouseZone,
	&amp;ParameterOperationKindAcceptance AS OperationKind,
	1 AS OperationKindPicking,
	ProductsInTurnoverCells.Recorder.EmployeeResponsible AS Performer,
	ProductsInTurnoverCells.InStockReceipt AS Count,
	ProductsInTurnoverCells.Products,
	ProductsInTurnoverCells.Characteristic,
	ProductsInTurnoverCells.Package,
	ProductsInTurnoverCells.Cell,
	ProductsInTurnoverCells.Series,
	ProductsInTurnoverCells.Cell.Owner AS Warehouse,
	ProductsInTurnoverCells.Cell.Premise AS Premise,
	ProductsInTurnoverCells.LineNumber,
	&amp;QueryTextPackageVolume1 AS VolumeM3,
	&amp;QueryTextPackageWeight1 AS Weight
FROM
	AccumulationRegister.GoodsInStorageBins.Turnovers(, , Record, ) AS ProductsInTurnoverCells
WHERE
	ProductsInTurnoverCells.Recorder REFS Document.GoodsReceiptNote
	AND ProductsInTurnoverCells.InStockReceipt &lt;&gt; 0

UNION ALL

SELECT
	ProductsInTurnoverCells.Period,
	ProductsInTurnoverCells.Recorder,
	ProductsInTurnoverCells.Recorder.WarehouseZone,
	CASE
		WHEN ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Move)
				AND ProductsInTurnoverCells.InStockReceipt &lt;&gt; 0
			THEN VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Location)
		WHEN ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Move)
				AND ProductsInTurnoverCells.InStockExpense &lt;&gt; 0
			THEN VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Filter)
		ELSE ProductsInTurnoverCells.Recorder.OperationKind
	END,
	2,
	ProductsInTurnoverCells.Recorder.Performer,
	CASE
		WHEN ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Location)
				OR ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Move)
					AND ProductsInTurnoverCells.InStockReceipt &lt;&gt; 0
			THEN ProductsInTurnoverCells.InStockReceipt
		WHEN ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Filter)
				OR ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Move)
					AND ProductsInTurnoverCells.InStockExpense &lt;&gt; 0
			THEN ProductsInTurnoverCells.InStockExpense
	END,
	ProductsInTurnoverCells.Products,
	ProductsInTurnoverCells.Characteristic,
	ProductsInTurnoverCells.Package,
	ProductsInTurnoverCells.Cell,
	ProductsInTurnoverCells.Series,
	ProductsInTurnoverCells.Cell.Owner,
	ProductsInTurnoverCells.Cell.Premise,
	ProductsInTurnoverCells.LineNumber,
	&amp;QueryTextPackageVolume1,
	&amp;QueryTextPackageWeight1
FROM
	AccumulationRegister.GoodsInStorageBins.Turnovers(, , Record, ) AS ProductsInTurnoverCells
WHERE
	ProductsInTurnoverCells.Recorder REFS Document.GoodsPickingPlacement
	AND CASE
			WHEN ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Location)
					OR ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Move)
						AND ProductsInTurnoverCells.InStockReceipt &lt;&gt; 0
				THEN ProductsInTurnoverCells.InStockReceipt
			WHEN ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Filter)
					OR ProductsInTurnoverCells.Recorder.OperationKind = VALUE(Enum.OperationKindsOfGoodsPlacementPicking.Move)
						AND ProductsInTurnoverCells.InStockExpense &lt;&gt; 0
				THEN ProductsInTurnoverCells.InStockExpense
		END &lt;&gt; 0

UNION ALL

SELECT
	GoodsForSelectionTurnover.Period,
	GoodsForSelectionTurnover.Recorder,
	GoodsForSelectionTurnover.Recorder.ShippingZone,
	&amp;ParameterOperationKindControl,
	3,
	GoodsForSelectionTurnover.Recorder.Inspector,
	GoodsForSelectionTurnover.PickedExpense,
	GoodsForSelectionTurnover.Products,
	GoodsForSelectionTurnover.Characteristic,
	NULL,
	NULL,
	GoodsForSelectionTurnover.Series,
	GoodsForSelectionTurnover.Recorder.Warehouse,
	GoodsForSelectionTurnover.Recorder.Premise,
	GoodsForSelectionTurnover.LineNumber,
	0,
	0
FROM
	AccumulationRegister.GoodsForPicking.Turnovers(, , Record, ) AS GoodsForSelectionTurnover
WHERE
	GoodsForSelectionTurnover.Recorder REFS Document.GoodsIssueNote
	AND GoodsForSelectionTurnover.PickedExpense &lt;&gt; 0

UNION ALL

SELECT
	RecalculationOfGoods.Ref.Date,
	RecalculationOfGoods.Ref,
	NULL,
	&amp;ParameterOperationKindRecalculation,
	4,
	RecalculationOfGoods.Ref.Performer,
	RecalculationOfGoods.NumberOfPackagesReal,
	RecalculationOfGoods.Products,
	RecalculationOfGoods.Characteristic,
	RecalculationOfGoods.Package,
	RecalculationOfGoods.Cell,
	RecalculationOfGoods.Series,
	RecalculationOfGoods.Cell.Owner,
	RecalculationOfGoods.Cell.Premise,
	RecalculationOfGoods.LineNumber,
	&amp;QueryTextPackageVolume2,
	&amp;QueryTextPackageWeight2
FROM
	Document.InventoryRecount.Goods AS RecalculationOfGoods
WHERE
	RecalculationOfGoods.Ref.Posted
	AND RecalculationOfGoods.Ref.Status = VALUE(Enum.InventoryRecountStatuses.Completed2)
{WHERE
	(RecalculationOfGoods.Ref.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod)}</query>
	</dataSet>
