<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Employee</dataPath>
			<field>Employee</field>
			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceForm</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ChoiceFormInternational</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Department</dataPath>
			<field>Department</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>WorkScheduleCalendar</dataPath>
			<field>WorkScheduleCalendar</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Organization</dataPath>
			<field>Organization</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Date</dataPath>
			<field>Date</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineNumberEmployee</dataPath>
			<field>LineNumberEmployee</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Row number</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>شماره سطر</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Numero della riga</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Numer wiersza</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер строки</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Satır numarası</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Row number</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ShiftScheduleHR.Organization AS Organization,
	ShiftScheduleHRDataOnTime.Employee AS Employee,
	ShiftScheduleHRDataOnTime.Date AS Date,
	ShiftScheduleHRDataOnTime.WorkScheduleCalendar AS WorkScheduleCalendar
INTO DocumentsData
FROM
	Document.ShiftScheduleHR AS ShiftScheduleHR
		INNER JOIN Document.ShiftScheduleHR.DataOnTime AS ShiftScheduleHRDataOnTime
		ON ShiftScheduleHR.Ref = ShiftScheduleHRDataOnTime.Ref
WHERE
	ShiftScheduleHRDataOnTime.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND ShiftScheduleHR.Posted

GROUP BY
	ShiftScheduleHRDataOnTime.Date,
	ShiftScheduleHRDataOnTime.WorkScheduleCalendar,
	ShiftScheduleHRDataOnTime.Employee,
	ShiftScheduleHR.Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.Employee AS Employee,
	RECORDAUTONUMBER() AS EmployeeLineNumber
INTO EmployeeLineNumbers
FROM
	(SELECT
		DocumentsData.Employee AS Employee
	FROM
		DocumentsData AS DocumentsData
	
	GROUP BY
		DocumentsData.Employee) AS NestedQuery
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DocumentsData.Organization AS Organization,
	DocumentsData.Employee AS Employee,
	DocumentsData.Date AS Date,
	DocumentsData.WorkScheduleCalendar AS WorkScheduleCalendar,
	EmploymentRecordSliceLast.Department AS Department,
	EmployeeLineNumbers.EmployeeLineNumber AS LineNumberEmployee
FROM
	DocumentsData AS DocumentsData
		LEFT JOIN InformationRegister.EmploymentRecord.SliceLast(&amp;ReportDate, WorksInBusinessUnit) AS EmploymentRecordSliceLast
		ON DocumentsData.Organization = EmploymentRecordSliceLast.Organization
			AND DocumentsData.Employee = EmploymentRecordSliceLast.Employee
		INNER JOIN EmployeeLineNumbers AS EmployeeLineNumbers
		ON DocumentsData.Employee = EmployeeLineNumbers.Employee
{WHERE
	DocumentsData.Employee.*}</query>
	</dataSet>
