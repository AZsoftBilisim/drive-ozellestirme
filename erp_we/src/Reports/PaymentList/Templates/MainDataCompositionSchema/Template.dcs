		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ScheduleOfPayments.BankAccountCashAccount,
	CASE WHEN ScheduleOfPayments.PaymentDate &lt; &amp;BeginOfPeriod THEN
		DATEADD(&amp;BeginOfPeriod, DAY, -1)
	ELSE
		ScheduleOfPayments.PaymentDate
	END AS PaymentDate,
	ScheduleOfPayments.ReceiptIssue,
	ScheduleOfPayments.Currency AS PaymentCurrency,
	ScheduleOfPayments.PaymentObject,
	ScheduleOfPayments.PayerBeneficiary,
	ScheduleOfPayments.PlanningArea,
	ScheduleOfPayments.CashFlowItem,
	ScheduleOfPayments.BusinessOperation,
	ScheduleOfPayments.Organization,
	ScheduleOfPayments.Department,
	ScheduleOfPayments.LineOfBusiness,
	ScheduleOfPayments.Priority,
	ScheduleOfPayments.EmployeeResponsible,
	ScheduleOfPayments.DocumentAmount,
	ScheduleOfPayments.ScheduleRelevanceDate,
	CASE ScheduleOfPayments.ReceiptIssue
		WHEN VALUE(Enum.CashFlowTypes.Inpayment) THEN
			ScheduleOfPayments.Sum
		WHEN VALUE(Enum.CashFlowTypes.WriteOff) THEN
			-ScheduleOfPayments.Sum
	END AS PaymentAmount,
	ISNULL(Request.PaymentPurposes, """") AS PaymentPurposes,
	ScheduleOfPayments.Status AS Status
	
FROM
	InformationRegister.ScheduleOfPayments AS ScheduleOfPayments
	
	LEFT JOIN Document.PaymentRequest AS Request
	ON Request.Ref = ScheduleOfPayments.PaymentObject
	
WHERE
	ScheduleOfPayments.PaymentDate &lt; &amp;PeriodEnding
	AND CASE WHEN VALUETYPE(ScheduleOfPayments.PaymentObject) = TYPE(Document.PlannedCashReceipt)
		THEN ScheduleOfPayments.PaymentDate &gt;= &amp;BeginOfPeriod
		ELSE TRUE
	END
	
{WHERE
	ScheduleOfPayments.Organization.*,
	BankAccountCashAccount.*,
	ScheduleOfPayments.Currency.* AS Currency,
	PlanningArea,
	ScheduleOfPayments.Status AS Status}</query>
	</dataSet>
