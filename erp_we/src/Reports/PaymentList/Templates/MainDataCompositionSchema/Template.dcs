		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PaymentCurrencyRates.Currency AS PaymentExchangeRateCurrency,
	ISNULL(PaymentCurrencyRates.CourseNumerator, 1) AS PaymentExchangeRate,
	ISNULL(PaymentCurrencyRates.CourseDenominator, 1) AS PaymentMultiplier
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;BeginOfPeriod}, BaseCurrency = &amp;BaseCurrency) AS PaymentCurrencyRates
WHERE
	PaymentCurrencyRates.CourseDenominator &lt;&gt; 0
	AND PaymentCurrencyRates.CourseNumerator &lt;&gt; 0</query>
	</dataSet>
