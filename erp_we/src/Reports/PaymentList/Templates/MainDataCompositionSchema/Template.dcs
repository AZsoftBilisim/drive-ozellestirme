				<order>true</order>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CashCurrency_</dataPath>
			<field>CashCurrency_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Currency</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>ارز</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Valuta Di Cassa</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Waluta środków pieniężnych</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Валюта ДС</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Nakit para birimi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tiền tệ TM</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Currency</dataPath>
			<field>Currency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS CashCurrency_,
	CurrencyExchangeRate.CourseNumerator * SingleCurrencyExchangeRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * SingleCurrencyExchangeRate.CourseNumerator) AS RatioOfCashConversionToOneCurrency
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;BeginOfPeriod}, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast({&amp;BeginOfPeriod}, Currency = &amp;TotalCurrency AND BaseCurrency = &amp;BaseCurrency) AS SingleCurrencyExchangeRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND SingleCurrencyExchangeRate.CourseNumerator &lt;&gt; 0</query>
	</dataSet>
