		<field xsi:type="DataSetFieldField">
			<dataPath>CompanyOwner</dataPath>
			<field>CompanyOwner</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Company</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>شرکت</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Azienda</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Firma</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Организация</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>İş yeri</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Doanh nghiệp</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	BankAccounts.Ref AS BankAccountCashAccount,
	BankAccounts.CashCurrency AS CashCurrency,
	BankAccounts.Owner AS CompanyOwner
{SELECT
	BankAccountCashAccount.*,
	CashCurrency.*,
	CompanyOwner.*}
FROM
	Catalog.CompaniesBankAccounts AS BankAccounts
WHERE
	NOT BankAccounts.DeletionMark
	AND NOT BankAccounts.Closed
{WHERE
	BankAccounts.Owner.* AS Organization,
	BankAccounts.Ref.* AS BankAccountCashAccount,
	BankAccounts.CashCurrency.* AS Currency}

UNION ALL

SELECT
	CashAccounts.Ref,
	CashAccounts.CashCurrency,
	CashAccounts.Owner
FROM
	Catalog.CashAccounts AS CashAccounts
WHERE
	NOT CashAccounts.DeletionMark
{WHERE
	CashAccounts.Owner.* AS Organization,
	CashAccounts.Ref.* AS BankAccountCashAccount,
	CashAccounts.CashCurrency.* AS Currency}

UNION ALL

SELECT
	UNDEFINED AS BankAccountCashAccount,
	NULL AS CashCurrency,
	NULL</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
