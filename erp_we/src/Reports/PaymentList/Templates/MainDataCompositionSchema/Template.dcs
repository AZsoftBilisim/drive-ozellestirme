		<field xsi:type="DataSetFieldField">
			<dataPath>Currency</dataPath>
			<field>Currency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CashExchangeRates.Currency AS CashExchangeRateCurrency,
	ISNULL(CashExchangeRates.CourseNumerator, 1) AS ExchangeRate,
	ISNULL(CashExchangeRates.CourseDenominator, 1) AS CashMultiplier
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;BeginOfPeriod}, BaseCurrency = &amp;BaseCurrency) AS CashExchangeRates
WHERE
	CashExchangeRates.CourseDenominator &lt;&gt; 0
	AND CashExchangeRates.CourseNumerator &lt;&gt; 0</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>ConversionRatesOfDSIntoSingleCurrency</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>RatioOfCashConversionToOneCurrency</dataPath>
			<field>RatioOfCashConversionToOneCurrency</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Ratio of cash conversion to one currency</v8:content>
