	<totalField>
		<dataPath>SumBalance</dataPath>
		<expression>Sum(SumBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>0</expression>
		<group>PaymentObject</group>
		<group>CashFlowItem</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Sum(SumBalance)</expression>
		<group>Currency</group>
		<group>BankAccountCashAccount</group>
		<group>Organization</group>
	</totalField>
	<totalField>
		<dataPath>BalanceInASingleCurrency</dataPath>
		<expression>Sum(BalanceInASingleCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>PaymentAmount</dataPath>
		<expression>Sum(PaymentAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>EvalExpression("Max(SumBalance)", "PaymentDate", "Overall", "First", "Current") +
EvalExpression("IsNull(Sum(Sum), 0)", "PaymentDate", "Group", "First", "Current")</expression>
		<group>Currency</group>
		<group>BankAccountCashAccount</group>
		<group>Organization</group>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Sum(Sum)</expression>
		<group>PaymentObject</group>
		<group>CashFlowItem</group>
	</totalField>
	<totalField>
		<dataPath>AmountInASingleCurrency</dataPath>
		<expression>EvalExpression("Sum(BalanceInASingleCurrency)", "PaymentDate", "Overall", "First", "Current") +
EvalExpression("IsNull(Sum(AmountInASingleCurrency), 0)", "PaymentDate", "Group", "First", "Current")</expression>
		<group>Organization</group>
	</totalField>
	<totalField>
		<dataPath>AmountInASingleCurrency</dataPath>
		<expression>Sum(AmountInASingleCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountOfPaymentInThePaymentCurrency</dataPath>
		<expression>Sum(AmountOfPaymentInThePaymentCurrency)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountOfPaymentInASingleCurrency</dataPath>
		<expression>Sum(AmountOfPaymentInASingleCurrency)</expression>
	</totalField>
