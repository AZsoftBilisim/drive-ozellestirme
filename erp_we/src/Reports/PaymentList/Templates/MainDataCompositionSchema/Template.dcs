		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	BankAccountCash.BankAccount AS BankAccountCashAccount,
	BankAccountCash.SumBalance - BankAccountCash.ToWriteOffBalance + BankAccountCash.ToReceive_Balance AS SumBalance
FROM
	AccumulationRegister.BankAccountCash.Balance(
		{&amp;BeginOfPeriod},
		{(Organization).*, (BankAccount).* AS BankAccountCashAccount}
		) AS BankAccountCash

UNION ALL

SELECT
	CashAccountBalance.CashAccount AS BankAccountCashAccount,
	CashAccountBalance.SumBalance AS SumBalance
FROM
	AccumulationRegister.CashAccountBalance.Balance(
		{&amp;BeginOfPeriod},
		{(Organization).*, (CashAccount).* AS BankAccountCashAccount}
		) AS CashAccountBalance</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>RatesOfConversionOfPaymentsIntoSingleCurrency</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>RatioOfPaymentConversionToOneCurrency</dataPath>
			<field>RatioOfPaymentConversionToOneCurrency</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Ratio of payment conversion to one currency</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نسبت تبدیل پرداخت به یک ارز</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Tasso di conversione di un pagamento in una valuta</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Współczynnik konwersji płatności do jednej waluty</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Коэффициент пересчета платежа в одну валюту</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Nakit ödemenin tek para birimine dönüştürme oranı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tỷ giá chuyển đổi tiền tệ đơn</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PaymentCurrency</dataPath>
			<field>PaymentCurrency</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Payment currency</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>ارز پرداخت</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Valuta di pagamento</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Waluta płatności</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Валюта платежа</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Ödeme para birimi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tiền tệ thanh toán</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Currency</dataPath>
			<field>Currency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS PaymentCurrency,
	CurrencyExchangeRate.CourseNumerator * SingleCurrencyExchangeRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator * SingleCurrencyExchangeRate.CourseNumerator) AS RatioOfPaymentConversionToOneCurrency
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;BeginOfPeriod}, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast({&amp;BeginOfPeriod}, Currency = &amp;TotalCurrency AND BaseCurrency = &amp;BaseCurrency) AS SingleCurrencyExchangeRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND SingleCurrencyExchangeRate.CourseNumerator &lt;&gt; 0</query>
	</dataSet>
