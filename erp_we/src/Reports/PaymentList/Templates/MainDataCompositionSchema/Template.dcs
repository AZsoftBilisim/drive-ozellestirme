	<calculatedField>
		<dataPath>AmountOfPaymentInThePaymentCurrency</dataPath>
		<expression>Case When PaymentCurrency = CashCurrency Then
		PaymentAmount
	When Not ValueIsFilled(CashCurrency) Then
		PaymentAmount
	Else
		PaymentAmount * (PaymentExchangeRate * CashMultiplier) / (ExchangeRate * PaymentMultiplier)
End</expression>
