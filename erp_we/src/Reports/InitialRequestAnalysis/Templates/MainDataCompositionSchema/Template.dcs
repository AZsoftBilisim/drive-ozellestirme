					<v8:content>Segment klientów</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сегмент клиентов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Müşteri segmenti</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Phân khúc khách hàng</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.PartnersSegments</v8:Type>
			</valueType>
			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceParameters</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameters">
						<dcscor:item>
							<dcscor:choiceParameter>Filter.GenerationMethod</dcscor:choiceParameter>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.UpdateRegularly</dcscor:value>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.GenerateManually</dcscor:value>
						</dcscor:item>
					</dcscor:value>
				</dcscor:item>
				<dcscor:item>
					<dcscor:parameter>ChoiceFoldersAndItems</dcscor:parameter>
					<dcscor:value xmlns:d6p1="http://v8.1c.ru/8.1/data/enterprise" xsi:type="d6p1:FoldersAndItemsUse">Items</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	1 AS TransactionNumber,
	0 AS NumberOfPartners,
	SourcesOfInitialRequests.SalesOpportunity,
	SourcesOfInitialRequests.Partner AS Partner,
	SourcesOfInitialRequests.SalesOpportunity.StartDate,
	DATETIME(1,1,1,1,1,1) AS RegistrationDate,
	SourcesOfInitialRequests.ChannelOfInitialRequest,
	CASE
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest.Ref IS NULL 
			THEN "Streetpiccadilly"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.MarketingActivities
			THEN "StringMarketingEvent"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Users
			THEN "UserString"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Partners
			THEN "StringClient"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.ContactPersonsForPartners
			THEN "Strokestartlinecap"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Persons
			THEN "Strategicheskaia"
		ELSE "Streetpiccadilly"
	END AS SourceType,
	SourcesOfInitialRequests.SourceOfInitialRequest
FROM
	InformationRegister.SourcesOfInitialRequests AS SourcesOfInitialRequests
WHERE
	SourcesOfInitialRequests.SalesOpportunity &lt;&gt; VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
	AND NOT SourcesOfInitialRequests.SalesOpportunity.DeletionMark
{WHERE
	(SourcesOfInitialRequests.SalesOpportunity.StartDate &gt;= &amp;BeginOfPeriod),
	(SourcesOfInitialRequests.SalesOpportunity.StartDate &lt;= &amp;PeriodEnding),
	(SourcesOfInitialRequests.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	(CASE
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest.Ref IS NULL 
			THEN "Streetpiccadilly"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.MarketingActivities
			THEN "StringMarketingEvent"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Users
			THEN "UserString"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Partners
			THEN "StringClient"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.ContactPersonsForPartners
			THEN "Strokestartlinecap"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Persons
			THEN "Strategicheskaia"
		ELSE "Streetpiccadilly"
	END) AS SourceType}

UNION ALL

SELECT
	0,
	1,
	VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef),
	SourcesOfInitialRequests.Partner,
	DATETIME(1,1,1,1,1,1),
	SourcesOfInitialRequests.Partner.RegistrationDate,
	SourcesOfInitialRequests.ChannelOfInitialRequest,
	CASE
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest.Ref IS NULL 
			THEN "Streetpiccadilly"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.MarketingActivities
			THEN "StringMarketingEvent"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Users
			THEN "UserString"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Partners
			THEN "StringClient"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.ContactPersonsForPartners
			THEN "Strokestartlinecap"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Persons
			THEN "Strategicheskaia"
		ELSE "Streetpiccadilly"
	END,
	SourcesOfInitialRequests.SourceOfInitialRequest
FROM
	InformationRegister.SourcesOfInitialRequests AS SourcesOfInitialRequests
WHERE
	SourcesOfInitialRequests.SalesOpportunity = VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
{WHERE
	(SourcesOfInitialRequests.Partner.RegistrationDate &gt;= &amp;BeginOfPeriod),
	(SourcesOfInitialRequests.Partner.RegistrationDate &lt;= &amp;PeriodEnding),
	(SourcesOfInitialRequests.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	(CASE
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest.Ref IS NULL 
			THEN "Streetpiccadilly"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.MarketingActivities
			THEN "StringMarketingEvent"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Users
			THEN "UserString"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Partners
			THEN "StringClient"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.ContactPersonsForPartners
			THEN "Strokestartlinecap"
		WHEN SourcesOfInitialRequests.SourceOfInitialRequest REFS Catalog.Persons
			THEN "Strategicheskaia"
		ELSE "Streetpiccadilly"
	END) AS SourceType}</query>
	</dataSet>
	<totalField>
		<dataPath>TransactionNumber</dataPath>
		<expression>Sum(TransactionNumber)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfPartners</dataPath>
		<expression>Count(Distinct Partner)</expression>
	</totalField>
