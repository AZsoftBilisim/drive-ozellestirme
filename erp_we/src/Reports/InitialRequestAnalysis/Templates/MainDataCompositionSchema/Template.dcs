		<field xsi:type="DataSetFieldField">
			<dataPath>PartnersSegment</dataPath>
			<field>PartnersSegment</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Customer segment</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>بخش مشتری</v8:content>
				</v8:item>
				<v8:item>
