		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ABCXYZCustomerClassification.Period AS Period
INTO SelectedPeriods
FROM
	InformationRegister.ABCXYZCustomerClassification AS ABCXYZCustomerClassification
WHERE
	ABCXYZCustomerClassification.ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)
{WHERE
	(ABCXYZCustomerClassification.Period &gt;= &amp;BeginOfPeriod),
	(ABCXYZCustomerClassification.Period &lt;= &amp;PeriodEnding),
	ABCXYZCustomerClassification.ClassificationParameterType.*,
	ABCXYZCustomerClassification.Partner.*}

GROUP BY
	ABCXYZCustomerClassification.Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SelectedPeriods.Period AS Period,
	Partners.Ref AS Partner,
	TypesOfClassificationParameters.Ref AS ClassificationParameterType
INTO PartnersForPeriod
FROM
	SelectedPeriods AS SelectedPeriods
		LEFT JOIN Catalog.Partners AS Partners
		ON (Partners.RegistrationDate &lt; SelectedPeriods.Period)
			AND (Partners.Client),
	Enum.TypesOfClassificationParameters AS TypesOfClassificationParameters
WHERE
	TypesOfClassificationParameters.Ref IN
			(SELECT
				VALUE(Enum.TypesOfClassificationParameters.GrossProfit) AS ClassificationParameter
			FROM
				Constants AS Constants
			WHERE
				Constants.UseABCXYZClassificationOfPartnersByGrossProfit = TRUE
		
			UNION ALL
		
			SELECT
				VALUE(Enum.TypesOfClassificationParameters.Revenue)
			FROM
				Constants AS Constants
			WHERE
				Constants.UseABCXYZClassificationOfPartnersByRevenue = TRUE
		
			UNION ALL
		
			SELECT
				VALUE(Enum.TypesOfClassificationParameters.Count)
			FROM
				Constants AS Constants
			WHERE
				Constants.UseABCXYZClassificationOfPartnersByNumberOfSales = TRUE)
{WHERE
	(Partners.Ref IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	Partners.Ref.* AS Partner,
	TypesOfClassificationParameters.Ref.* AS ClassificationParameterType}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	PartnersForPeriod.Period AS Period,
	PartnersForPeriod.Partner AS Partner,
	PartnersForPeriod.ClassificationParameterType AS ClassificationParameterType,
	ABCXYZCustomerClassification.ClassificationParameterValue AS ClassificationParameterValue,
	ABCXYZCustomerClassification.Class AS Class,
	CASE
		WHEN ABCXYZCustomerClassification.Class IS NULL 
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.PotentialCustomer)
		WHEN ABCXYZCustomerClassification.Class = VALUE(Enum.XYZClassification.ZClass)
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.OneTimeCustomer)
		WHEN ABCXYZCustomerClassification.Class = VALUE(Enum.XYZClassification.NotClassified)
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.LostCustomer)
		ELSE VALUE(Enum.PhasesOfRelationshipsWithCustomers.LoyalCustomer)
	END AS RelationshipStage,
	CASE
		WHEN ABCXYZCustomerClassificationSliceLast.Class IS NULL 
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.PotentialCustomer)
		WHEN ABCXYZCustomerClassificationSliceLast.Class = VALUE(Enum.XYZClassification.ZClass)
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.OneTimeCustomer)
		WHEN ABCXYZCustomerClassificationSliceLast.Class = VALUE(Enum.XYZClassification.NotClassified)
			THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.LostCustomer)
		ELSE VALUE(Enum.PhasesOfRelationshipsWithCustomers.LoyalCustomer)
	END AS CurrentRelationshipStage,
	ABCXYZCustomerClassificationSliceLast.Class AS CurrentClass,
	ABCXYZCustomerClassificationSliceLast.ClassificationParameterValue AS CurrentValueOfClassificationParameter
{SELECT
	Period,
	Partner,
	ClassificationParameterType,
	RelationshipStage.*,
	CurrentRelationshipStage.*,
	Class.*,
	ClassificationParameterValue,
	CurrentClass.*,
	CurrentValueOfClassificationParameter}
FROM
	PartnersForPeriod AS PartnersForPeriod
		LEFT JOIN InformationRegister.ABCXYZCustomerClassification AS ABCXYZCustomerClassification
			LEFT JOIN InformationRegister.ABCXYZCustomerClassification.SliceLast AS ABCXYZCustomerClassificationSliceLast
			ON ABCXYZCustomerClassification.Partner = ABCXYZCustomerClassificationSliceLast.Partner
				AND ABCXYZCustomerClassification.ClassificationParameterType = ABCXYZCustomerClassificationSliceLast.ClassificationParameterType
				AND ABCXYZCustomerClassification.ClassificationType = ABCXYZCustomerClassificationSliceLast.ClassificationType
		ON PartnersForPeriod.ClassificationParameterType = ABCXYZCustomerClassification.ClassificationParameterType
			AND PartnersForPeriod.Period = ABCXYZCustomerClassification.Period
			AND PartnersForPeriod.Partner = ABCXYZCustomerClassification.Partner
			AND (ABCXYZCustomerClassification.ClassificationType = VALUE(Enum.TypesOfClassification.XYZ))
{WHERE
	PartnersForPeriod.ClassificationParameterType.*,
	(CASE
			WHEN ABCXYZCustomerClassification.Class IS NULL 
				THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.PotentialCustomer)
			WHEN ABCXYZCustomerClassification.Class = VALUE(Enum.XYZClassification.ZClass)
				THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.OneTimeCustomer)
			WHEN ABCXYZCustomerClassification.Class = VALUE(Enum.XYZClassification.NotClassified)
				THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.LostCustomer)
			ELSE VALUE(Enum.PhasesOfRelationshipsWithCustomers.LoyalCustomer)
		END).* AS RelationshipStage,
	PartnersForPeriod.ClassificationParameterType.*,
	(CASE
			WHEN ABCXYZCustomerClassificationSliceLast.Class IS NULL 
				THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.PotentialCustomer)
			WHEN ABCXYZCustomerClassificationSliceLast.Class = VALUE(Enum.XYZClassification.ZClass)
				THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.OneTimeCustomer)
			WHEN ABCXYZCustomerClassificationSliceLast.Class = VALUE(Enum.XYZClassification.NotClassified)
				THEN VALUE(Enum.PhasesOfRelationshipsWithCustomers.LostCustomer)
			ELSE VALUE(Enum.PhasesOfRelationshipsWithCustomers.LoyalCustomer)
		END).* AS CurrentRelationshipStage,
	PartnersForPeriod.Partner.*,
	ABCXYZCustomerClassificationSliceLast.Class.* AS CurrentClass,
	ABCXYZCustomerClassificationSliceLast.ClassificationParameterValue AS CurrentValueOfClassificationParameter}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
