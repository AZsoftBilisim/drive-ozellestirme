				<field>Purpose</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE           AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products   AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE                  AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.*        AS ProductSegment,
	Segments.Products.*   AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN CompanyGoods.Recorder = UNDEFINED
			THEN NULL
		ELSE CompanyGoods.Recorder
	END                                                                         AS Recorder,
	
	CompanyGoods.SecondPeriod                                               AS SecondPeriod,
	CompanyGoods.DayPeriod                                                  AS DayPeriod,
	CompanyGoods.WeekPeriod                                                AS WeekPeriod,
	CompanyGoods.TenDaysPeriod                                                AS TenDaysPeriod,
	CompanyGoods.MonthPeriod                                                 AS MonthPeriod,
	CompanyGoods.QuarterPeriod                                               AS QuarterPeriod,
	CompanyGoods.HalfYearPeriod                                             AS HalfYearPeriod,
	CompanyGoods.YearPeriod                                                   AS YearPeriod,
	
	CompanyGoods.Organization                                                 AS Organization,
	DimensionOfProductItem.Products                                            AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure                           AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports                          AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports               AS UnitFactorForReports,
	&amp;QueryTextItemWeight                                                  AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem                                                AS ProductsVolume,
	DimensionOfProductItem.Characteristic                                          AS Characteristic,
	DimensionOfProductItem.Purpose                                              AS Purpose,
	DimensionOfProductItem.Series                                                   AS Series,
	DimensionOfProductItem.Partner                                                 AS Toller,
	DimensionOfProductItem.Contract                                                 AS Contract,
	CompanyGoods.InventoryOwnerAttribute                                                  AS InventoryOwnerAttribute,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN
				CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END                                                                         AS CountOpeningBalance,
	CompanyGoods.CountOpeningBalance * &amp;QueryTextItemWeight   AS StartBalanceWeight,
	CompanyGoods.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem AS StartBalanceVolume,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN
				CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END                                                                         AS CountClosingBalance,
	CompanyGoods.CountClosingBalance  * &amp;QueryTextItemWeight   AS ClosingBalanceWeight,
	CompanyGoods.CountClosingBalance  * &amp;QueryTextTheVolumeOfTheItem AS ClosingBalanceVolume
	
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(,, Auto) AS CompanyGoods
		
	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	ON CompanyGoods.ItemsLocationAttributes = DimensionOfProductItem.Ref
WHERE
	DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	AND (DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.TransferToTolling2_5)
		OR DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.SubcontractingToTheEAEUCountries))
{WHERE
	DimensionOfProductItem.Products.*   AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.Purpose.*     AS Purpose,
	DimensionOfProductItem.Partner.*        AS Toller,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DimensionOfProductItem.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>GoodsTransferredToProcessorsTurnover</name>
