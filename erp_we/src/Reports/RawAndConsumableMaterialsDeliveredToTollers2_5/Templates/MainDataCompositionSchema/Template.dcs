			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountReceipt</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>StartBalanceWeight</dataPath>
		<expression>Sum(StartBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceWeight</dataPath>
		<expression>Sum(ClosingBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ReceiptWeight</dataPath>
		<expression>Sum(ReceiptWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ReceiptVolume</dataPath>
		<expression>Sum(ReceiptVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>SpentQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(SpentQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SpentWeight</dataPath>
		<expression>Sum(SpentWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>SpentVolume</dataPath>
		<expression>Sum(SpentVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>StartBalanceVolume</dataPath>
		<expression>Sum(StartBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceVolume</dataPath>
		<expression>Sum(ClosingBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityConsumed</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(QuantityConsumed)
End</expression>
	</totalField>
	<totalField>
		<dataPath>WrittenOffWeight</dataPath>
		<expression>Sum(WrittenOffWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>WrittenOffVolume</dataPath>
		<expression>Sum(WrittenOffVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ReceivedWeight</dataPath>
		<expression>Sum(ReceivedWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ReceivedVolume_</dataPath>
		<expression>Sum(ReceivedVolume_)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityReceived_</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(QuantityReceived_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityProduced</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(QuantityProduced)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ProducedWeight</dataPath>
		<expression>Sum(ProducedWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ProducedVolume</dataPath>
		<expression>Sum(ProducedVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ToTransfer</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ToTransfer)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToTransferWeight</dataPath>
		<expression>Sum(ToTransferWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ToTransferVolume</dataPath>
		<expression>Sum(ToTransferVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ToReceive</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ToReceive)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ForAdmissionWeight</dataPath>
		<expression>Sum(ForAdmissionWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ToReceiveVolume</dataPath>
		<expression>Sum(ToReceiveVolume)</expression>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
