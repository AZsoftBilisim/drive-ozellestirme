				<dataPath>RowCode</dataPath>
				<field>RowCode</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Warehouse</dataPath>
				<field>Warehouse</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PurchaseOrder</dataPath>
				<field>PurchaseOrder</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ReferenceOrder</dataPath>
				<field>ReferenceOrder</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Factor</dataPath>
				<field>Factor</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE           AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products   AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE                  AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.*        AS ProductSegment,
	Segments.Products.*   AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.Recorder                                   AS Recorder,
	
	CompanyGoods.SecondPeriod                                 AS SecondPeriod,
	CompanyGoods.DayPeriod                                    AS DayPeriod,
	CompanyGoods.WeekPeriod                                  AS WeekPeriod,
	CompanyGoods.TenDaysPeriod                                  AS TenDaysPeriod,
	CompanyGoods.MonthPeriod                                   AS MonthPeriod,
	CompanyGoods.QuarterPeriod                                 AS QuarterPeriod,
	CompanyGoods.HalfYearPeriod                               AS HalfYearPeriod,
	CompanyGoods.YearPeriod                                     AS YearPeriod,
	
	CompanyGoods.Organization                                   AS Organization,
	DimensionOfProductItem.Products                              AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure             AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports            AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight                                    AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem                                  AS ProductsVolume,
	DimensionOfProductItem.Characteristic                            AS Characteristic,
	DimensionOfProductItem.Purpose                                AS Purpose,
	DimensionOfProductItem.Series                                     AS Series,
	DimensionOfProductItem.Partner                                   AS Toller,
	DimensionOfProductItem.Contract                                   AS Contract,
	CompanyGoods.InventoryOwnerAttribute                                    AS InventoryOwnerAttribute,
	
	0                                                               AS ToTransfer,
	0                                                               AS ToTransferWeight,
	0                                                               AS ToTransferVolume,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5)
			THEN 0
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountReceipt
		WHEN &amp;QuantityUnits = 1
			THEN
				CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END                                                                         AS CountReceipt,
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5)
			THEN 0
		ELSE CompanyGoods.CountReceipt * &amp;QueryTextItemWeight
	END                                                                         AS ReceiptWeight,
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5)
			THEN 0
		ELSE CompanyGoods.CountReceipt * &amp;QueryTextTheVolumeOfTheItem
	END                                                                         AS ReceiptVolume,
	
	CASE
		WHEN NOT VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			AND NOT (VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5))
			THEN 0
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountReceipt
		WHEN &amp;QuantityUnits = 1
			THEN
				CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END                                                                         AS QuantityProduced,
	CASE
		WHEN NOT VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			AND NOT (VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5))
			THEN 0
		ELSE CompanyGoods.CountReceipt * &amp;QueryTextItemWeight
	END                                                                         AS ProducedWeight,
	CASE
		WHEN NOT VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			AND NOT (VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5))
			THEN 0
		ELSE CompanyGoods.CountReceipt * &amp;QueryTextTheVolumeOfTheItem
	END                                                                         AS ProducedVolume,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5)
			THEN
				CASE
					WHEN &amp;QuantityUnits = 0
						THEN CompanyGoods.CountExpense
					WHEN &amp;QuantityUnits = 1
						THEN
							CASE
								WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
									THEN CompanyGoods.CountExpense
											/ DimensionOfProductItem.Products.UnitFactorForReports
								ELSE 0
							END
				END
		ELSE 0
	END                                                           AS SpentQuantity,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5)
			THEN CompanyGoods.CountExpense * &amp;QueryTextItemWeight
		ELSE 0
	END                                                           AS SpentWeight,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.SubcontractorReport2_5)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.SubcontractorReport2_5)
			THEN CompanyGoods.CountExpense * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END                                                           AS SpentVolume,
	
	0                                                               AS ToReceive,
	0                                                               AS ForAdmissionWeight,
	0                                                               AS ToReceiveVolume,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReceiptOfGoodsFromCustodian)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.ReceiptOfGoodsFromCustodian)
			THEN
				CASE
					WHEN &amp;QuantityUnits = 0
						THEN CompanyGoods.CountExpense
					WHEN &amp;QuantityUnits = 1
						THEN
							CASE
								WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
									THEN CompanyGoods.CountExpense
											/ DimensionOfProductItem.Products.UnitFactorForReports
								ELSE 0
							END
				END
		ELSE 0
	END                                                           AS QuantityReceived_,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReceiptOfGoodsFromCustodian)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.ReceiptOfGoodsFromCustodian)
			THEN CompanyGoods.CountExpense * &amp;QueryTextItemWeight
		ELSE 0
	END                                                           AS ReceivedWeight,
	
	CASE 
		WHEN VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReceiptOfGoodsFromCustodian)
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) = TYPE(Document.ReceiptOfGoodsFromCustodian)
			THEN CompanyGoods.CountExpense * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END                                                           AS ReceivedVolume_,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) IN
				(TYPE(Document.RedemptionOfGoodsByCustodian),
				TYPE(Document.WriteOffOfShippedGoods),
				TYPE(Document.MisgradingOfGoodsAtCustodian),
				TYPE(Document.DamageAtCustodian))
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) IN
					(TYPE(Document.RedemptionOfGoodsByCustodian),
					TYPE(Document.WriteOffOfShippedGoods),
					TYPE(Document.MisgradingOfGoodsAtCustodian),
					TYPE(Document.DamageAtCustodian))
			THEN
				CASE
					WHEN &amp;QuantityUnits = 0
						THEN CompanyGoods.CountExpense
					WHEN &amp;QuantityUnits = 1
						THEN
							CASE
								WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
									THEN CompanyGoods.CountExpense
											/ DimensionOfProductItem.Products.UnitFactorForReports
								ELSE 0
							END
				END
		ELSE 0
	END                                                           AS QuantityConsumed,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) IN
				(TYPE(Document.RedemptionOfGoodsByCustodian),
				TYPE(Document.WriteOffOfShippedGoods),
				TYPE(Document.MisgradingOfGoodsAtCustodian),
				TYPE(Document.DamageAtCustodian))
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) IN
					(TYPE(Document.RedemptionOfGoodsByCustodian),
					TYPE(Document.WriteOffOfShippedGoods),
					TYPE(Document.MisgradingOfGoodsAtCustodian),
					TYPE(Document.DamageAtCustodian))
			THEN CompanyGoods.CountExpense * &amp;QueryTextItemWeight
		ELSE 0
	END                                                           AS WrittenOffWeight,
	
	CASE
		WHEN VALUETYPE(CompanyGoods.Recorder) IN
				(TYPE(Document.RedemptionOfGoodsByCustodian),
				TYPE(Document.WriteOffOfShippedGoods),
				TYPE(Document.MisgradingOfGoodsAtCustodian),
				TYPE(Document.DamageAtCustodian))
			OR VALUETYPE(CompanyGoods.Recorder) = TYPE(Document.ReversingEntry)
				AND VALUETYPE(CAST(CompanyGoods.Recorder AS Document.ReversingEntry).ReversedDocument) IN
					(TYPE(Document.RedemptionOfGoodsByCustodian),
					TYPE(Document.WriteOffOfShippedGoods),
					TYPE(Document.MisgradingOfGoodsAtCustodian),
					TYPE(Document.DamageAtCustodian))
			THEN CompanyGoods.CountExpense * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END                                                           AS WrittenOffVolume
FROM
	AccumulationRegister.CompanyGoods.Turnovers(,, Auto) AS CompanyGoods
	
	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	ON CompanyGoods.ItemsLocationAttributes = DimensionOfProductItem.Ref
WHERE
	DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
	AND (DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.TransferToTolling2_5)
		OR DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.SubcontractingToTheEAEUCountries))
{WHERE
	DimensionOfProductItem.Products.*   AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.Purpose.*     AS Purpose,
	DimensionOfProductItem.Partner.*        AS Toller,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DimensionOfProductItem.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

UNION ALL

SELECT
	Orders.Recorder                               AS Recorder,
	
	Orders.SecondPeriod                             AS SecondPeriod,
	Orders.DayPeriod                                AS DayPeriod,
	Orders.WeekPeriod                              AS WeekPeriod,
	Orders.TenDaysPeriod                              AS TenDaysPeriod,
	Orders.MonthPeriod                               AS MonthPeriod,
	Orders.QuarterPeriod                             AS QuarterPeriod,
	Orders.HalfYearPeriod                           AS HalfYearPeriod,
	Orders.YearPeriod                                 AS YearPeriod,
	
	DocumentsRegistry.Organization                     AS Organization,
	Orders.Products                              AS Products,
	Orders.Products.UnitOfMeasure             AS StorageUnit,
	Orders.Products.UnitForReports            AS UnitForReports,
	Orders.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeightWithoutDimension         AS ProductsWeight,
	&amp;QueryTextItemVolumeWithoutDimension       AS ProductsVolume,
	Orders.Characteristic                            AS Characteristic,
	CASE
		WHEN ProductionStages.Purpose IS NOT NULL
			THEN ProductionStages.Purpose
		WHEN TRUE
			THEN ISNULL(OrdersToProcessor.Purpose, VALUE(Catalog.Assignments.EmptyRef))
	END                                            AS Purpose,
	Orders.Series                                     AS Series,
	DocumentsRegistry.Partner                         AS Toller,
	DocumentsRegistry.Contract                         AS Contract,
	VALUE(Catalog.InventoryKinds.EmptyRef)    AS InventoryOwnerAttribute,
	
	SUM(CASE
		WHEN &amp;QuantityUnits = 0
			THEN CASE
				WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
					THEN Orders.CountTurnover
				ELSE -Orders.CountTurnover
			END
		WHEN &amp;QuantityUnits = 1
			THEN
				CASE
					WHEN Orders.Products.UnitFactorForReports &lt;&gt; 0
						THEN CASE
							WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
								THEN Orders.CountTurnover
							ELSE -Orders.CountTurnover
						END / Orders.Products.UnitFactorForReports
					ELSE 0
				END
	END)                                            AS ToTransfer,
	SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
			THEN Orders.CountTurnover
		ELSE -Orders.CountTurnover
	END) * &amp;QueryTextItemWeightWithoutDimension   AS ToTransferWeight,
	SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
			THEN Orders.CountTurnover
		ELSE -Orders.CountTurnover
	END) * &amp;QueryTextItemVolumeWithoutDimension AS ToTransferVolume,
	
	0                                                AS CountReceipt,
	0                                                AS ReceiptWeight,
	0                                                AS ReceiptVolume,
	
	0                                                AS QuantityProduced,
	0                                                AS ProducedWeight,
	0                                                AS ProducedVolume,
	
	0                                                AS SpentQuantity,
	0                                                AS SpentWeight,
	0                                                AS SpentVolume,
	
	0                                                AS ToReceive,
	0                                                AS ForAdmissionWeight,
	0                                                AS ToReceiveVolume,
	
	0                                                AS QuantityReceived_,
	0                                                AS ReceivedWeight,
	0                                                AS ReceivedVolume_,
	
	0                                                AS QuantityConsumed,
	0                                                AS WrittenOffWeight,
	0                                                AS WrittenOffVolume
FROM
	AccumulationRegister.ShipmentAndReturnReferences.Turnovers(,, Auto,
		VALUETYPE(ReferenceOrder) = TYPE(Document.SubcontractOrder2_5)
		AND Factor IN (VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped))
		{Products.*   AS Products,
		Characteristic.* AS Characteristic}
	) AS Orders
	
	{LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	ON DocumentsRegistry.Ref = Orders.ReferenceOrder
	AND NOT DocumentsRegistry.AdditionalRecord
	
	LEFT JOIN Document.SubcontractOrder2_5.SupplyWithMaterialsAndWorks AS OrdersToProcessor
	ON OrdersToProcessor.Ref = Orders.ReferenceOrder
	AND OrdersToProcessor.RowCode = Orders.RowCode
	
	LEFT JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS ProductionStages
	ON ProductionStages.Ref.SubcontractOrder = Orders.ReferenceOrder
	AND ProductionStages.RowCode = Orders.ReferenceOrder
	}
	
{WHERE
	CASE
		WHEN ProductionStages.Purpose IS NOT NULL
			THEN ProductionStages.Purpose
		WHEN TRUE
			THEN ISNULL(OrdersToProcessor.Purpose, VALUE(Catalog.Assignments.EmptyRef))
	END                      AS Purpose,
	DocumentsRegistry.Partner.* AS Toller,
	((Orders.Products, Orders.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DocumentsRegistry.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
GROUP BY
	Orders.Recorder,
	Orders.SecondPeriod,
	Orders.DayPeriod,
	Orders.WeekPeriod,
	Orders.TenDaysPeriod,
	Orders.MonthPeriod,
	Orders.QuarterPeriod,
	Orders.HalfYearPeriod,
	Orders.YearPeriod,
	DocumentsRegistry.Organization,
	Orders.Products,
	Orders.Characteristic,
	CASE
		WHEN ProductionStages.Purpose IS NOT NULL
			THEN ProductionStages.Purpose
		WHEN TRUE
			THEN ISNULL(OrdersToProcessor.Purpose, VALUE(Catalog.Assignments.EmptyRef))
	END,
	Orders.Series,
	DocumentsRegistry.Partner,
	DocumentsRegistry.Contract
HAVING
	SUM(CASE
		WHEN &amp;QuantityUnits = 0
			THEN CASE
				WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
					THEN Orders.CountTurnover
				ELSE -Orders.CountTurnover
			END
		WHEN &amp;QuantityUnits = 1
			THEN
				CASE
					WHEN Orders.Products.UnitFactorForReports &lt;&gt; 0
						THEN CASE
							WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
								THEN Orders.CountTurnover
							ELSE -Orders.CountTurnover
						END / Orders.Products.UnitFactorForReports
					ELSE 0
				END
	END) &lt;&gt; 0
	OR SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
			THEN Orders.CountTurnover
		ELSE -Orders.CountTurnover
	END) * &amp;QueryTextItemWeightWithoutDimension &lt;&gt; 0
	OR SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
			THEN Orders.CountTurnover
		ELSE -Orders.CountTurnover
	END) * &amp;QueryTextItemVolumeWithoutDimension &lt;&gt; 0

UNION ALL

SELECT
	Orders.Recorder                               AS Recorder,
	
	Orders.SecondPeriod                             AS SecondPeriod,
	Orders.DayPeriod                                AS DayPeriod,
	Orders.WeekPeriod                              AS WeekPeriod,
	Orders.TenDaysPeriod                              AS TenDaysPeriod,
	Orders.MonthPeriod                               AS MonthPeriod,
	Orders.QuarterPeriod                             AS QuarterPeriod,
	Orders.HalfYearPeriod                           AS HalfYearPeriod,
	Orders.YearPeriod                                 AS YearPeriod,
	
	DocumentsRegistry.Organization                     AS Organization,
	Orders.Products                              AS Products,
	Orders.Products.UnitOfMeasure             AS StorageUnit,
	Orders.Products.UnitForReports            AS UnitForReports,
	Orders.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeightWithoutDimension         AS ProductsWeight,
	&amp;QueryTextItemVolumeWithoutDimension       AS ProductsVolume,
	Orders.Characteristic                            AS Characteristic,
	CASE
		WHEN StagesOfProductionOutputProducts.Purpose IS NOT NULL
			THEN StagesOfProductionOutputProducts.Purpose
		WHEN StagesOfProductionByProducts.Purpose IS NOT NULL
			THEN StagesOfProductionByProducts.Purpose
		WHEN OrdersToProcessorOutputProducts.Purpose IS NOT NULL
			THEN OrdersToProcessorOutputProducts.Purpose
		ELSE ISNULL(OrdersToProcessorByProducts.Purpose, VALUE(Catalog.Assignments.EmptyRef))
	END                                            AS Purpose,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	DocumentsRegistry.Partner                         AS Toller,
	DocumentsRegistry.Contract                         AS Contract,
	VALUE(Catalog.InventoryKinds.EmptyRef)    AS InventoryOwnerAttribute,
	
	0                                                AS ToTransfer,
	0                                                AS ToTransferWeight,
	0                                                AS ToTransferVolume,
	
	0                                                AS CountReceipt,
	0                                                AS ReceiptWeight,
	0                                                AS ReceiptVolume,
	
	0                                                AS QuantityProduced,
	0                                                AS ProducedWeight,
	0                                                AS ProducedVolume,
	
	0                                                AS SpentQuantity,
	0                                                AS SpentWeight,
	0                                                AS SpentVolume,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN Orders.ToReceiveReceipt - Orders.ToReceiveExpense
		WHEN &amp;QuantityUnits = 1
			THEN
				CASE
					WHEN Orders.Products.UnitFactorForReports &lt;&gt; 0
						THEN (Orders.ToReceiveReceipt - Orders.ToReceiveExpense)
								/ Orders.Products.UnitFactorForReports
					ELSE 0
				END
	END                                            AS ToReceive,
	(Orders.ToReceiveReceipt - Orders.ToReceiveExpense)
		* &amp;QueryTextItemWeightWithoutDimension   AS ForAdmissionWeight,
	(Orders.ToReceiveReceipt - Orders.ToReceiveExpense)
		* &amp;QueryTextItemVolumeWithoutDimension AS ToReceiveVolume,
	
	0                                                AS QuantityReceived_,
	0                                                AS ReceivedWeight,
	0                                                AS ReceivedVolume_,
	
	0                                                AS QuantityConsumed,
	0                                                AS WrittenOffWeight,
	0                                                AS WrittenOffVolume
FROM
	AccumulationRegister.PurchaseOrders.Turnovers(,, Auto,
		VALUETYPE(PurchaseOrder) = TYPE(Document.SubcontractOrder2_5)
		{Products.*   AS Products,
		Characteristic.* AS Characteristic}
	) AS Orders
	
	{LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	ON DocumentsRegistry.Ref = Orders.PurchaseOrder
	AND NOT DocumentsRegistry.AdditionalRecord
	
	LEFT JOIN Document.SubcontractOrder2_5.ManufacturedProducts AS OrdersToProcessorOutputProducts
	ON OrdersToProcessorOutputProducts.Ref = Orders.PurchaseOrder
	AND OrdersToProcessorOutputProducts.RowCode = Orders.RowCode
	
	LEFT JOIN Document.SubcontractOrder2_5.SideAndIntermediateRelease AS OrdersToProcessorByProducts
	ON OrdersToProcessorByProducts.Ref = Orders.PurchaseOrder
	AND OrdersToProcessorByProducts.RowCode = Orders.RowCode
	
	LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS StagesOfProductionOutputProducts
	ON StagesOfProductionOutputProducts.Ref = Orders.PurchaseOrder
	AND StagesOfProductionOutputProducts.RowCode = Orders.RowCode
	
	LEFT JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS StagesOfProductionByProducts
	ON StagesOfProductionByProducts.Ref = Orders.PurchaseOrder
	AND StagesOfProductionByProducts.RowCode = Orders.RowCode
	}
	
{WHERE
	CASE
		WHEN StagesOfProductionOutputProducts.Purpose IS NOT NULL
			THEN StagesOfProductionOutputProducts.Purpose
		WHEN StagesOfProductionByProducts.Purpose IS NOT NULL
			THEN StagesOfProductionByProducts.Purpose
		WHEN OrdersToProcessorOutputProducts.Purpose IS NOT NULL
			THEN OrdersToProcessorOutputProducts.Purpose
		ELSE ISNULL(OrdersToProcessorByProducts.Purpose, VALUE(Catalog.Assignments.EmptyRef))
	END                      AS Purpose,
	DocumentsRegistry.Partner.* AS Toller,
	((Orders.Products, Orders.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DocumentsRegistry.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità di misura</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>J. m.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ед. изм.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ölçü birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>ĐVT</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
