		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PayrollCalculationsHR.Organization AS Organization,
	PayrollCalculationsHR.Department AS Department,
	PayrollCalculationsHR.Individual AS Individual,
	PayrollCalculationsHR.FinRecordID AS FinRecordID,
	PayrollCalculationsHR.Sum AS Sum,
	PayrollCalculationsHR.SumMan AS SumMan,
	PayrollCalculationsHR.SumCompl AS SumCompl,
	PayrollCalculationsHR.BusinessTransactionSetting AS BusinessTransactionSetting,
	BEGINOFPERIOD(PayrollCalculationsHR.Period, MONTH) AS MonthOfSettlement,
	PayrollCalculationsHR.Period AS ActionPeriod,
	PayrollCalculationsHR.Employee AS Employee,
	PayrollCalculationsHR.AmountToBePaid AS AmountToBePaid
INTO PayrollCalculations
FROM
	AccumulationRegister.PayrollCalculationsHR AS PayrollCalculationsHR
WHERE
	PayrollCalculationsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PayrollCalculations.Organization AS Organization,
	PayrollCalculations.Department AS Department,
	PayrollCalculations.Individual AS Individual,
	PayrollCalculations.Sum AS Sum
INTO TemplateForZeroLines
FROM
	PayrollCalculations AS PayrollCalculations
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PayrollCalculations.Organization AS Organization,
	PayrollCalculations.Department AS Department,
	PayrollCalculations.Individual AS Individual,
	AccrualsHR.HoursWorked AS HoursWorked,
	AccrualsHR.DaysWorked AS DaysWorked,
	AccrualsHR.NormalWorkdays AS NormalWorkdays,
	AccrualsHR.NormOfHours AS NormOfHours,
	AccrualsHR.Accrual AS Accrual,
	AccrualsHR.Sum AS Sum,
	PayrollCalculations.BusinessTransactionSetting AS BusinessTransactionSetting,
	PayrollCalculations.MonthOfSettlement AS MonthOfSettlement,
	AccrualsHR.Period AS Period,
	AccrualsHR.Employee AS Employee
INTO Accrued
FROM
	PayrollCalculations AS PayrollCalculations
		LEFT JOIN AccumulationRegister.AccrualsHR AS AccrualsHR
		ON PayrollCalculations.Organization = AccrualsHR.Organization
		AND PayrollCalculations.Individual = AccrualsHR.Individual
		AND PayrollCalculations.FinRecordID = AccrualsHR.RowID
		AND PayrollCalculations.Department = AccrualsHR.Department
		AND PayrollCalculations.MonthOfSettlement = BEGINOFPERIOD(AccrualsHR.Period, MONTH)
WHERE
	PayrollCalculations.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.WageRecord)
	AND AccrualsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PayrollCalculations.Organization AS Organization,
	PayrollCalculations.Department AS Department,
	PayrollCalculations.Individual AS Individual,
	PayrollCalculations.FinRecordID AS FinRecordID,
	PayrollCalculations.BusinessTransactionSetting AS BusinessTransactionSetting,
	SUM(DeductionsHR.Sum) AS Sum,
	DeductionsHR.Retention AS Retention,
	PayrollCalculations.MonthOfSettlement AS MonthOfSettlement,
	DeductionsHR.Period AS Period
INTO Withheld
FROM
	PayrollCalculations AS PayrollCalculations
		LEFT JOIN AccumulationRegister.DeductionsHR AS DeductionsHR
		ON PayrollCalculations.Organization = DeductionsHR.Organization
		AND PayrollCalculations.Department = DeductionsHR.Department
		AND PayrollCalculations.Individual = DeductionsHR.Individual
		AND PayrollCalculations.FinRecordID = DeductionsHR.RowID
		AND PayrollCalculations.MonthOfSettlement = BEGINOFPERIOD(DeductionsHR.Period, MONTH)
WHERE
	(PayrollCalculations.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.DeductionFromAnEmployeeSalary)
			OR PayrollCalculations.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.DeductionOfNonSpentImprest))
	AND DeductionsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	PayrollCalculations.Organization,
	PayrollCalculations.Department,
	PayrollCalculations.Individual,
	PayrollCalculations.FinRecordID,
	PayrollCalculations.BusinessTransactionSetting,
	DeductionsHR.Retention,
	PayrollCalculations.MonthOfSettlement,
	DeductionsHR.Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PayrollCalculations.Organization AS Organization,
	PayrollCalculations.Department AS Department,
	PayrollCalculations.AmountToBePaid AS Amount_Paid,
	PayrollCalculations.Individual AS Individual,
	PayrollCalculations.BusinessTransactionSetting AS BusinessTransactionSetting,
	PayrollCalculations.MonthOfSettlement AS MonthOfSettlement,
	PayrollCalculations.ActionPeriod AS ActionPeriod
INTO Payments_
FROM
	PayrollCalculations AS PayrollCalculations
WHERE
	PayrollCalculations.BusinessTransactionSetting IN
	(VALUE(Catalog.BusinessTransactionsSettings.SalaryPaymentToBankAccounts),
		VALUE(Catalog.BusinessTransactionsSettings.SalaryPaymentViaCashAccount))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PayrollCalculations.Organization AS Organization,
	PayrollCalculations.Department AS Department,
	PayrollCalculations.Individual AS Individual,
	SUM(TaxesContributionsHR.Sum) AS Sum,
	TaxesContributionsHR.TaxKind AS TaxKind,
	PayrollCalculations.MonthOfSettlement AS MonthOfSettlement,
	TaxesContributionsHR.Period AS Period
INTO Taxes
FROM
	PayrollCalculations AS PayrollCalculations
		LEFT JOIN AccumulationRegister.TaxesContributionsHR AS TaxesContributionsHR
		ON PayrollCalculations.Organization = TaxesContributionsHR.Organization
		AND PayrollCalculations.Department = TaxesContributionsHR.Department
		AND PayrollCalculations.Individual = TaxesContributionsHR.Individual
		AND PayrollCalculations.FinRecordID = TaxesContributionsHR.RowID
		AND PayrollCalculations.MonthOfSettlement = BEGINOFPERIOD(TaxesContributionsHR.Period, MONTH)
WHERE
	TaxesContributionsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND
		PayrollCalculations.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.PersonalIncomeTaxRecord)

GROUP BY
	PayrollCalculations.Organization,
	PayrollCalculations.Department,
	PayrollCalculations.Individual,
	TaxesContributionsHR.TaxKind,
	PayrollCalculations.MonthOfSettlement,
	TaxesContributionsHR.Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	HRPayrollCalculationsBalancesBeginningOfPeriod.Organization AS Organization,
	HRPayrollCalculationsBalancesBeginningOfPeriod.Individual AS Individual,
	-HRPayrollCalculationsBalancesBeginningOfPeriod.SumOpeningBalance AS AmountOfDebt,
	&amp;DebtForPreviousPeriodsText AS TextOfDebtPeriod,
	1 AS OrderOfDebtLine,
	BEGINOFPERIOD(HRPayrollCalculationsBalancesBeginningOfPeriod.Period, MONTH) AS MonthOfSettlement
INTO Balance
FROM
	AccumulationRegister.PayrollCalculationsHR.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Month,,) AS
		HRPayrollCalculationsBalancesBeginningOfPeriod

UNION ALL

SELECT
	PayrollCalculations.Organization,
	PayrollCalculations.Individual,
	0,
	&amp;DebtForPreviousPeriodsText,
	1,
	PayrollCalculations.MonthOfSettlement
FROM
	PayrollCalculations AS PayrollCalculations
GROUP BY
	PayrollCalculations.Organization,
	PayrollCalculations.Individual,
	PayrollCalculations.MonthOfSettlement

UNION ALL

SELECT
	PayrollCalculations.Organization,
	PayrollCalculations.Individual,
	0,
	&amp;DebtAtEndOfPeriodText,
	2,
	PayrollCalculations.MonthOfSettlement
FROM
	PayrollCalculations AS PayrollCalculations
GROUP BY
	PayrollCalculations.Individual,
	PayrollCalculations.Organization,
	PayrollCalculations.MonthOfSettlement

UNION ALL

SELECT
	PayrollCalculationsHRBalanceAndTurnovers.Organization,
	PayrollCalculationsHRBalanceAndTurnovers.Individual,
	-PayrollCalculationsHRBalanceAndTurnovers.SumClosingBalance,
	&amp;DebtAtEndOfPeriodText,
	2,
	BEGINOFPERIOD(PayrollCalculationsHRBalanceAndTurnovers.Period, MONTH)
FROM
	AccumulationRegister.PayrollCalculationsHR.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Month,,) AS
		PayrollCalculationsHRBalanceAndTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Accrued.Organization AS Organization,
	Accrued.Department AS Department,
	Accrued.Individual AS Individual,
	Accrued.HoursWorked AS HoursWorked,
	Accrued.DaysWorked AS DaysWorked,
	Accrued.Accrual AS Kind,
	Accrued.Sum AS Sum,
	&amp;AccruedGroup AS Group,
	1 AS SortField,
	0 AS SortingWithinGroup,
	Accrued.MonthOfSettlement AS MonthOfSettlement,
	Accrued.Period AS ActionPeriod,
	Accrued.Employee AS Employee,
	RegularAccrualsAndDeductionsHRSliceLast.Value AS Salary_Tariff,
	EmploymentRecordSliceLast.JobTitle AS JobTitle
INTO SummaryCalculationData
FROM
	Accrued AS Accrued
		LEFT JOIN InformationRegister.EmploymentRecord.SliceLast(&amp;EndOfPeriod,) AS
			EmploymentRecordSliceLast
		ON Accrued.Employee = EmploymentRecordSliceLast.Employee
		AND Accrued.Organization = EmploymentRecordSliceLast.Organization
		AND Accrued.Department = EmploymentRecordSliceLast.Department
		LEFT JOIN InformationRegister.RegularAccrualsAndDeductionsHR.SliceLast(&amp;EndOfPeriod,) AS
			RegularAccrualsAndDeductionsHRSliceLast
		ON Accrued.Organization = RegularAccrualsAndDeductionsHRSliceLast.Organization
		AND Accrued.Department = RegularAccrualsAndDeductionsHRSliceLast.Department
		AND Accrued.Employee = RegularAccrualsAndDeductionsHRSliceLast.Employee
WHERE
	EmploymentRecordSliceLast.WorksInBusinessUnit
	AND RegularAccrualsAndDeductionsHRSliceLast.BasicEarnings

UNION ALL

SELECT
	Withheld.Organization,
	UNDEFINED,
	Withheld.Individual,
	NULL,
	NULL,
	Withheld.Retention,
	Withheld.Sum,
	&amp;WithheldGroup,
	2,
	0,
	Withheld.MonthOfSettlement,
	Withheld.Period,
	NULL,
	NULL,
	NULL
FROM
	Withheld AS Withheld

UNION ALL

SELECT
	Payments_.Organization,
	UNDEFINED,
	Payments_.Individual,
	NULL,
	NULL,
	NULL,
	Payments_.Amount_Paid,
	&amp;PaidGroup,
	3,
	0,
	Payments_.MonthOfSettlement,
	Payments_.MonthOfSettlement,
	NULL,
	NULL,
	NULL
FROM
	Payments_ AS Payments_

UNION ALL

SELECT
	Balance.Organization,
	UNDEFINED,
	Balance.Individual,
	NULL,
	NULL,
	Balance.TextOfDebtPeriod,
	SUM(Balance.AmountOfDebt),
	&amp;DebtGroup,
	4,
	Balance.OrderOfDebtLine,
	Balance.MonthOfSettlement,
	DATETIME(1, 1, 1),
	NULL,
	NULL,
	NULL
FROM
	Balance AS Balance
GROUP BY
	Balance.TextOfDebtPeriod,
	Balance.Individual,
	Balance.Organization,
	Balance.OrderOfDebtLine,
	Balance.MonthOfSettlement

UNION ALL

SELECT
	Taxes.Organization,
	UNDEFINED,
	Taxes.Individual,
	NULL,
	NULL,
	Taxes.TaxKind,
	Taxes.Sum,
	&amp;WithheldGroup,
	2,
	0,
	Taxes.MonthOfSettlement,
	Taxes.Period,
	NULL,
	NULL,
	NULL
FROM
	Taxes AS Taxes
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SummaryCalculationData.Organization AS Organization,
	SummaryCalculationData.Department AS Department,
	SummaryCalculationData.Individual AS Individual,
	SummaryCalculationData.HoursWorked AS HoursWorked,
	SummaryCalculationData.DaysWorked AS DaysWorked,
	SummaryCalculationData.Kind AS Kind,
	SummaryCalculationData.Sum AS Sum,
	SummaryCalculationData.Group AS Group,
	SummaryCalculationData.SortField AS SortField,
	SummaryCalculationData.MonthOfSettlement AS MonthOfAccrual,
	Persons.Description AS IndividualFULLName,
	SummaryCalculationData.JobTitle AS JobTitle,
	SummaryCalculationData.Salary_Tariff AS Salary_Tariff,
	SummaryCalculationData.Employee.Code AS EmployeeCode,
	SummaryCalculationData.SortingWithinGroup AS SortingWithinGroup,
	SummaryCalculationData.ActionPeriod AS ActionPeriod,
	SummaryCalculationData.Employee AS Employee
FROM
	SummaryCalculationData AS SummaryCalculationData
		LEFT JOIN Catalog.Persons AS Persons
		ON SummaryCalculationData.Individual = Persons.Ref

ORDER BY
	Individual,
	Organization,
	Department,
	SortField</query>
	</dataSet>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Sum(Sum)</expression>
	</totalField>
