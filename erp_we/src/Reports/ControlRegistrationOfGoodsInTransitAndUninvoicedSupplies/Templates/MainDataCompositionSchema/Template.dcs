					<v8:lang>pl</v8:lang>
					<v8:content>Do przyjęcia (+) / do sporządzenia (-)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>К поступлению (+) / к оформлению (-)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Teslim alınacak (+) / işlenecek (-)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Cần tiếp nhận (+) / để lập (-)</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>0</v8:Digits>
					<v8:FractionDigits>0</v8:FractionDigits>
					<v8:AllowedSign>Any</v8:AllowedSign>
				</v8:NumberQualifiers>
			</valueType>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MinHeight</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MaxHeight</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ImportDocumentType</dataPath>
			<field>ImportDocumentType</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// The text of the request is filled in automatically in the module of the object TextControl formationdocumentsreferences()

SELECT
	"" AS OperationKind,
	"" AS Recommendation,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
	VALUE(Catalog.InventoryKinds.EmptyRef) AS InventoryOwnerAttribute,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef) AS Counterparty,
	VALUE(Catalog.CCDNumbers.EmptyRef) AS CCDNumber,
	VALUE(Catalog.CounterpartyContracts.EmptyRef) AS Contract,
	0 AS Count
FROM
	AccumulationRegister.CompanyGoods.Balance AS ProductsFromPartnersAreLeftovers,
	AccumulationRegister.GoodsForRegistrationOfImportDocuments.Balance AS GoodsForRegistrationOfImportDocumentsBalance</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<totalField>
		<dataPath>Recommendation</dataPath>
		<expression>Recommendation</expression>
	</totalField>
