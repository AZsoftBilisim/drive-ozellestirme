			<dataPath>ItemsCollection</dataPath>
			<field>ItemsCollection</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Products.ProductCategory AS NProductCategory,
	Products.Brand AS PBrand,
	Products.ItemsCollection
INTO TTAllBrandCategories
FROM
	Catalog.Products AS Products
WHERE
	Products.Brand = &amp;Brand

GROUP BY
	Products.ProductCategory,
	Products.Brand,
	Products.ItemsCollection
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	K.PlanningObject AS PlanningObject,
	MAX(K.Period) AS Period
INTO CurQuotas
FROM
	InformationRegister.ProductMixQuotas AS K
WHERE
	K.Period &lt;= &amp;Period

GROUP BY
	K.PlanningObject

INDEX BY
	Period,
	PlanningObject
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Quotas.PlanningObject AS PStoreFormat,
	Quotas.ProductCategory.Owner AS NTypeOfProduct,
	Quotas.ProductCategory AS NProductCategory,
	Quotas.Brand AS PBrand,
	Quotas.Quota AS PQuota,
	Quotas.VariancePercentage AS NPercentageOfDeviation,
	Quotas.ItemsCollection AS NCollectionOfProducts
FROM
	InformationRegister.ProductMixQuotas.SliceLast(&amp;Period, Brand = &amp;Brand) AS Quotas
		INNER JOIN CurQuotas AS CurQuotas
		ON Quotas.Period = CurQuotas.Period
			AND Quotas.PlanningObject = CurQuotas.PlanningObject

UNION

SELECT
	StoreFormats.Ref,
	TTAllBrandCategories.NProductCategory.Owner,
	TTAllBrandCategories.NProductCategory,
	TTAllBrandCategories.PBrand,
	0,
	0,
	TTAllBrandCategories.ItemsCollection
FROM
	TTAllBrandCategories AS TTAllBrandCategories
		INNER JOIN Catalog.StoreFormats AS StoreFormats
		ON (NOT StoreFormats.IsFolder)
		INNER JOIN Constant.UseStoreFormats AS UseStoreFormats
		ON (TRUE)
WHERE
	UseStoreFormats.Value

UNION ALL

SELECT
	Warehouses.Ref,
	TTAllBrandCategories.NProductCategory.Owner,
	TTAllBrandCategories.NProductCategory,
	TTAllBrandCategories.PBrand,
	0,
	0,
	TTAllBrandCategories.ItemsCollection
FROM
	TTAllBrandCategories AS TTAllBrandCategories
		INNER JOIN Catalog.Warehouses AS Warehouses
		ON (NOT Warehouses.IsFolder)
		INNER JOIN Constant.UseStoreFormats AS UseStoreFormats
		ON (TRUE)
WHERE
	NOT UseStoreFormats.Value</query>
	</dataSet>
	<totalField>
		<dataPath>Quota</dataPath>
		<expression>Sum(Quota)</expression>
	</totalField>
	<totalField>
		<dataPath>VariancePercentage</dataPath>
		<expression>Avg(VariancePercentage)</expression>
	</totalField>
	<totalField>
		<dataPath>PQuota</dataPath>
		<expression>Sum(PQuota)</expression>
	</totalField>
	<totalField>
		<dataPath>NPercentageOfDeviation</dataPath>
		<expression>Avg(NPercentageOfDeviation)</expression>
	</totalField>
