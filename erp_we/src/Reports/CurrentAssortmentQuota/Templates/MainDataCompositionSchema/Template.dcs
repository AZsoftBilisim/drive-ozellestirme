	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>QuotaDataset</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ProductKind</dataPath>
			<field>ProductKind</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Item kind</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نوع قلم</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Tipo di articolo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Rodzaj pozycji</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вид номенклатуры</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Ürün türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Dạng mặt hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Quota</dataPath>
			<field>Quota</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Brand</dataPath>
			<field>Brand</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>VariancePercentage</dataPath>
			<field>VariancePercentage</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ProductCategory</dataPath>
			<field>ProductCategory</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>StoreFormat</dataPath>
			<field>StoreFormat</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Store format</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>قالب فروشگاه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Formato del negozio</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Format sklepu</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Формат магазина</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Mağaza formatı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Khuôn dạng cửa hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ItemsCollection</dataPath>
			<field>ItemsCollection</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PlanningObject</dataPath>
			<field>PlanningObject</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	K.PlanningObject AS PlanningObject,
	MAX(K.Period) AS Period
INTO CurQuotas
FROM
	InformationRegister.ProductMixQuotas AS K
WHERE
	K.Period &lt;= &amp;Period

GROUP BY
	K.PlanningObject

INDEX BY
	Period,
	PlanningObject
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Quotas.PlanningObject AS StoreFormat,
	Quotas.ProductCategory.Owner AS ProductKind,
	Quotas.ProductCategory AS ProductCategory,
	Quotas.Brand AS Brand,
	Quotas.Quota AS Quota,
	Quotas.VariancePercentage AS VariancePercentage,
	Quotas.ItemsCollection
FROM
	InformationRegister.ProductMixQuotas.SliceLast(&amp;Period, ) AS Quotas
		INNER JOIN CurQuotas AS CurQuotas
		ON Quotas.Period = CurQuotas.Period
			AND Quotas.PlanningObject = CurQuotas.PlanningObject</query>
	</dataSet>
