		<field xsi:type="DataSetFieldField">
			<dataPath>SettlementStartDate</dataPath>
			<field>SettlementStartDate</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Case 
When &amp;ComparisonPeriodStep = Value(Enum.Periodicity.Year) Then
    StringFunctionsClientServer.SubstituteParametersToString(
    	"%1 %2",
    	Format(SettlementStartDate, "DF=yyyy"),
	NStr("ru = 'г.'; vi = 'năm'; en = 'year'; it = 'anno'; pl = 'r.'; tr = 'yıl'"))
When &amp;ComparisonPeriodStep = Value(Enum.Periodicity.HalfYear) Then
    StringFunctionsClientServer.SubstituteParametersToString(
    	"%1%2%3 %4",
    	Format(SettlementStartDate, "DF=MM"),
	NStr("ru = '.'; vi = '.'; en = '.'; it = '.'; pl = '.'; tr = '.'"),	
    	Format(SettlementStartDate, "DF=yyyy"),
	NStr("ru = 'г.'; vi = 'năm'; en = 'year'; it = 'anno'; pl = 'r.'; tr = 'yıl'"))
When &amp;ComparisonPeriodStep = Value(Enum.Periodicity.Quarter) Then
    StringFunctionsClientServer.SubstituteParametersToString(
    	"%1 %2 %3 %4",
    	Format(SettlementStartDate, "DF=k"),
	NStr("ru = 'квартал'; vi = 'quý'; en = 'quarter'; it = 'trimestre'; pl = 'kwartał'; tr = 'çeyrek'"),
    	Format(SettlementStartDate, "DF=yyyy"),
	NStr("ru = 'г.'; vi = 'năm'; en = 'year'; it = 'anno'; pl = 'r.'; tr = 'yıl'"))
When &amp;ComparisonPeriodStep = Value(Enum.Periodicity.Month) Then
    StringFunctionsClientServer.SubstituteParametersToString(
    	"%1 %2 %3",
    	Format(SettlementStartDate, "DF=MMMM"),
    	Format(SettlementStartDate, "DF=yyyy"),
	NStr("ru = 'г.'; vi = 'năm'; en = 'year'; it = 'anno'; pl = 'r.'; tr = 'yıl'"))
When &amp;ComparisonPeriodStep = Value(Enum.Periodicity.Week)
    Or &amp;ComparisonPeriodStep = Value(Enum.Periodicity.Day) Then
    StringFunctionsClientServer.SubstituteParametersToString(
    	"%1 %2",
    	Format(SettlementStartDate, "DLF=D"),
    	NStr("ru = 'г.'; vi = 'năm'; en = 'year'; it = 'anno'; pl = 'r.'; tr = 'yıl'"))
End</presentationExpression>
			<orderExpression>
				<dcscom:expression>SettlementStartDate</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>false</dcscom:autoOrder>
			</orderExpression>
		</field>
