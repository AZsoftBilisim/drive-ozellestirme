		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;SettlementStartDate AS SettlementStartDate,
	&amp;SettlementEndDate AS SettlementEndDate,
	RevenueAndCOGS.Department AS Department,
	RevenueAndCOGS.AccountingDimensionByPartners.Partner AS Partner,
	RevenueAndCOGS.AccountingDimensionByPartners.Partner.BusinessRegion AS BusinessRegion,
	RevenueAndCOGS.AccountingDimensionByPartners.Organization AS Organization,
	RevenueAndCOGS.AccountingDimensionByPartners.LineOfBusiness AS LineOfBusiness,
	RevenueAndCOGS.ItemsLocationAttributes.Products AS Products,
	RevenueAndCOGS.ItemsLocationAttributes.Products.UnitOfMeasure AS StorageUnit,
	RevenueAndCOGS.ItemsLocationAttributes.Products.UnitForReports AS UnitForReports,
	RevenueAndCOGS.ItemsLocationAttributes.Products.UnitFactorForReports AS UnitFactorForReports,
	RevenueAndCOGS.ItemsLocationAttributes.Characteristic AS Characteristic,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	RevenueAndCOGS.SalesOrder.Manager AS Manager,
	RevenueAndCOGS.SalesOrder AS SalesOrder,
	RevenueAndCOGS.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CASE WHEN &amp;ReportData = 3 THEN
		RevenueAndCOGS.AccountingDimensionByPartners.Organization.LocalAccountingCurrency
	ELSE
		&amp;ManagementAccountingCurrency
	END AS Currency,
	CASE
		WHEN RevenueAndCOGS.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
			THEN RevenueAndCOGS.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
		ELSE RevenueAndCOGS.InventoryOwnerAttribute.GoodsOwner
	END AS Vendor,
	SUM(RevenueAndCOGS.CountTurnover) AS Count,
	SUM(CASE
			WHEN &amp;ReportData = 1
				THEN RevenueAndCOGS.RevenueAmountTurnover
			WHEN &amp;ReportData = 2
				THEN RevenueAndCOGS.RevenueAmountExcludingVATTurnover
			WHEN &amp;ReportData = 3
				THEN RevenueAndCOGS.RevenueAmountExclVATLocalTurnover
		END) AS Revenue,
	SUM(CASE
			WHEN RevenueAndCOGS.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN CASE
						WHEN &amp;ReportData = 1
							THEN RevenueAndCOGS.RevenueAmountTurnover
						WHEN &amp;ReportData = 2
							THEN RevenueAndCOGS.RevenueAmountExcludingVATTurnover
						WHEN &amp;ReportData = 3
							THEN RevenueAndCOGS.RevenueAmountExclVATLocalTurnover
					END
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(RevenueAndCOGS.CountTurnover * CASE
							WHEN &amp;ReportData = 1
								THEN ISNULL(CostOfProducts.Cost, 0)
							WHEN &amp;ReportData = 2
								THEN ISNULL(CostOfProducts.CostExcludingVAT, 0)
							WHEN &amp;ReportData = 3
								THEN ISNULL(CostOfProducts.LocalCost, 0)
						END AS NUMBER(31,2))
			ELSE CASE
					WHEN &amp;ReportData = 1
						THEN RevenueAndCOGS.CostTurnover
					WHEN &amp;ReportData = 2
						THEN RevenueAndCOGS.CostExcludingVATTurnover
					WHEN &amp;ReportData = 3
						THEN RevenueAndCOGS.LocalCostTurnover
				END
		END) AS Cost_,
	SUM(CASE
			WHEN RevenueAndCOGS.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN 0
			ELSE CASE
					WHEN &amp;ReportData = 1
						THEN RevenueAndCOGS.AddExpensesForGoodsTurnover
					WHEN &amp;ReportData = 2
						THEN RevenueAndCOGS.AdditionalExpensesExcludingVATTurnover
					ELSE 0
				END
		END) AS AddExpensesForGoods
{SELECT
	Products.*,
	Characteristic.*}
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;SettlementStartDate, &amp;SettlementEndDate, Auto, ) AS RevenueAndCOGS
		{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON RevenueAndCOGS.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
			AND (RevenueAndCOGS.AccountingDimensionByPartners.Organization = CostOfProducts.Organization)
			AND RevenueAndCOGS.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
			AND (CostOfProducts.Period = BEGINOFPERIOD(RevenueAndCOGS.MonthPeriod, MONTH))}
		{LEFT JOIN Document.InventoryCostCalculation.Companies AS CalculationOfCost
		ON (BEGINOFPERIOD(RevenueAndCOGS.MonthPeriod, MONTH) = BEGINOFPERIOD(CalculationOfCost.Ref.Date, MONTH))
			AND (RevenueAndCOGS.AccountingDimensionByPartners.Organization = CalculationOfCost.Organization)
			AND CalculationOfCost.Ref.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
			AND (CalculationOfCost.Ref.Posted)}
WHERE
	RevenueAndCOGS.AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	((RevenueAndCOGS.ItemsLocationAttributes.Products, RevenueAndCOGS.ItemsLocationAttributes.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(RevenueAndCOGS.AccountingDimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	RevenueAndCOGS.Department,
	RevenueAndCOGS.AccountingDimensionByPartners.Partner,
	RevenueAndCOGS.AccountingDimensionByPartners.Partner.BusinessRegion,
	RevenueAndCOGS.AccountingDimensionByPartners.Organization,
	RevenueAndCOGS.AccountingDimensionByPartners.LineOfBusiness,
	RevenueAndCOGS.ItemsLocationAttributes.Products,
	RevenueAndCOGS.ItemsLocationAttributes.Characteristic,
	RevenueAndCOGS.SalesOrder.Manager,
	RevenueAndCOGS.SalesOrder,
	RevenueAndCOGS.InventoryOwnerAttribute,
	CASE
		WHEN RevenueAndCOGS.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
			THEN RevenueAndCOGS.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
		ELSE RevenueAndCOGS.InventoryOwnerAttribute.GoodsOwner
	END,
	RevenueAndCOGS.ItemsLocationAttributes.Products.UnitOfMeasure,
	RevenueAndCOGS.ItemsLocationAttributes.Products.UnitForReports,
	RevenueAndCOGS.ItemsLocationAttributes.Products.UnitFactorForReports</query>
	</dataSet>
