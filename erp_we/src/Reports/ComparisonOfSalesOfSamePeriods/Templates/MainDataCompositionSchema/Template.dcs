	<totalField>
		<dataPath>Growth</dataPath>
		<expression>Case
    When EvalExpression("SettlementStartDate","SettlementStartDate", , "Current", "Current") = EvalExpression("SettlementStartDate","SettlementStartDate",, "First", "First")
    Then 0 
    Else SalesServer.IncreasePercentage(EvalExpression("IsNull(Sum(Revenue), 0)","SettlementStartDate", , "Previous", "Previous"), EvalExpression("IsNull(Sum(Revenue), 0)","SettlementStartDate", , "Current", "Current"))
End</expression>
	</totalField>
	<totalField>
		<dataPath>GrowthInQuantity</dataPath>
		<expression>Case
    When EvalExpression("SettlementStartDate","SettlementStartDate", , "Current", "Current") = EvalExpression("SettlementStartDate","SettlementStartDate",, "First", "First")
    Then 0 
    Else SalesServer.IncreasePercentage(EvalExpression("IsNull(Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then 0 Else Sum(Count) End, 0)","SettlementStartDate",, "Previous", "Previous"), 
		EvalExpression("IsNull(Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then 0 Else Sum(Count) End, 0)","SettlementStartDate", , "Current", "Current"))
End</expression>
	</totalField>
	<totalField>
		<dataPath>AddExpensesForGoods</dataPath>
		<expression>Sum(AddExpensesForGoods)</expression>
	</totalField>
	<totalField>
		<dataPath>Cost_</dataPath>
		<expression>Sum(Cost_)</expression>
	</totalField>
	<totalField>
		<dataPath>SalesProfitability</dataPath>
		<expression>Case
	When Sum(Revenue) &lt;&gt; 0
	Then (Sum(Revenue) - Sum(Cost_) - Sum(AddExpensesForGoods)) / Sum(Revenue) * 100
	Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>SerialNumber</dataPath>
		<expression>EvalExpression("GroupSerialNumber()", , , , , "Sum(Revenue) Desc")</expression>
	</totalField>
	<totalField>
		<dataPath>Revenue</dataPath>
		<expression>Sum(Revenue)</expression>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Count)
End</expression>
	</totalField>
	<totalField>
		<dataPath>GrossProfit</dataPath>
		<expression>Sum(GrossProfit)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityWeight</dataPath>
		<expression>Sum(QuantityWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityVolume</dataPath>
		<expression>Sum(QuantityVolume)</expression>
	</totalField>
