	<calculatedField>
		<dataPath>SalesProfitability</dataPath>
		<expression>Case
	When Revenue &lt;&gt; 0
	Then (Revenue - Cost_ - AddExpensesForGoods) / Revenue * 100
	Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
