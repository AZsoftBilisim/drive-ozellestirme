						<v8:content>Data ultimo pagamento</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Data ostatniej płatności</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Дата последнего платежа</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Son ödeme tarihi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Ngày thanh toán gần nhất</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>TermMonths</dataPath>
				<field>TermMonths</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Term months</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>مدت به ماه</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Periodo mese</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Okres miesięcy</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Срок мес</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Süre ay</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Thời hạn tháng</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	PaymentSchedule.Period,
	LoanAndDepositContracts.Organization,
	LoanAndDepositContracts.Counterparty,
	PaymentSchedule.ScheduleOption.Owner AS Contract,
	PaymentSchedule.ScheduleOption.Owner.ContractKind AS ContractKind,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Payments) AS ScheduleType,
	YEAR(PaymentSchedule.Period) AS YearNumber,
	BEGINOFPERIOD(PaymentSchedule.Period, MONTH) AS MonthName,
	0 AS TrancheAmount,
	PaymentSchedule.Interests AS AmountInterest,
	PaymentSchedule.Fee AS AmountIncludingVATFee,
	0 AS AccruedDebt,
	0 AS AccruedInterest,
	0 AS AccruedCommission,
	0 AS DebtPayment,
	0 AS PaymentInterest,
	0 AS PaymentCommission,
	0 AS Percent,
	0 AS Fee,
	FALSE AS Supply,
	ISNULL(ScheduleOption.LastPayment, LoanAndDepositContracts.LastPayment) AS LastPayment,
	ISNULL(ScheduleOption.TermMonths, LoanAndDepositContracts.TermMonths) AS TermMonths
FROM
	InformationRegister.ScheduleOfPaymentForLoansAndDeposits AS PaymentSchedule
		INNER JOIN Catalog.LoanAndDepositContracts AS LoanAndDepositContracts
		ON PaymentSchedule.ScheduleOption.Owner = LoanAndDepositContracts.Ref
		LEFT JOIN Catalog.OptionsOfLoansAndDepositsSchedules AS ContractScheduleOption
		ON LoanAndDepositContracts.Ref = ContractScheduleOption.Owner
		AND NOT ContractScheduleOption.DeletionMark
		AND ContractScheduleOption.Used
WHERE
	PaymentSchedule.ScheduleOption.Used
	AND NOT PaymentSchedule.ScheduleOption.DeletionMark
	AND (LoanAndDepositContracts.Status = &amp;ContractStatus
			OR &amp;ContractStatus = VALUE(Enum.CounterpartyContractStatuses.EmptyRef))
	AND ISNULL(ContractScheduleOption.DateOfFirstTranche, LoanAndDepositContracts.DateOfFirstTranche) &lt;= &amp;EndOfPeriod
	AND ISNULL(ContractScheduleOption.LastPayment, LoanAndDepositContracts.LastPayment) &gt;= &amp;BeginOfPeriod</query>
		</item>
	</dataSet>
