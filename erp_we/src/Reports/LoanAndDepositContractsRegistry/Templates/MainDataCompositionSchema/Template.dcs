				<dataPath>TermMonths</dataPath>
				<field>TermMonths</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Term months</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>مدت به ماه</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Periodo mese</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Okres miesięcy</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Срок мес</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Süre ay</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Thời hạn tháng</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	LoanAndDepositContracts.Organization,
	LoanAndDepositContracts.Counterparty,
	LoanAndDepositContracts.Ref AS Contract,
	InterestRatesCut.Percent AS Percent,
	InterestRatesCut.Fee AS Fee,
	SUM(CASE
			WHEN LoanAndDepositContractsSupply.LineNumber IS NULL 
				THEN 0
			ELSE 1
		END) AS Supply,
	ISNULL(ScheduleOption.LastPayment, LoanAndDepositContracts.LastPayment) AS LastPayment,
	ISNULL(ScheduleOption.TermMonths, LoanAndDepositContracts.TermMonths) AS TermMonths
INTO LoanAndDepositContracts
FROM
	Catalog.LoanAndDepositContracts AS LoanAndDepositContracts
		LEFT JOIN InformationRegister.InterestRateOfFinancialInstruments.SliceLast(&amp;Period, ) AS InterestRatesCut
		ON LoanAndDepositContracts.Ref = InterestRatesCut.Contract
		LEFT JOIN Catalog.LoanAndDepositContracts.Supply AS LoanAndDepositContractsSupply
		ON LoanAndDepositContracts.Ref = LoanAndDepositContractsSupply.Ref
		LEFT JOIN Catalog.OptionsOfLoansAndDepositsSchedules AS ScheduleOption
		ON LoanAndDepositContracts.Ref = ScheduleOption.Owner
		AND NOT ScheduleOption.DeletionMark
		AND ScheduleOption.Used
WHERE
	(LoanAndDepositContracts.Status = &amp;ContractStatus
			OR &amp;ContractStatus = VALUE(Enum.CounterpartyContractStatuses.EmptyRef))
	AND ISNULL(ScheduleOption.DateOfFirstTranche, LoanAndDepositContracts.DateOfFirstTranche) &lt;= &amp;EndOfPeriod
	AND ISNULL(ScheduleOption.LastPayment, LoanAndDepositContracts.LastPayment) &gt;= &amp;BeginOfPeriod

GROUP BY
	LoanAndDepositContracts.Ref,
	LoanAndDepositContracts.Organization,
	LoanAndDepositContracts.Counterparty,
	InterestRatesCut.Percent,
	InterestRatesCut.Fee,
	ISNULL(ScheduleOption.LastPayment, LoanAndDepositContracts.LastPayment),
	ISNULL(ScheduleOption.TermMonths, LoanAndDepositContracts.TermMonths)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ScheduleOfTrancheForLoansAndDeposits.Period,
	ScheduleOfTrancheForLoansAndDeposits.ScheduleOption.Owner AS Contract,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Payments) AS ScheduleType,
	YEAR(ScheduleOfTrancheForLoansAndDeposits.Period) AS YearNumber,
	BEGINOFPERIOD(ScheduleOfTrancheForLoansAndDeposits.Period, MONTH) AS MonthName,
	ScheduleOfTrancheForLoansAndDeposits.Sum AS TrancheAmount
INTO TrancheSchedule
FROM
	InformationRegister.ScheduleOfTrancheForLoansAndDeposits AS ScheduleOfTrancheForLoansAndDeposits
		INNER JOIN LoanAndDepositContracts AS LoanAndDepositContracts
		ON ScheduleOfTrancheForLoansAndDeposits.ScheduleOption.Owner = LoanAndDepositContracts.Contract
WHERE
	ScheduleOfTrancheForLoansAndDeposits.ScheduleOption.Used
	AND NOT ScheduleOfTrancheForLoansAndDeposits.ScheduleOption.DeletionMark
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TrancheSchedule.Period,
	LoanAndDepositContracts.Organization,
	LoanAndDepositContracts.Counterparty,
	LoanAndDepositContracts.Contract,
	LoanAndDepositContracts.Contract.ContractKind AS ContractKind,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Payments) AS ScheduleType,
	TrancheSchedule.YearNumber AS YearNumber,
	TrancheSchedule.MonthName AS MonthName,
	TrancheSchedule.TrancheAmount AS TrancheAmount,
	0 AS AmountInterest,
	0 AS AmountIncludingVATFee,
	0 AS AccruedDebt,
	0 AS AccruedInterest,
	0 AS AccruedCommission,
	0 AS DebtPayment,
	0 AS PaymentInterest,
	0 AS PaymentCommission,
	LoanAndDepositContracts.Percent,
	LoanAndDepositContracts.Fee,
	CASE
		WHEN LoanAndDepositContracts.Supply &gt; 0
			THEN TRUE
		ELSE FALSE
	END AS Supply,
	LoanAndDepositContracts.LastPayment,
	LoanAndDepositContracts.TermMonths
FROM
	LoanAndDepositContracts AS LoanAndDepositContracts
		LEFT JOIN TrancheSchedule AS TrancheSchedule
		ON LoanAndDepositContracts.Contract = TrancheSchedule.Contract</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>FactOfAccruals</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Period</dataPath>
				<field>Period</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
				<valueType>
					<v8:Type>xs:dateTime</v8:Type>
					<v8:DateQualifiers>
						<v8:DateFractions>Date</v8:DateFractions>
					</v8:DateQualifiers>
				</valueType>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ScheduleType</dataPath>
				<field>ScheduleType</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>MonthName</dataPath>
				<field>MonthName</field>
				<role>
					<dcscom:periodNumber>3</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>YearNumber</dataPath>
				<field>YearNumber</field>
				<role>
					<dcscom:periodNumber>2</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
