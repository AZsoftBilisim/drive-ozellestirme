					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>TermMonths</dataPath>
				<field>TermMonths</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Term months</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>مدت به ماه</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Periodo mese</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Okres miesięcy</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Срок мес</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Süre ay</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Thời hạn tháng</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	SettlementsOnCreditsDeposits.Period,
	SettlementsOnCreditsDeposits.Contract.Organization AS Organization,
	SettlementsOnCreditsDeposits.Contract.Counterparty AS Counterparty,
	SettlementsOnCreditsDeposits.Contract,
	SettlementsOnCreditsDeposits.Contract.ContractKind AS ContractKind,
	SettlementsOnCreditsDeposits.ScheduleType,
	YEAR(SettlementsOnCreditsDeposits.Period) AS YearNumber,
	BEGINOFPERIOD(SettlementsOnCreditsDeposits.Period, MONTH) AS MonthName,
	0 AS TrancheAmount,
	0 AS AmountInterest,
	0 AS AmountIncludingVATFee,
	0 AS AccruedDebt,
	CASE
		WHEN SettlementsOnCreditsDeposits.AmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Interests)
			THEN SettlementsOnCreditsDeposits.Sum
		ELSE 0
	END AS AccruedInterest,
	CASE
		WHEN SettlementsOnCreditsDeposits.AmountType = VALUE(Enum.LoanAndDepositScheduleAmountTypes.Fee)
			THEN SettlementsOnCreditsDeposits.Sum
		ELSE 0
	END AS AccruedCommission,
	0 AS DebtPayment,
	0 AS PaymentInterest,
	0 AS PaymentCommission,
	0 AS Percent,
	0 AS Fee,
	FALSE AS Supply,
	ISNULL(ScheduleOption.LastPayment, SettlementsOnCreditsDeposits.Contract.LastPayment) AS LastPayment,
	ISNULL(ScheduleOption.TermMonths, SettlementsOnCreditsDeposits.Contract.TermMonths) AS TermMonths
FROM
	AccumulationRegister.FinancialInstrumentsARAP AS SettlementsOnCreditsDeposits
	
		LEFT JOIN Catalog.OptionsOfLoansAndDepositsSchedules AS ScheduleOption
		ON SettlementsOnCreditsDeposits.Contract = ScheduleOption.Owner
		AND NOT ScheduleOption.DeletionMark
		AND ScheduleOption.Used
WHERE
	SettlementsOnCreditsDeposits.ScheduleType = VALUE(Enum.FinancialInstrumentScheduleTypes.Accruals)
	AND (SettlementsOnCreditsDeposits.Contract.Status = &amp;ContractStatus
			OR &amp;ContractStatus = VALUE(Enum.CounterpartyContractStatuses.EmptyRef))
	AND ISNULL(ScheduleOption.DateOfFirstTranche, SettlementsOnCreditsDeposits.Contract.DateOfFirstTranche) &lt;= &amp;EndOfPeriod
	AND ISNULL(ScheduleOption.LastPayment, SettlementsOnCreditsDeposits.Contract.LastPayment) &gt;= &amp;BeginOfPeriod</query>
		</item>
