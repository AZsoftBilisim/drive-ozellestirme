		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	UNDEFINED AS Period,
	&amp;OpeningBalance AS Recorder,
	Balance.Contract AS Contract,
	Balance.Contract.ContractKind AS ContractKind,
	Balance.AccountingDimensionByPartners.Counterparty AS Counterparty,
	Balance.AccountingDimensionByPartners.Partner AS Partner,
	Balance.AccountingDimensionByPartners.Organization AS Organization,
	Balance.Contract.LineOfBusiness AS LineOfBusiness,
	Balance.Currency AS Currency,
	
	0 AS DocumentAmount,
	SUM(CASE &amp;ReportCurrency
			WHEN 1
				THEN Balance.SumBalance
			WHEN 2
				THEN Balance.SumComplBalance
			ELSE
				Balance.SumManBalance
	END) AS SumBalance,
	
	0 AS PrincipalDebt,
	0 AS Interests,
	0 AS Fee,
	0 AS LeaseObligations,
	0 AS DepositPayment,
	0 AS BuyoutValuePrepayment,
	0 AS BuyoutValue,
	0 AS RentalServicePrepayment,
	0 AS RentalService,
	0 AS InterestRent,
	0 AS VAT,
	
	SUM(CASE
		WHEN Balance.AmountType = &amp;PrincipalDebt
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS PrincipalDebtBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;Interests
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS InterestsBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;Fee
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS FeeBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;LeaseObligations
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS LeaseObligationsBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;DepositPayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS DepositPaymentBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;BuyoutValuePrepayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS BuyoutValuePrepaymentBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;BuyoutValue
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS BuyoutValueBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;RentalServicePrepayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS RentalServicePrepaymentBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;RentalService
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS RentalServiceBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;InterestRent
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS InterestRentBalance,
	SUM(CASE
		WHEN Balance.AmountType = &amp;VAT
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Balance.SumBalance
					WHEN 2
						THEN Balance.SumComplBalance
					ELSE
						Balance.SumManBalance
				END
		ELSE 0
	END) AS VATBalance,
	1 AS OrderOfResults
FROM
	AccumulationRegister.FinancialInstrumentsARAP.Balance(
		&amp;EmptyBeginning{&amp;BeginOfPeriod},
	) AS Balance
WHERE
	Balance.SumBalance &lt;&gt; 0
	
GROUP BY
	Balance.Contract,
	Balance.Contract.LineOfBusiness,
	Balance.Contract.ContractKind,
	Balance.AccountingDimensionByPartners,
	Balance.Currency
	
UNION ALL

SELECT
	Turnovers.Period AS Period,
	Turnovers.Recorder AS Recorder,
	Turnovers.Contract AS Contract,
	Turnovers.Contract.ContractKind AS ContractKind,
	Turnovers.AccountingDimensionByPartners.Counterparty AS Counterparty,
	Turnovers.AccountingDimensionByPartners.Partner AS Partner,
	Turnovers.AccountingDimensionByPartners.Organization AS Organization,
	Turnovers.Contract.LineOfBusiness AS LineOfBusiness,
	Turnovers.Currency AS Currency,
	CASE WHEN DocumentsRegistry.Sum = 0 
		THEN SUM(Turnovers.SumTurnover)
		ELSE DocumentsRegistry.Sum
	END AS DocumentAmount,
	
	SUM(CASE &amp;ReportCurrency
			WHEN 1
				THEN Turnovers.SumTurnover
			WHEN 2
				THEN Turnovers.SumComplTurnover
			ELSE
				Turnovers.SumManTurnover
	END) AS SumBalance,
	
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;PrincipalDebt
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS PrincipalDebt,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;Interests
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS Interests,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;Fee
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS Fee,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;LeaseObligations
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS LeaseObligations,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;DepositPayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS DepositPayment,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;BuyoutValuePrepayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS BuyoutValuePrepayment,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;BuyoutValue
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS BuyoutValue,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;RentalServicePrepayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS RentalServicePrepayment,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;RentalService
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS RentalService,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;InterestRent
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS InterestRent,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;VAT
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS VAT,
	
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;PrincipalDebt
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS PrincipalDebtBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;Interests
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS InterestsBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;Fee
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS FeeBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;LeaseObligations
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS LeaseObligationsBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;DepositPayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS DepositPaymentBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;BuyoutValuePrepayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS BuyoutValuePrepaymentBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;BuyoutValue
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS BuyoutValueBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;RentalServicePrepayment
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS RentalServicePrepaymentBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;RentalService
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS RentalServiceBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;InterestRent
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS InterestRentBalance,
	SUM(CASE
		WHEN Turnovers.AmountType = &amp;VAT
			THEN CASE &amp;ReportCurrency
					WHEN 1
						THEN Turnovers.SumTurnover
					WHEN 2
						THEN Turnovers.SumComplTurnover
					ELSE
						Turnovers.SumManTurnover
				END
		ELSE 0
	END) AS VATBalance,
	2 AS OrderOfResults
FROM
	AccumulationRegister.FinancialInstrumentsARAP.Turnovers(
		&amp;EmptyBeginning{&amp;BeginOfPeriod},
		&amp;EmptyEnding{&amp;EndOfPeriod},
		Recorder
	) AS Turnovers
	LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	ON Turnovers.Recorder = DocumentsRegistry.Ref
WHERE
	&amp;ReportCurrency &lt;&gt; 1 AND VALUETYPE(Turnovers.Recorder) = TYPE(Document.ExchangeDifferenceCalculation)
	OR VALUETYPE(Turnovers.Recorder) &lt;&gt; TYPE(Document.ExchangeDifferenceCalculation)
	
GROUP BY
	Turnovers.Period,
	Turnovers.Recorder,
	Turnovers.Contract,
	Turnovers.Contract.LineOfBusiness,
	Turnovers.Contract.ContractKind,
	Turnovers.AccountingDimensionByPartners,
	Turnovers.Currency,
	DocumentsRegistry.Sum</query>
	</dataSet>
	<calculatedField>
		<dataPath>PrincipalDebtBalance</dataPath>
		<expression>EvalExpression("Sum(PrincipalDebtBalance)",,,"First","Current")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Principal debt</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>اصل بدهی</v8:content>
