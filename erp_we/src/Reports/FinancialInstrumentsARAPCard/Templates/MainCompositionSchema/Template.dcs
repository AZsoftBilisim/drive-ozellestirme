		<field xsi:type="DataSetFieldField">
			<dataPath>SumBalance</dataPath>
			<field>SumBalance</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Amount balance</v8:content>
				</v8:item>
				<v8:item>
