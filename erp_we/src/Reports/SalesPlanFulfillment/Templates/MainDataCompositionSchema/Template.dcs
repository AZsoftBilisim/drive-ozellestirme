				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN SalesPlansTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN SalesPlansTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN SalesPlansTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN SalesPlansTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN SalesPlansTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN SalesPlansTurnovers.YearPeriod
		ELSE SalesPlansTurnovers.DayPeriod
	END AS DynamicPeriod,
	SalesPlansTurnovers.StoreFormat AS StoreFormat,
	SalesPlansTurnovers.Products AS Products,
	SalesPlansTurnovers.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN SalesPlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	SalesPlansTurnovers.Recorder AS Recorder,
	SalesPlansTurnovers.Partner AS Partner,
	SUM(SalesPlansTurnovers.CountTurnover) AS Count,
	SUM(SalesPlansTurnovers.SumTurnover) AS Sum
INTO SalesPlan
{SELECT
	StoreFormat.*}
FROM
	AccumulationRegister.SalesPlans.Turnovers(
		,
		,
		Auto,
		Scenario = &amp;Scenario
		{(StoreFormat),
		((Products, Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment AS SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
		(Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment AS SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))
		}) AS SalesPlansTurnovers

GROUP BY
	SalesPlansTurnovers.Products,
	SalesPlansTurnovers.Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN SalesPlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	SalesPlansTurnovers.StoreFormat,
	SalesPlansTurnovers.Recorder,
	SalesPlansTurnovers.Partner,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN SalesPlansTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN SalesPlansTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN SalesPlansTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN SalesPlansTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN SalesPlansTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN SalesPlansTurnovers.YearPeriod
		ELSE SalesPlansTurnovers.DayPeriod
	END

INDEX BY
	DynamicPeriod,
	StoreFormat,
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;BeginOfPeriod AS Period,
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;BeginOfPeriod, Currency IN (&amp;CurrencyOfMan, &amp;ScenarioCurrency) AND BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
WHERE
	&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency

UNION ALL

SELECT
	ExchangeRates.Period,
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
FROM
	InformationRegister.RelativeExchangeRates AS ExchangeRates
WHERE
	&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency
	AND ExchangeRates.Period &gt; &amp;BeginOfPeriod
	AND ExchangeRates.Period &lt;= &amp;EndOfPeriod
	AND ExchangeRates.Currency IN (&amp;CurrencyOfMan, &amp;ScenarioCurrency)
	AND ExchangeRates.BaseCurrency = &amp;BaseCurrency

INDEX BY
	Period,
	CurrencyRatesCut.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, YEAR)
		ELSE BEGINOFPERIOD(RevenueAndCOGS.Period, DAY)
	END AS DynamicPeriod,
	RevenueAndCOGS.ItemsLocationAttributes.StorageLocation AS Warehouse,
	RevenueAndCOGS.AccountingDimensionByPartners.Partner AS Partner,
	RevenueAndCOGS.ItemsLocationAttributes.Products AS Products,
	RevenueAndCOGS.ItemsLocationAttributes.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN RevenueAndCOGS.ItemsLocationAttributes.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	RevenueAndCOGS.Recorder AS Recorder,
	SUM(RevenueAndCOGS.Count) AS FactQuantity,
	SUM(CAST(CASE
		WHEN &amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency AND &amp;ScenarioCurrency = RevenueAndCOGS.DocumentCurrency
			THEN CASE
					WHEN &amp;SumOfFactWithVAT
						THEN RevenueAndCOGS.AmountInDocumentCurrency
					ELSE RevenueAndCOGS.AmountExcludingVATInDocumentCurrency
				END
		ELSE CASE
				WHEN &amp;SumOfFactWithVAT
					THEN RevenueAndCOGS.RevenueAmount
				ELSE RevenueAndCOGS.RevenueAmountExcludingVAT
			END
		END * CASE
		WHEN &amp;ScenarioCurrency = RevenueAndCOGS.DocumentCurrency
			THEN 1
		WHEN &amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency
			THEN CASE
				WHEN ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)) &gt; 0
					AND ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) &gt; 0
					AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
					AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
						THEN ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) * ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) / (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) * ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)))
				ELSE 0
			END
		ELSE 1
	END AS NUMBER(31,2))) AS ActualAmount
INTO Sales
FROM
	AccumulationRegister.RevenueAndCOGS AS RevenueAndCOGS
		LEFT JOIN ExchangeRates AS ManSExchangeRates
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (&amp;ScenarioCurrency &lt;&gt; RevenueAndCOGS.DocumentCurrency)
			AND (ManSExchangeRates.Currency = &amp;CurrencyOfMan)
			AND BEGINOFPERIOD(RevenueAndCOGS.Period, DAY) = ManSExchangeRates.Period
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)  
			AND (&amp;ScenarioCurrency &lt;&gt; RevenueAndCOGS.DocumentCurrency)
			AND (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND BEGINOFPERIOD(RevenueAndCOGS.Period, DAY) = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS ExchangeRatesOfManAtBeginning
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency) 
			AND (&amp;ScenarioCurrency &lt;&gt; RevenueAndCOGS.DocumentCurrency)
			AND (ExchangeRatesOfManAtBeginning.Currency = &amp;CurrencyOfMan)
			AND (ExchangeRatesOfManAtBeginning.Period = &amp;BeginOfPeriod)
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)     
			AND (&amp;ScenarioCurrency &lt;&gt; RevenueAndCOGS.DocumentCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;BeginOfPeriod)
WHERE
	CASE
		WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
			THEN ItemsLocationAttributes IN
				(SELECT DISTINCT
					ItemsLocationAttributes.DimensionKey
				FROM
					SalesPlan AS SalesPlan
						INNER JOIN InformationRegister.ItemsLocationAttributes AS ItemsLocationAttributes
						ON SalesPlan.Products = ItemsLocationAttributes.Products
						 AND SalesPlan.Characteristic = ItemsLocationAttributes.Characteristic)
		ELSE TRUE
	END
	AND RevenueAndCOGS.BusinessOperation &lt;&gt; VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)

{WHERE
	RevenueAndCOGS.AccountingDimensionByPartners.Organization.* AS Organization,
	RevenueAndCOGS.ItemsLocationAttributes.Products.* AS Products,
	(RevenueAndCOGS.AccountingDimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment AS SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	RevenueAndCOGS.ItemsLocationAttributes.StorageLocation,
	RevenueAndCOGS.ItemsLocationAttributes.Characteristic,
	RevenueAndCOGS.ItemsLocationAttributes.Products,
	RevenueAndCOGS.AccountingDimensionByPartners.Partner,
	CASE
		WHEN &amp;SpecifyTargets
			THEN RevenueAndCOGS.ItemsLocationAttributes.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	RevenueAndCOGS.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, YEAR)
		ELSE BEGINOFPERIOD(RevenueAndCOGS.Period, DAY)
	END

INDEX BY
	DynamicPeriod,
	Warehouse,
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Table.Products AS Products,
	Table.Characteristic AS Characteristic
INTO TTPlanProducts
FROM
	SalesPlan AS Table

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, YEAR)
		ELSE BEGINOFPERIOD(Orders.DateOfShipment, DAY)
	END AS DynamicPeriod,
	CASE
		WHEN Orders.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
			THEN Orders.Department
		ELSE Orders.Warehouse
	END AS Warehouse,
	Orders.Products AS Products,
	Orders.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN CASE
					WHEN Orders.WithAssignment
						THEN OrderDetails.Purpose
					ELSE VALUE(Catalog.Assignments.EmptyRef)
				END
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	OrderDetails.Ref AS Recorder,
	OrderDetails.Partner AS Partner,
	SUM(Orders.Count) AS OrderedQuantity
INTO Orders
FROM
	Document.SalesOrder.Goods AS Orders
		INNER JOIN TTPlanProducts AS FilterOfProductItem
		ON Orders.Products = FilterOfProductItem.Products
			AND Orders.Characteristic = FilterOfProductItem.Characteristic
		INNER JOIN Document.SalesOrder AS OrderDetails
		ON Orders.Ref = OrderDetails.Ref
WHERE
	NOT Orders.Canceled
	AND Orders.Ref.Posted
{WHERE
	OrderDetails.Organization.* AS Organization,
	OrderDetails.Department.* AS Department,
	Orders.Warehouse.* AS Warehouse,
	(OrderDetails.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment AS SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	Orders.Products,
	Orders.Characteristic,
	CASE
		WHEN Orders.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
			THEN Orders.Department
		ELSE Orders.Warehouse
	END,
	CASE
		WHEN &amp;SpecifyTargets
			THEN CASE
					WHEN Orders.WithAssignment
						THEN OrderDetails.Purpose
					ELSE VALUE(Catalog.Assignments.EmptyRef)
				END
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	OrderDetails.Ref,
	OrderDetails.Partner,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, YEAR)
		ELSE BEGINOFPERIOD(Orders.DateOfShipment, DAY)
	END

INDEX BY
	DynamicPeriod,
	Warehouse,
	Products,
	Characteristic,
	Purpose
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DynamicPeriod,
	NestedQuery.StoreFormat,
	NestedQuery.Products,
	NestedQuery.Characteristic,
	NestedQuery.Purpose,
	NestedQuery.Recorder,
	SUM(NestedQuery.PlanQuantity) AS PlanQuantity,
	SUM(NestedQuery.PlanAmount) AS PlanAmount,
	SUM(NestedQuery.FactQuantity) AS FactQuantity,
	SUM(NestedQuery.ActualAmount) AS ActualAmount,
	SUM(NestedQuery.OrderedQuantity) AS OrderedQuantity
INTO SalesPlanFact
FROM
	(SELECT
		SalesPlan.DynamicPeriod AS DynamicPeriod,
		SalesPlan.StoreFormat AS StoreFormat,
		SalesPlan.Products AS Products,
		SalesPlan.Characteristic AS Characteristic,
		SalesPlan.Purpose AS Purpose,
		SalesPlan.Recorder AS Recorder,
		SalesPlan.Count AS PlanQuantity,
		SalesPlan.Sum AS PlanAmount,
		0 AS FactQuantity,
		0 AS ActualAmount,
		0 AS OrderedQuantity
	FROM
		SalesPlan AS SalesPlan
	
	UNION ALL
	
	SELECT
		Sales.DynamicPeriod,
		ISNULL(StoreFormats.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)),
		Sales.Products,
		Sales.Characteristic,
		Sales.Purpose,
		Sales.Recorder,
		0,
		0,
		Sales.FactQuantity,
		Sales.ActualAmount,
		0
	FROM
		Sales AS Sales
			LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast(
					&amp;BeginOfPeriod,
					Warehouse IN
						(SELECT DISTINCT
							T.Warehouse
						FROM
							Sales AS T)) AS StoreFormats
			ON Sales.Warehouse = StoreFormats.Warehouse
		
	UNION ALL
	
	SELECT
		Orders.DynamicPeriod,
		ISNULL(StoreFormats.StoreFormat, VALUE(Catalog.StoreFormats.EmptyRef)),
		Orders.Products,
		Orders.Characteristic,
		Orders.Purpose,
		Orders.Recorder,
		0,
		0,
		0,
		0,
		Orders.OrderedQuantity
		
	FROM
		Orders AS Orders
			LEFT JOIN InformationRegister.HistoryOfStoreFormatChange.SliceLast(
					&amp;BeginOfPeriod,
					Warehouse IN
						(SELECT DISTINCT
							T.Warehouse
						FROM
							Orders AS T)) AS StoreFormats
			ON Orders.Warehouse = StoreFormats.Warehouse
		) AS NestedQuery

GROUP BY
	NestedQuery.DynamicPeriod,
	NestedQuery.Characteristic,
	NestedQuery.Products,
	NestedQuery.Purpose,
	NestedQuery.StoreFormat,
	NestedQuery.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SalesPlanFact.DynamicPeriod AS DynamicPeriod,
	SalesPlanFact.StoreFormat AS StoreFormat,
	SalesPlanFact.Products AS Products,
	SalesPlanFact.Products.UnitOfMeasure AS StorageUnit,
	SalesPlanFact.Products.UnitForReports AS UnitForReports,
	CASE
		WHEN SalesPlanFact.Products.UnitFactorForReports &lt;&gt; 0
			THEN 1 / SalesPlanFact.Products.UnitFactorForReports
		ELSE 1
	END AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	SalesPlanFact.Characteristic AS Characteristic,
	SalesPlanFact.Purpose AS Purpose,
	SalesPlanFact.Recorder AS Recorder,
	SUM(SalesPlanFact.PlanQuantity) AS PlanQuantity,
	SUM(SalesPlanFact.PlanAmount) AS PlanAmount,
	SUM(SalesPlanFact.FactQuantity) AS FactQuantity,
	SUM(SalesPlanFact.ActualAmount) AS ActualAmount,
	100 * (CASE
		WHEN SUM(SalesPlanFact.PlanQuantity) = 0
			THEN 0
		ELSE SUM(SalesPlanFact.FactQuantity) / SUM(SalesPlanFact.PlanQuantity)
	END) AS ExecutionOfPlanQuantity,
	100 * (CASE
		WHEN SUM(SalesPlanFact.PlanAmount) = 0
			THEN 0
		ELSE SUM(SalesPlanFact.ActualAmount) / SUM(SalesPlanFact.PlanAmount)
	END) AS ExecutionOfPlanSum,
	SUM(SalesPlanFact.OrderedQuantity) AS OrderedQuantity
FROM
	SalesPlanFact AS SalesPlanFact
WHERE
	SalesPlanFact.DynamicPeriod BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod 

GROUP BY
	SalesPlanFact.DynamicPeriod,
	SalesPlanFact.Products,
	SalesPlanFact.Characteristic,
	SalesPlanFact.Purpose,
	SalesPlanFact.Recorder,
	SalesPlanFact.StoreFormat</query>
			</dataSet>
