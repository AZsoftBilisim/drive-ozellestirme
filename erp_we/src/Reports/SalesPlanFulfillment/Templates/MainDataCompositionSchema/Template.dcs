					<dcsset:userFields>
						<dcsset:item xsi:type="dcsset:UserFieldExpression">
							<dcsset:dataPath>UserFields.Field1</dcsset:dataPath>
							<dcsset:lwsTitle>
								<v8:item>
									<v8:lang>en</v8:lang>
									<v8:content>Quantity (variance)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>fa</v8:lang>
									<v8:content>مقدار (انحراف)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>it</v8:lang>
									<v8:content>Quantità (scostamento)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>pl</v8:lang>
									<v8:content>Ilość (odchylenie)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>Количество (отклонение)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>tr</v8:lang>
									<v8:content>Miktar (fark)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>vi</v8:lang>
									<v8:content>Số lượng (chênh lệch)</v8:content>
								</v8:item>
							</dcsset:lwsTitle>
							<dcsset:detailExpression>Case
	When Plan.Count = 0 And Real.Count = 0
		Then 0
	When PlanExecution.Count &gt; 100
		Then PlanExecution.Count - 100
	Else 100 - PlanExecution.Count
End</dcsset:detailExpression>
							<dcsset:detailExpressionPresentation>Case
	When Plan.Count = 0 And Real.Count = 0
		Then 0
	When PlanExecution.Count &gt; 100
		Then PlanExecution.Count - 100
	Else 100 - PlanExecution.Count
End</dcsset:detailExpressionPresentation>
							<dcsset:totalExpression>Cast(Case
		When Plan.Count = 0 And Real.Count = 0
			Then 0
		When PlanExecution.Count &gt; 100
			Then PlanExecution.Count - 100
		Else 100 - PlanExecution.Count
	End, "Number(15,2)")</dcsset:totalExpression>
							<dcsset:totalExpressionPresentation>Cast(Case
		When Plan.Count = 0 And Real.Count = 0
			Then 0
		When PlanExecution.Count &gt; 100
			Then PlanExecution.Count - 100
		Else 100 - PlanExecution.Count
	End, "Number(15,2)")</dcsset:totalExpressionPresentation>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:UserFieldExpression">
							<dcsset:dataPath>UserFields.Field3</dcsset:dataPath>
							<dcsset:lwsTitle>
								<v8:item>
									<v8:lang>en</v8:lang>
									<v8:content>Weight (variance)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>fa</v8:lang>
									<v8:content>وزن (انحراف)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>it</v8:lang>
									<v8:content>Peso (variazione)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>pl</v8:lang>
									<v8:content>Waga (odchylenie)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>Вес (отклонение)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>tr</v8:lang>
									<v8:content>Ağırlık (fark)</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>vi</v8:lang>
									<v8:content>Trọng lượng (chênh lệch)</v8:content>
								</v8:item>
							</dcsset:lwsTitle>
							<dcsset:detailExpression>Case
	When PlanExecution.Weight &gt; 100
