								</v8:item>
							</dcsset:lwsTitle>
							<dcsset:detailExpression>Case
	When Plans.Payment = 0 And Real.Payment = 0
		Then 0
	When PlanExecution.Payment &gt; 100
		Then PlanExecution.Payment - 100
	Else 100 - PlanExecution.Payment
End</dcsset:detailExpression>
							<dcsset:detailExpressionPresentation>Case
	When Plans.Payment = 0 And Real.Payment = 0
		Then 0
	When PlanExecution.Payment &gt; 100
		Then PlanExecution.Payment - 100
	Else 100 - PlanExecution.Payment
End</dcsset:detailExpressionPresentation>
							<dcsset:totalExpression>Cast(Case
		When Plans.Payment = 0 And Real.Payment = 0
			Then 0
		When PlanExecution.Payment &gt; 100
			Then PlanExecution.Payment - 100
		Else 100 - PlanExecution.Payment
	End, "Number(31,2)")</dcsset:totalExpression>
							<dcsset:totalExpressionPresentation>Cast(Case
		When Plans.Payment = 0 And Real.Payment = 0
			Then 0
		When PlanExecution.Payment &gt; 100
