				<field xsi:type="DataSetFieldField">
					<dataPath>TargetFundItem</dataPath>
					<field>TargetFundItem</field>
				</field>
				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PaymentPlan_.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PaymentPlan_.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PaymentPlan_.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PaymentPlan_.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PaymentPlan_.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PaymentPlan_.YearPeriod
		ELSE PaymentPlan_.DayPeriod
	END AS DynamicPeriod,
	PaymentPlan_.Partner AS Partner,
	PaymentPlan_.Recorder AS Recorder,
	SUM(PaymentPlan_.SumTurnover) AS PaymentPlan_1,
	0 AS ShippingPlan_
INTO Plans
{SELECT
	Partner.*}
FROM
	AccumulationRegister.CashFlowPlansCustomers.Turnovers(
		,
		,
		Auto,
		Scenario = &amp;Scenario
		{(Plan) AS DocumentPlan,
		(Partner IN
			(SELECT
					SelectionByPartnerSegment.Partner
				FROM
					SelectionByPartnerSegment AS SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))
		}) AS PaymentPlan_

GROUP BY
	PaymentPlan_.Partner,
	PaymentPlan_.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN PaymentPlan_.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN PaymentPlan_.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN PaymentPlan_.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN PaymentPlan_.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN PaymentPlan_.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN PaymentPlan_.YearPeriod
		ELSE PaymentPlan_.DayPeriod
	END

UNION ALL

SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN ShipmentPlan.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN ShipmentPlan.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN ShipmentPlan.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN ShipmentPlan.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN ShipmentPlan.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN ShipmentPlan.YearPeriod
		ELSE ShipmentPlan.DayPeriod
	END,
	ShipmentPlan.Partner,
	ShipmentPlan.Recorder,
	0,
	SUM(ShipmentPlan.SumTurnover)
FROM
	AccumulationRegister.SalesPlans.Turnovers(
		,
		,
		Auto,
		Scenario = &amp;Scenario
		{(SalesPlan) AS DocumentPlan,
		(Partner IN
			(SELECT
					SelectionByPartnerSegment.Partner
				FROM
					SelectionByPartnerSegment AS SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))
		}) AS ShipmentPlan

GROUP BY
	ShipmentPlan.Partner,
	ShipmentPlan.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN ShipmentPlan.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN ShipmentPlan.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN ShipmentPlan.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN ShipmentPlan.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN ShipmentPlan.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN ShipmentPlan.YearPeriod
		ELSE ShipmentPlan.DayPeriod
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;BeginOfPeriod AS Period,
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator,
	CurrencyRatesCut.CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;BeginOfPeriod, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut

UNION ALL

SELECT
	ExchangeRates.Period,
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
FROM
	InformationRegister.RelativeExchangeRates AS ExchangeRates
WHERE
	ExchangeRates.Period &gt; &amp;BeginOfPeriod
	AND ExchangeRates.Period &lt;= &amp;EndOfPeriod
	AND ExchangeRates.BaseCurrency = &amp;BaseCurrency

INDEX BY
	Period,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, YEAR)
		ELSE BEGINOFPERIOD(RevenueAndCOGS.Period, DAY)
	END AS DynamicPeriod,
	DimensionByPartners.Partner AS Partner,
	RevenueAndCOGS.Recorder AS Recorder,
	SUM(CAST(CASE
		WHEN &amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency AND &amp;ScenarioCurrency = RevenueAndCOGS.DocumentCurrency
			THEN CASE
					WHEN &amp;SumOfFactWithVAT
						THEN RevenueAndCOGS.AmountInDocumentCurrency
					ELSE RevenueAndCOGS.AmountExcludingVATInDocumentCurrency
				END
		ELSE CASE
				WHEN &amp;SumOfFactWithVAT
					THEN RevenueAndCOGS.RevenueAmount
				ELSE RevenueAndCOGS.RevenueAmountExcludingVAT
			END
		END * CASE
		WHEN &amp;ScenarioCurrency = RevenueAndCOGS.DocumentCurrency
			THEN 1
		WHEN &amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency
			THEN CASE
				WHEN ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)) &gt; 0
				AND ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) &gt; 0
				AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
				AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
					THEN ISNULL(ManSExchangeRates.CourseNumerator, ISNULL(ExchangeRatesOfManAtBeginning.CourseNumerator, 0)) * ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) / (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) * ISNULL(ManSExchangeRates.CourseDenominator, ISNULL(ExchangeRatesOfManAtBeginning.CourseDenominator, 0)))
				ELSE 0
			END
		ELSE 1
	END AS NUMBER(31,2))) AS FactShipment,
	0 AS FactPayment
INTO Real
FROM
	AccumulationRegister.RevenueAndCOGS AS RevenueAndCOGS
		LEFT JOIN ExchangeRates AS ManSExchangeRates
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (&amp;ScenarioCurrency &lt;&gt; RevenueAndCOGS.DocumentCurrency)
			AND (ManSExchangeRates.Currency = &amp;CurrencyOfMan)
			AND BEGINOFPERIOD(RevenueAndCOGS.Period, DAY) = ManSExchangeRates.Period
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (&amp;ScenarioCurrency &lt;&gt; RevenueAndCOGS.DocumentCurrency)
			AND (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND BEGINOFPERIOD(RevenueAndCOGS.Period, DAY) = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS ExchangeRatesOfManAtBeginning
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (&amp;ScenarioCurrency &lt;&gt; RevenueAndCOGS.DocumentCurrency)
			AND (ExchangeRatesOfManAtBeginning.Currency = &amp;CurrencyOfMan)
			AND (ExchangeRatesOfManAtBeginning.Period = &amp;BeginOfPeriod)
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (&amp;CurrencyOfMan &lt;&gt; &amp;ScenarioCurrency)
			AND (&amp;ScenarioCurrency &lt;&gt; RevenueAndCOGS.DocumentCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;BeginOfPeriod)
		INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON RevenueAndCOGS.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
WHERE
	RevenueAndCOGS.BusinessOperation &lt;&gt; VALUE(Enum.BusinessTransactions.GoodsSaleToAnotherCompany)
{WHERE
	DimensionByPartners.Organization.* AS Organization,
	(DimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment AS SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	DimensionByPartners.Partner,
	RevenueAndCOGS.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(RevenueAndCOGS.Period, YEAR)
		ELSE BEGINOFPERIOD(RevenueAndCOGS.Period, DAY)
	END

UNION ALL

SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN CustomerPaymentRegisteredRecordsTurnover.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN CustomerPaymentRegisteredRecordsTurnover.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN CustomerPaymentRegisteredRecordsTurnover.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN CustomerPaymentRegisteredRecordsTurnover.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN CustomerPaymentRegisteredRecordsTurnover.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN CustomerPaymentRegisteredRecordsTurnover.YearPeriod
		ELSE CustomerPaymentRegisteredRecordsTurnover.DayPeriod
	END,
	CustomerPaymentRegisteredRecordsTurnover.Partner,
	CustomerPaymentRegisteredRecordsTurnover.Recorder,
	0,
	SUM(CAST(CASE
		WHEN &amp;SumOfFactWithVAT
			THEN CustomerPaymentRegisteredRecordsTurnover.PaymentAmountPaymentCurrencyTurnover
		ELSE (CustomerPaymentRegisteredRecordsTurnover.PaymentAmountPaymentCurrencyTurnover - CustomerPaymentRegisteredRecordsTurnover.AmountVATCurrencyPaymentTurnover)
	END * CASE
		WHEN CustomerPaymentRegisteredRecordsTurnover.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToCustomer)
		  OR CustomerPaymentRegisteredRecordsTurnover.BusinessOperation = VALUE(Enum.BusinessTransactions.RefundToCustomerSPaymentCard)
			THEN -1
		ELSE 1
	END * CASE
		WHEN CustomerPaymentRegisteredRecordsTurnover.PaymentCurrency &lt;&gt; &amp;ScenarioCurrency
			THEN CASE
				WHEN ISNULL(SettlementCurrencyRates_.CourseDenominator, ISNULL(SettlementCurrencyRatesAtBeginning.CourseDenominator, 0)) &gt; 0
					AND ISNULL(SettlementCurrencyRates_.CourseNumerator, ISNULL(SettlementCurrencyRatesAtBeginning.CourseNumerator, 0)) &gt; 0
					AND ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) &gt; 0
					AND ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) &gt; 0
						THEN ISNULL(SettlementCurrencyRates_.CourseNumerator, ISNULL(SettlementCurrencyRatesAtBeginning.CourseNumerator, 0)) * ISNULL(Currency_Rates.CourseDenominator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseDenominator, 0)) / (ISNULL(Currency_Rates.CourseNumerator, ISNULL(CurrencyExchangeRatesAtBeginning.CourseNumerator, 0)) * ISNULL(SettlementCurrencyRates_.CourseDenominator, ISNULL(SettlementCurrencyRatesAtBeginning.CourseDenominator, 0)))
				ELSE 0
			END
		ELSE 1
	END AS NUMBER(31,2)))
FROM
	AccumulationRegister.RecordsCashCounterparty.Turnovers(, , Auto, ) AS CustomerPaymentRegisteredRecordsTurnover
		LEFT JOIN ExchangeRates AS SettlementCurrencyRates_
		ON CustomerPaymentRegisteredRecordsTurnover.DayPeriod = SettlementCurrencyRates_.Period
			AND CustomerPaymentRegisteredRecordsTurnover.PaymentCurrency = SettlementCurrencyRates_.Currency
		LEFT JOIN ExchangeRates AS Currency_Rates
		ON (Currency_Rates.Currency = &amp;ScenarioCurrency)
			AND CustomerPaymentRegisteredRecordsTurnover.DayPeriod = Currency_Rates.Period
		LEFT JOIN ExchangeRates AS SettlementCurrencyRatesAtBeginning
		ON (SettlementCurrencyRatesAtBeginning.Period = &amp;BeginOfPeriod)
			AND CustomerPaymentRegisteredRecordsTurnover.PaymentCurrency = SettlementCurrencyRatesAtBeginning.Currency
		LEFT JOIN ExchangeRates AS CurrencyExchangeRatesAtBeginning
		ON (CurrencyExchangeRatesAtBeginning.Currency = &amp;ScenarioCurrency)
			AND (CurrencyExchangeRatesAtBeginning.Period = &amp;BeginOfPeriod)
WHERE
	CustomerPaymentRegisteredRecordsTurnover.BusinessOperation IN (&amp;PaymentOperations)
{WHERE
	CustomerPaymentRegisteredRecordsTurnover.Organization.* AS Organization,
	(CustomerPaymentRegisteredRecordsTurnover.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment AS SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	CustomerPaymentRegisteredRecordsTurnover.Partner,
	CustomerPaymentRegisteredRecordsTurnover.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN CustomerPaymentRegisteredRecordsTurnover.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN CustomerPaymentRegisteredRecordsTurnover.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN CustomerPaymentRegisteredRecordsTurnover.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN CustomerPaymentRegisteredRecordsTurnover.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN CustomerPaymentRegisteredRecordsTurnover.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN CustomerPaymentRegisteredRecordsTurnover.YearPeriod
		ELSE CustomerPaymentRegisteredRecordsTurnover.DayPeriod
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DynamicPeriod,
	NestedQuery.Partner,
	NestedQuery.Recorder,
	SUM(NestedQuery.ShippingPlan_) AS ShippingPlan_,
	SUM(NestedQuery.PaymentPlan_1) AS PaymentPlan_1,
	SUM(NestedQuery.FactShipment) AS FactShipment,
	SUM(NestedQuery.FactPayment) AS FactPayment
INTO PlanFact
FROM
	(SELECT
		Plans.DynamicPeriod AS DynamicPeriod,
		Plans.Partner AS Partner,
		Plans.Recorder AS Recorder,
		Plans.ShippingPlan_ AS ShippingPlan_,
		Plans.PaymentPlan_1 AS PaymentPlan_1,
		0 AS FactShipment,
		0 AS FactPayment
	FROM
		Plans AS Plans
	
	UNION ALL
	
	SELECT
		Real.DynamicPeriod,
		Real.Partner,
		Real.Recorder,
		0,
		0,
		Real.FactShipment,
		Real.FactPayment
	FROM
		Real AS Real) AS NestedQuery

GROUP BY
	NestedQuery.DynamicPeriod,
	NestedQuery.Partner,
	NestedQuery.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PlanFact.DynamicPeriod,
	PlanFact.Partner AS Partner,
	PlanFact.Recorder,
	PlanFact.ShippingPlan_,
	PlanFact.PaymentPlan_1,
	PlanFact.FactShipment,
	PlanFact.FactPayment,
	100 * (CASE
		WHEN SUM(PlanFact.PaymentPlan_1) = 0
			THEN 0
		ELSE SUM(PlanFact.FactPayment) / SUM(PlanFact.PaymentPlan_1)
	END) AS ExecutionOfPaymentPlan_
FROM
	PlanFact AS PlanFact
WHERE
	PlanFact.DynamicPeriod BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	PlanFact.DynamicPeriod,
	PlanFact.Recorder,
	PlanFact.ShippingPlan_,
	PlanFact.PaymentPlan_1,
	PlanFact.FactShipment,
	PlanFact.FactPayment,
	PlanFact.Partner</query>
				<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
			</dataSet>
