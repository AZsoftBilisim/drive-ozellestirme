					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Volume, %13%</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>حجم، %13 درصد</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Volume, %13%</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Objętość, %13%</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Объем, %13%</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
