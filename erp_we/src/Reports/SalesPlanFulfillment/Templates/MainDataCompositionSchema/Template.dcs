			<calculatedField>
				<dataPath>PlanExecution.VolumeM3</dataPath>
				<expression>100 * (Case When Plan.Count = 0 Then 0 Else Real.Count / Plan.Count End)</expression>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
