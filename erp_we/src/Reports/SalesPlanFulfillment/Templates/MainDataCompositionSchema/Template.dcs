								<v8:lang>it</v8:lang>
								<v8:content>ND=10; NFD=1</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>ЧЦ(ND)=15; ЧДЦ(NFD)=2</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>ND=10; NFD=1</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>ND=10; NFD=1</v8:content>
