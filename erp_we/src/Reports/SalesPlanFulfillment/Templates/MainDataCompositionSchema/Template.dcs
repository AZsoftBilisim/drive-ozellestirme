	<settingsVariant>
		<dcsset:name>PaymentPlanFulfillmentByCustomers</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Payment and shipment plan fulfillment by customers</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>اجرای برنامه پرداخت و ارسال بر اساس مشتریان</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Esecuzione del piano di pagamento e spedizione per cliente</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wykonanie planu płatności i wysyłki według klientów</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Исполнение плана оплат и отгрузок по клиентам</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
