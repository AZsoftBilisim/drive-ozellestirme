		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	RegisterTable.Recorder AS DocumentRegisterRecords,
	RegisterTable.ReferenceOrder AS ReferenceOrder,
	RegisterTable.Products AS Products,
	RegisterTable.Characteristic AS Characteristic,
	RegisterTable.Series AS Series,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
					THEN RegisterTable.CountTurnover
				ELSE 0
			END), 0) AS IssuedQuantity,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
					THEN RegisterTable.SumTurnover
				ELSE 0
			END), 0) AS IssuedAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
					THEN RegisterTable.VATAmountComplTurnover
				ELSE 0
			END), 0) AS IssuedVATAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RegisteredOnReturns)
					THEN RegisterTable.CountTurnover
				ELSE 0
			END), 0) AS IssuedByReturnsQuantity,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RegisteredOnReturns)
					THEN RegisterTable.SumTurnover
				ELSE 0
			END), 0) AS IssuedByReturnsAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.RegisteredOnReturns)
					THEN RegisterTable.VATAmountComplTurnover
				ELSE 0
			END), 0) AS IssuedByReturnsVATAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
					THEN RegisterTable.CountTurnover
				ELSE 0
			END), 0) AS ShippedQuantity,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
					THEN RegisterTable.SumTurnover
				ELSE 0
			END), 0) AS ShippedAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
					THEN RegisterTable.VATAmountComplTurnover
				ELSE 0
			END), 0) AS ShippedVATAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WrittenOffBeforeTransferOfTitleToGoods)
					THEN RegisterTable.CountTurnover
				ELSE 0
			END), 0) AS DeductedToPPPQuantity,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WrittenOffBeforeTransferOfTitleToGoods)
					THEN RegisterTable.SumTurnover
				ELSE 0
			END), 0) AS DebitedToPPPAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WrittenOffBeforeTransferOfTitleToGoods)
					THEN RegisterTable.VATAmountComplTurnover
				ELSE 0
			END), 0) AS DeductedToPPPVATAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ReceivedBeforeTransferOfTitleToGoods)
					THEN RegisterTable.CountTurnover
				ELSE 0
			END), 0) AS RegisteredUpToPPPQuantity,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ReceivedBeforeTransferOfTitleToGoods)
					THEN RegisterTable.SumTurnover
				ELSE 0
			END), 0) AS RegisteredUpToPPPAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ReceivedBeforeTransferOfTitleToGoods)
					THEN RegisterTable.VATAmountComplTurnover
				ELSE 0
			END), 0) AS RegisteredBeforePPPVATAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.TaxInvoicesRegistered)
					THEN RegisterTable.CountTurnover
				ELSE 0
			END), 0) AS IssuedInvoicesQuantity,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.TaxInvoicesRegistered)
					THEN RegisterTable.SumTurnover
				ELSE 0
			END), 0) AS IssuedInvoicesAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.TaxInvoicesRegistered)
					THEN RegisterTable.VATAmountComplTurnover
				ELSE 0
			END), 0) AS IssuedInvoicesVATAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WasAdjusted)
					THEN RegisterTable.CountTurnover
				ELSE 0
			END), 0) AS AdjustedQuantity,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WasAdjusted)
					THEN RegisterTable.SumTurnover
				ELSE 0
			END), 0) AS AdjustedAmount,
	ISNULL(SUM(CASE
				WHEN RegisterTable.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.WasAdjusted)
					THEN RegisterTable.VATAmountComplTurnover
				ELSE 0
			END), 0) AS AdjustedVATAmount
INTO TTRegisterTableExpanded
FROM
	AccumulationRegister.ShipmentAndReturnReferences.Turnovers(, , Recorder, ReferenceOrder IN (&amp;ReferenceArray)) AS RegisterTable

GROUP BY
	RegisterTable.Recorder,
	RegisterTable.ReferenceOrder,
	RegisterTable.Products,
	RegisterTable.Characteristic,
	RegisterTable.Series
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TTRegisterTableExpanded.ReferenceOrder AS ReferenceOrder,
	TTRegisterTableExpanded.DocumentRegisterRecords AS DocumentRegisterRecords,
	TTRegisterTableExpanded.Products AS Products,
	TTRegisterTableExpanded.Characteristic AS Characteristic,
	TTRegisterTableExpanded.Series AS Series,
	TTRegisterTableExpanded.ShippedQuantity - TTRegisterTableExpanded.IssuedByReturnsQuantity - TTRegisterTableExpanded.DeductedToPPPQuantity  + TTRegisterTableExpanded.RegisteredUpToPPPQuantity AS ShippedQuantity,
	TTRegisterTableExpanded.ShippedAmount - TTRegisterTableExpanded.IssuedByReturnsAmount - TTRegisterTableExpanded.DebitedToPPPAmount + TTRegisterTableExpanded.RegisteredUpToPPPAmount AS ShippedAmount,
	TTRegisterTableExpanded.ShippedVATAmount - TTRegisterTableExpanded.IssuedByReturnsVATAmount - TTRegisterTableExpanded.DeductedToPPPVATAmount + TTRegisterTableExpanded.RegisteredBeforePPPVATAmount AS ShippedVATAmount,
	TTRegisterTableExpanded.IssuedQuantity + TTRegisterTableExpanded.AdjustedQuantity AS RealizedQuantity,
	TTRegisterTableExpanded.IssuedAmount + TTRegisterTableExpanded.AdjustedAmount AS RealizedAmount,
	TTRegisterTableExpanded.IssuedVATAmount + TTRegisterTableExpanded.AdjustedVATAmount AS RealizedVATAmount,
	TTRegisterTableExpanded.IssuedInvoicesQuantity AS IssuedInvoicesQuantity,
	TTRegisterTableExpanded.IssuedInvoicesAmount AS IssuedInvoicesAmount,
	TTRegisterTableExpanded.IssuedInvoicesVATAmount AS IssuedInvoicesVATAmount
FROM
	TTRegisterTableExpanded AS TTRegisterTableExpanded</query>
