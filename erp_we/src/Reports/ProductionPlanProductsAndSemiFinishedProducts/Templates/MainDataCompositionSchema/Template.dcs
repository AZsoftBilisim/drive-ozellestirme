			<presentationExpression>Case
    When &amp;Periodicity = Value(Enum.Periodicity.Month)
        Then Format(Period, "DF='MMMM (yyyy)'")
    When &amp;Periodicity = Value(Enum.Periodicity.Week)
        Then Format(Period, "DLF=D") + " - " + Format(EndOfPeriod(Period, "Week"), "DLF=D")
    Else Format(Period, "DLF='D'")
End</presentationExpression>
		</field>
