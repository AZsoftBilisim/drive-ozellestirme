		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.DAY)
			THEN ProductionPlansTurnovers.DayPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN ProductionPlansTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN ProductionPlansTurnovers.MonthPeriod
	END AS Period,
	ProductionPlansTurnovers.Scenario AS Scenario,
	ProductionPlansTurnovers.Status AS Status,
	ProductionPlansTurnovers.Products AS Products,
	ProductionPlansTurnovers.Characteristic AS Characteristic,
	ProductionPlansTurnovers.Department AS Department,
	ProductionPlansTurnovers.ProductionPlan AS ProductionPlan,
	ProductionPlansTurnovers.BillOfMaterials AS BillOfMaterials,
	ProductionPlansTurnovers.Purpose AS Purpose,
	ProductionPlansTurnovers.ThisIsASemiFinishedProduct AS ThisIsASemiFinishedProduct,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductionPlansTurnovers.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN ProductionPlansTurnovers.Products.UnitFactorForReports &lt;&gt; 0
						THEN ProductionPlansTurnovers.CountTurnover / ProductionPlansTurnovers.Products.UnitFactorForReports
					ELSE 0
				END
	END AS Count
FROM
	AccumulationRegister.ProductionPlans.Turnovers(
		{(&amp;StartDate)},
		{(&amp;EndDate)},
		Auto,
		&amp;GenerationMethod = 1 AND NOT &amp;ThisIsDisassembly
			OR &amp;GenerationMethod = 0 AND &amp;ThisIsDisassembly
	) AS ProductionPlansTurnovers

UNION ALL

SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.DAY)
			THEN BEGINOFPERIOD(ProductionPlansTurnovers.DateOfOrderReleaseAndProductionIssue, DAY)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(ProductionPlansTurnovers.DateOfOrderReleaseAndProductionIssue, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(ProductionPlansTurnovers.DateOfOrderReleaseAndProductionIssue, MONTH)
	END,
	ProductionPlansTurnovers.Scenario,
	ProductionPlansTurnovers.Status,
	ProductionPlansTurnovers.Products,
	ProductionPlansTurnovers.Characteristic,
	ProductionPlansTurnovers.Department,
	ProductionPlansTurnovers.ProductionPlan,
	ProductionPlansTurnovers.BillOfMaterials,
	ProductionPlansTurnovers.Purpose,
	ProductionPlansTurnovers.ThisIsASemiFinishedProduct,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductionPlansTurnovers.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN ProductionPlansTurnovers.Products.UnitFactorForReports &lt;&gt; 0
						THEN ProductionPlansTurnovers.CountTurnover / ProductionPlansTurnovers.Products.UnitFactorForReports
					ELSE 0
				END
	END
FROM
	AccumulationRegister.ProductionPlans.Turnovers(
			,
			,
			,
			(&amp;GenerationMethod = 0 AND NOT &amp;ThisIsDisassembly
				OR &amp;GenerationMethod = 1 AND &amp;ThisIsDisassembly)
			AND (&amp;StartDate = DATETIME(1, 1, 1)
				OR DateOfOrderReleaseAndProductionIssue &gt;= &amp;StartDate)
			AND (&amp;EndDate = DATETIME(1, 1, 1)
				OR DateOfOrderReleaseAndProductionIssue &lt;= &amp;EndDate)) AS ProductionPlansTurnovers</query>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
