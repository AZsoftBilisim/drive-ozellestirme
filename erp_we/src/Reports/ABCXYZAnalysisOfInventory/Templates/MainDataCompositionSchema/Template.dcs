		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	InventoryCost.ItemsLocationAttributes.StorageLocation AS Warehouse,
	InventoryCost.ItemsLocationAttributes.Products AS Products,
	InventoryCost.ItemsLocationAttributes.Characteristic AS Characteristic,
	(SUM(InventoryCost.CostBalance) + SUM(InventoryCost.AddExpensesForGoodsBalance) + SUM(InventoryCost.OffBalanceCostBalance) + SUM(InventoryCost.LaborCostsBalance) + SUM(InventoryCost.ItemizedFixedCostsIncludingVATBalance)) / SUM(InventoryCost.CountBalance) AS UnitCost
FROM
	AccumulationRegister.InventoryCost.Balance AS InventoryCost
WHERE
	InventoryCost.ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)

GROUP BY
	InventoryCost.ItemsLocationAttributes.StorageLocation,
	InventoryCost.ItemsLocationAttributes.Products,
	InventoryCost.ItemsLocationAttributes.Characteristic

HAVING
	SUM(InventoryCost.CountBalance) &gt; 0</query>
