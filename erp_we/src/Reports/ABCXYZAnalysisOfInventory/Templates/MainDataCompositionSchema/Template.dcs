					<v8:lang>tr</v8:lang>
					<v8:content>Miktar</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số lượng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Warehouses.Ref AS ClassificationSection
INTO ClassificationSections
FROM
	Catalog.Warehouses AS Warehouses
WHERE
	NOT Warehouses.Ref.IsFolder

UNION ALL

SELECT
	Companies.Ref AS ClassificationSection
FROM
	Catalog.Companies AS Companies

UNION ALL

SELECT
	BusinessStructure.Ref AS ClassificationSection
FROM
	Catalog.BusinessStructure AS BusinessStructure
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ClassificationSections.ClassificationSection AS Warehouse,
	Products.Ref AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	ABCClassification.Ref AS ABCClassificationParameterType,
	XYZClassification.Ref AS XYZClassificationParameterType
INTO ProductsCharacteristic
FROM
	Catalog.Products AS Products
		LEFT JOIN ClassificationSections AS ClassificationSections
		ON (TRUE)
		LEFT JOIN Enum.TypesOfClassificationParameters AS ABCClassification
		ON (TRUE)
		LEFT JOIN Enum.TypesOfClassificationParameters AS XYZClassification
		ON (TRUE)
WHERE
	Products.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))

UNION

SELECT
	ClassificationSections.ClassificationSection,
	Products.Ref,
	ISNULL(Characteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)),
	ABCClassification.Ref,
	XYZClassification.Ref
FROM
	Catalog.Products AS Products
		LEFT JOIN Catalog.ItemsCharacteristics AS Characteristics
		ON (Characteristics.Owner = CASE
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN Products.ProductKind
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN Products.Ref
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN Products.ItemVariantsOwner
				ELSE FALSE
			END)
		LEFT JOIN ClassificationSections AS ClassificationSections
		ON (TRUE)
		LEFT JOIN Enum.TypesOfClassificationParameters AS ABCClassification
		ON (TRUE)
		LEFT JOIN Enum.TypesOfClassificationParameters AS XYZClassification
		ON (TRUE)
WHERE
	Products.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
;

SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.InStockBalance AS InStockBalance,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.OrderedBalance AS OrderedBalance,
	Inventories.Received_1Balance AS Received_1Balance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
	Inventories.ToSupplyBalance AS ToSupplyBalance,
	Inventories.NotProvideBalance AS NotProvideBalance
INTO InventoryAndDemandsBalance
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		(Products, Characteristic, Warehouse) IN(
			SELECT
				Filter.Products AS Products,
				Filter.Characteristic AS Characteristic,
				Filter.Warehouse AS Warehouse
			FROM
				ProductsCharacteristic AS Filter)) AS Inventories
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Calculation.Products AS Products,
	Calculation.Characteristic AS Characteristic,
	Calculation.Warehouse AS Warehouse,
	SUM(Calculation.QuantityInStock) AS QuantityInStock
INTO TempTableBalance
FROM
	CalculationOfBalancesForSettingActions AS Calculation
GROUP BY
	Calculation.Products,
	Calculation.Characteristic,
	Calculation.Warehouse
INDEX BY
	Products, Characteristic, Warehouse
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	ProductsCharacteristic.Warehouse AS Warehouse,
	ProductsCharacteristic.Products AS Products,
	ProductsCharacteristic.Characteristic AS Characteristic,
	ProductsCharacteristic.ABCClassificationParameterType AS ABCClassificationParameterType,
	ProductsCharacteristic.XYZClassificationParameterType AS XYZClassificationParameterType,
	ISNULL(ABCClassification.Class, VALUE(Enum.ABCClassification.NotClassified)) AS ABC,
	ISNULL(XYZClassification.Class, VALUE(Enum.XYZClassification.NotClassified)) AS XYZ,
	ISNULL(ABCClassification.ClassificationParameterValue, 0) AS ABCValue,
	ISNULL(XYZClassification.ClassificationParameterValue, 0) AS XYZValue,
	Calculation.QuantityInStock AS Count
{SELECT
	Warehouse AS Warehouse,
	Products AS Products,
	Characteristic AS Characteristic,
	ABCClassificationParameterType AS ABCClassificationParameterType,
	XYZClassificationParameterType AS XYZClassificationParameterType,
	ABC AS ABC,
	XYZ AS XYZ,
	ABCValue AS ABCValue,
	XYZValue AS XYZValue,
	Count AS Count}
FROM
	ProductsCharacteristic AS ProductsCharacteristic
		{LEFT JOIN TempTableBalance AS Calculation
		ON Calculation.Products = ProductsCharacteristic.Products
		 AND Calculation.Characteristic = ProductsCharacteristic.Characteristic
		 AND Calculation.Warehouse = ProductsCharacteristic.Warehouse}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast AS ABCClassification
		ON ProductsCharacteristic.ABCClassificationParameterType = ABCClassification.ClassificationParameterType
			AND (ABCClassification.ClassificationType = VALUE(Enum.TypesOfClassification.ABC))
			AND ProductsCharacteristic.Warehouse = ABCClassification.ClassificationSection
			AND ProductsCharacteristic.Products = ABCClassification.Products
			AND ProductsCharacteristic.Characteristic = ABCClassification.Characteristic}
		{LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast AS XYZClassification
		ON ProductsCharacteristic.XYZClassificationParameterType = XYZClassification.ClassificationParameterType
			AND (XYZClassification.ClassificationType = VALUE(Enum.TypesOfClassification.XYZ))
			AND ProductsCharacteristic.Warehouse = XYZClassification.ClassificationSection
			AND ProductsCharacteristic.Products = XYZClassification.Products
			AND ProductsCharacteristic.Characteristic = XYZClassification.Characteristic}
		{LEFT JOIN InformationRegister.SegmentProducts AS SegmentProducts
		ON ProductsCharacteristic.Products = SegmentProducts.Products
			AND ProductsCharacteristic.Characteristic = SegmentProducts.Characteristic}
{WHERE
	(ISNULL(SegmentProducts.Segment, VALUE(Catalog.ProductSegments.EmptyRef))) AS ProductSegment}
{WHERE
	ProductsCharacteristic.Warehouse.* AS Warehouse,
	ProductsCharacteristic.Products.* AS Products,
	ProductsCharacteristic.Characteristic.* AS Characteristic,
	ProductsCharacteristic.ABCClassificationParameterType AS ABCClassificationParameterType,
	ProductsCharacteristic.XYZClassificationParameterType AS XYZClassificationParameterType,
	ISNULL(ABCClassification.Class, VALUE(Enum.ABCClassification.NotClassified)) AS ABC,
	ISNULL(XYZClassification.Class, VALUE(Enum.XYZClassification.NotClassified)) AS XYZ,
	ISNULL(ABCClassification.ClassificationParameterValue, 0) AS ABCValue,
	ISNULL(XYZClassification.ClassificationParameterValue, 0) AS XYZValue,
	Calculation.QuantityInStock AS Count}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
