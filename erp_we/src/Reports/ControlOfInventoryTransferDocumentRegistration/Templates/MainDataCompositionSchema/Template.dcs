				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// The text of the request is filled in automatically in the module of the object TextControl formationdocumentsreferences()

SELECT ALLOWED
	"" AS OperationKind,
	"" AS VarianceType,
	"" AS Recommendation,
	0 AS IncompleteWarehouseOperation,
	0 AS UnfinishedFinancialTransaction,
	DATETIME(1, 1, 1) AS DateOfTransaction,
	CASE
		WHEN TRUE
			THEN GoodsForIssue.DocumentShipments
		ELSE GoodsToReceive.DocumentInflow
	END AS ReferenceOrder,
	CatalogWarehouses.Ref AS Warehouse,
	CatalogProducts.Ref AS Products,
	CatalogItemsCharacteristics.Ref AS Characteristic,
	CatalogItemsBatches.Ref AS Series,
	CatalogAssignments.Ref AS Purpose
FROM
	AccumulationRegister.GoodsForIssue.Balance(&amp;PeriodLimit) AS GoodsForIssue,
	AccumulationRegister.GoodsToReceive.Balance(&amp;PeriodLimit) AS GoodsToReceive,
	Catalog.Warehouses AS CatalogWarehouses,
	Catalog.Products AS CatalogProducts,
	Catalog.ItemsCharacteristics AS CatalogItemsCharacteristics,
	Catalog.ItemsBatches AS CatalogItemsBatches,
	Catalog.Assignments AS CatalogAssignments</query>
	</dataSet>
	<calculatedField>
		<dataPath>DurationOfOperation</dataPath>
		<expression>Case When DateOfTransaction = DateTime(1, 1, 1) 
Then 0 
Else DateDiff(DateOfTransaction, &amp;EndOfDayDate, "Day")
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Days</v8:content>
			</v8:item>
