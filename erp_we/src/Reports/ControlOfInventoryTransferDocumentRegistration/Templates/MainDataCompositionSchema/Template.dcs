		<field xsi:type="DataSetFieldField">
			<dataPath>OperationKind</dataPath>
			<field>OperationKind</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Operation type</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نوع عملیات</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Tipo di operazione</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Typ operacji</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вид операции</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>İşlem türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Dạng giao dịch</v8:content>
				</v8:item>
			</title>
			<orderExpression>
				<dcscom:expression>Case 
    When OperationKind = &amp;LineTypeOfOperationShipmentToCustomers Then 1
    When OperationKind = &amp;OperationTypeRowRefundsFromCustomers Then 2
    When OperationKind = &amp;LineTypeOfOperationAcceptanceFromSuppliers Then 3
    When OperationKind = &amp;TypeOfOperationReturnsToSuppliers Then 4
    When OperationKind = &amp;LineTypeOfOperationInternalConsumption Then 5
    When OperationKind = &amp;LineTypeOfOperationMovingGoods Then 6
    When OperationKind = &amp;LineTypeOfOperationAssemblyDisassemblyOfGoods Then 7
    When OperationKind = &amp;LineTypeOfOperationOtherProductRegistration Then 8
    When OperationKind = &amp;LineTypeOfOperationTransferOfMaterialsToProduction Then 9
    When OperationKind = &amp;RowTypeOfOperationReturnsOfMaterialsFromProduction Then 10
    When OperationKind = &amp;LineTypeOfOperationAcceptanceOfFinishedProducts Then 11
    When OperationKind = &amp;ThisTypeOfOperationProcessingRawMaterialsGiver Then 12
    When OperationKind = &amp;LineTypeOfOperationReturnsOfRawMaterialsToGivers Then 13
    When OperationKind = &amp;ThisIsTypeOfOperationForTransferringProductsToGivers Then 14
    When OperationKind = &amp;LineTypeOfOperationProcessingOfRawMaterialsFromProcessor Then 15
    When OperationKind = &amp;OperationTypeRowReturnsOfRawMaterialsFromProcessors Then 16
    When OperationKind = &amp;LineTypeOfTransactionReceiptOfProductsFromProcessors Then 17
    When OperationKind = &amp;LineTypeOfOperationRegistrationOfSurplusesAndShortages Then 18
End</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>false</dcscom:autoOrder>
			</orderExpression>
			<valueType>
				<v8:Type>xs:string</v8:Type>
				<v8:StringQualifiers>
					<v8:Length>0</v8:Length>
					<v8:AllowedLength>Variable</v8:AllowedLength>
				</v8:StringQualifiers>
			</valueType>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>MinWidth</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">30</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>MaxWidth</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">30</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>Text</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType"/>
				</dcscor:item>
			</appearance>
			<availableValue>
				<value xsi:type="xs:string">LineTypeOfOperationShipmentToCustomers</value>
				<presentation xsi:type="v8:LocalStringType">
					<v8:item>
