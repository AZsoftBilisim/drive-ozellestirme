	<calculatedField>
		<dataPath>OverloadLoadingType</dataPath>
		<expression>Case
	When Overload &gt; 0
		Then
			Case
				When Available &gt; 0
					Then 
						Case
							When (Overload/Available * 100) &lt;= 100
								Then 3
							When (Overload/Available * 100) &lt;= 200
								Then 4
							Else 5
						End
				Else 6
			End
	Else
		Case
			When Available &gt; 0
				Then
					Case 
						When (Load/Available * 100) &lt;= (100-AvailabilityReserveInterest)
							Then 1
						Else 2
					End
			Else
				Case
					When Load &gt; 0
						Then 6
					Else 1
				End
			
		End
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Load/overload type</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>نوع بار/اضافه‌بار</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Tipo di carico/sovraccarico</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Rodzaj ładowania/przeładowania</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Тип загрузки/перегрузки</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Çalışma yükü/aşırı yükü türü</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Loại tải / quá tải</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Available</dataPath>
		<expression>Sum(Available)</expression>
	</totalField>
	<totalField>
		<dataPath>Load</dataPath>
		<expression>Sum(Load)</expression>
	</totalField>
	<totalField>
		<dataPath>Overload</dataPath>
		<expression>Sum(Overload)</expression>
	</totalField>
	<totalField>
		<dataPath>LoadingPercentages</dataPath>
		<expression>Case 
When Sum(Available) &gt; 0
Then Sum(Load)/Sum(Available)*100
Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>OverloadPercentages</dataPath>
		<expression>Case 
When Sum(Available) &gt; 0
Then Sum(Overload)/Sum(Available)*100
Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>AvailableHours</dataPath>
		<expression>Sum(Available)/3600</expression>
	</totalField>
	<totalField>
		<dataPath>LoadingHours</dataPath>
		<expression>Sum(Load)/3600</expression>
	</totalField>
	<totalField>
		<dataPath>OverloadClock</dataPath>
		<expression>Sum(Overload)/3600</expression>
	</totalField>
	<totalField>
		<dataPath>OverloadLoadingType</dataPath>
		<expression>Case
	When Sum(Overload) &gt; 0
		Then
			Case
				When Sum(Available) &gt; 0
					Then 
						Case
							When (Sum(Overload)/Sum(Available) * 100) &lt;= 100
								Then 3
							When (Sum(Overload)/Sum(Available) * 100) &lt;= 200
								Then 4
							Else 5
						End
				Else 6
			End
	Else
		Case
			When Sum(Available) &gt; 0
				Then
					Case 
						When (Sum(Load)/Sum(Available) * 100) &lt;= (100-Max(AvailabilityReserveInterest))
							Then 1
						Else 2
					End
			Else 
				Case
					When Sum(Load) &gt; 0
						Then 6
					Else 1
				End
		End
End</expression>
	</totalField>
