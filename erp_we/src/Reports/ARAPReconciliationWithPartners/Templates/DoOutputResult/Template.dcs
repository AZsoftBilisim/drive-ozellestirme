		<dataSource>DataSource1</dataSource>
		<query>// The report displays a list of all completed reconciliation documents for the specified period
// and lines with discrepancies for each reconciliation document, if any.
// In the first-level grouping by organization, in the columns "Our debt", "Counterparty debt", according to the organization and the counterparty
// , the final balance for the Cur organization is displayed (the balance is calculated in terms of the resource on the Resources tab).
// In the grouping of the second level according to the reconciliation document, in the columns "Our debt", "Counterparty debt" according to the organization and the counterparty
// , the final balance for the Cur document is displayed. 
// This final balance must coincide with what is displayed in the printed form of the reconciliation report of this document.
// In the third-level grouping according to the settlement document, in the columns "Our debt", "Counterparty debt" 
// , the amounts for a specific settlement document for which a discrepancy is indicated in the tabular part of the reconciliation document are displayed.
// Grouping by settlement document displays only lines with discrepancies.
// If there are no discrepancies, then the column "Our debt" according to the organization is equal to the column "Our debt" according to the counterparty.
// For the column "Counterparty debt" is the same.

// Document.ARAPReconciliation2_4
SELECT ALLOWED
	DocumentHeader.Ref AS ARAPReconciliation,
	DocumentTable.PaymentType_ AS PaymentType_,
	DocumentHeader.Organization AS Organization,
	DocumentHeader.Counterparty AS Counterparty,
	DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AS TheseAreSettlementsWithCustomers,
	DocumentTable.Partner AS Partner,
	DocumentTable.ARAPObject.ARAPCurrency AS ARAPCurrency,
	DocumentTable.ARAPObject AS ARAPObject,
	DocumentTable.ARAPDocument AS ARAPDocument,
	CASE WHEN DocumentHeader.ThereAreDiscrepancies
		THEN DocumentTable.DebtAmountCounterparty
		ELSE DocumentTable.DebtAmount_
	END AS DebtAmountCounterparty,
	CASE WHEN DocumentHeader.ThereAreDiscrepancies
		THEN DocumentTable.AmountPrepaymentCounterparty
		ELSE DocumentTable.AmountPrepayment
	END AS AmountPrepaymentCounterparty,
	
	DocumentTable.DebtAmount_ AS DebtAmount_,
	DocumentTable.AmountPrepayment AS AmountPrepayment
INTO TTDetailedRecordsCalculations
FROM
	Document.ARAPReconciliation2_4 AS DocumentHeader
	INNER JOIN Document.ARAPReconciliation2_4.DetailedRecordsARAPAccounting AS DocumentTable
		ON DocumentHeader.Ref = DocumentTable.Ref
WHERE
	DocumentHeader.Posted
	AND NOT (TRUE IN (
			SELECT TOP 1
				TRUE
			FROM
				Document.ARAPReconciliation2_4.CounterpartyData AS CounterpartyData
			WHERE
				DocumentHeader.Ref = CounterpartyData.Ref
		)
	)
{WHERE
	DocumentHeader.Date BETWEEN &amp;BeginOfPeriod AND &amp;PeriodEnding
}
{WHERE
	NOT (TRUE IN (
			SELECT TOP 1
				TRUE
			FROM
				Document.ARAPReconciliation2_4.GroupingsFinancialInstruments AS FinTools
			WHERE
				DocumentHeader.Ref = FinTools.Ref
				AND FinTools.PaymentType_ IN (&amp;ProhibitedPaymentTypes)
		)
	)
}
;

// The initial balance of the Document.SPARKLE_2_4 ACCOUNTING_2_4
SELECT ALLOWED
	DocumentHeader.Ref AS ARAPReconciliation,
	DocumentTable.PaymentType_ AS PaymentType_,
	DocumentHeader.Organization AS Organization,
	DocumentHeader.Counterparty AS Counterparty,
	DocumentTable.Partner AS Partner,
	UNDEFINED AS ARAPCurrency,
	UNDEFINED AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	
	//According To The Counterparty
	CASE
		WHEN DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AND SUM(DocumentTable.OpeningBalance) &gt; 0
			THEN SUM(DocumentTable.OpeningBalance)
		WHEN NOT DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AND SUM(DocumentTable.OpeningBalance) &lt; 0
			THEN -SUM(DocumentTable.OpeningBalance)
		ELSE
			0
	END AS CounterpartyDataPartnerDebt,
	CASE
		WHEN DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AND SUM(DocumentTable.OpeningBalance) &lt; 0
			THEN -SUM(DocumentTable.OpeningBalance)
		WHEN NOT DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AND SUM(DocumentTable.OpeningBalance) &gt; 0
			THEN SUM(DocumentTable.OpeningBalance)
		ELSE
			0
	END AS CounterpartyDataAmountOurDebt,
	
	//according to the organization
	CASE
		WHEN DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AND SUM(DocumentTable.OpeningBalance) &gt; 0
			THEN SUM(DocumentTable.OpeningBalance)
		WHEN NOT DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AND SUM(DocumentTable.OpeningBalance) &lt; 0
			THEN -SUM(DocumentTable.OpeningBalance)
		ELSE
			0
	END AS OrganizationDataPartnerSDebtAmount,
	CASE
		WHEN DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AND SUM(DocumentTable.OpeningBalance) &lt; 0
			THEN -SUM(DocumentTable.OpeningBalance)
		WHEN NOT DocumentTable.PaymentType_ = &amp;CustomersARAPAccounting AND SUM(DocumentTable.OpeningBalance) &gt; 0
			THEN SUM(DocumentTable.OpeningBalance)
		ELSE
			0
	END AS TheseOrganizationsAmountToOurDebt,
	
	//Discrepancies
	0 AS PartnerDebtDiscrepancies,
	0 AS DiscrepanciesAreOurDebt
INTO TTDataOfReconciliationDocuments
FROM
	Document.ARAPReconciliation2_4 AS DocumentHeader
	INNER JOIN Document.ARAPReconciliation2_4.GroupingsARAP AS DocumentTable
		ON DocumentHeader.Ref = DocumentTable.Ref
WHERE
	DocumentHeader.Posted
	AND NOT (TRUE IN (
			SELECT TOP 1
				TRUE
			FROM
				Document.ARAPReconciliation2_4.CounterpartyData AS CounterpartyData
			WHERE
				DocumentHeader.Ref = CounterpartyData.Ref
		)
	)
GROUP BY
	DocumentHeader.Ref,
	DocumentTable.PaymentType_,
	DocumentHeader.Organization,
	DocumentHeader.Counterparty,
	DocumentTable.Partner
{WHERE
	DocumentHeader.Date BETWEEN &amp;BeginOfPeriod AND &amp;PeriodEnding
}
{WHERE
	NOT (TRUE IN (
			SELECT TOP 1
				TRUE
			FROM
				Document.ARAPReconciliation2_4.GroupingsFinancialInstruments AS FinTools
			WHERE
				DocumentHeader.Ref = FinTools.Ref
				AND FinTools.PaymentType_ IN (&amp;ProhibitedPaymentTypes)
		)
	)
}

UNION ALL

// Document Turnover.SPARKLE_2_4 ACCOUNTING_2_4
SELECT
	DocumentTable.ARAPReconciliation AS ARAPReconciliation,
	DocumentTable.PaymentType_ AS PaymentType_,
	DocumentTable.Organization AS Organization,
	DocumentTable.Counterparty AS Counterparty,
	DocumentTable.Partner AS Partner,
	DocumentTable.ARAPObject.ARAPCurrency AS ARAPCurrency,
	DocumentTable.ARAPObject AS ARAPObject,
	DocumentTable.ARAPDocument AS ARAPDocument,
	
	//According To The Counterparty
	CASE
		WHEN DocumentTable.TheseAreSettlementsWithCustomers AND DocumentTable.DebtAmountCounterparty &gt; DocumentTable.AmountPrepaymentCounterparty
			THEN DocumentTable.DebtAmountCounterparty - DocumentTable.AmountPrepaymentCounterparty
		WHEN NOT DocumentTable.TheseAreSettlementsWithCustomers AND DocumentTable.DebtAmountCounterparty &lt; DocumentTable.AmountPrepaymentCounterparty
			THEN DocumentTable.AmountPrepaymentCounterparty - DocumentTable.DebtAmountCounterparty
		ELSE 0
	END AS CounterpartyDataPartnerDebt,
	CASE
		WHEN DocumentTable.TheseAreSettlementsWithCustomers AND DocumentTable.AmountPrepaymentCounterparty &gt; DocumentTable.DebtAmountCounterparty
			THEN DocumentTable.AmountPrepaymentCounterparty - DocumentTable.DebtAmountCounterparty
		WHEN NOT DocumentTable.TheseAreSettlementsWithCustomers AND DocumentTable.AmountPrepaymentCounterparty &lt; DocumentTable.DebtAmountCounterparty
			THEN DocumentTable.DebtAmountCounterparty - DocumentTable.AmountPrepaymentCounterparty
		ELSE
			0
	END AS CounterpartyDataAmountOurDebt,
	
	//according to the organization
	CASE 
		WHEN DocumentTable.TheseAreSettlementsWithCustomers AND DocumentTable.DebtAmount_ &gt; DocumentTable.AmountPrepayment
			THEN DocumentTable.DebtAmount_ - DocumentTable.AmountPrepayment
		WHEN NOT DocumentTable.TheseAreSettlementsWithCustomers AND DocumentTable.DebtAmount_ &lt; DocumentTable.AmountPrepayment
			THEN DocumentTable.AmountPrepayment - DocumentTable.DebtAmount_
		ELSE 
			0
	END AS OrganizationDataPartnerSDebtAmount,
	CASE 
		WHEN DocumentTable.TheseAreSettlementsWithCustomers AND DocumentTable.AmountPrepayment &gt; DocumentTable.DebtAmount_
			THEN DocumentTable.AmountPrepayment - DocumentTable.DebtAmount_
		WHEN NOT DocumentTable.TheseAreSettlementsWithCustomers AND DocumentTable.AmountPrepayment &lt; DocumentTable.DebtAmount_
			THEN DocumentTable.DebtAmount_ - DocumentTable.AmountPrepayment
		ELSE
			0
	END AS TheseOrganizationsAmountToOurDebt,
	
	//Discrepancies
	DocumentTable.DebtAmountCounterparty - DocumentTable.DebtAmount_ AS PartnerDebtDiscrepancies,
	-(DocumentTable.AmountPrepaymentCounterparty - DocumentTable.AmountPrepayment) AS DiscrepanciesAreOurDebt
FROM
	TTDetailedRecordsCalculations AS DocumentTable

UNION ALL

//The initial balance of the Document.SPARKLE_OUTCOUNTS2_5_11
SELECT
	DocumentHeader.Ref AS ARAPReconciliation,
	DocumentTable.PaymentType_ AS PaymentType_,
	DocumentHeader.Organization AS Organization,
	DocumentHeader.Counterparty AS Counterparty,
	DocumentTable.Partner AS Partner,
	UNDEFINED AS ARAPCurrency,
	UNDEFINED AS ARAPObject,
	UNDEFINED AS ARAPDocument,
	
	//According To The Counterparty
	CASE WHEN SUM(DocumentTable.OpeningBalanceDr) &gt; SUM(DocumentTable.OpeningBalanceCr)
		THEN SUM(DocumentTable.OpeningBalanceDr) - SUM(DocumentTable.OpeningBalanceCr)
		ELSE 0
	END AS CounterpartyDataPartnerDebt,
	CASE WHEN SUM(DocumentTable.OpeningBalanceCr) &gt; SUM(DocumentTable.OpeningBalanceDr)
		THEN SUM(DocumentTable.OpeningBalanceCr) - SUM(DocumentTable.OpeningBalanceDr)
		ELSE 0
	END AS CounterpartyDataAmountOurDebt,
	
	//according to the organization
	CASE WHEN SUM(DocumentTable.OpeningBalanceDr) &gt; SUM(DocumentTable.OpeningBalanceCr)
		THEN SUM(DocumentTable.OpeningBalanceDr) - SUM(DocumentTable.OpeningBalanceCr)
		ELSE 0
	END AS OrganizationDataPartnerSDebtAmount,
	CASE WHEN SUM(DocumentTable.OpeningBalanceCr) &gt; SUM(DocumentTable.OpeningBalanceDr)
		THEN SUM(DocumentTable.OpeningBalanceCr) - SUM(DocumentTable.OpeningBalanceDr)
		ELSE 0
	END AS TheseOrganizationsAmountToOurDebt,
	
	//Discrepancies
	0 AS PartnerDebtDiscrepancies,
	0 AS DiscrepanciesAreOurDebt
FROM
	Document.ARAPReconciliation2_5_11 AS DocumentHeader
	INNER JOIN Document.ARAPReconciliation2_5_11.SummaryRecords AS DocumentTable
		ON DocumentHeader.Ref = DocumentTable.Ref
WHERE
	DocumentHeader.Posted
GROUP BY
	DocumentHeader.Ref,
	DocumentTable.PaymentType_,
	DocumentHeader.Organization,
	DocumentHeader.Counterparty,
	DocumentTable.Partner
{WHERE
	DocumentHeader.Date BETWEEN &amp;BeginOfPeriod AND &amp;PeriodEnding
}
{WHERE
	NOT (TRUE IN (
			SELECT TOP 1
				TRUE
			FROM
				Document.ARAPReconciliation2_5_11.DetailedRecords AS FinTools
			WHERE
				DocumentHeader.Ref = FinTools.Ref
				AND FinTools.PaymentType_ IN (&amp;ProhibitedPaymentTypes)
		)
	)
}

UNION ALL

// Document Turnover.SPARKLE_OUTCOUNTS2_5_11
SELECT
	DocumentHeader.Ref AS ARAPReconciliation,
	DocumentTable.PaymentType_ AS PaymentType_,
	DocumentHeader.Organization AS Organization,
	DocumentHeader.Counterparty AS Counterparty,
	DocumentTable.Partner AS Partner,
	CASE WHEN DocumentHeader.ModeOfARAPTotalsReconciliation = &amp;AccordingToObjectOfCalculations
		THEN DocumentTable.ARAPObject.ARAPCurrency
		ELSE DocumentTable.Contract.ARAPCurrency
	END AS ARAPCurrency,
	CASE WHEN DocumentHeader.ModeOfARAPTotalsReconciliation = &amp;AccordingToObjectOfCalculations
		THEN DocumentTable.ARAPObject
		ELSE DocumentTable.Contract
	END AS ARAPObject,
	DocumentTable.ARAPDocument AS ARAPDocument,
	
	//According To The Counterparty
	CASE WHEN DocumentHeader.ThereAreDiscrepancies
		THEN
			DocumentTable.AmountDebitCounterparty
		ELSE
			DocumentTable.DebitAmount
	END AS CounterpartyDataPartnerDebt,
	CASE WHEN DocumentHeader.ThereAreDiscrepancies
		THEN
			DocumentTable.AmountCreditCounterparty
		ELSE
			DocumentTable.LoanAmount_
	END AS CounterpartyDataAmountOurDebt,
	
	//according to the organization
	DocumentTable.DebitAmount AS OrganizationDataPartnerSDebtAmount,
	DocumentTable.LoanAmount_ AS TheseOrganizationsAmountToOurDebt,
	
	//Discrepancies
	CASE WHEN DocumentHeader.ThereAreDiscrepancies
		THEN
			DocumentTable.AmountDebitCounterparty
		ELSE
			DocumentTable.DebitAmount
	END - DocumentTable.DebitAmount AS PartnerDebtDiscrepancies,
	-(CASE WHEN DocumentHeader.ThereAreDiscrepancies
		THEN
			DocumentTable.AmountCreditCounterparty
		ELSE
			DocumentTable.LoanAmount_
	END - DocumentTable.LoanAmount_) AS DiscrepanciesAreOurDebt
FROM
	Document.ARAPReconciliation2_5_11 AS DocumentHeader
	INNER JOIN Document.ARAPReconciliation2_5_11.DetailedRecords AS DocumentTable
		ON DocumentHeader.Ref = DocumentTable.Ref
WHERE
	DocumentHeader.Posted
{WHERE
	DocumentHeader.Date BETWEEN &amp;BeginOfPeriod AND &amp;PeriodEnding
}
{WHERE
	NOT (TRUE IN (
			SELECT TOP 1
				TRUE
			FROM
				Document.ARAPReconciliation2_5_11.DetailedRecords AS FinTools
			WHERE
				DocumentHeader.Ref = FinTools.Ref
				AND FinTools.PaymentType_ IN (&amp;ProhibitedPaymentTypes)
		)
	)
}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DataOfReconciliationDocuments.ARAPReconciliation AS ARAPReconciliation,
	DataOfReconciliationDocuments.Organization AS Organization,
	DataOfReconciliationDocuments.Counterparty AS Counterparty,
	DataOfReconciliationDocuments.Partner AS Partner,
	DataOfReconciliationDocuments.ARAPCurrency AS ARAPCurrency,
	DataOfReconciliationDocuments.ARAPObject AS ARAPObject,
	DataOfReconciliationDocuments.ARAPDocument AS ARAPDocument,
	
	SUM(DataOfReconciliationDocuments.CounterpartyDataPartnerDebt) AS CounterpartyDataPartnerDebt,
	SUM(DataOfReconciliationDocuments.CounterpartyDataAmountOurDebt) AS CounterpartyDataAmountOurDebt,

	SUM(DataOfReconciliationDocuments.OrganizationDataPartnerSDebtAmount) AS OrganizationDataPartnerSDebtAmount,
	SUM(DataOfReconciliationDocuments.TheseOrganizationsAmountToOurDebt) AS TheseOrganizationsAmountToOurDebt,
	
	SUM(DataOfReconciliationDocuments.PartnerDebtDiscrepancies) AS PartnerDebtDiscrepancies,
	SUM(DataOfReconciliationDocuments.DiscrepanciesAreOurDebt) AS DiscrepanciesAreOurDebt
FROM
	TTDataOfReconciliationDocuments AS DataOfReconciliationDocuments
	
GROUP BY
	DataOfReconciliationDocuments.ARAPReconciliation,
	DataOfReconciliationDocuments.Organization,
	DataOfReconciliationDocuments.Counterparty,
	DataOfReconciliationDocuments.Partner,
	DataOfReconciliationDocuments.ARAPCurrency,
	DataOfReconciliationDocuments.ARAPObject,
	DataOfReconciliationDocuments.ARAPDocument
	
</query>
	</dataSet>
	<totalField>
		<dataPath>CounterpartyDataPartnerDebt</dataPath>
		<expression>Sum(CounterpartyDataPartnerDebt)</expression>
	</totalField>
	<totalField>
		<dataPath>CounterpartyDataAmountOurDebt</dataPath>
		<expression>Sum(CounterpartyDataAmountOurDebt)</expression>
	</totalField>
	<totalField>
		<dataPath>OrganizationDataPartnerSDebtAmount</dataPath>
		<expression>Sum(OrganizationDataPartnerSDebtAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>TheseOrganizationsAmountToOurDebt</dataPath>
		<expression>Sum(TheseOrganizationsAmountToOurDebt)</expression>
	</totalField>
	<totalField>
		<dataPath>PartnerDebtDiscrepancies</dataPath>
		<expression>Sum(PartnerDebtDiscrepancies)</expression>
	</totalField>
	<totalField>
		<dataPath>DiscrepanciesAreOurDebt</dataPath>
		<expression>Sum(DiscrepanciesAreOurDebt)</expression>
	</totalField>
	<totalField>
		<dataPath>CounterpartyDataPartnerDebt</dataPath>
		<expression>Case When Sum(CounterpartyDataPartnerDebt) &gt; Sum(CounterpartyDataAmountOurDebt)
	Then Sum(CounterpartyDataPartnerDebt)-Sum(CounterpartyDataAmountOurDebt)
	Else 0
End</expression>
		<group>Organization</group>
		<group>ARAPReconciliation</group>
	</totalField>
	<totalField>
		<dataPath>CounterpartyDataAmountOurDebt</dataPath>
		<expression>Case When Sum(CounterpartyDataAmountOurDebt) &gt; Sum(CounterpartyDataPartnerDebt)
	Then Sum(CounterpartyDataAmountOurDebt) - Sum(CounterpartyDataPartnerDebt)
	Else 0
End</expression>
		<group>Organization</group>
		<group>ARAPReconciliation</group>
	</totalField>
	<totalField>
		<dataPath>OrganizationDataPartnerSDebtAmount</dataPath>
		<expression>Case When Sum(OrganizationDataPartnerSDebtAmount) &gt; Sum(TheseOrganizationsAmountToOurDebt)
	Then Sum(OrganizationDataPartnerSDebtAmount)-Sum(TheseOrganizationsAmountToOurDebt)
	Else 0
End</expression>
		<group>Organization</group>
		<group>ARAPReconciliation</group>
	</totalField>
	<totalField>
		<dataPath>TheseOrganizationsAmountToOurDebt</dataPath>
		<expression>Case When Sum(TheseOrganizationsAmountToOurDebt) &gt; Sum(OrganizationDataPartnerSDebtAmount)
	Then Sum(TheseOrganizationsAmountToOurDebt) - Sum(OrganizationDataPartnerSDebtAmount)
	Else 0
End</expression>
		<group>Organization</group>
		<group>ARAPReconciliation</group>
	</totalField>
