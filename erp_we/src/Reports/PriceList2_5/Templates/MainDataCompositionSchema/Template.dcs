			</attributeUseRestriction>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	ItemKinds.Ref AS ProductKind,
	ItemKinds.SettingsOfPriceKeyByItemVariant AS SettingsOfPriceKeyByItemVariant,
	ItemKinds.SettingsOfPriceKeyByBatch AS SettingsOfPriceKeyByBatch,
	ItemKinds.SettingsOfPriceKeyByPackage AS SettingsOfPriceKeyByPackage,
	CASE
		WHEN ItemKinds.BatchOwner = VALUE(Catalog.ItemKinds.EmptyRef)
			THEN ItemKinds.Ref
		ELSE ItemKinds.BatchOwner
	END AS BatchOwner
INTO ItemKinds
FROM
	Catalog.ItemKinds AS ItemKinds
{WHERE
	ItemKinds.Ref.* AS ProductKind}

INDEX BY
	ProductKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	ISNULL(Segments.Characteristic.ItemsCharacteristicForPricing,
		VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
WHERE
	&amp;FilterByProductSegmentIsUsed
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic,
	Segments.Characteristic.ItemsCharacteristicForPricing.* AS PricingVariant}

INDEX BY
	Products,
	Characteristic,
	PricingVariant,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ProductRange.Products AS Products,
	ProductRange.PlanningObject AS PlanningObject,
	TRUE AS FilterByProductRangeIsUsed
INTO SelectionByAssortment
FROM
	InformationRegister.ProductRange.SliceLast(&amp;Period, ) AS ProductRange
WHERE
	&amp;FilterByProductRangeIsUsed
{WHERE
	ProductRange.Products.* AS Products,
	ProductRange.PlanningObject.* AS PlanningObject,
	ProductRange.ItemsCollection.* AS ItemsCollection,
	ProductRange.SalesAreAllowed AS SalesAreAllowed}

INDEX BY
	Products,
	PlanningObject,
	FilterByProductRangeIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemsPrices.Products AS Products,
	ItemsPrices.PricingVariant AS PricingVariant,
	ItemsPrices.PricingBatch AS PricingBatch,
	ItemsPrices.PricingPackage AS PricingPackage,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Price AS Price,
	ItemsPrices.Package AS Package,
	ItemsPrices.Currency AS Currency,
	CASE
		WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifyVATRateForAllItems)
			THEN TypesOfPrices.VATRate
		WHEN TypesOfPrices.OptionForSpecifyingVATRates = VALUE(Enum.OptionsForSpecifyingVATRatesInPriceList.SpecifiedVATRatesLineByLine)
			THEN ItemsPrices.VATRate
		ELSE 0
	END AS VATRate
INTO ItemPricesCrossSectionOfTheLatest
FROM
	InformationRegister.ItemsPrices25.SliceLast(&amp;Period,
		PriceKind IN (&amp;TypesOfPrices)
		{((Products, PricingVariant) IN
				(SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.PricingVariant
				FROM
			        SelectionByProductSegment
				WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
			(Products IN
				(SELECT
			        SelectionByAssortment.Products
			    FROM
			        SelectionByAssortment
			    WHERE
			        SelectionByAssortment.FilterByProductRangeIsUsed = &amp;FilterByProductRangeIsUsed))}
		) AS ItemsPrices
LEFT JOIN
	Catalog.TypesOfPrices AS TypesOfPrices
ON
	ItemsPrices.PriceKind = TypesOfPrices.Ref
WHERE
	ItemsPrices.Price &gt; 0

INDEX BY
	Products,
	PricingVariant
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ItemsPrices.Products AS Products
INTO NomenclatureSelection
FROM
	ItemPricesCrossSectionOfTheLatest AS ItemsPrices
INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Products.Ref AS Products,
	Products.ProductKind AS ProductKind,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef) AS PricingVariant
INTO TableProductCharacteristics
FROM
	Catalog.Products AS Products
WHERE
	Products.Ref IN (SELECT Table.Products FROM NomenclatureSelection AS Table)
	AND NOT Products.IsFolder
	AND Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
{WHERE
	Products.Ref.* AS Products,
	(VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	(VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	((Products.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef), VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

UNION ALL

SELECT
	Products.Ref,
	Products.ProductKind,
	ItemsCharacteristics.Ref,
	ISNULL(ItemsCharacteristics.ItemsCharacteristicForPricing.Ref,
		VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
FROM
	Catalog.Products AS Products
		INNER JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON (CASE
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
					THEN Products.Ref
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
					THEN Products.ProductKind
				WHEN Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
					THEN Products.ItemVariantsOwner
				ELSE UNDEFINED
			END = ItemsCharacteristics.Owner)
WHERE
	Products.Ref IN (SELECT Table.Products FROM NomenclatureSelection AS Table)
{WHERE
	Products.Ref.* AS Products,
	ItemsCharacteristics.Ref.* AS Characteristic,
	ItemsCharacteristics.ItemsCharacteristicForPricing.Ref.* AS PricingVariant,
	((Products.Ref, ItemsCharacteristics.Ref, ItemsCharacteristics.ItemsCharacteristicForPricing.Ref) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(Products.Ref IN
			(SELECT
				SelectionByAssortment.Products
			FROM
				SelectionByAssortment
			WHERE
				SelectionByAssortment.FilterByProductRangeIsUsed = &amp;FilterByProductRangeIsUsed))}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TableProductCharacteristics.Products AS Products,
	TableProductCharacteristics.ProductKind AS ProductKind,
	TableProductCharacteristics.Characteristic AS Characteristic,
	TableProductCharacteristics.PricingVariant AS PricingVariant,
	ItemsBatches.Series AS Series,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		ELSE ItemsBatches.PricingBatch
	END AS PricingBatch
INTO TableItemCharacteristicsOfSeries
FROM
	TableProductCharacteristics AS TableProductCharacteristics
		INNER JOIN ItemKinds AS ItemKinds
		ON TableProductCharacteristics.ProductKind = ItemKinds.ProductKind
		LEFT JOIN (SELECT
			ItemKinds.ProductKind AS ProductKind,
			VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
			ItemsBatchesForPricing.Ref AS PricingBatch
		FROM
			ItemKinds AS ItemKinds
				LEFT JOIN Catalog.ItemsBatchesForPricing AS ItemsBatchesForPricing
				ON (ItemsBatchesForPricing.Predefined)
		
		UNION ALL
		
		SELECT
			ItemKinds.ProductKind,
			ISNULL(ItemsBatches.Ref, VALUE(Catalog.ItemsBatches.EmptyRef)),
			CASE
				WHEN ItemsBatches.Ref IS NULL
						OR ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
					THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
				ELSE ItemsBatches.ItemsBatchForPricing
			END
		FROM
			ItemKinds AS ItemKinds
				LEFT JOIN Catalog.ItemsBatches AS ItemsBatches
				ON ItemKinds.BatchOwner = ItemsBatches.ProductKind
		WHERE
			ItemKinds.SettingsOfPriceKeyByBatch &lt;&gt; VALUE(Enum.FilterOptionForPriceKey.DontUse)) AS ItemsBatches
		ON (ItemKinds.ProductKind = ItemsBatches.ProductKind)
{WHERE
	ItemsBatches.Series.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.InStockBalance AS InStockBalance,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.OrderedBalance AS OrderedBalance,
	Inventories.Received_1Balance AS Received_1Balance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
	Inventories.ToSupplyBalance AS ToSupplyBalance,
	Inventories.NotProvideBalance AS NotProvideBalance
INTO InventoryAndDemandsBalance
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		Purpose = VALUE(Catalog.Assignments.EmptyRef)) AS Inventories
;

///////////////////////////////////////////////////////
SELECT
	CAST(Calculation.Products AS Catalog.Products) AS Products,
	Calculation.Characteristic AS Characteristic,
	Calculation.Warehouse AS Warehouse,
	Calculation.QuantityForShipAction AS Balance
INTO FreeBalancesFromRegisters
FROM
	CalculationOfBalancesForSettingActions AS Calculation
WHERE
	Calculation.QuantityForShipAction &gt; 0
INDEX BY
	Products, Characteristic, Warehouse
;
////////////////////////////////////////////////////////////////////////////////

DROP InventoryAndDemandsBalance
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	WarehouseStockBalance.Products AS Products,
	WarehouseStockBalance.Characteristic AS Characteristic,
	WarehouseStockBalance.Warehouse AS Warehouse,
	WarehouseStockBalance.Balance AS Balance,
	ProductRestrictions.SafetyStockQuantity AS SafetyStockQuantity,
	ProductRestrictions.MinimumInventoryQuantity AS MinimumInventoryQuantity,
	ProductRestrictions.MaximumInventoryAmount AS MaximumInventoryAmount,
	ProductRestrictions.InventoryReplenishmentMethod AS InventoryReplenishmentMethod
INTO AvailableStock
FROM
	FreeBalancesFromRegisters AS WarehouseStockBalance
		LEFT JOIN InformationRegister.ProductRestrictions AS ProductRestrictions
		ON &amp;SubstituteGoodsRestriction
WHERE
	WarehouseStockBalance.Products.ItemsType IN(
		VALUE(Enum.ItemsTypes.OwnGoods),
		VALUE(Enum.ItemsTypes.ReusablePackage))
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Sets.Owner AS Set,
	SetComponents.Ref AS Components,
	SUM(SetComponents.CostShare) AS SumOfCostShares
INTO SetShares
FROM
	Catalog.ProductKitConfigurations AS Sets
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS SetComponents
		ON Sets.Ref = SetComponents.Ref
WHERE
	NOT Sets.DeletionMark
	AND NOT Sets.Owner.DeletionMark
	AND Sets.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToShares)
	AND &amp;SetsAreDisplayed

GROUP BY
	Sets.Owner,
	SetComponents.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Sets.Owner AS Set,
	SetComponents.Ref AS Components,
	ItemPricesCrossSectionOfTheLatest.PriceKind AS PriceKind,
	SUM(ItemPricesCrossSectionOfTheLatest.Price) AS SumOfComponentPrices,
	COUNT(DISTINCT ItemPricesCrossSectionOfTheLatest.Currency) AS NumberOfCurrencies
INTO SetsDistributionByPrice
FROM
	Catalog.ProductKitConfigurations AS Sets
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS SetComponents
		ON Sets.Ref = SetComponents.Ref
		LEFT JOIN ItemKinds AS ItemKinds
		ON (ItemKinds.ProductKind = SetComponents.Products.ProductKind)
		LEFT JOIN InformationRegister.ItemsPrices25.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices)) AS ItemPricesCrossSectionOfTheLatest
		ON (SetComponents.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (ISNULL(CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE SetComponents.Characteristic.ItemsCharacteristicForPricing
		END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) = ItemPricesCrossSectionOfTheLatest.PricingVariant)
WHERE
	NOT Sets.DeletionMark
	AND NOT Sets.Owner.DeletionMark
	AND Sets.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToPrices)
	AND &amp;SetsAreDisplayed

GROUP BY
	Sets.Owner,
	SetComponents.Ref,
	ItemPricesCrossSectionOfTheLatest.PriceKind
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AccessoriesNomeclaturePriceByComponents.Ref.Owner AS SetOfProducts,
	ISNULL(AccessoriesNomeclaturePriceByComponents.Count, 0) AS QuantityInSet,
	ItemPricesCrossSectionOfTheLatest.Products AS Products,
	ItemPricesCrossSectionOfTheLatest.PricingVariant AS PricingVariant,
	TableProductCharacteristics.Series AS Series,
	ItemPricesCrossSectionOfTheLatest.PricingBatch AS PricingBatch,
	ItemPricesCrossSectionOfTheLatest.PricingPackage AS PricingPackage,
	TableProductCharacteristics.Characteristic AS Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind AS PriceKind,
	ItemPricesCrossSectionOfTheLatest.VATRate AS VATRate,
	ItemPricesCrossSectionOfTheLatest.Price AS Price,
	"" AS PriceByLine,
	ItemPricesCrossSectionOfTheLatest.Price &gt; 0 AS PriceIsSet,
	CASE
		WHEN ItemPricesCrossSectionOfTheLatest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN ItemPricesCrossSectionOfTheLatest.Products.UnitOfMeasure
		ELSE ItemPricesCrossSectionOfTheLatest.Package
	END AS Package,
	ItemPricesCrossSectionOfTheLatest.Currency AS Currency,
	ItemPricesCrossSectionOfTheLatest.Products.PriceGroup AS PriceGroup,
	AvailableStock.Balance AS Balance,
	CASE
		WHEN AvailableStock.Balance &lt;= 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.OutOfStock)
		WHEN AvailableStock.Balance &lt;= AvailableStock.MinimumInventoryQuantity
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.SpecifyAvailability)
		WHEN AvailableStock.Balance &lt; AvailableStock.SafetyStockQuantity + AvailableStock.MinimumInventoryQuantity
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Little)
		WHEN AvailableStock.Balance &lt; AvailableStock.MaximumInventoryAmount
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Enough)
		WHEN AvailableStock.Balance &gt;= AvailableStock.MaximumInventoryAmount
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Many)
		ELSE VALUE(Enum.GoodsAvailabilityForCustomer.Unknown)
	END AS RemainingBalance,
	AvailableStock.Warehouse AS Warehouse,
	AvailableStock.InventoryReplenishmentMethod AS InventoryReplenishmentMethod
INTO Prices
FROM
	ItemPricesCrossSectionOfTheLatest AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN TableItemCharacteristicsOfSeries AS TableProductCharacteristics
		ON ItemPricesCrossSectionOfTheLatest.Products = TableProductCharacteristics.Products
			AND ItemPricesCrossSectionOfTheLatest.PricingVariant = TableProductCharacteristics.PricingVariant
			AND ItemPricesCrossSectionOfTheLatest.PricingBatch = TableProductCharacteristics.PricingBatch
		LEFT JOIN AvailableStock AS AvailableStock
		ON TableProductCharacteristics.Products = AvailableStock.Products
			AND TableProductCharacteristics.Characteristic = AvailableStock.Characteristic
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS AccessoriesNomeclaturePriceByComponents
		ON ItemPricesCrossSectionOfTheLatest.Products = AccessoriesNomeclaturePriceByComponents.Products
			AND TableProductCharacteristics.Characteristic = AccessoriesNomeclaturePriceByComponents.Characteristic
			AND ItemPricesCrossSectionOfTheLatest.PricingBatch = VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
			AND (ItemPricesCrossSectionOfTheLatest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
				AND ItemPricesCrossSectionOfTheLatest.Products.UnitOfMeasure = AccessoriesNomeclaturePriceByComponents.Package
				OR ItemPricesCrossSectionOfTheLatest.Package = AccessoriesNomeclaturePriceByComponents.Package)
			AND (AccessoriesNomeclaturePriceByComponents.Ref.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.CaclulatesFromComponentPrices))
		{LEFT JOIN InformationRegister.ItemsPrices25.SliceLast(&amp;Period, {(PriceKind) AS PriceTypeRange}) AS ProductPricesSelection
		ON ItemPricesCrossSectionOfTheLatest.Products = ProductPricesSelection.Products
			AND ItemPricesCrossSectionOfTheLatest.PricingVariant = ProductPricesSelection.PricingVariant
			AND ItemPricesCrossSectionOfTheLatest.PricingBatch = ProductPricesSelection.PricingBatch}
WHERE
	ItemPricesCrossSectionOfTheLatest.Price &gt; 0
{WHERE
	ProductPricesSelection.Price AS PriceFrom,
	ProductPricesSelection.Price AS PriceUpTo}

UNION ALL

SELECT
	SetShares.Set,
	KitComponentsPricesByKit.Count,
	KitComponentsPricesByKit.Products,
	ItemPricesCrossSectionOfTheLatest.PricingVariant,
	TableProductCharacteristics.Series,
	ItemPricesCrossSectionOfTheLatest.PricingBatch,
	ItemPricesCrossSectionOfTheLatest.PricingPackage,
	TableProductCharacteristics.Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	ItemPricesCrossSectionOfTheLatest.VATRate AS VATRate,
	CASE
		WHEN NOT SetShares.Set IS NULL
				AND SetShares.SumOfCostShares &gt; 0
				AND NOT KitComponentsPricesByKit.Products IS NULL
				AND KitComponentsPricesByKit.Count &gt; 0
			THEN ItemPricesCrossSectionOfTheLatest.Price * KitComponentsPricesByKit.CostShare / SetShares.SumOfCostShares / KitComponentsPricesByKit.Count
		ELSE 0
	END,
	"",
	ItemPricesCrossSectionOfTheLatest.Price &gt; 0,
	CASE
		WHEN KitComponentsPricesByKit.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN KitComponentsPricesByKit.Products.UnitOfMeasure
		ELSE KitComponentsPricesByKit.Package
	END,
	ItemPricesCrossSectionOfTheLatest.Currency,
	ItemPricesCrossSectionOfTheLatest.Products.PriceGroup,
	CASE
		WHEN KitComponentsPricesByKit.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN AvailableStock.Balance
		ELSE AvailableStock.Balance / &amp;QueryTextSecondPackingFactor
	END,
	CASE
		WHEN AvailableStock.Balance &lt;= 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.OutOfStock)
		WHEN AvailableStock.Balance &lt;= AvailableStock.MinimumInventoryQuantity
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.SpecifyAvailability)
		WHEN AvailableStock.Balance &lt; AvailableStock.SafetyStockQuantity + AvailableStock.MinimumInventoryQuantity
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Little)
		WHEN AvailableStock.Balance &lt; AvailableStock.MaximumInventoryAmount
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Enough)
		WHEN AvailableStock.Balance &gt;= AvailableStock.MaximumInventoryAmount
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Many)
		ELSE VALUE(Enum.GoodsAvailabilityForCustomer.Unknown)
	END,
	AvailableStock.Warehouse,
	AvailableStock.InventoryReplenishmentMethod
FROM
	ItemPricesCrossSectionOfTheLatest AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN SetShares AS SetShares
		ON ItemPricesCrossSectionOfTheLatest.Products = SetShares.Set
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS KitComponentsPricesByKit
		ON (SetShares.Components = KitComponentsPricesByKit.Ref)
		LEFT JOIN TableItemCharacteristicsOfSeries AS TableProductCharacteristics
		ON ItemPricesCrossSectionOfTheLatest.Products = TableProductCharacteristics.Products
			AND ItemPricesCrossSectionOfTheLatest.PricingVariant = TableProductCharacteristics.PricingVariant
			AND ItemPricesCrossSectionOfTheLatest.PricingBatch = TableProductCharacteristics.PricingBatch
		LEFT JOIN AvailableStock AS AvailableStock
		ON TableProductCharacteristics.Products = AvailableStock.Products
			AND TableProductCharacteristics.Characteristic = AvailableStock.Characteristic
		{LEFT JOIN InformationRegister.ItemsPrices25.SliceLast(&amp;Period, {(PriceKind) AS PriceTypeRange}) AS ProductPricesSelection
		ON ItemPricesCrossSectionOfTheLatest.Products = ProductPricesSelection.Products
			AND ItemPricesCrossSectionOfTheLatest.PricingVariant = ProductPricesSelection.PricingVariant
			AND ItemPricesCrossSectionOfTheLatest.PricingBatch = ProductPricesSelection.PricingBatch}
WHERE
	ItemPricesCrossSectionOfTheLatest.Price &gt; 0
	AND SetShares.Set IS NOT NULL 
{WHERE
	ProductPricesSelection.Price AS PriceFrom,
	ProductPricesSelection.Price AS PriceUpTo}
	
UNION ALL

SELECT
	SetsDistributionByPrice.Set,
	KitComponentsPricesByKit.Count,
	KitComponentsPricesByKit.Products,
	ItemPricesCrossSectionOfTheLatest.PricingVariant,
	TableProductCharacteristics.Series,
	ItemPricesCrossSectionOfTheLatest.PricingBatch,
	ItemPricesCrossSectionOfTheLatest.PricingPackage,
	TableProductCharacteristics.Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	ItemPricesCrossSectionOfTheLatest.VATRate AS VATRate,
	CASE
		WHEN SetsDistributionByPrice.NumberOfCurrencies = 1
				AND NOT SetsDistributionByPrice.Set IS NULL
				AND SetsDistributionByPrice.SumOfComponentPrices &gt; 0
				AND NOT KitComponentsPricesByKit.Products IS NULL
				AND KitComponentsPricesByKit.Count &gt; 0
			THEN ItemPricesCrossSectionOfTheLatest.Price * PricesOfComponentProductsCrossSection.Price / SetsDistributionByPrice.SumOfComponentPrices / KitComponentsPricesByKit.Count
		ELSE 0
	END,
	CASE
		WHEN SetsDistributionByPrice.NumberOfCurrencies &gt; 1
			THEN "-"
		ELSE ""
	END,
	ItemPricesCrossSectionOfTheLatest.Price &gt; 0,
	CASE
		WHEN KitComponentsPricesByKit.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN KitComponentsPricesByKit.Products.UnitOfMeasure
		ELSE KitComponentsPricesByKit.Package
	END,
	ItemPricesCrossSectionOfTheLatest.Currency,
	ItemPricesCrossSectionOfTheLatest.Products.PriceGroup,
	CASE
		WHEN KitComponentsPricesByKit.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN AvailableStock.Balance
		ELSE AvailableStock.Balance / &amp;QueryTextSecondPackingFactor
	END,
	CASE
		WHEN AvailableStock.Balance &lt;= 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.OutOfStock)
		WHEN AvailableStock.Balance &lt;= AvailableStock.MinimumInventoryQuantity
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.SpecifyAvailability)
		WHEN AvailableStock.Balance &lt; AvailableStock.SafetyStockQuantity + AvailableStock.MinimumInventoryQuantity
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Little)
		WHEN AvailableStock.Balance &lt; AvailableStock.MaximumInventoryAmount
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Enough)
		WHEN AvailableStock.Balance &gt;= AvailableStock.MaximumInventoryAmount
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.Many)
		ELSE VALUE(Enum.GoodsAvailabilityForCustomer.Unknown)
	END,
	AvailableStock.Warehouse,
	AvailableStock.InventoryReplenishmentMethod
FROM
	ItemPricesCrossSectionOfTheLatest AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN SetsDistributionByPrice AS SetsDistributionByPrice
		ON ItemPricesCrossSectionOfTheLatest.Products = SetsDistributionByPrice.Set
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS KitComponentsPricesByKit
		ON (SetsDistributionByPrice.Components = KitComponentsPricesByKit.Ref)
			AND (ItemPricesCrossSectionOfTheLatest.PriceKind = SetsDistributionByPrice.PriceKind)

		LEFT JOIN TableItemCharacteristicsOfSeries AS TableProductCharacteristics
		ON ItemPricesCrossSectionOfTheLatest.Products = TableProductCharacteristics.Products
			AND ItemPricesCrossSectionOfTheLatest.PricingVariant = TableProductCharacteristics.PricingVariant
			AND ItemPricesCrossSectionOfTheLatest.PricingBatch = TableProductCharacteristics.PricingBatch

		LEFT JOIN InformationRegister.ItemsPrices25.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices)) AS PricesOfComponentProductsCrossSection
		ON (TableProductCharacteristics.Products = PricesOfComponentProductsCrossSection.Products)
			AND (TableProductCharacteristics.PricingVariant = PricesOfComponentProductsCrossSection.PricingVariant)
			AND ItemPricesCrossSectionOfTheLatest.PriceKind = PricesOfComponentProductsCrossSection.PriceKind
		LEFT JOIN AvailableStock AS AvailableStock
		ON (KitComponentsPricesByKit.Products = AvailableStock.Products)
			AND (KitComponentsPricesByKit.Characteristic = AvailableStock.Characteristic)

		{LEFT JOIN InformationRegister.ItemsPrices25.SliceLast(&amp;Period, {(PriceKind) AS PriceTypeRange}) AS ProductPricesSelection
		ON ItemPricesCrossSectionOfTheLatest.Products = ProductPricesSelection.Products
			AND ItemPricesCrossSectionOfTheLatest.PricingVariant = ProductPricesSelection.PricingVariant
			AND ItemPricesCrossSectionOfTheLatest.PricingBatch = ProductPricesSelection.PricingBatch}
WHERE
	PricesOfComponentProductsCrossSection.Price &gt; 0
	AND SetsDistributionByPrice.Set IS NOT NULL 
{WHERE
	ProductPricesSelection.Price AS PriceFrom,
	ProductPricesSelection.Price AS PriceUpTo}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Prices.SetOfProducts AS SetOfProducts,
	Prices.QuantityInSet AS QuantityInSet,
	CASE
		WHEN Prices.SetOfProducts IS NULL
			THEN 0
		ELSE 1
	END AS ComponentCounter,
	Prices.Products AS Products,
	Prices.PricingVariant AS PricingVariant,
	Prices.Series AS Series,
	Prices.PricingBatch AS PricingBatch,
	Prices.PricingPackage AS PricingPackage,
	Prices.Characteristic AS Characteristic,
	Prices.PriceKind AS PriceKind,
	Prices.VATRate AS VATRate,
	CASE
		WHEN Prices.SetOfProducts IS NULL
				AND Prices.PriceByLine = "-"
			THEN Prices.PriceByLine
		ELSE Prices.Price
	END AS Price,
	Prices.PriceIsSet AS PriceIsSet,	
	Prices.Package AS Package,
	Prices.Currency AS Currency,
	Prices.PriceGroup AS PriceGroup,
	Prices.Warehouse AS Warehouse,	
	CASE
		WHEN Prices.Balance &lt; 0 
			THEN 0
		ELSE Prices.Balance
	END AS Balance,
	CASE
		WHEN Prices.InventoryReplenishmentMethod = VALUE(Enum.InventoryReplenishmentMethods.OrderAgainstOrder)
				OR Prices.InventoryReplenishmentMethod IS NULL
					AND Prices.Balance &gt; 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.AgainstOrder)
		WHEN Prices.Balance &lt; 0
			THEN NULL
		ELSE Prices.RemainingBalance
	END AS RemainingBalance
{SELECT
	Products.*,
	PricingVariant.*,
	Series.*,
	PricingBatch.*,
	PricingPackage.*,
	PriceKind.*,
	Price,
	PriceIsSet,
	Package.*,
	Currency.*,
	PriceGroup.*,
	Characteristic.*,
	Warehouse.*}
FROM
	Prices AS Prices
{WHERE
	Prices.Products.*,
	Prices.PricingVariant.*,
	Prices.Series.*,
	Prices.PricingBatch.*,
	Prices.PricingPackage.*,
	Prices.PriceKind.*,
	Prices.Price,
	Prices.PriceIsSet,
	Prices.Package.*,
	Prices.Currency.*,
	Prices.Characteristic.*,
	Prices.Warehouse.*}</query>
	</dataSet>
