		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Sets.Owner AS Set,
	Sets.SetPricingOption AS SetPricingOption,
	SetComponents.Ref AS Components,
	SetComponents.CostShare AS CostShare,
	SetComponents.Products AS Products,
	SetComponents.Characteristic AS Characteristic,
	ISNULL(SetComponents.Characteristic.ItemsCharacteristicForPricing,
		VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	SetComponents.Package AS Package,
	SetComponents.Count AS Count,
	CatProducts.ProductKind AS ProductKind
INTO SetComponents
FROM
	Catalog.ProductKitConfigurations AS Sets
LEFT JOIN
	Catalog.ProductKitConfigurations.Goods AS SetComponents
ON
	Sets.Ref = SetComponents.Ref
LEFT JOIN
	Catalog.Products AS CatProducts
ON
	CatProducts.Ref = SetComponents.Products	
WHERE
	Sets.Owner IN (&amp;SetsList)
	AND NOT Sets.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.EmptyRef)
	AND &amp;SetsAreDisplayed
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SetComponents.Set AS Set,
	SetComponents.Components AS Components,
	SUM(SetComponents.CostShare) AS SumOfCostShares
INTO SetShares
FROM
	SetComponents AS SetComponents
WHERE
	SetComponents.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToShares)

GROUP BY
	SetComponents.Set,
	SetComponents.Components
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SetComponents.Set AS Set,
	SetComponents.Components AS Components,
	Prices.PriceKind AS PriceKind,
	SUM(Prices.Price) AS SumOfComponentPrices,
	COUNT(DISTINCT Prices.Currency) AS NumberOfCurrencies
INTO SetsDistributionByPrice
FROM
	SetComponents AS SetComponents
LEFT JOIN
	InformationRegister.ItemsPrices25.SliceLast(&amp;Period,
			PriceKind IN (&amp;TypesOfPrices)
			AND Products IN (SELECT Products FROM SetComponents)
		) AS Prices
ON
	SetComponents.Products = Prices.Products
	AND ISNULL(CASE
			WHEN SetComponents.ProductKind = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE SetComponents.PricingVariant
		END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) = Prices.PricingVariant
WHERE
	SetComponents.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToPrices)

GROUP BY
	SetComponents.Set,
	SetComponents.Components,
	Prices.PriceKind
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Prices.Products AS Products,
	Prices.PricingVariant AS PricingVariant,
	Prices.PricingBatch AS PricingBatch,
	Prices.PricingPackage AS PricingPackage,
	Prices.PriceKind AS PriceKind,
	Prices.Price AS Price,
	Prices.Package AS Package,
	Prices.Currency AS Currency
INTO ItemsPrices
FROM
	InformationRegister.ItemsPrices25.SliceLast(&amp;Period,
		 PriceKind IN (&amp;TypesOfPrices)
		AND (Products, PricingVariant) IN
				(SELECT
			        Products,
			        PricingVariant
				FROM
			        SetComponents)
		) AS Prices
WHERE
	Prices.Price &gt; 0
INDEX BY
	Products,
	PricingVariant
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SetComponents.Set AS SetOfProducts,
	ISNULL(SetComponents.Count, 0) * ItemsPrices.Price AS SetPrice,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Currency AS Currency
INTO PricesOfSets
FROM
	SetComponents AS SetComponents 
LEFT JOIN	
	ItemsPrices AS ItemsPrices
ON
	SetComponents.Products = ItemsPrices.Products
    AND SetComponents.PricingVariant = ItemsPrices.PricingVariant
	AND ItemsPrices.PricingBatch = VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
	AND (ItemsPrices.Package = SetComponents.Package
		OR ItemsPrices.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			AND ItemsPrices.Products.UnitOfMeasure = SetComponents.Package)
	AND SetComponents.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.CaclulatesFromComponentPrices)
WHERE
	ItemsPrices.Price &gt; 0

UNION ALL

SELECT
	SetShares.Set,
	CASE
		WHEN	NOT SetShares.Set IS NULL
				AND SetShares.SumOfCostShares &gt; 0
			THEN ItemsPrices.Price * SetComponents.CostShare / SetShares.SumOfCostShares
		ELSE 0
	END,
	ItemsPrices.PriceKind,
	ItemsPrices.Currency
FROM
	SetShares AS SetShares 
LEFT JOIN	
	ItemsPrices AS ItemsPrices
ON
	ItemsPrices.Products = SetShares.Set
LEFT JOIN
	SetComponents AS SetComponents
ON
	SetShares.Set = SetComponents.Set
	AND SetShares.Components = SetComponents.Components
	AND ItemsPrices.Products = SetComponents.Products
	AND ItemsPrices.PricingVariant = SetComponents.PricingVariant
WHERE
	ItemsPrices.Price &gt; 0
	AND SetShares.Set IS NOT NULL
	
UNION ALL

SELECT
	SetsDistributionByPrice.Set,
	CASE
		WHEN NOT SetsDistributionByPrice.Set IS NULL
				AND SetsDistributionByPrice.SumOfComponentPrices &gt; 0
			THEN ItemsPrices.Price * PricesOfComponentItems.Price / SetsDistributionByPrice.SumOfComponentPrices
		ELSE 0
	END,
	ItemsPrices.PriceKind,
	ItemsPrices.Currency
FROM
	SetsDistributionByPrice AS SetsDistributionByPrice
LEFT JOIN	
	ItemsPrices AS ItemsPrices
ON
	ItemsPrices.Products = SetsDistributionByPrice.Set 

LEFT JOIN
	SetComponents AS SetComponents
ON
	SetsDistributionByPrice.Set = SetComponents.Set
	AND SetsDistributionByPrice.Components = SetComponents.Components
	AND ItemsPrices.Products = SetComponents.Products
	AND ItemsPrices.PricingVariant = SetComponents.PricingVariant
	AND ItemsPrices.PriceKind = SetsDistributionByPrice.PriceKind

LEFT JOIN
	ItemsPrices AS PricesOfComponentItems
ON
	SetComponents.Products = PricesOfComponentItems.Products
	AND SetComponents.PricingVariant = PricesOfComponentItems.PricingVariant
	AND ItemsPrices.PriceKind = PricesOfComponentItems.PriceKind
WHERE
	ItemsPrices.Price &gt; 0
	AND SetsDistributionByPrice.Set IS NOT NULL
;
////////////////////////////////////////////////////////////////////////////////
SELECT
	PricesOfSets.SetOfProducts AS SetOfProducts,
	PricesOfSets.SetPrice AS SetPrice,
	PricesOfSets.PriceKind AS PriceKind,
	PricesOfSets.Currency AS Currency
FROM
	PricesOfSets AS PricesOfSets</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>PriceList</sourceDataSet>
		<destinationDataSet>PricesOfSets</destinationDataSet>
		<sourceExpression>SetOfProducts</sourceExpression>
		<destinationExpression>SetOfProducts</destinationExpression>
		<parameter>SetsList</parameter>
		<parameterListAllowed>false</parameterListAllowed>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>PriceList</sourceDataSet>
		<destinationDataSet>PricesOfSets</destinationDataSet>
		<sourceExpression>PriceKind</sourceExpression>
		<destinationExpression>PriceKind</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>PriceList</sourceDataSet>
		<destinationDataSet>PricesOfSets</destinationDataSet>
		<sourceExpression>Currency</sourceExpression>
		<destinationExpression>Currency</destinationExpression>
	</dataSetLink>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Case When Count(Distinct Price) = 1 Then Max(Price) Else Undefined End</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>Currency</dataPath>
		<expression>Max(Currency)</expression>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>0</expression>
		<group>Products Hierarchy</group>
		<group>SetOfProducts Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Case When Sum(ComponentCounter)&gt;0 And Count(Distinct Balance) = 1 Then Max(Balance) Else Undefined End
</expression>
		<group>SetOfProducts</group>
	</totalField>
	<totalField>
		<dataPath>RemainingBalance</dataPath>
		<expression>Case When Count(Distinct RemainingBalance) = 1 Then Max(RemainingBalance) Else Undefined End</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>0</expression>
		<group>SetOfProducts Hierarchy</group>
		<group>Products Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>RemainingBalance</dataPath>
		<expression>0</expression>
		<group>SetOfProducts Hierarchy</group>
		<group>Products Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Sum(SetPrice)</expression>
		<group>SetOfProducts</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Sum(Balance)</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>RemainingBalance</dataPath>
		<expression>Case When Sum(ComponentCounter)&gt;0 And Count(Distinct Balance) = 1 Then Max(RemainingBalance) Else Undefined End
</expression>
		<group>SetOfProducts</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Case When Count(Distinct Balance) = 1 Then Max(Balance) Else Undefined End</expression>
		<group>Warehouse</group>
	</totalField>
	<totalField>
		<dataPath>VATRate</dataPath>
		<expression>VATRate</expression>
		<group>Products</group>
	</totalField>
	<parameter>
		<name>ReportDate</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report date</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تاریخ گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Data del report</v8:content>
			</v8:item>
			<v8:item>
