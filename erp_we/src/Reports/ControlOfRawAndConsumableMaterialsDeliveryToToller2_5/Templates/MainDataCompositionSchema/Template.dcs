		<field xsi:type="DataSetFieldField">
			<dataPath>Factor</dataPath>
			<field>Factor</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// TAGS ARE USED!!!
SELECT ALLOWED
	ShipmentReferences.ReferenceOrder AS ReferenceOrder
INTO OrdersToProcessor
FROM
	InformationRegister.ShipmentAndReturnReferencesToFulfill AS ShipmentReferences
	
	INNER JOIN Document.SubcontractOrder2_5 AS OrdersToProcessor
	ON OrdersToProcessor.Ref = ShipmentReferences.ReferenceOrder
WHERE
	NOT &amp;ContextReport
{WHERE
	OrdersToProcessor.Organization.* AS Organization,
	OrdersToProcessor.Partner.*     AS Toller,
	OrdersToProcessor.Contract.*     AS Contract}

UNION ALL

SELECT
	OrdersToProcessor.Ref AS ReferenceOrder
FROM
	Document.SubcontractOrder2_5 AS OrdersToProcessor
WHERE
	&amp;ContextReport
{WHERE
	OrdersToProcessor.Ref        AS ReferenceOrder,
	OrdersToProcessor.Organization.* AS Organization,
	OrdersToProcessor.Partner.*     AS Toller,
	OrdersToProcessor.Contract.*     AS Contract}

INDEX BY
	ReferenceOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Orders.SecondPeriod AS SecondPeriod,
	Orders.MinutePeriod AS MinutePeriod,
	Orders.HourPeriod AS HourPeriod,
	Orders.DayPeriod AS DayPeriod,
	Orders.WeekPeriod AS WeekPeriod,
	Orders.TenDaysPeriod AS TenDaysPeriod,
	Orders.MonthPeriod AS MonthPeriod,
	Orders.QuarterPeriod AS QuarterPeriod,
	Orders.HalfYearPeriod AS HalfYearPeriod,
	Orders.YearPeriod AS YearPeriod,
	
	CASE
		WHEN Orders.Recorder = UNDEFINED
			THEN NULL
		ELSE Orders.Recorder
	END AS Recorder,
	
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.Partner AS Toller,
	DocumentsRegistry.Contract AS Contract,
	Orders.ReferenceOrder AS ReferenceOrder,
	DocumentsRegistry.IBDocumentDate AS IBDocumentDate,
	DocumentsRegistry.IBDocumentNumber AS IBDocumentNumber,
	Orders.Products AS Products,
	Orders.Products.UnitOfMeasure AS UnitOfMeasure,
	Orders.Characteristic AS Characteristic,
	Orders.RowCode AS RowCode,
	Orders.Warehouse AS Warehouse,
	Orders.Series AS Series,
	Orders.RowCode = 0 AS ExceedingOrder,
	SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
			THEN Orders.CountTurnover
		ELSE 0
	END) AS Passed,
	SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
			THEN Orders.CountTurnover
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
			THEN -Orders.CountTurnover
		ELSE 0
	END) AS ToTransfer,
	SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
			THEN Orders.CountTurnover
		ELSE 0
	END) AS Ordered
INTO RegisterData
FROM
	AccumulationRegister.ShipmentAndReturnReferences.Turnovers(
			,, Auto,
			ReferenceOrder IN(
				SELECT
					OrdersToProcessor.ReferenceOrder
				FROM
					OrdersToProcessor AS OrdersToProcessor)
			AND Factor IN (VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered),
				VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip),
				VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped))
			{(RowCode = 0)  AS ExceedingOrder,
			Products.*   AS Products,
			Characteristic.* AS Characteristic,
			RowCode        AS RowCode,
			Warehouse.*          AS Warehouse}
	) AS Orders
	
	LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
	ON DocumentsRegistry.Ref = Orders.ReferenceOrder
	AND NOT DocumentsRegistry.AdditionalRecord

{WHERE
	Orders.Recorder.*               AS Recorder,
	DocumentsRegistry.Organization.*     AS Organization,
	DocumentsRegistry.Partner.*         AS Toller,
	DocumentsRegistry.Contract.*         AS Contract
}
GROUP BY
	Orders.SecondPeriod,
	Orders.MinutePeriod,
	Orders.HourPeriod,
	Orders.DayPeriod,
	Orders.WeekPeriod,
	Orders.TenDaysPeriod,
	Orders.MonthPeriod,
	Orders.QuarterPeriod,
	Orders.HalfYearPeriod,
	Orders.YearPeriod,
	CASE
		WHEN Orders.Recorder = UNDEFINED
			THEN NULL
		ELSE Orders.Recorder
	END,
	DocumentsRegistry.Organization,
	DocumentsRegistry.Partner,
	DocumentsRegistry.Contract,
	Orders.ReferenceOrder,
	DocumentsRegistry.IBDocumentDate,
	DocumentsRegistry.IBDocumentNumber,
	Orders.Products,
	Orders.Characteristic,
	Orders.RowCode,
	Orders.Warehouse,
	Orders.Series,
	Orders.RowCode = 0
HAVING
	SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
			THEN Orders.CountTurnover
		ELSE 0
	END) &lt;&gt; 0
	OR SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
			THEN Orders.CountTurnover
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped)
			THEN -Orders.CountTurnover
		ELSE 0
	END) &lt;&gt; 0
	OR SUM(CASE
		WHEN Orders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
			THEN Orders.CountTurnover
		ELSE 0
	END) &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	RegisterData.ReferenceOrder AS ReferenceOrder,
	RegisterData.RowCode    AS RowCode
INTO TTOrders
FROM
	RegisterData AS RegisterData

GROUP BY
	RegisterData.ReferenceOrder,
	RegisterData.RowCode
	
INDEX BY
	ReferenceOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Orders.ReferenceOrder AS ReferenceOrder,
	Orders.RowCode AS RowCode,
	MAX(ISNULL(TabPart.DateOfShipment, DATETIME(1, 1, 1))) AS DateOfShipmentPlan
INTO TTDeliveryTime
FROM
	TTOrders AS Orders

	INNER JOIN Document.SubcontractOrder2_5.SupplyWithMaterialsAndWorks AS TabPart
	ON Orders.ReferenceOrder = TabPart.Ref
	AND Orders.RowCode = TabPart.RowCode

WHERE
	NOT TabPart.Canceled

GROUP BY
	Orders.ReferenceOrder,
	Orders.RowCode

UNION ALL

SELECT
	Orders.ReferenceOrder AS ReferenceOrder,
	Orders.RowCode AS RowCode,
	MAX(ISNULL(TabPart.DateOfShipment, DATETIME(1, 1, 1))) AS DateOfShipmentPlan
FROM
	TTOrders AS Orders

	INNER JOIN Document.SubcontractOrder2_5 AS DocOrderDocument
	ON Orders.ReferenceOrder = DocOrderDocument.Ref

	INNER JOIN Document.ProductionStage2_2 AS DocStage
	ON DocOrderDocument.Ref = DocStage.SubcontractOrder

	INNER JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS TabPart
	ON DocStage.Ref = TabPart.Ref
	AND Orders.RowCode = TabPart.RowCode
	
WHERE
	DocOrderDocument.GroupCosts = VALUE(Enum.CostGroupingsInTollingOrder.ByProductionStages)
	AND NOT TabPart.Canceled
	
GROUP BY
	Orders.ReferenceOrder,
	Orders.RowCode

INDEX BY
	ReferenceOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterData.SecondPeriod AS SecondPeriod,
	RegisterData.MinutePeriod AS MinutePeriod,
	RegisterData.HourPeriod AS HourPeriod,
	RegisterData.DayPeriod AS DayPeriod,
	RegisterData.WeekPeriod AS WeekPeriod,
	RegisterData.TenDaysPeriod AS TenDaysPeriod,
	RegisterData.MonthPeriod AS MonthPeriod,
	RegisterData.QuarterPeriod AS QuarterPeriod,
	RegisterData.HalfYearPeriod AS HalfYearPeriod,
	RegisterData.YearPeriod AS YearPeriod,
	RegisterData.Recorder AS Recorder,
	RegisterData.Organization AS Organization,
	RegisterData.Toller AS Toller,
	RegisterData.Contract AS Contract,
	RegisterData.ReferenceOrder AS ReferenceOrder,
	RegisterData.IBDocumentDate AS IBDocumentDate,
	RegisterData.IBDocumentNumber AS IBDocumentNumber,
	RegisterData.Products AS Products,
	RegisterData.Products.UnitOfMeasure AS UnitOfMeasure,
	RegisterData.Characteristic AS Characteristic,
	RegisterData.RowCode AS RowCode,
	DeliveryTerm.DateOfShipmentPlan AS DateOfShipmentPlan,
	RegisterData.Warehouse AS Warehouse,
	RegisterData.Series AS Series,
	RegisterData.ExceedingOrder AS ExceedingOrder,
	RegisterData.Passed AS Passed,
	RegisterData.ToTransfer AS ToTransfer,
	RegisterData.Ordered AS Ordered
FROM
	RegisterData AS RegisterData
	
	LEFT JOIN TTDeliveryTime AS DeliveryTerm
	ON RegisterData.ReferenceOrder = DeliveryTerm.ReferenceOrder
	AND RegisterData.RowCode = DeliveryTerm.RowCode
</query>
	</dataSet>
	<totalField>
		<dataPath>Passed</dataPath>
		<expression>Sum(Passed)</expression>
	</totalField>
	<totalField>
		<dataPath>ToTransfer</dataPath>
		<expression>Sum(ToTransfer)</expression>
	</totalField>
	<totalField>
		<dataPath>Ordered</dataPath>
		<expression>Sum(Ordered)</expression>
	</totalField>
