		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE
		WHEN &amp;UserCalendar = VALUE(Catalog.Calendars.EmptyRef)
			THEN MainCalendar.Value
		ELSE &amp;UserCalendar
	END AS Calendar
INTO FilterCalendar
FROM
	Constant.MainEnterpriseCalendar AS MainCalendar
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Tab.DayPeriod AS DayPeriod,
	MAX(Tab.SecondPeriod) AS SecondPeriod,
	Tab.PriceKind AS PriceKind,
	Tab.Products AS Products,
	Tab.PricingVariant AS PricingVariant,
	Tab.PricingBatch AS PricingBatch,
	Tab.PricingPackage AS PricingPackage
INTO MaximumPeriod
FROM
	(SELECT
		BEGINOFPERIOD(ItemsPrices.Period, DAY) AS DayPeriod,
		ItemsPrices.Period AS SecondPeriod,
		ItemsPrices.PriceKind AS PriceKind,
		ItemsPrices.Products AS Products,
		ItemsPrices.PricingVariant AS PricingVariant,
		ItemsPrices.PricingBatch AS PricingBatch,
		ItemsPrices.PricingPackage AS PricingPackage
	FROM
		InformationRegister.ItemsPrices25 AS ItemsPrices
	WHERE
		ItemsPrices.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	{WHERE
		ItemsPrices.Products.* AS Products,
		ItemsPrices.PricingVariant.* AS PricingVariant,
		ItemsPrices.PricingBatch.* AS PricingBatch,
		ItemsPrices.PricingPackage.* AS PricingPackage,
		ItemsPrices.PriceKind.* AS PriceKind}
	
	UNION ALL
	
	SELECT
		BEGINOFPERIOD(ItemPricesCrossSectionOfTheLatest.Period, DAY),
		ItemPricesCrossSectionOfTheLatest.Period,
		ItemPricesCrossSectionOfTheLatest.PriceKind,
		ItemPricesCrossSectionOfTheLatest.Products,
		ItemPricesCrossSectionOfTheLatest.PricingVariant,
		ItemPricesCrossSectionOfTheLatest.PricingBatch,
		ItemPricesCrossSectionOfTheLatest.PricingPackage
	FROM
		InformationRegister.ItemsPrices25.SliceLast({(DATEADD(&amp;BeginOfPeriod, SECOND, -1))}, {(Products).* AS Products, (PricingVariant).* AS PricingVariant, (PricingBatch).* AS PricingBatch, (PricingPackage).* AS PricingPackage, (PriceKind).* AS PriceKind}) AS ItemPricesCrossSectionOfTheLatest) AS Tab

GROUP BY
	Tab.DayPeriod,
	Tab.PriceKind,
	Tab.Products,
	Tab.PricingVariant,
	Tab.PricingBatch,
	Tab.PricingPackage
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CalendarSchedules.ScheduleDate AS ScheduleDate,
	TypesOfPrices.Ref AS PriceKind,
	Table.Products AS Products,
	Table.PricingVariant AS PricingVariant,
	Table.PricingBatch AS PricingBatch,
	Table.PricingPackage AS PricingPackage
INTO CalendarDates
FROM
	InformationRegister.CalendarSchedules AS CalendarSchedules
		INNER JOIN FilterCalendar AS FilterCalendar
		ON CalendarSchedules.Calendar = FilterCalendar.Calendar
		LEFT JOIN (SELECT DISTINCT
			T.Products AS Products,
			T.PricingVariant AS PricingVariant,
			T.PricingBatch AS PricingBatch,
			T.PricingPackage AS PricingPackage
		FROM
			MaximumPeriod AS T) AS Table
		ON (TRUE)
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON (TRUE)
WHERE
	CalendarSchedules.ScheduleDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
{WHERE
	TypesOfPrices.Ref.* AS PriceKind}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	MaximumPeriod.Products AS Products,
	MaximumPeriod.PricingVariant AS PricingVariant,
	MaximumPeriod.PricingBatch AS PricingBatch,
	MaximumPeriod.PricingPackage AS PricingPackage,
	MaximumPeriod.PriceKind AS PriceKind,
	MaximumPeriod.DayPeriod AS DayPeriod,
	CAST(ItemsPrices.Price / ISNULL(&amp;QueryTextPackagingFactor, 1) AS NUMBER(31, 2)) AS Price
INTO ChangesOfPrices
FROM
	MaximumPeriod AS MaximumPeriod
		LEFT JOIN InformationRegister.ItemsPrices25 AS ItemsPrices
		ON MaximumPeriod.PriceKind = ItemsPrices.PriceKind
			AND MaximumPeriod.Products = ItemsPrices.Products
			AND MaximumPeriod.PricingVariant = ItemsPrices.PricingVariant
			AND MaximumPeriod.PricingBatch = ItemsPrices.PricingBatch
			AND MaximumPeriod.PricingPackage = ItemsPrices.PricingPackage
			AND MaximumPeriod.SecondPeriod = ItemsPrices.Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	T.ScheduleDate AS DayPeriod,
	T.Products AS Products,
	T.PricingVariant AS PricingVariant,
	T.PricingBatch AS PricingBatch,
	T.PricingPackage AS PricingPackage,
	T.PriceKind AS PriceKind,
	ISNULL(ChangesOfPrices.Price, 0) AS Price
FROM
	(SELECT
		CalendarDates.ScheduleDate AS ScheduleDate,
		CalendarDates.Products AS Products,
		CalendarDates.PricingVariant AS PricingVariant,
		CalendarDates.PricingBatch AS PricingBatch,
		CalendarDates.PricingPackage AS PricingPackage,
		CalendarDates.PriceKind AS PriceKind,
		MAX(ChangesOfPrices.DayPeriod) AS MaximumPeriod
	FROM
		CalendarDates AS CalendarDates
			LEFT JOIN ChangesOfPrices AS ChangesOfPrices
			ON CalendarDates.ScheduleDate &gt;= ChangesOfPrices.DayPeriod
				AND CalendarDates.PriceKind = ChangesOfPrices.PriceKind
				AND CalendarDates.Products = ChangesOfPrices.Products
				AND CalendarDates.PricingVariant = ChangesOfPrices.PricingVariant
				AND CalendarDates.PricingBatch = ChangesOfPrices.PricingBatch
				AND CalendarDates.PricingPackage = ChangesOfPrices.PricingPackage
	
	GROUP BY
		CalendarDates.PriceKind,
		CalendarDates.PricingVariant,
		CalendarDates.PricingBatch,
		CalendarDates.PricingPackage,
		CalendarDates.ScheduleDate,
		CalendarDates.Products) AS T
		LEFT JOIN ChangesOfPrices AS ChangesOfPrices
		ON T.MaximumPeriod = ChangesOfPrices.DayPeriod
			AND T.Products = ChangesOfPrices.Products
			AND T.PriceKind = ChangesOfPrices.PriceKind
			AND T.PricingVariant = ChangesOfPrices.PricingVariant
			AND T.PricingBatch = ChangesOfPrices.PricingBatch
			AND T.PricingPackage = ChangesOfPrices.PricingPackage

ORDER BY
	T.ScheduleDate</query>
	</dataSet>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Max(Price)</expression>
	</totalField>
