		<field xsi:type="DataSetFieldField">
			<dataPath>Ref</dataPath>
			<field>Ref</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Reference</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مرجع</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Link</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Odnośnik</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Ссылка</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Bağlantı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tham chiếu</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CompletedProperties.Ref.Description AS PropertyGroup,
	CompletedProperties.Property,
	ISNULL(CompletedProperties.NumberOfFilledOnes, 0)AS NumberOfFilledOnes,
	ISNULL(GroupPartners.NumberOfPartners, 0) AS NumberOfPartnersInTheGroup,
	CASE
		WHEN ISNULL(CompletedProperties.NumberOfFilledOnes, 0) = 0
			THEN 0
		WHEN ISNULL(GroupPartners.NumberOfPartners, 0) = 0
			THEN 100
		ELSE ISNULL(CompletedProperties.NumberOfFilledOnes, 0) / ISNULL(GroupPartners.NumberOfPartners, 0) * 100
	END AS FillType
FROM
	(SELECT
		AdditionalAttributes.Ref AS Ref,
		AdditionalAttributes.Property AS Property,
		COUNT(PartnersAdditionalDetails.Value) AS NumberOfFilledOnes
	FROM
		Catalog.AdditionalAttributesAndInfoSets.AdditionalAttributes AS AdditionalAttributes
			LEFT JOIN Catalog.Partners.AdditionalAttributes AS PartnersAdditionalDetails
			ON AdditionalAttributes.Property = PartnersAdditionalDetails.Property
	
	GROUP BY
		AdditionalAttributes.Ref,
		AdditionalAttributes.Property) AS CompletedProperties
		INNER JOIN (SELECT
			&amp;Set_Catalog_Partners_Overall AS PropertyGroup,
			COUNT(*) AS NumberOfPartners
		FROM
			Catalog.Partners AS Partners
		
		UNION ALL
		
		SELECT
			&amp;Set_Catalog_Partners_Customers,
			COUNT(*)
		FROM
			Catalog.Partners AS Partners
		WHERE
			Partners.Client
		
		UNION ALL
		
		SELECT
			&amp;Set_Catalog_Partners_Vendors,
			COUNT(*)
		FROM
			Catalog.Partners AS Partners
		WHERE
			Partners.Vendor
		
		UNION ALL
		
		SELECT
			&amp;Set_Catalog_Partners_Competitors,
			COUNT(*)
		FROM
			Catalog.Partners AS Partners
		WHERE
			Partners.Competitor
		
		UNION ALL
		
		SELECT
			&amp;Set_Catalog_Partners_OtherItems,
			COUNT(*)
		FROM
			Catalog.Partners AS Partners
		WHERE
			Partners.OtherRelations) AS GroupPartners
		ON CompletedProperties.Ref = GroupPartners.PropertyGroup</query>
	</dataSet>
