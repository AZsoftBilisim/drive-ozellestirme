					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Сумма перерасход</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Tutar fazla harcama</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Số tiền chi thừa</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Department</dataPath>
				<field>Department</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	MonetaryFunds.Organization AS Organization,
	MonetaryFunds.IssuancePurpose AS IssuancePurpose,
	MonetaryFunds.Currency AS Currency,
	MonetaryFunds.AdvanceHolder AS AdvanceHolder,
	CASE
		WHEN MonetaryFunds.SumBalance &gt; 0
			THEN MonetaryFunds.SumBalance
		ELSE 0
	END AS SumBalance,
	CASE
		WHEN MonetaryFunds.SumBalance &lt; 0
			THEN -MonetaryFunds.SumBalance
		ELSE 0
	END AS AmountOverspend,
	CASE
		WHEN MonetaryFunds.ToReportBalance &gt; 0
			THEN MonetaryFunds.ToReportBalance
		ELSE 0
	END AS AmountOverdue
FROM
	AccumulationRegister.AdvanceHolderCash.Balance(&amp;Period, ) AS MonetaryFunds</query>
		</item>
