				<field>PaymentRequest</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Organization</dataPath>
				<field>Organization</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Company</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>شرکت</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Azienda</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Firma</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Организация</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>İş yeri</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Doanh nghiệp</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>AdvanceHolder</dataPath>
				<field>AdvanceHolder</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Recipient</dataPath>
				<field>Recipient</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BankAccountCashAccount</dataPath>
				<field>BankAccountCashAccount</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	Cash.Recipient AS AdvanceHolder,
	Cash.Organization AS Organization,
	CAST(Cash.PaymentRequest AS Document.PaymentRequest).Currency AS Currency,
	CASE WHEN Cash.SumBalance &lt; 0 THEN
		-Cash.SumBalance
	ELSE
		0
	END AS IssueIsApproved
FROM
	AccumulationRegister.CashToBePaid.Balance(&amp;Period, ) AS Cash
WHERE
	Cash.PaymentRequest REFS Document.PaymentRequest
	AND Cash.PaymentRequest.Status IN (
		VALUE(Enum.StatusesOfPaymentRequests.AgreedUpon),
		VALUE(Enum.StatusesOfPaymentRequests.AmountDue)
	)
	AND Cash.PaymentRequest.BusinessOperation = VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder)
	
UNION ALL

SELECT
	Cash.Recipient AS AdvanceHolder,
	Cash.Organization AS Organization,
	CAST(Cash.PaymentRequest AS Document.ApplicationForBusinessTrip).Currency AS Currency,
	CASE WHEN Cash.SumBalance &lt; 0 THEN
		-Cash.SumBalance
	ELSE
		0
	END AS IssueIsApproved
FROM
	AccumulationRegister.CashToBePaid.Balance(&amp;Period,) AS Cash
WHERE
	Cash.PaymentRequest REFS Document.ApplicationForBusinessTrip
	AND Cash.PaymentRequest.Status IN (
		VALUE(Enum.EmployeeApplicationStatuses.AgreedUpon)
	)</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>SumBalance</dataPath>
		<expression>Case
    When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountOverspend</dataPath>
		<expression>Case
    When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(AmountOverspend)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountOverdue</dataPath>
		<expression>Case
    When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(AmountOverdue)
End</expression>
	</totalField>
	<totalField>
		<dataPath>IssueIsApproved</dataPath>
		<expression>Case
    When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(IssueIsApproved)
End</expression>
	</totalField>
