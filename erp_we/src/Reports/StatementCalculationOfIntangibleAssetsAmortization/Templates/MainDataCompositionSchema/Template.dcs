	<template>
		<name>Template7</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="dcscor:Parameter">ACPeriod</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Details</dcscor:parameter>
							<dcscor:value xsi:type="dcscor:Parameter">DepreciationCalculationDocument</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>ACPeriod</dcsat:name>
			<dcsat:expression>Case When ThisIsAdditionalChargeAccounting Then Format(ACPeriod, "DLF=D") + " " + NStr("ru = '(доначисление)'; vi = '(tính bổ sung)'; en = '(additional amortization charge)'; it = '(additional amortization charge)'; pl = '(additional amortization charge)'; tr = '(hesap öncesi)'") Else Format(ACPeriod, "DLF=D") End</dcsat:expression>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:DetailsAreaTemplateParameter">
			<dcsat:name>DepreciationCalculationDocument</dcsat:name>
			<dcsat:fieldExpression>
				<dcsat:field>DepreciationCalculationDocument</dcsat:field>
				<dcsat:expression>DepreciationCalculationDocument</dcsat:expression>
			</dcsat:fieldExpression>
			<dcsat:mainAction>OpenValue</dcsat:mainAction>
		</parameter>
	</template>
	<template>
		<name>Template8</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="dcscor:Parameter">MAPEriOd</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Details</dcscor:parameter>
							<dcscor:value xsi:type="dcscor:Parameter">DepreciationCalculationDocument</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>MAPEriOd</dcsat:name>
			<dcsat:expression>Case When ThisIsAdditionalChargeMA Then Format(MAPEriOd, "DLF=D") + " " + NStr("ru = '(доначисление)'; vi = '(tính bổ sung)'; en = '(additional amortization charge)'; it = '(additional amortization charge)'; pl = '(additional amortization charge)'; tr = '(hesap öncesi)'") Else Format(MAPEriOd, "DLF=D") End</dcsat:expression>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:DetailsAreaTemplateParameter">
			<dcsat:name>DepreciationCalculationDocument</dcsat:name>
			<dcsat:fieldExpression>
				<dcsat:field>DepreciationCalculationDocument</dcsat:field>
				<dcsat:expression>DepreciationCalculationDocument</dcsat:expression>
			</dcsat:fieldExpression>
			<dcsat:mainAction>OpenValue</dcsat:mainAction>
		</parameter>
	</template>
	<template>
		<name>Template15</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
