		<dataSource>DataSource1</dataSource>
		<query>SELECT
	VALUE(Document.IntangibleAssetsAmortizationCharge2_4.EmptyRef) AS DepreciationCalculationDocument,
	DATETIME(1, 1, 1) AS Period,
	DATETIME(1, 1, 1) AS MAPEriOd,
	DATETIME(1, 1, 1) AS ACPeriod,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.IntangibleAssets.EmptyRef) AS IntangibleAsset,
	0 AS DepreciationManagementAccounting,
	0 AS DepreciationInAccounting,
	FALSE AS ThisIsAnAdditionalAccrual,
	FALSE AS ThisIsAdditionalChargeMA,
	FALSE AS ThisIsAdditionalChargeAccounting,
	VALUE(Enum.AccountingPolicyForFixedAssets.EmptyRef) AS AccountingProcedureMA,
	VALUE(Enum.AccountingPolicyForFixedAssets.EmptyRef) AS AccountingProcedureAC,
	VALUE(Enum.AccrualMethodOfIntangibleAssetDepreciation.EmptyRef) AS DepreciationMethodAccounting,
	0 AS DepreciationMethodVersionLA,
	0 AS InitialCostLocalAccounting,
	0 AS InitialCostMA,
	0 AS UsefulLifeMonthsAC,
	0 AS ThePeriodOfUseForCalculatingTheDepreciationOfTheBU,
	0 AS VolumeOfProductionWorksForCalculatingDepreciationOfBU,
	0 AS OutputPerMonth,
	0 AS EstimatedRunningTime,
	0 AS ActualPeriodOfUseOfBU,
	0 AS ActualPeriodOfUseOfMa,
	0 AS ACResidualValue,
	0 AS NetBookValueMan,
	0 AS DepreciationAccrualFactor,
	0 AS DepreciationRate,
	VALUE(Enum.AccrualMethodOfIntangibleAssetDepreciation.EmptyRef) AS DepreciationAccrualMethodManagementAccounting,
	0 AS DepreciationMethodVersionMA,
	0 AS UsefulLifeOfMa,
	0 AS ThePeriodOfUseForCalculatingTheDepreciationOfTheUU,
	0 AS ScopeOfProductionWorksToCalculateMaDepreciation,
	0 AS AccelerationFactorManagementAccounting,
	0 AS ResidualValueMan,
	0 AS ResidualValueLocal,
	0 AS ResourceDevelopedOverPastPeriodMA,
	0 AS ResourceDevelopedForCurPeriodMA,
	0 AS CostUsedToCalculateDepreciationInManagementAccounting,
	0 AS LifeSpentPastPeriodAccounting,
	0 AS LifeSpentCurrentPeriodAccounting,
	0 AS CostUsedToCalculateDepreciationInAccounting,
	0 AS WorkedMonthsFullYears</query>
	</dataSet>
	<totalField>
		<dataPath>DepreciationInAccounting</dataPath>
		<expression>Sum(DepreciationInAccounting)</expression>
	</totalField>
	<totalField>
		<dataPath>DepreciationManagementAccounting</dataPath>
		<expression>Sum(DepreciationManagementAccounting)</expression>
	</totalField>
	<totalField>
		<dataPath>InitialCostLocalAccounting</dataPath>
		<expression>Max(InitialCostLocalAccounting)</expression>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>UsefulLifeMonthsAC</dataPath>
		<expression>Max(UsefulLifeMonthsAC)</expression>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>OutputPerMonth</dataPath>
		<expression>Max(OutputPerMonth)</expression>
		<group>ACPeriod</group>
		<group>MAPEriOd</group>
	</totalField>
	<totalField>
		<dataPath>EstimatedRunningTime</dataPath>
		<expression>Max(EstimatedRunningTime)</expression>
		<group>ACPeriod</group>
		<group>MAPEriOd</group>
	</totalField>
	<totalField>
		<dataPath>ACResidualValue</dataPath>
		<expression>Max(ACResidualValue)</expression>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>DepreciationAccrualFactor</dataPath>
		<expression>Max(DepreciationAccrualFactor)</expression>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>ActualPeriodOfUseOfBU</dataPath>
		<expression>Max(ActualPeriodOfUseOfBU)</expression>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>DepreciationRate</dataPath>
		<expression>Max(DepreciationRate)</expression>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>InitialCostMA</dataPath>
