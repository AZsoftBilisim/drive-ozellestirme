				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Period (MA)</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Case When ThisIsAdditionalChargeMA Then Format(MAPEriOd, "DLF=D") + " " + NStr("ru = '(доначисление)'; vi = '(trích bổ sung)'; en = '(additional accrual)'; it = '(additional accrual)'; pl = '(additional accrual)'; tr = '(hesap öncesi)'") Else Format(MAPEriOd, "DLF=D") End</presentationExpression>
