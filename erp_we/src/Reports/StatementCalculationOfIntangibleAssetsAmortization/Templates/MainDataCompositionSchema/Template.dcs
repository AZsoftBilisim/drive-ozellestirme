					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Amortization calculation formula: [1] * [2] * [3] / ( [4] - [3] * ( [5] - [6] ) )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
