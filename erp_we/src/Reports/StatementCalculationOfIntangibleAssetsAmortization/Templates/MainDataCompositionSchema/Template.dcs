			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Beginning of the last period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>ابتدای آخرین دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo precedente</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
