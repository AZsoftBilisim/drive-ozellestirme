		<field xsi:type="DataSetFieldField">
			<dataPath>WorkKind</dataPath>
			<field>WorkKind</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BillOfMaterials</dataPath>
			<field>BillOfMaterials</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Stage</dataPath>
			<field>Stage</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RegisterRecords.WorkKind AS WorkKind,
	RegisterRecords.ProductionOrder AS ProductionOrder,
	RegisterRecords.ProductionOrder.LineOfBusiness AS LineOfBusiness,
	RegisterRecords.Stage AS Stage,
	RegisterRecords.BillOfMaterials AS BillOfMaterials,
	RegisterRecords.Department AS Department,
	CASE
		WHEN RegisterRecords.WorkKind.UnitOfMeasure &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN CASE
					WHEN RegisterRecords.WorkKind.UnitOfMeasure = &amp;Seconds
						THEN RegisterRecords.Count / 3600
					WHEN RegisterRecords.WorkKind.UnitOfMeasure = &amp;Minutes1
						THEN RegisterRecords.Count / 60
					WHEN RegisterRecords.WorkKind.UnitOfMeasure = &amp;Hours1
						THEN RegisterRecords.Count
					WHEN RegisterRecords.WorkKind.UnitOfMeasure = &amp;Days
						THEN RegisterRecords.Count * 24
					ELSE RegisterRecords.Count * RegisterRecords.WorkKind.LaborInput / RegisterRecords.WorkKind.LaborInputMultiplier
				END
		ELSE RegisterRecords.Count * RegisterRecords.WorkKind.LaborInput / RegisterRecords.WorkKind.LaborInputMultiplier
	END AS Count,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.DAY)
			THEN ISNULL(Schedule.Begin, RegulatorySchedule.Begin)
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(ISNULL(Schedule.Begin, RegulatorySchedule.Begin), WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(ISNULL(Schedule.Begin, RegulatorySchedule.Begin), TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(ISNULL(Schedule.Begin, RegulatorySchedule.Begin), MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(ISNULL(Schedule.Begin, RegulatorySchedule.Begin), QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(ISNULL(Schedule.Begin, RegulatorySchedule.Begin), HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(ISNULL(Schedule.Begin, RegulatorySchedule.Begin), YEAR)
	END AS DemandDate
{SELECT
	WorkKind.*,
	ProductionOrder.*,
	LineOfBusiness.*,
	Stage.*,
	BillOfMaterials.*,
	Department.*,
	Count,
	DemandDate}
FROM
	InformationRegister.OrderStructureLaborCosts AS RegisterRecords
	
	LEFT JOIN InformationRegister.TargetOrderStructureSchedule AS RegulatorySchedule
	ON NOT &amp;TheProductionScheduleIsUsed
	 AND RegulatorySchedule.KeyLot          = RegisterRecords.KeyLot
	 AND RegulatorySchedule.Stage                = RegisterRecords.Stage
	
	LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	ON &amp;TheProductionScheduleIsUsed
	 AND Schedule.KeyLot          = RegisterRecords.KeyLot
	 AND Schedule.Stage                = RegisterRecords.Stage
	 AND Schedule.ScheduleStatus = 0
WHERE
	ISNULL(Schedule.Begin, RegulatorySchedule.Begin) BETWEEN &amp;StartDate AND &amp;EndDate
{WHERE
	WorkKind.* AS WorkKind,
	RegisterRecords.ProductionOrder.* AS ProductionOrder,
	RegisterRecords.ProductionOrder.LineOfBusiness.* AS LineOfBusiness,
	RegisterRecords.Stage.*,
	RegisterRecords.BillOfMaterials.*,
	RegisterRecords.Department.* AS Department,
	Count AS Count}
</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
