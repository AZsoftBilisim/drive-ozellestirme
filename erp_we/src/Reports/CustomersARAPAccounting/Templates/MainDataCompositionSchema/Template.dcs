	<settingsVariant>
		<dcsset:name>CustomersARAPAccounting</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Customer AR/AP roll forward</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>گردش دریافتنی/پرداختنی مشتری</v8:content>
