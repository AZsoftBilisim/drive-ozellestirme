		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	0 AS PaymentType_,
	CustomersARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	RegisterAccountingAnalyticsForPartners.Contract, 
	CASE WHEN NOT CustomersARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE CustomersARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	CASE &amp;SettlementsData
		WHEN 1
			THEN CustomersARAPAccounting.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		ELSE RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS ARAPCurrency,
	CustomersARAPAccounting.ARAPObject AS OrderDocument,
	CustomersARAPAccounting.ARAPObject.FinancialAccountingGroup AS FinancialAccountingGroup,
	
	CASE WHEN CustomersARAPAccounting.Recorder = UNDEFINED THEN
		NULL
	ELSE
		CustomersARAPAccounting.Recorder
	END AS Recorder,
	
	CustomersARAPAccounting.SecondPeriod AS SecondPeriod,
	CustomersARAPAccounting.DayPeriod AS DayPeriod,
	CustomersARAPAccounting.WeekPeriod AS WeekPeriod,
	CustomersARAPAccounting.TenDaysPeriod AS TenDaysPeriod,
	CustomersARAPAccounting.MonthPeriod AS MonthPeriod,
	CustomersARAPAccounting.QuarterPeriod AS QuarterPeriod,
	CustomersARAPAccounting.HalfYearPeriod AS HalfYearPeriod,
	CustomersARAPAccounting.YearPeriod AS YearPeriod,
	
	CASE WHEN CustomersARAPAccounting.SumOpeningBalance &gt; 0 THEN
		CustomersARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS PartnerDebt_OpeningBalance,
	CASE WHEN CustomersARAPAccounting.SumOpeningBalance &lt; 0 THEN
		-CustomersARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS AccountsPayableOfCompanyOpeningBalance,
	
	CustomersARAPAccounting.SumOpeningBalance AS DebtOpeningBalance,
	CustomersARAPAccounting.SumReceipt AS DebtIncrease_,
	CustomersARAPAccounting.SumExpense AS DebtReduction,
	CustomersARAPAccounting.SumClosingBalance AS DebtClosingBalance,
	
	CASE WHEN CustomersARAPAccounting.SumClosingBalance &gt; 0 THEN
		CustomersARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS PartnerDebt_ClosingBalance,
	CASE WHEN CustomersARAPAccounting.SumClosingBalance &lt; 0 THEN
		-CustomersARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS AccountsPayableOfCompanyClosingBalance
		
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(
		,
		,
		Auto
	) AS CustomersARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData = 1 // In the settlement currency
{WHERE
	RegisterAccountingAnalyticsForPartners.Partner IN (
		SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}

UNION ALL

SELECT
	0 AS PaymentType_,
	CustomersARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	RegisterAccountingAnalyticsForPartners.Contract,
	CASE WHEN NOT CustomersARAPAccounting.SalesOrder.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE CustomersARAPAccounting.SalesOrder.LineOfBusiness
	END,
	CASE &amp;SettlementsData
		WHEN 1
			THEN CustomersARAPAccounting.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		ELSE RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS ARAPCurrency,
	CustomersARAPAccounting.SalesOrder AS OrderDocument,
	CustomersARAPAccounting.SalesOrder.FinancialAccountingGroup AS FinancialAccountingGroup,
	
	CASE WHEN CustomersARAPAccounting.Recorder = UNDEFINED THEN
		NULL
	ELSE
		CustomersARAPAccounting.Recorder
	END AS Recorder,
	
	CustomersARAPAccounting.SecondPeriod AS SecondPeriod,
	CustomersARAPAccounting.DayPeriod AS DayPeriod,
	CustomersARAPAccounting.WeekPeriod AS WeekPeriod,
	CustomersARAPAccounting.TenDaysPeriod AS TenDaysPeriod,
	CustomersARAPAccounting.MonthPeriod AS MonthPeriod,
	CustomersARAPAccounting.QuarterPeriod AS QuarterPeriod,
	CustomersARAPAccounting.HalfYearPeriod AS HalfYearPeriod,
	CustomersARAPAccounting.YearPeriod AS YearPeriod,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance &gt; 0 THEN
			CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance
		ELSE
			0
		END
	ELSE // In the currency of the regl. accounting
		CASE WHEN CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance &gt; 0 THEN
			CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance
		ELSE
			0
		END
	END AS PartnerDebt_OpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance &lt; 0 THEN
			-(CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance)
		ELSE
			0
		END
	ELSE // In the currency of the regl. accounting
		CASE WHEN CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance &lt; 0 THEN
			-(CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance)
		ELSE
			0
		END
	END AS AccountsPayableOfCompanyOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance
	ELSE
		CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance
	END AS DebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CustomersARAPAccounting.ARAPManReceipt + CustomersARAPAccounting.PrepaymentManReceipt
	ELSE
		CustomersARAPAccounting.DebtLocalReceipt + CustomersARAPAccounting.PrepaymentLocalReceipt
	END AS DebtIncrease_,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CustomersARAPAccounting.ARAPManExpense + CustomersARAPAccounting.PrepaymentManExpense
	ELSE
		CustomersARAPAccounting.DebtLocalExpense + CustomersARAPAccounting.PrepaymentLocalExpense
	END AS DebtReduction,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance
	ELSE
		CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance
	END AS DebtClosingBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance &gt; 0 THEN
			CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance
		ELSE
			0
		END
	ELSE
		CASE WHEN CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance &gt; 0 THEN
			CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance
		ELSE
			0
		END
	END AS PartnerDebt_ClosingBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance &lt; 0 THEN
			-(CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance)
		ELSE
			0
		END
	ELSE
		CASE WHEN CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance &lt; 0 THEN
			-(CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance)
		ELSE
			0
		END
	END AS AccountsPayableOfCompanyClosingBalance

FROM
	AccumulationRegister.CustomersARAPAccountingByDocuments.BalanceAndTurnovers(
		,
		,
		Auto
	) AS CustomersARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData IN (2,3) // In the currency of upr. accounting, in the currency of regl. accounting
{WHERE
	RegisterAccountingAnalyticsForPartners.Partner IN (
		SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}</query>
	</dataSet>
	<totalField>
		<dataPath>DebtClosingBalance</dataPath>
		<expression>Case
    When Sum(DebtClosingBalance) &lt;&gt; 0
        And Count(Distinct ARAPCurrency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(DebtClosingBalance), ""NFD=2; NZ=0,00""), ARAPCurrency", "ARAPCurrency")), ";", "")
    Else
        Sum(DebtClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtOpeningBalance</dataPath>
		<expression>Case
    When Sum(DebtOpeningBalance) &lt;&gt; 0
        And Count(Distinct ARAPCurrency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(DebtOpeningBalance), ""NFD=2; NZ=0,00""), ARAPCurrency", "ARAPCurrency")), ";", "")
    Else
        Sum(DebtOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PartnerDebt_ClosingBalance</dataPath>
		<expression>Case
    When Sum(PartnerDebt_ClosingBalance) &lt;&gt; 0
        And Count(Distinct ARAPCurrency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(PartnerDebt_ClosingBalance), ""NFD=2; NZ=0,00""), ARAPCurrency", "ARAPCurrency")), ";", "")
    Else
        Sum(PartnerDebt_ClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PartnerDebt_OpeningBalance</dataPath>
		<expression>Case
    When Sum(PartnerDebt_OpeningBalance) &lt;&gt; 0
        And Count(Distinct ARAPCurrency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(PartnerDebt_OpeningBalance), ""NFD=2; NZ=0,00""), ARAPCurrency", "ARAPCurrency")), ";", "")
    Else
        Sum(PartnerDebt_OpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtIncrease_</dataPath>
		<expression>Case
    When Sum(DebtIncrease_) &lt;&gt; 0
        And Count(Distinct ARAPCurrency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(DebtIncrease_), ""NFD=2; NZ=0,00""), ARAPCurrency", "ARAPCurrency")), ";", "")
    Else
        Sum(DebtIncrease_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtReduction</dataPath>
		<expression>Case
    When Sum(DebtReduction) &lt;&gt; 0
        And Count(Distinct ARAPCurrency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(DebtReduction), ""NFD=2; NZ=0,00""), ARAPCurrency", "ARAPCurrency")), ";", "")
    Else
        Sum(DebtReduction)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompanyClosingBalance</dataPath>
		<expression>Case
    When Sum(AccountsPayableOfCompanyClosingBalance) &lt;&gt; 0
        And Count(Distinct ARAPCurrency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(AccountsPayableOfCompanyClosingBalance), ""NFD=2; NZ=0,00""), ARAPCurrency", "ARAPCurrency")), ";", "")
    Else
        Sum(AccountsPayableOfCompanyClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompanyOpeningBalance</dataPath>
		<expression>Case
    When Sum(AccountsPayableOfCompanyOpeningBalance) &lt;&gt; 0
        And Count(Distinct ARAPCurrency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(AccountsPayableOfCompanyOpeningBalance), ""NFD=2; NZ=0,00""), ARAPCurrency", "ARAPCurrency")), ";", "")
    Else
        Sum(AccountsPayableOfCompanyOpeningBalance)
End</expression>
	</totalField>
