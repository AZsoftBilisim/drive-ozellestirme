		<field xsi:type="DataSetFieldField">
			<dataPath>Sender</dataPath>
			<field>Sender</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>BusinessOperation</dataPath>
			<field>BusinessOperation</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Table.Document                          AS Document,
	Table.Products                      AS Products,
	Table.Products.UnitOfMeasure AS StorageUnit,
	Table.Products.UnitForReports AS UnitForReports,
	Table.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	Table.Characteristic                    AS Characteristic,
	SUM(Table.ToRegisterReceipt)          AS ToRegisterReceipt,
	SUM(Table.ToRegisterExpense)          AS ToRegisterExpense,
	SUM(Table.ToRegisterClosingBalance) AS ToRegisterClosingBalance,
	SUM(Table.ToRegisterOpeningBalance)
	 + SUM(Table.ToRegisterReceipt)       AS ToRegisterRegister,
	SUM(Table.ToShipReceipt)            AS ToShipReceipt,
	SUM(Table.ToShipExpense)            AS ToShipExpense,
	SUM(Table.ToShipClosingBalance)   AS ToShipClosingBalance,
	SUM(Table.ToShipOpeningBalance)
	 + SUM(Table.ToShipReceipt)         AS ForShipmentShip,
	SUM(Table.ToReceiveReceipt)         AS ToReceiveReceipt,
	SUM(Table.ToReceiveExpense)         AS ToReceiveExpense,
	SUM(Table.ToReceiveClosingBalance) AS ToReceiveClosingBalance,
	SUM(Table.ToReceiveOpeningBalance)
	 + SUM(Table.ToReceiveReceipt)      AS ToReceiveReceive,
	CASE
		WHEN Table.Recorder = UNDEFINED
			THEN NULL
		ELSE Table.Recorder
	END                                     AS Recorder,
	Table.YearPeriod,
	Table.HalfYearPeriod,
	Table.QuarterPeriod,
	Table.MonthPeriod,
	Table.TenDaysPeriod,
	Table.WeekPeriod,
	Table.DayPeriod,
	Table.SecondPeriod

FROM
	(SELECT
		Orders.ByAssemblyDisassemblyOrder               AS Document,
		Orders.Products                AS Products,
		Orders.Characteristic              AS Characteristic,
		Orders.ToRegisterOpeningBalance AS ToRegisterOpeningBalance,
		Orders.ToRegisterReceipt           AS ToRegisterReceipt,
		Orders.ToRegisterExpense           AS ToRegisterExpense,
		Orders.ToRegisterClosingBalance  AS ToRegisterClosingBalance,
		CASE
			WHEN (NOT Orders.ByAssemblyDisassemblyOrder.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
					OR Orders.ByAssemblyDisassemblyOrder.Date &lt; Orders.ByAssemblyDisassemblyOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue)
					AND Orders.AssemblyType = VALUE(Enum.InventoryMovementTypes.Shipment)
				THEN Orders.ToRegisterOpeningBalance
			ELSE 0
		END                              AS ToShipOpeningBalance,
		CASE
			WHEN (NOT Orders.ByAssemblyDisassemblyOrder.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
					OR Orders.ByAssemblyDisassemblyOrder.Date &lt; Orders.ByAssemblyDisassemblyOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue)
					AND Orders.AssemblyType = VALUE(Enum.InventoryMovementTypes.Shipment)
				THEN Orders.ToRegisterReceipt
			ELSE 0
		END                              AS ToShipReceipt,
		CASE
			WHEN (NOT Orders.ByAssemblyDisassemblyOrder.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
					OR Orders.ByAssemblyDisassemblyOrder.Date &lt; Orders.ByAssemblyDisassemblyOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue)
					AND Orders.AssemblyType = VALUE(Enum.InventoryMovementTypes.Shipment)
				THEN Orders.ToRegisterExpense
			ELSE 0
		END                              AS ToShipExpense,
		CASE
			WHEN (NOT Orders.ByAssemblyDisassemblyOrder.Warehouse.UseWarehouseManagemantSystemForGoodsIssue
					OR Orders.ByAssemblyDisassemblyOrder.Date &lt; Orders.ByAssemblyDisassemblyOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue)
					AND Orders.AssemblyType = VALUE(Enum.InventoryMovementTypes.Shipment)
				THEN Orders.ToRegisterClosingBalance
			ELSE 0
		END                              AS ToShipClosingBalance,
		CASE
			WHEN (NOT Orders.ByAssemblyDisassemblyOrder.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Orders.ByAssemblyDisassemblyOrder.Date &lt; Orders.ByAssemblyDisassemblyOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
					AND Orders.AssemblyType = VALUE(Enum.InventoryMovementTypes.Inpayment)
				THEN Orders.ToRegisterOpeningBalance
			ELSE 0
		END                              AS ToReceiveOpeningBalance,
		CASE
			WHEN (NOT Orders.ByAssemblyDisassemblyOrder.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Orders.ByAssemblyDisassemblyOrder.Date &lt; Orders.ByAssemblyDisassemblyOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
					AND Orders.AssemblyType = VALUE(Enum.InventoryMovementTypes.Inpayment)
				THEN Orders.ToRegisterReceipt
			ELSE 0
		END                              AS ToReceiveReceipt,
		CASE
			WHEN (NOT Orders.ByAssemblyDisassemblyOrder.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Orders.ByAssemblyDisassemblyOrder.Date &lt; Orders.ByAssemblyDisassemblyOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
					AND Orders.AssemblyType = VALUE(Enum.InventoryMovementTypes.Inpayment)
				THEN Orders.ToRegisterExpense
			ELSE 0
		END                              AS ToReceiveExpense,
		CASE
			WHEN (NOT Orders.ByAssemblyDisassemblyOrder.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Orders.ByAssemblyDisassemblyOrder.Date &lt; Orders.ByAssemblyDisassemblyOrder.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
					AND Orders.AssemblyType = VALUE(Enum.InventoryMovementTypes.Inpayment)
				THEN Orders.ToRegisterClosingBalance
			ELSE 0
		END                              AS ToReceiveClosingBalance,
		Orders.YearPeriod                   AS YearPeriod,
		Orders.HalfYearPeriod             AS HalfYearPeriod,
		Orders.QuarterPeriod               AS QuarterPeriod,
		Orders.MonthPeriod                 AS MonthPeriod,
		Orders.TenDaysPeriod                AS TenDaysPeriod,
		Orders.WeekPeriod                AS WeekPeriod,
		Orders.DayPeriod                  AS DayPeriod,
		Orders.SecondPeriod               AS SecondPeriod,
		Orders.Recorder                 AS Recorder

	{SELECT
		YearPeriod,
		HalfYearPeriod,
		QuarterPeriod,
		MonthPeriod,
		TenDaysPeriod,
		WeekPeriod,
		DayPeriod,
		SecondPeriod,
		Recorder}
	FROM
		AccumulationRegister.AssemblyOrders.BalanceAndTurnovers(, , Auto, ,
				{
				(ByAssemblyDisassemblyOrder.Warehouse).* AS SourceWarehouse,
				(ByAssemblyDisassemblyOrder.Warehouse).* AS DestinationWarehouse
				}
			) AS Orders
	
	UNION ALL
	
	SELECT
		Orders.TransferOrder,
		Orders.Products,
		Orders.Characteristic,
		Orders.ToRegisterOpeningBalance,
		Orders.ToRegisterReceipt,
		Orders.ToRegisterExpense,
		Orders.ToRegisterClosingBalance,
		CASE
			WHEN (NOT Orders.TransferOrder.SourceWarehouse.UseWarehouseManagemantSystemForGoodsIssue
					OR Orders.TransferOrder.Date &lt; Orders.TransferOrder.SourceWarehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue)
				THEN Orders.ToRegisterOpeningBalance
			ELSE 0
		END,
		CASE
			WHEN (NOT Orders.TransferOrder.SourceWarehouse.UseWarehouseManagemantSystemForGoodsIssue
					OR Orders.TransferOrder.Date &lt; Orders.TransferOrder.SourceWarehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue)
				THEN Orders.ToRegisterReceipt
			ELSE 0
		END,
		CASE
			WHEN (NOT Orders.TransferOrder.SourceWarehouse.UseWarehouseManagemantSystemForGoodsIssue
					OR Orders.TransferOrder.Date &lt; Orders.TransferOrder.SourceWarehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue)
				THEN Orders.ToRegisterExpense
			ELSE 0
		END,
		CASE
			WHEN (NOT Orders.TransferOrder.SourceWarehouse.UseWarehouseManagemantSystemForGoodsIssue
					OR Orders.TransferOrder.Date &lt; Orders.TransferOrder.SourceWarehouse.StartDateOfWarehouseManagemantSystemForGoodsIssue)
				THEN Orders.ToRegisterClosingBalance
			ELSE 0
		END,
		CASE
			WHEN (NOT Orders.TransferOrder.DestinationWarehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Orders.TransferOrder.Date &lt; Orders.TransferOrder.DestinationWarehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
				THEN Orders.ToRegisterOpeningBalance
			ELSE 0
		END,
		CASE
			WHEN (NOT Orders.TransferOrder.DestinationWarehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Orders.TransferOrder.Date &lt; Orders.TransferOrder.DestinationWarehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
				THEN Orders.ToRegisterReceipt
			ELSE 0
		END,
		CASE
			WHEN (NOT Orders.TransferOrder.DestinationWarehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Orders.TransferOrder.Date &lt; Orders.TransferOrder.DestinationWarehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
				THEN Orders.ToRegisterExpense
			ELSE 0
		END,
		CASE
			WHEN (NOT Orders.TransferOrder.DestinationWarehouse.UseWarehouseManagemantSystemForGoodsReceipt
					OR Orders.TransferOrder.Date &lt; Orders.TransferOrder.DestinationWarehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt)
				THEN Orders.ToRegisterClosingBalance
			ELSE 0
		END,
		Orders.YearPeriod,
		Orders.HalfYearPeriod,
		Orders.QuarterPeriod,
		Orders.MonthPeriod,
		Orders.TenDaysPeriod,
		Orders.WeekPeriod,
		Orders.DayPeriod,
		Orders.SecondPeriod,
		Orders.Recorder
	FROM
		AccumulationRegister.TransferOrders.BalanceAndTurnovers(, , Auto, ,
				{
					(TransferOrder.SourceWarehouse).* AS SourceWarehouse,
					(TransferOrder.DestinationWarehouse).* AS DestinationWarehouse
				}
			) AS Orders
	
	UNION ALL
	
	SELECT
		CASE
			WHEN GoodsForIssue.DocumentShipments REFS Document.AssemblyFromComponents
				THEN CASE
						WHEN CAST(GoodsForIssue.DocumentShipments AS Document.AssemblyFromComponents).ByAssemblyDisassemblyOrder = VALUE(Document.ByAssemblyDisassemblyOrder.EmptyRef)
							THEN CAST(GoodsForIssue.DocumentShipments AS Document.AssemblyFromComponents)
						ELSE CAST(GoodsForIssue.DocumentShipments AS Document.AssemblyFromComponents).ByAssemblyDisassemblyOrder
					END
			WHEN GoodsForIssue.DocumentShipments REFS Document.InventoryTransfer
				THEN CASE
						WHEN CAST(GoodsForIssue.DocumentShipments AS Document.InventoryTransfer).TransferOrder = VALUE(Document.TransferOrder.EmptyRef)
							THEN CAST(GoodsForIssue.DocumentShipments AS Document.InventoryTransfer)
						ELSE CAST(GoodsForIssue.DocumentShipments AS Document.InventoryTransfer).TransferOrder
					END
		END,
		GoodsForIssue.Products,
		GoodsForIssue.Characteristic,
		0,
		0,
		0,
		0,
		GoodsForIssue.ToShipOpeningBalance,
		GoodsForIssue.ToShipReceipt,
		GoodsForIssue.ToShipExpense,
		GoodsForIssue.ToShipClosingBalance,
		0,
		0,
		0,
		0,
		GoodsForIssue.YearPeriod,
		GoodsForIssue.HalfYearPeriod,
		GoodsForIssue.QuarterPeriod,
		GoodsForIssue.MonthPeriod,
		GoodsForIssue.TenDaysPeriod,
		GoodsForIssue.WeekPeriod,
		GoodsForIssue.DayPeriod,
		GoodsForIssue.SecondPeriod,
		GoodsForIssue.Recorder
	FROM
		AccumulationRegister.GoodsForIssue.BalanceAndTurnovers(
				,
				,
				Auto,
				,
				DocumentShipments REFS Document.AssemblyFromComponents
					OR DocumentShipments REFS Document.InventoryTransfer 
				{
					(Warehouse).* AS SourceWarehouse,
					CASE
						WHEN DocumentShipments REFS Document.AssemblyFromComponents THEN
							CAST(DocumentShipments AS Document.AssemblyFromComponents).Warehouse
						WHEN DocumentShipments REFS Document.InventoryTransfer THEN
							CAST(DocumentShipments AS Document.InventoryTransfer).DestinationWarehouse
					END AS DestinationWarehouse
				}
		) AS GoodsForIssue
	
	UNION ALL
	
	SELECT
		GoodsToReceive.DocumentInflow,
		GoodsToReceive.Products,
		GoodsToReceive.Characteristic,
		0,
		0,
		0,
		0,
		0,
		0,
		0,
		0,
		GoodsToReceive.GoodsReceiptNotesToRegisterOpeningBalance,
		GoodsToReceive.GoodsReceiptNotesToRegisterReceipt,
		GoodsToReceive.GoodsReceiptNotesToRegisterExpense,
		GoodsToReceive.GoodsReceiptNotesToRegisterClosingBalance,
		GoodsToReceive.YearPeriod,
		GoodsToReceive.HalfYearPeriod,
		GoodsToReceive.QuarterPeriod,
		GoodsToReceive.MonthPeriod,
		GoodsToReceive.TenDaysPeriod,
		GoodsToReceive.WeekPeriod,
		GoodsToReceive.DayPeriod,
		GoodsToReceive.SecondPeriod,
		GoodsToReceive.Recorder
	FROM
		AccumulationRegister.GoodsToReceive.BalanceAndTurnovers(
				,
				,
				Auto,
				,
				DocumentInflow REFS Document.AssemblyFromComponents
					OR DocumentInflow REFS Document.ByAssemblyDisassemblyOrder
					OR DocumentInflow REFS Document.InventoryTransfer
					OR DocumentInflow REFS Document.TransferOrder

				{
					(Warehouse).* AS DestinationWarehouse,
					(CASE
						WHEN DocumentInflow REFS Document.AssemblyFromComponents THEN

							CAST(DocumentInflow AS Document.AssemblyFromComponents).Warehouse

						WHEN DocumentInflow REFS Document.ByAssemblyDisassemblyOrder THEN

							CAST(DocumentInflow AS Document.ByAssemblyDisassemblyOrder).Warehouse

						WHEN DocumentInflow REFS Document.InventoryTransfer THEN

							CAST(DocumentInflow AS Document.InventoryTransfer).SourceWarehouse

						WHEN DocumentInflow REFS Document.TransferOrder THEN
						
							CAST(DocumentInflow AS Document.TransferOrder).SourceWarehouse

					END) AS SourceWarehouse
				}
			) AS GoodsToReceive
		) AS Table

GROUP BY
	Table.WeekPeriod,
	Table.YearPeriod,
	Table.Document,
	Table.TenDaysPeriod,
	Table.Characteristic,
	Table.QuarterPeriod,
	Table.HalfYearPeriod,
	Table.MonthPeriod,
	Table.DayPeriod,
	Table.SecondPeriod,
	Table.Products,
	&amp;QueryTextItemWeight,
	&amp;QueryTextTheVolumeOfTheItem,
	CASE
		WHEN Table.Recorder = UNDEFINED
			THEN NULL
		ELSE Table.Recorder
	END</query>
	</dataSet>
	<calculatedField>
		<dataPath>ToShipClosingBalance</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		ToShipClosingBalance
	When &amp;QuantityUnits = 1 Then
		ToShipClosingBalance / UnitFactorForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>To ship closing balance</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>مانده پایان دوره برای ارسال</v8:content>
