	</dataSet>
	<calculatedField>
		<dataPath>Recommendation</dataPath>
		<expression>Case 
When NoIssues Then
 NStr("ru = 'Элементы бюджета, требующие переработки не обнаружены'; vi = 'Không tìm thấy các phần tử ngân sách cần xử lý'; en = 'No budget flow items requiring processing were found'; it = 'Non sono stati trovati elementi del bilancio che richiedono rielaborazione '; pl = 'Nie wykryto elementów budżetu, wymagających przetwarzania'; tr = 'İşlem gereken bütçe kalemleri tespit edilemedi'")
When MainItem And FinalItem Then 
 NStr("ru = 'Пересмотреть структуру бюджета и отказаться от следующих элементов'; vi = 'Xem lại cấu trúc ngân sách và loại bỏ các phần tử sau'; en = 'Review the budget structure and discard the following items'; it = 'Rivedere la struttura del bilancio e rinunciare ai seguenti elementi'; pl = 'Zrewiduj strukturę budżetu i zrezygnuj z następujących elementów'; tr = 'Bütçe yapısını yeniden gözden geçir ve sıradaki öğelerden vazgeç'")
When ItemKind = &amp;BudgetIndicator Then
 NStr("ru = 'Отказаться от следующих элементов в структуре бюджета'; vi = 'Loại bỏ các yếu tố sau đây trong cấu trúc ngân sách'; en = 'Discard the following items in the budget structure'; it = 'Rinunciare ai seguenti elementi nella struttura del bilancio'; pl = 'Zrezygnuj z następujących elementów w strukturze budżetu'; tr = 'Bütçe yapısındaki sıradaki öğelerden vazgeç'") 
When MainItem And Not FinalItem And ItemKind = &amp;BudgetFlowItem Then 
 NStr("ru = 'Вместо следующих элементов использовать элемент ""Формула по группе"", либо производный показатель с операндами типа ""Ячейка таблицы"". Для этого вместо простой таблицы используйте сложную.'; vi = 'Thay thế cho các phần tử sau bằng cách sử dụng phần tử ""Công thức theo nhóm"" hoặc chỉ tiêu nguồn với toán hạng kiểu ""Ô của bảng"". Để thực hiện điều này, thay cho bảng đơn giản, hãy sử dụng bảng phức hợp.'; en = 'Instead of the following elements, use the ""Formula by group"" element, or a derived item with operands of the type ""Table cell"" To do this, use a complex table instead of a simple one.'; it = 'Al posto dei seguenti elementi usare l''elemento ""Formula per gruppo"" oppure indicatore derivato con gli operandi ""Cella della tabella"". Per farlo usate tabella complessa invece della tabella semplice.'; pl = 'Zamiast następujących elementów użyj ""Wzór dla grupy"", lub wskaźnik pochodny z operandami o typie ""Komórka tabeli"". W tym celu zamiast zwykłej tabeli używaj złożonej tabeli.'; tr = 'Sıradaki öğeler yerine ""Gruba göre formül"" öğesini ya da türetilmiş madde ile işlenen tipi ""Hücre tablosunu"" kullan. Bunun için basit tablo yerine kompleks olanı kullan.'")

When MainItem And Not FinalItem Then 
 NStr("ru = 'Вместо следующих элементов использовать элемент ""Формула по группе"", либо производный показатель с операндами типа ""Ячейка таблицы""'; vi = 'Thay thế cho các phần tử sau bằng cách sử dụng phần tử ""Công thức theo nhóm"" hoặc chỉ tiêu nguồn có toán hạng kiểu ""Ô của bảng""'; en = 'Instead of the following elements, use the ""Formula by group"" element, or a derived item with operands of the type ""Table cell""'; it = 'Al posto dei seguenti elementi usare l''elemento ""Formula per gruppo"" oppure indicatore derivato con gli operandi ""Cella della tabella""'; pl = 'Zamiast następujących elementów używaj ""Wzór dla grupy"", lub wskaźnik pochodny z operandami o typie ""Komórka tabeli""'; tr = 'Sıradaki öğeler yerine ""Gruba göre formül"" öğesini ya da türetilmiş madde ile işlenen tipi ""Hücre tablosu"" kullan'")
When ItemKind = &amp;DerivedItem Then
 NStr("ru = 'В следующих производных показателях заменить операнды на операнды типа ""Ячейка таблицы ""'; vi = 'Trong các chỉ tiêu tùy ý sau, cần thay thế các toán hạng sang toán hạng kiểu ""Ô của bảng""'; en = 'In the following derived items, replace operands with operands of the type ""Table cell""'; it = 'Sostituire nei seguenti indicatori derivati gli operandi con gli operandi del tipo ""Cella della tabella""'; pl = 'W następujących wskaźnikach pochodnych zastąp operandy na operandy o typie ""Komórka tabeli ""'; tr = 'Sıradaki türetilmiş maddelerde işlenenleri ""Hücre tablosu"" tipi işlenenler ile değiştir'") 
Else 
 NStr("ru = 'Отказаться от следующих элементов в структуре бюджета'; vi = 'Loại bỏ các yếu tố sau đây trong cấu trúc ngân sách'; en = 'Discard the following items in the budget structure'; it = 'Rinunciare ai seguenti elementi nella struttura del bilancio'; pl = 'Zrezygnuj z następujących elementów w strukturze budżetu'; tr = 'Bütçe yapısındaki sıradaki öğelerden vazgeç'") 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Recommendation</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پیشنهاد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Consiglio</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Zalecenie</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Рекомендация</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Öneri</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Khuyến cáo</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>NoIssues</dataPath>
		<expression>Max(NoIssues)</expression>
	</totalField>
