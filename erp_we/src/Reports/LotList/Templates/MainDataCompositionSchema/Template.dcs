			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Case
              When Sum(CountOpeningBalance) &lt;&gt; 0
                    And Count(Distinct Currency) &gt; 1
              Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(CountOpeningBalance), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
              Else
        Sum(CountOpeningBalance)
              End
End</expression>
	</totalField>
