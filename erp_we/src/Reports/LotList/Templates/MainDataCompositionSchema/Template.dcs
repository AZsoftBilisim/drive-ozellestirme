							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MarkNegatives</dcscor:parameter>
					<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MinWidth</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">18</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MaxWidth</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">18</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Currency</dataPath>
			<field>Currency</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Currency</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>ارز</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Valuta</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Waluta</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Валюта</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Para birimi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tiền tệ</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;InventoryCost AS RegisterType,
	Lots.DayPeriod         AS DayPeriod,
	Lots.WeekPeriod       AS WeekPeriod,
	Lots.TenDaysPeriod       AS TenDaysPeriod,
	Lots.MonthPeriod        AS MonthPeriod,
	Lots.QuarterPeriod      AS QuarterPeriod,
	Lots.HalfYearPeriod    AS HalfYearPeriod,
	Lots.YearPeriod          AS YearPeriod,
	Lots.SecondPeriod      AS SecondPeriod,
	
	DimensionOfProductItem.Products                                 AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure                AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports               AS UnitForReports,
	DimensionOfProductItem.Products.SKU                         AS ProductsSKU,
	
	DimensionOfProductItem.Characteristic      AS Characteristic,
	DimensionOfProductItem.Series               AS Series,
	DimensionOfProductItem.StorageLocation               AS Warehouse,
	
	Lots.ItemsLocationAttributes         AS ItemsLocationAttributes,
	Lots.Lot                             AS DocumentInflow,
	UNDEFINED                              AS ExpenseItem,
	UNDEFINED                              AS ExpenseReceiptDocument,
	Lots.LotVendorAttributes               AS LotVendorAttributes,
	
	Lots.InventoryOwnerAttribute                         AS InventoryOwnerAttribute,
	ISNULL(Lots.LotVendorAttributes.Vendor, UNDEFINED) AS Vendor,
	ISNULL(Lots.LotVendorAttributes.FinancialAccountingGroup, UNDEFINED)  AS FinancialAccountingGroup,
	
	Lots.Organization AS Organization,
	CASE WHEN Lots.Recorder = UNDEFINED THEN
		NULL
		ELSE Lots.Recorder
	END                                     AS Recorder,
	
	CASE &amp;ReportData
		WHEN 4
			THEN Lots.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	CASE WHEN &amp;BeginOfPeriod &lt; &amp;DateOfMigrationToBatchAccounting22 THEN 0
	WHEN &amp;QuantityUnits = 0 THEN
		Lots.CountOpeningBalance
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			Lots.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS CountOpeningBalance,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		Lots.CountClosingBalance
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			Lots.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS CountClosingBalance,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		Lots.CountReceipt
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			Lots.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS CountReceipt,
	
	CASE WHEN &amp;QuantityUnits = 0 THEN
		Lots.CountExpense
	WHEN &amp;QuantityUnits = 1 THEN
		CASE WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0 THEN
			Lots.CountExpense / DimensionOfProductItem.Products.UnitFactorForReports
		ELSE 0
		END
	END AS CountExpense,
	CASE
		WHEN &amp;BeginOfPeriod &lt; &amp;DateOfMigrationToBatchAccounting22
			THEN 0
		ELSE Lots.CountOpeningBalance * &amp;QueryTextWeight
	END                                                      AS StartBalanceWeight,
	Lots.CountClosingBalance * &amp;QueryTextWeight        AS ClosingBalanceWeight,
	Lots.CountReceipt * &amp;QueryTextWeight                 AS ReceiptWeight,
	Lots.CountExpense * &amp;QueryTextWeight                 AS ConsumptionWeight,
	CASE
		WHEN &amp;BeginOfPeriod &lt; &amp;DateOfMigrationToBatchAccounting22
			THEN 0
		ELSE Lots.CountOpeningBalance * &amp;QueryTextVolumeM3
	END                                                      AS StartBalanceVolume,
	Lots.CountClosingBalance * &amp;QueryTextVolumeM3      AS ClosingBalanceVolume,
	Lots.CountReceipt * &amp;QueryTextVolumeM3               AS ReceiptVolume,
	Lots.CountExpense * &amp;QueryTextVolumeM3               AS ConsumptionVolume,
	
	//CostOfAdmissionOpeningBalance
	CASE WHEN &amp;BeginOfPeriod &lt; &amp;DateOfMigrationToBatchAccounting22 THEN 0
	WHEN &amp;ReportData = 1 THEN
		Lots.CostOpeningBalance
		+ Lots.OffBalanceCostOpeningBalance
		+ Lots.LaborCostsOpeningBalance
		+ Lots.ItemizedFixedCostsIncludingVATOpeningBalance
		+ Lots.ItemizedVariableCostsIncludingVATOpeningBalance
	WHEN &amp;ReportData = 2 THEN
		Lots.CostExcludingVATOpeningBalance
		+ Lots.OffBalanceCostOpeningBalance
		+ Lots.LaborCostsOpeningBalance
		+ Lots.ItemizedFixedCostsExcludingVATOpeningBalance
		+ Lots.ItemizedVariableCostsExcludingVATOpeningBalance
	WHEN &amp;ReportData = 3 THEN
		Lots.CostManOpeningBalance
		+ Lots.OffBalanceCostOpeningBalance
		+ Lots.LaborCostsManOpeningBalance
		+ Lots.ItemizedFixedCostsManagOpeningBalance
		+ Lots.ItemizedVariableCostsManagOpeningBalance
	WHEN &amp;ReportData = 4 THEN
		Lots.LocalCostOpeningBalance
		+ Lots.OffBalanceCostLocalOpeningBalance
		+ Lots.LaborCostsLocalOpeningBalance
		+ Lots.ItemizedFixedCostsComplOpeningBalance
		+ Lots.ItemizedVariableCostsComplOpeningBalance
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.CostExcludingVATOpeningBalance
			+ Lots.OffBalanceCostOpeningBalance
			+ Lots.LaborCostsOpeningBalance
			+ Lots.ItemizedFixedCostsExcludingVATOpeningBalance
			+ Lots.ItemizedVariableCostsExcludingVATOpeningBalance
		ELSE
			Lots.CostManOpeningBalance
			+ Lots.OffBalanceCostOpeningBalance
			+ Lots.LaborCostsManOpeningBalance
			+ Lots.ItemizedFixedCostsManagOpeningBalance
			+ Lots.ItemizedVariableCostsManagOpeningBalance
		END
	END AS CostOfAdmissionOpeningBalance,
	
	//CostOfAdmissionClosingBalance
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.CostClosingBalance
		+ Lots.OffBalanceCostClosingBalance
		+ Lots.LaborCostsClosingBalance
		+ Lots.ItemizedFixedCostsIncludingVATClosingBalance
		+ Lots.ItemizedVariableCostsIncludingVATClosingBalance
	WHEN &amp;ReportData = 2 THEN
		Lots.CostExcludingVATClosingBalance
		+ Lots.OffBalanceCostClosingBalance
		+ Lots.LaborCostsClosingBalance
		+ Lots.ItemizedFixedCostsExcludingVATClosingBalance
		+ Lots.ItemizedVariableCostsExcludingVATClosingBalance
	WHEN &amp;ReportData = 3 THEN
		Lots.CostManClosingBalance
		+ Lots.OffBalanceCostClosingBalance
		+ Lots.LaborCostsManClosingBalance
		+ Lots.ItemizedFixedCostsManagClosingBalance
		+ Lots.ItemizedVariableCostsManagClosingBalance
	WHEN &amp;ReportData = 4 THEN
		Lots.LocalCostClosingBalance
		+ Lots.OffBalanceCostLocalClosingBalance
		+ Lots.LaborCostsLocalClosingBalance
		+ Lots.ItemizedFixedCostsComplClosingBalance
		+ Lots.ItemizedVariableCostsComplClosingBalance
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.CostExcludingVATClosingBalance
			+ Lots.OffBalanceCostClosingBalance
			+ Lots.LaborCostsClosingBalance
			+ Lots.ItemizedFixedCostsExcludingVATClosingBalance
			+ Lots.ItemizedVariableCostsExcludingVATClosingBalance
		ELSE
			Lots.CostManClosingBalance
			+ Lots.OffBalanceCostClosingBalance
			+ Lots.LaborCostsManClosingBalance
			+ Lots.ItemizedFixedCostsManagClosingBalance
			+ Lots.ItemizedVariableCostsManagClosingBalance
		END
	END AS CostOfAdmissionClosingBalance,
	
	//CostOfAdmissionReceipt
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.CostReceipt
		+ Lots.OffBalanceCostReceipt
		+ Lots.LaborCostsReceipt
		+ Lots.ItemizedFixedCostsIncludingVATReceipt
		+ Lots.ItemizedVariableCostsIncludingVATReceipt
	WHEN &amp;ReportData = 2 THEN
		Lots.CostExcludingVATReceipt
		+ Lots.OffBalanceCostReceipt
		+ Lots.LaborCostsReceipt
		+ Lots.ItemizedFixedCostsExcludingVATReceipt
		+ Lots.ItemizedVariableCostsExcludingVATReceipt
	WHEN &amp;ReportData = 3 THEN
		Lots.CostManReceipt
		+ Lots.OffBalanceCostReceipt
		+ Lots.LaborCostsManReceipt
		+ Lots.ItemizedFixedCostsManagReceipt
		+ Lots.ItemizedVariableCostsManagReceipt
	WHEN &amp;ReportData = 4 THEN
		Lots.LocalCostReceipt
		+ Lots.OffBalanceCostLocalReceipt
		+ Lots.LaborCostsLocalReceipt
		+ Lots.ItemizedFixedCostsComplReceipt
		+ Lots.ItemizedVariableCostsComplReceipt
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.CostExcludingVATReceipt
			+ Lots.OffBalanceCostReceipt
			+ Lots.LaborCostsReceipt
			+ Lots.ItemizedFixedCostsExcludingVATReceipt
			+ Lots.ItemizedVariableCostsExcludingVATReceipt
		ELSE
			Lots.CostManReceipt
			+ Lots.OffBalanceCostReceipt
			+ Lots.LaborCostsManReceipt
			+ Lots.ItemizedFixedCostsManagReceipt
			+ Lots.ItemizedVariableCostsManagReceipt
		END
	END AS CostOfAdmissionReceipt,
	
	//CostOfAdmissionExpense
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.CostExpense
		+ Lots.OffBalanceCostExpense
		+ Lots.LaborCostsExpense
		+ Lots.ItemizedFixedCostsIncludingVATExpense
		+ Lots.ItemizedVariableCostsIncludingVATExpense
	WHEN &amp;ReportData = 2 THEN
		Lots.CostExcludingVATExpense
		+ Lots.OffBalanceCostExpense
		+ Lots.LaborCostsExpense
		+ Lots.ItemizedFixedCostsExcludingVATExpense
		+ Lots.ItemizedVariableCostsExcludingVATExpense
	WHEN &amp;ReportData = 3 THEN
		Lots.CostManExpense
		+ Lots.OffBalanceCostExpense
		+ Lots.LaborCostsManExpense
		+ Lots.ItemizedFixedCostsManagExpense
		+ Lots.ItemizedVariableCostsManagExpense
	WHEN &amp;ReportData = 4 THEN
		Lots.LocalCostExpense
		+ Lots.OffBalanceCostLocalExpense
		+ Lots.LaborCostsLocalExpense
		+ Lots.ItemizedFixedCostsComplExpense
		+ Lots.ItemizedVariableCostsComplExpense
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.CostExcludingVATExpense
			+ Lots.OffBalanceCostExpense
			+ Lots.LaborCostsExpense
			+ Lots.ItemizedFixedCostsExcludingVATExpense
			+ Lots.ItemizedVariableCostsExcludingVATExpense
		ELSE
			Lots.CostManExpense
			+ Lots.OffBalanceCostExpense
			+ Lots.LaborCostsManExpense
			+ Lots.ItemizedFixedCostsManagExpense
			+ Lots.ItemizedVariableCostsManagExpense
		END
	END AS CostOfAdmissionExpense,
	
	0 AS VATLocalOpeningBalance,
	0 AS VATLocalClosingBalance,
	0 AS VATLocalReceipt,
	0 AS VATLocalExpense,
	
	//AddExpensesForGoodsOpeningBalance
	CASE WHEN &amp;BeginOfPeriod &lt; &amp;DateOfMigrationToBatchAccounting22 THEN 0
	WHEN &amp;ReportData = 1 THEN
		Lots.AddExpensesForGoodsOpeningBalance
	WHEN &amp;ReportData = 2 THEN
		Lots.AdditionalExpensesExcludingVATOpeningBalance
	WHEN &amp;ReportData = 3 THEN
		Lots.AddExpensesManOpeningBalance
	WHEN &amp;ReportData = 4 THEN
		Lots.AddExpensesLocalOpeningBalance
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.AdditionalExpensesExcludingVATOpeningBalance
		ELSE
			Lots.AddExpensesManOpeningBalance
		END
	END AS AddExpensesForGoodsOpeningBalance,
	
	//AddExpensesForGoodsClosingBalance
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.AddExpensesForGoodsClosingBalance
	WHEN &amp;ReportData = 2 THEN
		Lots.AdditionalExpensesExcludingVATClosingBalance
	WHEN &amp;ReportData = 3 THEN
		Lots.AddExpensesManClosingBalance
	WHEN &amp;ReportData = 4 THEN
		Lots.AddExpensesLocalClosingBalance
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.AdditionalExpensesExcludingVATClosingBalance
		ELSE
			Lots.AddExpensesManClosingBalance
		END
	END AS AddExpensesForGoodsClosingBalance,
	
	//AddExpensesForGoodsReceipt
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.AddExpensesForGoodsReceipt
	WHEN &amp;ReportData = 2 THEN
		Lots.AdditionalExpensesExcludingVATReceipt
	WHEN &amp;ReportData = 3 THEN
		Lots.AddExpensesManReceipt
	WHEN &amp;ReportData = 4 THEN
		Lots.AddExpensesLocalReceipt
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.AdditionalExpensesExcludingVATReceipt
		ELSE
			Lots.AddExpensesManReceipt
		END
	END AS AddExpensesForGoodsReceipt,
	
	//AddExpensesForGoodsExpense
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.AddExpensesForGoodsExpense
	WHEN &amp;ReportData = 2 THEN
		Lots.AdditionalExpensesExcludingVATExpense
	WHEN &amp;ReportData = 3 THEN
		Lots.AddExpensesManExpense
	WHEN &amp;ReportData = 4 THEN
		Lots.AddExpensesLocalExpense
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.AdditionalExpensesExcludingVATExpense
		ELSE
			Lots.AddExpensesManExpense
		END
	END AS AddExpensesForGoodsExpense,
	
	//Cost_OpeningBalance
	CASE WHEN &amp;BeginOfPeriod &lt; &amp;DateOfMigrationToBatchAccounting22 THEN 0
	WHEN &amp;ReportData = 1 THEN
		Lots.CostOpeningBalance
		+ Lots.OffBalanceCostOpeningBalance
		+ Lots.AddExpensesForGoodsOpeningBalance
		+ Lots.LaborCostsOpeningBalance
		+ Lots.ItemizedFixedCostsIncludingVATOpeningBalance
		+ Lots.ItemizedVariableCostsIncludingVATOpeningBalance
	WHEN &amp;ReportData = 2 THEN
		Lots.CostExcludingVATOpeningBalance
		+ Lots.OffBalanceCostOpeningBalance
		+ Lots.AdditionalExpensesExcludingVATOpeningBalance
		+ Lots.LaborCostsOpeningBalance
		+ Lots.ItemizedFixedCostsExcludingVATOpeningBalance
		+ Lots.ItemizedVariableCostsExcludingVATOpeningBalance
	WHEN &amp;ReportData = 3 THEN
		Lots.CostManOpeningBalance
		+ Lots.OffBalanceCostOpeningBalance
		+ Lots.AddExpensesManOpeningBalance
		+ Lots.LaborCostsManOpeningBalance
		+ Lots.ItemizedFixedCostsManagOpeningBalance
		+ Lots.ItemizedVariableCostsManagOpeningBalance
	WHEN &amp;ReportData = 4 THEN
		Lots.LocalCostOpeningBalance
		+ Lots.OffBalanceCostLocalOpeningBalance
		+ Lots.AddExpensesLocalOpeningBalance
		+ Lots.LaborCostsLocalOpeningBalance
		+ Lots.ItemizedFixedCostsComplOpeningBalance
		+ Lots.ItemizedVariableCostsComplOpeningBalance
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.CostExcludingVATOpeningBalance
			+ Lots.OffBalanceCostOpeningBalance
			+ Lots.AdditionalExpensesExcludingVATOpeningBalance
			+ Lots.LaborCostsOpeningBalance
			+ Lots.ItemizedFixedCostsExcludingVATOpeningBalance
			+ Lots.ItemizedVariableCostsExcludingVATOpeningBalance
		ELSE
			Lots.CostManOpeningBalance
			+ Lots.OffBalanceCostOpeningBalance
			+ Lots.AddExpensesManOpeningBalance
			+ Lots.LaborCostsManOpeningBalance
			+ Lots.ItemizedFixedCostsManagOpeningBalance
			+ Lots.ItemizedVariableCostsManagOpeningBalance
		END
	END AS Cost_OpeningBalance,
	
	//Cost_ClosingBalance
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.CostClosingBalance
		+ Lots.OffBalanceCostClosingBalance
		+ Lots.AddExpensesForGoodsClosingBalance
		+ Lots.LaborCostsClosingBalance
		+ Lots.ItemizedFixedCostsIncludingVATClosingBalance
		+ Lots.ItemizedVariableCostsIncludingVATClosingBalance
	WHEN &amp;ReportData = 2 THEN
		Lots.CostExcludingVATClosingBalance
		+ Lots.OffBalanceCostClosingBalance
		+ Lots.AdditionalExpensesExcludingVATClosingBalance
		+ Lots.LaborCostsClosingBalance
		+ Lots.ItemizedFixedCostsExcludingVATClosingBalance
		+ Lots.ItemizedVariableCostsExcludingVATClosingBalance
	WHEN &amp;ReportData = 3 THEN
		Lots.CostManClosingBalance
		+ Lots.OffBalanceCostClosingBalance
		+ Lots.AddExpensesManClosingBalance
		+ Lots.LaborCostsManClosingBalance
		+ Lots.ItemizedFixedCostsManagClosingBalance
		+ Lots.ItemizedVariableCostsManagClosingBalance
	WHEN &amp;ReportData = 4 THEN
		Lots.LocalCostClosingBalance
		+ Lots.OffBalanceCostLocalClosingBalance
		+ Lots.AddExpensesLocalClosingBalance
		+ Lots.LaborCostsLocalClosingBalance
		+ Lots.ItemizedFixedCostsComplClosingBalance
		+ Lots.ItemizedVariableCostsComplClosingBalance
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.CostExcludingVATClosingBalance
			+ Lots.OffBalanceCostClosingBalance
			+ Lots.AdditionalExpensesExcludingVATClosingBalance
			+ Lots.LaborCostsClosingBalance
			+ Lots.ItemizedFixedCostsExcludingVATClosingBalance
			+ Lots.ItemizedVariableCostsExcludingVATClosingBalance
		ELSE
			Lots.CostManClosingBalance
			+ Lots.OffBalanceCostClosingBalance
			+ Lots.AddExpensesManClosingBalance
			+ Lots.LaborCostsManClosingBalance
			+ Lots.ItemizedFixedCostsManagClosingBalance
			+ Lots.ItemizedVariableCostsManagClosingBalance
		END
	END AS Cost_ClosingBalance,
	
	//Cost_Receipt
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.CostReceipt
		+ Lots.OffBalanceCostReceipt
		+ Lots.AddExpensesForGoodsReceipt
		+ Lots.LaborCostsReceipt
		+ Lots.ItemizedFixedCostsIncludingVATReceipt
		+ Lots.ItemizedVariableCostsIncludingVATReceipt
	WHEN &amp;ReportData = 2 THEN
		Lots.CostExcludingVATReceipt
		+ Lots.OffBalanceCostReceipt
		+ Lots.AdditionalExpensesExcludingVATReceipt
		+ Lots.LaborCostsReceipt
		+ Lots.ItemizedFixedCostsExcludingVATReceipt
		+ Lots.ItemizedVariableCostsExcludingVATReceipt
	WHEN &amp;ReportData = 3 THEN
		Lots.CostManReceipt
		+ Lots.OffBalanceCostReceipt
		+ Lots.AddExpensesManReceipt
		+ Lots.LaborCostsManReceipt
		+ Lots.ItemizedFixedCostsManagReceipt
		+ Lots.ItemizedVariableCostsManagReceipt
	WHEN &amp;ReportData = 4 THEN
		Lots.LocalCostReceipt
		+ Lots.OffBalanceCostLocalReceipt
		+ Lots.AddExpensesLocalReceipt
		+ Lots.LaborCostsLocalReceipt
		+ Lots.ItemizedFixedCostsComplReceipt
		+ Lots.ItemizedVariableCostsComplReceipt
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.CostExcludingVATReceipt
			+ Lots.OffBalanceCostReceipt
			+ Lots.AdditionalExpensesExcludingVATReceipt
			+ Lots.LaborCostsReceipt
			+ Lots.ItemizedFixedCostsExcludingVATReceipt
			+ Lots.ItemizedVariableCostsExcludingVATReceipt
		ELSE
			Lots.CostManReceipt
			+ Lots.OffBalanceCostReceipt
			+ Lots.AddExpensesManReceipt
			+ Lots.LaborCostsManReceipt
			+ Lots.ItemizedFixedCostsManagReceipt
			+ Lots.ItemizedVariableCostsManagReceipt
		END
	END AS Cost_Receipt,
	
	//Cost_Expense
	CASE WHEN &amp;ReportData = 1 THEN
		Lots.CostExpense
		+ Lots.OffBalanceCostExpense
		+ Lots.AddExpensesForGoodsExpense
		+ Lots.LaborCostsExpense
		+ Lots.ItemizedFixedCostsIncludingVATExpense
		+ Lots.ItemizedVariableCostsIncludingVATExpense
	WHEN &amp;ReportData = 2 THEN
		Lots.CostExcludingVATExpense
		+ Lots.OffBalanceCostExpense
		+ Lots.AdditionalExpensesExcludingVATExpense
		+ Lots.LaborCostsExpense
		+ Lots.ItemizedFixedCostsExcludingVATExpense
		+ Lots.ItemizedVariableCostsExcludingVATExpense
	WHEN &amp;ReportData = 3 THEN
		Lots.CostManExpense
		+ Lots.OffBalanceCostExpense
		+ Lots.AddExpensesManExpense
		+ Lots.LaborCostsManExpense
		+ Lots.ItemizedFixedCostsManagExpense
		+ Lots.ItemizedVariableCostsManagExpense
	WHEN &amp;ReportData = 4 THEN
		Lots.LocalCostExpense
		+ Lots.OffBalanceCostLocalExpense
		+ Lots.AddExpensesLocalExpense
		+ Lots.LaborCostsLocalExpense
		+ Lots.ItemizedFixedCostsComplExpense
		+ Lots.ItemizedVariableCostsComplExpense
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			Lots.CostExcludingVATExpense
			+ Lots.OffBalanceCostExpense
			+ Lots.AdditionalExpensesExcludingVATExpense
			+ Lots.LaborCostsExpense
			+ Lots.ItemizedFixedCostsExcludingVATExpense
			+ Lots.ItemizedVariableCostsExcludingVATExpense
		ELSE
			Lots.CostManExpense
			+ Lots.OffBalanceCostExpense
			+ Lots.AddExpensesManExpense
			+ Lots.LaborCostsManExpense
			+ Lots.ItemizedFixedCostsManagExpense
			+ Lots.ItemizedVariableCostsManagExpense
		END
	END AS Cost_Expense,
	
	0 AS Cost_PreliminaryReceipt,
	0 AS Cost_PreliminaryExpense,
	0 AS CostDeviation_Receipt,
	0 AS CostDeviation_Expense
{SELECT
		YearPeriod,
		HalfYearPeriod,
		QuarterPeriod,
		MonthPeriod,
		TenDaysPeriod,
		WeekPeriod,
		DayPeriod,
		Recorder,
		SecondPeriod}
FROM
	AccumulationRegister.InventoryCost.BalanceAndTurnovers({(&amp;BeginOfPeriod22)}, , Auto, , &amp;BulletData) AS Lots
	INNER JOIN Constants AS Constants
		ON (TRUE)
	
{LEFT JOIN
		Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	ON
		Lots.ItemsLocationAttributes = DimensionOfProductItem.Ref}
{WHERE
	(DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN (
		SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}

UNION ALL

SELECT
	&amp;GoodsCostTransfers AS RegisterType,
	BEGINOFPERIOD(Lots.Period, DAY)        AS DayPeriod,
	BEGINOFPERIOD(Lots.Period, WEEK)      AS WeekPeriod,
	BEGINOFPERIOD(Lots.Period, TENDAYS)      AS TenDaysPeriod,
	BEGINOFPERIOD(Lots.Period, MONTH)       AS MonthPeriod,
	BEGINOFPERIOD(Lots.Period, QUARTER)     AS QuarterPeriod,
	BEGINOFPERIOD(Lots.Period, HALFYEAR)   AS HalfYearPeriod,
	BEGINOFPERIOD(Lots.Period, YEAR)         AS YearPeriod,
	Lots.Period                             AS SecondPeriod,
	
	DimensionOfProductItem.Products                                 AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure                AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports               AS UnitForReports,
	DimensionOfProductItem.Products.SKU                         AS ProductsSKU,
	
	DimensionOfProductItem.Characteristic      AS Characteristic,
	DimensionOfProductItem.Series               AS Series,
	DimensionOfProductItem.StorageLocation               AS Warehouse,
	
	Lots.ItemsLocationAttributes         AS ItemsLocationAttributes,
	Lots.Lot                             AS DocumentInflow,
	UNDEFINED                              AS ExpenseItem,
	UNDEFINED                              AS ExpenseReceiptDocument,
	Lots.LotVendorAttributes               AS LotVendorAttributes,
	
	Lots.InventoryOwnerAttribute                         AS InventoryOwnerAttribute,
	ISNULL(Lots.LotVendorAttributes.Vendor, UNDEFINED) AS Vendor,
	ISNULL(Lots.LotVendorAttributes.FinancialAccountingGroup, UNDEFINED)  AS FinancialAccountingGroup,
	
	Lots.Organization AS Organization,
	CASE WHEN Lots.Recorder = UNDEFINED THEN
		NULL
		ELSE Lots.Recorder
	END                                     AS Recorder,
	
	CASE &amp;ReportData
		WHEN 4
			THEN Lots.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	0                                         AS CountOpeningBalance,
	0                                         AS CountClosingBalance,
	
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
			- CASE
				WHEN &amp;QuantityUnits = 0
					THEN Lots.Count
				WHEN &amp;QuantityUnits = 1
					THEN CASE
							WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
								THEN Lots.Count / DimensionOfProductItem.Products.UnitFactorForReports
							ELSE 0
						END
			END
	END AS CountReceipt,
	
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Expense) THEN
			- CASE
				WHEN &amp;QuantityUnits = 0
					THEN Lots.Count
				WHEN &amp;QuantityUnits = 1
					THEN CASE
							WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
								THEN Lots.Count / DimensionOfProductItem.Products.UnitFactorForReports
							ELSE 0
						END
			END
	END AS CountExpense,

	0                                                          AS StartBalanceWeight,
	0                                                          AS ClosingBalanceWeight,
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN -Lots.Count
	END * &amp;QueryTextWeight                                   AS ReceiptWeight,
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN -Lots.Count
	END * &amp;QueryTextWeight                                   AS ConsumptionWeight,
	0                                                          AS StartBalanceVolume,
	0                                                          AS ClosingBalanceVolume,
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN -Lots.Count
	END * &amp;QueryTextVolumeM3                                 AS ReceiptVolume,
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN -Lots.Count
	END * &amp;QueryTextVolumeM3                                 AS ConsumptionVolume,
	
	//CostOfAdmissionOpeningBalance
	0                                                          AS CostOfAdmissionOpeningBalance,
	
	//CostOfAdmissionClosingBalance
	0                                                          AS CostOfAdmissionClosingBalance,
	
	//CostOfAdmissionReceipt
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
			- CASE
				WHEN &amp;ReportData = 1
					THEN Lots.Cost
						+ Lots.OffBalanceCost
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsIncludingVAT
						+ Lots.ItemizedVariableCostsIncludingVAT
				WHEN &amp;ReportData = 2
					THEN Lots.CostExcludingVAT
						+ Lots.OffBalanceCost
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsExcludingVAT
						+ Lots.ItemizedVariableCostsExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.CostMan
						+ Lots.OffBalanceCost
						+ Lots.LaborCostsMan
						+ Lots.ItemizedFixedCostsManag
						+ Lots.ItemizedVariableCostsManag
				WHEN &amp;ReportData = 4
					THEN Lots.LocalCost
						+ Lots.OffBalanceCostLocal
						+ Lots.LaborCostsLocal
						+ Lots.ItemizedFixedCostsCompl
						+ Lots.ItemizedVariableCostsCompl
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.CostExcludingVAT
								+ Lots.OffBalanceCost
								+ Lots.LaborCosts
								+ Lots.ItemizedFixedCostsExcludingVAT
								+ Lots.ItemizedVariableCostsExcludingVAT
						ELSE Lots.CostMan
							+ Lots.OffBalanceCost
							+ Lots.LaborCostsMan
							+ Lots.ItemizedFixedCostsManag
							+ Lots.ItemizedVariableCostsManag
					END
			END
	END AS CostOfAdmissionReceipt,
	
	//CostOfAdmissionExpense
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Expense) THEN
			- CASE
				WHEN &amp;ReportData = 1
					THEN Lots.Cost
						+ Lots.OffBalanceCost
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsIncludingVAT
						+ Lots.ItemizedVariableCostsIncludingVAT
				WHEN &amp;ReportData = 2
					THEN Lots.CostExcludingVAT
						+ Lots.OffBalanceCost
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsExcludingVAT
						+ Lots.ItemizedVariableCostsExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.CostMan
						+ Lots.OffBalanceCost
						+ Lots.LaborCostsMan
						+ Lots.ItemizedFixedCostsManag
						+ Lots.ItemizedVariableCostsManag
				WHEN &amp;ReportData = 4
					THEN Lots.LocalCost
						+ Lots.OffBalanceCostLocal
						+ Lots.LaborCostsLocal
						+ Lots.ItemizedFixedCostsCompl
						+ Lots.ItemizedVariableCostsCompl
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.CostExcludingVAT
								+ Lots.OffBalanceCost
								+ Lots.LaborCosts
								+ Lots.ItemizedFixedCostsExcludingVAT
								+ Lots.ItemizedVariableCostsExcludingVAT
						ELSE Lots.CostMan
							+ Lots.OffBalanceCost
							+ Lots.LaborCostsMan
							+ Lots.ItemizedFixedCostsManag
							+ Lots.ItemizedVariableCostsManag
					END
			END
	END AS CostOfAdmissionExpense,
	
	0                                                          AS VATLocalOpeningBalance,
	0                                                          AS VATLocalClosingBalance,
	0                                                          AS VATLocalReceipt,
	0                                                          AS VATLocalExpense,
	
	//AddExpensesForGoodsOpeningBalance
	0                                                          AS AddExpensesForGoodsOpeningBalance,
	
	//AddExpensesForGoodsClosingBalance
	0                                                          AS AddExpensesForGoodsClosingBalance,
	
	//AddExpensesForGoodsReceipt
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
			- CASE
				WHEN &amp;ReportData = 1
					THEN Lots.AddExpensesForGoods
				WHEN &amp;ReportData = 2
					THEN Lots.AdditionalExpensesExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.AddExpensesMan
				WHEN &amp;ReportData = 4
					THEN Lots.AddExpensesLocal
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.AdditionalExpensesExcludingVAT
						ELSE Lots.AddExpensesMan
					END
			END
	END AS AddExpensesForGoodsReceipt,
	
	//AddExpensesForGoodsExpense
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Expense) THEN
			- CASE
				WHEN &amp;ReportData = 1
					THEN Lots.AddExpensesForGoods
				WHEN &amp;ReportData = 2
					THEN Lots.AdditionalExpensesExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.AddExpensesMan
				WHEN &amp;ReportData = 4
					THEN Lots.AddExpensesLocal
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.AdditionalExpensesExcludingVAT
						ELSE Lots.AddExpensesMan
					END
			END
	END AS AddExpensesForGoodsExpense,
	
	//Cost_OpeningBalance
	0                                                          AS Cost_OpeningBalance,
	
	//Cost_ClosingBalance
	0                                                          AS Cost_ClosingBalance,
	
	//Cost_Receipt
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
			- CASE
				WHEN &amp;ReportData = 1
					THEN Lots.Cost
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesForGoods
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsIncludingVAT
						+ Lots.ItemizedVariableCostsIncludingVAT
				WHEN &amp;ReportData = 2
					THEN Lots.CostExcludingVAT
						+ Lots.OffBalanceCost
						+ Lots.AdditionalExpensesExcludingVAT
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsExcludingVAT
						+ Lots.ItemizedVariableCostsExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.CostMan
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesMan
						+ Lots.LaborCostsMan
						+ Lots.ItemizedFixedCostsManag
						+ Lots.ItemizedVariableCostsManag
				WHEN &amp;ReportData = 4
					THEN Lots.LocalCost
						+ Lots.OffBalanceCostLocal
						+ Lots.AddExpensesLocal
						+ Lots.LaborCostsLocal
						+ Lots.ItemizedFixedCostsCompl
						+ Lots.ItemizedVariableCostsCompl
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.CostExcludingVAT
								+ Lots.OffBalanceCost
								+ Lots.AdditionalExpensesExcludingVAT
								+ Lots.LaborCosts
								+ Lots.ItemizedFixedCostsExcludingVAT
								+ Lots.ItemizedVariableCostsExcludingVAT
						ELSE Lots.CostMan
							+ Lots.OffBalanceCost
							+ Lots.AddExpensesMan
							+ Lots.LaborCostsMan
							+ Lots.ItemizedFixedCostsManag
							+ Lots.ItemizedVariableCostsManag
					END
			END
	END AS Cost_Receipt,
	
	//Cost_Expense
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Expense) THEN
			- CASE
				WHEN &amp;ReportData = 1
					THEN Lots.Cost
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesForGoods
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsIncludingVAT
						+ Lots.ItemizedVariableCostsIncludingVAT
				WHEN &amp;ReportData = 2
					THEN Lots.CostExcludingVAT
						+ Lots.OffBalanceCost
						+ Lots.AdditionalExpensesExcludingVAT
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsExcludingVAT
						+ Lots.ItemizedVariableCostsExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.CostMan
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesMan
						+ Lots.LaborCostsMan
						+ Lots.ItemizedFixedCostsManag
						+ Lots.ItemizedVariableCostsManag
				WHEN &amp;ReportData = 4
					THEN Lots.LocalCost
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesLocal
						+ Lots.LaborCostsLocal
						+ Lots.ItemizedFixedCostsCompl
						+ Lots.ItemizedVariableCostsCompl
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.CostExcludingVAT
								+ Lots.OffBalanceCost
								+ Lots.AdditionalExpensesExcludingVAT
								+ Lots.LaborCosts
								+ Lots.ItemizedFixedCostsExcludingVAT
								+ Lots.ItemizedVariableCostsExcludingVAT
						ELSE Lots.CostMan
							+ Lots.OffBalanceCost
							+ Lots.AddExpensesMan
							+ Lots.LaborCostsMan
							+ Lots.ItemizedFixedCostsManag
							+ Lots.ItemizedVariableCostsManag
					END
			END
	END AS Cost_Expense,
	
	0 AS Cost_PreliminaryReceipt,
	0 AS Cost_PreliminaryExpense,
	0 AS CostDeviation_Receipt,
	0 AS CostDeviation_Expense
FROM
	AccumulationRegister.InventoryCost AS Lots
	INNER JOIN Constants AS Constants
		ON (TRUE)
	
{LEFT JOIN
		Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	ON
		Lots.ItemsLocationAttributes = DimensionOfProductItem.Ref}
		
WHERE
	&amp;ExcludeBusinessTransactions = TRUE
	AND &amp;BulletData
	AND (Lots.Period BETWEEN &amp;BeginOfPeriod22 AND &amp;EndOfPeriod
		OR &amp;EndOfPeriod = DATETIME(1,1,1) AND Lots.Period &gt;= &amp;BeginOfPeriod22)
	AND Lots.BusinessOperation IN (&amp;ExcludedBusinessTransactions)
{WHERE
	(DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN (
		SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			
UNION ALL

SELECT
	&amp;CostOfGoodsDeviation AS RegisterType,
	BEGINOFPERIOD(Lots.Period, DAY)        AS DayPeriod,
	BEGINOFPERIOD(Lots.Period, WEEK)      AS WeekPeriod,
	BEGINOFPERIOD(Lots.Period, TENDAYS)      AS TenDaysPeriod,
	BEGINOFPERIOD(Lots.Period, MONTH)       AS MonthPeriod,
	BEGINOFPERIOD(Lots.Period, QUARTER)     AS QuarterPeriod,
	BEGINOFPERIOD(Lots.Period, HALFYEAR)   AS HalfYearPeriod,
	BEGINOFPERIOD(Lots.Period, YEAR)         AS YearPeriod,
	Lots.Period                             AS SecondPeriod,
	
	DimensionOfProductItem.Products                                 AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure                AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports               AS UnitForReports,
	DimensionOfProductItem.Products.SKU                         AS ProductsSKU,
	
	DimensionOfProductItem.Characteristic      AS Characteristic,
	DimensionOfProductItem.Series               AS Series,
	DimensionOfProductItem.StorageLocation               AS Warehouse,
	
	Lots.ItemsLocationAttributes         AS ItemsLocationAttributes,
	Lots.Lot                             AS DocumentInflow,
	UNDEFINED                              AS ExpenseItem,
	UNDEFINED                              AS ExpenseReceiptDocument,
	Lots.LotVendorAttributes               AS LotVendorAttributes,
	
	Lots.InventoryOwnerAttribute                         AS InventoryOwnerAttribute,
	ISNULL(Lots.LotVendorAttributes.Vendor, UNDEFINED) AS Vendor,
	ISNULL(Lots.LotVendorAttributes.FinancialAccountingGroup, UNDEFINED)  AS FinancialAccountingGroup,
	
	Lots.Organization AS Organization,
	CASE WHEN Lots.Recorder = UNDEFINED THEN
		NULL
		ELSE Lots.Recorder
	END                                     AS Recorder,
	
	CASE &amp;ReportData
		WHEN 4
			THEN Lots.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	0 AS CountOpeningBalance,
	0 AS CountClosingBalance,
	0 AS CountReceipt,
	0 AS CountExpense,

	0 AS StartBalanceWeight,
	0 AS ClosingBalanceWeight,
	0 AS ReceiptWeight,
	0 AS ConsumptionWeight,
	0 AS StartBalanceVolume,
	0 AS ClosingBalanceVolume,
	0 AS ReceiptVolume,
	0 AS ConsumptionVolume,
	
	0 AS CostOfAdmissionOpeningBalance,
	0 AS CostOfAdmissionClosingBalance,
	0 AS CostOfAdmissionReceipt,
	0 AS CostOfAdmissionExpense,
	
	0 AS VATLocalOpeningBalance,
	0 AS VATLocalClosingBalance,
	0 AS VATLocalReceipt,
	0 AS VATLocalExpense,
	
	0 AS AddExpensesForGoodsOpeningBalance,
	0 AS AddExpensesForGoodsClosingBalance,
	0 AS AddExpensesForGoodsReceipt,
	0 AS AddExpensesForGoodsExpense,
	
	0 AS Cost_OpeningBalance,
	0 AS Cost_ClosingBalance,
	0 AS Cost_Receipt,
	0 AS Cost_Expense,
	
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Receipt)
		 AND Lots.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing) THEN
			CASE
				WHEN &amp;ReportData = 1
					THEN Lots.Cost
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesForGoods
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsIncludingVAT
						+ Lots.ItemizedVariableCostsIncludingVAT
				WHEN &amp;ReportData = 2
					THEN Lots.CostExcludingVAT
						+ Lots.OffBalanceCost
						+ Lots.AdditionalExpensesExcludingVAT
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsExcludingVAT
						+ Lots.ItemizedVariableCostsExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.CostMan
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesMan
						+ Lots.LaborCostsMan
						+ Lots.ItemizedFixedCostsManag
						+ Lots.ItemizedVariableCostsManag
				WHEN &amp;ReportData = 4
					THEN Lots.LocalCost
						+ Lots.OffBalanceCostLocal
						+ Lots.AddExpensesLocal
						+ Lots.LaborCostsLocal
						+ Lots.ItemizedFixedCostsCompl
						+ Lots.ItemizedVariableCostsCompl
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.CostExcludingVAT
								+ Lots.OffBalanceCost
								+ Lots.AdditionalExpensesExcludingVAT
								+ Lots.LaborCosts
								+ Lots.ItemizedFixedCostsExcludingVAT
								+ Lots.ItemizedVariableCostsExcludingVAT
						ELSE Lots.CostMan
							+ Lots.OffBalanceCost
							+ Lots.AddExpensesMan
							+ Lots.LaborCostsMan
							+ Lots.ItemizedFixedCostsManag
							+ Lots.ItemizedVariableCostsManag
					END
			END
	END AS Cost_PreliminaryReceipt,
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Expense)
		 AND Lots.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.PreliminaryClosing) THEN
			CASE
				WHEN &amp;ReportData = 1
					THEN Lots.Cost
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesForGoods
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsIncludingVAT
						+ Lots.ItemizedVariableCostsIncludingVAT
				WHEN &amp;ReportData = 2
					THEN Lots.CostExcludingVAT
						+ Lots.OffBalanceCost
						+ Lots.AdditionalExpensesExcludingVAT
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsExcludingVAT
						+ Lots.ItemizedVariableCostsExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.CostMan
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesMan
						+ Lots.LaborCostsMan
						+ Lots.ItemizedFixedCostsManag
						+ Lots.ItemizedVariableCostsManag
				WHEN &amp;ReportData = 4
					THEN Lots.LocalCost
						+ Lots.OffBalanceCostLocal
						+ Lots.AddExpensesLocal
						+ Lots.LaborCostsLocal
						+ Lots.ItemizedFixedCostsCompl
						+ Lots.ItemizedVariableCostsCompl
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.CostExcludingVAT
								+ Lots.OffBalanceCost
								+ Lots.AdditionalExpensesExcludingVAT
								+ Lots.LaborCosts
								+ Lots.ItemizedFixedCostsExcludingVAT
								+ Lots.ItemizedVariableCostsExcludingVAT
						ELSE Lots.CostMan
							+ Lots.OffBalanceCost
							+ Lots.AddExpensesMan
							+ Lots.LaborCostsMan
							+ Lots.ItemizedFixedCostsManag
							+ Lots.ItemizedVariableCostsManag
					END
			END
	END AS Cost_PreliminaryExpense,
	
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Receipt)
		 AND Lots.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.FinalClosing) THEN
			CASE
				WHEN &amp;ReportData = 1
					THEN Lots.Cost
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesForGoods
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsIncludingVAT
						+ Lots.ItemizedVariableCostsIncludingVAT
				WHEN &amp;ReportData = 2
					THEN Lots.CostExcludingVAT
						+ Lots.OffBalanceCost
						+ Lots.AdditionalExpensesExcludingVAT
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsExcludingVAT
						+ Lots.ItemizedVariableCostsExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.CostMan
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesMan
						+ Lots.LaborCostsMan
						+ Lots.ItemizedFixedCostsManag
						+ Lots.ItemizedVariableCostsManag
				WHEN &amp;ReportData = 4
					THEN Lots.LocalCost
						+ Lots.OffBalanceCostLocal
						+ Lots.AddExpensesLocal
						+ Lots.LaborCostsLocal
						+ Lots.ItemizedFixedCostsCompl
						+ Lots.ItemizedVariableCostsCompl
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.CostExcludingVAT
								+ Lots.OffBalanceCost
								+ Lots.AdditionalExpensesExcludingVAT
								+ Lots.LaborCosts
								+ Lots.ItemizedFixedCostsExcludingVAT
								+ Lots.ItemizedVariableCostsExcludingVAT
						ELSE Lots.CostMan
							+ Lots.OffBalanceCost
							+ Lots.AddExpensesMan
							+ Lots.LaborCostsMan
							+ Lots.ItemizedFixedCostsManag
							+ Lots.ItemizedVariableCostsManag
					END
			END
	END AS CostDeviation_Receipt,
	CASE
		WHEN Lots.RecordType = VALUE(AccumulationRecordType.Expense)
		 AND Lots.MonthEndClosingMode = VALUE(Enum.MonthEndClosingModes.FinalClosing) THEN
			CASE
				WHEN &amp;ReportData = 1
					THEN Lots.Cost
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesForGoods
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsIncludingVAT
						+ Lots.ItemizedVariableCostsIncludingVAT
				WHEN &amp;ReportData = 2
					THEN Lots.CostExcludingVAT
						+ Lots.OffBalanceCost
						+ Lots.AdditionalExpensesExcludingVAT
						+ Lots.LaborCosts
						+ Lots.ItemizedFixedCostsExcludingVAT
						+ Lots.ItemizedVariableCostsExcludingVAT
				WHEN &amp;ReportData = 3
					THEN Lots.CostMan
						+ Lots.OffBalanceCost
						+ Lots.AddExpensesMan
						+ Lots.LaborCostsMan
						+ Lots.ItemizedFixedCostsManag
						+ Lots.ItemizedVariableCostsManag
				WHEN &amp;ReportData = 4
					THEN Lots.LocalCost
						+ Lots.OffBalanceCostLocal
						+ Lots.AddExpensesLocal
						+ Lots.LaborCostsLocal
						+ Lots.ItemizedFixedCostsCompl
						+ Lots.ItemizedVariableCostsCompl
				ELSE CASE
						WHEN &amp;ByEnterprise
							THEN Lots.CostExcludingVAT
								+ Lots.OffBalanceCost
								+ Lots.AdditionalExpensesExcludingVAT
								+ Lots.LaborCosts
								+ Lots.ItemizedFixedCostsExcludingVAT
								+ Lots.ItemizedVariableCostsExcludingVAT
						ELSE Lots.CostMan
							+ Lots.OffBalanceCost
							+ Lots.AddExpensesMan
							+ Lots.LaborCostsMan
							+ Lots.ItemizedFixedCostsManag
							+ Lots.ItemizedVariableCostsManag
					END
			END
	END AS CostDeviation_Expense
FROM
	AccumulationRegister.InventoryCost AS Lots
	
{LEFT JOIN
		Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
	ON
		Lots.ItemsLocationAttributes = DimensionOfProductItem.Ref}
		
WHERE
	&amp;BulletData
	AND (Lots.Period BETWEEN &amp;BeginOfPeriod22 AND &amp;EndOfPeriod
		OR &amp;EndOfPeriod = DATETIME(1,1,1) AND Lots.Period &gt;= &amp;BeginOfPeriod22)
	AND Lots.CalculationOfCost
	AND NOT (&amp;ExcludeBusinessTransactions
		AND Lots.BusinessOperation IN (&amp;ExcludedBusinessTransactions))
{WHERE
	(DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN (
		SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}</query>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        Products.UnitOfMeasure
    When &amp;QuantityUnits = 1 Then
        Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit of measure</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد اندازه‌گیری</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità di misura</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednosta miary</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица измерения</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ölçü birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị tính</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        StorageUnit
    When &amp;QuantityUnits = 1 Then
        UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
