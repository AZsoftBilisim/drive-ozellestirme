	<calculatedField>
		<dataPath>Cost.NetBookValue</dataPath>
		<expression>Case
	When ServiceLife = 0
		Then Cost.Cost
	When NumberOfMonthsOfUse &gt; ServiceLife
		Then 0
	Else Cost.Cost - Cost.Cost * NumberOfMonthsOfUse / ServiceLife
End</expression>
		<title xsi:type="v8:LocalStringType">
