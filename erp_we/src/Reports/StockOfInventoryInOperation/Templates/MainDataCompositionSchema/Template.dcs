		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	InventoryInOperation.Organization AS Organization,
	InventoryInOperation.Organization.ParentCompany AS ParentCompany,
	InventoryInOperation.Department AS Department,
	InventoryInOperation.Individual AS Individual,
	InventoryInOperation.Products AS Products,
	InventoryInOperation.Characteristic AS Characteristic,
	InventoryInOperation.Series AS Series,
	InventoryInOperation.Lot AS Lot,
	InventoryInOperation.AssetID AS AssetID,
	InventoryInOperation.CCDNumber AS CCDNumber,
	InventoryInOperation.LineOfBusiness AS LineOfBusiness,
	InventoryInOperation.Lot.FixedAsset AS FixedAsset,
	ISNULL(InventoryInOperation.Lot.StartDateOfOperation, DATETIME(1, 1, 1)) AS OperationStart,
	ISNULL(InventoryInOperation.Lot.CompletionDate_, DATETIME(1, 1, 1)) AS EndOfOperation,
	ISNULL(InventoryInOperation.Lot.ServiceLife, 0) AS ServiceLife,
	ISNULL(CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE InventoryInOperation.Characteristic.ItemsCharacteristicForPricing
	END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	ISNULL(CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		ELSE InventoryInOperation.Series.ItemsBatchForPricing
	END, VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)) AS PricingBatch,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS PricingPackage,
	CASE
		WHEN &amp;ValuationCurrency = "ComplCurrency"
			THEN InventoryInOperation.Organization.LocalAccountingCurrency
		ELSE &amp;CurrencyOfMan
	END AS CurrencyOfValue,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN InventoryInOperation.CountBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN InventoryInOperation.Products.UnitFactorForReports &lt;&gt; 0
					THEN InventoryInOperation.CountBalance / InventoryInOperation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS Count,
	InventoryInOperation.QuantityByGBRNBalance AS QuantityByGBRN,
	InventoryInOperation.CountBalance * &amp;QueryTextItemWeight AS QuantityWeight,
	InventoryInOperation.CountBalance * &amp;QueryTextTheVolumeOfTheItem AS QuantityVolume
INTO InventoryInOperation
FROM
	AccumulationRegister.InventoryInOperation.Balance(&amp;DateOfRemainingGoods {(&amp;DateOfRemainingGoods)},) AS InventoryInOperation
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON (ItemKinds.Ref = InventoryInOperation.Products.ProductKind)

INDEX BY
	Products,
	Characteristic,
	Series,
	AssetID,
	Lot
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Cost_Inventory.Organization AS Organization,
	Cost_Inventory.Products AS Products,
	Cost_Inventory.Characteristic AS Characteristic,
	Cost_Inventory.Series AS Series,
	Cost_Inventory.AssetID AS AssetID,
	Cost_Inventory.Lot AS Lot,
	CASE
		WHEN SUM(Cost_Inventory.Count) &lt;&gt; 0
			THEN SUM(Cost_Inventory.LocalCost) / SUM(Cost_Inventory.Count)
		ELSE 0
	END AS LocalPrice,
	CASE
		WHEN SUM(Cost_Inventory.Count) &lt;&gt; 0
			THEN SUM(Cost_Inventory.CostMan) / SUM(Cost_Inventory.Count)
		ELSE 0
	END AS ManSPrice
INTO Cost_Inventory
FROM
	InformationRegister.CostOfInventoryInOperation AS Cost_Inventory
WHERE
	Cost_Inventory.Active
	AND (Cost_Inventory.Organization, Cost_Inventory.Products, Cost_Inventory.Characteristic, Cost_Inventory.Series,
		Cost_Inventory.AssetID, Cost_Inventory.Lot) IN
		(SELECT
			InventoryInOperation.Organization,
			InventoryInOperation.Products,
			InventoryInOperation.Characteristic,
			InventoryInOperation.Series,
			InventoryInOperation.AssetID,
			InventoryInOperation.Lot
		FROM
			InventoryInOperation AS InventoryInOperation)
			
GROUP BY
	Cost_Inventory.Organization,
	Cost_Inventory.Products,
	Cost_Inventory.Characteristic,
	Cost_Inventory.Series,
	Cost_Inventory.AssetID,
	Cost_Inventory.Lot
	
INDEX BY
	Products,
	Characteristic,
	Series,
	AssetID,
	Lot	
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Products AS Products,
	ItemsPrices.Characteristic AS Characteristic,
	ItemsPrices.Currency AS Currency,
	CASE
		WHEN &amp;TextOfRequestIsPackingCoefficientOfProductPrice &lt;&gt; 0
			THEN ItemsPrices.Price / ISNULL(&amp;TextOfRequestIsPackingCoefficientOfProductPrice, 1)
		ELSE ItemsPrices.Price
	END AS Price
INTO ItemsPrices
FROM
	InformationRegister.ItemsPrices.SliceLast(
		{(&amp;EndOfPeriod)}, 
		PriceKind = &amp;PriceKind
			AND (Products, Characteristic) IN
				(SELECT
					InventoryInOperation.Products,
					InventoryInOperation.Characteristic
				FROM
					InventoryInOperation AS InventoryInOperation)) AS ItemsPrices
WHERE
	NOT &amp;UsePriceManagementSystem25

UNION ALL

SELECT DISTINCT
	ItemsPrices.PriceKind,
	ItemsPrices.Products,
	InventoryInOperation.Characteristic,
	ItemsPrices.Currency,
	CASE
		WHEN &amp;TextOfRequestIsPackingCoefficientOfProductPrice &lt;&gt; 0
			THEN ItemsPrices.Price / ISNULL(&amp;TextOfRequestIsPackingCoefficientOfProductPrice, 1)
		ELSE ItemsPrices.Price
	END
FROM
	InformationRegister.ItemsPrices25.SliceLast(
		{(&amp;EndOfPeriod)}, 
		PriceKind = &amp;PriceKind
			AND (Products, PricingVariant, PricingBatch, PricingPackage) IN
				(SELECT
					InventoryInOperation.Products,
					InventoryInOperation.PricingVariant,
					InventoryInOperation.PricingBatch,
					InventoryInOperation.PricingPackage
				FROM
					InventoryInOperation AS InventoryInOperation)) AS ItemsPrices
					
		LEFT JOIN InventoryInOperation AS InventoryInOperation
		ON ItemsPrices.Products = InventoryInOperation.Products
			AND ItemsPrices.PricingVariant = InventoryInOperation.PricingVariant
			AND ItemsPrices.PricingBatch = InventoryInOperation.PricingBatch
			AND ItemsPrices.PricingPackage = InventoryInOperation.PricingPackage
WHERE
	&amp;UsePriceManagementSystem25

INDEX BY
	Products,
	Characteristic,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ExchangeRates.Currency AS Currency,
	ExchangeRates.CourseNumerator AS CourseNumerator,
	ExchangeRates.CourseDenominator AS CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)}, BaseCurrency = &amp;BaseCurrency) AS
		ExchangeRates
WHERE
	ExchangeRates.CourseNumerator &lt;&gt; 0
	AND ExchangeRates.CourseDenominator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	InventoryInOperation.Organization AS Organization,
	InventoryInOperation.Department AS Department,
	InventoryInOperation.Individual AS Individual,
	InventoryInOperation.Products AS Products,
	InventoryInOperation.Characteristic AS Characteristic,
	InventoryInOperation.Series AS Series,
	InventoryInOperation.Lot AS Lot,
	InventoryInOperation.AssetID AS AssetID,
	InventoryInOperation.CCDNumber AS CCDNumber,
	InventoryInOperation.LineOfBusiness AS LineOfBusiness,
	InventoryInOperation.FixedAsset AS FixedAsset,
	InventoryInOperation.OperationStart AS OperationStart,
	InventoryInOperation.EndOfOperation AS EndOfOperation,
	InventoryInOperation.ServiceLife AS ServiceLife,
	InventoryInOperation.Products.UnitOfMeasure AS StorageUnit,
	InventoryInOperation.Products.UnitForReports AS UnitForReports,
	CASE
		WHEN InventoryInOperation.OperationStart = DATETIME(1, 1, 1)
			THEN 0
		WHEN &amp;DateOfRemainingGoods &lt;&gt; DATETIME(1, 1, 1)
			THEN DATEDIFF(InventoryInOperation.OperationStart, &amp;DateOfRemainingGoods, MONTH) - 1
		WHEN &amp;CurrentDate &lt;&gt; DATETIME(1, 1, 1)
			THEN DATEDIFF(InventoryInOperation.OperationStart, &amp;CurrentDate, MONTH)
		ELSE 0
	END AS NumberOfMonthsOfUse,
	InventoryInOperation.Count AS Count,
	InventoryInOperation.QuantityByGBRN AS QuantityByGBRN,
	InventoryInOperation.QuantityWeight AS QuantityWeight,
	InventoryInOperation.QuantityVolume AS QuantityVolume,
	CASE
		WHEN &amp;InventoryAssessment = "ByPriceType"
			THEN InventoryInOperation.Count * ISNULL(ItemsPrices.Price, 0) * CASE
				WHEN ISNULL(ExchangeRatesOfValue.CourseNumerator, 0) &lt;&gt; 0
				AND ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 0) &lt;&gt; 0
					THEN ISNULL(ExchangeRatesOfPriceType.CourseNumerator, 0) * ISNULL(ExchangeRatesOfValue.CourseDenominator, 0) /
						(ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 1) * ISNULL(ExchangeRatesOfValue.CourseNumerator, 0))
				ELSE 1
			END
		ELSE CASE
			WHEN &amp;ValuationCurrency = "ComplCurrency"
				THEN InventoryInOperation.Count * ISNULL(Cost_Inventory.LocalPrice, 0)
			ELSE InventoryInOperation.Count * ISNULL(Cost_Inventory.ManSPrice, 0)
		END
	END AS Cost
FROM
	InventoryInOperation AS InventoryInOperation
	
		LEFT JOIN Cost_Inventory AS Cost_Inventory
		ON (Cost_Inventory.Organization = InventoryInOperation.Organization)
			AND (Cost_Inventory.Products = InventoryInOperation.Products)
			AND (Cost_Inventory.Characteristic = InventoryInOperation.Characteristic)
			AND (Cost_Inventory.Series = InventoryInOperation.Series)
			AND (Cost_Inventory.AssetID = InventoryInOperation.AssetID)
			AND (Cost_Inventory.Lot = InventoryInOperation.Lot)
		
		LEFT JOIN ItemsPrices AS ItemsPrices
		ON (ItemsPrices.Products = InventoryInOperation.Products)
			AND (ItemsPrices.Characteristic = InventoryInOperation.Characteristic)
			AND (ItemsPrices.Currency = InventoryInOperation.CurrencyOfValue)
			
		LEFT JOIN ExchangeRates AS ExchangeRatesOfValue
		ON (ExchangeRatesOfValue.Currency = InventoryInOperation.CurrencyOfValue)
		
		LEFT JOIN ExchangeRates AS ExchangeRatesOfPriceType
		ON (ExchangeRatesOfPriceType.Currency = ItemsPrices.Currency)</query>
	</dataSet>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
