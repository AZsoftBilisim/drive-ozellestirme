				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>other handlers might hold its execution; you can check it by clicking</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>ممکن است رویدادگردان‌های دیگر اجرای آن را متوقف کرده باشند؛ می‌توانید با کلیک روی این مورد بررسی کنید</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>probabilmente altri elaboratori trattengono la sua esecuzione, verificare al comando</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>możliwe, że inne procesory danych wstrzymują go wykonanie, można to sprawdzić za pomocą polecenia</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>возможно другие обработчики держат его выполнение, проверить это можно по команде</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>belki diğer geliştiriciler onun yürütmesini tutuyor, bunu komutla kontrol edebilirsiniz</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>các hàm sự kiện khác có thể duy trì thực hiện, có thể kiểm tra điều này thông qua lệnh</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
