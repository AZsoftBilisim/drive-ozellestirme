			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Generate by collected data</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تولید بر اساس داده‌های جمع‌آوری‌شده</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Creare in base ai dati raccolti</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wygeneruj według zebranych danych</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сформировать по собранным данным</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Toplanan verilere göre oluşturmak</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Lập báo cáo theo dữ liệu đã thu thập</v8:content>
