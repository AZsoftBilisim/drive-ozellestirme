				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>- the handler did not process the data for the selected period</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>- رویدادگردان داده‌ها را برای دوره انتخاب‌شده پردازش نکرد</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>- l'elaboratore non ha elaborato i dati per l'intervallo selezionato</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>- procesor danych nie przetworzył dane za wybrany interwał</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>- обработчик не обработал данные за выбранный интервал</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>- geliştirici seçilen aralık için verileri işlemedi</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>- hàm sự kiện không xử lý dữ liệu trong khoảng thời gian đã chọn</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
