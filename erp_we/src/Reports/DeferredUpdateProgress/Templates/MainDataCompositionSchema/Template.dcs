							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>در نوار فرمان</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>в командной панели</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>komut çubuğunda</v8:content>
							</v8:item>
							<v8:item>
