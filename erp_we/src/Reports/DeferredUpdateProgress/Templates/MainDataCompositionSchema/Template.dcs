				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>in the command bar or by double-clicking the cell</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>در نوار فرمان یا با دوبار کلیک روی سلول مشاهده کنید</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Nel pannello di comando o con doppio click sulla cella</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>w panelu poleceć lub podwójnie klikając komórkę</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>в командной панели или по двойному клику в ячейке</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>komut çubuğunda veya bir hücreye çift tıklayarak</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>trong thanh lệnh hoặc nhấp đúp vào ô</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
