						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>- errors found in the handler or in the data being processed</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>- خطاهایی در رویدادگردان یا در داده‌های در حال پردازش یافت شد</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>- vi sono errori durante l'esecuzione dell'elaboratore o nei dati che elabora</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>- istnieją błędy procesora danych lub w danych które on przetwarza</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>- есть ошибки при выполнении обработчика или в данных, которые он обрабатывает</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>- geliştiricinin yürütülmesinde veya işlediği verilerde hatalar var</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>- có lỗi khi thực hiện hàm sự kiện hoặc trong dữ liệu mà nó đang xử lý</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>VerticalAlign</dcscor:parameter>
