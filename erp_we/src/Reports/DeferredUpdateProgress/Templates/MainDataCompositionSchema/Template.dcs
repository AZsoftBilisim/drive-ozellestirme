		<inputParameters>
			<dcscor:item>
				<dcscor:use>false</dcscor:use>
				<dcscor:parameter>EditFormat</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>BF='Collect data and generate'; BT='Generate by collected data'</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>BF='جمع‌آوری داده‌ها و تولید'; BT='تولید بر اساس داده‌های جمع‌آوری‌شده'</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>BF='Raccogliere i dati e creare'; BT='Creare in base ai dati raccolti'</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>BF='Zbieraj dane i generuj'; BT='Wygeneruj według zebranych danych'</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>BF='Собрать данные и сформировать'; BT='Сформировать по собранным данным'</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>BF='Veri topla ve oluştur'; BT= 'Toplanan verilerden oluştur'</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>BF='Thu thập dữ liệu và lập báo cáo'; BT='Lập báo cáo theo dữ liệu đã thu thập'</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</inputParameters>
		<use>Always</use>
	</parameter>
