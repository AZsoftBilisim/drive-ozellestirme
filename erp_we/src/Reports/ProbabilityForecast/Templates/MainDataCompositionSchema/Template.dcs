	<totalField>
		<dataPath>Probability</dataPath>
		<expression>100*Count(NumberOfWonTransactions)/(Count(NumberOfLostTransactions) + Count(NumberOfWonTransactions))</expression>
	</totalField>
	<totalField>
		<dataPath>SalesOpportunityPotentialSaleAmount</dataPath>
		<expression>Sum(SalesOpportunityPotentialSaleAmount)</expression>
		<group>ProcessStep</group>
	</totalField>
	<totalField>
		<dataPath>ForecastOfTheClosingDate</dataPath>
		<expression>Max(ForecastOfTheClosingDate)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfWonTransactions</dataPath>
		<expression>Count(NumberOfWonTransactions)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfLostTransactions</dataPath>
		<expression>Count(NumberOfLostTransactions)</expression>
	</totalField>
