		<field xsi:type="DataSetFieldField">
			<dataPath>Duration</dataPath>
			<field>Duration</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Duration</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مدت</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Durata</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Czas trwania</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Длительность</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Süre</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Thời lượng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Durations.TransactionTypeOfTransaction AS SalesOpportunityKind,
	Durations.ProcessStep,
	DATEADD(&amp;Today, DAY, Durations.Duration) AS ForecastOfTheClosingDate
FROM
	(SELECT
		StatisticsOfCustomerOpportunities.SalesOpportunity.SalesOpportunityKind AS TransactionTypeOfTransaction,
		StatisticsOfCustomerOpportunities.ProcessStep AS ProcessStep,
		AVG(DATEDIFF(StatisticsOfCustomerOpportunities.StartDate, StatisticsOfCustomerOpportunities.SalesOpportunity.EndDate, DAY)) AS Duration
	FROM
		InformationRegister.StatisticsOfCustomerOpportunities AS StatisticsOfCustomerOpportunities
	WHERE
		StatisticsOfCustomerOpportunities.SalesOpportunity.EndDate &lt;&gt; DATETIME(1, 1, 1)
	
	GROUP BY
		StatisticsOfCustomerOpportunities.SalesOpportunity.SalesOpportunityKind,
		StatisticsOfCustomerOpportunities.ProcessStep) AS Durations</query>
	</dataSet>
