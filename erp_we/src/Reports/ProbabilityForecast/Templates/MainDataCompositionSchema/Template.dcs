		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	StatisticsOfCustomerOpportunities.ProcessStep,
	StatisticsOfCustomerOpportunities.SalesOpportunity,
	StatisticsOfCustomerOpportunities.SalesOpportunity.PotentialSaleAmount,
	StatisticsOfCustomerOpportunities.SalesOpportunity.SalesOpportunityKind AS SalesOpportunityKind
FROM
	InformationRegister.StatisticsOfCustomerOpportunities AS StatisticsOfCustomerOpportunities
WHERE
	StatisticsOfCustomerOpportunities.EndDate = DATETIME(1, 1, 1)
	AND StatisticsOfCustomerOpportunities.SalesOpportunity.Status = VALUE(Enum.OpportunityStatuses.InProgress)</query>
	</dataSet>
