		<field xsi:type="DataSetFieldField">
			<dataPath>SalesOpportunityKind</dataPath>
			<field>SalesOpportunityKind</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Sales opportunity kind</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نوع فرصت فروش</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
