				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CashInCashRegistersCRBalanceAndTurnovers.Organization,
	CashInCashRegistersCRBalanceAndTurnovers.CashRegister,
	CashInCashRegistersCRBalanceAndTurnovers.CashRegister.CashRegisterType AS CashRegisterType,
	CashInCashRegistersCRBalanceAndTurnovers.CashRegister.CashCurrency AS Currency,
	CashInCashRegistersCRBalanceAndTurnovers.SumOpeningBalance,
	CASE
		WHEN CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.DepositCashIntoCashRegister
				OR CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.CashVoucher
			THEN CashInCashRegistersCRBalanceAndTurnovers.SumTurnover
		WHEN CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.RegisterAdjustment
			THEN CASE WHEN CashInCashRegistersCRBalanceAndTurnovers.SumTurnover &gt; 0 THEN CashInCashRegistersCRBalanceAndTurnovers.SumTurnover ELSE 0 END
		ELSE 0
	END AS CashDeposit,
	CASE
		WHEN CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.CashWithdrawalFromCashRegister
				OR CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.CashAccountReceiptNote
			THEN -CashInCashRegistersCRBalanceAndTurnovers.SumTurnover
		WHEN CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.RegisterAdjustment
			THEN CASE WHEN CashInCashRegistersCRBalanceAndTurnovers.SumTurnover &lt; 0 THEN -CashInCashRegistersCRBalanceAndTurnovers.SumTurnover ELSE 0 END
		ELSE 0
	END AS Withdrawal,
	CASE
		WHEN CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.CashRegisterReceipt
			OR CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.CashRegisterReceiptReturn
			OR CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.RetailSalesReport
			OR CashInCashRegistersCRBalanceAndTurnovers.Recorder REFS Document.GiftCertificateSale
			THEN CashInCashRegistersCRBalanceAndTurnovers.SumTurnover
		ELSE 0
	END AS Sales,
	CashInCashRegistersCRBalanceAndTurnovers.SumClosingBalance,
	
	CASE WHEN CashInCashRegistersCRBalanceAndTurnovers.Recorder = UNDEFINED THEN
		NULL
	ELSE
		CashInCashRegistersCRBalanceAndTurnovers.Recorder
	END AS Recorder,
	
	CashInCashRegistersCRBalanceAndTurnovers.DayPeriod,
	CashInCashRegistersCRBalanceAndTurnovers.WeekPeriod,
	CashInCashRegistersCRBalanceAndTurnovers.MonthPeriod,
	CashInCashRegistersCRBalanceAndTurnovers.QuarterPeriod,
	CashInCashRegistersCRBalanceAndTurnovers.HalfYearPeriod,
	CashInCashRegistersCRBalanceAndTurnovers.YearPeriod,
	CashInCashRegistersCRBalanceAndTurnovers.SecondPeriod
FROM
	AccumulationRegister.CashInCashRegistersCR.BalanceAndTurnovers(, , Auto, , ) AS CashInCashRegistersCRBalanceAndTurnovers</query>
	</dataSet>
