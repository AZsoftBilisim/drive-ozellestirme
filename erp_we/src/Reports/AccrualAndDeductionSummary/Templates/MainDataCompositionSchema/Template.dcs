		<dataSource>DataSource1</dataSource>
		<query>SELECT
	AccrualsHR.Organization AS Organization,
	AccrualsHR.Individual AS Individual,
	AccrualsHR.Employee AS Employee,
	AccrualsHR.Accrual AS TypeOfAccrualsOfDeductions,
	AccrualsHR.Department AS Department,
	AccrualsHR.Sum AS AccrualAmount,
	NULL AS RetentionAmount
FROM
	AccumulationRegister.AccrualsHR AS AccrualsHR
		LEFT JOIN AccumulationRegister.PayrollCalculationsHR AS PayrollCalculationsHR
		ON AccrualsHR.RowID = PayrollCalculationsHR.FinRecordID
		AND AccrualsHR.Organization = PayrollCalculationsHR.Organization
		AND AccrualsHR.Individual = PayrollCalculationsHR.Individual
WHERE
	ISNULL(PayrollCalculationsHR.Individual, 0) &lt;&gt; 0
	AND AccrualsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND PayrollCalculationsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

UNION ALL

SELECT
	DeductionsHR.Organization,
	DeductionsHR.Individual,
	DeductionsHR.Employee,
	DeductionsHR.Retention,
	DeductionsHR.Department,
	NULL,
	DeductionsHR.Sum
FROM
	AccumulationRegister.DeductionsHR AS DeductionsHR
		LEFT JOIN AccumulationRegister.PayrollCalculationsHR AS PayrollCalculationsHR
		ON DeductionsHR.RowID = PayrollCalculationsHR.FinRecordID
		AND DeductionsHR.Organization = PayrollCalculationsHR.Organization
		AND DeductionsHR.Individual = PayrollCalculationsHR.Individual
WHERE
	ISNULL(PayrollCalculationsHR.Individual, 0) &lt;&gt; 0
	AND DeductionsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND PayrollCalculationsHR.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod</query>
	</dataSet>
	<totalField>
		<dataPath>AccrualAmount</dataPath>
		<expression>Sum(AccrualAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>RetentionAmount</dataPath>
		<expression>Sum(RetentionAmount)</expression>
	</totalField>
