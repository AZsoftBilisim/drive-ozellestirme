		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentPartners.Partner,
	Partners.MainManager,
	PartnersSegments.Ref AS Segment,
	PartnersSegments.LongDesc,
	"V" AS SegmentIsUsedToProhibitShipment
FROM
	InformationRegister.SegmentPartners AS SegmentPartners
		LEFT JOIN Catalog.PartnersSegments AS PartnersSegments
		ON SegmentPartners.Segment = PartnersSegments.Ref
		LEFT JOIN Catalog.Partners AS Partners
		ON SegmentPartners.Partner = Partners.Ref
WHERE
	PartnersSegments.SegmentIsUsedToProhibitShipment
	AND NOT PartnersSegments.DeletionMark</query>
	</dataSet>
	<totalField>
		<dataPath>SegmentIsUsedToProhibitShipment</dataPath>
		<expression>Max(SegmentIsUsedToProhibitShipment)</expression>
	</totalField>
