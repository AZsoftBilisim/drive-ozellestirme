		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	StatisticsOfCustomerOpportunities.ProcessStep AS ProcessStep,
	StatisticsOfCustomerOpportunities.SalesOpportunity AS SalesOpportunity,
	1 AS TransactionNumber,
	StatisticsOfCustomerOpportunities.SalesOpportunity.Partner AS Partner,
	StatisticsOfCustomerOpportunities.SalesOpportunity.Partner AS Client,
	StatisticsOfCustomerOpportunities.Duration AS Duration,
	StatisticsOfCustomerOpportunities.SalesOpportunity.PotentialSaleAmount AS Potential,
	StatisticsOfCustomerOpportunities.EmployeeResponsible AS EmployeeResponsible,
	StatisticsOfCustomerOpportunities.Result AS Result,
	CASE
		WHEN StatisticsOfCustomerOpportunities.Result = VALUE(Enum.OpportunityStatuses.Won)
			THEN 1
		ELSE 0
	END AS NumberOfWonTransactions,
	CASE
		WHEN StatisticsOfCustomerOpportunities.Result = VALUE(Enum.OpportunityStatuses.Lost)
			THEN 1
		ELSE 0
	END AS NumberOfLostTransactions,
	CASE
		WHEN StatisticsOfCustomerOpportunities.Result = VALUE(Enum.OpportunityStatuses.InProgress)
			THEN 1
		ELSE 0
	END AS NumberOfTransactionsInProgress,
	CASE
		WHEN StatisticsOfCustomerOpportunities.Result = VALUE(Enum.OpportunityStatuses.Won)
			THEN StatisticsOfCustomerOpportunities.Potential
		ELSE 0
	END AS WonPotential,
	CASE
		WHEN StatisticsOfCustomerOpportunities.Result = VALUE(Enum.OpportunityStatuses.Lost)
			THEN StatisticsOfCustomerOpportunities.Potential
		ELSE 0
	END AS LostPotential,
	CASE
		WHEN StatisticsOfCustomerOpportunities.Result = VALUE(Enum.OpportunityStatuses.InProgress)
			THEN StatisticsOfCustomerOpportunities.Potential
		ELSE 0
	END AS PotentialInOperation
{SELECT
	ProcessStep.*,
	SalesOpportunity.*,
	TransactionNumber,
	Partner.* AS Partner,
	Client.* AS Client,
	Duration,
	Potential,
	EmployeeResponsible.*,
	Result.*,
	NumberOfWonTransactions,
	NumberOfLostTransactions,
	NumberOfTransactionsInProgress,
	WonPotential,
	LostPotential,
	PotentialInOperation}
FROM
	InformationRegister.StatisticsOfCustomerOpportunities AS StatisticsOfCustomerOpportunities
{WHERE
	(StatisticsOfCustomerOpportunities.StartDate &lt;= &amp;EndOfPeriod
			OR &amp;EndOfPeriod = DATETIME(1, 1, 1)),
	(StatisticsOfCustomerOpportunities.EndDate &gt;= &amp;BeginOfPeriod
			OR StatisticsOfCustomerOpportunities.EndDate = DATETIME(1, 1, 1)),
	(StatisticsOfCustomerOpportunities.SalesOpportunity.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	StatisticsOfCustomerOpportunities.ProcessStep.*,
	StatisticsOfCustomerOpportunities.SalesOpportunity.*,
	StatisticsOfCustomerOpportunities.SalesOpportunity.Partner.* AS Partner,
	StatisticsOfCustomerOpportunities.Duration,
	StatisticsOfCustomerOpportunities.SalesOpportunity.PotentialSaleAmount,
	StatisticsOfCustomerOpportunities.EmployeeResponsible.*,
	StatisticsOfCustomerOpportunities.Result.*}</query>
	</dataSet>
	<totalField>
		<dataPath>Duration</dataPath>
		<expression>Avg(Duration)</expression>
		<group>Client</group>
		<group>EmployeeResponsible</group>
		<group>Result</group>
		<group>SalesOpportunity</group>
		<group>ProcessStep</group>
	</totalField>
	<totalField>
		<dataPath>TransactionNumber</dataPath>
		<expression>Sum(TransactionNumber)</expression>
		<group>Client</group>
		<group>EmployeeResponsible</group>
		<group>Result</group>
		<group>SalesOpportunity</group>
		<group>ProcessStep</group>
	</totalField>
	<totalField>
		<dataPath>Potential</dataPath>
		<expression>Sum(Potential)</expression>
		<group>Client</group>
		<group>EmployeeResponsible</group>
		<group>Result</group>
		<group>SalesOpportunity</group>
		<group>ProcessStep</group>
	</totalField>
	<totalField>
