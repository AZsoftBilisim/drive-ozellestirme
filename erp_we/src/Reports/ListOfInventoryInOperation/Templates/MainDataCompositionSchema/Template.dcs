					<dcscor:parameter>Format</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MinWidth</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">13</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MaxWidth</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">13</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	InventoryInOperation.Organization AS Organization,
	InventoryInOperation.Organization.ParentCompany AS ParentCompany,
	InventoryInOperation.Department AS Department,
	InventoryInOperation.Individual AS Individual,
	InventoryInOperation.Products AS Products,
	InventoryInOperation.Characteristic AS Characteristic,
	InventoryInOperation.Series AS Series,
	InventoryInOperation.Lot AS Lot,
	InventoryInOperation.AssetID AS AssetID,
	InventoryInOperation.CCDNumber AS CCDNumber,
	InventoryInOperation.LineOfBusiness AS LineOfBusiness,
	InventoryInOperation.Lot.FixedAsset AS FixedAsset,
	InventoryInOperation.Lot.StartDateOfOperation AS OperationStart,
	InventoryInOperation.Lot.CompletionDate_ AS EndOfOperation,
	InventoryInOperation.Lot.ServiceLife AS ServiceLife,
	
	CASE
		WHEN ISNULL(InventoryInOperation.Lot.StartDateOfOperation, DATETIME(1, 1, 1)) = DATETIME(1, 1, 1)
			THEN 0
		WHEN &amp;EndOfPeriod &lt;&gt; DATETIME(1, 1, 1)
			THEN DATEDIFF(InventoryInOperation.Lot.StartDateOfOperation, &amp;EndOfPeriod, MONTH)
		WHEN &amp;CurrentDate &lt;&gt; DATETIME(1, 1, 1)
			THEN DATEDIFF(InventoryInOperation.Lot.StartDateOfOperation, &amp;CurrentDate, MONTH)
		ELSE 0
	END AS NumberOfMonthsOfUse,
	
	ISNULL(CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE InventoryInOperation.Characteristic.ItemsCharacteristicForPricing
	END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	
	ISNULL(CASE
		WHEN ItemKinds.SettingsOfPriceKeyByBatch = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)
		ELSE InventoryInOperation.Series.ItemsBatchForPricing
	END, VALUE(Catalog.ItemsBatchesForPricing.EmptyRef)) AS PricingBatch,
	
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS PricingPackage,
	
	CASE
		WHEN &amp;ValuationCurrency = "ComplCurrency"
			THEN InventoryInOperation.Organization.LocalAccountingCurrency
		ELSE &amp;CurrencyOfMan
	END AS CurrencyOfValue,
	
	CASE
		WHEN InventoryInOperation.Recorder = UNDEFINED
			THEN NULL
		ELSE InventoryInOperation.Recorder
	END AS Recorder,
	
	InventoryInOperation.SecondPeriod AS SecondPeriod,
	InventoryInOperation.DayPeriod AS DayPeriod,
	InventoryInOperation.WeekPeriod AS WeekPeriod,
	InventoryInOperation.TenDaysPeriod AS TenDaysPeriod,
	InventoryInOperation.MonthPeriod AS MonthPeriod,
	InventoryInOperation.QuarterPeriod AS QuarterPeriod,
	InventoryInOperation.YearPeriod AS YearPeriod,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN InventoryInOperation.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN InventoryInOperation.Products.UnitFactorForReports &lt;&gt; 0
					THEN InventoryInOperation.CountOpeningBalance / InventoryInOperation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountOpeningBalance,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN InventoryInOperation.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN InventoryInOperation.Products.UnitFactorForReports &lt;&gt; 0
					THEN InventoryInOperation.CountClosingBalance / InventoryInOperation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountClosingBalance,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN InventoryInOperation.CountReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN InventoryInOperation.Products.UnitFactorForReports &lt;&gt; 0
					THEN InventoryInOperation.CountReceipt / InventoryInOperation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountReceipt,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN InventoryInOperation.CountExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN InventoryInOperation.Products.UnitFactorForReports &lt;&gt; 0
					THEN InventoryInOperation.CountExpense / InventoryInOperation.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountExpense,
	
	InventoryInOperation.CountOpeningBalance * &amp;QueryTextItemWeight AS StartBalanceWeight,
	InventoryInOperation.CountClosingBalance * &amp;QueryTextItemWeight AS ClosingBalanceWeight,
	InventoryInOperation.CountReceipt * &amp;QueryTextItemWeight AS ReceiptWeight,
	InventoryInOperation.CountExpense * &amp;QueryTextItemWeight AS ConsumptionWeight,
	InventoryInOperation.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem AS StartBalanceVolume,
	InventoryInOperation.CountClosingBalance * &amp;QueryTextTheVolumeOfTheItem AS ClosingBalanceVolume,
	InventoryInOperation.CountReceipt * &amp;QueryTextTheVolumeOfTheItem AS ReceiptVolume,
	InventoryInOperation.CountExpense * &amp;QueryTextTheVolumeOfTheItem AS ConsumptionVolume,
	InventoryInOperation.QuantityByGBRNOpeningBalance AS QuantityByGBRNOpeningBalance,
	InventoryInOperation.QuantityByGBRNClosingBalance AS QuantityByGBRNClosingBalance,
	InventoryInOperation.QuantityByGBRNReceipt AS QuantityByGBRNReceipt,
	InventoryInOperation.QuantityByGBRNExpense AS QuantityByGBRNExpense
	
INTO InventoryInOperation

FROM
	AccumulationRegister.InventoryInOperation.BalanceAndTurnovers(,, Auto,, Products IN
		(SELECT
			Products.Ref
		FROM
			Catalog.Products AS Products
		WHERE
			Products.TracedGoods
			OR NOT &amp;TraceableItemOnly)) AS InventoryInOperation
			
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON (ItemKinds.Ref = InventoryInOperation.Products.ProductKind)

INDEX BY
	Organization,
	Products,
	Characteristic,
	Series,
	AssetID,
	Lot
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Cost_Inventory.Organization AS Organization,
	Cost_Inventory.Products AS Products,
	Cost_Inventory.Characteristic AS Characteristic,
	Cost_Inventory.Series AS Series,
	Cost_Inventory.AssetID AS AssetID,
	Cost_Inventory.Lot AS Lot,
	CASE
		WHEN SUM(Cost_Inventory.Count) &lt;&gt; 0
			THEN SUM(Cost_Inventory.LocalCost) / SUM(Cost_Inventory.Count)
		ELSE 0
	END AS LocalPrice,
	CASE
		WHEN SUM(Cost_Inventory.Count) &lt;&gt; 0
			THEN SUM(Cost_Inventory.CostMan) / SUM(Cost_Inventory.Count)
		ELSE 0
	END AS ManSPrice
	
INTO Cost_Inventory

FROM
	InformationRegister.CostOfInventoryInOperation AS Cost_Inventory
WHERE
	Cost_Inventory.Active
	AND (Cost_Inventory.Organization, Cost_Inventory.Products, Cost_Inventory.Characteristic, Cost_Inventory.Series,
		Cost_Inventory.AssetID, Cost_Inventory.Lot) IN
		(SELECT
			InventoryInOperation.Organization,
			InventoryInOperation.Products,
			InventoryInOperation.Characteristic,
			InventoryInOperation.Series,
			InventoryInOperation.AssetID,
			InventoryInOperation.Lot
		FROM
			InventoryInOperation AS InventoryInOperation)
			
GROUP BY
	Cost_Inventory.Organization,
	Cost_Inventory.Products,
	Cost_Inventory.Characteristic,
	Cost_Inventory.Series,
	Cost_Inventory.AssetID,
	Cost_Inventory.Lot
	
INDEX BY
	Organization,
	Products,
	Characteristic,
	Series,
	AssetID,
	Lot
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	InventoryInOperation.Products,
	InventoryInOperation.Characteristic

INTO ListOfGoodsAndEquipmentPrices

FROM
	InventoryInOperation AS InventoryInOperation

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	InventoryInOperation.Products AS Products,
	InventoryInOperation.Characteristic AS Characteristic,
	InventoryInOperation.PricingVariant AS PricingVariant,
	InventoryInOperation.PricingBatch AS PricingBatch,
	InventoryInOperation.PricingPackage AS PricingPackage

INTO ListOfGoodsAndEquipmentPrices25

FROM
	InventoryInOperation AS InventoryInOperation
	
INDEX BY
	Products,
	PricingVariant,
	PricingBatch,
	PricingPackage
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Products AS Products,
	ItemsPrices.Characteristic AS Characteristic,
	ItemsPrices.Currency AS Currency,
	CASE
		WHEN NOT &amp;TextOfRequestIsPackingCoefficientOfProductPrice IS NULL
		AND &amp;TextOfRequestIsPackingCoefficientOfProductPrice &lt;&gt; 0
			THEN ItemsPrices.Price / &amp;TextOfRequestIsPackingCoefficientOfProductPrice
		ELSE ItemsPrices.Price
	END AS Price
	
INTO ItemsPrices

FROM
	InformationRegister.ItemsPrices.SliceLast({(&amp;EndOfPeriod)}, PriceKind = &amp;PriceKind
	AND (Products, Characteristic) IN
		(SELECT
			ListOfGoodsAndEquipmentPrices.Products,
			ListOfGoodsAndEquipmentPrices.Characteristic
		FROM
			ListOfGoodsAndEquipmentPrices AS ListOfGoodsAndEquipmentPrices)) AS ItemsPrices
WHERE
	NOT &amp;UsePriceManagementSystem25

UNION ALL

SELECT
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Products AS Products,
	ListOfGoodsAndEquipmentPrices25.Characteristic AS Characteristic,
	ItemsPrices.Currency AS Currency,
	CASE
		WHEN NOT &amp;TextOfRequestIsPackingCoefficientOfProductPrice IS NULL
		AND &amp;TextOfRequestIsPackingCoefficientOfProductPrice &lt;&gt; 0
			THEN ItemsPrices.Price / &amp;TextOfRequestIsPackingCoefficientOfProductPrice
		ELSE ItemsPrices.Price
	END AS Price
FROM
	InformationRegister.ItemsPrices25.SliceLast({(&amp;EndOfPeriod)}, PriceKind = &amp;PriceKind
	AND (Products, PricingVariant, PricingBatch, PricingPackage) IN
		(SELECT
			ListOfGoodsAndEquipmentPrices25.Products,
			ListOfGoodsAndEquipmentPrices25.PricingVariant,
			ListOfGoodsAndEquipmentPrices25.PricingBatch,
			ListOfGoodsAndEquipmentPrices25.PricingPackage
		FROM
			ListOfGoodsAndEquipmentPrices25 AS ListOfGoodsAndEquipmentPrices25)) AS ItemsPrices
			
		LEFT JOIN ListOfGoodsAndEquipmentPrices25 AS ListOfGoodsAndEquipmentPrices25
		ON ItemsPrices.Products = ListOfGoodsAndEquipmentPrices25.Products
			AND ItemsPrices.PricingVariant = ListOfGoodsAndEquipmentPrices25.PricingVariant
			AND ItemsPrices.PricingBatch = ListOfGoodsAndEquipmentPrices25.PricingBatch
			AND ItemsPrices.PricingPackage = ListOfGoodsAndEquipmentPrices25.PricingPackage
WHERE
	&amp;UsePriceManagementSystem25

INDEX BY
	Products,
	Characteristic,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ExchangeRates.Currency AS Currency,
	ExchangeRates.CourseNumerator AS CourseNumerator,
	ExchangeRates.CourseDenominator AS CourseDenominator
	
INTO ExchangeRates

FROM
	InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)}, BaseCurrency = &amp;BaseCurrency) AS
		ExchangeRates
WHERE
	ExchangeRates.CourseNumerator &lt;&gt; 0
	AND ExchangeRates.CourseDenominator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	InventoryInOperation.Organization AS Organization,
	InventoryInOperation.Department AS Department,
	InventoryInOperation.Individual AS Individual,
	InventoryInOperation.Products AS Products,
	InventoryInOperation.Characteristic AS Characteristic,
	InventoryInOperation.Series AS Series,
	InventoryInOperation.Lot AS Lot,
	InventoryInOperation.AssetID AS AssetID,
	InventoryInOperation.CCDNumber AS CCDNumber,
	InventoryInOperation.LineOfBusiness AS LineOfBusiness,
	InventoryInOperation.FixedAsset AS FixedAsset,
	InventoryInOperation.OperationStart AS OperationStart,
	InventoryInOperation.EndOfOperation AS EndOfOperation,
	InventoryInOperation.ServiceLife AS ServiceLife,
	InventoryInOperation.Products.UnitOfMeasure AS StorageUnit,
	InventoryInOperation.Products.UnitForReports AS UnitForReports,
	InventoryInOperation.NumberOfMonthsOfUse AS NumberOfMonthsOfUse,
	InventoryInOperation.Recorder AS Recorder,
	InventoryInOperation.SecondPeriod AS SecondPeriod,
	InventoryInOperation.DayPeriod AS DayPeriod,
	InventoryInOperation.WeekPeriod AS WeekPeriod,
	InventoryInOperation.TenDaysPeriod AS TenDaysPeriod,
	InventoryInOperation.MonthPeriod AS MonthPeriod,
	InventoryInOperation.QuarterPeriod AS QuarterPeriod,
	InventoryInOperation.YearPeriod AS YearPeriod,
	InventoryInOperation.CountOpeningBalance AS CountOpeningBalance,
	InventoryInOperation.CountClosingBalance AS CountClosingBalance,
	InventoryInOperation.CountReceipt AS CountReceipt,
	InventoryInOperation.CountExpense AS CountExpense,
	InventoryInOperation.QuantityByGBRNOpeningBalance AS QuantityByGBRNOpeningBalance,
	InventoryInOperation.QuantityByGBRNClosingBalance AS QuantityByGBRNClosingBalance,
	InventoryInOperation.QuantityByGBRNReceipt AS QuantityByGBRNReceipt,
	InventoryInOperation.QuantityByGBRNExpense AS QuantityByGBRNExpense,
	InventoryInOperation.StartBalanceWeight AS StartBalanceWeight,
	InventoryInOperation.ClosingBalanceWeight AS ClosingBalanceWeight,
	InventoryInOperation.ReceiptWeight AS ReceiptWeight,
	InventoryInOperation.ConsumptionWeight AS ConsumptionWeight,
	InventoryInOperation.StartBalanceVolume AS StartBalanceVolume,
	InventoryInOperation.ClosingBalanceVolume AS ClosingBalanceVolume,
	InventoryInOperation.ReceiptVolume AS ReceiptVolume,
	InventoryInOperation.ConsumptionVolume AS ConsumptionVolume,  
	
	CASE
		WHEN &amp;InventoryAssessment = "ByPriceType"
			THEN InventoryInOperation.CountReceipt * ISNULL(ItemsPrices.Price, 0) * CASE
				WHEN ISNULL(ExchangeRatesOfValue.CourseNumerator, 0) &lt;&gt; 0
				AND ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 0) &lt;&gt; 0
					THEN ISNULL(ExchangeRatesOfPriceType.CourseNumerator, 0) * ISNULL(ExchangeRatesOfValue.CourseDenominator, 0) /
						(ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 1) * ISNULL(ExchangeRatesOfValue.CourseNumerator, 0))
				ELSE 1
			END
		ELSE CASE
			WHEN &amp;ValuationCurrency = "ComplCurrency"
				THEN InventoryInOperation.CountReceipt * ISNULL(Cost_Inventory.LocalPrice, 0)
			ELSE InventoryInOperation.CountReceipt * ISNULL(Cost_Inventory.ManSPrice, 0)
		END
	END AS CostReceipt,
	
	CASE
		WHEN &amp;InventoryAssessment = "ByPriceType"
			THEN InventoryInOperation.CountExpense * ISNULL(ItemsPrices.Price, 0) * CASE
				WHEN ISNULL(ExchangeRatesOfValue.CourseNumerator, 0) &lt;&gt; 0
				AND ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 0) &lt;&gt; 0
					THEN ISNULL(ExchangeRatesOfPriceType.CourseNumerator, 0) * ISNULL(ExchangeRatesOfValue.CourseDenominator, 0) /
						(ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 1) * ISNULL(ExchangeRatesOfValue.CourseNumerator, 0))
				ELSE 1
			END
		ELSE CASE
			WHEN &amp;ValuationCurrency = "ComplCurrency"
				THEN InventoryInOperation.CountExpense * ISNULL(Cost_Inventory.LocalPrice, 0)
			ELSE InventoryInOperation.CountExpense * ISNULL(Cost_Inventory.ManSPrice, 0)
		END
	END AS CostExpense,
	
	CASE
		WHEN &amp;InventoryAssessment = "ByPriceType"
			THEN InventoryInOperation.CountOpeningBalance * ISNULL(ItemsPrices.Price, 0) * CASE
				WHEN ISNULL(ExchangeRatesOfValue.CourseNumerator, 0) &lt;&gt; 0
				AND ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 0) &lt;&gt; 0
					THEN ISNULL(ExchangeRatesOfPriceType.CourseNumerator, 0) * ISNULL(ExchangeRatesOfValue.CourseDenominator, 0) /
						(ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 1) * ISNULL(ExchangeRatesOfValue.CourseNumerator, 0))
				ELSE 1
			END
		ELSE CASE
			WHEN &amp;ValuationCurrency = "ComplCurrency"
				THEN InventoryInOperation.CountOpeningBalance * ISNULL(Cost_Inventory.LocalPrice, 0)
			ELSE InventoryInOperation.CountOpeningBalance * ISNULL(Cost_Inventory.ManSPrice, 0)
		END
	END AS CostAtBeginningOfPeriod,
	
	CASE
		WHEN &amp;InventoryAssessment = "ByPriceType"
			THEN InventoryInOperation.CountClosingBalance * ISNULL(ItemsPrices.Price, 0) * CASE
				WHEN ISNULL(ExchangeRatesOfValue.CourseNumerator, 0) &lt;&gt; 0
				AND ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 0) &lt;&gt; 0
					THEN ISNULL(ExchangeRatesOfPriceType.CourseNumerator, 0) * ISNULL(ExchangeRatesOfValue.CourseDenominator, 0) /
						(ISNULL(ExchangeRatesOfPriceType.CourseDenominator, 1) * ISNULL(ExchangeRatesOfValue.CourseNumerator, 0))
				ELSE 1
			END
		ELSE CASE
			WHEN &amp;ValuationCurrency = "ComplCurrency"
				THEN InventoryInOperation.CountClosingBalance * ISNULL(Cost_Inventory.LocalPrice, 0)
			ELSE InventoryInOperation.CountClosingBalance * ISNULL(Cost_Inventory.ManSPrice, 0)
		END
	END AS CostAtEndOfPeriod
	
INTO InventoryInOperationCost
	
FROM
	InventoryInOperation AS InventoryInOperation
	
		LEFT JOIN Cost_Inventory AS Cost_Inventory
		ON (Cost_Inventory.Organization = InventoryInOperation.Organization)
			AND (Cost_Inventory.Products = InventoryInOperation.Products)
			AND (Cost_Inventory.Characteristic = InventoryInOperation.Characteristic)
			AND (Cost_Inventory.Series = InventoryInOperation.Series)
			AND (Cost_Inventory.AssetID = InventoryInOperation.AssetID)
			AND (Cost_Inventory.Lot = InventoryInOperation.Lot)
			
		LEFT JOIN ItemsPrices AS ItemsPrices
		ON (ItemsPrices.Products = InventoryInOperation.Products)
			AND (ItemsPrices.Characteristic = InventoryInOperation.Characteristic)
			AND (ItemsPrices.Currency = InventoryInOperation.CurrencyOfValue)
			
		LEFT JOIN ExchangeRates AS ExchangeRatesOfValue
		ON (ExchangeRatesOfValue.Currency = InventoryInOperation.CurrencyOfValue)
		
		LEFT JOIN ExchangeRates AS ExchangeRatesOfPriceType
		ON (ExchangeRatesOfPriceType.Currency = ItemsPrices.Currency)
;
		
////////////////////////////////////////////////////////////////////////////////
SELECT
	InventoryInOperation.Organization AS Organization,
	InventoryInOperation.Department AS Department,
	InventoryInOperation.Individual AS Individual,
	InventoryInOperation.Products AS Products,
	InventoryInOperation.Characteristic AS Characteristic,
	InventoryInOperation.Series AS Series,
	InventoryInOperation.Lot AS Lot,
	InventoryInOperation.AssetID AS AssetID,
	InventoryInOperation.CCDNumber AS CCDNumber,
	InventoryInOperation.LineOfBusiness AS LineOfBusiness,
	InventoryInOperation.FixedAsset AS FixedAsset,
	InventoryInOperation.OperationStart AS OperationStart,
	InventoryInOperation.EndOfOperation AS EndOfOperation,
	InventoryInOperation.ServiceLife AS ServiceLife,
	InventoryInOperation.Products.UnitOfMeasure AS StorageUnit,
	InventoryInOperation.Products.UnitForReports AS UnitForReports,
	InventoryInOperation.NumberOfMonthsOfUse AS NumberOfMonthsOfUse,
	InventoryInOperation.Recorder AS Recorder,
	InventoryInOperation.SecondPeriod AS SecondPeriod,
	InventoryInOperation.DayPeriod AS DayPeriod,
	InventoryInOperation.WeekPeriod AS WeekPeriod,
	InventoryInOperation.TenDaysPeriod AS TenDaysPeriod,
	InventoryInOperation.MonthPeriod AS MonthPeriod,
	InventoryInOperation.QuarterPeriod AS QuarterPeriod,
	InventoryInOperation.YearPeriod AS YearPeriod,
	InventoryInOperation.CountOpeningBalance AS CountOpeningBalance,
	InventoryInOperation.CountClosingBalance AS CountClosingBalance,
	InventoryInOperation.CountReceipt AS CountReceipt,
	InventoryInOperation.CountExpense AS CountExpense,
	InventoryInOperation.QuantityByGBRNOpeningBalance AS QuantityByGBRNOpeningBalance,
	InventoryInOperation.QuantityByGBRNClosingBalance AS QuantityByGBRNClosingBalance,
	InventoryInOperation.QuantityByGBRNReceipt AS QuantityByGBRNReceipt,
	InventoryInOperation.QuantityByGBRNExpense AS QuantityByGBRNExpense,
	InventoryInOperation.StartBalanceWeight AS StartBalanceWeight,
	InventoryInOperation.ClosingBalanceWeight AS ClosingBalanceWeight,
	InventoryInOperation.ReceiptWeight AS ReceiptWeight,
	InventoryInOperation.ConsumptionWeight AS ConsumptionWeight,
	InventoryInOperation.StartBalanceVolume AS StartBalanceVolume,
	InventoryInOperation.ClosingBalanceVolume AS ClosingBalanceVolume,
	InventoryInOperation.ReceiptVolume AS ReceiptVolume,
	InventoryInOperation.ConsumptionVolume AS ConsumptionVolume,  
	
	InventoryInOperation.CostReceipt AS CostReceipt,
	InventoryInOperation.CostExpense AS CostExpense,
	InventoryInOperation.CostAtBeginningOfPeriod AS CostAtBeginningOfPeriod,
	InventoryInOperation.CostAtEndOfPeriod AS CostAtEndOfPeriod,
	
	CASE
		WHEN InventoryInOperation.ServiceLife = 0
			THEN InventoryInOperation.CostReceipt
		WHEN InventoryInOperation.NumberOfMonthsOfUse &gt; InventoryInOperation.ServiceLife
			THEN 0
		ELSE InventoryInOperation.CostReceipt * InventoryInOperation.NumberOfMonthsOfUse / InventoryInOperation.ServiceLife
	END AS NetBookValueReceipt,
	
	CASE
		WHEN InventoryInOperation.ServiceLife = 0
			THEN InventoryInOperation.CostExpense
		WHEN InventoryInOperation.NumberOfMonthsOfUse &gt; InventoryInOperation.ServiceLife
			THEN 0
		ELSE InventoryInOperation.CostExpense * InventoryInOperation.NumberOfMonthsOfUse / InventoryInOperation.ServiceLife
	END AS NetBookValueExpense,
	
	CASE
		WHEN InventoryInOperation.ServiceLife = 0
			THEN InventoryInOperation.CostAtBeginningOfPeriod
		WHEN InventoryInOperation.NumberOfMonthsOfUse &gt; InventoryInOperation.ServiceLife
			THEN 0
		ELSE InventoryInOperation.CostAtBeginningOfPeriod - InventoryInOperation.CostAtBeginningOfPeriod * InventoryInOperation.NumberOfMonthsOfUse / InventoryInOperation.ServiceLife
	END AS ResidualValueAtBeginningOfPeriod,
	
	CASE
		WHEN InventoryInOperation.ServiceLife = 0
			THEN InventoryInOperation.CostAtEndOfPeriod
		WHEN InventoryInOperation.NumberOfMonthsOfUse &gt; InventoryInOperation.ServiceLife
			THEN 0
		ELSE InventoryInOperation.CostAtEndOfPeriod - InventoryInOperation.CostAtEndOfPeriod * InventoryInOperation.NumberOfMonthsOfUse / InventoryInOperation.ServiceLife
	END AS ResidualValueAtEndOfPeriod
	
FROM
	InventoryInOperationCost AS InventoryInOperation</query>
	</dataSet>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
