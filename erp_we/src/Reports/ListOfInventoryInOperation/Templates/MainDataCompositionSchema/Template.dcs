		<expression>Sum(ConsumptionVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>CountReceipt</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountExpense</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(CountExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Sum(CountClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountOpeningBalance)
End</expression>
	</totalField>
