		<field xsi:type="DataSetFieldField">
			<dataPath>ImportDocumentType</dataPath>
			<field>ImportDocumentType</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	GoodsForRegistrationOfImportDocumentsBalance.Organization AS Organization,
	GoodsForRegistrationOfImportDocumentsBalance.Vendor AS Vendor,
	GoodsForRegistrationOfImportDocumentsBalance.ItemsLocationAttributes.Products AS Products,
	GoodsForRegistrationOfImportDocumentsBalance.ItemsLocationAttributes.Characteristic AS Characteristic,
	GoodsForRegistrationOfImportDocumentsBalance.ItemsLocationAttributes.Series AS Series,
	GoodsForRegistrationOfImportDocumentsBalance.ItemsLocationAttributes.StorageLocation AS Warehouse,
	GoodsForRegistrationOfImportDocumentsBalance.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	GoodsForRegistrationOfImportDocumentsBalance.DocumentInflow AS DocumentInflow,
	SUM(GoodsForRegistrationOfImportDocumentsBalance.CountBalance) AS CountBalance
{SELECT
	Organization.*,
	Vendor.*,
	Products.*,
	Characteristic.*,
	Series.*,
	Warehouse.*,
	InventoryOwnerAttribute.*,
	DocumentInflow.*,
	CountBalance}
FROM
	AccumulationRegister.GoodsForRegistrationOfImportDocuments.Balance(, ImportDocumentType = &amp;ImportDocumentType) AS GoodsForRegistrationOfImportDocumentsBalance
{WHERE
	GoodsForRegistrationOfImportDocumentsBalance.CountBalance}

GROUP BY
	GoodsForRegistrationOfImportDocumentsBalance.Organization,
	GoodsForRegistrationOfImportDocumentsBalance.Vendor,
	GoodsForRegistrationOfImportDocumentsBalance.ItemsLocationAttributes.Products,
	GoodsForRegistrationOfImportDocumentsBalance.ItemsLocationAttributes.Characteristic,
	GoodsForRegistrationOfImportDocumentsBalance.ItemsLocationAttributes.Series,
	GoodsForRegistrationOfImportDocumentsBalance.ItemsLocationAttributes.StorageLocation,
	GoodsForRegistrationOfImportDocumentsBalance.InventoryOwnerAttribute,
	GoodsForRegistrationOfImportDocumentsBalance.DocumentInflow</query>
	</dataSet>
	<totalField>
		<dataPath>CountBalance</dataPath>
		<expression>Sum(CountBalance)</expression>
	</totalField>
