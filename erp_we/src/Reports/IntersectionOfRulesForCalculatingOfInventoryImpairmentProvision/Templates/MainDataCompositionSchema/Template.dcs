		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys) AS ItemsLocationAttributes,
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).Products AS Products,
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).Characteristic AS Characteristic,
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).Series AS Series,
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).StorageLocation AS StorageLocation,
	CAST(SummaryTableOfOverlappingRules.AccountingSection AS Enum.SectionsOfInventoryCostAccounting) AS
		AccountingSection,
	CAST(SummaryTableOfOverlappingRules.InventoryOwnerAttribute AS Catalog.InventoryKinds) AS InventoryOwnerAttribute,
	CAST(SummaryTableOfOverlappingRules.InventoryType AS Enum.InventoryTypes) AS InventoryType,
	CAST(SummaryTableOfOverlappingRules.Organization AS Catalog.Companies) AS Organization,
	SummaryTableOfOverlappingRules.Lot AS Lot,
	CAST(SummaryTableOfOverlappingRules.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS
		LotVendorAttributes,
	SummaryTableOfOverlappingRules.FinancialAccountingDimension AS FinancialAccountingDimension,
	CAST(SummaryTableOfOverlappingRules.VATActivityType AS Enum.VATTaxationTypes) AS
		VATActivityType,
	CAST(SummaryTableOfOverlappingRules.AccountingDimensionByPartners AS
		Catalog.DimensionKeysOfAccountingByPartners) AS AccountingDimensionByPartners,
	CAST(SummaryTableOfOverlappingRules.Rule AS
		Catalog.RulesForCalculationOfInventoryImpairmentProvision) AS Rule,
	CAST(SummaryTableOfOverlappingRules.Priority AS NUMBER(5, 0)) AS Priority,
	CAST(SummaryTableOfOverlappingRules.PriceKind AS Catalog.TypesOfPrices) AS PriceKind,
	CAST(SummaryTableOfOverlappingRules.LocalAccounting AS BOOLEAN) AS AccountingKind
{SELECT
	ItemsLocationAttributes.* AS ItemsLocationAttributes,
	Products.* AS Products,
	Characteristic.* AS Characteristic,
	Series.* AS Series,
	StorageLocation.* AS StorageLocation,
	AccountingSection.* AS AccountingSection,
	InventoryOwnerAttribute.* AS InventoryOwnerAttribute,
	InventoryType.* AS InventoryType,
	Organization.* AS Organization,
	Lot.* AS Lot,
	LotVendorAttributes.* AS LotVendorAttributes,
	FinancialAccountingDimension.* AS FinancialAccountingDimension,
	VATActivityType.* AS VATActivityType,
	AccountingDimensionByPartners.* AS AccountingDimensionByPartners,
	Rule.* AS Rule,
	Priority AS Priority,
	PriceKind.* AS PriceKind,
	AccountingKind.* AS AccountingKind}
FROM
	TemporaryTableOfBalances AS SummaryTableOfOverlappingRules
{WHERE
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys) AS ItemsLocationAttributes,
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).Products AS Products,
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).Characteristic AS Characteristic,
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).Series AS Series,
	CAST(SummaryTableOfOverlappingRules.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).StorageLocation AS StorageLocation,
	CAST(SummaryTableOfOverlappingRules.AccountingSection AS Enum.SectionsOfInventoryCostAccounting) AS
		AccountingSection,
	CAST(SummaryTableOfOverlappingRules.InventoryOwnerAttribute AS Catalog.InventoryKinds) AS InventoryOwnerAttribute,
	CAST(SummaryTableOfOverlappingRules.InventoryType AS Enum.InventoryTypes) AS InventoryType,
	CAST(SummaryTableOfOverlappingRules.Organization AS Catalog.Companies) AS Organization,
	SummaryTableOfOverlappingRules.Lot AS Lot,
	CAST(SummaryTableOfOverlappingRules.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS
		LotVendorAttributes,
	SummaryTableOfOverlappingRules.FinancialAccountingDimension AS FinancialAccountingDimension,
	CAST(SummaryTableOfOverlappingRules.VATActivityType AS Enum.VATTaxationTypes) AS
		VATActivityType,
	CAST(SummaryTableOfOverlappingRules.AccountingDimensionByPartners AS Catalog.DimensionKeysOfAccountingByPartners)
		AS AccountingDimensionByPartners,
	CAST(SummaryTableOfOverlappingRules.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision)
		AS Rule,
	CAST(SummaryTableOfOverlappingRules.Priority AS NUMBER(5, 0)) AS Priority,
	CAST(SummaryTableOfOverlappingRules.PriceKind AS Catalog.TypesOfPrices) AS PriceKind,
	CAST(SummaryTableOfOverlappingRules.LocalAccounting AS BOOLEAN) AS AccountingKind}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>PriceKind</dataPath>
		<expression>Max(PriceKind)</expression>
		<group>Organization</group>
	</totalField>
