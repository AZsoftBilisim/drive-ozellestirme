	<settingsVariant>
		<dcsset:name>Main</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Control over intersection of conditions of rules for generating provisions for impairment of inventory</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>کنترل همپوشانی شرایط قواعد تولید ذخایر کاهش ارزش موجودی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Controllo intersezione delle condizioni delle regole di creazione di scorte in deterioramento</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Kontrola przekroczenia warunków reguł tworzenia rezerw pod utratę wartości zapasów</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Контроль пересечения условий правил формирования резервов под обесценение запасов</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Stok değer düşüklüğü için karşılık oluşturma kuralı koşullarının kesişimi üzerinde kontrol</v8:content>
			</v8:item>
			<v8:item>
