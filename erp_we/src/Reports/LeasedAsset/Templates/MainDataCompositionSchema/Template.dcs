				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Недвижимое имущество</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Gayrimenkul</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Bất động sản</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	LeasedAsset.FixedAsset AS FixedAsset,
	LeasedAsset.Partner AS Lessor,
	LeasedAsset.Counterparty AS Counterparty,
	LeasedAsset.Contract AS Contract
INTO TT_LeasedAsset
FROM
	InformationRegister.LeasedAsset.SliceLast({&amp;Period}) AS LeasedAsset
WHERE
	LeasedAsset.State IN (
		VALUE(Enum.FixedAssetsStates.LeaseContractsSigned),
		VALUE(Enum.FixedAssetsStates.InLease),
		VALUE(Enum.FixedAssetsStates.EnteredInOffBalanceAccounting))
{WHERE
	LeasedAsset.Partner.* AS Lessor,
	LeasedAsset.Counterparty.* AS Counterparty,
	LeasedAsset.Contract.* AS Contract}

INDEX BY
	FixedAsset
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TermsOfLeaseContracts.Contract AS Contract,
	TermsOfLeaseContracts.LeaseStartDate AS LeaseStartDate,
	TermsOfLeaseContracts.TermYears AS TermYears,
	TermsOfLeaseContracts.TermMonths AS TermMonths,
	TermsOfLeaseContracts.TermDays AS TermDays
INTO TT_TermsOfLeaseContracts
FROM
	InformationRegister.TermsOfLeaseContracts.SliceLast(
		{&amp;Period}, 
		Contract IN
			(SELECT
				TT_LeasedAsset.Contract
			FROM
				TT_LeasedAsset)) AS TermsOfLeaseContracts

INDEX BY
	Contract
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	FALocation.FixedAsset AS FixedAsset,
	FALocation.Organization AS Organization,
	FALocation.FixedAssetsLocation AS Department,
	FALocation.FinanciallyLiablePerson AS FinanciallyLiablePerson
INTO TT_FALocation
FROM
	InformationRegister.FALocation.SliceLast(
		{&amp;Period}, 
		CorrectionDate = DATETIME(1,1,1)
			AND FixedAsset IN
				(SELECT
					TT_LeasedAsset.FixedAsset
				FROM
					TT_LeasedAsset)) AS FALocation

{WHERE
	FALocation.Organization.* AS Organization,
	FALocation.FixedAssetsLocation.* AS Department,
	FALocation.FinanciallyLiablePerson.* AS FinanciallyLiablePerson}
	
INDEX BY
	FixedAsset

;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AccountingProcedureForOSBU.Organization AS Organization,
	AccountingProcedureForOSBU.FixedAsset AS FixedAsset,
	AccountingProcedureForOSBU.DepreciationGroup AS DepreciationGroup,
	AccountingProcedureForOSBU.RealEstate AS RealEstate
INTO TT_AccountingProcedureForOSBU
FROM
	InformationRegister.AccountingProcedureForOSBU.SliceLast(
		{&amp;Period}, 
		CorrectionDate = DATETIME(1,1,1)
			AND FixedAsset IN
				(SELECT
					TT_LeasedAsset.FixedAsset
				FROM
					TT_LeasedAsset)) AS AccountingProcedureForOSBU
{WHERE
	AccountingProcedureForOSBU.DepreciationGroup.* AS DepreciationGroup,
	AccountingProcedureForOSBU.RealEstate AS RealEstate}

INDEX BY
	FixedAsset
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TT_LeasedAsset.FixedAsset AS FixedAsset,
	TT_LeasedAsset.Lessor AS Lessor,
	TT_LeasedAsset.Counterparty AS Counterparty,
	TT_LeasedAsset.Contract AS Contract,
	TT_FALocation.Organization AS Organization,
	TT_FALocation.Department AS Department,
	TT_FALocation.FinanciallyLiablePerson AS FinanciallyLiablePerson,
	TT_TermsOfLeaseContracts.LeaseStartDate AS LeaseStartDate,
	TT_TermsOfLeaseContracts.TermYears AS TermYears,
	TT_TermsOfLeaseContracts.TermMonths AS TermMonths,
	TT_TermsOfLeaseContracts.TermDays AS TermDays,
	TT_AccountingProcedureForOSBU.DepreciationGroup AS DepreciationGroup,
	TT_AccountingProcedureForOSBU.RealEstate AS RealEstate
FROM
	TT_LeasedAsset AS TT_LeasedAsset
	
		LEFT JOIN TT_TermsOfLeaseContracts AS TT_TermsOfLeaseContracts
		ON TT_TermsOfLeaseContracts.Contract = TT_LeasedAsset.Contract
		
		LEFT JOIN TT_FALocation AS TT_FALocation
		ON TT_FALocation.FixedAsset = TT_LeasedAsset.FixedAsset
		
		LEFT JOIN TT_AccountingProcedureForOSBU AS TT_AccountingProcedureForOSBU
		ON TT_AccountingProcedureForOSBU.Organization = TT_FALocation.Organization		
			AND TT_AccountingProcedureForOSBU.FixedAsset = TT_FALocation.FixedAsset
			
{WHERE
	TT_FALocation.Organization.* AS Organization,
	TT_FALocation.Department.* AS Department,
	TT_FALocation.FinanciallyLiablePerson.* AS FinanciallyLiablePerson,
	TT_AccountingProcedureForOSBU.DepreciationGroup.* AS DepreciationGroup,
	TT_AccountingProcedureForOSBU.RealEstate AS RealEstate}			</query>
	</dataSet>
