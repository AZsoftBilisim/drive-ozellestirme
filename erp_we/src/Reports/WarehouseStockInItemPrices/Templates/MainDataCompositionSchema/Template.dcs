		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductStock.SecondPeriod AS Period,
	ProductStock.Recorder AS Recorder,
	ProductStock.Products AS Products,
	ProductStock.Characteristic AS Characteristic,
	ProductStock.Warehouse AS Warehouse,
	ProductStock.Premise AS Premise,
	ProductStock.Warehouse.AccountingPriceType AS AccountingPriceType,
	ProductStock.Warehouse.RetailPriceType AS RetailPriceType,
	ProductStock.InStockOpeningBalance AS CountOpeningBalance,
	ProductStock.InStockReceipt AS CountReceipt,
	ProductStock.InStockExpense AS CountExpense,
	ProductStock.InStockClosingBalance AS CountClosingBalance
INTO BalanceAndTurnovers
FROM
	AccumulationRegister.ProductStock.BalanceAndTurnovers({&amp;BeginOfPeriod}, {&amp;EndOfPeriod}, Auto,, {(Products).* AS
		Products} {(Characteristic).* AS Characteristic} {(Warehouse).* AS Warehouse} {(Products, Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}) AS
		ProductStock
{WHERE
	ProductStock.Warehouse.*,
	ProductStock.Products.*,
	ProductStock.Characteristic.*,
	(CASE
		WHEN &amp;EstimationOfStocksByTypeOfPrices = 1
			THEN ProductStock.Warehouse.AccountingPriceType
		WHEN &amp;EstimationOfStocksByTypeOfPrices = 2
			THEN ProductStock.Warehouse.RetailPriceType
		WHEN &amp;EstimationOfStocksByTypeOfPrices = 3
			THEN &amp;PriceKind
		ELSE VALUE(Catalog.TypesOfPrices.EmptyRef)
	END) AS PriceTypeOfReport}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	BalanceAndTurnovers.AccountingPriceType AS PriceKind
INTO TypesOfPricesIndicatedInWarehouses
FROM
	BalanceAndTurnovers AS BalanceAndTurnovers
		INNER JOIN Catalog.TypesOfPrices AS CatalogOfPriceTypes
		ON BalanceAndTurnovers.AccountingPriceType = CatalogOfPriceTypes.Ref
WHERE
	&amp;EstimationOfStocksByTypeOfPrices = 1

UNION

SELECT
	BalanceAndTurnovers.RetailPriceType AS PriceKind
FROM
	BalanceAndTurnovers AS BalanceAndTurnovers
		INNER JOIN Catalog.TypesOfPrices AS CatalogOfPriceTypes
		ON BalanceAndTurnovers.RetailPriceType = CatalogOfPriceTypes.Ref
WHERE
	&amp;EstimationOfStocksByTypeOfPrices = 2

UNION

SELECT
	&amp;PriceKind AS PriceKind
WHERE
	&amp;EstimationOfStocksByTypeOfPrices = 3
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemsPrices.Recorder AS Recorder,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Products AS Products,
	CASE
		WHEN
			ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
			THEN ItemsPrices.Products
		WHEN
			ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
			THEN ItemsPrices.Products.ProductKind
		WHEN
			ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
			THEN ItemsPrices.Products.ItemVariantsOwner
		ELSE UNDEFINED
	END AS ItemVariantsOwner,
	ItemsPrices.PricingVariant AS PricingVariant,
	ItemsPrices.PricingBatch AS PricingBatch,
	ItemsPrices.PricingPackage AS PricingPackage,
	MAX(ItemsPrices.Period) AS Period
INTO ItemsPricesPreliminary
FROM
	InformationRegister.ItemsPrices25 AS ItemsPrices
WHERE
	TRUE IN
		(SELECT TOP 1
			TRUE
		FROM
			BalanceAndTurnovers AS BalanceAndTurnovers
		WHERE
			BalanceAndTurnovers.Products = ItemsPrices.Products)
	AND ItemsPrices.PriceKind IN
		(SELECT
			PriceKind
		FROM
			TypesOfPricesIndicatedInWarehouses AS TypesOfPricesIndicatedInWarehouses)	
{WHERE
	ItemsPrices.Period &lt;= &amp;EndOfPeriod,
	ItemsPrices.Products.* AS Products}
GROUP BY
	ItemsPrices.Recorder,
	ItemsPrices.PriceKind,
	ItemsPrices.Products,
	CASE
		WHEN
			ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
			THEN ItemsPrices.Products
		WHEN
			ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
			THEN ItemsPrices.Products.ProductKind
		WHEN
			ItemsPrices.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
			THEN ItemsPrices.Products.ItemVariantsOwner
		ELSE UNDEFINED
	END,
	ItemsPrices.PricingVariant,
	ItemsPrices.PricingBatch,
	ItemsPrices.PricingPackage

INDEX BY
	Products,
	PricingVariant,
	ItemVariantsOwner
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemsPrices.Period AS Period,
	ItemsPrices.Recorder AS Recorder,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Products AS Products,
	ISNULL(ItemsCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS
		Characteristic,
	ItemsPrices.PricingVariant AS PricingVariant,
	ItemsPrices.PricingBatch AS PricingBatch,
	ItemsPrices.PricingPackage AS PricingPackage
INTO ItemsPrices
FROM
	ItemsPricesPreliminary AS ItemsPrices
		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON ItemsPrices.ItemVariantsOwner = ItemsCharacteristics.Owner
WHERE
	ItemsPrices.PricingVariant = VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
{WHERE
	ItemsCharacteristics.Ref.* AS Characteristic}

UNION

SELECT
	ItemsPrices.Period AS Period,
	ItemsPrices.Recorder AS Recorder,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Products AS Products,
	ISNULL(ItemsCharacteristics.Ref, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS
		Characteristic,
	ItemsPrices.PricingVariant AS PricingVariant,
	ItemsPrices.PricingBatch AS PricingBatch,
	ItemsPrices.PricingPackage AS PricingPackage
FROM
	ItemsPricesPreliminary AS ItemsPrices
		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON ItemsPrices.PricingVariant = ItemsCharacteristics.ItemsCharacteristicForPricing
WHERE
	ItemsPrices.PricingVariant &lt;&gt; VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
{WHERE
	ItemsCharacteristics.Ref.* AS Characteristic}

INDEX BY
	Products,
	PricingVariant,
	PricingPackage,
	PricingBatch,
	PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemsPrices.Period AS Period,
	ItemsPrices.Recorder AS Recorder,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Products AS Products,
	ItemsPrices.Characteristic AS Characteristic,
	ItemsPrices.PricingVariant AS PricingVariant,
	ItemsPrices.PricingBatch AS PricingBatch,
	ItemsPrices.PricingPackage AS PricingPackage,
	MAX(PricesBeforeChanges.Period) AS DateOfLastChange
INTO Price_Table
FROM
	ItemsPrices AS ItemsPrices
		LEFT JOIN InformationRegister.ItemsPrices25 AS PricesBeforeChanges
		ON ItemsPrices.Period &gt; PricesBeforeChanges.Period
		AND ItemsPrices.Products = PricesBeforeChanges.Products
		AND ItemsPrices.PricingVariant = PricesBeforeChanges.PricingVariant
		AND ItemsPrices.PricingBatch = PricesBeforeChanges.PricingBatch
		AND ItemsPrices.PricingPackage = PricesBeforeChanges.PricingPackage
		AND PricesBeforeChanges.PriceKind IN
			(SELECT
				PriceKind
			FROM
				TypesOfPricesIndicatedInWarehouses AS TypesOfPricesIndicatedInWarehouses)
{WHERE
	ItemsPrices.Period &lt;= &amp;EndOfPeriod,
	ItemsPrices.Products.* AS Products,
	ItemsPrices.Characteristic.* AS Characteristic}
GROUP BY
	ItemsPrices.Period,
	ItemsPrices.Recorder,
	ItemsPrices.PriceKind,
	ItemsPrices.Products,
	ItemsPrices.Characteristic,
	ItemsPrices.PricingVariant,
	ItemsPrices.PricingBatch,
	ItemsPrices.PricingPackage
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Price_Table.Period AS Period,
	Price_Table.Recorder AS Recorder,
	Price_Table.Products AS Products,
	Price_Table.Characteristic AS Characteristic,
	Price_Table.PriceKind AS PriceKind,
	&amp;CurrentPrice AS Price,
	&amp;OldPrice AS OldPrice,
	&amp;Delta AS Delta
INTO ChangesOfPrices
FROM
	Price_Table AS Price_Table
		LEFT JOIN InformationRegister.ItemsPrices25 AS PricesOfProduct
		ON Price_Table.Period = PricesOfProduct.Period
		AND Price_Table.Products = PricesOfProduct.Products
		AND Price_Table.PricingVariant = PricesOfProduct.PricingVariant
		AND Price_Table.PricingBatch = PricesOfProduct.PricingBatch
		AND Price_Table.PricingPackage = PricesOfProduct.PricingPackage
		AND Price_Table.PriceKind = PricesOfProduct.PriceKind
		LEFT JOIN InformationRegister.ItemsPrices25 AS PricesOfProductB
		ON Price_Table.DateOfLastChange = PricesOfProductB.Period
		AND Price_Table.Products = PricesOfProductB.Products
		AND Price_Table.PricingVariant = PricesOfProductB.PricingVariant
		AND Price_Table.PricingBatch = PricesOfProductB.PricingBatch
		AND Price_Table.PricingPackage = PricesOfProductB.PricingPackage
		AND Price_Table.PriceKind = PricesOfProductB.PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ChangesOfPrices.Period AS Period,
	ChangesOfPrices.Recorder AS Recorder,
	ChangesOfPrices.Delta AS Delta,
	ChangesOfPrices.Price AS Price,
	ChangesOfPrices.OldPrice AS OldPrice,
	GoodsOfOrganizationsBalancesAndTurnover.Products AS Products,
	GoodsOfOrganizationsBalancesAndTurnover.Characteristic AS Characteristic,
	GoodsOfOrganizationsBalancesAndTurnover.Warehouse AS Warehouse,
	GoodsOfOrganizationsBalancesAndTurnover.Premise AS Premise,
	MAX(GoodsOfOrganizationsBalancesAndTurnover.Period) AS PeriodMaximum
INTO NearestRemnantsByProductType
FROM
	ChangesOfPrices AS ChangesOfPrices
		LEFT JOIN BalanceAndTurnovers AS GoodsOfOrganizationsBalancesAndTurnover
		ON ChangesOfPrices.Period &gt;= GoodsOfOrganizationsBalancesAndTurnover.Period
		AND ChangesOfPrices.Products = GoodsOfOrganizationsBalancesAndTurnover.Products
		AND ChangesOfPrices.Characteristic = GoodsOfOrganizationsBalancesAndTurnover.Characteristic
		AND CASE
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 1
				THEN ChangesOfPrices.PriceKind = GoodsOfOrganizationsBalancesAndTurnover.AccountingPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 2
				THEN ChangesOfPrices.PriceKind = GoodsOfOrganizationsBalancesAndTurnover.RetailPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 3
				THEN ChangesOfPrices.PriceKind = &amp;PriceKind
			ELSE FALSE
		END
{WHERE
	GoodsOfOrganizationsBalancesAndTurnover.Products.* AS Products,
	GoodsOfOrganizationsBalancesAndTurnover.Characteristic.* AS Characteristic}
GROUP BY
	ChangesOfPrices.Period,
	ChangesOfPrices.Recorder,
	ChangesOfPrices.Delta,
	ChangesOfPrices.Price,
	ChangesOfPrices.OldPrice,
	GoodsOfOrganizationsBalancesAndTurnover.Products,
	GoodsOfOrganizationsBalancesAndTurnover.Characteristic,
	GoodsOfOrganizationsBalancesAndTurnover.Warehouse,
	GoodsOfOrganizationsBalancesAndTurnover.Premise
HAVING
	MAX(GoodsOfOrganizationsBalancesAndTurnover.Period) IS NOT NULL

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	BalanceTable.Period AS Period,
	BalanceTable.Products AS Products,
	BalanceTable.Characteristic AS Characteristic,
	BalanceTable.Warehouse AS Warehouse,
	BalanceTable.Premise AS Premise,
	MAX(BalanceTable.Recorder) AS Recorder
INTO RegistrarMaximumByPeriod
FROM
	BalanceAndTurnovers AS BalanceTable
WHERE
	TRUE IN
	(SELECT TOP 1
		TRUE
	FROM
		NearestRemnantsByProductType AS NearestBalance
	WHERE
		BalanceTable.Period = NearestBalance.PeriodMaximum
		AND BalanceTable.Products = NearestBalance.Products
		AND BalanceTable.Characteristic = NearestBalance.Characteristic
		AND BalanceTable.Warehouse = NearestBalance.Warehouse
		AND BalanceTable.Premise = NearestBalance.Premise)
GROUP BY
	BalanceTable.Period,
	BalanceTable.Products,
	BalanceTable.Characteristic,
	BalanceTable.Warehouse,
	BalanceTable.Premise

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	T.Period AS Period,
	T.Recorder AS Recorder,
	T.Delta AS Delta,
	T.Price AS Price,
	T.OldPrice AS OldPrice,
	T.Products AS Products,
	T.Characteristic AS Characteristic,
	T.Warehouse AS Warehouse,
	T.Premise AS Premise,
	T.PeriodMaximum AS PeriodMaximum,
	RegistrarMaximumByPeriod.Recorder AS LoggerMax
INTO NearestRemnantsByProductName
FROM
	NearestRemnantsByProductType AS T
		LEFT JOIN RegistrarMaximumByPeriod AS RegistrarMaximumByPeriod
		ON RegistrarMaximumByPeriod.Products = T.Products
		AND RegistrarMaximumByPeriod.Characteristic = T.Characteristic
		AND RegistrarMaximumByPeriod.Warehouse = T.Warehouse
		AND RegistrarMaximumByPeriod.Premise = T.Premise
		AND RegistrarMaximumByPeriod.Period = T.PeriodMaximum
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProductStock.Period AS MovementPeriod,
	ProductStock.Recorder AS Recorder,
	ProductStock.Products AS Products,
	ProductStock.Characteristic AS Characteristic,
	ProductStock.Warehouse AS Warehouse,
	ProductStock.AccountingPriceType AS AccountingPriceType,
	ProductStock.RetailPriceType AS RetailPriceType,
	ProductStock.Premise AS Premise,
	ProductStock.CountOpeningBalance AS CountOpeningBalance,
	ProductStock.CountReceipt AS CountReceipt,
	ProductStock.CountExpense AS CountExpense,
	ProductStock.CountClosingBalance AS CountClosingBalance,
	MAX(ItemsPrices.Period) AS PeriodMaximum
INTO TableGoodsInWarehousesMaximumPeriod
FROM
	BalanceAndTurnovers AS ProductStock
		LEFT JOIN ChangesOfPrices AS ItemsPrices
		ON ProductStock.Products = ItemsPrices.Products
		AND ProductStock.Characteristic = ItemsPrices.Characteristic
		AND ProductStock.Period &gt;= ItemsPrices.Period
		AND CASE
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 1
				THEN ItemsPrices.PriceKind = ProductStock.AccountingPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 2
				THEN ItemsPrices.PriceKind = ProductStock.RetailPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 3
				THEN ItemsPrices.PriceKind = &amp;PriceKind
			ELSE FALSE
		END
{WHERE
	ProductStock.Products.* AS Products,
	ProductStock.Characteristic.* AS Characteristic}
GROUP BY
	ProductStock.Period,
	ProductStock.Recorder,
	ProductStock.Products,
	ProductStock.Characteristic,
	ProductStock.Warehouse,
	ProductStock.Premise,
	ProductStock.CountOpeningBalance,
	ProductStock.CountReceipt,
	ProductStock.CountExpense,
	ProductStock.CountClosingBalance,
	ProductStock.AccountingPriceType,
	ProductStock.RetailPriceType

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TypesOfPrices.PriceCurrency AS Currency,
	TypesOfPrices.Ref AS PriceKind,
	TableGoodsInWarehousesMaximumPeriod.MovementPeriod AS SecondPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, MINUTE) AS MinutePeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, HOUR) AS HourPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, DAY) AS DayPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, YEAR) AS YearPeriod,
	TableGoodsInWarehousesMaximumPeriod.Recorder AS Recorder,
	TableGoodsInWarehousesMaximumPeriod.Warehouse AS Warehouse,
	TableGoodsInWarehousesMaximumPeriod.Premise AS Premise,
	TableGoodsInWarehousesMaximumPeriod.Products AS Products,
	TableGoodsInWarehousesMaximumPeriod.Products.UnitOfMeasure AS StorageUnit,
	TableGoodsInWarehousesMaximumPeriod.Products.UnitForReports AS UnitForReports,
	TableGoodsInWarehousesMaximumPeriod.Characteristic AS Characteristic,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0) /
						TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountOpeningBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0) /
						TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountClosingBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0) /
						TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountReceipt,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountExpense, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountExpense, 0) /
						TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountExpense,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0) * &amp;QueryTextItemWeight1 AS
		StartBalanceWeight,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0) * &amp;QueryTextItemWeight1 AS
		ClosingBalanceWeight,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0) * &amp;QueryTextItemWeight1 AS ReceiptWeight,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountExpense, 0) * &amp;QueryTextItemWeight1 AS ConsumptionWeight,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0) *
		&amp;QueryTextTheVolumeOfTheItem1 AS StartBalanceVolume,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0) * &amp;QueryTextTheVolumeOfTheItem1 AS
		ClosingBalanceVolume,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0) * &amp;QueryTextTheVolumeOfTheItem1 AS
		ReceiptVolume,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountExpense, 0) * &amp;QueryTextTheVolumeOfTheItem1 AS
		ConsumptionVolume,
	ISNULL(ItemsPrices.Price * TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0) AS
		SumOpeningBalance,
	ISNULL(ItemsPrices.Price * TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0) AS SumReceipt,
	ISNULL(ItemsPrices.Price * TableGoodsInWarehousesMaximumPeriod.CountExpense, 0) AS SumExpense,
	ISNULL(ItemsPrices.Price * TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0) AS
		SumClosingBalance,
	0 AS IncreasePrice,
	0 AS ReducePrice,
	0 AS Revaluation
{SELECT
	Currency.*,
	PriceKind.*,
	SecondPeriod,
	MinutePeriod,
	HourPeriod,
	DayPeriod,
	WeekPeriod,
	MonthPeriod,
	QuarterPeriod,
	YearPeriod,
	Recorder.*,
	Warehouse.*,
	Premise.*,
	Products.*,
	StorageUnit.*,
	UnitForReports.*,
	Characteristic.*,
	CountOpeningBalance,
	CountClosingBalance,
	CountReceipt,
	CountExpense,
	StartBalanceWeight,
	ClosingBalanceWeight,
	ReceiptWeight,
	ConsumptionWeight,
	StartBalanceVolume,
	ClosingBalanceVolume,
	ReceiptVolume,
	ConsumptionVolume,
	SumOpeningBalance,
	SumReceipt,
	SumExpense,
	SumClosingBalance,
	IncreasePrice,
	ReducePrice,
	Revaluation}
FROM
	TableGoodsInWarehousesMaximumPeriod AS TableGoodsInWarehousesMaximumPeriod
		LEFT JOIN ChangesOfPrices AS ItemsPrices
		ON TableGoodsInWarehousesMaximumPeriod.Products = ItemsPrices.Products
		AND TableGoodsInWarehousesMaximumPeriod.Characteristic = ItemsPrices.Characteristic
		AND TableGoodsInWarehousesMaximumPeriod.PeriodMaximum = ItemsPrices.Period
		AND CASE
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 1
				THEN ItemsPrices.PriceKind = TableGoodsInWarehousesMaximumPeriod.AccountingPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 2
				THEN ItemsPrices.PriceKind = TableGoodsInWarehousesMaximumPeriod.RetailPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 3
				THEN ItemsPrices.PriceKind = &amp;PriceKind
			ELSE FALSE
		END
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON CASE
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 1
				THEN TypesOfPrices.Ref = TableGoodsInWarehousesMaximumPeriod.AccountingPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 2
				THEN TypesOfPrices.Ref = TableGoodsInWarehousesMaximumPeriod.RetailPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 3
				THEN TypesOfPrices.Ref = &amp;PriceKind
			ELSE FALSE
		END
{WHERE
	TypesOfPrices.PriceCurrency.* AS Currency,
	TypesOfPrices.Ref.* AS PriceKind,
	TableGoodsInWarehousesMaximumPeriod.MovementPeriod AS SecondPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, MINUTE) AS MinutePeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, HOUR) AS HourPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, DAY) AS DayPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(TableGoodsInWarehousesMaximumPeriod.MovementPeriod, YEAR) AS YearPeriod,
	TableGoodsInWarehousesMaximumPeriod.Recorder.*,
	TableGoodsInWarehousesMaximumPeriod.Warehouse.*,
	TableGoodsInWarehousesMaximumPeriod.Premise.*,
	TableGoodsInWarehousesMaximumPeriod.Products.*,
	TableGoodsInWarehousesMaximumPeriod.Products.UnitOfMeasure.* AS UnitOfMeasure,
	TableGoodsInWarehousesMaximumPeriod.Products.UnitForReports.* AS UnitForReports,
	TableGoodsInWarehousesMaximumPeriod.Characteristic.*,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0) /
						TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountOpeningBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0) /
						TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountClosingBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0) /
						TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountReceipt,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountExpense, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(TableGoodsInWarehousesMaximumPeriod.CountExpense, 0) /
						TableGoodsInWarehousesMaximumPeriod.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountExpense,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0) * &amp;QueryTextItemWeight1 AS
		StartBalanceWeight,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0) * &amp;QueryTextItemWeight1 AS
		ClosingBalanceWeight,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0) * &amp;QueryTextItemWeight1 AS ReceiptWeight,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountExpense, 0) * &amp;QueryTextItemWeight1 AS ConsumptionWeight,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0) * &amp;QueryTextTheVolumeOfTheItem1
		AS StartBalanceVolume,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0) * &amp;QueryTextTheVolumeOfTheItem1 AS
		ClosingBalanceVolume,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0) * &amp;QueryTextTheVolumeOfTheItem1 AS
		ReceiptVolume,
	ISNULL(TableGoodsInWarehousesMaximumPeriod.CountExpense, 0) * &amp;QueryTextTheVolumeOfTheItem1 AS
		ConsumptionVolume,
	ISNULL(ItemsPrices.Price * TableGoodsInWarehousesMaximumPeriod.CountOpeningBalance, 0) AS
		SumOpeningBalance,
	ISNULL(ItemsPrices.Price * TableGoodsInWarehousesMaximumPeriod.CountReceipt, 0) AS SumReceipt,
	ISNULL(ItemsPrices.Price * TableGoodsInWarehousesMaximumPeriod.CountExpense, 0) AS SumExpense,
	ISNULL(ItemsPrices.Price * TableGoodsInWarehousesMaximumPeriod.CountClosingBalance, 0) AS
		SumClosingBalance,
	0 AS IncreasePrice,
	0 AS ReducePrice,
	0 AS Revaluation}

UNION ALL

SELECT
	TypesOfPrices.PriceCurrency,
	TypesOfPrices.Ref,
	NearestRemnantsByProductName.Period,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, MINUTE),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, HOUR),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, DAY),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, WEEK),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, MONTH),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, QUARTER),
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, YEAR),
	NearestRemnantsByProductName.Recorder,
	NearestRemnantsByProductName.Warehouse,
	NearestRemnantsByProductName.Premise,
	NearestRemnantsByProductName.Products,
	NearestRemnantsByProductName.Products.UnitOfMeasure,
	NearestRemnantsByProductName.Products.UnitForReports,
	NearestRemnantsByProductName.Characteristic,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN NearestRemnantsByProductName.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) /
						NearestRemnantsByProductName.Products.UnitFactorForReports
				ELSE 0
			END
	END,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN NearestRemnantsByProductName.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) /
						NearestRemnantsByProductName.Products.UnitFactorForReports
				ELSE 0
			END
	END,
	0,
	0,
	ISNULL(GoodsInWarehousesBalancesAndTurnover.CountOpeningBalance, 0) * &amp;QueryTextItemWeight2,
	ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) * &amp;QueryTextItemWeight2,
	0,
	0,
	ISNULL(GoodsInWarehousesBalancesAndTurnover.CountOpeningBalance, 0) * &amp;QueryTextTheVolumeOfTheItem2,
	ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) * &amp;QueryTextTheVolumeOfTheItem2,
	0,
	0,
	ISNULL(NearestRemnantsByProductName.OldPrice * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0),
	0,
	0,
	ISNULL(NearestRemnantsByProductName.Price * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0),
	CASE
		WHEN NearestRemnantsByProductName.Delta &gt; 0
			THEN ISNULL(NearestRemnantsByProductName.Delta * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0)
		ELSE 0
	END,
	CASE
		WHEN NearestRemnantsByProductName.Delta &lt; 0
			THEN ISNULL(-NearestRemnantsByProductName.Delta * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance,
				0)
		ELSE 0
	END,
	ISNULL(NearestRemnantsByProductName.Delta * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0)
FROM
	NearestRemnantsByProductName AS NearestRemnantsByProductName
		LEFT JOIN BalanceAndTurnovers AS GoodsInWarehousesBalancesAndTurnover
		ON NearestRemnantsByProductName.PeriodMaximum = GoodsInWarehousesBalancesAndTurnover.Period
		AND NearestRemnantsByProductName.LoggerMax = GoodsInWarehousesBalancesAndTurnover.Recorder
		AND NearestRemnantsByProductName.Warehouse = GoodsInWarehousesBalancesAndTurnover.Warehouse
		AND NearestRemnantsByProductName.Premise = GoodsInWarehousesBalancesAndTurnover.Premise
		AND NearestRemnantsByProductName.Products = GoodsInWarehousesBalancesAndTurnover.Products
		AND NearestRemnantsByProductName.Characteristic = GoodsInWarehousesBalancesAndTurnover.Characteristic
		LEFT JOIN Catalog.TypesOfPrices AS TypesOfPrices
		ON CASE
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 1
				THEN TypesOfPrices.Ref = GoodsInWarehousesBalancesAndTurnover.AccountingPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 2
				THEN TypesOfPrices.Ref = GoodsInWarehousesBalancesAndTurnover.RetailPriceType
			WHEN &amp;EstimationOfStocksByTypeOfPrices = 3
				THEN TypesOfPrices.Ref = &amp;PriceKind
			ELSE FALSE
		END
{WHERE
	GoodsInWarehousesBalancesAndTurnover.Period &lt;= &amp;EndOfPeriod,
	TypesOfPrices.PriceCurrency.* AS Currency,
	TypesOfPrices.Ref.* AS PriceKind,
	NearestRemnantsByProductName.Period AS SecondPeriod,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, MINUTE) AS MinutePeriod,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, HOUR) AS HourPeriod,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(NearestRemnantsByProductName.Period, YEAR) AS YearPeriod,
	NearestRemnantsByProductName.Recorder.*,
	NearestRemnantsByProductName.Warehouse.*,
	NearestRemnantsByProductName.Premise.*,
	NearestRemnantsByProductName.Products.*,
	NearestRemnantsByProductName.Products.UnitOfMeasure.* AS UnitOfMeasure,
	NearestRemnantsByProductName.Products.UnitForReports.* AS UnitForReports,
	NearestRemnantsByProductName.Characteristic.*,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN NearestRemnantsByProductName.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) /
						NearestRemnantsByProductName.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountOpeningBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN NearestRemnantsByProductName.Products.UnitFactorForReports &lt;&gt; 0
					THEN ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) /
						NearestRemnantsByProductName.Products.UnitFactorForReports
				ELSE 0
			END
	END AS ClosingBalanceWeight,
	0 AS CountReceipt,
	0 AS CountExpense,
	ISNULL(GoodsInWarehousesBalancesAndTurnover.CountOpeningBalance, 0) * &amp;QueryTextItemWeight2 AS
		StartBalanceWeight,
	ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) * &amp;QueryTextItemWeight2 AS
		ClosingBalanceWeight,
	0 AS ReceiptWeight,
	0 AS ConsumptionWeight,
	ISNULL(GoodsInWarehousesBalancesAndTurnover.CountOpeningBalance, 0) * &amp;QueryTextTheVolumeOfTheItem2 AS
		StartBalanceVolume,
	ISNULL(GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) * &amp;QueryTextTheVolumeOfTheItem2 AS
		ClosingBalanceVolume,
	0 AS ReceiptVolume,
	0 AS ConsumptionVolume,
	ISNULL(NearestRemnantsByProductName.OldPrice * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) AS
		SumOpeningBalance,
	0 AS SumReceipt,
	0 AS SumExpense,
	ISNULL(NearestRemnantsByProductName.Price * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) AS
		SumClosingBalance,
	CASE
		WHEN NearestRemnantsByProductName.Delta &gt; 0
			THEN ISNULL(NearestRemnantsByProductName.Delta * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0)
		ELSE 0
	END AS IncreasePrice,
	CASE
		WHEN NearestRemnantsByProductName.Delta &lt; 0
			THEN ISNULL(-NearestRemnantsByProductName.Delta * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance,
				0)
		ELSE 0
	END AS ReducePrice,
	ISNULL(NearestRemnantsByProductName.Delta * GoodsInWarehousesBalancesAndTurnover.CountClosingBalance, 0) AS
		Revaluation}</query>
	</dataSet>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
