			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountClosingBalance)
End", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountOpeningBalance)
End", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>CountReceipt</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountReceipt)
End", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>CountExpense</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountExpense)
End", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>SumClosingBalance</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(SumClosingBalance)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>SumOpeningBalance</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(SumOpeningBalance)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>SumReceipt</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(SumReceipt)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>SumExpense</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(SumExpense)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceWeight</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(ClosingBalanceWeight)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceVolume</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(ClosingBalanceVolume)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>StartBalanceWeight</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(StartBalanceWeight)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>StartBalanceVolume</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(StartBalanceVolume)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>ReceiptWeight</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(ReceiptWeight)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>ReceiptVolume</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(ReceiptVolume)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>ConsumptionWeight</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(ConsumptionWeight)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>ConsumptionVolume</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(ConsumptionVolume)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>IncreasePrice</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(IncreasePrice)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>ReducePrice</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(ReducePrice)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>Revaluation</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(Revaluation)", "Products, Characteristic",,&amp;ValueOfSelectionByResources))</expression>
	</totalField>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountClosingBalance)
End</expression>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountOpeningBalance)
End</expression>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>CountReceipt</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountReceipt)
End</expression>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>CountExpense</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountExpense)
End</expression>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>SumClosingBalance</dataPath>
		<expression>Sum(SumClosingBalance)</expression>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>SumOpeningBalance</dataPath>
		<expression>Sum(SumOpeningBalance)</expression>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
