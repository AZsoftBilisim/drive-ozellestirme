		<field xsi:type="DataSetFieldField">
			<dataPath>PerformerRole</dataPath>
			<field>PerformerRole</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Role</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نقش</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Ruolo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Rola</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Роль</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Rol</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Vai trò</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Users.Ref AS User,
	TaskPerformers.PerformerRole,
	TaskPerformers.MainAddressingObject,
	TaskPerformers.AdditionalAddressingObject
FROM
	Catalog.Users AS Users
		LEFT JOIN InformationRegister.TaskPerformers AS TaskPerformers
		ON (TaskPerformers.Performer = Users.Ref)
{WHERE
	Users.Ref.* AS User,
	TaskPerformers.PerformerRole.*}</query>
	</dataSet>
