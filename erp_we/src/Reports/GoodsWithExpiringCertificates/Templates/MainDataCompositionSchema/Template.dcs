		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ProductStockBalance.Warehouse AS Warehouse,
	ProductStockBalance.Products AS Products,
	ProductStockBalance.Characteristic AS Characteristic,
	ProductStockBalance.Series AS Series,
	ProductStockBalance.InStockBalance - ProductStockBalance.ToShipBalance AS AvailableStock
INTO WarehouseStockBalance
FROM
	AccumulationRegister.ProductStock.Balance(,
			Products.KeepRecordsOfQualityCertificates) AS ProductStockBalance

WHERE
	ProductStockBalance.InStockBalance - ProductStockBalance.ToShipBalance &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	CertificateScopes.ProductKind AS ProductKind,
	CertificateScopes.Products AS Products,
	CertificateScopes.Characteristic AS Characteristic,
	CertificateScopes.Series AS Series,
	CertificatesData.CertificateType AS CertificateType
INTO TypesOfCertificatesByScope
FROM
	InformationRegister.QualityCertificateApplicationAreas AS CertificateScopes
		LEFT JOIN Catalog.QualityCertificates AS CertificatesData
		ON CertificateScopes.QualityCertificate = CertificatesData.Ref

INDEX BY
	ProductKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	TypesOfCertificatesByScope.ProductKind AS ProductKind,
	TypesOfCertificatesByScope.Products AS Products,
	TypesOfCertificatesByScope.Characteristic AS Characteristic,
	TypesOfCertificatesByScope.Series AS Series,
	CertificatesData.Ref AS QualityCertificate,
	CAST(TypesOfCertificatesByScope.CertificateType AS STRING(50)) AS CertificateType,
	CASE
		WHEN CertificatesData.Status = VALUE(Enum.StatusesOfQualityCertificates.Valid_)
			THEN CASE
					WHEN CertificatesData.Permanent
						THEN DATETIME(3999, 12, 31, 23, 59, 59)
					ELSE CertificatesData.ValidTo
				END
		ELSE DATETIME(1, 1, 1, 0, 0, 0)
	END AS Expiration,
	CertificatesData.StatusOfRAC AS StatusOfRAC,
	0 AS PriorityOfStatusOfRosaccreditation
INTO AreasOfValidityOfCertificatesByType
FROM
	TypesOfCertificatesByScope AS TypesOfCertificatesByScope
		LEFT JOIN InformationRegister.QualityCertificateApplicationAreas AS CertificateScopes
		ON TypesOfCertificatesByScope.ProductKind = CertificateScopes.ProductKind
			AND (TypesOfCertificatesByScope.Products = CertificateScopes.Products
					AND TypesOfCertificatesByScope.Characteristic = CertificateScopes.Characteristic
					AND TypesOfCertificatesByScope.Series = CertificateScopes.Series
				OR TypesOfCertificatesByScope.Products = CertificateScopes.Products
					AND TypesOfCertificatesByScope.Characteristic = CertificateScopes.Characteristic
					AND CertificateScopes.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
				OR TypesOfCertificatesByScope.Products = CertificateScopes.Products
					AND CertificateScopes.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
					AND CertificateScopes.Series = VALUE(Catalog.ItemsBatches.EmptyRef)
				OR CertificateScopes.Products = VALUE(Catalog.Products.EmptyRef)
					AND CertificateScopes.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
					AND CertificateScopes.Series = VALUE(Catalog.ItemsBatches.EmptyRef))
			AND TypesOfCertificatesByScope.CertificateType = CertificateScopes.QualityCertificate.CertificateType
		
		LEFT JOIN Catalog.QualityCertificates AS CertificatesData
		ON CertificateScopes.QualityCertificate = CertificatesData.Ref

INDEX BY
	ProductKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CertificateScopes.ProductKind AS ProductKind,
	CertificateScopes.Products AS Products,
	CertificateScopes.Characteristic AS Characteristic,
	CertificateScopes.Series AS Series,
	CertificateScopes.CertificateType AS CertificateType,
	MAX(CertificateScopes.Expiration) AS Expiration,
	MIN(CertificateScopes.PriorityOfStatusOfRosaccreditation) AS PriorityOfStatusOfRosaccreditation
INTO CertificateScopesGroupedByType
FROM
	AreasOfValidityOfCertificatesByType AS CertificateScopes

GROUP BY
	CertificateScopes.ProductKind,
	CertificateScopes.Products,
	CertificateScopes.Characteristic,
	CertificateScopes.Series,
	CertificateScopes.CertificateType
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CertificateScopesGrouped.ProductKind AS ProductKind,
	CertificateScopesGrouped.Products AS Products,
	CertificateScopesGrouped.Characteristic AS Characteristic,
	CertificateScopesGrouped.Series AS Series,
	CertificateScopesGrouped.CertificateType AS CertificateType,
	CertificateScopesGrouped.Expiration AS Expiration,
	MAX(CertificateScopes.StatusOfRAC) AS StatusOfRAC,
	CertificateScopesGrouped.PriorityOfStatusOfRosaccreditation AS PriorityOfStatusOfRosaccreditation
INTO SummaryTable
FROM
	CertificateScopesGroupedByType AS CertificateScopesGrouped
		LEFT JOIN AreasOfValidityOfCertificatesByType AS CertificateScopes
		ON CertificateScopesGrouped.ProductKind = CertificateScopes.ProductKind
			AND CertificateScopesGrouped.Products = CertificateScopes.Products
			AND CertificateScopesGrouped.Characteristic = CertificateScopes.Characteristic
			AND CertificateScopesGrouped.Series = CertificateScopes.Series
			AND CertificateScopesGrouped.CertificateType = CertificateScopes.CertificateType
			AND CertificateScopesGrouped.PriorityOfStatusOfRosaccreditation = CertificateScopes.PriorityOfStatusOfRosaccreditation

GROUP BY
	CertificateScopesGrouped.ProductKind,
	CertificateScopesGrouped.Products,
	CertificateScopesGrouped.Characteristic,
	CertificateScopesGrouped.Series,
	CertificateScopesGrouped.CertificateType,
	CertificateScopesGrouped.Expiration,
	CertificateScopesGrouped.PriorityOfStatusOfRosaccreditation

INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	StockBalance.Warehouse AS Warehouse,
	SummaryTable.ProductKind AS ProductKind,
	SummaryTable.Products AS Products,
	ISNULL(StockBalance.Characteristic, SummaryTable.Characteristic) AS Characteristic,
	ISNULL(StockBalance.Series, SummaryTable.Series) AS Series,
	SummaryTable.CertificateType AS CertificateType,
	SummaryTable.Expiration AS Expiration,
	SummaryTable.Expiration AS State,
	SummaryTable.StatusOfRAC AS StatusOfRAC,
	SummaryTable.PriorityOfStatusOfRosaccreditation AS PriorityOfStatusOfRosaccreditation
FROM
	SummaryTable AS SummaryTable
		LEFT JOIN WarehouseStockBalance AS StockBalance
		ON SummaryTable.Products = StockBalance.Products
			AND (SummaryTable.Characteristic = StockBalance.Characteristic
				OR SummaryTable.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef))
			AND (SummaryTable.Series = StockBalance.Series
				OR SummaryTable.Series = VALUE(Catalog.ItemsBatches.EmptyRef))
{WHERE
	(SummaryTable.Expiration &gt;= &amp;DateHideCertificates),
	(SummaryTable.Expiration &lt; &amp;InvalidAsOfTheDate)}</query>
	</dataSet>
	<totalField>
		<dataPath>Expiration</dataPath>
		<expression>Min( Case When Expiration = DateTime(1, 1, 1, 0, 0, 0) Then DateTime(3999, 12, 31, 23, 59, 58) Else Expiration End)</expression>
		<group>Products</group>
		<group>CertificateType</group>
	</totalField>
	<totalField>
		<dataPath>State</dataPath>
		<expression>Min( Case When Expiration = DateTime(1, 1, 1, 0, 0, 0) Then DateTime(3999, 12, 31, 23, 59, 58) Else Expiration End)</expression>
		<group>Products</group>
		<group>CertificateType</group>
	</totalField>
	<totalField>
		<dataPath>PriorityOfStatusOfRosaccreditation</dataPath>
		<expression>Min(PriorityOfStatusOfRosaccreditation)</expression>
		<group>Products</group>
		<group>CertificateType</group>
	</totalField>
	<totalField>
		<dataPath>StatusOfRAC</dataPath>
		<expression>Max(StatusOfRAC)</expression>
		<group>Products</group>
		<group>CertificateType</group>
	</totalField>
