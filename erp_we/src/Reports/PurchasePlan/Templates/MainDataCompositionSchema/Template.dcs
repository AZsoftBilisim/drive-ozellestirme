		<field xsi:type="DataSetFieldField">
			<dataPath>Period</dataPath>
			<field>Period</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Additional</dcscom:periodType>
			</role>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Format</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>DF=MM/dd/yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>DF=MM/dd/yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>DF=dd.MM.yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>DF=dd.MM.yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>DF=dd.MM.yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>DF=dd.MM.yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>DF=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN PurchasePlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN PurchasePlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN PurchasePlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN PurchasePlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN PurchasePlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN PurchasePlansTurnovers.YearPeriod
		ELSE PurchasePlansTurnovers.DayPeriod
	END AS Period,
	PurchasePlansTurnovers.Products,
	PurchasePlansTurnovers.Characteristic,
	PurchasePlansTurnovers.Department,
	PurchasePlansTurnovers.Warehouse,
	PurchasePlansTurnovers.Partner,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN PurchasePlansTurnovers.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN PurchasePlansTurnovers.Products.UnitFactorForReports &lt;&gt; 0
					THEN PurchasePlansTurnovers.CountTurnover / PurchasePlansTurnovers.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountTurnover
FROM
	AccumulationRegister.PurchasePlans.Turnovers({(&amp;StartDate)}, {(&amp;EndDate)}, Auto, &amp;GenerationMethod = 0) AS PurchasePlansTurnovers

UNION ALL

SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(PurchasePlansTurnovers.OrderDate, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(PurchasePlansTurnovers.OrderDate, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(PurchasePlansTurnovers.OrderDate, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(PurchasePlansTurnovers.OrderDate, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(PurchasePlansTurnovers.OrderDate, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(PurchasePlansTurnovers.OrderDate, YEAR)
		ELSE BEGINOFPERIOD(PurchasePlansTurnovers.OrderDate, DAY)
	END AS Period,
	PurchasePlansTurnovers.Products,
	PurchasePlansTurnovers.Characteristic,
	PurchasePlansTurnovers.Department,
	PurchasePlansTurnovers.Warehouse,
	PurchasePlansTurnovers.Partner,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN PurchasePlansTurnovers.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN PurchasePlansTurnovers.Products.UnitFactorForReports &lt;&gt; 0
					THEN PurchasePlansTurnovers.CountTurnover / PurchasePlansTurnovers.Products.UnitFactorForReports
				ELSE 0
			END
	END AS CountTurnover
FROM
	AccumulationRegister.PurchasePlans.Turnovers(,,, &amp;GenerationMethod = 1
		AND (&amp;StartDate    = DATETIME(1, 1, 1) OR OrderDate &gt;= &amp;StartDate)
		AND (&amp;EndDate = DATETIME(1, 1, 1) OR OrderDate &lt;= &amp;EndDate)) AS PurchasePlansTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>CountTurnover</dataPath>
		<expression>Sum(CountTurnover)</expression>
	</totalField>
