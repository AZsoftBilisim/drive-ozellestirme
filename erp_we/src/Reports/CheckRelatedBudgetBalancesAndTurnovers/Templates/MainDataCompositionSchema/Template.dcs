<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>CalculationsRules</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>CalculationRule</dataPath>
			<field>CalculationRule</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Calculation rule</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>قاعده محاسبه</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Правило расчета</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Hesaplama kuralı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Quy tắc tính</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Calculation rule</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Calculation rule</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:required>true</dcscom:required>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Receiver</dataPath>
			<field>Receiver</field>
			<role>
				<dcscom:required>true</dcscom:required>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Source</dataPath>
			<field>Source</field>
			<role>
				<dcscom:required>true</dcscom:required>
			</role>
			<presentationExpression>Case When SourceType = Value(Enum.DataSourceTypesForBudgeting.BudgetTurnovers) Then Source Else SourceType End</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>SourceType</dataPath>
			<field>SourceType</field>
			<useRestriction>
				<field>true</field>
				<group>true</group>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
			</attributeUseRestriction>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RuleForCalculatingRelatedBudgetBalancesAndTurnovers.Ref AS CalculationRule,
	RuleForCalculatingRelatedBudgetBalancesAndTurnovers.Receiver AS Receiver,
	RuleForCalculatingRelatedBudgetBalancesAndTurnovers.Source AS Source,
	RuleForCalculatingRelatedBudgetBalancesAndTurnovers.SourceType AS SourceType
FROM
	Catalog.RuleForCalculatingRelatedBudgetBalancesAndTurnovers AS RuleForCalculatingRelatedBudgetBalancesAndTurnovers
WHERE
	NOT RuleForCalculatingRelatedBudgetBalancesAndTurnovers.DeletionMark
	AND RuleForCalculatingRelatedBudgetBalancesAndTurnovers.Status = VALUE(Enum.BudgetingRuleStatuses.Valid)
{WHERE
	RuleForCalculatingRelatedBudgetBalancesAndTurnovers.Ref.* AS CalculationRule,
	RuleForCalculatingRelatedBudgetBalancesAndTurnovers.Receiver.* AS Receiver,
	RuleForCalculatingRelatedBudgetBalancesAndTurnovers.Source.* AS Source,
	RuleForCalculatingRelatedBudgetBalancesAndTurnovers.SourceType.* AS SourceType}</query>
	</dataSet>
