		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DimensionOfExpenses</dataPath>
			<field>DimensionOfExpenses</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ExpenseItem</dataPath>
			<field>ExpenseItem</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineOfBusiness</dataPath>
			<field>LineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Recorder</dataPath>
			<field>Recorder</field>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE
		WHEN &amp;Periodicity = "Day"
			THEN BEGINOFPERIOD(ISNULL(DeferredExpenseAllocation.Date, OtherExpenses.Period), DAY)
		ELSE BEGINOFPERIOD(ISNULL(DeferredExpenseAllocation.Date, OtherExpenses.Period), MONTH)
	END AS Period,
	SUM(CASE
		WHEN OtherExpenses.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN CASE
				WHEN &amp;ReportData = 1
					THEN CASE
						WHEN
							OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
							THEN OtherExpenses.AmountExcludingVAT
						ELSE 0
					END
				WHEN &amp;ReportData = 2
					THEN CASE
						WHEN
							OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
							THEN OtherExpenses.SumMan
						ELSE 0
					END
				WHEN &amp;ReportData = 3
					THEN CASE
						WHEN
							OtherExpenses.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
							THEN OtherExpenses.SumCompl
						ELSE 0
					END
				WHEN &amp;ReportData = 4
					THEN CASE
						WHEN
							OtherExpenses.ExpenseItem.CostAllocationOptionTax = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
							THEN OtherExpenses.SumCompl - OtherExpenses.PermanentDifference - OtherExpenses.CostTD
						ELSE 0
					END
				ELSE CASE
					WHEN
						OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
						THEN OtherExpenses.Sum
					ELSE 0
				END
			END
		ELSE 0
	END) AS Receipt,
	SUM(CASE
		WHEN OtherExpenses.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN CASE
				WHEN &amp;ReportData = 1
					THEN CASE
						WHEN
							OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
							THEN OtherExpenses.AmountExcludingVAT
						ELSE 0
					END
				WHEN &amp;ReportData = 2
					THEN CASE
						WHEN
							OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
							THEN OtherExpenses.SumMan
						ELSE 0
					END
				WHEN &amp;ReportData = 3
					THEN CASE
						WHEN
							OtherExpenses.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
							THEN OtherExpenses.SumCompl
						ELSE 0
					END
				WHEN &amp;ReportData = 4
					THEN CASE
						WHEN
							OtherExpenses.ExpenseItem.CostAllocationOptionTax = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
							THEN OtherExpenses.SumCompl - OtherExpenses.PermanentDifference - OtherExpenses.CostTD
						ELSE 0
					END
				ELSE CASE
					WHEN
						OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
						THEN OtherExpenses.Sum
					ELSE 0
				END
			END
		ELSE 0
	END) AS Expense,
	OtherExpenses.Recorder AS Recorder
FROM
	AccumulationRegister.OtherExpenses AS OtherExpenses
		LEFT JOIN Document.DeferredExpensesAllocation AS DeferredExpenseAllocation
		ON OtherExpenses.Recorder = DeferredExpenseAllocation.Ref
{WHERE
	OtherExpenses.Organization.*,
	OtherExpenses.Department.*,
	OtherExpenses.LineOfBusiness.*,
	OtherExpenses.ExpenseItem.*,
	OtherExpenses.DimensionOfExpenses.*}
WHERE
	ISNULL(CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN
					OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
					THEN OtherExpenses.AmountExcludingVAT
				ELSE 0
			END
		WHEN &amp;ReportData = 2
			THEN CASE
				WHEN
					OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
					THEN OtherExpenses.SumMan
				ELSE 0
			END
		WHEN &amp;ReportData = 3
			THEN CASE
				WHEN
					OtherExpenses.ExpenseItem.CostAllocationOptionLocal = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
					THEN OtherExpenses.SumCompl
				ELSE 0
			END
		WHEN &amp;ReportData = 4
			THEN CASE
				WHEN
					OtherExpenses.ExpenseItem.CostAllocationOptionTax = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
					THEN OtherExpenses.SumCompl - OtherExpenses.PermanentDifference - OtherExpenses.CostTD
				ELSE 0
			END
		ELSE CASE
			WHEN
				OtherExpenses.ExpenseItem.CostAllocationOptionManag = VALUE(Enum.CostAllocationOptions.ToDeferredExpenses)
				THEN OtherExpenses.Sum
			ELSE 0
		END
	END, 0) &lt;&gt; 0
GROUP BY
	OtherExpenses.Recorder,
	CASE
		WHEN &amp;Periodicity = "Day"
			THEN BEGINOFPERIOD(ISNULL(DeferredExpenseAllocation.Date, OtherExpenses.Period), DAY)
		ELSE BEGINOFPERIOD(ISNULL(DeferredExpenseAllocation.Date, OtherExpenses.Period), MONTH)
	END

ORDER BY
	Recorder</query>
	</dataSet>
