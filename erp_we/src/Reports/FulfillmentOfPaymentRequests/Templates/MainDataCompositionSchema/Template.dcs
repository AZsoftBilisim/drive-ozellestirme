		<dataSource>DataSource1</dataSource>
		<query>SELECT
	NULL AS DocumentPayments,
	BankAccountCashAccount,
	SumReceipt AS SumPlan,
	0 AS SumReal,
	0 AS Closed
{SELECT
	DocumentPayments,
	BankAccountCashAccount.*,
	SumPlan,
	SumReal,
	Closed}
FROM
	AccumulationRegister.CashToBePaid.Turnovers(,, Recorder, {PaymentRequest})
WHERE
	(Recorder REFS Document.PaymentRequest
	OR Recorder REFS Document.ApplicationForBusinessTrip)
	AND SumReceipt &gt; 0
	
UNION ALL

SELECT
	NULL AS DocumentPayments,
	BankAccountCashAccount,
	0 AS SumPlan,
	0 AS SumReal,
	-SumReceipt AS Closed
FROM
	AccumulationRegister.CashToBePaid.Turnovers(,, Recorder, {PaymentRequest})
WHERE
	(Recorder REFS Document.PaymentRequest
	OR Recorder REFS Document.ApplicationForBusinessTrip)
	AND SumReceipt &lt; 0
	
UNION ALL

SELECT
	Recorder AS DocumentPayments,
	BankAccountCashAccount,
	0 AS SumPlan,
	SumExpense AS SumReal,
	0 AS Closed
FROM
	AccumulationRegister.CashToBePaid.Turnovers(,, Recorder, {PaymentRequest})
WHERE
	VALUETYPE(Recorder) IN (
		TYPE(Document.BankAccountIssue),
		TYPE(Document.CashVoucher),
		TYPE(Document.PaymentCardTransaction),
		TYPE(Document.ReversingEntry)
	)</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>RemainsToPay</dataPath>
		<expression>SumPlan - SumReal - Closed</expression>
		<title xsi:type="v8:LocalStringType">
