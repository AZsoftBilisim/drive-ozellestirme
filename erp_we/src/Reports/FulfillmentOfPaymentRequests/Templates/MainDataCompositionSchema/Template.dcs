			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">16</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MaxWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">16</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<totalField>
		<dataPath>RemainsToPay</dataPath>
		<expression>Sum(SumPlan) - Sum(SumReal) - Sum(Closed)</expression>
	</totalField>
	<totalField>
		<dataPath>SumPlan</dataPath>
		<expression>Sum(SumPlan)</expression>
	</totalField>
	<totalField>
		<dataPath>SumReal</dataPath>
		<expression>Sum(SumReal)</expression>
	</totalField>
	<totalField>
		<dataPath>RemainsToPay</dataPath>
		<expression>0</expression>
		<group>DocumentPayments</group>
	</totalField>
	<totalField>
		<dataPath>Closed</dataPath>
		<expression>Sum(Closed)</expression>
	</totalField>
