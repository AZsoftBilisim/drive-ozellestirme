		<dataSource>DataSource1</dataSource>
		<objectName>TaskTable_</objectName>
	</dataSet>
	<calculatedField>
		<dataPath>Performer</dataPath>
		<expression>Case 
	When ValueIsFilled(BudgetingStepBasis) Then 
		Case When BudgetingStepBasis.ExecuteAutomatically 
		Then &amp;TitleAutomatically 
		Else PerformerOriginal 
		End 
	When ValueIsFilled(BudgetingStep) Then 
		Case When BudgetingStep.ExecuteAutomatically 
		Then &amp;TitleAutomatically 
		Else PerformerOriginal 
		End 
	Else PerformerOriginal 
End</expression>
		<title xsi:type="v8:LocalStringType">
