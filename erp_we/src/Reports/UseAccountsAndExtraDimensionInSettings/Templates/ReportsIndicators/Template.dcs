		<dataSource>DataSource1</dataSource>
		<query>SELECT
	FinancialReportItems.Owner AS ReportKind,
	FinancialReportItems.NameForPrinting AS ElementDescription,
	FinancialReportItems.Ref AS ReportItem,
	FormulaIndicators.Id AS Id,
	FormulaIndicators.Ref.NameForPrinting AS DerivedIndicatorName,
	FormulaIndicators.Ref AS DerivedItem,
	FinancialReportItems.AdditionalSelection AS AdditionalSelection,
	FinancialReportItems.HasSettings AS HasFilter,
	AdditionalElementTypeDetails.Value AS Account,
	FALSE AS Dimension
INTO ItemsByAccount
FROM
	Catalog.FinancialReportItems.ItemKindAttributes AS AdditionalElementTypeDetails
		LEFT JOIN Catalog.FinancialReportItems.FormulaOperands AS FormulaIndicators
		ON AdditionalElementTypeDetails.Ref = FormulaIndicators.Operand
		LEFT JOIN Catalog.FinancialReportItems AS FinancialReportItems
		ON AdditionalElementTypeDetails.Ref = FinancialReportItems.Ref
WHERE
	AdditionalElementTypeDetails.Attribute = VALUE(ChartOfCharacteristicTypes.ItemAttributesOfFinancialReports.GLAccount_)
	AND AdditionalElementTypeDetails.Value = &amp;GLAccount_
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	FinancialReportItems.Owner AS ReportKind,
	FinancialReportItems.NameForPrinting AS ElementDescription,
	FinancialReportItems.Ref AS ReportItem,
	FormulaIndicators.Id AS Id,
	FormulaIndicators.Ref.NameForPrinting AS DerivedIndicatorName,
	FormulaIndicators.Ref AS DerivedItem,
	FinancialReportItems.AdditionalSelection AS AdditionalSelection,
	FinancialReportItems.HasSettings AS HasFilter,
	AdditionalElementTypeDetails.Value AS Account,
	TRUE AS Dimension
INTO ExtdimensionElements
FROM
	Catalog.FinancialReportItems.ItemKindAttributes AS AdditionalElementTypeDetails
		LEFT JOIN Catalog.FinancialReportItems.FormulaOperands AS FormulaIndicators
		ON AdditionalElementTypeDetails.Ref = FormulaIndicators.Operand
		LEFT JOIN Catalog.FinancialReportItems AS FinancialReportItems
		ON AdditionalElementTypeDetails.Ref = FinancialReportItems.Ref
WHERE
	AdditionalElementTypeDetails.Attribute = VALUE(ChartOfCharacteristicTypes.ItemAttributesOfFinancialReports.ExtDimensionType)
	AND AdditionalElementTypeDetails.Value = &amp;ExtDimensionType
	AND FinancialReportItems.ItemKind = VALUE(Enum.FinancialReportItemKinds.Dimension)

;

////////////////////////////////////////////////////////////////////////////////
SELECT
	FinancialReportItems.Owner AS ReportKind,
	FinancialReportItems.NameForPrinting AS ElementDescription,
	FinancialReportItems.Ref AS ReportItem,
	FormulaIndicators.Id AS Id,
	FormulaIndicators.Ref.NameForPrinting AS DerivedIndicatorName,
	FormulaIndicators.Ref AS DerivedItem,
	FinancialReportItems.AdditionalSelection,
	UNDEFINED AS Account,
	FALSE AS Dimension
FROM
	Catalog.FinancialReportItems AS FinancialReportItems
		LEFT JOIN Catalog.FinancialReportItems.FormulaOperands AS FormulaIndicators
		ON FinancialReportItems.Ref = FormulaIndicators.Operand
WHERE
	FinancialReportItems.HasSettings
	AND VALUETYPE(FinancialReportItems.Owner) = TYPE(Catalog.FinancialReportTypes)
	AND NOT FinancialReportItems.Ref IN (SELECT ItemsByAccount.ReportItem FROM ItemsByAccount UNION ALL SELECT ExtdimensionElements.ReportItem FROM ExtdimensionElements)

UNION ALL

SELECT
	ItemsByAccount.ReportKind,
	ItemsByAccount.ElementDescription,
	ItemsByAccount.ReportItem,
	ItemsByAccount.Id,
	ItemsByAccount.DerivedIndicatorName,
	ItemsByAccount.DerivedItem,
	ItemsByAccount.AdditionalSelection,
	ItemsByAccount.Account,
	ItemsByAccount.Dimension
FROM
	ItemsByAccount AS ItemsByAccount
	
	UNION ALL

SELECT
	ExtdimensionElements.ReportKind,
	ExtdimensionElements.ElementDescription,
	ExtdimensionElements.ReportItem,
	ExtdimensionElements.Id,
	ExtdimensionElements.DerivedIndicatorName,
	ExtdimensionElements.DerivedItem,
	ExtdimensionElements.AdditionalSelection,
	ExtdimensionElements.Account,
	ExtdimensionElements.Dimension
FROM
	ExtdimensionElements AS ExtdimensionElements</query>
	</dataSet>
