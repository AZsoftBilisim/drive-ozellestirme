		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PostingTemplates.Ref AS PostingTemplate,
	PostingTemplates.DrAccountDefault AS DefaultAccountDr,
	VALUE(Enum.AccountingMovementKinds.Debit) AS RecordType,
	PostingTemplates.Operation AS BusinessTransaction,
	PostingTemplates.CrAccountDefault AS DefaultAccountCr,
	PostingTemplates.Description AS TemplateDescription,
	UNDEFINED AS FinancialAccountingGroup,
	PostingTemplates.AdditionalSelection AS AdditionalSelection,
	PostingTemplates.DrAccountDefault AS AccountToCheck
FROM
	Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
WHERE
	PostingTemplates.DrAccountDefault = &amp;Account

UNION ALL

SELECT
	PostingTemplates.Ref,
	PostingTemplates.DrAccountDefault,
	VALUE(Enum.AccountingMovementKinds.Credit),
	PostingTemplates.Operation,
	PostingTemplates.CrAccountDefault,
	PostingTemplates.Description,
	UNDEFINED,
	PostingTemplates.AdditionalSelection,
	PostingTemplates.CrAccountDefault
FROM
	Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
WHERE
	PostingTemplates.CrAccountDefault = &amp;Account

UNION ALL

SELECT
	PostingTemplates.Ref AS PostingTemplate,
	PostingTemplates.DrAccountDefault AS DefaultAccountDr,
	VALUE(Enum.AccountingMovementKinds.Debit) AS RecordType,
	PostingTemplates.Operation AS BusinessTransaction,
	PostingTemplates.CrAccountDefault AS DefaultAccountCr,
	PostingTemplates.Description AS TemplateDescription,
	UNDEFINED AS FinancialAccountingGroup,
	PostingTemplates.AdditionalSelection,
	UNDEFINED
FROM
	Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
WHERE
	PostingTemplates.DrAccountDefault &lt;&gt; &amp;Account
	AND PostingTemplates.CrAccountDefault  &lt;&gt; &amp;Account 

UNION ALL

SELECT
	RulesForClarifyingInvoices.PostingTemplate,
	PostingTemplates.DrAccountDefault,
	RulesForClarifyingInvoices.RecordType,
	PostingTemplates.Operation,
	PostingTemplates.CrAccountDefault,
	PostingTemplates.Description,
	RulesForClarifyingInvoices.FinancialAccountingGroup,
	UNDEFINED,
	RulesForClarifyingInvoices.GLAccount
FROM
	InformationRegister.RulesOfSpecifyingAccountsFinancialAccounting AS RulesForClarifyingInvoices
		INNER JOIN Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
		ON RulesForClarifyingInvoices.PostingTemplate = PostingTemplates.Ref
WHERE
	RulesForClarifyingInvoices.GLAccount = &amp;Account</query>
	</dataSet>
