				<dataSource>DataSource1</dataSource>
				<query>SELECT
	"Debit" AS DebitCredit,
	RecordSettings.PostingGenerationSetting AS PostingGenerationSetting,
	RecordSettings.AccountingObjectDr AS AccountingObjectDr,
	RecordSettings.AccountingObjectCr AS AccountingObjectCr,
	RecordSettings.ApplicationProcedure AS ApplicationProcedure
FROM
	InformationRegister.SettingsForReflectingCorrespondenceInFinancialAccounting AS RecordSettings
WHERE
	RecordSettings.GLAccountDr = &amp;GLAccount_
	
UNION ALL

SELECT
	"Credit" AS DebitCredit,
	RecordSettings.PostingGenerationSetting AS PostingGenerationSetting,
	RecordSettings.AccountingObjectDr AS AccountingObjectDr,
	RecordSettings.AccountingObjectCr AS AccountingObjectCr,
	RecordSettings.ApplicationProcedure AS ApplicationProcedure
FROM
	InformationRegister.SettingsForReflectingCorrespondenceInFinancialAccounting AS RecordSettings
WHERE
	RecordSettings.GLAccountCr = &amp;GLAccount_</query>
