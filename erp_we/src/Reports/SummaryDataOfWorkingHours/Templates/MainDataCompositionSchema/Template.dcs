		<field xsi:type="DataSetFieldField">
			<dataPath>Organization</dataPath>
			<field>Organization</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TimesheetData.Organization AS Organization,
	TimesheetData.Employee AS Employee,
	TimesheetData.TimeKind AS TimeKind,
	TimesheetData.DaysTurnover AS Days,
	CASE
		WHEN TimesheetData.TimeKind.UnitOfMeasure = VALUE(Enum.TimeMeasureUnits.HOUR)
			THEN TimesheetData.Hours1Turnover
		ELSE TimesheetData.TimeKind.NumberOfHoursPerDay * TimesheetData.DaysTurnover
	END AS Hours1,
	EmploymentRecordSliceLast.JobTitle AS JobTitle,
	EmploymentRecordSliceLast.Department AS Department
FROM
	AccumulationRegister.DataOnEmployeeTimesheet.Turnovers(,,,) AS TimesheetData
		LEFT JOIN InformationRegister.EmploymentRecord.SliceLast(,) AS EmploymentRecordSliceLast
		ON TimesheetData.Organization = EmploymentRecordSliceLast.Organization
		AND TimesheetData.Employee = EmploymentRecordSliceLast.Employee
		AND EmploymentRecordSliceLast.WorksInBusinessUnit</query>
	</dataSet>
	<totalField>
		<dataPath>Days</dataPath>
		<expression>Sum(Days)</expression>
	</totalField>
	<totalField>
		<dataPath>Hours1</dataPath>
		<expression>Sum(Hours1)</expression>
	</totalField>
