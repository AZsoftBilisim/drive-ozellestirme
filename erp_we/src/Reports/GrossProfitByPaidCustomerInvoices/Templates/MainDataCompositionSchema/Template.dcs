	<calculatedField>
		<dataPath>ProfitFromPaymentDeductRefunds</dataPath>
		<expression>Case When (Revenue - ReturnAmount) &lt;&gt; 0 Then
    ((Revenue - ReturnAmount) - (Cost_ - ReturnCost))
     * (Case When ShipmentInReportPeriod Then
            Revenue - ReturnAmount - RemainingAmountDueForPayment
        Else
            PaidWithoutShipment - ReturnAmount
        End)
     / (Revenue - ReturnAmount)
Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Profit from payment taking into account returns</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
