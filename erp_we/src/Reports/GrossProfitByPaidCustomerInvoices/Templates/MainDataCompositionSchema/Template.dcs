	<calculatedField>
		<dataPath>ProfitFromPayment</dataPath>
		<expression>Case When Revenue &lt;&gt; 0 Then
	(Revenue - Cost_ ) * (Case When ShipmentInReportPeriod Then
		Revenue - RemainingAmountDueForPayment
	Else
		PaidWithoutShipment
	End) / Revenue
Else 0
End</expression>
