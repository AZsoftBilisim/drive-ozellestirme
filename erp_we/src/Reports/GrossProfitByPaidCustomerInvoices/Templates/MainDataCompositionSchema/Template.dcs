					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MarkNegatives</dcscor:parameter>
				<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">16</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MaxWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">16</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<totalField>
		<dataPath>Cost_</dataPath>
		<expression>Case
    When Sum(Cost_) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Cost_), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(Cost_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Revenue</dataPath>
		<expression>Case
    When Sum(Revenue) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Revenue), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(Revenue)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PaymentForPeriod</dataPath>
		<expression>Case
    When Sum(PaymentForPeriod) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(PaymentForPeriod), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(PaymentForPeriod)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ProfitFromPayment</dataPath>
		<expression>Case
    When Sum(ProfitFromPayment) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ProfitFromPayment), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ProfitFromPayment)
End</expression>
	</totalField>
	<totalField>
		<dataPath>TotalProfit</dataPath>
		<expression>Case
    When Sum(TotalProfit) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(TotalProfit), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(TotalProfit)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PayPercentage</dataPath>
		<expression>Case When Sum(Revenue) &lt;&gt; 0 Then
	(1 - Sum(RemainingAmountDueForPayment) / Sum(Revenue)) * 100
Else
	0
End</expression>
	</totalField>
	<totalField>
		<dataPath>ProfitFromPaymentDeductRefunds</dataPath>
		<expression>Case
    When Sum(ProfitFromPaymentDeductRefunds) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ProfitFromPaymentDeductRefunds), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ProfitFromPaymentDeductRefunds)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ProfitFullDeductRefunds</dataPath>
		<expression>Case
    When Sum(ProfitFullDeductRefunds) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ProfitFullDeductRefunds), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ProfitFullDeductRefunds)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CostOfPaid</dataPath>
		<expression>Case
    When Sum(CostOfPaid) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(CostOfPaid), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(CostOfPaid)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ReturnedProfits</dataPath>
		<expression>Case
    When Sum(ReturnedProfits) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ReturnedProfits), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ReturnedProfits)
End</expression>
	</totalField>
	<totalField>
		<dataPath>RemainingAmountDueForPayment</dataPath>
		<expression>Case
    When Sum(RemainingAmountDueForPayment) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(RemainingAmountDueForPayment), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(RemainingAmountDueForPayment)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ReturnAmount</dataPath>
		<expression>Case
    When Sum(ReturnAmount) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ReturnAmount), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ReturnAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ReturnCost</dataPath>
		<expression>Case
    When Sum(ReturnCost) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ReturnCost), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ReturnCost)
End</expression>
	</totalField>
	<totalField>
		<dataPath>FullPayment</dataPath>
		<expression>Case
    When Sum(FullPayment) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(FullPayment), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(FullPayment)
End</expression>
	</totalField>
