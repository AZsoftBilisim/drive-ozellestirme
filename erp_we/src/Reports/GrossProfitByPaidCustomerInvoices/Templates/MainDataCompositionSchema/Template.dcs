				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>There is no debt by AR/AP documents</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>// Tags are used
SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	CalculationOfCostOfOrganization.Ref.PreliminaryCalculation AS PreliminaryCalculation,
	BEGINOFPERIOD(CalculationOfCostOfOrganization.Ref.Date, MONTH) AS Date,
	CalculationOfCostOfOrganization.Organization AS Organization
INTO CalculationOfCostOfOrganization
FROM
	Document.InventoryCostCalculation.Companies AS CalculationOfCostOfOrganization
WHERE
	CalculationOfCostOfOrganization.Ref.Posted
	AND CalculationOfCostOfOrganization.Ref.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)

INDEX BY
	Date,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	CustomersARAPAccountingBalance.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CustomersARAPAccountingBalance.SalesOrder AS SalesOrder,
	CustomersARAPAccountingBalance.ARAPDocument AS ARAPDocument,
	CustomersARAPAccountingBalance.Currency AS Currency,
	CustomersARAPAccountingBalance.DebtBalance AS DebtBalance,
	CustomersARAPAccountingBalance.ARAPManBalance AS ARAPManBalance,
	CustomersARAPAccountingBalance.DebtLocalBalance AS DebtLocalBalance
INTO CustomersARAPAccountingBalance
FROM
	AccumulationRegister.CustomersARAPAccountingByDocuments.Balance(&amp;PeriodEndBoundary,) AS CustomersARAPAccountingBalance
WHERE
	NOT &amp;NewOnlineARAPAccounting
{WHERE
	CustomersARAPAccountingBalance.AccountingDimensionByPartners.Organization.* AS Organization,
	CustomersARAPAccountingBalance.AccountingDimensionByPartners.Partner.* AS Partner,
	(CustomersARAPAccountingBalance.AccountingDimensionByPartners.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

UNION ALL

SELECT
	Register.AccountingDimensionByPartners,
	Register.ARAPObject,
	Register.ARAPDocument,
	Register.Currency,
	Register.DebtBalance,
	Register.ARAPManBalance,
	Register.DebtLocalBalance
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(&amp;PeriodEndBoundary,) AS Register
WHERE
	&amp;NewOnlineARAPAccounting
{WHERE
	Register.AccountingDimensionByPartners.Organization.* AS Organization,
	Register.AccountingDimensionByPartners.Partner.* AS Partner,
	(Register.AccountingDimensionByPartners.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

INDEX BY
	AccountingDimensionByPartners,
	SalesOrder,
	ARAPDocument,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	Register.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Dimension.Organization AS Organization,
	Dimension.Partner AS Partner,
	Register.ARAPObject AS ARAPObject,
	Register.ARAPDocument AS ARAPDocument,
	Register.Currency AS Currency,
	Register.DebtReceipt AS DebtReceipt,
	Register.DebtLocalExpense AS DebtLocalExpense,
	Register.ARAPManExpense AS ARAPManExpense
INTO TTTurnoverSettlementsWithCustomers
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod,,) AS Register
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS Dimension
		ON Register.AccountingDimensionByPartners = Dimension.DimensionKey
WHERE
	(&amp;ShowSales_ = 1
	AND Dimension.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	OR &amp;ShowSales_ = 2
	AND Dimension.Partner = VALUE(Catalog.Partners.OurEnterprise)
	OR &amp;ShowSales_ = 0)
	AND VALUETYPE(Register.ARAPDocument) IN (&amp;APARDocumentTypes)
	AND &amp;NewOnlineARAPAccounting
	AND NOT
	(CASE WHEN VALUETYPE(Register.ARAPDocument) = TYPE(Document.CustomerInvoiceServices)
		THEN CAST(Register.ARAPDocument AS Document.CustomerInvoiceServices).ARAPObjectSettings
	 WHEN VALUETYPE(Register.ARAPDocument) = TYPE(Document.RedemptionOfGoodsByCustodian)
		THEN CAST(Register.ARAPDocument AS Document.RedemptionOfGoodsByCustodian).ARAPObjectSettings
	
	 WHEN VALUETYPE(Register.ARAPDocument) = TYPE(Document.ReportToMaterialProvider2_5)
		THEN CAST(Register.ARAPDocument AS Document.ReportToMaterialProvider2_5).ARAPObjectSettings
	 WHEN VALUETYPE(Register.ARAPDocument) = TYPE(Document.ConsumptionReportSubcontractingServicesDeliveredIntercompany)
		THEN CAST(Register.ARAPDocument AS Document.ConsumptionReportSubcontractingServicesDeliveredIntercompany).ARAPObjectSettings
	 WHEN VALUETYPE(Register.ARAPDocument) = TYPE(Document.CustomerInvoice)
		THEN CAST(Register.ARAPDocument AS Document.CustomerInvoice).ARAPObjectSettings
	 WHEN VALUETYPE(Register.ARAPDocument) = TYPE(Document.CustomerInvoiceIntercompany)
		THEN CAST(Register.ARAPDocument AS Document.CustomerInvoiceIntercompany).ARAPObjectSettings
	END = VALUE(Enum.ARAPObjectSettings.OrderForPrepaymentInvoiceForInvoice)
	AND Register.ARAPObject.ARAPObjectType = VALUE(Enum.ARAPObjectTypes.OrderDocument))
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	CustomersARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	DimensionByPartners.Organization AS Organization,
	DimensionByPartners.Partner AS Partner,
	CustomersARAPAccounting.ARAPDocument AS ARAPDocument,
	CASE
		WHEN &amp;ReportData = 3
			THEN ISNULL(CustomersARAPAccountingBalance.DebtLocalBalance, 0)
		ELSE ISNULL(CustomersARAPAccountingBalance.ARAPManBalance, 0)
	END AS RemainingAmountDueForPayment,
	ISNULL(CustomersARAPAccountingBalance.DebtBalance, 0) AS DebtBalance,
	CASE
		WHEN &amp;ReportData = 3
			THEN SUM(CustomersARAPAccounting.DebtLocalExpense)
		ELSE SUM(CustomersARAPAccounting.ARAPManExpense)
	END AS PaidWithoutShipment,
	CASE
		WHEN SUM(CustomersARAPAccounting.DebtReceipt) = 0
			THEN FALSE
		ELSE TRUE
	END AS ShipmentInReportPeriod,
	CASE
		WHEN CustomersARAPAccounting.SalesOrder.Object REFS Document.SalesOrder
		AND CustomersARAPAccounting.SalesOrder.Object &lt;&gt; CustomersARAPAccounting.ARAPDocument
			THEN CustomersARAPAccounting.SalesOrder.Object
		ELSE NULL
	END AS SalesOrder
INTO Payments
FROM
	AccumulationRegister.CustomersARAPAccountingByDocuments.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto,) AS CustomersARAPAccounting
		{INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
		LEFT JOIN CustomersARAPAccountingBalance AS CustomersARAPAccountingBalance
		ON (CustomersARAPAccountingBalance.AccountingDimensionByPartners = CustomersARAPAccounting.AccountingDimensionByPartners)
		AND (CustomersARAPAccountingBalance.SalesOrder = CustomersARAPAccounting.SalesOrder)
		AND (CustomersARAPAccountingBalance.ARAPDocument = CustomersARAPAccounting.ARAPDocument)
		AND (CustomersARAPAccountingBalance.Currency = CustomersARAPAccounting.Currency)
WHERE
	(&amp;ShowSales_ = 1
	AND DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	OR &amp;ShowSales_ = 2
	AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	OR &amp;ShowSales_ = 0)
	AND VALUETYPE(CustomersARAPAccounting.ARAPDocument) IN (&amp;APARDocumentTypes)
	AND (CustomersARAPAccounting.DebtExpense &gt; 0
	OR CustomersARAPAccounting.DebtReceipt &gt; 0
	OR CustomersARAPAccounting.ARAPManExpense &gt; 0
	OR CustomersARAPAccounting.ARAPManReceipt &gt; 0
	OR CustomersARAPAccounting.DebtLocalExpense &gt; 0
	OR CustomersARAPAccounting.DebtLocalReceipt &gt; 0)
	AND NOT &amp;NewOnlineARAPAccounting
{WHERE
	DimensionByPartners.Organization.* AS Organization,
	DimensionByPartners.Partner.* AS Partner,
	(DimensionByPartners.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
GROUP BY
	CustomersARAPAccounting.AccountingDimensionByPartners,
	DimensionByPartners.Organization,
	DimensionByPartners.Partner,
	CustomersARAPAccounting.ARAPDocument,
	CustomersARAPAccountingBalance.DebtBalance,
	CustomersARAPAccountingBalance.ARAPManBalance,
	CustomersARAPAccountingBalance.DebtLocalBalance,
	CASE
		WHEN CustomersARAPAccounting.SalesOrder.Object REFS Document.SalesOrder
		AND CustomersARAPAccounting.SalesOrder.Object &lt;&gt; CustomersARAPAccounting.ARAPDocument
			THEN CustomersARAPAccounting.SalesOrder.Object
		ELSE NULL
	END

UNION ALL

SELECT
	CustomersARAPAccounting.AccountingDimensionByPartners,
	CustomersARAPAccounting.Organization,
	CustomersARAPAccounting.Partner,
	CustomersARAPAccounting.ARAPDocument,
	CASE
		WHEN &amp;ReportData = 3
			THEN ISNULL(CustomersARAPAccountingBalance.DebtLocalBalance, 0)
		ELSE ISNULL(CustomersARAPAccountingBalance.ARAPManBalance, 0)
	END,
	ISNULL(CustomersARAPAccountingBalance.DebtBalance, 0),
	CASE
		WHEN &amp;ReportData = 3
			THEN SUM(CustomersARAPAccounting.DebtLocalExpense)
		ELSE SUM(CustomersARAPAccounting.ARAPManExpense)
	END,
	CASE
		WHEN SUM(CustomersARAPAccounting.DebtReceipt) = 0
			THEN FALSE
		ELSE TRUE
	END,
	CASE
		WHEN CustomersARAPAccounting.ARAPObject.Object REFS Document.SalesOrder
		AND CustomersARAPAccounting.ARAPObject.Object &lt;&gt; CustomersARAPAccounting.ARAPDocument
			THEN CustomersARAPAccounting.ARAPObject.Object
		ELSE NULL
	END
FROM
	TTTurnoverSettlementsWithCustomers AS CustomersARAPAccounting
		LEFT JOIN CustomersARAPAccountingBalance AS CustomersARAPAccountingBalance
		ON (CustomersARAPAccountingBalance.AccountingDimensionByPartners = CustomersARAPAccounting.AccountingDimensionByPartners)
		AND (CustomersARAPAccountingBalance.SalesOrder = CustomersARAPAccounting.ARAPObject)
		AND (CustomersARAPAccountingBalance.ARAPDocument = CustomersARAPAccounting.ARAPDocument)
		AND (CustomersARAPAccountingBalance.Currency = CustomersARAPAccounting.Currency)
{WHERE
	CustomersARAPAccounting.Organization.* AS Organization,
	CustomersARAPAccounting.Partner.* AS Partner,
	(CustomersARAPAccounting.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
GROUP BY
	CustomersARAPAccounting.AccountingDimensionByPartners,
	CustomersARAPAccounting.Organization,
	CustomersARAPAccounting.Partner,
	CustomersARAPAccounting.ARAPDocument,
	CustomersARAPAccountingBalance.DebtBalance,
	CustomersARAPAccountingBalance.ARAPManBalance,
	CustomersARAPAccountingBalance.DebtLocalBalance,
	CASE
		WHEN CustomersARAPAccounting.ARAPObject.Object REFS Document.SalesOrder
		AND CustomersARAPAccounting.ARAPObject.Object &lt;&gt; CustomersARAPAccounting.ARAPDocument
			THEN CustomersARAPAccounting.ARAPObject.Object
		ELSE NULL
	END

INDEX BY
	ARAPDocument,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	BEGINOFPERIOD(Sales.Period, MONTH) AS Period,
	Sales.Department AS Department,
	CASE
		WHEN Sales.Manager = VALUE(Catalog.Users.EmptyRef)
			THEN ISNULL(Sales.SalesOrder.Manager, VALUE(Catalog.Users.EmptyRef))
		ELSE Sales.Manager
	END AS Manager,
	Sales.SalesOrder AS SalesOrder,
	Sales.ARAPDocument AS ARAPDocument,
	Sales.ItemsLocationAttributes AS ItemsLocationAttributes,
	Sales.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	Sales.InventoryType AS InventoryType,
	SUM(Sales.RevenueAmount) AS RevenueAmount,
	SUM(Sales.RevenueAmount) AS RevenueWithVAT,
	SUM(CASE
		WHEN &amp;ReportData = 1
			THEN Sales.RevenueAmount
		WHEN &amp;ReportData = 3
			THEN Sales.RevenueAmountExclVATLocal
		ELSE Sales.RevenueAmountExcludingVAT
	END) AS Revenue,
	SUM(Sales.Count) AS Count,
	SUM(Sales.Cost_) AS Cost_,
	SUM(Sales.CostExcludingVAT_) AS CostExcludingVAT_,
	SUM(Sales.CostLocal) AS CostLocal,
	SUM(Sales.AdditionalExpenseAmount) AS AdditionalExpenseAmount,
	SUM(Sales.AdditionalExpensesAmountExcludingVAT) AS AdditionalExpensesAmountExcludingVAT,
	SUM(Sales.AmountOfAdditionalLocalExpenses) AS AmountOfAdditionalLocalExpenses,
	SUM(Sales.SellingExpensesIncludingVAT) AS SellingExpensesIncludingVAT,
	SUM(Sales.SellingExpensesExcludingVAT) AS SellingExpensesExcludingVAT,
	SUM(Sales.SellingExpensesLocal) AS SellingExpensesLocal
INTO Sales
FROM
	(SELECT
		Sales.Period AS Period,
		Sales.Department AS Department,
		Sales.Manager AS Manager,
		Sales.SalesOrder AS SalesOrder,
		Payments.ARAPDocument AS ARAPDocument,
		Sales.ItemsLocationAttributes AS ItemsLocationAttributes,
		Sales.InventoryOwnerAttribute AS InventoryOwnerAttribute,
		Sales.InventoryType AS InventoryType,
		Sales.RevenueAmount AS RevenueAmount,
		Sales.RevenueAmountExcludingVAT AS RevenueAmountExcludingVAT,
		Sales.RevenueAmountExclVATLocal AS RevenueAmountExclVATLocal,
		Sales.Count AS Count,
		Sales.Cost + Sales.LaborCosts + Sales.ItemizedFixedCostsIncludingVAT + Sales.ItemizedVariableCostsIncludingVAT AS
			Cost_,
		Sales.CostExcludingVAT + Sales.LaborCosts + Sales.ItemizedFixedCostsExcludingVAT +
			Sales.ItemizedVariableCostsExcludingVAT AS CostExcludingVAT_,
		Sales.LocalCost + Sales.LaborCostsLocal + Sales.ItemizedFixedCostsCompl +
			Sales.ItemizedVariableCostsCompl AS CostLocal,
		Sales.AddExpensesForGoods AS AdditionalExpenseAmount,
		Sales.AdditionalExpensesExcludingVAT AS AdditionalExpensesAmountExcludingVAT,
		Sales.AddExpensesLocal AS AmountOfAdditionalLocalExpenses,
		Sales.SellingExpensesIncludingVAT AS SellingExpensesIncludingVAT,
		Sales.SellingExpensesExcludingVAT AS SellingExpensesExcludingVAT,
		Sales.SellingExpensesLocal AS SellingExpensesLocal
	FROM
		AccumulationRegister.RevenueAndCOGS AS Sales
			INNER JOIN Payments AS Payments
			ON (Payments.ARAPDocument = Sales.SalesOrder)
	WHERE
		NOT Sales.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomer),
			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods))

	UNION ALL

	SELECT
		Sales.Period,
		Sales.Department,
		Sales.Manager,
		Sales.SalesOrder,
		Payments.ARAPDocument,
		Sales.ItemsLocationAttributes,
		Sales.InventoryOwnerAttribute,
		Sales.InventoryType,
		Sales.RevenueAmount,
		Sales.RevenueAmountExcludingVAT,
		Sales.RevenueAmountExclVATLocal,
		Sales.Count,
		Sales.Cost + Sales.LaborCosts + Sales.ItemizedFixedCostsIncludingVAT + Sales.ItemizedVariableCostsIncludingVAT,
		Sales.CostExcludingVAT + Sales.LaborCosts + Sales.ItemizedFixedCostsExcludingVAT +
			Sales.ItemizedVariableCostsExcludingVAT,
		Sales.LocalCost + Sales.LaborCostsLocal + Sales.ItemizedFixedCostsCompl +
			Sales.ItemizedVariableCostsCompl,
		Sales.AddExpensesForGoods,
		Sales.AdditionalExpensesExcludingVAT,
		Sales.AddExpensesLocal,
		Sales.SellingExpensesIncludingVAT AS SellingExpensesIncludingVAT,
		Sales.SellingExpensesExcludingVAT AS SellingExpensesExcludingVAT,
		Sales.SellingExpensesLocal AS SellingExpensesLocal
	FROM
		AccumulationRegister.RevenueAndCOGS AS Sales
			INNER JOIN Payments AS Payments
			ON (Payments.ARAPDocument = Sales.DocumentRegisterRecords)
			AND (Payments.ARAPDocument &lt;&gt; Sales.SalesOrder)
			AND (Payments.SalesOrder = Sales.SalesOrder
			OR Payments.SalesOrder IS NULL)
	WHERE
		NOT Sales.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ReverseOfSale),
			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomer),
			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods))

	UNION ALL

	SELECT
		Sales.Period,
		Sales.Department,
		Sales.Manager,
		Sales.SalesOrder,
		Payments.ARAPDocument,
		Sales.ItemsLocationAttributes,
		Sales.InventoryOwnerAttribute,
		Sales.InventoryType,
		Sales.RevenueAmount,
		Sales.RevenueAmountExcludingVAT,
		Sales.RevenueAmountExclVATLocal,
		Sales.Count,
		Sales.Cost + Sales.LaborCosts + Sales.ItemizedFixedCostsIncludingVAT + Sales.ItemizedVariableCostsIncludingVAT,
		Sales.CostExcludingVAT + Sales.LaborCosts + Sales.ItemizedFixedCostsExcludingVAT +
			Sales.ItemizedVariableCostsExcludingVAT,
		Sales.LocalCost + Sales.LaborCostsLocal + Sales.ItemizedFixedCostsCompl +
			Sales.ItemizedVariableCostsCompl,
		Sales.AddExpensesForGoods,
		Sales.AdditionalExpensesExcludingVAT,
		Sales.AddExpensesLocal,
		Sales.SellingExpensesIncludingVAT AS SellingExpensesIncludingVAT,
		Sales.SellingExpensesExcludingVAT AS SellingExpensesExcludingVAT,
		Sales.SellingExpensesLocal AS SellingExpensesLocal
	FROM
		AccumulationRegister.RevenueAndCOGS AS Sales
			INNER JOIN Payments AS Payments
			ON (Payments.ARAPDocument = Sales.Recorder)
			AND (Payments.ARAPDocument &lt;&gt; Sales.SalesOrder)
			AND (Payments.ARAPDocument &lt;&gt; Sales.DocumentRegisterRecords)
			AND (Payments.SalesOrder = Sales.SalesOrder
			OR Payments.SalesOrder IS NULL)
	WHERE
		NOT Sales.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ReverseOfSale),
			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomer),
			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods))) AS Sales
		{INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON Sales.ItemsLocationAttributes = DimensionOfProductItem.Ref}
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.StorageLocation.* AS Warehouse,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(ISNULL(Sales.SalesOrder.SalesOpportunity, VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef))).* AS SalesOpportunity}
GROUP BY
	BEGINOFPERIOD(Sales.Period, MONTH),
	Sales.Department,
	CASE
		WHEN Sales.Manager = VALUE(Catalog.Users.EmptyRef)
			THEN ISNULL(Sales.SalesOrder.Manager, VALUE(Catalog.Users.EmptyRef))
		ELSE Sales.Manager
	END,
	Sales.SalesOrder,
	Sales.ItemsLocationAttributes,
	Sales.InventoryOwnerAttribute,
	Sales.InventoryType,
	Sales.ARAPDocument

INDEX BY
	ARAPDocument,
	Period,
	ItemsLocationAttributes,
	InventoryOwnerAttribute,
	InventoryType
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	Payments.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Payments.Organization AS Organization,
	CASE &amp;ReportData
		WHEN 3
			THEN Payments.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	Payments.Partner AS Partner,
	Sales.Department AS Department,
	Sales.Manager AS Manager,
	Sales.SalesOrder AS SalesOrder,
	CASE
		WHEN Payments.SalesOrder IS NULL
			THEN TRUE
		ELSE FALSE
	END AS Allocate,
	Payments.ARAPDocument AS ARAPDocument,
	SUM(Sales.RevenueAmount) AS RevenueWithVAT,
	SUM(Sales.Revenue) AS Revenue,
	Payments.RemainingAmountDueForPayment AS RemainingAmountDueForPayment,
	Payments.PaidWithoutShipment AS PaidWithoutShipment,
	Payments.ShipmentInReportPeriod AS ShipmentInReportPeriod,
	SUM(CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
					THEN ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.Cost, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.AdditionalExpenseCost, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.LaborCosts, 0) + ISNULL(Sales.Count,
						0) * ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0) + ISNULL(Sales.Count, 0) *
						ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
				ELSE ISNULL(Sales.Cost_, 0) + ISNULL(Sales.AdditionalExpenseAmount, 0) +
					ISNULL(Sales.SellingExpensesIncludingVAT, 0)
			END
		WHEN &amp;ReportData = 3
			THEN CASE
				WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
					THEN ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.LocalCost, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.LaborCostsLocal, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.ItemizedFixedCostsCompl, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.ItemizedVariableCostsCompl, 0)
				ELSE ISNULL(Sales.CostLocal, 0) + ISNULL(Sales.AmountOfAdditionalLocalExpenses, 0) +
					ISNULL(Sales.SellingExpensesLocal, 0)
			END
		ELSE CASE
			WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
				THEN ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.CostExcludingVAT, 0) +
					ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0) +
					ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.LaborCosts, 0) + ISNULL(Sales.Count,
					0) * ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0) + ISNULL(Sales.Count, 0) *
					ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0)
			ELSE ISNULL(Sales.CostExcludingVAT_, 0) + ISNULL(Sales.AdditionalExpensesAmountExcludingVAT, 0) +
				ISNULL(Sales.SellingExpensesExcludingVAT, 0)
		END
	END) AS Cost_,
	0 AS ReturnAmount,
	0 AS ReturnCost
INTO Result
FROM
	Payments AS Payments
		LEFT JOIN Sales AS Sales
		ON (Sales.ARAPDocument = Payments.ARAPDocument)
		AND (Sales.SalesOrder = Payments.SalesOrder
		OR Payments.SalesOrder IS NULL)
		{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON (Sales.Period = CostOfProducts.Period)
		AND (Sales.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes)
		AND (Sales.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute)
		AND (Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		AND
			CostOfProducts.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
		OR Sales.InventoryType &lt;&gt; VALUE(Enum.InventoryTypes.ConsignedGoods)
		AND CostOfProducts.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock))
		AND Payments.Organization = CostOfProducts.Organization}
		{LEFT JOIN CalculationOfCostOfOrganization AS CalculationOfCostOfOrganization
		ON (CalculationOfCostOfOrganization.Date = Sales.Period)
		AND (CalculationOfCostOfOrganization.Organization = Payments.Organization)}
GROUP BY
	Payments.AccountingDimensionByPartners,
	Payments.Organization,
	Payments.Partner,
	Sales.Department,
	Sales.Manager,
	Sales.SalesOrder,
	CASE
		WHEN Payments.SalesOrder IS NULL
			THEN TRUE
		ELSE FALSE
	END,
	Payments.ARAPDocument,
	Payments.DebtBalance,
	Payments.RemainingAmountDueForPayment,
	Payments.PaidWithoutShipment,
	Payments.ShipmentInReportPeriod,
	CASE &amp;ReportData
		WHEN 3
			THEN Payments.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END
HAVING
	(SUM(Sales.RevenueAmount) &lt;&gt; Payments.DebtBalance
	OR &amp;NewOnlineARAPAccounting)

UNION ALL

SELECT
	Sales.AccountingDimensionByPartners,
	DimensionByPartners.Organization,
	CASE &amp;ReportData
		WHEN 3
			THEN DimensionByPartners.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END,
	DimensionByPartners.Partner,
	Sales.Department,
	Sales.Manager,
	Sales.SalesOrder,
	CASE
		WHEN Payments.SalesOrder IS NULL
			THEN TRUE
		ELSE FALSE
	END,
	CASE
		WHEN VALUETYPE(Sales.SalesOrder) IN (&amp;APARDocumentTypes)
			THEN Sales.SalesOrder
		WHEN VALUETYPE(Sales.DocumentRegisterRecords) IN (&amp;APARDocumentTypes)
			THEN Sales.DocumentRegisterRecords
		WHEN VALUETYPE(Sales.Recorder) IN (&amp;APARDocumentTypes)
			THEN Sales.Recorder
	END,
	SUM(Sales.RevenueAmount),
	SUM(CASE
		WHEN &amp;ReportData = 1
			THEN Sales.RevenueAmount
		WHEN &amp;ReportData = 3
			THEN Sales.RevenueAmountExclVATLocal
		ELSE Sales.RevenueAmountExcludingVAT
	END),
	0,
	SUM(CASE
		WHEN &amp;ReportData = 1
			THEN Sales.RevenueAmount
		WHEN &amp;ReportData = 3
			THEN Sales.RevenueAmountExclVATLocal
		ELSE Sales.RevenueAmountExcludingVAT
	END),
	FALSE,
	SUM(CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
					THEN ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.Cost, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.AdditionalExpenseCost, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.LaborCosts, 0) + ISNULL(Sales.Count,
						0) * ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0) + ISNULL(Sales.Count, 0) *
						ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
				ELSE ISNULL(Sales.Cost, 0) + ISNULL(Sales.AddExpensesForGoods, 0) + ISNULL(Sales.LaborCosts, 0) +
					ISNULL(Sales.ItemizedFixedCostsIncludingVAT, 0) + ISNULL(Sales.ItemizedVariableCostsIncludingVAT, 0)
			END
		WHEN &amp;ReportData = 3
			THEN CASE
				WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
					THEN ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.LocalCost, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.LaborCostsLocal, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.ItemizedFixedCostsCompl, 0) +
						ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.ItemizedVariableCostsCompl, 0)
				ELSE ISNULL(Sales.LocalCost, 0) + ISNULL(Sales.AddExpensesLocal, 0) +
					ISNULL(Sales.LaborCostsLocal, 0) + ISNULL(Sales.ItemizedFixedCostsCompl, 0) +
					ISNULL(Sales.ItemizedVariableCostsCompl, 0)
			END
		ELSE CASE
			WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
				THEN ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.CostExcludingVAT, 0) +
					ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0) +
					ISNULL(Sales.Count, 0) * ISNULL(CostOfProducts.LaborCosts, 0) + ISNULL(Sales.Count,
					0) * ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0) + ISNULL(Sales.Count, 0) *
					ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0)
			ELSE ISNULL(Sales.CostExcludingVAT, 0) + ISNULL(Sales.AdditionalExpensesExcludingVAT, 0) + ISNULL(Sales.LaborCosts,
				0) + ISNULL(Sales.ItemizedFixedCostsExcludingVAT, 0) + ISNULL(Sales.ItemizedVariableCostsExcludingVAT, 0)
		END
	END),
	0,
	0
FROM
	AccumulationRegister.RevenueAndCOGS AS Sales
		LEFT JOIN Payments AS Payments
		ON (Payments.SalesOrder = Sales.SalesOrder
		OR Payments.SalesOrder IS NULL)
		AND (Payments.ARAPDocument = CASE
			WHEN VALUETYPE(Sales.DocumentRegisterRecords) IN (&amp;APARDocumentTypes)
				THEN Sales.DocumentRegisterRecords
			WHEN VALUETYPE(Sales.Recorder) IN (&amp;APARDocumentTypes)
				THEN Sales.Recorder
		END)
		{INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON Sales.ItemsLocationAttributes = DimensionOfProductItem.Ref}
		{INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON Sales.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
		{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON Sales.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
		AND (DimensionByPartners.Organization = CostOfProducts.Organization)
		AND Sales.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
		AND (CostOfProducts.Period = BEGINOFPERIOD(Sales.Period, MONTH))
		AND (Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		AND
			CostOfProducts.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
		OR Sales.InventoryType &lt;&gt; VALUE(Enum.InventoryTypes.ConsignedGoods)
		AND CostOfProducts.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock))}
		{LEFT JOIN CalculationOfCostOfOrganization AS CalculationOfCostOfOrganization
		ON (BEGINOFPERIOD(Sales.Period, MONTH) = CalculationOfCostOfOrganization.Date)
		AND (DimensionByPartners.Organization = CalculationOfCostOfOrganization.Organization)}
WHERE
	(Sales.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	OR &amp;EndOfPeriod = DATETIME(1, 1, 1)
	AND Sales.Period &gt;= &amp;BeginOfPeriod)
	AND (&amp;ShowSales_ = 1
	AND DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	OR &amp;ShowSales_ = 2
	AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	OR &amp;ShowSales_ = 0)
	AND Payments.ARAPDocument IS NULL
	AND (VALUETYPE(Sales.DocumentRegisterRecords) IN (&amp;APARDocumentTypes)
	OR VALUETYPE(Sales.Recorder) IN (&amp;APARDocumentTypes))
	AND NOT Sales.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ReverseOfSale),
		VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomer),
		VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods))
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionByPartners.Organization.* AS Organization,
	DimensionByPartners.Partner.* AS Partner,
	DimensionOfProductItem.StorageLocation.* AS Warehouse,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DimensionByPartners.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	(ISNULL(Sales.SalesOrder.SalesOpportunity, VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef))).* AS SalesOpportunity}
GROUP BY
	Sales.AccountingDimensionByPartners,
	DimensionByPartners.Organization,
	DimensionByPartners.Partner,
	Sales.Department,
	Sales.Manager,
	Sales.SalesOrder,
	CASE
		WHEN Payments.SalesOrder IS NULL
			THEN TRUE
		ELSE FALSE
	END,
	CASE
		WHEN VALUETYPE(Sales.SalesOrder) IN (&amp;APARDocumentTypes)
			THEN Sales.SalesOrder
		WHEN VALUETYPE(Sales.DocumentRegisterRecords) IN (&amp;APARDocumentTypes)
			THEN Sales.DocumentRegisterRecords
		WHEN VALUETYPE(Sales.Recorder) IN (&amp;APARDocumentTypes)
			THEN Sales.Recorder
	END,
	CASE &amp;ReportData
		WHEN 3
			THEN DimensionByPartners.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END

UNION ALL

SELECT
	Returns.AccountingDimensionByPartners,
	DimensionByPartners.Organization,
	CASE &amp;ReportData
		WHEN 3
			THEN DimensionByPartners.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END,
	DimensionByPartners.Partner,
	Returns.Department,
	Returns.Manager,
	Returns.SalesOrder,
	FALSE,
	Returns.Recorder,
	0,
	0,
	0,
	0,
	0,
	0,
	-SUM(CASE
		WHEN &amp;ReportData = 1
			THEN Returns.RevenueAmount
		WHEN &amp;ReportData = 3
			THEN Returns.RevenueAmountExclVATLocal
		ELSE Returns.RevenueAmountExcludingVAT
	END),
	-SUM(CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
					THEN ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.Cost, 0) +
						ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.AdditionalExpenseCost, 0) +
						ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.LaborCosts, 0) +
						ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0) +
						ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
				ELSE ISNULL(Returns.Cost, 0) + ISNULL(Returns.AddExpensesForGoods, 0) + ISNULL(Returns.LaborCosts, 0) +
					ISNULL(Returns.ItemizedFixedCostsIncludingVAT, 0) + ISNULL(Returns.ItemizedVariableCostsIncludingVAT, 0)
			END
		WHEN &amp;ReportData = 3
			THEN CASE
				WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
					THEN ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.LocalCost, 0) +
						ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.AddExpensesLocal, 0) +
						ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.LaborCostsLocal, 0) +
						ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.ItemizedFixedCostsCompl, 0) +
						ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.ItemizedVariableCostsCompl, 0)
				ELSE ISNULL(Returns.LocalCost, 0) + ISNULL(Returns.AddExpensesLocal, 0) +
					ISNULL(Returns.LaborCostsLocal, 0) + ISNULL(Returns.ItemizedFixedCostsCompl, 0) +
					ISNULL(Returns.ItemizedVariableCostsCompl, 0)
			END
		ELSE CASE
			WHEN ISNULL(CalculationOfCostOfOrganization.PreliminaryCalculation, FALSE)
				THEN ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.CostExcludingVAT, 0) +
					ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0) +
					ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.LaborCosts, 0) +
					ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0) +
					ISNULL(Returns.Count, 0) * ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0)
			ELSE ISNULL(Returns.CostExcludingVAT, 0) + ISNULL(Returns.AdditionalExpensesExcludingVAT, 0) +
				ISNULL(Returns.LaborCosts, 0) + ISNULL(Returns.ItemizedFixedCostsExcludingVAT, 0) +
				ISNULL(Returns.ItemizedVariableCostsExcludingVAT, 0)
		END
	END)
FROM
	AccumulationRegister.RevenueAndCOGS AS Returns
		{INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON Returns.ItemsLocationAttributes = DimensionOfProductItem.Ref}
		{INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON Returns.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
		{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON Returns.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
		AND (DimensionByPartners.Organization = CostOfProducts.Organization)
		AND Returns.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
		AND (CostOfProducts.Period = BEGINOFPERIOD(Returns.Period, MONTH))
		AND (Returns.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
		AND
			CostOfProducts.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedByCommissionAgent)
		OR Returns.InventoryType &lt;&gt; VALUE(Enum.InventoryTypes.ConsignedGoods)
		AND CostOfProducts.AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock))}
		{LEFT JOIN CalculationOfCostOfOrganization AS CalculationOfCostOfOrganization
		ON (BEGINOFPERIOD(Returns.Period, MONTH) = CalculationOfCostOfOrganization.Date)
		AND (DimensionByPartners.Organization = CalculationOfCostOfOrganization.Organization)}
WHERE
	(Returns.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	OR &amp;EndOfPeriod = DATETIME(1, 1, 1)
	AND Returns.Period &gt;= &amp;BeginOfPeriod)
	AND (&amp;ShowSales_ = 1
	AND DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	OR &amp;ShowSales_ = 2
	AND DimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	OR &amp;ShowSales_ = 0)
	AND (Returns.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ReverseOfSale),
		VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomer),
		VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods))
	OR VALUETYPE(Returns.Recorder) = TYPE(Document.SaleAdjustment)
	AND NOT Returns.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ReverseOfSale),
		VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomer),
		VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods)))
	AND (Returns.SalesOrder REFS Document.CustomerInvoice
	OR Returns.SalesOrder REFS Document.SalesOrder)
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionByPartners.Organization.* AS Organization,
	DimensionByPartners.Partner.* AS Partner,
	DimensionOfProductItem.StorageLocation.* AS Warehouse,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DimensionByPartners.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	(ISNULL(Returns.SalesOrder.SalesOpportunity, VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef))).* AS SalesOpportunity}
GROUP BY
	Returns.AccountingDimensionByPartners,
	DimensionByPartners.Organization,
	DimensionByPartners.Partner,
	Returns.Department,
	Returns.Manager,
	Returns.SalesOrder,
	Returns.Recorder,
	CASE &amp;ReportData
		WHEN 3
			THEN DimensionByPartners.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	RECORDAUTONUMBER() AS RecNo,
	Result.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Result.Organization AS Organization,
	Result.Currency AS Currency,
	Result.Partner AS Partner,
	Result.Department AS Department,
	Result.Manager AS Manager,
	Result.SalesOrder AS SalesOrder,
	Result.ARAPDocument AS ARAPDocument,
	Result.RevenueWithVAT AS RevenueWithVAT,
	Result.Revenue AS Revenue,
	Result.RemainingAmountDueForPayment AS RemainingAmountDueForPayment,
	Result.PaidWithoutShipment AS PaidWithoutShipment,
	Result.ShipmentInReportPeriod AS ShipmentInReportPeriod,
	Result.Cost_ AS Cost_,
	Result.ReturnAmount AS ReturnAmount,
	Result.ReturnCost AS ReturnCost
INTO ForAllocation
FROM
	Result AS Result
WHERE
	Result.Allocate
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	ForAllocation.ARAPDocument AS ARAPDocument,
	MIN(ForAllocation.RecNo) AS RecNo
INTO ToDistributionOfTotals
FROM
	ForAllocation AS ForAllocation
GROUP BY
	ForAllocation.ARAPDocument

INDEX BY
	ARAPDocument
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	Register.ARAPObject.Object AS ARAPObject,
	SUM(Register.DebtBalance) AS DebtBalance
INTO BalanceOfDebt
FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates.Balance(&amp;PeriodEndBoundary,) AS Register
WHERE
	&amp;NewOnlineARAPAccounting
{WHERE
	Register.AccountingDimensionByPartners.Organization.* AS Organization,
	Register.AccountingDimensionByPartners.Partner.* AS Partner,
	(Register.AccountingDimensionByPartners.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
GROUP BY
	Register.ARAPObject.Object

UNION ALL

SELECT
	Register.SalesOrder.Object,
	SUM(Register.DebtBalance)
FROM
	AccumulationRegister.CustomersARAPAccountingByDocuments.Balance(&amp;PeriodEndBoundary,) AS Register
WHERE
	NOT &amp;NewOnlineARAPAccounting
{WHERE
	Register.AccountingDimensionByPartners.Organization.* AS Organization,
	Register.AccountingDimensionByPartners.Partner.* AS Partner,
	(Register.AccountingDimensionByPartners.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
GROUP BY
	Register.SalesOrder.Object
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	Result.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	Result.Organization AS Organization,
	Result.Currency AS Currency,
	Result.Partner AS Partner,
	Result.Department AS Department,
	Result.Manager AS Manager,
	Result.SalesOrder AS SalesOrder,
	Result.ARAPDocument AS ARAPDocument,
	Result.RevenueWithVAT AS RevenueWithVAT,
	Result.Revenue AS Revenue,
	Result.RemainingAmountDueForPayment AS RemainingAmountDueForPayment,
	Result.PaidWithoutShipment AS PaidWithoutShipment,
	Result.ShipmentInReportPeriod AS ShipmentInReportPeriod,
	Result.Cost_ AS Cost_,
	Result.ReturnAmount AS ReturnAmount,
	Result.ReturnCost AS ReturnCost
FROM
	Result AS Result
		LEFT JOIN BalanceOfDebt AS BalanceOfDebt
		ON Result.SalesOrder = BalanceOfDebt.ARAPObject
WHERE
	NOT Result.Allocate
{WHERE
	ISNULL(BalanceOfDebt.DebtBalance, 0) &lt;= 0 AS ThereIsNoDebtOnSettlementDocuments}

UNION ALL

SELECT
	ForAllocation.AccountingDimensionByPartners,
	ForAllocation.Organization,
	ForAllocation.Currency,
	ForAllocation.Partner,
	ForAllocation.Department,
	ForAllocation.Manager,
	CASE
		WHEN
			ForAllocation.AccountingDimensionByPartners.Contract.ARAPObjectSettings = VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
			THEN ForAllocation.AccountingDimensionByPartners.Contract
		ELSE ForAllocation.ARAPDocument
	END,
	ForAllocation.ARAPDocument,
	SUM(ForAllocation.RevenueWithVAT),
	SUM(ForAllocation.Revenue),
	SUM(CASE
		WHEN ISNULL(ForAllocation.RecNo, 0) = ISNULL(ToDistributionOfTotals.RecNo, 0)
			THEN ForAllocation.RemainingAmountDueForPayment
		ELSE 0
	END),
	SUM(CASE
		WHEN ISNULL(ForAllocation.RecNo, 0) = ISNULL(ToDistributionOfTotals.RecNo, 0)
			THEN ForAllocation.PaidWithoutShipment
		ELSE 0
	END),
	ForAllocation.ShipmentInReportPeriod,
	SUM(ForAllocation.Cost_),
	SUM(ForAllocation.ReturnAmount),
	SUM(ForAllocation.ReturnCost)
FROM
	ForAllocation AS ForAllocation
		LEFT JOIN ToDistributionOfTotals AS ToDistributionOfTotals
		ON (ToDistributionOfTotals.ARAPDocument = ForAllocation.ARAPDocument)
		LEFT JOIN BalanceOfDebt AS BalanceOfDebt
		ON ForAllocation.SalesOrder = BalanceOfDebt.ARAPObject
{WHERE
	ISNULL(BalanceOfDebt.DebtBalance, 0) &lt;= 0 AS ThereIsNoDebtOnSettlementDocuments}
GROUP BY
	ForAllocation.AccountingDimensionByPartners,
	ForAllocation.Organization,
	ForAllocation.Currency,
	ForAllocation.Partner,
	ForAllocation.Department,
	ForAllocation.Manager,
	CASE
		WHEN
			ForAllocation.AccountingDimensionByPartners.Contract.ARAPObjectSettings = VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
			THEN ForAllocation.AccountingDimensionByPartners.Contract
		ELSE ForAllocation.ARAPDocument
	END,
	ForAllocation.ARAPDocument,
	ForAllocation.ShipmentInReportPeriod</query>
	</dataSet>
	<calculatedField>
		<dataPath>TotalProfit</dataPath>
		<expression>Case When RemainingAmountDueForPayment = 0 Then
	Revenue - Cost_
Else
	0
End</expression>
