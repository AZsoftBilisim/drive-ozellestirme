	<calculatedField>
		<dataPath>CostOfPaid</dataPath>
		<expression>Cost_ * 
Case When Revenue &lt;&gt; 0 Then
    (Case When ShipmentInReportPeriod Then
        Revenue - RemainingAmountDueForPayment
    Else
        PaidWithoutShipment
    End) / Revenue
Else 0
End</expression>
