			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DocumentData.Organization,
	PurchaseOrders.Products,
	PurchaseOrders.Products.UnitOfMeasure AS StorageUnit,
	PurchaseOrders.Products.UnitForReports AS UnitForReports,
	PurchaseOrders.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	PurchaseOrders.Characteristic,
	DocumentData.Partner AS Consignor,
	DocumentData.Terms AS Terms,
	DocumentData.Currency AS Currency,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN PurchaseOrders.OrderedBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN PurchaseOrders.Products.UnitFactorForReports &lt;&gt; 0
						THEN PurchaseOrders.OrderedBalance / PurchaseOrders.Products.UnitFactorForReports
					ELSE 0
				END
	END AS Ordered,
	PurchaseOrders.OrderedBalance * &amp;QueryTextItemWeight AS OrderedWeight,
	PurchaseOrders.OrderedBalance * &amp;QueryTextTheVolumeOfTheItem AS OrderedAmount
FROM
	AccumulationRegister.PurchaseOrders.Balance({(&amp;EndOfPeriod)}, CAST(PurchaseOrder AS Document.PurchaseOrder).Status &lt;&gt; VALUE(Enum.PurchaseOrderStatuses.NotApproved) {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (PurchaseOrder.Partner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS PurchaseOrders
		INNER JOIN Document.PurchaseOrder AS DocumentData
		ON PurchaseOrders.PurchaseOrder = DocumentData.Ref
WHERE
	DocumentData.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentProcurement)</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità di misura</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>J. m.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ед. изм.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ölçü birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị tính</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ConsignedQuantityReceived</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(ConsignedQuantityReceived)
End</expression>
	</totalField>
	<totalField>
		<dataPath>RevenueAmountReceipt</dataPath>
		<expression>Case
	When Count(Distinct Currency) &gt; 1
		Then 0
	Else Sum(RevenueAmountReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Ordered</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Ordered)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityReturned</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantityReturned)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantitySold</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantitySold)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityConsumed</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantityConsumed)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityReturnedWeight</dataPath>
		<expression>Sum(QuantityReturnedWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityReturnedVolume</dataPath>
		<expression>Sum(QuantityReturnedVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityClosingBalanceWeight</dataPath>
		<expression>Sum(QuantityClosingBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityClosingBalanceVolume</dataPath>
		<expression>Sum(QuantityClosingBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityOpeningBalanceWeight</dataPath>
		<expression>Sum(QuantityOpeningBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityOpeningBalanceVolume</dataPath>
		<expression>Sum(QuantityOpeningBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ConsignedQuantityReceivedWeight</dataPath>
		<expression>Sum(ConsignedQuantityReceivedWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ConsignedQuantityReceivedVolume</dataPath>
		<expression>Sum(ConsignedQuantityReceivedVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantitySoldWeight</dataPath>
		<expression>Sum(QuantitySoldWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantitySoldVolume</dataPath>
		<expression>Sum(QuantitySoldVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityWrittenOffWeight</dataPath>
		<expression>Sum(QuantityWrittenOffWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityWrittenOffVolume</dataPath>
		<expression>Sum(QuantityWrittenOffVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>OrderedWeight</dataPath>
		<expression>Sum(OrderedWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>OrderedAmount</dataPath>
		<expression>Sum(OrderedAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityTransferredToSubcommission</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantityTransferredToSubcommission)
End</expression>
	</totalField>
