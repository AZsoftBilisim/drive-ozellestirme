			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	InventoryKinds.Ref AS InventoryOwnerAttribute
INTO TypesOfStocksCommission
FROM
	Catalog.InventoryKinds AS InventoryKinds
WHERE
	InventoryKinds.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	AND NOT InventoryKinds.SaleOfAnotherCompanyInventory
	AND InventoryKinds.GoodsOwner REFS Catalog.Partners
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.Organization,
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	DimensionOfProductItem.Characteristic AS Characteristic,
	CompanyGoods.CCDNumber,
	CompanyGoods.InventoryOwnerAttribute,
	CompanyGoods.InventoryOwnerAttribute.GoodsOwner AS Consignor,
	CompanyGoods.InventoryOwnerAttribute.Terms AS Terms,
	CompanyGoods.InventoryOwnerAttribute.Currency AS Currency,
	CASE
		WHEN CompanyGoods.Recorder = UNDEFINED
			THEN NULL
		ELSE CompanyGoods.Recorder
	END AS Recorder,
	CompanyGoods.SecondPeriod AS SecondPeriod,
	CompanyGoods.DayPeriod AS DayPeriod,
	CompanyGoods.WeekPeriod AS WeekPeriod,
	CompanyGoods.TenDaysPeriod AS TenDaysPeriod,
	CompanyGoods.MonthPeriod AS MonthPeriod,
	CompanyGoods.QuarterPeriod AS QuarterPeriod,
	CompanyGoods.HalfYearPeriod AS HalfYearPeriod,
	CompanyGoods.YearPeriod AS YearPeriod,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountOpeningBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS ConsignedQuantityReceived,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountClosingBalance,
	0 AS QuantityTransferredToSubcommission,
	CompanyGoods.CountOpeningBalance * &amp;QueryTextItemWeight AS QuantityOpeningBalanceWeight,
	CompanyGoods.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem AS QuantityOpeningBalanceVolume,
	CompanyGoods.CountReceipt * &amp;QueryTextItemWeight AS ConsignedQuantityReceivedWeight,
	CompanyGoods.CountReceipt * &amp;QueryTextTheVolumeOfTheItem AS ConsignedQuantityReceivedVolume,
	CompanyGoods.CountClosingBalance * &amp;QueryTextItemWeight AS QuantityClosingBalanceWeight,
	CompanyGoods.CountClosingBalance * &amp;QueryTextTheVolumeOfTheItem AS QuantityClosingBalanceVolume
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(
			,
			,
			Auto,
			,
			InventoryOwnerAttribute IN
				(SELECT
					TypesOfStocksCommission.InventoryOwnerAttribute
				FROM
					TypesOfStocksCommission AS TypesOfStocksCommission) {(InventoryOwnerAttribute.GoodsOwner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS CompanyGoods
		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON CompanyGoods.ItemsLocationAttributes = DimensionOfProductItem.Ref
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

UNION ALL

SELECT
	InventoryKinds.Organization,
	GoodsTransferred.ItemsLocationAttributes,
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Products.UnitOfMeasure,
	DimensionOfProductItem.Products.UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports,
	&amp;QueryTextItemWeight,
	&amp;QueryTextTheVolumeOfTheItem,
	DimensionOfProductItem.Characteristic,
	GoodsTransferred.CCDNumber,
	InventoryKinds.Ref,
	InventoryKinds.GoodsOwner,
	InventoryKinds.Terms,
	InventoryKinds.Currency,
	CASE
		WHEN GoodsTransferred.Recorder = UNDEFINED
			THEN NULL
		ELSE GoodsTransferred.Recorder
	END,
	GoodsTransferred.SecondPeriod,
	GoodsTransferred.DayPeriod,
	GoodsTransferred.WeekPeriod,
	GoodsTransferred.TenDaysPeriod,
	GoodsTransferred.MonthPeriod,
	GoodsTransferred.QuarterPeriod,
	GoodsTransferred.HalfYearPeriod,
	GoodsTransferred.YearPeriod,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsTransferred.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsTransferred.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	0,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsTransferred.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsTransferred.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	0,
	GoodsTransferred.CountOpeningBalance * &amp;QueryTextItemWeight,
	GoodsTransferred.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem,
	0,
	0,
	GoodsTransferred.CountClosingBalance * &amp;QueryTextItemWeight,
	GoodsTransferred.CountClosingBalance * &amp;QueryTextTheVolumeOfTheItem
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent.BalanceAndTurnovers(
			,
			,
			Auto,
			,
			InventoryOwnerAttribute IN
				(SELECT
					TypesOfStocksCommission.InventoryOwnerAttribute
				FROM
					TypesOfStocksCommission AS TypesOfStocksCommission) {(InventoryOwnerAttribute.GoodsOwner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS GoodsTransferred
		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON GoodsTransferred.ItemsLocationAttributes = DimensionOfProductItem.Ref
		INNER JOIN Catalog.InventoryKinds AS InventoryKinds
		ON GoodsTransferred.InventoryOwnerAttribute = InventoryKinds.Ref
			AND (NOT GoodsTransferred.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory)
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

UNION ALL

SELECT
	InventoryKinds.Organization,
	GoodsTransferred.ItemsLocationAttributes,
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Products.UnitOfMeasure,
	DimensionOfProductItem.Products.UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports,
	&amp;QueryTextItemWeight,
	&amp;QueryTextTheVolumeOfTheItem,
	DimensionOfProductItem.Characteristic,
	GoodsTransferred.CCDNumber,
	InventoryKinds.Ref,
	InventoryKinds.GoodsOwner,
	InventoryKinds.Terms,
	InventoryKinds.Currency,
	CASE
		WHEN GoodsTransferred.Recorder = UNDEFINED
			THEN NULL
		ELSE GoodsTransferred.Recorder
	END,
	GoodsTransferred.SecondPeriod,
	GoodsTransferred.DayPeriod,
	GoodsTransferred.WeekPeriod,
	GoodsTransferred.TenDaysPeriod,
	GoodsTransferred.MonthPeriod,
	GoodsTransferred.QuarterPeriod,
	GoodsTransferred.HalfYearPeriod,
	GoodsTransferred.YearPeriod,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsTransferred.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsTransferred.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	0,
	0,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsTransferred.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsTransferred.CountTurnover / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	GoodsTransferred.CountOpeningBalance * &amp;QueryTextItemWeight,
	GoodsTransferred.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem,
	0,
	0,
	GoodsTransferred.CountClosingBalance * &amp;QueryTextItemWeight,
	GoodsTransferred.CountClosingBalance * &amp;QueryTextTheVolumeOfTheItem
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent.BalanceAndTurnovers(
			,
			,
			Auto,
			,
			InventoryOwnerAttribute IN
				(SELECT
					TypesOfStocksCommission.InventoryOwnerAttribute
				FROM
					TypesOfStocksCommission AS TypesOfStocksCommission) {(InventoryOwnerAttribute.GoodsOwner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS GoodsTransferred
		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON GoodsTransferred.ItemsLocationAttributes = DimensionOfProductItem.Ref
		INNER JOIN Catalog.InventoryKinds AS InventoryKinds
		ON GoodsTransferred.InventoryOwnerAttribute = InventoryKinds.Ref
			AND (NOT GoodsTransferred.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory)
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}</query>
		</item>
