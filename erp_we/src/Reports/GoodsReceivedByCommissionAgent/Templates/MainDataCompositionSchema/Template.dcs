			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsForRegistration.InventoryOwnerAttribute.Organization AS Organization,
	GoodsForRegistration.Currency,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	DimensionOfProductItem.Characteristic AS Characteristic,
	GoodsForRegistration.InventoryOwnerAttribute.GoodsOwner AS Consignor,
	GoodsForRegistration.InventoryOwnerAttribute.Terms AS Terms,
	CASE
		WHEN GoodsForRegistration.Recorder = UNDEFINED
			THEN NULL
		ELSE GoodsForRegistration.Recorder
	END AS Recorder,
	GoodsForRegistration.SecondPeriod AS SecondPeriod,
	GoodsForRegistration.DayPeriod AS DayPeriod,
	GoodsForRegistration.WeekPeriod AS WeekPeriod,
	GoodsForRegistration.TenDaysPeriod AS TenDaysPeriod,
	GoodsForRegistration.MonthPeriod AS MonthPeriod,
	GoodsForRegistration.QuarterPeriod AS QuarterPeriod,
	GoodsForRegistration.HalfYearPeriod AS HalfYearPeriod,
	GoodsForRegistration.YearPeriod AS YearPeriod,
	GoodsForRegistration.RevenueAmountToRegisterReceipt AS RevenueAmountReceipt,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsForRegistration.QuantityToRegisterReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsForRegistration.QuantityToRegisterReceipt / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS QuantitySold,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsForRegistration.QuantityConsumedForIncoiceRegistrationReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsForRegistration.QuantityConsumedForIncoiceRegistrationReceipt / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS QuantityConsumed,
	GoodsForRegistration.QuantityToRegisterReceipt * &amp;QueryTextItemWeight AS QuantitySoldWeight,
	GoodsForRegistration.QuantityToRegisterReceipt * &amp;QueryTextTheVolumeOfTheItem AS QuantitySoldVolume,
	GoodsForRegistration.QuantityConsumedForIncoiceRegistrationReceipt * &amp;QueryTextItemWeight AS QuantityWrittenOffWeight,
	GoodsForRegistration.QuantityConsumedForIncoiceRegistrationReceipt * &amp;QueryTextTheVolumeOfTheItem AS QuantityWrittenOffVolume
FROM
	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.Turnovers(, , Auto, {(InventoryOwnerAttribute.GoodsOwner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS GoodsForRegistration
		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON GoodsForRegistration.ItemsLocationAttributes = DimensionOfProductItem.Ref
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}</query>
		</item>
