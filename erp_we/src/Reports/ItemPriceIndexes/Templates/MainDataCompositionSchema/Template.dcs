	<parameter>
		<name>BasicPeriodEnd</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Basic period end</v8:content>
			</v8:item>
			<v8:item>
