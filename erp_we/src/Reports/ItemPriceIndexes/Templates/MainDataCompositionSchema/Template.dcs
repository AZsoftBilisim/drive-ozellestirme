	</calculatedField>
	<calculatedField>
		<dataPath>SellingPrice</dataPath>
		<expression>Case When QuantitySales &lt;&gt; 0 Then SaleCost / QuantitySales Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
