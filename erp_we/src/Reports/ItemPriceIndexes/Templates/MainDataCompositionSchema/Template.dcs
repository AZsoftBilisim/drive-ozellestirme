			<field xsi:type="DataSetFieldField">
				<dataPath>ProductSegment</dataPath>
				<field>ProductSegment</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PartnersSegment</dataPath>
				<field>PartnersSegment</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PurchasesManager</dataPath>
				<field>PurchasesManager</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Characteristic</dataPath>
				<field>Characteristic</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Counterparty</dataPath>
				<field>Counterparty</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ItemsLocationAttributes</dataPath>
				<field>ItemsLocationAttributes</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>InventoryOwnerAttribute</dataPath>
				<field>InventoryOwnerAttribute</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CounterpartyLineOfBusiness</dataPath>
				<field>CounterpartyLineOfBusiness</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>AdvanceHolder</dataPath>
				<field>AdvanceHolder</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Manager</dataPath>
				<field>Manager</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ProductLineOfBusiness</dataPath>
				<field>ProductLineOfBusiness</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>OrderDocument</dataPath>
				<field>OrderDocument</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>InventoryType</dataPath>
				<field>InventoryType</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Terms</dataPath>
				<field>Terms</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BusinessOperation</dataPath>
				<field>BusinessOperation</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Department</dataPath>
				<field>Department</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Organization</dataPath>
				<field>Organization</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Warehouse</dataPath>
				<field>Warehouse</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Purchases.Partner AS Vendor,
	Purchases.Manager AS PurchasesManager,
	Purchases.ItemsLocationAttributes.Products AS Products,
	SUM(Purchases.CountTurnover) AS PurchasedQuantityBase,
	SUM(Purchases.CostTurnover) AS PurchaseCostBase
INTO ProcurementBasePeriod
{SELECT
	Vendor.*,
	PurchasesManager.*,
	Products.*,
	PurchasedQuantityBase,
	PurchaseCostBase}
FROM
	AccumulationRegister.Purchases.Turnovers(&amp;BeginOfPeriod, &amp;BasicPeriodEnd, Auto, BusinessOperation IN (VALUE(Enum.BusinessTransactions.PurchaseFromSupplier), VALUE(Enum.BusinessTransactions.PurchaseByImport), VALUE(Enum.BusinessTransactions.PurchaseViaAdvanceHolder))) AS Purchases
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS PartnerAnalytics_
		ON Purchases.Partner = PartnerAnalytics_.Partner
			AND Purchases.Organization = PartnerAnalytics_.Organization
			AND Purchases.Counterparty = PartnerAnalytics_.Counterparty
			AND Purchases.Contract = PartnerAnalytics_.Contract}
WHERE
	(Purchases.CountTurnover &lt;&gt; 0
			OR Purchases.CostTurnover &lt;&gt; 0)
{WHERE
	(Purchases.ItemsLocationAttributes.Products IN
			(SELECT
				SelectionByProductSegment.Products
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(PartnerAnalytics_.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	Purchases.Partner,
	Purchases.Manager,
	Purchases.ItemsLocationAttributes.Products

INDEX BY
	Products,
	Vendor,
	PurchasesManager
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Purchases.Partner AS Vendor,
	Purchases.Manager AS PurchasesManager,
	Purchases.ItemsLocationAttributes.Products AS Products,
	Purchases.Recorder AS DocumentPurchases,
	Purchases.DayPeriod AS DayPeriod,
	Purchases.WeekPeriod AS WeekPeriod,
	Purchases.TenDaysPeriod AS TenDaysPeriod,
	Purchases.MonthPeriod AS MonthPeriod,
	Purchases.QuarterPeriod AS QuarterPeriod,
	Purchases.HalfYearPeriod AS HalfYearPeriod,
	Purchases.YearPeriod AS YearPeriod,
	SUM(Purchases.CountTurnover) AS PurchasedQuantity,
	SUM(Purchases.CostTurnover) AS PurchaseCost
INTO Purchases
{SELECT
	Vendor.*,
	PurchasesManager.*,
	Products.*,
	DocumentPurchases.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	PurchasedQuantity,
	PurchaseCost}
FROM
	AccumulationRegister.Purchases.Turnovers(&amp;BeginOfPeriod, &amp;PeriodEnding, Auto, BusinessOperation IN (VALUE(Enum.BusinessTransactions.PurchaseFromSupplier), VALUE(Enum.BusinessTransactions.PurchaseByImport), VALUE(Enum.BusinessTransactions.PurchaseViaAdvanceHolder))) AS Purchases
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS PartnerAnalytics_
		ON Purchases.Partner = PartnerAnalytics_.Partner
			AND Purchases.Organization = PartnerAnalytics_.Organization
			AND Purchases.Counterparty = PartnerAnalytics_.Counterparty
			AND Purchases.Contract = PartnerAnalytics_.Contract}
WHERE
	(Purchases.CountTurnover &lt;&gt; 0
			OR Purchases.CostTurnover &lt;&gt; 0)
{WHERE
	(Purchases.ItemsLocationAttributes.Products IN
			(SELECT
				SelectionByProductSegment.Products
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(PartnerAnalytics_.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	Purchases.Partner,
	Purchases.Manager,
	Purchases.ItemsLocationAttributes.Products,
	Purchases.Recorder,
	Purchases.DayPeriod,
	Purchases.WeekPeriod,
	Purchases.TenDaysPeriod,
	Purchases.MonthPeriod,
	Purchases.QuarterPeriod,
	Purchases.HalfYearPeriod,
	Purchases.YearPeriod

INDEX BY
	Products,
	Vendor,
	PurchasesManager
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProcurementBasePeriod.Vendor AS Vendor,
	ProcurementBasePeriod.PurchasesManager AS PurchasesManager,
	ProcurementBasePeriod.Products AS Products,
	Purchases.DayPeriod AS DayPeriod,
	Purchases.WeekPeriod AS WeekPeriod,
	Purchases.TenDaysPeriod AS TenDaysPeriod,
	Purchases.MonthPeriod AS MonthPeriod,
	Purchases.QuarterPeriod AS QuarterPeriod,
	Purchases.HalfYearPeriod AS HalfYearPeriod,
	Purchases.YearPeriod AS YearPeriod,
	ProcurementBasePeriod.PurchasedQuantityBase AS PurchasedQuantityBase,
	ProcurementBasePeriod.PurchaseCostBase AS PurchaseCostBase,
	Purchases.PurchasedQuantity AS PurchasedQuantity,
	Purchases.PurchaseCost AS PurchaseCost,
	Purchases.DocumentPurchases AS DocumentPurchases
{SELECT
	Vendor.*,
	PurchasesManager.*,
	Products.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	PurchasedQuantityBase,
	PurchaseCostBase,
	PurchasedQuantity,
	PurchaseCost,
	DocumentPurchases.*}
FROM
	ProcurementBasePeriod AS ProcurementBasePeriod
		LEFT JOIN Purchases AS Purchases
		ON ProcurementBasePeriod.Products = Purchases.Products
{WHERE
	ProcurementBasePeriod.Vendor.*,
	ProcurementBasePeriod.PurchasesManager.*,
	ProcurementBasePeriod.Products.*,
	Purchases.DayPeriod,
	Purchases.WeekPeriod,
	Purchases.TenDaysPeriod,
	Purchases.MonthPeriod,
	Purchases.QuarterPeriod,
	Purchases.HalfYearPeriod,
	Purchases.YearPeriod,
	ProcurementBasePeriod.PurchasedQuantityBase,
	ProcurementBasePeriod.PurchaseCostBase,
	Purchases.PurchasedQuantity,
	Purchases.PurchaseCost,
	Purchases.DocumentPurchases.*}</query>
		</item>
