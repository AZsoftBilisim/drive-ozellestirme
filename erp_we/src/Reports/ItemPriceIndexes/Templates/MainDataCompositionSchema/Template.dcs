				<dataPath>AccountingSection</dataPath>
				<field>AccountingSection</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>LotVendorAttributes</dataPath>
				<field>LotVendorAttributes</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>FinancialAccountingDimension</dataPath>
				<field>FinancialAccountingDimension</field>
			</field>
