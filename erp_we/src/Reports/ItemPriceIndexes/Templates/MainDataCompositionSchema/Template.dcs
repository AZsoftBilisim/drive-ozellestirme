	<calculatedField>
		<dataPath>SellingPriceIndex</dataPath>
		<expression>Case When QuantitySales &lt;&gt; 0 And SaleCostBase &lt;&gt; 0 Then SaleCost / QuantitySales * QuantitySalesBase / SaleCostBase * 100 Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Selling price index, %</v8:content>
