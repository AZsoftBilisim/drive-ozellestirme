				<dataPath>CounterpartyLineOfBusiness</dataPath>
				<field>CounterpartyLineOfBusiness</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>VATActivityType</dataPath>
				<field>VATActivityType</field>
			</field>
