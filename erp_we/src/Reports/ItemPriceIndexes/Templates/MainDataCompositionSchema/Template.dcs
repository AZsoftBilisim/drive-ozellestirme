			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Temel dönemin kapanışı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Kết thúc kỳ cơ sở</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;Periodicity = Value(Enum.Periodicity.Year) Then EndOfPeriod(&amp;Period.StartDate, "Year") When &amp;Periodicity = Value(Enum.Periodicity.HalfYear) Then EndOfPeriod(&amp;Period.StartDate, "HalfYear") When &amp;Periodicity = Value(Enum.Periodicity.Quarter) Then EndOfPeriod(&amp;Period.StartDate, "Quarter") When &amp;Periodicity = Value(Enum.Periodicity.Month) Then EndOfPeriod(&amp;Period.StartDate, "Month") When &amp;Periodicity = Value(Enum.Periodicity.TenDays) Then EndOfPeriod(&amp;Period.StartDate, "TenDays") When &amp;Periodicity = Value(Enum.Periodicity.Week) Then EndOfPeriod(&amp;Period.StartDate, "Week") When &amp;Periodicity = Value(Enum.Periodicity.Day) Then EndOfPeriod(&amp;Period.StartDate, "Day") End</expression>
	</parameter>
