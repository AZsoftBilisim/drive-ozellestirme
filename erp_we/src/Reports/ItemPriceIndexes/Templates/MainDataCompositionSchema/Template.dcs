				<dataPath>Lot</dataPath>
				<field>Lot</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Sales.ItemsLocationAttributes.Products AS Products,
	SUM(Sales.CountTurnover) AS QuantitySalesBase,
	SUM(Sales.RevenueAmountTurnover) AS SaleCostBase
INTO SalesBasePeriod
{SELECT
	Products.*,
	QuantitySalesBase,
	SaleCostBase}
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;BasicPeriodEnd)}, Auto,
		NOT BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods),
			VALUE(Enum.BusinessTransactions.GoodsReceiptByGoodsReturn),
			VALUE(Enum.BusinessTransactions.ReverseOfSale)
		)) AS Sales
WHERE
	Sales.AccountingDimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND (Sales.CountTurnover &lt;&gt; 0
		OR Sales.RevenueAmountTurnover &lt;&gt; 0)
GROUP BY
	Sales.ItemsLocationAttributes.Products
	
{WHERE
	Sales.ItemsLocationAttributes.Products.* AS Products,
	(Sales.ItemsLocationAttributes.Products IN
			(SELECT
				SelectionByProductSegment.Products
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(Sales.AccountingDimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Sales.ItemsLocationAttributes.Products AS Products,
	Sales.Recorder AS DocumentSales,
	Sales.DayPeriod AS DayPeriod,
	Sales.WeekPeriod AS WeekPeriod,
	Sales.TenDaysPeriod AS TenDaysPeriod,
	Sales.MonthPeriod AS MonthPeriod,
	Sales.QuarterPeriod AS QuarterPeriod,
	Sales.HalfYearPeriod AS HalfYearPeriod,
	Sales.YearPeriod AS YearPeriod,
	SUM(Sales.CountTurnover) AS QuantitySales,
	SUM(Sales.RevenueAmountTurnover) AS SaleCost
INTO Sales
{SELECT
	Products.*,
	DocumentSales.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	QuantitySales,
	SaleCost}
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;PeriodEnding)}, Auto,
		NOT BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.ReturnOfGoodsFromCustomerOfPreviousPeriods),
			VALUE(Enum.BusinessTransactions.GoodsReceiptByGoodsReturn),
			VALUE(Enum.BusinessTransactions.ReverseOfSale)
		)) AS Sales
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS PartnerAnalytics_
		ON Sales.AccountingDimensionByPartners = PartnerAnalytics_.DimensionKey}
WHERE
	PartnerAnalytics_.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND (Sales.CountTurnover &lt;&gt; 0
		OR Sales.RevenueAmountTurnover &lt;&gt; 0)
GROUP BY
	Sales.ItemsLocationAttributes.Products,
	Sales.Recorder ,
	Sales.DayPeriod,
	Sales.WeekPeriod,
	Sales.TenDaysPeriod,
	Sales.MonthPeriod,
	Sales.QuarterPeriod,
	Sales.HalfYearPeriod,
	Sales.YearPeriod
{WHERE
	Sales.ItemsLocationAttributes.Products.* AS Products,
	(Sales.ItemsLocationAttributes.Products IN
			(SELECT
				SelectionByProductSegment.Products
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(PartnerAnalytics_.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
			
INDEX BY
	Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SalesBasePeriod.Products AS Products,
	Sales.DayPeriod AS DayPeriod,
	Sales.WeekPeriod AS WeekPeriod,
	Sales.TenDaysPeriod AS TenDaysPeriod,
	Sales.MonthPeriod AS MonthPeriod,
	Sales.QuarterPeriod AS QuarterPeriod,
	Sales.HalfYearPeriod AS HalfYearPeriod,
	Sales.YearPeriod AS YearPeriod,
	SalesBasePeriod.QuantitySalesBase AS QuantitySalesBase,
	SalesBasePeriod.SaleCostBase AS SaleCostBase,
	Sales.QuantitySales AS QuantitySales,
	Sales.SaleCost AS SaleCost,
	Sales.DocumentSales AS DocumentSales
{SELECT
	Products.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	QuantitySalesBase,
	SaleCostBase,
	QuantitySales,
	SaleCost,
	DocumentSales.*}
FROM
	SalesBasePeriod AS SalesBasePeriod
		LEFT JOIN Sales AS Sales
		ON SalesBasePeriod.Products = Sales.Products
{WHERE
	SalesBasePeriod.Products.*,
	Sales.DayPeriod,
	Sales.WeekPeriod,
	Sales.TenDaysPeriod,
	Sales.MonthPeriod,
	Sales.QuarterPeriod,
	Sales.HalfYearPeriod,
	Sales.YearPeriod,
	SalesBasePeriod.QuantitySalesBase,
	SalesBasePeriod.SaleCostBase,
	Sales.QuantitySales,
	Sales.SaleCost,
	Sales.DocumentSales.*}</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>SellingPriceBase</dataPath>
		<expression>Case When QuantitySalesBase &lt;&gt; 0 Then SaleCostBase / QuantitySalesBase Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
