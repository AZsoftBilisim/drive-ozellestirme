					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>TenDaysPeriod</dataPath>
				<field>TenDaysPeriod</field>
				<role>
					<dcscom:periodNumber>5</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>MonthPeriod</dataPath>
				<field>MonthPeriod</field>
				<role>
					<dcscom:periodNumber>6</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>QuarterPeriod</dataPath>
				<field>QuarterPeriod</field>
				<role>
					<dcscom:periodNumber>7</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>HalfYearPeriod</dataPath>
				<field>HalfYearPeriod</field>
				<role>
					<dcscom:periodNumber>8</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>YearPeriod</dataPath>
				<field>YearPeriod</field>
				<role>
					<dcscom:periodNumber>9</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CASE
		WHEN BalanceAndTurnovers.Recorder = UNDEFINED
			THEN NULL
		ELSE BalanceAndTurnovers.Recorder
	END AS Recorder,
	BalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	BalanceAndTurnovers.Account AS Account,
	BalanceAndTurnovers.ExtDimension1 AS ExtDimension1,
	BalanceAndTurnovers.ExtDimension2 AS ExtDimension2,
	BalanceAndTurnovers.ExtDimension3 AS ExtDimension3,
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.ChartOfAccounts AS ChartOfAccounts,
	BalanceAndTurnovers.Department AS Department,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	BalanceAndTurnovers.Currency AS Currency,
	1 AS Factor,
	BalanceAndTurnovers.SumOpeningBalance AS SumOpeningBalance,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.SumOpeningSplittedBalanceDr
		ELSE BalanceAndTurnovers.SumOpeningBalanceDr
	END AS SumOpeningBalanceDr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.SumOpeningSplittedBalanceCr
		ELSE BalanceAndTurnovers.SumOpeningBalanceCr
	END AS SumOpeningBalanceCr,
	BalanceAndTurnovers.SumClosingBalance AS SumClosingBalance,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.SumClosingSplittedBalanceDr
		ELSE BalanceAndTurnovers.SumClosingBalanceDr
	END AS SumClosingBalanceDr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.SumClosingSplittedBalanceCr
		ELSE BalanceAndTurnovers.SumClosingBalanceCr
	END AS SumClosingBalanceCr,
	BalanceAndTurnovers.PresentationAmountOpeningBalance AS PresentationAmountOpeningBalance,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.PresentationAmountOpeningSplittedBalanceDr
		ELSE BalanceAndTurnovers.PresentationAmountOpeningBalanceDr
	END AS PresentationAmountOpeningBalanceDr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.PresentationAmountOpeningSplittedBalanceCr
		ELSE BalanceAndTurnovers.PresentationAmountOpeningBalanceCr
	END AS PresentationAmountOpeningBalanceCr,
	BalanceAndTurnovers.PresentationAmountClosingBalance AS PresentationAmountClosingBalance,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.PresentationAmountClosingSplittedBalanceDr
		ELSE BalanceAndTurnovers.PresentationAmountClosingBalanceDr
	END AS PresentationAmountClosingBalanceDr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.PresentationAmountClosingSplittedBalanceCr
		ELSE BalanceAndTurnovers.PresentationAmountClosingBalanceCr
	END AS PresentationAmountClosingBalanceCr,
	BalanceAndTurnovers.CurrencyAmountOpeningBalance AS CurrencyAmountOpeningBalance,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.CurrencyAmountOpeningSplittedBalanceDr
		ELSE BalanceAndTurnovers.CurrencyAmountOpeningBalanceDr
	END AS CurrencyAmountOpeningBalanceDr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.CurrencyAmountOpeningSplittedBalanceCr
		ELSE BalanceAndTurnovers.CurrencyAmountOpeningBalanceCr
	END AS CurrencyAmountOpeningBalanceCr,
	BalanceAndTurnovers.CurrencyAmountClosingBalance AS CurrencyAmountClosingBalance,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.CurrencyAmountClosingSplittedBalanceDr
		ELSE BalanceAndTurnovers.CurrencyAmountClosingBalanceDr
	END AS CurrencyAmountClosingBalanceDr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.CurrencyAmountClosingSplittedBalanceCr
		ELSE BalanceAndTurnovers.CurrencyAmountClosingBalanceCr
	END AS CurrencyAmountClosingBalanceCr,
	BalanceAndTurnovers.CountOpeningBalance AS CountOpeningBalance,
	BalanceAndTurnovers.CountClosingBalance AS CountClosingBalance,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.CountClosingSplittedBalanceDr
		ELSE BalanceAndTurnovers.CountClosingBalanceDr
	END AS CountClosingBalanceDr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.CountClosingSplittedBalanceCr
		ELSE BalanceAndTurnovers.CountClosingBalanceCr
	END AS CountClosingBalanceCr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.CountOpeningSplittedBalanceDr
		ELSE BalanceAndTurnovers.CountOpeningBalanceDr
	END AS CountOpeningBalanceDr,
	CASE
		WHEN &amp;DetailedBalance
			THEN BalanceAndTurnovers.CountOpeningSplittedBalanceCr
		ELSE BalanceAndTurnovers.CountOpeningBalanceCr
	END AS CountOpeningBalanceCr,
	BalanceAndTurnovers.DayPeriod,
	BalanceAndTurnovers.WeekPeriod,
	BalanceAndTurnovers.TenDaysPeriod,
	BalanceAndTurnovers.MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod,
	BalanceAndTurnovers.HalfYearPeriod,
	BalanceAndTurnovers.YearPeriod
FROM
	AccountingRegister.International.BalanceAndTurnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto {(&amp;Periodicity)},
		RegisterRecordsAndPeriodBoundaries, {(Account).* AS Account}, {(&amp;ExtDimensionType)},
	NOT ChartOfAccounts.DeletionMark
	AND ChartOfAccounts = &amp;ChartOfAccounts {(Organization).* AS Organization, (Department).* AS Department,
		(LineOfBusiness).* AS LineOfBusiness, (Currency).* AS Currency, (ExtDimension1).* AS ExtDimension1,
		(ExtDimension2).* AS ExtDimension2, (ExtDimension3).* AS ExtDimension3}) AS BalanceAndTurnovers</query>
		</item>
