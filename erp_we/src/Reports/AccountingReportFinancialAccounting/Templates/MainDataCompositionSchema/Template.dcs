			<field xsi:type="DataSetFieldField">
				<dataPath>TurnoverForAPeriod.CountTurnover</dataPath>
				<field>CountTurnover</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>TurnoverForAPeriod.Dr.CountTurnoverDr</dataPath>
				<field>CountTurnoverDr</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>TurnoverForAPeriod.Cr.CountTurnoverCr</dataPath>
				<field>CountTurnoverCr</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ChartOfAccounts</dataPath>
				<field>ChartOfAccounts</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CASE
		WHEN InternationalTurnover.Recorder = UNDEFINED
			THEN NULL
		ELSE InternationalTurnover.Recorder
	END AS Recorder,
	InternationalTurnover.SecondPeriod AS SecondPeriod,
	InternationalTurnover.Account AS Account,
	InternationalTurnover.ExtDimension1 AS ExtDimension1,
	InternationalTurnover.ExtDimension2 AS ExtDimension2,
	InternationalTurnover.ExtDimension3 AS ExtDimension3,
	InternationalTurnover.Organization AS Organization,
	InternationalTurnover.ChartOfAccounts AS ChartOfAccounts,
	InternationalTurnover.Currency AS Currency,
	InternationalTurnover.Department AS Department,
	InternationalTurnover.LineOfBusiness AS LineOfBusiness,
	InternationalTurnover.SumTurnoverDr AS SumTurnoverDr,
	InternationalTurnover.SumTurnoverCr AS SumTurnoverCr,
	InternationalTurnover.PresentationAmountTurnoverDr AS PresentationAmountTurnoverDr,
	InternationalTurnover.PresentationAmountTurnoverCr AS PresentationAmountTurnoverCr,
	InternationalTurnover.CurrencyAmountTurnoverDr AS CurrencyAmountTurnoverDr,
	InternationalTurnover.CurrencyAmountTurnoverCr AS CurrencyAmountTurnoverCr,
	InternationalTurnover.SumTurnover AS SumTurnover,
	InternationalTurnover.PresentationAmountTurnover AS PresentationAmountTurnover,
	InternationalTurnover.CurrencyAmountTurnover AS CurrencyAmountTurnover,
	InternationalTurnover.CountTurnover AS CountTurnover,
	InternationalTurnover.CountTurnoverDr AS CountTurnoverDr,
	InternationalTurnover.CountTurnoverCr AS CountTurnoverCr,
	InternationalTurnover.DayPeriod,
	InternationalTurnover.WeekPeriod,
	InternationalTurnover.TenDaysPeriod,
	InternationalTurnover.MonthPeriod,
	InternationalTurnover.QuarterPeriod,
	InternationalTurnover.HalfYearPeriod,
	InternationalTurnover.YearPeriod
{SELECT
	Recorder,
	SecondPeriod,
	Account.*,
	ExtDimension1.*,
	ExtDimension2.*,
	ExtDimension3.*,
	Organization.*,
	ChartOfAccounts.*,
	Currency.*,
	Department.*,
	LineOfBusiness.*,
	SumTurnoverDr,
	SumTurnoverCr,
	PresentationAmountTurnoverDr,
	PresentationAmountTurnoverCr,
	CurrencyAmountTurnoverDr,
	CurrencyAmountTurnoverCr,
	SumTurnover,
	PresentationAmountTurnover,
	CurrencyAmountTurnover,
	CountTurnover,
	CountTurnoverDr,
	CountTurnoverCr}
FROM
	AccountingRegister.International.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto {(&amp;Periodicity)}, {(Account).*
		AS Account}, {(&amp;ExtDimensionType)},
	NOT ChartOfAccounts.DeletionMark
	AND ChartOfAccounts = &amp;ChartOfAccounts {(Organization).* AS Organization, (Department).* AS Department,
		(LineOfBusiness).* AS LineOfBusiness, (Currency).* AS Currency, (ExtDimension1).* AS ExtDimension1,
		(ExtDimension2).* AS ExtDimension2, (ExtDimension3).* AS ExtDimension3}) AS InternationalTurnover
{WHERE
	CASE
		WHEN InternationalTurnover.Recorder = UNDEFINED
			THEN NULL
		ELSE InternationalTurnover.Recorder
	END AS Recorder,
	InternationalTurnover.SecondPeriod,
	InternationalTurnover.Account.*,
	InternationalTurnover.ExtDimension1.*,
	InternationalTurnover.ExtDimension2.*,
	InternationalTurnover.ExtDimension3.*,
	InternationalTurnover.Organization.*,
	InternationalTurnover.ChartOfAccounts.*,
	InternationalTurnover.Currency.*,
	InternationalTurnover.Department.*,
	InternationalTurnover.LineOfBusiness.*,
	InternationalTurnover.SumTurnoverDr,
	InternationalTurnover.SumTurnoverCr,
	InternationalTurnover.PresentationAmountTurnoverDr,
	InternationalTurnover.PresentationAmountTurnoverCr,
	InternationalTurnover.CurrencyAmountTurnoverDr,
	InternationalTurnover.CurrencyAmountTurnoverCr,
	InternationalTurnover.SumTurnover,
	InternationalTurnover.PresentationAmountTurnover,
	InternationalTurnover.CurrencyAmountTurnover,
	InternationalTurnover.CountTurnover,
	InternationalTurnover.CountTurnoverDr,
	InternationalTurnover.CountTurnoverCr}</query>
			<autoFillFields>false</autoFillFields>
		</item>
