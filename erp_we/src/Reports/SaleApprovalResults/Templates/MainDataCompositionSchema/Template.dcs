	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet2</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ApprovalDate</dataPath>
			<field>ApprovalDate</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineNumber</dataPath>
			<field>LineNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ApprovalResult</dataPath>
			<field>ApprovalResult</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Reviewer</dataPath>
			<field>Reviewer</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>RoutePoint</dataPath>
			<field>RoutePoint</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Comment</dataPath>
			<field>Comment</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ref</dataPath>
			<field>Ref</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>VersionNumber</dataPath>
			<field>VersionNumber</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SaleApprovalApprovalResults.RoutePoint         AS RoutePoint,
	SaleApprovalApprovalResults.Reviewer             AS Reviewer,
	SaleApprovalApprovalResults.ApprovalResult AS ApprovalResult,
	SaleApprovalApprovalResults.Comment           AS Comment,
	SaleApprovalApprovalResults.ApprovalDate      AS ApprovalDate,
	SaleApprovalApprovalResults.Ref                AS Ref,
	SaleApprovalApprovalResults.LineNumber           AS LineNumber,
	SaleApprovalApprovalResults.VersionNumber           AS VersionNumber

FROM
	BusinessProcess.SaleApproval.ApprovalResults AS SaleApprovalApprovalResults
{WHERE
	(SaleApprovalApprovalResults.Ref IN (&amp;SaleApproval)),
	(SaleApprovalApprovalResults.Ref.SubjectOf IN (&amp;SubjectOf))}</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>SubjectOf</dataPath>
			<field>SubjectOf</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>SaleApproval</dataPath>
			<field>SaleApproval</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Sale approval</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تأیید فروش</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Approvazione della vendita</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Uzgodnienie sprzedaży</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Согласование продажи</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Satış anlaşması</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Thống nhất bán hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SaleApproval.Ref  AS SaleApproval,
	SaleApproval.SubjectOf AS SubjectOf
FROM
	BusinessProcess.SaleApproval AS SaleApproval
{WHERE
	(SaleApproval.Ref IN (&amp;SaleApproval)),
	(SaleApproval.SubjectOf IN (&amp;SubjectOf))}</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>DataSet1</sourceDataSet>
		<destinationDataSet>DataSet2</destinationDataSet>
		<sourceExpression>SaleApproval</sourceExpression>
		<destinationExpression>Ref</destinationExpression>
	</dataSetLink>
