				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Anlaşma</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Thống nhất</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Approval.Ref  AS Approval,
	Approval.SubjectOf AS SubjectOf
FROM
	BusinessProcess.ApprovalOfRequestForReturnOfGoodsFromCustomer AS Approval
{WHERE
	(Approval.Ref IN (&amp;Approval)),
	(Approval.SubjectOf IN (&amp;SubjectOf))}</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>DataSet1</sourceDataSet>
		<destinationDataSet>DataSet2</destinationDataSet>
		<sourceExpression>Approval</sourceExpression>
		<destinationExpression>Approval</destinationExpression>
	</dataSetLink>
