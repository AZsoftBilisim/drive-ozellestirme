					<v8:content>Thống nhất</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ApprovalResults.RoutePoint         AS RoutePoint,
	ApprovalResults.Reviewer             AS Reviewer,
	ApprovalResults.ApprovalResult AS ApprovalResult,
	ApprovalResults.Comment           AS Comment,
	ApprovalResults.ApprovalDate      AS ApprovalDate,
	ApprovalResults.Ref                AS Approval,
	ApprovalResults.LineNumber           AS LineNumber,
	ApprovalResults.VersionNumber           AS VersionNumber

FROM
	BusinessProcess.ApprovalOfRequestForReturnOfGoodsFromCustomer.ApprovalResults AS ApprovalResults
{WHERE
	(ApprovalResults.Ref IN (&amp;Approval)),
	(ApprovalResults.Ref.SubjectOf IN (&amp;SubjectOf))}</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>SubjectOf</dataPath>
			<field>SubjectOf</field>
			<presentationExpression>TMCommonUse.GetDocumentPresentation(SubjectOf, SubjectOf.Number, SubjectOf.Date)</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Approval</dataPath>
			<field>Approval</field>
