				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Uzgodnienie</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Согласование</v8:content>
				</v8:item>
				<v8:item>
