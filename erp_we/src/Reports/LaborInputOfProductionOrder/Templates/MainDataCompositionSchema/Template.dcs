		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Sum(Case
When IsNull(TotalTimeSpent, 0) &gt;= IsNull(Plan, 0)
Then 0 
Else Case When StatusOfProductionStage &lt;&gt; &amp;StatusOfStageIsCompleted Then IsNull(Plan, 0) - IsNull(TotalTimeSpent,0)
Else 0 End
End)</expression>
	</totalField>
	<totalField>
		<dataPath>ProgressPercent</dataPath>
		<expression>Case
When Sum(IsNull(Plan, 0))&gt;0 Then
(Sum(PlannedTimeUsed)/Sum(IsNull(Plan, 0)))*100
Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>TimeSpent</dataPath>
		<expression>Sum(TimeSpent)</expression>
	</totalField>
	<totalField>
		<dataPath>Plan</dataPath>
		<expression>Sum(Plan)</expression>
	</totalField>
	<totalField>
		<dataPath>overspending</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(EvalExpressionWithGroupArray(""Case
When Sum(IsNull(TimeSpent, 0)) &gt;= Sum(IsNull(Plan, 0))
Then Sum(IsNull(TimeSpent, 0)) - Sum(IsNull(Plan, 0))
Else 0
End"", ""WorkKind""))", "Stage, StatusOfProductionStage, ProductionOrder, Product, ProductionLot, Department"))</expression>
	</totalField>
	<totalField>
		<dataPath>Savings</dataPath>
		<expression>Sum(Case
When IsNull(TotalTimeSpent, 0) = 0
Then Case
When StatusOfProductionStage = &amp;StatusOfStageIsCompleted
Then IsNull(Plan, 0)
Else 0
End
Else Case
When IsNull(Plan, 0) - IsNull(TotalTimeSpent, 0) &gt; 0 And StatusOfProductionStage = &amp;StatusOfStageIsCompleted
Then IsNull(Plan, 0) - IsNull(TotalTimeSpent, 0)
Else 0
End
End)</expression>
	</totalField>
