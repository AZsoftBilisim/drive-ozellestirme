		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	OrderStructureGraph.Stage AS Stage,
	OrderStructureGraph.ProductionOrder AS ProductionOrder,
	OrderStructureGraph.KeyLot AS KeyLot,
	OrderStructureGraph.Begin AS Begin,
	OrderStructureGraph.Ending AS Ending
INTO TT_Schedule
{SELECT
	Stage.*,
	ProductionOrder.*,
	Begin AS BeginningOfPlanStage,
	Ending AS EndOfPlanStage}
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS OrderStructureGraph
WHERE
	OrderStructureGraph.ScheduleStatus = 0
{WHERE
	OrderStructureGraph.Stage.* AS Stage,
	OrderStructureGraph.ProductionOrder.* AS ProductionOrder}

INDEX BY
	Stage,
	ProductionOrder,
	KeyLot
;

////////////////////////////////////////////////////////////////////////////////

SELECT 
	OrderStructureGraph.ProductionOrder AS ProductionOrder,
	OrderStructureGraph.Stage AS Stage,
	MIN(OrderStructureGraph.Begin) AS Begin,
	MAX(OrderStructureGraph.Ending) AS Ending
{SELECT
	ProductionOrder.*,
	Stage.*,
	Begin AS BeginningOfPlanStage,
	Ending AS EndOfPlanStage}
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS OrderStructureGraph
		INNER JOIN TT_Schedule AS TT_Schedule
		ON OrderStructureGraph.ProductionOrder = TT_Schedule.ProductionOrder
			AND OrderStructureGraph.Stage = TT_Schedule.Stage
			AND OrderStructureGraph.KeyLot = TT_Schedule.KeyLot
			AND OrderStructureGraph.ScheduleStatus = 0

GROUP BY
	OrderStructureGraph.ProductionOrder,
	OrderStructureGraph.Stage</query>
		<autoFillFields>false</autoFillFields>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
