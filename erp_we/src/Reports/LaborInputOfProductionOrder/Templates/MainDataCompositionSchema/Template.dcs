			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	ProductionStage2_2.ProductionLot AS Lot,
	ProductionStage2_2.ReferenceOrder AS Document,
	ProductionStage2_2.Ref AS Stage
INTO TT_ProductionOrders
{SELECT
	Document.* AS ProductionOrder,
	Lot.* AS ProductionLot,
	Stage.* AS Stage}
FROM
	Document.ProductionStage2_2 AS ProductionStage2_2
{WHERE
	ProductionStage2_2.ReferenceOrder.* AS ProductionOrder,
	ProductionStage2_2.ProductionLot.* AS ProductionLot,
	ProductionStage2_2.Ref.* AS Stage}

INDEX BY
	Lot
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	LaborCostsToRegisterTurnovers.DayPeriod AS DayPeriod,
	LaborCostsToRegisterTurnovers.WeekPeriod AS WeekPeriod,
	LaborCostsToRegisterTurnovers.WorkKind AS WorkKind,
	LaborCostsToRegisterTurnovers.Department AS Department,
	LaborCostsToRegisterTurnovers.ProductionLot AS ProductionLot,
	LaborCostsToRegisterTurnovers.ProductionLot.MainProductProducts AS Product,
	CASE
		WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionStage2_2
			THEN LaborCostsToRegisterTurnovers.ReferenceOrder
		WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionOperation2_2
			THEN CAST(LaborCostsToRegisterTurnovers.ReferenceOrder AS Document.ProductionOperation2_2).Stage
		ELSE VALUE(Document.ProductionStage2_2.EmptyRef)
	END AS Stage,
	CASE
		WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionStage2_2
			THEN CAST(LaborCostsToRegisterTurnovers.ReferenceOrder AS Document.ProductionStage2_2).Status
		WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionOperation2_2
			THEN CAST(LaborCostsToRegisterTurnovers.ReferenceOrder AS Document.ProductionOperation2_2).Stage.Status
		ELSE VALUE(Enum.StatusesOfProductionStages2_2.EmptyRef)
	END AS StatusOfProductionStage,
	CASE
		WHEN LaborCostsToRegisterTurnovers.WorkKind.LaborInputMultiplier = 0
			THEN 0
		ELSE LaborCostsToRegisterTurnovers.CountReceipt * LaborCostsToRegisterTurnovers.WorkKind.LaborInput / LaborCostsToRegisterTurnovers.WorkKind.LaborInputMultiplier
	END AS TimeSpent,
	LaborCostsToRegisterTurnovers.ProductionLot.Document AS ProductionOrder
{SELECT
	WorkKind.*,
	Department.*,
	Stage.*,
	DayPeriod,
	WeekPeriod,
	TimeSpent AS TimeSpent,
	ProductionLot.*,
	Product.*,
	ProductionOrder.*,
	StatusOfProductionStage.*}
FROM
	AccumulationRegister.LaborCostsToRegister.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;EndOfPeriod)},
			Auto,
			ProductionLot IN
				(SELECT DISTINCT
					TT_ProductionOrders.Lot AS Lot
				FROM
					TT_ProductionOrders AS TT_ProductionOrders)) AS LaborCostsToRegisterTurnovers
{WHERE
	LaborCostsToRegisterTurnovers.DayPeriod,
	LaborCostsToRegisterTurnovers.WeekPeriod,
	LaborCostsToRegisterTurnovers.WorkKind.*,
	LaborCostsToRegisterTurnovers.Department.*,
	(CASE
			WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionStage2_2
				THEN LaborCostsToRegisterTurnovers.ReferenceOrder
			WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionOperation2_2
				THEN CAST(LaborCostsToRegisterTurnovers.ReferenceOrder AS Document.ProductionOperation2_2).Stage
			ELSE VALUE(Document.ProductionStage2_2.EmptyRef)
		END).* AS Stage,
	LaborCostsToRegisterTurnovers.ProductionLot.*,
	LaborCostsToRegisterTurnovers.ProductionLot.Document.* AS ProductionOrder,
	LaborCostsToRegisterTurnovers.ProductionLot.MainProductProducts.* AS Product,
	(CASE
			WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionStage2_2
				THEN CAST(LaborCostsToRegisterTurnovers.ReferenceOrder AS Document.ProductionStage2_2).Status
			WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionOperation2_2
				THEN CAST(LaborCostsToRegisterTurnovers.ReferenceOrder AS Document.ProductionOperation2_2).Stage.Status
			ELSE VALUE(Enum.StatusesOfProductionStages2_2.EmptyRef)
		END IN (&amp;StageStatuses_2))}</query>
			<autoFillFields>false</autoFillFields>
		</item>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>PlannedDates</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>BeginningOfPlanStage</dataPath>
			<field>BeginningOfPlanStage</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Planned start</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>شروع برنامه‌ریزی‌شده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Плановое начало</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Planlanan başlangıç</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Bắt đầu dự kiện</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Planned start</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Planned start</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Format</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>DF=MM/dd/yyyy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
