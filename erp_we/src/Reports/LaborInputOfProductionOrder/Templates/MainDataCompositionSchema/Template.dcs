					<field>true</field>
					<group>true</group>
					<order>true</order>
				</useRestriction>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	TT_ScheduledData.ProductionOrder AS ProductionOrder,
	TT_ScheduledData.Department AS Department,
	TT_ScheduledData.Stage AS Stage,
	TT_ScheduledData.WorkKind AS WorkKind,
	SUM(TT_ScheduledData.ScheduledTime) AS ScheduledTime,
	TT_ScheduledData.Product AS Product,
	TT_ScheduledData.ProductionLot AS ProductionLot
INTO VT_PlannedDataGrouped
{SELECT
	ProductionOrder.*,
	Department.*,
	Stage.*,
	WorkKind.*,
	Product.*,
	ProductionLot.*,
	ScheduledTime}
FROM
	(SELECT
		OrderStructureLaborCosts.ProductionOrder AS ProductionOrder,
		OrderStructureLaborCosts.Department AS Department,
		OrderStructureLaborCosts.Stage AS Stage,
		OrderStructureLaborCosts.WorkKind AS WorkKind,
		SUM(CASE
				WHEN OrderStructureLaborCosts.WorkKind.LaborInputMultiplier = 0
					THEN 0
				ELSE OrderStructureLaborCosts.Count * OrderStructureLaborCosts.WorkKind.LaborInput / OrderStructureLaborCosts.WorkKind.LaborInputMultiplier
			END) AS ScheduledTime,
		CASE
			WHEN OrderStructureLaborCosts.Stage REFS Document.ProductionStage2_2
				THEN CAST(OrderStructureLaborCosts.Stage AS Document.ProductionStage2_2).ProductionLot.MainProductProducts
			WHEN OrderStructureLaborCosts.Stage REFS Catalog.ProductionStages
				THEN CAST(OrderStructureLaborCosts.Stage AS Catalog.ProductionStages).Owner.MainProductProducts
			ELSE VALUE(Catalog.Products.EmptyRef)
		END AS Product,
		CASE
			WHEN OrderStructureLaborCosts.Stage REFS Document.ProductionStage2_2
				THEN CAST(OrderStructureLaborCosts.Stage AS Document.ProductionStage2_2).ProductionLot
			ELSE VALUE(Catalog.ProductionLots.EmptyRef)
		END AS ProductionLot
	{SELECT
		ProductionOrder.*,
		Department.*,
		Stage.*,
		WorkKind.*,
		Product.*,
		ProductionLot.*,
		ScheduledTime AS Plan}
	FROM
		InformationRegister.OrderStructureLaborCosts AS OrderStructureLaborCosts
	{WHERE
		OrderStructureLaborCosts.ProductionOrder.*,
		OrderStructureLaborCosts.Department.*,
		OrderStructureLaborCosts.Stage.*,
		OrderStructureLaborCosts.WorkKind.*,
		(CAST(OrderStructureLaborCosts.Stage AS Document.ProductionStage2_2).ProductionLot.MainProductProducts).* AS Product,
		(CASE
				WHEN OrderStructureLaborCosts.Stage REFS Document.ProductionStage2_2
					THEN CAST(OrderStructureLaborCosts.Stage AS Document.ProductionStage2_2).ProductionLot
				ELSE VALUE(Catalog.ProductionLots.EmptyRef)
			END).* AS ProductionLot,
		(CASE
				WHEN OrderStructureLaborCosts.Stage REFS Document.ProductionStage2_2
					THEN CAST(OrderStructureLaborCosts.Stage AS Document.ProductionStage2_2).Status
				ELSE VALUE(Enum.StatusesOfProductionStages2_2.EmptyRef)
			END IN (&amp;StageStatuses_2))}
	
	GROUP BY
		OrderStructureLaborCosts.ProductionOrder,
		OrderStructureLaborCosts.Department,
		OrderStructureLaborCosts.Stage,
		OrderStructureLaborCosts.WorkKind,
		CASE
			WHEN OrderStructureLaborCosts.Stage REFS Document.ProductionStage2_2
				THEN CAST(OrderStructureLaborCosts.Stage AS Document.ProductionStage2_2).ProductionLot.MainProductProducts
			WHEN OrderStructureLaborCosts.Stage REFS Catalog.ProductionStages
				THEN CAST(OrderStructureLaborCosts.Stage AS Catalog.ProductionStages).Owner.MainProductProducts
			ELSE VALUE(Catalog.Products.EmptyRef)
		END,
		CASE
			WHEN OrderStructureLaborCosts.Stage REFS Document.ProductionStage2_2
				THEN CAST(OrderStructureLaborCosts.Stage AS Document.ProductionStage2_2).ProductionLot
			ELSE VALUE(Catalog.ProductionLots.EmptyRef)
		END
	
	UNION ALL
	
	SELECT
		ProductionStage2_2LaborCosts.Ref.ReferenceOrder,
		ProductionStage2_2LaborCosts.Department,
		ProductionStage2_2LaborCosts.Ref,
		ProductionStage2_2LaborCosts.WorkKind,
		SUM(CASE
				WHEN ProductionStage2_2LaborCosts.WorkKind.LaborInputMultiplier = 0
					THEN 0
				ELSE ProductionStage2_2LaborCosts.Count * ProductionStage2_2LaborCosts.WorkKind.LaborInput / ProductionStage2_2LaborCosts.WorkKind.LaborInputMultiplier
			END),
		ProductionStage2_2LaborCosts.Ref.ProductionLot.MainProductProducts,
		ProductionStage2_2LaborCosts.Ref.ProductionLot
	FROM
		Document.ProductionStage2_2.LaborCosts AS ProductionStage2_2LaborCosts
	WHERE
		ProductionStage2_2LaborCosts.Ref.Posted
		AND ProductionStage2_2LaborCosts.Ref.DynamicStructure
		AND NOT ProductionStage2_2LaborCosts.Canceled
		AND (ProductionStage2_2LaborCosts.Completed2
				OR ProductionStage2_2LaborCosts.Ref.Status = &amp;StatusOfStageIsCompleted)
	{WHERE
		ProductionStage2_2LaborCosts.Ref.ReferenceOrder.* AS ProductionOrder,
		ProductionStage2_2LaborCosts.Department.*,
		ProductionStage2_2LaborCosts.Ref.* AS Stage,
		ProductionStage2_2LaborCosts.WorkKind.*,
		ProductionStage2_2LaborCosts.Ref.ProductionLot.MainProductProducts.* AS Product,
		ProductionStage2_2LaborCosts.Ref.ProductionLot.*,
		(ProductionStage2_2LaborCosts.Ref.Status IN (&amp;StageStatuses_2))}
	
	GROUP BY
		ProductionStage2_2LaborCosts.Department,
		ProductionStage2_2LaborCosts.Ref,
		ProductionStage2_2LaborCosts.WorkKind,
		ProductionStage2_2LaborCosts.Ref.ProductionLot.MainProductProducts,
		ProductionStage2_2LaborCosts.Ref.ProductionLot,
		ProductionStage2_2LaborCosts.Ref.ReferenceOrder) AS TT_ScheduledData
{WHERE
	TT_ScheduledData.ProductionOrder.*,
	TT_ScheduledData.Department.*,
	TT_ScheduledData.Stage.*,
	TT_ScheduledData.WorkKind.*,
	TT_ScheduledData.Product.*,
	TT_ScheduledData.ProductionLot.*}

GROUP BY
	TT_ScheduledData.ProductionLot,
	TT_ScheduledData.Product,
	TT_ScheduledData.WorkKind,
	TT_ScheduledData.ProductionOrder,
	TT_ScheduledData.Department,
	TT_ScheduledData.Stage

INDEX BY
	WorkKind,
	ProductionLot,
	Department,
	Stage
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	LaborCostsToRegisterTurnovers.ProductionLot AS ProductionLot,
	LaborCostsToRegisterTurnovers.Department AS Department,
	LaborCostsToRegisterTurnovers.WorkKind AS WorkKind,
	CASE
		WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionStage2_2
			THEN LaborCostsToRegisterTurnovers.ReferenceOrder
		WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionOperation2_2
			THEN CAST(LaborCostsToRegisterTurnovers.ReferenceOrder AS Document.ProductionOperation2_2).Stage
		ELSE VALUE(Document.ProductionStage2_2.EmptyRef)
	END AS Stage,
	SUM(CASE
		WHEN LaborCostsToRegisterTurnovers.WorkKind.LaborInputMultiplier = 0
			THEN 0
		ELSE LaborCostsToRegisterTurnovers.CountReceipt * LaborCostsToRegisterTurnovers.WorkKind.LaborInput / LaborCostsToRegisterTurnovers.WorkKind.LaborInputMultiplier
	END) AS Actual_Time
INTO TT_LaborCosts
FROM
	AccumulationRegister.LaborCostsToRegister.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;EndOfPeriod)},
			,
			(WorkKind, ProductionLot) IN
				(SELECT
					VT_PlannedDataGrouped.WorkKind AS WorkKind,
					VT_PlannedDataGrouped.ProductionLot AS ProductionLot
				FROM
					VT_PlannedDataGrouped AS VT_PlannedDataGrouped)) AS LaborCostsToRegisterTurnovers

GROUP BY
	LaborCostsToRegisterTurnovers.ProductionLot,
	LaborCostsToRegisterTurnovers.WorkKind,
	CASE
		WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionStage2_2
			THEN LaborCostsToRegisterTurnovers.ReferenceOrder
		WHEN LaborCostsToRegisterTurnovers.ReferenceOrder REFS Document.ProductionOperation2_2
			THEN CAST(LaborCostsToRegisterTurnovers.ReferenceOrder AS Document.ProductionOperation2_2).Stage
		ELSE VALUE(Document.ProductionStage2_2.EmptyRef)
	END,
	LaborCostsToRegisterTurnovers.Department

INDEX BY
	ProductionLot,
	WorkKind,
	Department,
	Stage
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	VT_PlannedDataGrouped.ProductionOrder AS ProductionOrder,
	VT_PlannedDataGrouped.Department AS Department,
	VT_PlannedDataGrouped.Stage AS Stage,
	CASE
		WHEN CAST(VT_PlannedDataGrouped.Stage AS Document.ProductionStage2_2) IS NULL
			THEN VALUE(Enum.StatusesOfProductionStages2_2.EmptyRef)
		ELSE CAST(VT_PlannedDataGrouped.Stage AS Document.ProductionStage2_2).Status
	END AS StatusOfProductionStage,
	VT_PlannedDataGrouped.WorkKind AS WorkKind,
	VT_PlannedDataGrouped.ScheduledTime AS Plan,
	VT_PlannedDataGrouped.Product AS Product,
	VT_PlannedDataGrouped.ProductionLot AS ProductionLot,
	ISNULL(TT_LaborCosts.Actual_Time, 0) AS TotalTimeSpent,
	CASE
		WHEN ISNULL(TT_LaborCosts.Actual_Time, 0) = 0
			THEN CASE
					WHEN CAST(VT_PlannedDataGrouped.Stage AS Document.ProductionStage2_2).Status = &amp;StatusOfStageIsCompleted
						THEN VT_PlannedDataGrouped.ScheduledTime
					ELSE 0
				END
		ELSE CASE
				WHEN CAST(VT_PlannedDataGrouped.Stage AS Document.ProductionStage2_2).Status = &amp;StatusOfStageIsCompleted
					THEN VT_PlannedDataGrouped.ScheduledTime
				ELSE CASE
						WHEN ISNULL(TT_LaborCosts.Actual_Time, 0) &gt;= VT_PlannedDataGrouped.ScheduledTime
							THEN VT_PlannedDataGrouped.ScheduledTime
						ELSE ISNULL(TT_LaborCosts.Actual_Time, 0)
					END
			END
	END AS PlannedTimeUsed
{SELECT
	ProductionOrder.*,
	Department.*,
	Stage.*,
	WorkKind.*,
	Plan,
	Product.*,
	ProductionLot.*,
	PlannedTimeUsed,
	StatusOfProductionStage.*,
	TotalTimeSpent}
FROM
	VT_PlannedDataGrouped AS VT_PlannedDataGrouped
		LEFT JOIN TT_LaborCosts AS TT_LaborCosts
		ON VT_PlannedDataGrouped.ProductionLot = TT_LaborCosts.ProductionLot
			AND VT_PlannedDataGrouped.WorkKind = TT_LaborCosts.WorkKind
			AND VT_PlannedDataGrouped.Stage = TT_LaborCosts.Stage
			AND VT_PlannedDataGrouped.Department = TT_LaborCosts.Department</query>
			<autoFillFields>false</autoFillFields>
		</item>
