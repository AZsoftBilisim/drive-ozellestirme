	<calculatedField>
		<dataPath>DueDate_2</dataPath>
		<expression>Case 
	When Stage.Status = Value(Enum.StatusesOfProductionStages2_2.Completed) Then
		Stage.ActualStageEnd
	When Stage.ProductionDate &lt;&gt; DateTime(1,1,1) Then
		Stage.ProductionDate
	Else 
		EndOfPlanStage 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Due date</v8:content>
			</v8:item>
