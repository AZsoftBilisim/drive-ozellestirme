		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	BudgetTurnovers.SecondPeriod AS UpdateDate,
	BudgetTurnovers.Recorder AS Recorder,
	BudgetTurnovers.PlanningPeriod AS PlanningPeriod,
	BudgetTurnovers.Scenario AS Scenario,
	BudgetTurnovers.Scenario.TheBaseCurrencyOfTheExchangeRates AS BaseCurrencyOfScriptRates,
	BudgetTurnovers.BudgetFlowItem AS BudgetFlowItem,
	BudgetTurnovers.Organization AS Organization,
	ISNULL(BudgetTurnovers.Organization.LocalAccountingCurrency, Constant.DefaultBaseCurrency.Value) AS LocalAccountingCurrency,
	Constant.ManagementAccountingCurrency.Value AS ManagementAccountingCurrency,
	BudgetTurnovers.Department AS Department,
	&amp;AnalystSExpression1 AS Dimension1,
	&amp;AnalystSExpression2 AS Dimension2,
	&amp;AnalystSExpression3 AS Dimension3,
	&amp;AnalystSExpression4 AS Dimension4,
	&amp;AnalystSExpression5 AS Dimension5,
	&amp;AnalystSExpression6 AS Dimension6,
	BudgetTurnovers.Currency AS Currency,
	BudgetTurnovers.CountTurnover AS Count,
	BudgetTurnovers.SumManTurnover AS SumMan,
	BudgetTurnovers.SumComplTurnover AS SumCompl,
	BudgetTurnovers.AmountInCurrencyTurnover AS AmountInCurrency,
	BudgetTurnovers.ScenarioAmountTurnover AS ScenarioAmount
{SELECT
	UpdateDate,
	Recorder.*,
	PlanningPeriod,
	Scenario.*,
	BaseCurrencyOfScriptRates.*,
	BudgetFlowItem.*,
	Organization.*,
	LocalAccountingCurrency.*,
	ManagementAccountingCurrency.*,
	Department.*,
	Dimension1.*,
	Dimension2.*,
	Dimension3.*,
	Dimension4.*,
	Dimension5.*,
	Dimension6.*,
	Currency.*,
	Count,
	SumMan,
	SumCompl,
	AmountInCurrency,
	ScenarioAmount}
FROM
	AccumulationRegister.BudgetTurnovers.Turnovers(, {(&amp;DateWhenTheDataIsUpToDate)}, Auto, Status IN (&amp;TurnoversInStatuses) AND PlanningPeriod BETWEEN &amp;PlanningStartDate AND &amp;PlanningEndDate
	{Scenario.*,
	BudgetFlowItem.*,
	Organization.*,
	Department.*,
	Dimension1.*,
	Dimension2.*,
	Dimension3.*,
	Dimension4.*,
	Dimension5.*,
	Dimension6.*,
	Currency.*}
	) AS BudgetTurnovers
	LEFT JOIN Constant.DefaultBaseCurrency
	ON TRUE
	LEFT JOIN Constant.ManagementAccountingCurrency
	ON TRUE</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
