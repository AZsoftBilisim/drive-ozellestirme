				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ lập kế hoạch</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	&amp;PlanningPeriod AS PlanningPeriod,
	RelativeCourses.CourseNumerator / RelativeCourses.CourseDenominator AS RelativeRateOfManAccounting
{SELECT
	PlanningPeriod,
	RelativeRateOfManAccounting}
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(
			&amp;PlanningPeriod {(&amp;PlanningPeriod)},
			BaseCurrency IN
				(SELECT
					Constant.DefaultBaseCurrency.Value
				FROM
					Constant.DefaultBaseCurrency)
			AND Currency IN
				(SELECT
					Constant.ManagementAccountingCurrency.Value
				FROM
					Constant.ManagementAccountingCurrency)
			 ) AS RelativeCourses</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
