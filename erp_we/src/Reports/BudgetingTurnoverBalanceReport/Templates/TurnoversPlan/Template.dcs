					<v8:content>Tahmini kur</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tỷ giá dự báo</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	BudgetingScenarios.Ref AS Scenario
INTO Filter
FROM
	Catalog.BudgetingScenarios AS BudgetingScenarios
WHERE
	BudgetingScenarios.Ref = &amp;Scenario
	AND NOT BudgetingScenarios.UseExchangeRatesOfAnotherScenario

UNION ALL

SELECT
	BudgetingScenarios.RateScenario
FROM
	Catalog.BudgetingScenarios AS BudgetingScenarios
WHERE
	BudgetingScenarios.Ref = &amp;Scenario
	AND BudgetingScenarios.UseExchangeRatesOfAnotherScenario
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ForecastedExchangeRatesOfScenarios.Scenario AS Scenario,
	&amp;PlanningPeriod AS PlanningPeriod,
	ForecastedExchangeRatesOfScenarios.CourseNumerator / ForecastedExchangeRatesOfScenarios.CourseDenominator AS ForecastRate
{SELECT
	Scenario.*,
	PlanningPeriod,
	ForecastRate}
FROM
	InformationRegister.ForecastedExchangeRatesOfScenarios.SliceLast(
			&amp;PlanningPeriod {(&amp;PlanningPeriod)},
			Scenario IN
				(SELECT
					Filter.Scenario
				FROM
					Filter)
			AND Currency = &amp;Currency) AS ForecastedExchangeRatesOfScenarios</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
