	<calculatedField>
		<dataPath>WeekPeriod</dataPath>
		<expression>Case 
When BeginOfPeriod(PlanningPeriod, "Week") &lt; &amp;PlanningStartDate
Then &amp;PlanningStartDate 
Else BeginOfPeriod(PlanningPeriod, "Week") 
End

</expression>
