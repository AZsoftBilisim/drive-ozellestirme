		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	&amp;PlanningPeriod AS PlanningPeriod,
	RelativeCourses.Currency AS Currency,
	RelativeCourses.CourseNumerator / RelativeCourses.CourseDenominator AS RelativeExchangeRateBaseCurrencyOfManScenarioAccounting
{SELECT
	PlanningPeriod,
	Currency.*,
	RelativeExchangeRateBaseCurrencyOfManScenarioAccounting}
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(
			&amp;PlanningPeriod {(&amp;PlanningPeriod)},
			BaseCurrency IN
				(SELECT
					Constant.DefaultBaseCurrency.Value
				FROM
					Constant.DefaultBaseCurrency)
			AND Currency IN (&amp;Currency)) AS RelativeCourses</query>
	</dataSet>
