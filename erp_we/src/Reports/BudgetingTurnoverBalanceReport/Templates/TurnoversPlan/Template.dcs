		<dataSource>DataSource1</dataSource>
		<query>SELECT
	&amp;PlanningPeriod AS PlanningPeriod,
	RelativeCourses.BaseCurrency AS BaseCurrency,
	RelativeCourses.Currency AS Currency,
	RelativeCourses.CourseNumerator / RelativeCourses.CourseDenominator AS RelativeExchangeRateBaseCurrencyOfLocalAccountingScenario
{SELECT
	PlanningPeriod,
	Currency.*,
	BaseCurrency.*,
	RelativeExchangeRateBaseCurrencyOfLocalAccountingScenario}
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(
			&amp;PlanningPeriod {(&amp;PlanningPeriod)},
			BaseCurrency IN (&amp;BaseCurrency)
				AND Currency IN (&amp;Currency)) AS RelativeCourses</query>
