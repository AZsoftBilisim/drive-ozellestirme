	<dataSet xsi:type="DataSetQuery">
		<name>BudgetingScenarios</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Scenario</dataPath>
			<field>Scenario</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Scenario</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>سناریو</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Scenario</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Scenariusz</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сценарий</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Senaryo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kịch bản</v8:content>
				</v8:item>
			</title>
			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceParameters</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameters">
						<dcscor:item>
							<dcscor:choiceParameter>NotThisScenario</dcscor:choiceParameter>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Catalog.BudgetingScenarios.ActualData</dcscor:value>
						</dcscor:item>
					</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	BudgetingScenarios.Ref AS Scenario
{SELECT
	Scenario}
FROM
	Catalog.BudgetingScenarios AS BudgetingScenarios
WHERE
	NOT BudgetingScenarios.IsFolder
{WHERE
	BudgetingScenarios.Ref.* AS Scenario}</query>
	</dataSet>
