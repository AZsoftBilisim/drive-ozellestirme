		<expression>Sum(SumReal)</expression>
	</totalField>
	<totalField>
		<dataPath>DeviationOfCentsQuantity</dataPath>
		<expression>BudgetReportingDisplayServer.VariancePercentage(Sum(IsNull(NumberOfScenario,0)), Sum(IsNull(CountReal, 0)))</expression>
	</totalField>
	<totalField>
		<dataPath>DeviationPercentageAmount</dataPath>
		<expression>BudgetReportingDisplayServer.VariancePercentage(Sum(IsNull(ScenarioAmount,0)), Sum(IsNull(SumReal, 0)))</expression>
	</totalField>
	<totalField>
		<dataPath>DeviationQuantity</dataPath>
		<expression>BudgetReportingDisplayServer.Deviation(Sum(IsNull(NumberOfScenario,0)), Sum(IsNull(CountReal, 0)))</expression>
	</totalField>
