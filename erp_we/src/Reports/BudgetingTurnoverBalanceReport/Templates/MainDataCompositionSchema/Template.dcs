	</totalField>
	<totalField>
		<dataPath>NumberOfScenario</dataPath>
		<expression>Sum(NumberOfScenario)</expression>
	</totalField>
	<totalField>
		<dataPath>ScenarioAmount</dataPath>
		<expression>Sum(ScenarioAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>DeviationQuantity</dataPath>
		<expression>BudgetReportingDisplayServer.Deviation(EvalExpression("Sum(IsNull(NumberOfScenario,0))",,,"First","Current"), EvalExpression("Sum(IsNull(CountReal,0))",,,"First","Current"))</expression>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>DeviationOfCentsQuantity</dataPath>
		<expression>BudgetReportingDisplayServer.VariancePercentage(EvalExpression("Sum(IsNull(NumberOfScenario,0))",,,"First","Current"), EvalExpression("Sum(IsNull(CountReal,0))",,,"First","Current"))</expression>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>DeviationAmount</dataPath>
		<expression>BudgetReportingDisplayServer.Deviation(EvalExpression("Sum(IsNull(ScenarioAmount,0))",,,"First","Current"), EvalExpression("Sum(IsNull(SumReal,0))",,,"First","Current"))</expression>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>DeviationPercentageAmount</dataPath>
