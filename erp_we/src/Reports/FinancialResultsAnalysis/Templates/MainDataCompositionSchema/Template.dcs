			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	"Expenses" AS Section,
	&amp;ManagementAccountingCurrency AS Currency,
	CASE
		WHEN FinancialResults.Recorder = UNDEFINED
			THEN NULL
		ELSE FinancialResults.Recorder
	END AS Recorder,
	FinancialResults.SecondPeriod AS SecondPeriod,
	FinancialResults.MonthPeriod AS MonthPeriod,
	FinancialResults.QuarterPeriod AS QuarterPeriod,
	FinancialResults.HalfYearPeriod AS HalfYearPeriod,
	FinancialResults.YearPeriod AS YearPeriod,
	FinancialResults.Organization AS Organization,
	FinancialResults.Department AS Department,
	FinancialResults.LineOfBusiness AS LineOfBusiness,
	FinancialResults.ExpenseItem AS AssetRef,
	0 AS IncomeAmount,
	FinancialResults.ExpensesTurnover AS ExpenseAmount,
	CASE
		WHEN FinancialResults.ExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.SaleCost)
			THEN -FinancialResults.ExpensesTurnover
		ELSE 0
	END AS SaleCost,
	CASE
		WHEN FinancialResults.ExpenseItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.SaleCost)
			THEN -FinancialResults.ExpensesTurnover
		ELSE 0
	END AS OtherExpenses
{SELECT
	Section,
	Currency,
	Recorder.*,
	SecondPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	AssetRef.*,
	IncomeAmount,
	ExpenseAmount,
	SaleCost,
	OtherExpenses}
FROM
	AccumulationRegister.FinancialResults.Turnovers(, , Auto, ) AS FinancialResults
{WHERE
	("Expenses") AS Section}</query>
		</item>
	</dataSet>
