			<field xsi:type="DataSetFieldField">
				<dataPath>Currency</dataPath>
				<field>Currency</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Currency</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>ارز</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Valuta</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Waluta</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Валюта</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Para birimi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Tiền tệ</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	"Income" AS Section,
	&amp;ManagementAccountingCurrency AS Currency,
	CASE
		WHEN FinancialResults.Recorder = UNDEFINED
			THEN NULL
		ELSE FinancialResults.Recorder
	END AS Recorder,
	FinancialResults.SecondPeriod AS SecondPeriod,
	FinancialResults.MonthPeriod AS MonthPeriod,
	FinancialResults.QuarterPeriod AS QuarterPeriod,
	FinancialResults.HalfYearPeriod AS HalfYearPeriod,
	FinancialResults.YearPeriod AS YearPeriod,
	FinancialResults.Organization AS Organization,
	FinancialResults.Department AS Department,
	FinancialResults.LineOfBusiness AS LineOfBusiness,
	FinancialResults.IncomeItem AS AssetRef,
	FinancialResults.IncomeTurnover AS IncomeAmount,
	0 AS ExpenseAmount,
	CASE
		WHEN FinancialResults.IncomeItem = VALUE(ChartOfCharacteristicTypes.IncomeItems.SalesRevenue)
			THEN FinancialResults.IncomeTurnover
		ELSE 0
	END AS SalesRevenue,
	CASE
		WHEN FinancialResults.IncomeItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.IncomeItems.SalesRevenue)
			THEN FinancialResults.IncomeTurnover
		ELSE 0
	END AS OtherIncome
{SELECT
	Section,
	Currency,
	Recorder.*,
	SecondPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	Organization.*,
	Department.*,
	LineOfBusiness.*,
	AssetRef.*,
	IncomeAmount,
	ExpenseAmount,
	SalesRevenue,
	OtherIncome}
FROM
	AccumulationRegister.FinancialResults.Turnovers(, , Auto, ) AS FinancialResults
{WHERE
	("Income") AS Section}</query>
		</item>
