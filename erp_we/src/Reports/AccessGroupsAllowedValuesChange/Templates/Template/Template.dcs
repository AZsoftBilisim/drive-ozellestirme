							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>izin türünün gri rengi ve erişim türü kullanılmıyor ise değeri.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>màu xám của dạng và giá trị truy cập, nếu không sử dụng dạng truy cập.</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Access kind is not used (highlighted gray).</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Access kind is not used (highlighted gray).</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
	</template>
