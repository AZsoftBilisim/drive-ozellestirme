	</calculatedField>
	<totalField>
		<dataPath>IncludedViaValuesGroup</dataPath>
		<expression>Case When Max(ValueOrGroup = AccessValue) = True Then Undefined Else Array(Distinct IncludedViaValuesGroup) End</expression>
		<group>AccessKind</group>
		<group>AccessGroup</group>
		<group>AccessValue</group>
	</totalField>
