			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>JobTitle</dataPath>
			<field>JobTitle</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>EmployeeCode</dataPath>
			<field>EmployeeCode</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Employee ID</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>شناسه کارمند</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Numero di matricola</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Identyfikator pracownika</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Табельный номер</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Çalışan Kimlik numarası</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số nhân viên</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>AccrualDeduction</dataPath>
			<field>AccrualDeduction</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>EventKind</dataPath>
			<field>EventKind</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	MatchingData.Organization AS Organization,
	MatchingData.Department AS Department,
	MatchingData.Employee AS Employee,
	MatchingData.JobTitle AS JobTitle,
	EmployeesHR.Code AS EmployeeCode,
	MatchingData.EventKind AS EventKind
FROM
	InformationRegister.EmploymentRecord.SliceLast(, ) AS MatchingData
		INNER JOIN Catalog.EmployeesHR AS EmployeesHR
		ON (MatchingData.Employee = EmployeesHR.Ref)
		INNER JOIN InformationRegister.RegularAccrualsAndDeductionsHR.SliceLast AS RegularAccrualsAndDeductionsHRSliceLast
		ON (MatchingData.Employee = RegularAccrualsAndDeductionsHRSliceLast.Employee)
			AND (MatchingData.Organization = RegularAccrualsAndDeductionsHRSliceLast.Organization)
			AND (MatchingData.Department = RegularAccrualsAndDeductionsHRSliceLast.Department)
		LEFT JOIN InformationRegister.EmploymentRecord.SliceLast(, EventKind = VALUE(Enum.HREventKindsPayrollAndHumanResources.Dismissal)) AS PersonnelHistoryHRSectionOfLastFired
		ON (PersonnelHistoryHRSectionOfLastFired.Organization = MatchingData.Organization)
			AND (PersonnelHistoryHRSectionOfLastFired.Employee = MatchingData.Employee)
WHERE
	MatchingData.WorksInBusinessUnit
	AND NOT MatchingData.EventKind = VALUE(Enum.HREventKindsPayrollAndHumanResources.Dismissal)
	AND RegularAccrualsAndDeductionsHRSliceLast.BasicEarnings
	AND PersonnelHistoryHRSectionOfLastFired.Period IS NULL</query>
	</dataSet>
