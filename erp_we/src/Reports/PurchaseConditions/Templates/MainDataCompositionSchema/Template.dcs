		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
// EXCHANGE RATES /////////////////////////////////////////////////////////////////

SELECT ALLOWED
	CurrencyRatesCut.Currency    AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO CurrencyRatesCut
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;ReportDate}, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
;

////////////////////////////////////////////////////////////////////////////////
// SUPPLIER PRICES ////////////////////////////////////////////////////////////

SELECT ALLOWED
	
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products             AS Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic           AS Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Package                 AS Package,
	CASE
		WHEN
			&amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
			OR &amp;Currency = UNDEFINED
		THEN
			PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency
		ELSE
			&amp;Currency
	END AS Currency,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products.UnitOfMeasure     AS UnitOfMeasure,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PartnerProducts            AS PartnerProducts,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind                 AS VendorPriceKind,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT AS PriceIncludesVAT,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Recorder.Comment           AS Comment,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Partner                AS Partner,
	CASE
		WHEN
			&amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
			OR &amp;Currency = UNDEFINED
		THEN
			PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency
		ELSE
			&amp;Currency
	END AS CurrencyOfReportPrice,
	CASE
		WHEN &amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
				OR &amp;Currency = UNDEFINED
			THEN ISNULL(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price, 0) / ISNULL(&amp;QueryTextPackagingFactor1, 1)
		ELSE CAST(ISNULL(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price, 0) / ISNULL(&amp;QueryTextPackagingFactor1, 1) * CASE
					WHEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency &lt;&gt; &amp;Currency
						THEN CASE
								WHEN ISNULL(CrossSectionReportCurrencyRates.CourseDenominator, 0) &gt; 0
										AND ISNULL(CrossSectionReportCurrencyRates.CourseNumerator, 0) &gt; 0
										AND ISNULL(CurrencyRatesPricesCut.CourseDenominator, 0) &gt; 0
										AND ISNULL(CurrencyRatesPricesCut.CourseNumerator, 0) &gt; 0
									THEN CurrencyRatesPricesCut.CourseNumerator * CrossSectionReportCurrencyRates.CourseDenominator / (CrossSectionReportCurrencyRates.CourseNumerator * CurrencyRatesPricesCut.CourseDenominator)
								ELSE 0
							END
					ELSE 1
				END AS NUMBER(31, 2))
	END AS Price,
	CASE
		WHEN &amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
				OR &amp;Currency = UNDEFINED
			THEN CASE
					WHEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price IS NULL
						THEN 0
					WHEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT
						THEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price
					WHEN NOT PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT
						THEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price * (((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 + 100) / 100)
				END / ISNULL(&amp;QueryTextPackagingFactor1, 1)
		ELSE CAST(CASE
					WHEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price IS NULL
						THEN 0
					WHEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT
						THEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price
					WHEN NOT PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind.PriceIncludesVAT
						THEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price * (((ISNULL(ProductsVATRates.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))).Rate1 + 100) / 100)
				END / ISNULL(&amp;QueryTextPackagingFactor1, 1) * CASE
					WHEN PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency &lt;&gt; &amp;Currency
						THEN CASE
								WHEN ISNULL(CrossSectionReportCurrencyRates.CourseDenominator, 0) &gt; 0
										AND ISNULL(CrossSectionReportCurrencyRates.CourseNumerator, 0) &gt; 0
										AND ISNULL(CurrencyRatesPricesCut.CourseDenominator, 0) &gt; 0
										AND ISNULL(CurrencyRatesPricesCut.CourseNumerator, 0) &gt; 0
									THEN CurrencyRatesPricesCut.CourseNumerator * CrossSectionReportCurrencyRates.CourseDenominator / (CrossSectionReportCurrencyRates.CourseNumerator * CurrencyRatesPricesCut.CourseDenominator)
								ELSE 0
							END
					ELSE 1
				END AS NUMBER(31, 2))
	END AS PriceWithVAT
INTO ItemsPrices
FROM
	InformationRegister.ItemsPricesOfVendor.SliceLast({ENDOFPERIOD(&amp;ReportDate, DAY)},
		{Partner = &amp;Partner}
		{(Products, Characteristic) IN
						(SELECT
							SelectionByProductSegment.Products,
							SelectionByProductSegment.Characteristic
						FROM
							SelectionByProductSegment
						WHERE
							SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
		{VendorPriceKind.Owner IN
						(SELECT
							SelectionByPartnerSegment.Partner
						FROM
							SelectionByPartnerSegment
						WHERE
							SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}

		) AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
LEFT JOIN
	CurrencyRatesCut AS CrossSectionReportCurrencyRates
ON
	&amp;Currency = CrossSectionReportCurrencyRates.Currency
LEFT JOIN
	CurrencyRatesCut AS CurrencyRatesPricesCut
ON
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency = CurrencyRatesPricesCut.Currency
LEFT JOIN
	InformationRegister.ProductsVATRates.SliceLast({&amp;ReportDate}, Country = &amp;CountryOfVATRates OR Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS ProductsVATRates
ON
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products = ProductsVATRates.Products

LEFT JOIN
	InformationRegister.BasicVATRates.SliceLast({&amp;ReportDate}, Country = &amp;CountryOfVATRates OR Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS BasicVATRates
ON
	TRUE
;
////////////////////////////////////////////////////////////////////////////////

SELECT
	PurchaseConditionsSliceLast.Products AS Products,
	PurchaseConditionsSliceLast.Characteristic AS Characteristic,
	PurchaseConditionsSliceLast.VendorPriceKind AS VendorPriceKind,
	PurchaseConditionsSliceLast.OrderPackage AS OrderPackage,
	PurchaseConditionsSliceLast.MinimumDeliveryLot AS MinimumDeliveryLot
INTO PurchaseConditions
FROM
	InformationRegister.PurchaseConditions.SliceLast AS PurchaseConditionsSliceLast
;
////////////////////////////////////////////////////////////////////////////////
// AGGREGATE VALUES OF PRICES AND OTHER PARAMETERS OF THE NOMENCLATURE OF PARTNERS //////////

SELECT ALLOWED
	ItemsPrices.Products    AS Products,
	ItemsPrices.Characteristic  AS Characteristic,
	
	MIN (ItemsPrices.Price)  AS MinimumPrice,
	MAX (ItemsPrices.Price) AS MaximumPrice,
	AVG (ItemsPrices.Price)  AS AveragePrice,

	MIN (ItemsPrices.PriceWithVAT)  AS MinimumPriceWithVAT,
	MAX (ItemsPrices.PriceWithVAT) AS MaximumPriceWithVAT,
	AVG (ItemsPrices.PriceWithVAT)  AS AveragePriceWithVAT
	
INTO SummaryData
FROM
	ItemsPrices AS ItemsPrices

GROUP BY
	ItemsPrices.Products,
	ItemsPrices.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ItemsPrices.Products             AS Products,
	ItemsPrices.Characteristic           AS Characteristic,
	ItemsPrices.Package                 AS Package,
	ISNULL(CASE
			WHEN ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
				THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
			ELSE ItemsPrices.Characteristic.ItemsCharacteristicForPricing
		END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		ELSE ItemsPrices.Package
	END AS PricingPackage,
	ItemsPrices.Partner               AS Partner,
	ItemsPrices.VendorPriceKind     AS VendorPriceKind,
	ItemsPrices.CurrencyOfReportPrice	
INTO ProductPricesAugmented
FROM
	ItemsPrices AS ItemsPrices
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON (ItemKinds.Ref = ItemsPrices.Products.ProductKind)
WHERE
	&amp;UsePriceManagementSystem25		
;

////////////////////////////////////////////////////////////////////////////////
// THE RANGE OF ACCEPTABLE PURCHASE PRICES /////////////////////////////////////////////

SELECT ALLOWED
	ItemsPrices.Products          AS Products,
	ItemsPrices.Characteristic        AS Characteristic,
	ItemsPrices.Partner               AS Partner,
	ItemsPrices.VendorPriceKind     AS VendorPriceKind,
	CASE
		WHEN
			MaximumPricesOfCrossSectionProductRange.Price IS NULL
				THEN
					TRUE
				ELSE
					FALSE
	END AS ThereIsNoMaximumAllowedPurchasePrice,
		CAST(ISNULL(MaximumPricesOfCrossSectionProductRange.Price,0)
			/ ISNULL(&amp;QueryTextPackagingFactor2,1)
					* CASE
						WHEN
							MaximumPricesOfCrossSectionProductRange.Currency &lt;&gt; ItemsPrices.CurrencyOfReportPrice
						THEN
							CASE
								WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) &gt; 0
									AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) &gt; 0
									AND ISNULL(MaximumPriceCurrencyRates.CourseDenominator, 0) &gt; 0
									AND ISNULL(MaximumPriceCurrencyRates.CourseNumerator, 0) &gt; 0
								THEN
									(MaximumPriceCurrencyRates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
									/ (CurrencyRatesPrices.CourseNumerator * MaximumPriceCurrencyRates.CourseDenominator)
								ELSE
									0
							END
						ELSE
							1
		END AS NUMBER(31,2))
	AS MaximumAllowablePurchasePrice
INTO RangeOfAllowablePurchasePrices
FROM
	ItemsPrices AS ItemsPrices
LEFT JOIN
	InformationRegister.ItemsPrices.SliceLast(
		ENDOFPERIOD(&amp;Date, DAY),
		PriceKind IN (
		SELECT
			Constants.KindOfMaximumAllowablePurchasePrice AS PriceKind
		FROM
			Constants AS Constants)
		AND (Products,Characteristic) IN (
			SELECT
			ItemsPrices.Products,
			ItemsPrices.Characteristic
		FROM
			ItemsPrices AS ItemsPrices)
		) AS MaximumPricesOfCrossSectionProductRange
ON
	ItemsPrices.Products = MaximumPricesOfCrossSectionProductRange.Products
	AND ItemsPrices.Characteristic = MaximumPricesOfCrossSectionProductRange.Characteristic

LEFT JOIN
	CurrencyRatesCut AS CurrencyRatesPrices
ON
	ItemsPrices.CurrencyOfReportPrice = CurrencyRatesPrices.Currency

LEFT JOIN
	CurrencyRatesCut AS MaximumPriceCurrencyRates
ON
	MaximumPricesOfCrossSectionProductRange.Currency = MaximumPriceCurrencyRates.Currency
WHERE
	NOT &amp;UsePriceManagementSystem25
	
UNION ALL

SELECT
	ItemsPrices.Products,
	ItemsPrices.Characteristic,
	ItemsPrices.Partner,
	ItemsPrices.VendorPriceKind,
	CASE
		WHEN
			MaximumPricesOfCrossSectionProductRange.Price IS NULL
				THEN
					TRUE
				ELSE
					FALSE
	END,
		CAST(ISNULL(MaximumPricesOfCrossSectionProductRange.Price,0)
			/ ISNULL(&amp;QueryTextPackagingFactor2,1)
					* CASE
						WHEN
							MaximumPricesOfCrossSectionProductRange.Currency &lt;&gt; ItemsPrices.CurrencyOfReportPrice
						THEN
							CASE
								WHEN ISNULL(CurrencyRatesPrices.CourseDenominator, 0) &gt; 0
									AND ISNULL(CurrencyRatesPrices.CourseNumerator, 0) &gt; 0
									AND ISNULL(MaximumPriceCurrencyRates.CourseDenominator, 0) &gt; 0
									AND ISNULL(MaximumPriceCurrencyRates.CourseNumerator, 0) &gt; 0
								THEN
									(MaximumPriceCurrencyRates.CourseNumerator * CurrencyRatesPrices.CourseDenominator)
									/ (CurrencyRatesPrices.CourseNumerator * MaximumPriceCurrencyRates.CourseDenominator)
								ELSE
									0
							END
						ELSE
							1
		END AS NUMBER(31,2))
FROM
	ProductPricesAugmented AS ItemsPrices
LEFT JOIN
	InformationRegister.ItemsPrices25.SliceLast(
		ENDOFPERIOD(&amp;Date, DAY),
		PriceKind IN (
		SELECT
			Constants.KindOfMaximumAllowablePurchasePrice AS PriceKind
		FROM
			Constants AS Constants)
		AND (Products, PricingVariant, PricingBatch, PricingPackage) IN (
			SELECT
			        ItemsPrices.Products,
			        ItemsPrices.PricingVariant,
			        ItemsPrices.PricingBatch,
			        ItemsPrices.PricingPackage
		FROM
			ProductPricesAugmented AS ItemsPrices)
		) AS MaximumPricesOfCrossSectionProductRange
ON
	ItemsPrices.Products = MaximumPricesOfCrossSectionProductRange.Products
	AND ItemsPrices.PricingVariant = MaximumPricesOfCrossSectionProductRange.PricingVariant
	AND ItemsPrices.PricingBatch = MaximumPricesOfCrossSectionProductRange.PricingBatch
	AND ItemsPrices.PricingPackage = MaximumPricesOfCrossSectionProductRange.PricingPackage

LEFT JOIN
	CurrencyRatesCut AS CurrencyRatesPrices
ON
	ItemsPrices.CurrencyOfReportPrice = CurrencyRatesPrices.Currency

LEFT JOIN
	CurrencyRatesCut AS MaximumPriceCurrencyRates
ON
	MaximumPricesOfCrossSectionProductRange.Currency = MaximumPriceCurrencyRates.Currency	
WHERE
	&amp;UsePriceManagementSystem25
;

////////////////////////////////////////////////////////////////////////////////
// FINAL REQUEST /////////////////////////////////////////////////////////////

SELECT ALLOWED
	ItemsPrices.Products                                 AS Products,
	ItemsPrices.Characteristic                               AS Characteristic,
	ItemsPrices.Package                                     AS Package,
	ItemsPrices.Currency                                       AS Currency,
	ItemsPrices.UnitOfMeasure                             AS UnitOfMeasure,
	ItemsPrices.PartnerProducts                       AS PartnerProducts,
	ItemsPrices.VendorPriceKind                            AS VendorPriceKind,
	ItemsPrices.Partner                                      AS Partner,
	ItemsPrices.Price                                         AS Price,
	ItemsPrices.PriceWithVAT                                     AS PriceWithVAT,
	ItemsPrices.Comment                                  AS Comment,
	SummaryData.MinimumPrice                                AS MinimumPrice,
	SummaryData.MaximumPrice                               AS MaximumPrice,
	RangeOfAllowablePurchasePrices.MaximumAllowablePurchasePrice AS MaximumAllowablePurchasePrice,
	CASE
		WHEN
			SummaryData.MinimumPriceWithVAT = SummaryData.MaximumPriceWithVAT
		THEN
			FALSE
		WHEN
			SummaryData.MinimumPriceWithVAT = ItemsPrices.PriceWithVAT
		THEN
			TRUE
		ELSE
			FALSE
	END AS ThisIsMinimumPriceWithVAT,
	CASE
		WHEN
			SummaryData.MinimumPriceWithVAT = SummaryData.MaximumPriceWithVAT
		THEN
			FALSE
		WHEN
			SummaryData.MaximumPriceWithVAT = ItemsPrices.PriceWithVAT
		THEN
			TRUE
		ELSE
			FALSE
	END AS ThisIsMaximumPriceWithVAT,

	// RECOMMENDATION: 1 - regular item, 2 - recommended, 3 - not recommended
	// If the currency is not filled in in the report, recommendations for the minimum price are not shown
	CASE
		// If the price is higher than the maximum allowable price - a recommendation regardless of the mode - 3
		WHEN
			NOT RangeOfAllowablePurchasePrices.ThereIsNoMaximumAllowedPurchasePrice
			AND ItemsPrices.PriceWithVAT &gt; RangeOfAllowablePurchasePrices.MaximumAllowablePurchasePrice
		THEN
			3
		ELSE
		//////////////////////////////////////////////////////////////////////////////
		// MINIMUM PRICE
			CASE
				WHEN
					&amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
					OR &amp;Currency = UNDEFINED
				THEN
					1
				WHEN
					SummaryData.MinimumPriceWithVAT = SummaryData.MaximumPriceWithVAT
				THEN
					2
				WHEN
					SummaryData.MinimumPriceWithVAT = ItemsPrices.PriceWithVAT
				THEN
					2
				WHEN
					SummaryData.MaximumPriceWithVAT = ItemsPrices.PriceWithVAT
				THEN
					3
				ELSE
					1
			END
	END AS Recommendation,
	&amp;QueryTextPackagingFactor3 AS PackageFactor,
	&amp;QueryTextItemWeight AS ProductsWeight,
	PurchaseConditions.OrderPackage AS OrderPackage,
	PurchaseConditions.MinimumDeliveryLot AS MinimumDeliveryLot
	
FROM
	ItemsPrices AS ItemsPrices

LEFT JOIN
	SummaryData
ON
	ItemsPrices.Products = SummaryData.Products
	AND ItemsPrices.Characteristic = SummaryData.Characteristic

LEFT JOIN
	RangeOfAllowablePurchasePrices
ON
	ItemsPrices.Products        = RangeOfAllowablePurchasePrices.Products
	AND ItemsPrices.Characteristic    = RangeOfAllowablePurchasePrices.Characteristic
	AND ItemsPrices.Partner           = RangeOfAllowablePurchasePrices.Partner
	AND ItemsPrices.VendorPriceKind = RangeOfAllowablePurchasePrices.VendorPriceKind

LEFT JOIN 
	PurchaseConditions AS PurchaseConditions
ON ItemsPrices.Products = PurchaseConditions.Products
			AND ItemsPrices.Characteristic = PurchaseConditions.Characteristic
			AND ItemsPrices.VendorPriceKind = PurchaseConditions.VendorPriceKind
</query>
	</dataSet>
	<calculatedField>
		<dataPath>PackingPrice</dataPath>
		<expression>Price * PackageFactor</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Price per packaging unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>قیمت به ازای هر واحد بسته‌بندی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Prezzo per un imballaggio</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Cena za opakowanie</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Цена за упаковку</v8:content>
			</v8:item>
			<v8:item>
