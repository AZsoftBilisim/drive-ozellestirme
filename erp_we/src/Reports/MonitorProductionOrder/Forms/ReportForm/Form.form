  <attributes>
    <name>List</name>
    <title>
      <key>en</key>
      <value>Products</value>
    </title>
    <title>
      <key>fa</key>
      <value>کالاها</value>
    </title>
    <title>
      <key>it</key>
      <value>Prodotti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Wyroby</value>
    </title>
    <title>
      <key>ru</key>
      <value>Изделия</value>
    </title>
    <title>
      <key>tr</key>
      <value>Nihai ürünler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Sản phẩm</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Characteristic</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.KeyLot</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.KeyProducts</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.ProductionOrder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Products</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Warehouse</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT

	RegisterRecords.Products        AS Products,
	RegisterRecords.Characteristic      AS Characteristic,
	RegisterRecords.Warehouse               AS Warehouse,
	RegisterRecords.Purpose          AS Purpose,
	RegisterRecords.ProductionOrder AS ProductionOrder,
	RegisterRecords.KeyProducts    AS KeyProducts,
	
	MIN(CASE
		WHEN RegisterRecords.LineKind IN (
				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct),
				VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption))
			THEN RegisterRecords.KeyLot
	END) AS KeyLot,
		
	MIN(NSICache.BillOfMaterials) AS BillOfMaterials,
	
	MIN(ISNULL(RegulatorySchedule.Begin, OrderProducts_.DemandDate)) AS DesiredDate,
	
	SUM(RegisterRecords.ToSupply) + SUM(RegisterRecords.Ordered) + SUM(RegisterRecords.Done) AS Required2,
	
	SUM(CASE
		WHEN RegisterRecords.ReceiptOrder &lt;> UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory + RegisterRecords.AllocatedFromAvailableInventoryWithAssignment + RegisterRecords.AllocatedInFreeProductionLots + RegisterRecords.AllocatedInAssignedProductionLots
		ELSE
			0
	END) AS InProgress,
	
	SUM(CASE
		WHEN RegisterRecords.ReceiptOrder = UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory + RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
		ELSE
			0
	END) + SUM(RegisterRecords.Done) AS Done,
	
	SUM(RegisterRecords.ToSupply + RegisterRecords.Ordered - RegisterRecords.AllocatedInFreeProductionLots - RegisterRecords.AllocatedInAssignedProductionLots - RegisterRecords.AllocatedFromAvailableInventory - RegisterRecords.AllocatedFromAvailableInventoryWithAssignment) AS Left
	
FROM
	InformationRegister.OrderStructure AS RegisterRecords
	
	INNER JOIN InformationRegister.CacheOfOrderStructureMasterData AS NSICache
	ON RegisterRecords.Products        = NSICache.Products
	 AND RegisterRecords.Characteristic      = NSICache.Characteristic
	 AND RegisterRecords.Warehouse               = NSICache.Warehouse
	 AND RegisterRecords.Purpose          = NSICache.Purpose
	 AND RegisterRecords.ProductionOrder = NSICache.ProductionOrder
	 AND NSICache.ToPlan
	 AND NSICache.SupplyType = VALUE(Enum.SupplyTypes.Production)
	
	LEFT JOIN InformationRegister.TargetOrderStructureSchedule AS RegulatorySchedule
	ON RegisterRecords.ProductionOrder = RegulatorySchedule.ProductionOrder
	 AND RegisterRecords.KeyLot          = RegulatorySchedule.KeyLot
	 AND RegisterRecords.Stage                = RegulatorySchedule.Stage
	 AND RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
				
	LEFT JOIN Document.ProductionOrder2_2.ManufacturedProduct AS OrderProducts_
	ON OrderProducts_.Ref = &amp;ProductionOrder
	 AND OrderProducts_.KeyProducts = RegisterRecords.KeyProducts
	 AND RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct)
	
WHERE
	RegisterRecords.ProductionOrder = &amp;ProductionOrder
	
{WHERE
	RegisterRecords.LineKind AS LineKind
}
	
GROUP BY
	RegisterRecords.Products,
	RegisterRecords.Characteristic,
	RegisterRecords.Warehouse,
	RegisterRecords.Purpose,
	RegisterRecords.ProductionOrder,
	RegisterRecords.KeyProducts
	
HAVING
	SUM(RegisterRecords.ToSupply) + SUM(RegisterRecords.Ordered) + SUM(RegisterRecords.Done) > 0</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
