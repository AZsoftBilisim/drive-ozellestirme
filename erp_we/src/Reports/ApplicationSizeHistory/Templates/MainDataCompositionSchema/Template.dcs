		<dataSource>DataSource1</dataSource>
		<query>SELECT
	SizeOfApplicationMetadataObjectsSliceLast.DataAreaAuxiliaryData AS ApplicationNumber,
	SizeOfApplicationMetadataObjectsSliceLast.MetadataObject AS MetadataObject,
	SizeOfApplicationMetadataObjectsSliceLast.Size AS Size,
	SizeOfApplicationMetadataObjectsSliceLast.Period AS Period
INTO MetadataSizeAtPeriodStart
FROM
	InformationRegister.SizeOfApplicationMetadataObjects.SliceLast(&amp;BegPeriodFix {&amp;BegPeriod},
		{(DataAreaAuxiliaryData) AS ApplicationNumber, (MetadataObject) AS MetadataObject}) AS
		SizeOfApplicationMetadataObjectsSliceLast
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	SizeOfApplicationMetadataObjectsSliceLast.DataAreaAuxiliaryData AS ApplicationNumber,
	SizeOfApplicationMetadataObjectsSliceLast.MetadataObject AS MetadataObject,
	SizeOfApplicationMetadataObjectsSliceLast.Size AS Size,
	SizeOfApplicationMetadataObjectsSliceLast.Period AS Period
INTO MetadataSizeAtPeriodEnd
FROM
	InformationRegister.SizeOfApplicationMetadataObjects.SliceLast(&amp;EndPeriodFix {&amp;NdPeriod},
		{(DataAreaAuxiliaryData) AS ApplicationNumber, (MetadataObject) AS MetadataObject}) AS
		SizeOfApplicationMetadataObjectsSliceLast
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	MetadataSizeAtPeriodStart.ApplicationNumber AS ApplicationNumber,
	MetadataSizeAtPeriodStart.MetadataObject AS MetadataObject,
	MetadataSizeAtPeriodStart.Size AS SizeAtPeriodStart,
	MetadataSizeAtPeriodStart.Period AS SizeCalculationDateAtPeriodStart,
	0 AS SizeAtPeriodEnd,
	DATETIME(1, 1, 1) AS SizeCalculationDateAtPeriodEnd
{SELECT
	ApplicationNumber,
	MetadataObject,
	SizeAtPeriodStart,
	SizeCalculationDateAtPeriodStart,
	SizeAtPeriodEnd,
	SizeCalculationDateAtPeriodEnd}
FROM
	MetadataSizeAtPeriodStart AS MetadataSizeAtPeriodStart

UNION ALL

SELECT
	MetadataSizeAtPeriodEnd.ApplicationNumber AS ApplicationNumber,
	MetadataSizeAtPeriodEnd.MetadataObject AS MetadataObject,
	0 AS SizeAtPeriodStart,
	DATETIME(1, 1, 1) AS SizeCalculationDateAtPeriodStart,
	MetadataSizeAtPeriodEnd.Size AS SizeAtPeriodEnd,
	MetadataSizeAtPeriodEnd.Period AS SizeCalculationDateAtPeriodEnd
FROM
	MetadataSizeAtPeriodEnd AS MetadataSizeAtPeriodEnd</query>
		<autoFillFields>false</autoFillFields>
