						<v8:content>NFD=3</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>NFD=3</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>NFD=3</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MarkNegatives</dcscor:parameter>
				<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>Growth_Percentage</dataPath>
		<expression> Case
			When Round(SizeAtPeriodStart / 1024 / 1024, 2) = 0
				Then 
					Case
						When Round(SizeAtPeriodEnd / 1024 / 1024, 2) = 0
						Then 0 
						Else 100 
					End
			Else (Round(SizeAtPeriodEnd / 1024 / 1024, 2) / Round(SizeAtPeriodStart / 1024 / 1024,2) -1) * 100
		End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Increase, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>افزایش، درصد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Accrescimento, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wzrost , %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Прирост, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Artış, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Tăng, %</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MarkNegatives</dcscor:parameter>
				<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>SettlementDatesOfPeriodsPresentation</dataPath>
		<expression>"" + Case When SizeCalculationDateAtPeriodStart &lt;&gt; DateTime(1,1,1) Then Format(SizeCalculationDateAtPeriodStart, "DF=dd.MM.yyyy") + "And" Else "" End + Format(SizeCalculationDateAtPeriodEnd, "DF=dd.MM.yyyy")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Presentation of period calculation dates</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>نمایش تاریخ‌های محاسبه دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Представление дат расчетов периодов</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem hesaplama tarihlerinin gösterimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Trình bày ngày tính toán của kỳ</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Presentation of period calculation dates</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Presentation of period calculation dates</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>SizeCalculationDateAtPeriodEnd</dataPath>
		<expression>Max(SizeCalculationDateAtPeriodEnd)</expression>
	</totalField>
	<totalField>
		<dataPath>SizeCalculationDateAtPeriodStart</dataPath>
		<expression>Max(SizeCalculationDateAtPeriodStart)</expression>
	</totalField>
	<totalField>
		<dataPath>Growth_Absolute</dataPath>
		<expression>Round(Sum(SizeAtPeriodEnd / 1024 / 1024), 3) - Round(Sum(SizeAtPeriodStart / 1024 / 1024), 3)</expression>
	</totalField>
	<totalField>
		<dataPath>Growth_Percentage</dataPath>
		<expression> Case
			When Round(Sum(SizeAtPeriodStart / 1024 / 1024), 2) = 0
				Then 
					Case
						When Round(Sum(SizeAtPeriodEnd / 1024 / 1024), 2) = 0
						Then 0 
						Else 100 
					End
			Else (Round(Sum(SizeAtPeriodEnd / 1024 / 1024), 2) / Round(Sum(SizeAtPeriodStart / 1024 / 1024),2) -1) * 100
		End</expression>
	</totalField>
	<totalField>
		<dataPath>SizeAtPeriodEnd</dataPath>
		<expression>Sum(SizeAtPeriodEnd) / 1024 / 1024</expression>
	</totalField>
	<totalField>
		<dataPath>SizeAtPeriodStart</dataPath>
		<expression>Sum(SizeAtPeriodStart) / 1024 / 1024</expression>
	</totalField>
	<totalField>
		<dataPath>SettlementDatesOfPeriodsPresentation</dataPath>
		<expression>"" + Case When Max(SizeCalculationDateAtPeriodStart) &lt;&gt; DateTime(1,1,1) Then Format(Max(SizeCalculationDateAtPeriodStart), "DF=dd.MM.yyyy") + "And" Else "" End + Format(Max(SizeCalculationDateAtPeriodEnd), "DF=dd.MM.yyyy")</expression>
	</totalField>
