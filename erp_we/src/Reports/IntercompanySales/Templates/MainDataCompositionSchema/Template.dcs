		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SUM(Table.Count)    AS Count,
	SUM(Table.Revenue)       AS Revenue,
	SUM(Table.Cost_) AS Cost_,
	SUM(Table.AddExpensesForGoods)    AS AddExpensesForGoods,
	SUM(Table.Revenue)
		 - SUM(Table.Cost_)
		 - SUM(Table.AddExpensesForGoods) AS GrossProfit,
	CAST(
			CASE WHEN SUM(Table.Revenue) &lt;&gt; 0 THEN
				(SUM(Table.Revenue)
					 - SUM(Table.Cost_)
					 - SUM(Table.AddExpensesForGoods)
					) / SUM(Table.Revenue)
				ELSE
					0
		END * 100
		AS NUMBER(31,2)) AS Profitability,
	CASE
		WHEN Table.Partner = VALUE(Catalog.Partners.OurEnterprise)
			THEN TRUE
		ELSE FALSE
	END                  AS IntercompanySales,
	Table.Products   AS Products,
	Table.Characteristic AS Characteristic,
	Table.Organization    AS Organization,
	Table.Seller       AS Seller,
	Table.Partner        AS Partner,
	Table.LineOfBusiness AS LineOfBusiness,
	Table.SalesOrder   AS SalesOrder,
	Table.Department  AS Department,
	Table.Warehouse          AS Warehouse,
	Table.Counterparty     AS Counterparty,
	Table.Customer     AS Customer,
	Table.Vendor      AS Vendor,
	Table.Manager       AS Manager,
	Table.SalesOpportunity         AS SalesOpportunity,
	Table.SalesOpportunity.EmployeeResponsible AS OpportunityManager,
	Table.InventoryOwnerAttribute     AS InventoryOwnerAttribute,
	Table.Recorder,
	Table.SecondPeriod,
	Table.Day,
	Table.Week,
	Table.TenDays,
	Table.Month,
	Table.Quarter,
	Table.HalfYear,
	Table.Year
FROM
	(SELECT
		ISNULL(Sales.SalesOrder.SalesOpportunity, VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)) AS SalesOpportunity,
		Sales.ItemsLocationAttributes.Products   AS Products,
		Sales.ItemsLocationAttributes.Characteristic AS Characteristic,
		Sales.AccountingDimensionByPartners.Organization     AS Organization,
		Sales.AccountingDimensionByPartners.Organization     AS Seller,
		Sales.AccountingDimensionByPartners.Partner         AS Partner,
		Sales.AccountingDimensionByPartners.LineOfBusiness AS LineOfBusiness,
		Sales.InventoryOwnerAttribute AS InventoryOwnerAttribute,
		Sales.InventoryOwnerAttribute.GoodsOwner AS Vendor,
		ISNULL(Sales.SalesOrder.Manager, UNDEFINED) AS Manager,
		
		CASE WHEN Sales.Recorder = UNDEFINED THEN
			NULL
		ELSE
			Sales.Recorder
		END AS Recorder,

		CASE WHEN Sales.SalesOrder REFS Document.SalesOrder
		 OR Sales.SalesOrder REFS Document.RequestForReturnOfGoodsFromCustomer
		THEN
			Sales.SalesOrder
		ELSE
			UNDEFINED
		END AS SalesOrder,
		Sales.Department AS Department,
		Sales.ItemsLocationAttributes.StorageLocation AS Warehouse,
		BuyersCounterparties.Ref AS Counterparty,
		BusinessBuyers.Ref AS Customer,
		Sales.CountTurnover   AS Count,
		Sales.RevenueAmountTurnover AS Revenue,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
				Sales.RevenueAmountTurnover
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE) THEN
				CAST(Sales.CountTurnover * ISNULL(CostOfProducts.Cost, 0) AS NUMBER(31,2))
			ELSE
				Sales.CostTurnover
		END AS Cost_,
		CASE
			WHEN Sales.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods) THEN
				 0
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE) THEN
				CAST(Sales.CountTurnover * ISNULL(CostOfProducts.AdditionalExpenseCost, 0) AS NUMBER(31,2))
			ELSE
				Sales.AddExpensesForGoodsTurnover
		END                   AS AddExpensesForGoods,
		Sales.SecondPeriod   AS SecondPeriod,
		Sales.DayPeriod      AS Day,
		Sales.WeekPeriod    AS Week,
		Sales.TenDaysPeriod    AS TenDays,
		Sales.MonthPeriod     AS Month,
		Sales.QuarterPeriod   AS Quarter,
		Sales.HalfYearPeriod AS HalfYear,
		Sales.YearPeriod       AS Year
	{SELECT
		Recorder,
		SecondPeriod,
		Day,
		Week,
		TenDays,
		Month,
		Quarter,
		HalfYear,
		Year}
	FROM
		AccumulationRegister.RevenueAndCOGS.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;PeriodEnding)}, Auto, ) AS Sales

			{LEFT JOIN Catalog.Companies AS BusinessBuyers
			ON Sales.AccountingDimensionByPartners.Counterparty = BusinessBuyers.Ref}

			{LEFT JOIN Catalog.Companies AS BuyersCounterparties
			ON Sales.AccountingDimensionByPartners.Counterparty = BuyersCounterparties.Ref}

			{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
			ON Sales.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
				AND (Sales.AccountingDimensionByPartners.Organization = CostOfProducts.Organization)
				AND (Sales.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute)
				AND (CostOfProducts.Period = BEGINOFPERIOD(Sales.MonthPeriod,MONTH))} // because the cost of goods is stored by months

			LEFT JOIN Document.InventoryCostCalculation.Companies AS CalculationOfCost
			ON (BEGINOFPERIOD(Sales.MonthPeriod, MONTH) = BEGINOFPERIOD(CalculationOfCost.Ref.Date, MONTH)) // because the document is started 1 for a month
				AND (Sales.AccountingDimensionByPartners.Organization = CalculationOfCost.Organization)
				AND (CalculationOfCost.Ref.Posted)
				AND CalculationOfCost.Ref.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
	WHERE
		Sales.AccountingDimensionByPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	{WHERE
		Sales.ItemsLocationAttributes.Products.* AS Products,
		Sales.ItemsLocationAttributes.Characteristic.* AS Characteristic,
		Sales.AccountingDimensionByPartners.Organization.* AS Organization,
		Sales.AccountingDimensionByPartners.Partner.* AS Partner,
		Sales.ItemsLocationAttributes.StorageLocation.* AS Warehouse,
		Sales.AccountingDimensionByPartners.Counterparty.* AS Counterparty,
		(ISNULL(Sales.SalesOrder.SalesOpportunity, VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef))).* AS SalesOpportunity,
		(Sales.ItemsLocationAttributes.Products, Sales.ItemsLocationAttributes.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)
	}
	) AS Table

GROUP BY
	Table.SalesOpportunity,
	Table.Products,
	Table.Characteristic,
	Table.Organization,
	Table.Seller,
	Table.Partner,
	Table.LineOfBusiness,
	Table.Recorder,
	Table.SecondPeriod,
	Table.Day,
	Table.Week,
	Table.TenDays,
	Table.Month,
	Table.Quarter,
	Table.HalfYear,
	Table.Year,
	Table.SalesOrder,
	Table.Department,
	Table.Warehouse,
	Table.Counterparty,
	Table.Customer,
	Table.Vendor,
	Table.Manager,
	Table.InventoryOwnerAttribute

HAVING
	(SUM(Table.Count) &lt;&gt; 0
		OR SUM(Table.Revenue) &lt;&gt; 0
		OR SUM(Table.Cost_) &lt;&gt; 0
		OR SUM(Table.AddExpensesForGoods) &lt;&gt; 0)</query>
	</dataSet>
	<totalField>
		<dataPath>GrossProfit</dataPath>
		<expression>Sum(GrossProfit)</expression>
	</totalField>
	<totalField>
		<dataPath>Revenue</dataPath>
		<expression>Sum(Revenue)</expression>
	</totalField>
	<totalField>
		<dataPath>AddExpensesForGoods</dataPath>
		<expression>Sum(AddExpensesForGoods)</expression>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<totalField>
		<dataPath>Profitability</dataPath>
		<expression>Cast(
	Case When Sum(Revenue) &lt;&gt; 0 Then
            (Sum(Revenue)- Sum(Cost_) - Sum(AddExpensesForGoods))
            / Sum(Revenue)
	Else
		0
	End * 100, "NUMBER(15,2)")</expression>
	</totalField>
	<totalField>
		<dataPath>Cost_</dataPath>
		<expression>Sum(Cost_)</expression>
	</totalField>
