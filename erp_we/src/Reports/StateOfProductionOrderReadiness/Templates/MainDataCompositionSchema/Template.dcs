				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>شرح مرحله (گروه‌بندی‌شده)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Этап наименование (сгруппированный)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
