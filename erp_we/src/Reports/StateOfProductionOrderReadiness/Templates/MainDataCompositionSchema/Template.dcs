		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Orders.Ref AS ProductionOrder,
	StatesOfProductionOrders.EventDate AS DueDate_2,
	
	CASE
		WHEN NOT ISNULL(StatesOfProductionOrders.EventDate, DATETIME(1,1,1)) = DATETIME(1,1,1) 
			AND &amp;UpdateDate &gt; StatesOfProductionOrders.EventDate
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	FALSE AS ThereAreStagesThatHaveBeenStarted,
		
	-Orders.Priority.AddlOrderingAttribute AS PriorityQueue,
	Orders.Department.AddlOrderingAttribute AS DivisionQueue,
	Orders.Queue AS Queue,
	
	CatStages.Ref AS Stage,
	CatStages.Production_Stage AS Production_Stage,
	
	SUM(CASE CatStages.UnitOfMeasureOfStageDuration
					WHEN VALUE(Enum.TimeMeasureUnits.MINUTE)
						THEN 60
					WHEN VALUE(Enum.TimeMeasureUnits.HOUR)
						THEN 3600
					WHEN VALUE(Enum.TimeMeasureUnits.DAY)
						THEN 86400
					WHEN VALUE(Enum.TimeMeasureUnits.Days1)
						THEN 86400
					ELSE 1
				END
				* ISNULL(CatStages.StageDuration, 0)) AS Plan,
	0 AS Real
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	
	INNER JOIN Document.ProductionOrder2_2 AS Orders
		ON Schedule.ProductionOrder = Orders.Ref
		AND Orders.Status = VALUE(Enum.ProductionOrderStatuses2_2.ToProduce)
		AND Orders.Posted
		AND Orders.DynamicStructure
		
	LEFT JOIN Catalog.ProductionStages AS CatStages
		ON Schedule.Stage = CatStages.Ref
		
	LEFT JOIN InformationRegister.StatesOfProductionOrders AS StatesOfProductionOrders
		ON Orders.Ref = StatesOfProductionOrders.OrderDocument
WHERE
	Schedule.Stage &lt;&gt; VALUE(Catalog.ProductionStages.EmptyRef)
	AND VALUETYPE(Schedule.Stage) = TYPE(Catalog.ProductionStages)
	AND Schedule.ScheduleStatus = &amp;ScheduleStatus
	
GROUP BY
	Orders.Ref,
	StatesOfProductionOrders.EventDate,
	-Orders.Priority.AddlOrderingAttribute,
	Orders.Department.AddlOrderingAttribute,
	CatStages.Production_Stage,
	CatStages.Ref
	
UNION ALL

SELECT
	Orders.Ref AS ProductionOrder,
	StatesOfProductionOrders.EventDate AS DueDate_2,
	
	CASE
		WHEN NOT ISNULL(StatesOfProductionOrders.EventDate, DATETIME(1,1,1)) = DATETIME(1,1,1) 
			AND &amp;UpdateDate &gt; StatesOfProductionOrders.EventDate
			THEN TRUE
		ELSE FALSE
	END AS Overdue,
	MAX(CASE 
				WHEN Stages.Status IN (VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
									VALUE(Enum.StatusesOfProductionStages2_2.Completed))
					THEN TRUE
			ELSE FALSE
		END) AS ThereAreStagesThatHaveBeenStarted,
	
	-Orders.Priority.AddlOrderingAttribute AS PriorityQueue,
	Orders.Department.AddlOrderingAttribute AS DivisionQueue,
	Orders.Queue AS Queue,
	
	CatStages.Ref AS Stage,
	CatStages.Production_Stage AS Production_Stage,
	
	SUM(CASE Stages.UnitOfMeasureOfStageDuration
					WHEN VALUE(Enum.TimeMeasureUnits.MINUTE)
						THEN 60
					WHEN VALUE(Enum.TimeMeasureUnits.HOUR)
						THEN 3600
					WHEN VALUE(Enum.TimeMeasureUnits.DAY)
						THEN 86400
					WHEN VALUE(Enum.TimeMeasureUnits.Days1)
						THEN 86400
					ELSE 1
				END
				* ISNULL(Stages.StageDuration, 0)
				* CASE
					WHEN Stages.NumberOfPackagesPlan &gt; 0
						THEN (Stages.NumberOfPackagesPlan - Stages.NumberOfPackagesCanceled)/Stages.NumberOfPackagesPlan
					ELSE 1
				END) AS Plan,
	SUM(CASE Stages.UnitOfMeasureOfStageDuration
					WHEN VALUE(Enum.TimeMeasureUnits.MINUTE)
						THEN 60
					WHEN VALUE(Enum.TimeMeasureUnits.HOUR)
						THEN 3600
					WHEN VALUE(Enum.TimeMeasureUnits.DAY)
						THEN 86400
					WHEN VALUE(Enum.TimeMeasureUnits.Days1)
						THEN 86400
					ELSE 1
				END
				* ISNULL(Stages.StageDuration, 0)
				* CASE
					WHEN Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
						THEN 1
					WHEN Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Initiated)
							AND Stages.NumberOfPackagesReal &gt; 0
							AND Stages.NumberOfPackagesPlan &gt; 0
							AND Stages.PackagePlan = Stages.PackageActualData
						THEN Stages.NumberOfPackagesReal / (Stages.NumberOfPackagesPlan - Stages.NumberOfPackagesCanceled)
					WHEN Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Initiated)
							AND Stages.NumberOfPackagesReal &gt; 0
							AND Stages.NumberOfPackagesPlan &gt; 0
						THEN (Stages.NumberOfPackagesReal * ISNULL(&amp;PackagingFactorFact, 1) / (Stages.NumberOfPackagesPlan * ISNULL(&amp;PackagingFactorPlan, 1) - Stages.NumberOfPackagesCanceled * ISNULL(&amp;PackagingFactorCanceled, 1)))
					ELSE 0
				END
				* CASE
					WHEN Stages.NumberOfPackagesPlan &gt; 0
						THEN (Stages.NumberOfPackagesPlan - Stages.NumberOfPackagesCanceled)/Stages.NumberOfPackagesPlan
					ELSE 1
				END) AS Real
FROM
	Document.ProductionStage2_2 AS Stages
	
	INNER JOIN Document.ProductionOrder2_2 AS Orders
		ON Stages.ReferenceOrder = Orders.Ref
		AND Orders.Status = VALUE(Enum.ProductionOrderStatuses2_2.ToProduce)
		AND Orders.Posted
		AND Orders.DynamicStructure
	
	INNER JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
		ON Schedule.Stage = Stages.Ref
		
	LEFT JOIN Catalog.ProductionStages AS CatStages
		ON Stages.Stage = CatStages.Ref
		
	LEFT JOIN InformationRegister.StatesOfProductionOrders AS StatesOfProductionOrders
		ON Orders.Ref = StatesOfProductionOrders.OrderDocument
WHERE
	Stages.Posted
	
GROUP BY
	Orders.Ref,
	StatesOfProductionOrders.EventDate,
	-Orders.Priority.AddlOrderingAttribute,
	Orders.Department.AddlOrderingAttribute,
	CatStages.Production_Stage,
	CatStages.Ref
	</query>
	</dataSet>
