					<v8:lang>it</v8:lang>
					<v8:content>Production phase (by stages)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Production phase (by stages)</v8:content>
				</v8:item>
				<v8:item>
