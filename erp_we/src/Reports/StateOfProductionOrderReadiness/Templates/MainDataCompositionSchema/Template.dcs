	<calculatedField>
		<dataPath>ReadinessPercentage</dataPath>
		<expression/>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Readiness percent</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>درصد آمادگی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Процент готовности</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
