			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Production order (grouped)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Production order (grouped)</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
		<presentationExpression>ProductionOrder.Number</presentationExpression>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.ProductionOrder2_2</v8:Type>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>ReadinessPercentage</dataPath>
		<expression>Case
	When Sum(Plan) = 0 
		Then 0
	Else Sum(Real)/Sum(Plan)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ProductionOrderResource</dataPath>
		<expression>Array(ProductionOrderResource)</expression>
	</totalField>
	<totalField>
		<dataPath>StageResourceName</dataPath>
		<expression>ProductionManagement.FormattedPresentationOfArrayOfStages(
	Array(ProductionManagement.FormattedPresentationOfArrayOfStages(StageResourceName, StageState))
)</expression>
	</totalField>
	<totalField>
		<dataPath>ResourceStage</dataPath>
		<expression>Array(ResourceStage)</expression>
	</totalField>
	<totalField>
		<dataPath>ProductionOrderNumber</dataPath>
		<expression>Array(ProductionOrderNumber)</expression>
	</totalField>
	<totalField>
		<dataPath>ThereAreStagesThatHaveBeenStarted</dataPath>
		<expression>Max(ThereAreStagesThatHaveBeenStarted)</expression>
	</totalField>
