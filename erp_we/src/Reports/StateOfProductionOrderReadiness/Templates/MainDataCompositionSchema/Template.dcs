		<field xsi:type="DataSetFieldField">
			<dataPath>Begin</dataPath>
			<field>Begin</field>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Stages.ProductionOrder        AS ProductionOrder,
	Stages.ProductionStageByStages AS ProductionStageByStages,
	Stages.ResourceStage                 AS ResourceStage,
	Stages.StageResourceName     AS StageResourceName,
	Stages.StageState             AS StageState
FROM
(SELECT
	Orders.Ref AS ProductionOrder,
	Schedule.Order AS Order,
	Schedule.Begin AS Begin,
	CatStages.Production_Stage AS ProductionStageByStages,
	CatStages.Ref AS ResourceStage,
	CatStages.Description AS StageResourceName,
	CASE
		WHEN Schedule.Begin &lt; &amp;UpdateDate
			THEN "Overdue"
		ELSE ""
	END AS StageState
	
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	
	INNER JOIN Document.ProductionOrder2_2 AS Orders
		ON Schedule.ProductionOrder = Orders.Ref
		AND Orders.Status = VALUE(Enum.ProductionOrderStatuses2_2.ToProduce)
		AND Orders.Posted
		AND Orders.DynamicStructure
	
	LEFT JOIN Catalog.ProductionStages AS CatStages
		ON Schedule.Stage = CatStages.Ref
WHERE
	Schedule.Stage &lt;&gt; VALUE(Catalog.ProductionStages.EmptyRef)
	AND VALUETYPE(Schedule.Stage) = TYPE(Catalog.ProductionStages)
	AND Schedule.ScheduleStatus = &amp;ScheduleStatus
	
UNION ALL

SELECT
	Orders.Ref AS ProductionOrder,
	Schedule.Order AS Order,
	Schedule.Begin AS Begin,
	CatStages.Production_Stage AS ProductionStageByStages,
	CatStages.Ref AS ResourceStage,
	CatStages.Description AS StageResourceName,
	CASE
		WHEN Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Initiated) AND Schedule.Ending &gt;= &amp;UpdateDate
			THEN "Initiated"
		WHEN Schedule.Ending &lt; &amp;UpdateDate OR (Stages.Status &lt;&gt; VALUE(Enum.StatusesOfProductionStages2_2.Initiated) AND Schedule.Begin &lt; &amp;UpdateDate)
			THEN "Overdue"
		ELSE ""
	END AS StageState
	
FROM
	Document.ProductionStage2_2 AS Stages
	
	INNER JOIN Document.ProductionOrder2_2 AS Orders
		ON Stages.ReferenceOrder = Orders.Ref
		AND Orders.Status = VALUE(Enum.ProductionOrderStatuses2_2.ToProduce)
		AND Orders.Posted
		AND Orders.DynamicStructure
		
	LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
		ON Schedule.Stage = Stages.Ref
		
	LEFT JOIN Catalog.ProductionStages AS CatStages
		ON Stages.Stage = CatStages.Ref
WHERE
	Stages.Status &lt;&gt; VALUE(Enum.StatusesOfProductionStages2_2.Completed)
	AND Schedule.Stage &lt;&gt; VALUE(Catalog.ProductionStages.EmptyRef)
	AND Schedule.ScheduleStatus = &amp;ScheduleStatus) AS Stages

ORDER BY
	Stages.Order DESC,
	Stages.Begin,
	Stages.ResourceStage</query>
	</dataSet>
