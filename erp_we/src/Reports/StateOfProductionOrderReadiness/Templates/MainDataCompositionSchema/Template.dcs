	<calculatedField>
		<dataPath>PercentageOfReadinessGrouping</dataPath>
		<expression>Case
	When PlanByOrder = 0
		Then 0
	When FactByOrder/PlanByOrder &lt; 0.2
		Then 0
	When FactByOrder/PlanByOrder &lt; 0.4 And FactByOrder/PlanByOrder &gt;= 0.2
		Then 20
	When FactByOrder/PlanByOrder &lt; 0.6 And FactByOrder/PlanByOrder &gt;= 0.4
		Then 40
	When FactByOrder/PlanByOrder &lt; 0.8 And FactByOrder/PlanByOrder &gt;= 0.6
		Then 60
	When FactByOrder/PlanByOrder &lt; 1 And FactByOrder/PlanByOrder &gt;= 0.8
		Then 80
	When FactByOrder/PlanByOrder = 1
		Then 100
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Readiness percent, grouping</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>درصد آمادگی، گروه‌بندی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Процент готовности, группировка</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
