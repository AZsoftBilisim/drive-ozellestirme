				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>There are started stages</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>There are started stages</v8:content>
				</v8:item>
