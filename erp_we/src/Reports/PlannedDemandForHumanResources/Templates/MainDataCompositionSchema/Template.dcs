		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN PlansOfHumanResourcesOccupancyTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN PlansOfHumanResourcesOccupancyTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN PlansOfHumanResourcesOccupancyTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN PlansOfHumanResourcesOccupancyTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN PlansOfHumanResourcesOccupancyTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN PlansOfHumanResourcesOccupancyTurnovers.YearPeriod
		ELSE PlansOfHumanResourcesOccupancyTurnovers.DayPeriod
	END AS DynamicPeriod,
	PlansOfHumanResourcesOccupancyTurnovers.WorkKind AS WorkKind,
	PlansOfHumanResourcesOccupancyTurnovers.ProductionDispatcherBusinessUnit AS ProductionDispatcherBusinessUnit,
	PlansOfHumanResourcesOccupancyTurnovers.AssigneeBusinessUnit AS AssigneeBusinessUnit,
	PlansOfHumanResourcesOccupancyTurnovers.ProductsItems AS ProductsItems,
	PlansOfHumanResourcesOccupancyTurnovers.ItemVariant AS ItemVariant,
	PlansOfHumanResourcesOccupancyTurnovers.ProductBOM AS BillOfMaterials,
	PlansOfHumanResourcesOccupancyTurnovers.ProductionPlan AS ProductionPlan,
	PlansOfHumanResourcesOccupancyTurnovers.ProductionDate AS ProductionDate,
	CASE
		WHEN EmployeeWorkKinds.LaborInputMultiplier = 0
			THEN 0
		ELSE PlansOfHumanResourcesOccupancyTurnovers.CountTurnover * EmployeeWorkKinds.LaborInput / EmployeeWorkKinds.LaborInputMultiplier
	END AS NumberOfLaborCosts,
	ProductionPlansTurnovers.CountTurnover AS ProductsQuantity
FROM
	AccumulationRegister.PlansOfHumanResourcesOccupancy.Turnovers(, , Auto, Scenario = &amp;Scenario) AS PlansOfHumanResourcesOccupancyTurnovers
		{LEFT JOIN AccumulationRegister.ProductionPlans.Turnovers({(&amp;PlanPeriodStart)}, {(&amp;PlanPeriodEnd)}, Day, Scenario = &amp;Scenario {(Products) AS ProductsItems, (Characteristic) AS ItemVariant, (Department) AS ProductionDispatcherBusinessUnit}) AS ProductionPlansTurnovers
		ON PlansOfHumanResourcesOccupancyTurnovers.ProductsItems = ProductionPlansTurnovers.Products
			AND PlansOfHumanResourcesOccupancyTurnovers.ItemVariant = ProductionPlansTurnovers.Characteristic
			AND PlansOfHumanResourcesOccupancyTurnovers.ProductBOM = ProductionPlansTurnovers.BillOfMaterials
			AND PlansOfHumanResourcesOccupancyTurnovers.ProductionDispatcherBusinessUnit = ProductionPlansTurnovers.Department
			AND PlansOfHumanResourcesOccupancyTurnovers.Scenario = ProductionPlansTurnovers.Scenario
			AND PlansOfHumanResourcesOccupancyTurnovers.ProductionPlan = ProductionPlansTurnovers.ProductionPlan
			AND PlansOfHumanResourcesOccupancyTurnovers.ProductionDate = ProductionPlansTurnovers.Period}
		LEFT JOIN Catalog.EmployeeWorkKinds AS EmployeeWorkKinds
		ON PlansOfHumanResourcesOccupancyTurnovers.WorkKind = EmployeeWorkKinds.Ref</query>
	</dataSet>
	<totalField>
		<dataPath>ProductsQuantity</dataPath>
		<expression>Sum(ProductsQuantity)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfLaborCosts</dataPath>
		<expression>Sum(NumberOfLaborCosts)</expression>
	</totalField>
