				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Purchase order</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>سفارش خرید</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Ordine al fornitore</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Zamówienie do dostawcy</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Заказ поставщику</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Satın alma siparişi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Đơn hàng đặt nhà cung cấp</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterAccountingAnalyticsForPartners.Organization AS Organization,
	RegisterAccountingAnalyticsForPartners.Partner AS Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty AS Counterparty,
	RegisterAccountingAnalyticsForPartners.Contract AS Contract,
	RegisterAccountingAnalyticsForPartners.LineOfBusiness AS LineOfBusinessOfAnalytics,
	RegisterAccountingAnalyticsForPartners.DimensionKey AS DimensionKey
	
INTO RevisingAccountingForPartners
FROM
	InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
;
///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ARAPObjects.Organization AS Organization,
	ARAPObjects.Partner AS Partner,
	ARAPObjects.Counterparty AS Counterparty,
	ARAPObjects.Contract AS Contract, 
	ARAPObjects.LineOfBusiness AS LineOfBusinessOfARAPObject,
	ARAPObjects.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness AS ARAPAccountingRegistersAreNotDividedByLinesOfBusiness,
	ARAPObjects.Ref AS ARAPObject,
	ARAPObjects.Object AS Object
	
INTO ARAPObjects
FROM
	Catalog.ARAPObjects AS ARAPObjects
;
///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	VendorsARAPAccounting.Period AS Period,
	CASE WHEN VendorsARAPAccounting.Recorder = UNDEFINED THEN
		NULL
	ELSE
		CASE WHEN VALUETYPE(ARAPObjects.Object) IN (TYPE(Document.BankAccountReceiptNote),
														TYPE(Document.BankAccountIssue),
														TYPE(Document.CashAccountReceiptNote),
														TYPE(Document.CashVoucher),
														TYPE(Document.PaymentCardTransaction),
														TYPE(Document.OBEntry))
					AND VendorsARAPAccounting.Recorder = &amp;CurrentDocument
				THEN ARAPObjects.Object 
			ELSE VendorsARAPAccounting.Recorder
		END
	END AS Recorder,
	VendorsARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CASE WHEN VALUETYPE(ARAPObjects.Object) IN (TYPE(Document.BankAccountReceiptNote),
														TYPE(Document.BankAccountIssue),
														TYPE(Document.CashAccountReceiptNote),
														TYPE(Document.CashVoucher),
														TYPE(Document.PaymentCardTransaction),
														TYPE(Document.OBEntry))
					AND VendorsARAPAccounting.Recorder = &amp;CurrentDocument
				THEN VendorsARAPAccounting.Recorder 
			ELSE ARAPObjects.Object
	END AS PurchaseOrder,
	VendorsARAPAccounting.Currency AS Currency,
	
	DimensionByPartners.Partner AS Partner,
	DimensionByPartners.Organization AS Organization,
	DimensionByPartners.Counterparty AS Counterparty,
	DimensionByPartners.Contract AS Contract,
	CASE WHEN NOT ARAPObjects.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN DimensionByPartners.LineOfBusinessOfAnalytics
		ELSE ARAPObjects.LineOfBusinessOfARAPObject
	END AS LineOfBusiness,
	
	// The duty of a supplier
	0 AS DebtOfSupplierOpeningBalance,
	0 AS DebtOfSupplierClosingBalance,
	
	// Supplier's debt (overdue)
	0 AS SupplierSDebtIsOverdueOpeningBalance,
	0 AS SupplierSDebtIsOverdueClosingBalance,
	
	// Our duty
	CASE WHEN VendorsARAPAccounting.SumOpeningBalance &lt; 0 THEN
		-VendorsARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS AccountsPayableOfCompanyOpeningBalance,
	
	CASE WHEN VendorsARAPAccounting.SumClosingBalance &lt; 0 THEN
		-VendorsARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS AccountsPayableOfCompanyClosingBalance,
	
	// Our debt (overdue)
	CASE WHEN VendorsARAPAccounting.Period &lt; &amp;ReportDate
		AND VendorsARAPAccounting.SumOpeningBalance &lt; 0
		AND VendorsARAPAccounting.AmountDueOpeningBalance &lt; 0
	THEN
		CASE WHEN (-VendorsARAPAccounting.SumOpeningBalance) &gt; (-VendorsARAPAccounting.AmountDueOpeningBalance - VendorsARAPAccounting.ToReceiveOpeningBalance) THEN
			-VendorsARAPAccounting.AmountDueOpeningBalance - VendorsARAPAccounting.ToReceiveOpeningBalance
		ELSE
			-VendorsARAPAccounting.SumOpeningBalance
		END
	ELSE
		0
	END AS OurDebtOverdueOpeningBalance,
	
	CASE WHEN VendorsARAPAccounting.Period &lt; &amp;ReportDate
		AND VendorsARAPAccounting.SumClosingBalance &lt; 0
		AND VendorsARAPAccounting.AmountDueClosingBalance &lt; 0
	THEN
		CASE WHEN (-VendorsARAPAccounting.SumClosingBalance) &gt; (-VendorsARAPAccounting.AmountDueClosingBalance - VendorsARAPAccounting.ToReceiveClosingBalance) THEN
			-VendorsARAPAccounting.AmountDueClosingBalance - VendorsARAPAccounting.ToReceiveClosingBalance
		ELSE
			-VendorsARAPAccounting.SumClosingBalance
		END
	ELSE
		0
	END AS OurDebtOverdueClosingBalance,
	
	CASE WHEN VendorsARAPAccounting.AmountDueExpense &lt;&gt; 0 THEN
		TRUE
	ELSE
		FALSE
	END AS ThisIsPaymentStageAccordingToSchedule,
	
	CASE WHEN VendorsARAPAccounting.AmountDueExpense &gt; - VendorsARAPAccounting.AmountDueClosingBalance THEN
		- VendorsARAPAccounting.AmountDueClosingBalance
	ELSE
		VendorsARAPAccounting.AmountDueExpense
	END AS Sum
	
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(, , Recorder, ,
		AccountingDimensionByPartners IN (
			SELECT
				DimensionKey
			FROM
				RevisingAccountingForPartners AS RevisingAccountingForPartners
			) {ARAPObject IN (&amp;OrderToSupplierSelection)}
	) AS VendorsARAPAccounting
	
	INNER JOIN
		RevisingAccountingForPartners AS DimensionByPartners
	ON
		VendorsARAPAccounting.AccountingDimensionByPartners = DimensionByPartners.DimensionKey
	INNER JOIN
		ARAPObjects AS ARAPObjects
	ON
		ARAPObjects.ARAPObject = VendorsARAPAccounting.ARAPObject

WHERE
	VendorsARAPAccounting.AmountDueExpense &gt; 0
	AND VendorsARAPAccounting.SumClosingBalance &lt; 0
	AND VendorsARAPAccounting.AmountDueClosingBalance &lt; 0
{WHERE
	DimensionByPartners.Partner IN (
		SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}</query>
		</item>
