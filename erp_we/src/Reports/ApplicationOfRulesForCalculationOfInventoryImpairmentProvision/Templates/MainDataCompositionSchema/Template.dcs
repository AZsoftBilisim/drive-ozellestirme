	<totalField>
		<dataPath>CountBalance</dataPath>
		<expression>Sum(CountBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageDeviation</dataPath>
		<expression>Case 
		When Sum(NetSellingValue) = 0  
			Then 0 
		Else (Sum(Cost_)-Sum(NetSellingValue)) / Sum(NetSellingValue) * 100 
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountDeviation</dataPath>
		<expression>Sum(AmountDeviation)</expression>
	</totalField>
	<totalField>
		<dataPath>PriceDeviation</dataPath>
		<expression>Case
	When Min(PriceIsIndicated) = False
		Then 0
	Else
		Case 
			When Sum(CountBalance) = 0 
				Then 0 
			Else (Sum(Cost_)-Sum(NetSellingValue)) / Sum(CountBalance) 
		End
End</expression>
		<group>Products</group>
		<group>Characteristic</group>
		<group>Series</group>
		<group>StorageLocation</group>
	</totalField>
	<totalField>
		<dataPath>Cost_</dataPath>
		<expression>Sum(Cost_)</expression>
	</totalField>
	<totalField>
		<dataPath>UnitCost</dataPath>
		<expression>Case When Sum(CountBalance) = 0 Then 0 Else Sum(Cost_) / Sum(CountBalance) End</expression>
		<group>Products</group>
		<group>Characteristic</group>
		<group>Series</group>
		<group>StorageLocation</group>
	</totalField>
	<totalField>
		<dataPath>NetSellingValue</dataPath>
		<expression>Sum(NetSellingValue)</expression>
	</totalField>
	<totalField>
		<dataPath>NetSellingPrice</dataPath>
		<expression>Case When Sum(CountBalance) = 0 Then 0 Else Sum(NetSellingValue) / Sum(CountBalance) End</expression>
		<group>Products</group>
		<group>Characteristic</group>
		<group>Series</group>
		<group>StorageLocation</group>
	</totalField>
