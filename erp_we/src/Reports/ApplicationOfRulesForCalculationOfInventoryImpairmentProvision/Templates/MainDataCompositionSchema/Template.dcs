	<calculatedField>
		<dataPath>PriceDeviation</dataPath>
		<expression>Case
	When Not PriceIsIndicated
		Then 0
	Else
		Case 
			When CountBalance = 0 
				Then 0 
			Else (Cost_-NetSellingValue) / CountBalance 
		End
End</expression>
