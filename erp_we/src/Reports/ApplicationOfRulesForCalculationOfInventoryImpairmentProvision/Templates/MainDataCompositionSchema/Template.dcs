		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys) AS
		ItemsLocationAttributes,
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Products AS
		Products,
	CAST(BalanceTable.ItemsLocationAttributes AS
		Catalog.InventoryLocationAttributeKeys).Characteristic AS Characteristic,
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Series AS Series,
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation AS
		StorageLocation,
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting) AS AccountingSection,
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds) AS InventoryOwnerAttribute,
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes) AS InventoryType,
	CAST(BalanceTable.Organization AS Catalog.Companies) AS Organization,
	BalanceTable.Lot AS Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS LotVendorAttributes,
	BalanceTable.FinancialAccountingDimension AS FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes) AS VATActivityType,
	CAST(BalanceTable.AccountingDimensionByPartners AS Catalog.DimensionKeysOfAccountingByPartners) AS
		AccountingDimensionByPartners,
	CAST(BalanceTable.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision) AS Rule,
	CAST(BalanceTable.PriceIsIndicated AS BOOLEAN) AS PriceIsIndicated,
	CAST(BalanceTable.CountBalance AS NUMBER(15, 3)) AS CountBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN CAST(BalanceTable.ManagementCost AS NUMBER(31, 2))
		ELSE CAST(BalanceTable.CostLocal AS NUMBER(31, 2))
	END AS Cost_,
	CASE
		WHEN &amp;ReportData = 1
			THEN CAST(BalanceTable.NetSellingValueOfMan AS NUMBER(31, 2))
		ELSE CAST(BalanceTable.NetSaleValueOfLocal AS NUMBER(31, 2))
	END AS NetSellingValue
{SELECT
	ItemsLocationAttributes.*,
	Products.*,
	Characteristic.*,
	Series.*,
	StorageLocation.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	InventoryType.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	AccountingDimensionByPartners.*,
	Rule.*,
	PriceIsIndicated,
	CountBalance,
	Cost_,
	NetSellingValue}
FROM
	BalanceTable AS BalanceTable
{WHERE
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys) AS ItemsLocationAttributes,
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Products AS Products,
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Characteristic AS Characteristic,
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).Series AS Series,
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys).StorageLocation AS StorageLocation,
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting) AS AccountingSection,
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds) AS InventoryOwnerAttribute,
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes) AS InventoryType,
	CAST(BalanceTable.Organization AS Catalog.Companies) AS Organization,
	BalanceTable.Lot AS Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS LotVendorAttributes,
	BalanceTable.FinancialAccountingDimension AS FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes) AS VATActivityType,
	CAST(BalanceTable.AccountingDimensionByPartners AS Catalog.DimensionKeysOfAccountingByPartners) AS AccountingDimensionByPartners,
	CAST(BalanceTable.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision) AS Rule,
	CAST(BalanceTable.CountBalance AS NUMBER(15, 3)) AS CountBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN CAST(BalanceTable.ManagementCost AS NUMBER(31, 2))
		ELSE CAST(BalanceTable.CostLocal AS NUMBER(31, 2))
	END AS Cost_,
	CASE
		WHEN &amp;ReportData = 1
			THEN CAST(BalanceTable.NetSellingValueOfMan AS NUMBER(31, 2))
		ELSE CAST(BalanceTable.NetSaleValueOfLocal AS NUMBER(31, 2))
	END AS NetSellingValue}
WHERE
	CASE
		WHEN &amp;FormationOption = 1
			THEN TRUE
		WHEN &amp;FormationOption = 2
			THEN NOT CASE
				WHEN &amp;ReportData = 1
					THEN CAST(BalanceTable.NetSellingValueOfMan AS NUMBER(31, 2))
				ELSE CAST(BalanceTable.NetSaleValueOfLocal AS NUMBER(31, 2))
			END = 0
		WHEN &amp;FormationOption = 3
			THEN CASE
				WHEN &amp;ReportData = 1
					THEN CAST(BalanceTable.NetSellingValueOfMan AS NUMBER(31, 2))
				ELSE CAST(BalanceTable.NetSaleValueOfLocal AS NUMBER(31, 2))
			END = 0
	END</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>UnitCost</dataPath>
		<expression>Case When CountBalance = 0 Then 0 Else Cost_ / CountBalance End</expression>
