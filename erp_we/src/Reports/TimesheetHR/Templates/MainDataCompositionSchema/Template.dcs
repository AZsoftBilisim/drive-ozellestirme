				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نام</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Имя</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Ad</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Name</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Name</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Name</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	DataOnEmployeeTimesheetTurnovers.Organization AS Organization,
	DataOnEmployeeTimesheetTurnovers.Employee AS Employee,
	DataOnEmployeeTimesheetTurnovers.TimeKind AS TimeKind,
	DataOnEmployeeTimesheetTurnovers.Period AS Date,
	DataOnEmployeeTimesheetTurnovers.Hours1Turnover AS Hours1,
	DataOnEmployeeTimesheetTurnovers.DaysTurnover AS Days,
	DataOnEmployeeTimesheetTurnovers.Employee.Individual AS Individual
INTO DataOnTime
FROM
	AccumulationRegister.DataOnEmployeeTimesheet.Turnovers(, , Day, ) AS DataOnEmployeeTimesheetTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DataOnTime.Employee AS Employee,
	DataOnTime.Employee.Code AS EmployeeCode,
	DataOnTime.TimeKind AS TimeKind,
	DataOnTime.Date AS Date,
	SUM(CASE
			WHEN DataOnTime.TimeKind.UnitOfMeasure = VALUE(Enum.TimeMeasureUnits.HOUR)
				THEN DataOnTime.Hours1
			ELSE DataOnTime.Days * DataOnTime.TimeKind.NumberOfHoursPerDay
		END) AS Hours1,
	SUM(DataOnTime.Days) AS Days,
	CASE
		WHEN DataOnTime.TimeKind.LetterCode = ""
			THEN "?"
		ELSE DataOnTime.TimeKind.LetterCode
	END AS LetterCode,
	DataOnTime.TimeKind.Numeric_Code AS Numeric_Code,
	DataOnTime.TimeKind.UnitOfMeasure AS UnitOfMeasure,
	DataOnTime.TimeKind.NumberOfHoursPerDay AS NumberOfHoursPerDay,
	DataOnTime.TimeKind.WorkingTime AS WorkingTime,
	DataOnTime.Employee.Individual AS Individual,
	CASE
		WHEN FullNameOfPersonsSliceLast.Name IS NULL
			THEN ""
		ELSE "" + FullNameOfPersonsSliceLast.Name + CASE
				WHEN FullNameOfPersonsSliceLast.Initials = ""
					THEN ""
				ELSE " " + FullNameOfPersonsSliceLast.Initials
			END
	END AS LastFirstName,
	DataOnTime.Individual.Description AS IndividualName,
	ISNULL(EmploymentRecordSliceLast.JobTitle, VALUE(Catalog.JobTitles.EmptyRef)) AS JobTitle,
	ISNULL(EmploymentRecordSliceLast.Department, VALUE(Catalog.BusinessStructure.EmptyRef)) AS Department,
	DataOnTime.Organization AS Organization
FROM
	DataOnTime AS DataOnTime
		LEFT JOIN InformationRegister.EmploymentRecord.SliceLast(
				,
				Organization IN
						(SELECT DISTINCT
							DataOnTime.Organization
						FROM
							DataOnTime)
					AND Employee IN
						(SELECT DISTINCT
							DataOnTime.Employee
						FROM
							DataOnTime)) AS EmploymentRecordSliceLast
		ON DataOnTime.Organization = EmploymentRecordSliceLast.Organization
			AND DataOnTime.Employee = EmploymentRecordSliceLast.Employee
		LEFT JOIN InformationRegister.FullNameOfPersons.SliceLast(
				,
				Individual IN
					(SELECT DISTINCT
						DataOnTime.Employee.Individual
					FROM
						DataOnTime)) AS FullNameOfPersonsSliceLast
		ON DataOnTime.Individual = FullNameOfPersonsSliceLast.Individual

GROUP BY
	DataOnTime.Employee,
	DataOnTime.Date,
	DataOnTime.TimeKind,
	DataOnTime.Employee.Code,
	DataOnTime.TimeKind.Numeric_Code,
	DataOnTime.TimeKind.UnitOfMeasure,
	DataOnTime.TimeKind.NumberOfHoursPerDay,
	DataOnTime.TimeKind.WorkingTime,
	DataOnTime.Employee.Individual,
	CASE
		WHEN DataOnTime.TimeKind.LetterCode = ""
			THEN "?"
		ELSE DataOnTime.TimeKind.LetterCode
	END,
	ISNULL(EmploymentRecordSliceLast.JobTitle, VALUE(Catalog.JobTitles.EmptyRef)),
	ISNULL(EmploymentRecordSliceLast.Department, VALUE(Catalog.BusinessStructure.EmptyRef)),
	DataOnTime.Organization,
	CASE
		WHEN FullNameOfPersonsSliceLast.Name IS NULL
			THEN ""
		ELSE "" + FullNameOfPersonsSliceLast.Name + CASE
				WHEN FullNameOfPersonsSliceLast.Initials = ""
					THEN ""
				ELSE " " + FullNameOfPersonsSliceLast.Initials
			END
	END,
	DataOnTime.Individual.Description

ORDER BY
	Organization,
	Employee,
	Date</query>
	</dataSet>
	<totalField>
		<dataPath>Days</dataPath>
		<expression>Sum(Days)</expression>
	</totalField>
	<totalField>
		<dataPath>Hours1</dataPath>
		<expression>Sum(Hours1)</expression>
	</totalField>
	<totalField>
		<dataPath>LastFirstName</dataPath>
		<expression>Max(LastFirstName)</expression>
	</totalField>
	<totalField>
		<dataPath>JobTitle</dataPath>
		<expression>Max(JobTitle)</expression>
	</totalField>
	<totalField>
		<dataPath>EmployeeCode</dataPath>
		<expression>Max(EmployeeCode)</expression>
	</totalField>
	<totalField>
		<dataPath>IndividualName</dataPath>
		<expression>Max(IndividualName)</expression>
	</totalField>
