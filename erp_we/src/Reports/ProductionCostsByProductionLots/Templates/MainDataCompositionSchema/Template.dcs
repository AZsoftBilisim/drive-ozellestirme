		<dataSource>DataSource1</dataSource>
		<query>SELECT
	"" AS Table,
	"" AS Content,
	VALUE(Enum.CostTypes.Material_) AS ExpenseType,
	"" AS CostKind,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS SendingDepartment,
	UNDEFINED                                           AS Recorder,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.ProductCostElements.EmptyRef) AS ProductCostElement,
	
	// material analysis
	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ItemsLocationAttributes,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	UNDEFINED AS Characteristic,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
	VALUE(Catalog.Assignments.EmptyRef) AS Purpose,
	
	// labor cost analytics
	VALUE(Catalog.EmployeeWorkKinds.EmptyRef) AS WorkKind,
	
	// analysis of item-by-item expense
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	UNDEFINED AS DimensionOfExpenses,
	
	// product analytics
	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ProductsAccountingDimension,
	VALUE(Catalog.Products.EmptyRef) AS ManufacturedProduct,
	UNDEFINED AS ItemVariant,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS ProductionSeries_,
	VALUE(Catalog.Assignments.EmptyRef) AS AssignmentOfProducts,

	VALUE(Catalog.ProductionLots.EmptyRef) AS ProductionLot,
	CASE
		WHEN TRUE
			THEN VALUE(Document.ProductionOrder2_2.EmptyRef)
		WHEN TRUE
			THEN UNDEFINED
		ELSE UNDEFINED
	END                                                  AS ProductionOrder,
	
	0 AS InitialBalanceQuantity,
	0 AS InitialBalanceCost,
	0 AS InitialBalanceOfPD,
	0 AS InitialBalanceOfTD,
	0 AS InitialBalanceOffBalanceSheet,
	
	0 AS AmountSpentOnProduction,
	0 AS SpentOnProductionCost,
	0 AS SpentOnProductionOfPD,
	0 AS SpentOnProductionOfTD,
	0 AS SpentOnProductionOffBalanceSheet,
	
	0 AS InclusionExclusionOfVAT,
	
	0 AS ProductionCostsQuantity,
	0 AS ProductionCostsCost,
	0 AS CostOfProductionPD,
	0 AS CostOfProductionOfTD,
	0 AS ProductionCostsOffBalanceSheet,
	
	0 AS FinalRemainderQuantity,
	0 AS FinalRemainderCost,
	0 AS FinalBalanceOfPD,
	0 AS FinalBalanceOfTD,
	0 AS FinalBalanceIsOffBalance
</query>
	</dataSet>
	<calculatedField>
		<dataPath>Cost_</dataPath>
		<expression>Case 
When CostKind = &amp;Material_ Or CostKind = &amp;Services Then Products
When CostKind = &amp;LaborCosts Then WorkKind
When CostKind = &amp;Itemized Then ExpenseItem
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Cost</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>بهای تمام‌شده</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Spesa</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koszt</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Затрата</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Gider</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chi phí</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.Products</v8:Type>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:ChartOfCharacteristicTypesRef.ExpenseItems</v8:Type>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.EmployeeWorkKinds</v8:Type>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>DimensionCosts</dataPath>
		<expression>Case 
When CostKind = &amp;Material_ Or CostKind = &amp;Services Then Characteristic
When CostKind = &amp;LaborCosts Then Undefined
When CostKind = &amp;Itemized  Then DimensionOfExpenses
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Cost dimension</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>بُعد بها</v8:content>
			</v8:item>
