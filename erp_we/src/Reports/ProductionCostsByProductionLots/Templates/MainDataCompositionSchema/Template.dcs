	<calculatedField>
		<dataPath>CostUnitOfMeasure</dataPath>
		<expression>Case 
When CostKind = &amp;Material_ Or CostKind = &amp;Services Then Products.UnitOfMeasure
When CostKind = &amp;LaborCosts Then WorkKind.UnitOfMeasure
When CostKind = &amp;Itemized Then Undefined
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
