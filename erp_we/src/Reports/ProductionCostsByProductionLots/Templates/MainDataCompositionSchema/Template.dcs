				<v8:lang>vi</v8:lang>
				<v8:content>Chỉ số</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>AnalyticsCostsAdditional</dataPath>
		<expression>Case 
When CostKind = &amp;Material_ Or CostKind = &amp;Services Then Series
When CostKind = &amp;LaborCosts Then Undefined
When CostKind = &amp;Itemized Then Undefined
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Cost batch</v8:content>
			</v8:item>
