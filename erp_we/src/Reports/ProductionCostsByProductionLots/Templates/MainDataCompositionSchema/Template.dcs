			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Analityka</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Аналитика</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Boyut</v8:content>
			</v8:item>
