	<totalField>
		<dataPath>ForRegistrationOfActsOnSurplusBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(ForRegistrationOfActsOnSurplusBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToDrawUpActsOnShortages</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ToDrawUpActsOnShortages)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ForRegistrationOfActsOnExcessBalanceWeight</dataPath>
		<expression>Sum(ForRegistrationOfActsOnExcessBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ToIssueActsOnSurplusBalanceVolume</dataPath>
		<expression>Sum(ToIssueActsOnSurplusBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ForRegistrationOfActsOnShortagesBalanceWeight</dataPath>
