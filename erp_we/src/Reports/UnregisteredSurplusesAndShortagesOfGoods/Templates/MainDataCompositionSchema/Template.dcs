		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ToRegister.Products AS Products,
	ToRegister.Products.UnitOfMeasure AS StorageUnit,
	ToRegister.Products.UnitForReports AS UnitForReports,
	ToRegister.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	ToRegister.Characteristic AS Characteristic,
	ToRegister.Purpose,
	ToRegister.Series,
	ToRegister.Warehouse,
	CASE
		WHEN ToRegister.ToCertificateRegistrationClosingBalance &lt; 0
			THEN -ToRegister.ToCertificateRegistrationClosingBalance
		ELSE 0
	END AS ToDrawUpActsOnShortages,
	CASE
		WHEN ToRegister.ToCertificateRegistrationClosingBalance &lt; 0
			THEN 0
		ELSE ToRegister.ToCertificateRegistrationClosingBalance
	END AS ForRegistrationOfActsOnSurplusBalance,
	CASE
		WHEN ToRegister.Recorder = UNDEFINED
			THEN NULL
		ELSE ToRegister.Recorder
	END AS Recorder,
	ToRegister.SecondPeriod,
	ToRegister.MinutePeriod,
	ToRegister.HourPeriod,
	ToRegister.DayPeriod,
	ToRegister.WeekPeriod,
	ToRegister.TenDaysPeriod,
	ToRegister.MonthPeriod,
	ToRegister.QuarterPeriod,
	ToRegister.YearPeriod
FROM
	AccumulationRegister.GoodsForRegistrationOfSurplusesAndShortages.BalanceAndTurnovers(, , Auto, , {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS ToRegister</query>
	</dataSet>
	<calculatedField>
		<dataPath>ForRegistrationOfActsOnSurplusBalance</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        ForRegistrationOfActsOnSurplusBalance
    When &amp;QuantityUnits = 1 Then
        ForRegistrationOfActsOnSurplusBalance / UnitFactorForReports
End</expression>
