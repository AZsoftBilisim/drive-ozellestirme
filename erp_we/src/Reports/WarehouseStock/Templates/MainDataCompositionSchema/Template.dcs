		<field xsi:type="DataSetFieldField">
			<dataPath>ControlledLotReference</dataPath>
			<field>ControlledLotReference</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	RecalculationOfGoods.Products AS Products,
	RecalculationOfGoods.Characteristic AS Characteristic,
	RecalculationOfGoods.Series AS Series,
	TRUE AS SelectionIsUsedForRecalculatingGoods
INTO SelectionForRecalculationOfGoods
FROM
	Document.InventoryRecount.Goods AS RecalculationOfGoods
{WHERE
	RecalculationOfGoods.Ref.* AS InventoryRecount}
INDEX BY
	Products,
	Characteristic,
	Series,
	SelectionIsUsedForRecalculatingGoods
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsInWarehousesBalancesAndTurnover.Products AS Products,
	GoodsInWarehousesBalancesAndTurnover.Characteristic AS Characteristic,
	GoodsInWarehousesBalancesAndTurnover.Purpose AS Purpose,
	GoodsInWarehousesBalancesAndTurnover.ControlledLotReference AS ControlledLotReference,
	GoodsInWarehousesBalancesAndTurnover.Products.UnitOfMeasure AS StorageUnit,
	GoodsInWarehousesBalancesAndTurnover.Products.UnitForReports AS UnitForReports,
	GoodsInWarehousesBalancesAndTurnover.Series AS Series,
	GoodsInWarehousesBalancesAndTurnover.Warehouse AS Warehouse,
	GoodsInWarehousesBalancesAndTurnover.Premise AS Premise,
	CASE
		WHEN GoodsInWarehousesBalancesAndTurnover.Recorder = UNDEFINED
			THEN NULL
		ELSE GoodsInWarehousesBalancesAndTurnover.Recorder
	END AS Recorder,
	GoodsInWarehousesBalancesAndTurnover.SecondPeriod AS SecondPeriod,
	GoodsInWarehousesBalancesAndTurnover.DayPeriod AS DayPeriod,
	GoodsInWarehousesBalancesAndTurnover.WeekPeriod AS WeekPeriod,
	GoodsInWarehousesBalancesAndTurnover.TenDaysPeriod AS TenDaysPeriod,
	GoodsInWarehousesBalancesAndTurnover.MonthPeriod AS MonthPeriod,
	GoodsInWarehousesBalancesAndTurnover.QuarterPeriod AS QuarterPeriod,
	GoodsInWarehousesBalancesAndTurnover.YearPeriod AS YearPeriod,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
					ELSE 0
				END
	END AS OpeningBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
					ELSE 0
				END
	END AS ClosingBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInWarehousesBalancesAndTurnover.InStockReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsInWarehousesBalancesAndTurnover.InStockReceipt / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
					ELSE 0
				END
	END AS Receipt,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInWarehousesBalancesAndTurnover.InStockExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsInWarehousesBalancesAndTurnover.InStockExpense / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
					ELSE 0
				END
	END AS Expense,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInWarehousesBalancesAndTurnover.ToShipOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsInWarehousesBalancesAndTurnover.ToShipOpeningBalance / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
					ELSE 0
				END
	END AS ToShipOpeningBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInWarehousesBalancesAndTurnover.ToShipClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsInWarehousesBalancesAndTurnover.ToShipClosingBalance / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
					ELSE 0
				END
	END AS ToShipClosingBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInWarehousesBalancesAndTurnover.ToShipReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
						THEN GoodsInWarehousesBalancesAndTurnover.ToShipReceipt / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
					ELSE 0
				END
	END AS ToShipReceipt,

	GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance * &amp;QueryTextItemWeight AS StartBalanceWeight,
	GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance * &amp;QueryTextItemWeight AS ClosingBalanceWeight,
	GoodsInWarehousesBalancesAndTurnover.InStockReceipt * &amp;QueryTextItemWeight AS ReceiptWeight,
	GoodsInWarehousesBalancesAndTurnover.InStockExpense * &amp;QueryTextItemWeight AS ConsumptionWeight,
	GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance * &amp;QueryTextTheVolumeOfTheItem AS StartBalanceVolume,
	GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance * &amp;QueryTextTheVolumeOfTheItem AS ClosingBalanceVolume,
	GoodsInWarehousesBalancesAndTurnover.InStockReceipt * &amp;QueryTextTheVolumeOfTheItem AS ReceiptVolume,
	GoodsInWarehousesBalancesAndTurnover.InStockExpense * &amp;QueryTextTheVolumeOfTheItem AS ConsumptionVolume,
	GoodsInWarehousesBalancesAndTurnover.ToShipOpeningBalance * &amp;QueryTextItemWeight AS ToShipOpeningBalanceWeight,
	GoodsInWarehousesBalancesAndTurnover.ToShipClosingBalance * &amp;QueryTextItemWeight AS ForShipmentClosingBalanceWeight,
	GoodsInWarehousesBalancesAndTurnover.ToShipReceipt * &amp;QueryTextItemWeight AS ForShipmentReceiptWeight,
	GoodsInWarehousesBalancesAndTurnover.ToShipOpeningBalance * &amp;QueryTextTheVolumeOfTheItem AS ToShipOpeningBalanceVolume,
	GoodsInWarehousesBalancesAndTurnover.ToShipClosingBalance * &amp;QueryTextTheVolumeOfTheItem AS ForShipmentClosingBalanceVolume,
	GoodsInWarehousesBalancesAndTurnover.ToShipReceipt * &amp;QueryTextTheVolumeOfTheItem AS ForShipmentReceiptVolume
{SELECT
	Products.*,
	Characteristic.*,
	Purpose.*,
	ControlledLotReference,
	StorageUnit.*,
	UnitForReports.*,
	Series.*,
	Warehouse.*,
	Premise.*,
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	YearPeriod,
	OpeningBalance,
	ClosingBalance,
	Receipt,
	Expense,
	ToShipOpeningBalance,
	ToShipClosingBalance,
	ToShipReceipt,
	StartBalanceWeight,
	ClosingBalanceWeight,
	ReceiptWeight,
	ConsumptionWeight,
	StartBalanceVolume,
	ClosingBalanceVolume,
	ReceiptVolume,
	ConsumptionVolume,
	ToShipOpeningBalanceWeight,
	ForShipmentClosingBalanceWeight,
	ForShipmentReceiptWeight,
	ToShipOpeningBalanceVolume,
	ForShipmentClosingBalanceVolume,
	ForShipmentReceiptVolume}
FROM
	AccumulationRegister.ProductStock.BalanceAndTurnovers(, , Auto, , {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), ((Products, Characteristic, Series) IN
			    (SELECT
			        SelectionForRecalculationOfGoods.Products,
			        SelectionForRecalculationOfGoods.Characteristic,
			        SelectionForRecalculationOfGoods.Series
			    FROM
			        SelectionForRecalculationOfGoods
			    WHERE
			        SelectionForRecalculationOfGoods.SelectionIsUsedForRecalculatingGoods = &amp;SelectionIsUsedForRecalculatingGoods))}) AS GoodsInWarehousesBalancesAndTurnover
{WHERE
	GoodsInWarehousesBalancesAndTurnover.Products.*,
	GoodsInWarehousesBalancesAndTurnover.Characteristic.*,
	GoodsInWarehousesBalancesAndTurnover.Purpose.*,
	GoodsInWarehousesBalancesAndTurnover.ControlledLotReference,
	GoodsInWarehousesBalancesAndTurnover.Products.UnitOfMeasure.*,
	GoodsInWarehousesBalancesAndTurnover.Products.UnitForReports.*,
	GoodsInWarehousesBalancesAndTurnover.Series.*,
	GoodsInWarehousesBalancesAndTurnover.Warehouse.*,
	GoodsInWarehousesBalancesAndTurnover.Premise.*,
	(CASE
			WHEN GoodsInWarehousesBalancesAndTurnover.Recorder = UNDEFINED
				THEN NULL
			ELSE GoodsInWarehousesBalancesAndTurnover.Recorder
		END).* AS Recorder,
	GoodsInWarehousesBalancesAndTurnover.SecondPeriod,
	GoodsInWarehousesBalancesAndTurnover.DayPeriod,
	GoodsInWarehousesBalancesAndTurnover.WeekPeriod,
	GoodsInWarehousesBalancesAndTurnover.TenDaysPeriod,
	GoodsInWarehousesBalancesAndTurnover.MonthPeriod,
	GoodsInWarehousesBalancesAndTurnover.QuarterPeriod,
	GoodsInWarehousesBalancesAndTurnover.YearPeriod,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
							THEN GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS OpeningBalance,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
							THEN GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS ClosingBalance,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN GoodsInWarehousesBalancesAndTurnover.InStockReceipt
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
							THEN GoodsInWarehousesBalancesAndTurnover.InStockReceipt / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS Receipt,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN GoodsInWarehousesBalancesAndTurnover.InStockExpense
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
							THEN GoodsInWarehousesBalancesAndTurnover.InStockExpense / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS Expense,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN GoodsInWarehousesBalancesAndTurnover.ToShipOpeningBalance
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
							THEN GoodsInWarehousesBalancesAndTurnover.ToShipOpeningBalance / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS ToShipOpeningBalance,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN GoodsInWarehousesBalancesAndTurnover.ToShipClosingBalance
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
							THEN GoodsInWarehousesBalancesAndTurnover.ToShipClosingBalance / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS ToShipClosingBalance,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN GoodsInWarehousesBalancesAndTurnover.ToShipReceipt
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports &lt;&gt; 0
							THEN GoodsInWarehousesBalancesAndTurnover.ToShipReceipt / GoodsInWarehousesBalancesAndTurnover.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS ToShipReceipt,
	
	(GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance * &amp;QueryTextItemWeight) AS StartBalanceWeight,
	(GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance * &amp;QueryTextItemWeight) AS ClosingBalanceWeight,
	(GoodsInWarehousesBalancesAndTurnover.InStockReceipt * &amp;QueryTextItemWeight) AS ReceiptWeight,
	(GoodsInWarehousesBalancesAndTurnover.InStockExpense * &amp;QueryTextItemWeight) AS ConsumptionWeight,
	(GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance * &amp;QueryTextTheVolumeOfTheItem) AS StartBalanceVolume,
	(GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance * &amp;QueryTextTheVolumeOfTheItem) AS ClosingBalanceVolume,
	(GoodsInWarehousesBalancesAndTurnover.InStockReceipt * &amp;QueryTextTheVolumeOfTheItem) AS ReceiptVolume,
	(GoodsInWarehousesBalancesAndTurnover.InStockExpense * &amp;QueryTextTheVolumeOfTheItem) AS ConsumptionVolume,
	(GoodsInWarehousesBalancesAndTurnover.ToShipOpeningBalance * &amp;QueryTextItemWeight) AS ToShipOpeningBalanceWeight,
	(GoodsInWarehousesBalancesAndTurnover.ToShipClosingBalance * &amp;QueryTextItemWeight) AS ForShipmentClosingBalanceWeight,
	(GoodsInWarehousesBalancesAndTurnover.ToShipReceipt * &amp;QueryTextItemWeight) AS ForShipmentReceiptWeight,
	(GoodsInWarehousesBalancesAndTurnover.ToShipOpeningBalance * &amp;QueryTextTheVolumeOfTheItem) AS ToShipOpeningBalanceVolume,
	(GoodsInWarehousesBalancesAndTurnover.ToShipClosingBalance * &amp;QueryTextTheVolumeOfTheItem) AS ForShipmentClosingBalanceVolume,
	(GoodsInWarehousesBalancesAndTurnover.ToShipReceipt * &amp;QueryTextTheVolumeOfTheItem) AS ForShipmentReceiptVolume}</query>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
