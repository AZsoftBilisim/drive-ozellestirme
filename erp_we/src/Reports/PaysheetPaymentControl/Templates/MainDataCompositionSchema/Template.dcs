		<field xsi:type="DataSetFieldField">
			<dataPath>PayableAtEndOfPeriod</dataPath>
			<field>PayableAtEndOfPeriod</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>To be paid at the end of period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>قابل پرداخت در پایان دوره</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>К выплате на конец периода</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem sonu ödenecek</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>To be paid at the end of period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>To be paid at the end of period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>To be paid at the end of period</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:balance>true</dcscom:balance>
				<dcscom:balanceGroupName>ToBePaidOn</dcscom:balanceGroupName>
				<dcscom:balanceType>ClosingBalance</dcscom:balanceType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ARAPType</dataPath>
			<field>ARAPType</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Turnovers.Organization AS Organization,
	Turnovers.Individual AS Individual,
	-1 * Turnovers.AmountToBePaidOpeningBalance AS PayableAtBeginningOfPeriod,
	-1 * Turnovers.AmountToBePaidClosingBalance AS PayableAtEndOfPeriod
FROM
	AccumulationRegister.PayrollCalculationsHR.BalanceAndTurnovers(, , , , ) AS Turnovers</query>
	</dataSet>
