		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PayrollCalculationsHRTurnovers.Organization AS Organization,
	PayrollCalculationsHRTurnovers.Individual AS Individual,
	PayrollCalculationsHRTurnovers.Recorder AS Recorder,
	PayrollCalculationsHRTurnovers.AmountToBePaidExpense AS AccruedForPeriod,
	PayrollCalculationsHRTurnovers.AmountToBePaidReceipt AS PaidForPeriod
FROM
	AccumulationRegister.PayrollCalculationsHR.Turnovers(, , Recorder, ) AS PayrollCalculationsHRTurnovers</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>DataSet2</sourceDataSet>
		<destinationDataSet>DataSet1</destinationDataSet>
		<sourceExpression>Organization</sourceExpression>
		<destinationExpression>Organization</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>DataSet2</sourceDataSet>
		<destinationDataSet>DataSet1</destinationDataSet>
		<sourceExpression>Individual</sourceExpression>
		<destinationExpression>Individual</destinationExpression>
	</dataSetLink>
	<totalField>
		<dataPath>PaidForPeriod</dataPath>
		<expression>Sum(PaidForPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>PayableAtEndOfPeriod</dataPath>
		<expression>Sum(PayableAtEndOfPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>PayableAtBeginningOfPeriod</dataPath>
		<expression>Sum(PayableAtBeginningOfPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>AccruedForPeriod</dataPath>
		<expression>Sum(AccruedForPeriod)</expression>
	</totalField>
