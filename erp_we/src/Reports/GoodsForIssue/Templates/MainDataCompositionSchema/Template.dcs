	<calculatedField>
		<dataPath>ToRegistrationOfInvoicesByReferences</dataPath>
		<expression>Case When &amp;QuantityUnits = 0 Then
    ToRegistrationOfInvoicesByReferences
When &amp;QuantityUnits = 1 Then
    Case When UnitFactorForReports = 0 Then
        0
    Else
        ToRegistrationOfInvoicesByReferences / UnitFactorForReports
    End
End</expression>
