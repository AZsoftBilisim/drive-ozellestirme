		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	GoodsForIssue.DocumentShipments AS DocumentShipments,
	ISNULL(ReferencesToShip.Ref, UNDEFINED) AS TransportationJob
INTO ReferencesToShip
FROM
	AccumulationRegister.GoodsForIssue AS GoodsForIssue
		INNER JOIN Document.TransportationJob.References AS ReferencesToShip
		ON GoodsForIssue.DocumentShipments = ReferencesToShip.ReferenceOrder
			AND (ReferencesToShip.Ref.Posted)
			AND (ReferencesToShip.Ref.Status IN (VALUE(Enum.StatusesOfTransportationJobs.ToLoad), VALUE(Enum.StatusesOfTransportationJobs.Sent)))
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsForIssue.DocumentShipments AS DocumentShipments,
	GoodsForIssue.Products AS Products,
	GoodsForIssue.Products.UnitOfMeasure AS StorageUnit,
	GoodsForIssue.Products.UnitForReports AS UnitForReports,
	GoodsForIssue.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextWeight AS ProductsWeight,
	&amp;QueryTextVolumeM3 AS ProductsVolume,
	GoodsForIssue.Characteristic AS Characteristic,
	GoodsForIssue.Series AS Series,
	GoodsForIssue.Warehouse AS Warehouse,
	GoodsForIssue.Recipient AS Recipient,
	GoodsForIssue.ToShipOpeningBalance + GoodsForIssue.ToShipReceipt AS ToShip,
	GoodsForIssue.ToShipExpense AS Shipped,
	GoodsForIssue.ToShipClosingBalance AS Ship,
	GoodsForIssue.ToRegisterClosingBalance AS ToRegistrationOfInvoicesByReferences,
	GoodsForIssue.ToRegisterClosingBalance - GoodsForIssue.ToShipClosingBalance AS ToRegistrationOfInvoicesByReceipts,
	GoodsForIssue.ToShipClosingBalance - GoodsForIssue.AssemblyInProgressClosingBalance - GoodsForIssue.AssembledClosingBalance AS ToAssemble,
	GoodsForIssue.AssemblyInProgressClosingBalance AS AssemblyInProgress,
	GoodsForIssue.AssembledClosingBalance AS Assembled,
	CASE
		WHEN GoodsForIssue.Products.UnitOfMeasure.MeasuredValueType IN (VALUE(Enum.TypesOfMeasuredValues.Weight), VALUE(Enum.TypesOfMeasuredValues.VolumeM3), VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement), VALUE(Enum.TypesOfMeasuredValues.Length))
			THEN GoodsForIssue.ToShipReceipt * (AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Value / 100)
		ELSE 0
	END AS TopVarianceLimit,
	CASE
		WHEN GoodsForIssue.Products.UnitOfMeasure.MeasuredValueType IN (VALUE(Enum.TypesOfMeasuredValues.Weight), VALUE(Enum.TypesOfMeasuredValues.VolumeM3), VALUE(Enum.TypesOfMeasuredValues.AreaTypeOfMeasurement), VALUE(Enum.TypesOfMeasuredValues.Length))
			THEN -GoodsForIssue.ToShipReceipt * (AllowableDeviationOfMeasuringGoodsShipmentAndReceiving.Value / 100)
		ELSE 0
	END AS LowerVarianceLimit,
	GoodsForIssue.YearPeriod AS YearPeriod,
	GoodsForIssue.HalfYearPeriod AS HalfYearPeriod,
	GoodsForIssue.QuarterPeriod AS QuarterPeriod,
	GoodsForIssue.MonthPeriod AS MonthPeriod,
	GoodsForIssue.TenDaysPeriod AS TenDaysPeriod,
	GoodsForIssue.WeekPeriod AS WeekPeriod,
	GoodsForIssue.DayPeriod AS DayPeriod,
	GoodsForIssue.SecondPeriod AS SecondPeriod,
	CASE
		WHEN GoodsForIssue.Recorder = UNDEFINED
			THEN NULL
		ELSE GoodsForIssue.Recorder
	END AS Recorder,
	GoodsForIssue.Purpose AS Purpose,
	ISNULL(ReferencesToShip.TransportationJob, UNDEFINED) AS TransportationJob
FROM
	AccumulationRegister.GoodsForIssue.BalanceAndTurnovers(, , Auto, , ) AS GoodsForIssue
		LEFT JOIN ReferencesToShip AS ReferencesToShip
		ON GoodsForIssue.DocumentShipments = ReferencesToShip.DocumentShipments
		INNER JOIN Constant.AllowableDeviationOfMeasuringGoodsShipmentAndReceiving AS AllowableDeviationOfMeasuringGoodsShipmentAndReceiving
		ON (TRUE)</query>
	</dataSet>
	<calculatedField>
		<dataPath>Shipped</dataPath>
		<expression>Case When &amp;QuantityUnits = 0 Then
    Shipped
When &amp;QuantityUnits = 1 Then
    Case When UnitFactorForReports = 0 Then
        0
    Else
        Shipped / UnitFactorForReports
    End
End</expression>
