				<dataPath>CountBalance</dataPath>
				<field>CountBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SumBalance</dataPath>
				<field>SumBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PartnersSegment</dataPath>
				<field>PartnersSegment</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ItemsLocationAttributes</dataPath>
				<field>ItemsLocationAttributes</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>VendorPriceKind</dataPath>
				<field>VendorPriceKind</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BaseCurrency</dataPath>
				<field>BaseCurrency</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Country</dataPath>
				<field>Country</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
	
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;EndOfPeriod}, BaseCurrency = &amp;BaseCurrency) AS ExchangeRates
WHERE
	ExchangeRates.CourseNumerator &lt;&gt; 0
	AND ExchangeRates.CourseDenominator &lt;&gt; 0
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	InventoryKinds.Ref AS InventoryOwnerAttribute
	
INTO TypesOfStocksCommission
FROM
	Catalog.InventoryKinds AS InventoryKinds
WHERE
	InventoryKinds.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	AND NOT InventoryKinds.SaleOfAnotherCompanyInventory
	AND InventoryKinds.GoodsOwner REFS Catalog.Partners
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.Organization,
	CompanyGoods.ItemsLocationAttributes.Products AS Products,
	CompanyGoods.ItemsLocationAttributes.Characteristic AS Characteristic,
	CompanyGoods.CCDNumber,
	CompanyGoods.InventoryOwnerAttribute,
	CompanyGoods.InventoryOwnerAttribute.Terms AS Terms,
	
	CASE WHEN NOT ISNULL(CompanyGoods.InventoryOwnerAttribute.Terms.PriceIncludesVAT, FALSE)
		AND CompanyGoods.InventoryOwnerAttribute.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
	THEN
		((ISNULL(ProductsVATRates.VATRate, ISNULL(VATRatesForEmptyCountryProducts.VATRate, ISNULL(BasicVATRates.VATRate,	VALUE(Catalog.VATRates.EmptyRef))))).Rate1 + 100) / 100
	ELSE
		1
	END VATRate_2,
	
	ISNULL(ExchangeRates.CourseNumerator, 1) AS CourseNumerator,
	ISNULL(ExchangeRates.CourseDenominator, 1) AS CourseDenominator,
	
	CompanyGoods.CountBalance AS CountBalance
	
INTO CompanyGoods 			
FROM
	AccumulationRegister.CompanyGoods.Balance({&amp;EndOfPeriod},
		InventoryOwnerAttribute IN (
			SELECT
				InventoryOwnerAttribute
			FROM
				TypesOfStocksCommission AS TypesOfStocksCommission
			)
		{InventoryOwnerAttribute.GoodsOwner IN (
			SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed
			)
		}	
	) AS CompanyGoods	
	
	LEFT JOIN
		ExchangeRates AS ExchangeRates
	ON
		CompanyGoods.InventoryOwnerAttribute.Currency = ExchangeRates.Currency
	
	LEFT JOIN
		InformationRegister.ProductsVATRates.SliceLast({&amp;EndOfPeriod}) AS ProductsVATRates
	ON
		CompanyGoods.ItemsLocationAttributes.Products = ProductsVATRates.Products
		AND CompanyGoods.Organization.RegistrationCountry = ProductsVATRates.Country
	
	LEFT JOIN
		InformationRegister.ProductsVATRates.SliceLast({&amp;EndOfPeriod}, Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS VATRatesForEmptyCountryProducts
	ON
		CompanyGoods.ItemsLocationAttributes.Products = VATRatesForEmptyCountryProducts.Products
	
	LEFT JOIN
		InformationRegister.BasicVATRates.SliceLast({&amp;EndOfPeriod}) AS BasicVATRates
	ON
		CompanyGoods.Organization.RegistrationCountry = BasicVATRates.Country
UNION ALL

SELECT
	GoodsTransferred.Organization,
	GoodsTransferred.ItemsLocationAttributes.Products AS Products,
	GoodsTransferred.ItemsLocationAttributes.Characteristic AS Characteristic,
	GoodsTransferred.CCDNumber,
	GoodsTransferred.InventoryOwnerAttribute,
	GoodsTransferred.InventoryOwnerAttribute.Terms AS Terms,
	
	CASE WHEN NOT ISNULL(GoodsTransferred.InventoryOwnerAttribute.Terms.PriceIncludesVAT, FALSE)
		AND GoodsTransferred.InventoryOwnerAttribute.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
	THEN
		((ISNULL(ProductsVATRates.VATRate, ISNULL(VATRatesForEmptyCountryProducts.VATRate, ISNULL(BasicVATRates.VATRate,	VALUE(Catalog.VATRates.EmptyRef))))).Rate1 + 100) / 100
	ELSE
		1
	END VATRate_2,
	
	ISNULL(ExchangeRates.CourseNumerator, 1) AS CourseNumerator,
	ISNULL(ExchangeRates.CourseDenominator, 1) AS CourseDenominator,
	
	GoodsTransferred.CountBalance AS CountBalance
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent.Balance({&amp;EndOfPeriod},
		InventoryOwnerAttribute IN (
			SELECT
				InventoryOwnerAttribute
			FROM
				TypesOfStocksCommission AS TypesOfStocksCommission
			)
		{InventoryOwnerAttribute.GoodsOwner IN (
			SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed
			)
		}	
	) AS GoodsTransferred
	
	LEFT JOIN
		ExchangeRates AS ExchangeRates
	ON
		GoodsTransferred.InventoryOwnerAttribute.Currency = ExchangeRates.Currency
	
	LEFT JOIN
		InformationRegister.ProductsVATRates.SliceLast({&amp;EndOfPeriod}) AS ProductsVATRates
	ON
		GoodsTransferred.ItemsLocationAttributes.Products = ProductsVATRates.Products
		AND GoodsTransferred.Organization.RegistrationCountry = ProductsVATRates.Country	
	
	LEFT JOIN
		InformationRegister.ProductsVATRates.SliceLast({&amp;EndOfPeriod}, Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS VATRatesForEmptyCountryProducts
	ON
		GoodsTransferred.ItemsLocationAttributes.Products = VATRatesForEmptyCountryProducts.Products
	
	LEFT JOIN
		InformationRegister.BasicVATRates.SliceLast({&amp;EndOfPeriod}) AS BasicVATRates
	ON
		GoodsTransferred.Organization.RegistrationCountry = BasicVATRates.Country

;
///////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	ItemsPrices.VendorPriceKind,
	ItemsPrices.Products,
	ItemsPrices.Characteristic,
	ItemsPrices.Currency,
	
	CASE WHEN NOT &amp;QueryTextPackagingFactor1 IS NULL
		AND &amp;QueryTextPackagingFactor1 &lt;&gt; 0
	THEN
		ItemsPrices.Price / &amp;QueryTextPackagingFactor1
	ELSE
		ItemsPrices.Price
	END AS Price

INTO ItemsPrices
FROM	
	InformationRegister.ItemsPricesOfVendor.SliceLast({ENDOFPERIOD(&amp;EndOfPeriod, DAY)},
		(Products, Characteristic) IN (
			SELECT
				CompanyGoods.Products,
				CompanyGoods.Characteristic
			FROM
				CompanyGoods AS CompanyGoods
			)
	) AS ItemsPrices
;
///////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	CompanyGoods.Organization,
	CompanyGoods.Products,
	CompanyGoods.Characteristic,
	CompanyGoods.InventoryOwnerAttribute,
	
	CAST(CompanyGoods.InventoryOwnerAttribute.GoodsOwner AS Catalog.Partners) AS Consignor,
	CompanyGoods.InventoryOwnerAttribute.Terms AS Terms,
	CompanyGoods.InventoryOwnerAttribute.Currency AS Currency,
	
	CompanyGoods.CountBalance AS CountBalance,
	(
	CASE WHEN ItemsPrices.Price &lt;&gt; 0 THEN
		ItemsPrices.Price
	ELSE
		CAST(
			(ISNULL(ExchangeRates.CourseNumerator, 0) * CompanyGoods.CourseDenominator)
			/ (ISNULL(ExchangeRates.CourseDenominator, 1) * CompanyGoods.CourseNumerator)
			* ISNULL(ItemsPrices.Price, 0)
		AS NUMBER(31,2)
		)
	END
	* CompanyGoods.VATRate_2
	* CompanyGoods.CountBalance
	) AS SumBalance
FROM
	CompanyGoods AS CompanyGoods	
	
	LEFT JOIN
		ItemsPrices AS ItemsPrices
	ON
		CompanyGoods.Products = ItemsPrices.Products
		AND CompanyGoods.Characteristic = ItemsPrices.Characteristic
		AND CompanyGoods.Terms.VendorPriceKind = ItemsPrices.VendorPriceKind
		
	LEFT JOIN
		ExchangeRates AS ExchangeRates
	ON
		ItemsPrices.Currency = ExchangeRates.Currency
WHERE
	(
	CASE WHEN ItemsPrices.Price &lt;&gt; 0 THEN
		ItemsPrices.Price
	ELSE
		CAST(
			(ISNULL(ExchangeRates.CourseNumerator, 0) * CompanyGoods.CourseDenominator)
			/ (ISNULL(ExchangeRates.CourseDenominator, 1) * CompanyGoods.CourseNumerator)
			* ISNULL(ItemsPrices.Price, 0)
		AS NUMBER(31,2)
		)
	END
	* CompanyGoods.VATRate_2
	* CompanyGoods.CountBalance
	) &lt;&gt; 0</query>
		</item>
