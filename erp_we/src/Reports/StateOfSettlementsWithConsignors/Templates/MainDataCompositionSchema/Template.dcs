					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Расч документ</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Mutabakat belgesi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Chứng từ tính toán</v8:content>
