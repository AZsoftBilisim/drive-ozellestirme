			<field xsi:type="DataSetFieldField">
				<dataPath>CalcDocument</dataPath>
				<field>CalcDocument</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Calc. document</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>سند محاسبه</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Documento di regolamento</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
