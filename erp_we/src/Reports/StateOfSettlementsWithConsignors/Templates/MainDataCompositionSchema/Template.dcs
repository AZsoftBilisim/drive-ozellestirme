					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;
SELECT ALLOWED
	ARAPObjects.Ref AS ARAPObject
INTO ARAPObjects
FROM 
	Catalog.ARAPObjects AS ARAPObjects
WHERE 
	NOT ARAPObjects.DeletionMark
	AND (ARAPObjects.Object REFS Document.ConsignmentReportToVendor
		OR ARAPObjects.Object REFS Document.PurchaseInvoiceConsignmentStockLost
		OR ARAPObjects.Object IN (
			SELECT
				CounterpartyContracts.Ref
			FROM
				Catalog.CounterpartyContracts AS CounterpartyContracts
			WHERE CounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentProcurement)))
INDEX BY
	ARAPObject
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterAccountingAnalyticsForPartners.Organization AS Organization,
	RegisterAccountingAnalyticsForPartners.Partner AS Consignor,
	CASE WHEN NOT VendorsARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	VendorsARAPAccounting.Currency AS Currency,
	VendorsARAPAccounting.ARAPObject AS CalcDocument,

	CASE WHEN VendorsARAPAccounting.SumBalance &gt; 0 THEN
		VendorsARAPAccounting.SumBalance
	ELSE
		0
	END AS ConsignorDebt,
	CASE WHEN VendorsARAPAccounting.SumBalance &lt; 0 THEN
		-VendorsARAPAccounting.SumBalance
	ELSE
		0
	END AS AccountsPayableOfCompany
FROM
	AccumulationRegister.VendorsARAPAccounting.Balance({&amp;EndOfPeriod},
		ARAPObject IN (SELECT ARAPObject FROM ARAPObjects)
	) AS VendorsARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
{
WHERE
	RegisterAccountingAnalyticsForPartners.Partner IN (
		SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed
	)
}	</query>
		</item>
		<item xsi:type="DataSetQuery">
