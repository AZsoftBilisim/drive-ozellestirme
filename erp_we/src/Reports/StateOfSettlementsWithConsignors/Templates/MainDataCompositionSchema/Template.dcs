	<totalField>
		<dataPath>AccountsPayableOfCompany</dataPath>
		<expression>Sum(AccountsPayableOfCompany)</expression>
	</totalField>
	<totalField>
		<dataPath>OurDebtTotal</dataPath>
		<expression>Sum(IsNull(SumBalance,0))
+ Sum(IsNull(RevenueAmountBalance, 0))
+ Sum(IsNull(AccountsPayableOfCompany, 0))
- Sum(IsNull(ConsignorDebt, 0))</expression>
	</totalField>
	<totalField>
		<dataPath>ConsignorDebt</dataPath>
		<expression>Sum(ConsignorDebt)</expression>
	</totalField>
