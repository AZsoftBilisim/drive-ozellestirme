				<field>Recorder</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	1 AS ControlType,
	"PrepaymentsToVendor_" AS CashKind,
	VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder) AS BusinessOperation,
	&amp;TransactionTextIssueExpenseAdvance AS SpecifiedBusinessTransaction,
	Cash_1.IssuancePurpose AS IssuancePurpose,
	Cash_1.AdvanceHolder AS Recipient,
	Cash_1.Organization AS Organization,
	Cash_1.Currency AS Currency,
	Cash_1.SumOpeningBalance AS SumOpeningBalance,
	Cash_1.SumReceipt AS SumReceipt,
	Cash_1.SumExpense AS SumExpense,
	Cash_1.SumClosingBalance AS SumClosingBalance,
	CASE
		WHEN Cash_1.ToReportClosingBalance &gt; 0
			THEN Cash_1.ToReportClosingBalance
		ELSE 0
	END AS AmountOverdue,
	CASE
		WHEN Cash_1.SumClosingBalance = 0
			THEN 99
		WHEN Cash_1.SumClosingBalance &gt; 0
			THEN 27
		ELSE 28
	END AS Recommendation,
	Cash_1.Recorder AS Recorder
FROM
	AccumulationRegister.AdvanceHolderCash.BalanceAndTurnovers(
			&amp;BeginOfPeriod,
			&amp;EndOfPeriod,
			Auto,
			,
	) AS Cash_1</query>
		</item>
