						<v8:lang>it</v8:lang>
						<v8:content>Tipo di mezzi finanziari</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Rodzaj środków pieniężnych</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
