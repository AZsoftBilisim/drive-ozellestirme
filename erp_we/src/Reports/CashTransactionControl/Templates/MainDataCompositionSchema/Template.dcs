			<field xsi:type="DataSetFieldField">
				<dataPath>Recorder</dataPath>
				<field>Recorder</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	2 AS ControlType,
	"BankAccountPayments_" AS CashKind,
	VALUE(Enum.BusinessTransactions.EmptyRef) AS BusinessOperation,
	&amp;TransactionTextAcquiringPayment AS SpecifiedBusinessTransaction,
	CASE
		WHEN &amp;DetailedDisplayOfSendersRecipients
			THEN AcquiringContractARAP.Contract
		ELSE &amp;PaymentCardLine
	END AS Sender,
	CASE
		WHEN &amp;DetailedDisplayOfSendersRecipients
			THEN AcquiringContractARAP.Contract.BankAccount
		ELSE &amp;LineBank
	END AS Recipient,
	AcquiringContractARAP.Organization AS Organization,
	AcquiringContractARAP.Currency AS Currency,
	AcquiringContractARAP.SumOpeningBalance AS SumOpeningBalance,
	AcquiringContractARAP.SumReceipt AS SumReceipt,
	AcquiringContractARAP.SumExpense AS SumExpense,
	AcquiringContractARAP.SumClosingBalance AS SumClosingBalance,
	AcquiringContractARAP.POSTerminal AS POSTerminal,
	AcquiringContractARAP.Contract AS Contract,
	AcquiringContractARAP.PaymentDate AS PaymentDate,
	CASE
		WHEN AcquiringContractARAP.SumClosingBalance = 0
			THEN 99
		WHEN AcquiringContractARAP.SumClosingBalance &gt; 0
			THEN 21
		ELSE 23
	END AS Recommendation,
	AcquiringContractARAP.Recorder AS Recorder
FROM
	AccumulationRegister.AcquiringContractARAP.BalanceAndTurnovers(
		&amp;BeginOfPeriod,
		&amp;EndOfPeriod,
		Auto,
		,
		CashType = VALUE(Enum.AcquiringCashTypes.CashRecieptByAcquiringTransactions)
	) AS AcquiringContractARAP</query>
		</item>
