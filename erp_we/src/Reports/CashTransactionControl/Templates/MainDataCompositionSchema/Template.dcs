				<dataPath>Recommendation</dataPath>
				<field>Recommendation</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Recommendation</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>پیشنهاد</v8:content>
					</v8:item>
