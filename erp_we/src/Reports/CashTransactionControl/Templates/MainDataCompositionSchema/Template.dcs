			<field xsi:type="DataSetFieldField">
				<dataPath>Recorder</dataPath>
				<field>Recorder</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	2 AS ControlType,
	"BankAccountPayments_" AS CashKind,
	VALUE(Enum.BusinessTransactions.CashReceiptFromCustomer) AS BusinessOperation,
	&amp;TransactionTextAcquiringInpayment AS SpecifiedBusinessTransaction,
	CASE
		WHEN &amp;DetailedDisplayOfSendersRecipients
			THEN Cash_1.Contract
		ELSE &amp;PaymentCardLine
	END AS Sender,
	CASE
		WHEN &amp;DetailedDisplayOfSendersRecipients
			THEN Cash_1.Recipient
		ELSE &amp;LineBank
	END AS Recipient,
	Cash_1.Organization AS Organization,
	CAST(Cash_1.Recipient AS Catalog.CompaniesBankAccounts).CashCurrency AS Currency,
	Cash_1.SumOpeningBalance AS SumOpeningBalance,
	Cash_1.SumReceipt AS SumReceipt,
	Cash_1.SumExpense AS SumExpense,
	Cash_1.SumClosingBalance AS SumClosingBalance,
	CASE
		WHEN Cash_1.SumClosingBalance = 0
			THEN 99
		WHEN Cash_1.SumClosingBalance &gt; 0
			THEN 30
		ELSE 31
	END AS Recommendation,
	Cash_1.Recorder AS Recorder
FROM
	AccumulationRegister.CashInTransit.BalanceAndTurnovers(
		&amp;BeginOfPeriod,
		&amp;EndOfPeriod,
		Auto,
		,
		CashTransferKind = VALUE(Enum.CashTransferKinds.CashReceiptFromBankByAcquiring)
	) AS Cash_1</query>
		</item>
