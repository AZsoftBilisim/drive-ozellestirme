			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	1 AS ControlType,
	"BankAccountPayments_" AS CashKind,
	VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder) AS BusinessOperation,
	&amp;TextOfOperationCreditingToIndividual AS SpecifiedBusinessTransaction,
	Cash_1.Sender AS Sender,
	"A natural person" AS Recipient,
	Cash_1.Organization AS Organization,
	Cash_1.Currency AS Currency,
	Cash_1.SumOpeningBalance AS SumOpeningBalance,
	Cash_1.SumReceipt AS SumReceipt,
	Cash_1.SumExpense AS SumExpense,
	Cash_1.SumClosingBalance AS SumClosingBalance,
	CASE
		WHEN Cash_1.SumClosingBalance = 0
			THEN 99
		WHEN Cash_1.SumClosingBalance &gt; 0
			THEN 32
		ELSE 4
	END AS Recommendation,
	Cash_1.Recorder AS Recorder
FROM
	AccumulationRegister.CashInTransit.BalanceAndTurnovers(
		&amp;BeginOfPeriod,
		&amp;EndOfPeriod,
		Auto,
		,
		CashTransferKind = VALUE(Enum.CashTransferKinds.TransferToPersons)
	) AS Cash_1</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>ActionState</dataPath>
		<expression>Case When SumClosingBalance = 0 Then 1 Else 2 End</expression>
		<title xsi:type="v8:LocalStringType">
