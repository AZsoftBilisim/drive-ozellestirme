			<field xsi:type="DataSetFieldField">
				<dataPath>CashTransferKind</dataPath>
				<field>CashTransferKind</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Counterparty</dataPath>
				<field>Counterparty</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Recorder</dataPath>
				<field>Recorder</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	4 AS ControlType,
	"CashPayment" AS CashKind,
	VALUE(Enum.BusinessTransactions.CashDepositToBankAccount) AS BusinessOperation,
	&amp;TransactionTextTransferFromTheCashAccountToTheBank AS SpecifiedBusinessTransaction,
	CASE
		WHEN &amp;DetailedDisplayOfSendersRecipients
			THEN Cash.Sender
		ELSE &amp;CheckoutLine
	END AS Sender,
	CASE
		WHEN &amp;DetailedDisplayOfSendersRecipients
			THEN Cash.Recipient
		ELSE &amp;LineBank
	END AS Recipient,
	Cash.Organization AS Organization,
	Cash.Currency AS Currency,
	Cash.SumOpeningBalance AS SumOpeningBalance,
	Cash.SumReceipt AS SumReceipt,
	Cash.SumExpense AS SumExpense,
	Cash.SumClosingBalance AS SumClosingBalance,
	CASE
		WHEN Cash.SumClosingBalance = 0
			THEN 99
		WHEN Cash.SumClosingBalance &gt; 0
			THEN 5
		ELSE 12
	END AS Recommendation,
	Cash.Recorder AS Recorder
FROM
	AccumulationRegister.CashInTransit.BalanceAndTurnovers(
		&amp;BeginOfPeriod,
		&amp;EndOfPeriod,
		Auto,
		,
		CashTransferKind = VALUE(Enum.CashTransferKinds.CashDepositToBank)
	) AS Cash</query>
		</item>
