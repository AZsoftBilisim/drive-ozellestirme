					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Rodzaj środków pieniężnych</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Вид денежных средств</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Nakit türü</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Dạng lưu chuyển tiền tệ</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CashTransferKind</dataPath>
				<field>CashTransferKind</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Counterparty</dataPath>
				<field>Counterparty</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Recorder</dataPath>
				<field>Recorder</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	3 AS ControlType,
	"CashPayment" AS CashKind,
	VALUE(Enum.BusinessTransactions.CurrencyConversion) AS BusinessOperation,
	&amp;TransactionTextCashConversion AS SpecifiedBusinessTransaction,
	&amp;CheckoutLine AS Sender,
	CASE
		WHEN &amp;DetailedDisplayOfSendersRecipients
			THEN Cash_1.Recipient
		ELSE &amp;CheckoutLine
	END AS Recipient,
	Cash_1.Organization AS Organization,
	Cash_1.Currency AS Currency,
	Cash_1.SumOpeningBalance AS SumOpeningBalance,
	Cash_1.SumReceipt AS SumReceipt,
	Cash_1.SumExpense AS SumExpense,
	Cash_1.SumClosingBalance AS SumClosingBalance,
	CASE
		WHEN Cash_1.SumClosingBalance = 0
			THEN 99
		WHEN Cash_1.SumClosingBalance &gt; 0
			THEN 6
		ELSE 7
	END AS Recommendation,
	Cash_1.Recorder AS Recorder
	
FROM
	AccumulationRegister.CashInTransit.BalanceAndTurnovers(
			&amp;BeginOfPeriod,
			&amp;EndOfPeriod,
			Auto,
			,
			Recipient REFS Catalog.CashAccounts
			AND CashTransferKind IN (
				VALUE(Enum.CashTransferKinds.ForeignExchangeBuying),
				VALUE(Enum.CashTransferKinds.ForeignExchangeSelling))
		) AS Cash_1</query>
		</item>
