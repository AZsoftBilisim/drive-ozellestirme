		<dataSource>DataSource1</dataSource>
		<query>SELECT
	""                                                        AS GroupingEverything,
	VALUE(Catalog.Companies.EmptyRef)             AS Organization,
	VALUE(Catalog.Partners.EmptyRef)                AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef)             AS Counterparty,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS Contract,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS ARAPObject,
	VALUE(Catalog.Currencies.EmptyRef)                  AS Currency,
	VALUE(Document.CustomerInvoice.EmptyRef)    AS ARAPDocument,
	
	DATETIME(1, 1, 1)                                        AS PlannedRepaymentDate,
	DATETIME(1, 1, 1)                                        AS OccurrenceDate,
	
	0                                                         AS AccountsPayableOfCompany,
	0                                                         AS OurDebtOverdue,
	0                                                         AS CustomerAccountsReceivable,
	0                                                         AS OverdueCustomerDebt,
	0                                                         AS ToShip,
	
	0                                                         AS DaysCount,
	
	""                                                        AS IntervalName,
	0                                                         AS IntervalNumber,
	0                                                         AS LowerBoundOfInterval,
	
	VALUE(Catalog.PartnersSegments.EmptyRef)       AS PartnersSegment
{SELECT
	GroupingEverything,
	Organization.*,
	Partner.*,
	Counterparty.*,
	Contract.*,
	LineOfBusiness.*,
	ARAPObject.*,
	Currency.*,
	ARAPDocument.*,
	PlannedRepaymentDate,
	OccurrenceDate,
	AccountsPayableOfCompany,
	OurDebtOverdue,
	CustomerAccountsReceivable,
	OverdueCustomerDebt,
	ToShip,
	DaysCount,
	IntervalName,
	IntervalNumber,
	LowerBoundOfInterval}
{WHERE
	""                                                            AS GroupingEverything,
	VALUE(Catalog.PartnersSegments.EmptyRef)           AS PartnersSegment,
	(VALUE(Catalog.Companies.EmptyRef)).*             AS Organization,
	(VALUE(Catalog.Partners.EmptyRef)).*                AS Partner,
	(VALUE(Catalog.Counterparties.EmptyRef)).*             AS Counterparty,
	(VALUE(Catalog.CounterpartyContracts.EmptyRef)).*    AS Contract,
	(VALUE(Catalog.LinesOfBusiness.EmptyRef)).* AS LineOfBusiness,
	(VALUE(Catalog.CounterpartyContracts.EmptyRef)).*    AS ARAPObject,
	(VALUE(Catalog.Currencies.EmptyRef)).*                  AS Currency,
	(VALUE(Document.CustomerInvoice.EmptyRef)).*    AS ARAPDocument,
	
	DATETIME(1, 1, 1)                                            AS PlannedRepaymentDate,
	DATETIME(1, 1, 1)                                            AS OccurrenceDate,
	
	0                                                             AS AccountsPayableOfCompany,
	0                                                             AS OurDebtOverdue,
	0                                                             AS CustomerAccountsReceivable,
	0                                                             AS OverdueCustomerDebt,
	0                                                             AS ToShip,
	0                                                             AS DaysCount,
	
	""                                                            AS IntervalName,
	0                                                             AS IntervalNumber,
	0                                                             AS LowerBoundOfInterval}
</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>PercentageOfOverdueDebt</dataPath>
		<expression>Case When CustomerAccountsReceivable &lt;&gt; 0 Then OverdueCustomerDebt / CustomerAccountsReceivable * 100 Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
