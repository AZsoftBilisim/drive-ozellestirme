		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	SelectionByProductSegment.Products AS Products,
	SelectionByProductSegment.Characteristic AS Characteristic,
	SelectionByProductSegment.FilterByProductSegmentIsUsed AS FilterByProductSegmentIsUsed,
	ISNULL(CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE SelectionByProductSegment.Characteristic.ItemsCharacteristicForPricing
	END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS PricingPackage
INTO SelectionByProductSegmentAugmented
FROM
	SelectionByProductSegment AS SelectionByProductSegment
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON (ItemKinds.Ref = SelectionByProductSegment.Products.ProductKind)
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	ItemPricesCrossSectionOfTheLatest.Products,
	ItemPricesCrossSectionOfTheLatest.PricingVariant AS PricingVariant,
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	ItemPricesCrossSectionOfTheLatest.Price,
	ItemPricesCrossSectionOfTheLatest.Package,
	ItemPricesCrossSectionOfTheLatest.Currency,
	CatProducts_.PriceGroup,
	CASE
		WHEN
			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems)
			THEN CatProducts_.Ref
		WHEN
			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind)
			THEN CatProducts_.ProductKind
		WHEN
			CatProducts_.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind)
			THEN CatProducts_.ItemVariantsOwner
		ELSE UNDEFINED
	END AS ItemVariantsOwner
INTO ItemsPrices25
FROM
	InformationRegister.ItemsPrices25.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices) {((Products, PricingVariant,
		PricingBatch, PricingPackage) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.PricingVariant,
			SelectionByProductSegment.PricingBatch,
			SelectionByProductSegment.PricingPackage
		FROM
			SelectionByProductSegmentAugmented AS SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS
		ItemPricesCrossSectionOfTheLatest
		LEFT JOIN Catalog.Products AS CatProducts_
		ON ItemPricesCrossSectionOfTheLatest.Products = CatProducts_.Ref
WHERE
	&amp;UsePriceManagementSystem25
{WHERE
	ItemPricesCrossSectionOfTheLatest.Products.*,
	ItemPricesCrossSectionOfTheLatest.PriceKind.*,
	ItemPricesCrossSectionOfTheLatest.Price,
	ItemPricesCrossSectionOfTheLatest.Package.*,
	ItemPricesCrossSectionOfTheLatest.Currency.*}
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	ItemPricesCrossSectionOfTheLatest.Products AS Products,
	ItemPricesCrossSectionOfTheLatest.Characteristic AS Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind AS PriceKind,
	ItemPricesCrossSectionOfTheLatest.Price AS Price,
	ItemPricesCrossSectionOfTheLatest.Package AS Package,
	ItemPricesCrossSectionOfTheLatest.Currency AS Currency,
	ItemPricesCrossSectionOfTheLatest.Products.PriceGroup AS PriceGroup,
	"Client" AS Client,
	0 AS Qty,
	0 AS Sum
{SELECT
	Products.*,
	Characteristic.*,
	PriceKind.*,
	Price,
	Package.*,
	Currency.*,
	PriceGroup.*}
FROM
	InformationRegister.ItemsPrices.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices) {((Products, Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS
		ItemPricesCrossSectionOfTheLatest
WHERE
	NOT &amp;UsePriceManagementSystem25
{WHERE
	ItemPricesCrossSectionOfTheLatest.Products.*,
	ItemPricesCrossSectionOfTheLatest.Characteristic.* AS Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind.*,
	ItemPricesCrossSectionOfTheLatest.Price,
	ItemPricesCrossSectionOfTheLatest.Package.*,
	ItemPricesCrossSectionOfTheLatest.Currency.*}

UNION ALL

SELECT
	ItemPricesCrossSectionOfTheLatest.Products,
	ISNULL(ItemsCharacteristics.Ref, ISNULL(ItemsCharacteristics1.Ref,
		VALUE(Catalog.ItemsCharacteristics.EmptyRef))),
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	ItemPricesCrossSectionOfTheLatest.Price,
	ItemPricesCrossSectionOfTheLatest.Package,
	ItemPricesCrossSectionOfTheLatest.Currency,
	ItemPricesCrossSectionOfTheLatest.Products.PriceGroup,
	"Client",
	0,
	0
FROM
	ItemsPrices25 AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics
		ON (ItemPricesCrossSectionOfTheLatest.PricingVariant &lt;&gt; VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		AND
			ItemPricesCrossSectionOfTheLatest.PricingVariant = ItemsCharacteristics.ItemsCharacteristicForPricing
		LEFT JOIN Catalog.ItemsCharacteristics AS ItemsCharacteristics1
		ON (ItemPricesCrossSectionOfTheLatest.PricingVariant = VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef))
		AND ItemPricesCrossSectionOfTheLatest.ItemVariantsOwner = ItemsCharacteristics1.Owner
WHERE
	&amp;UsePriceManagementSystem25
{WHERE
	ItemPricesCrossSectionOfTheLatest.Products.*,
	(ISNULL(ItemsCharacteristics.Ref, ISNULL(ItemsCharacteristics1.Ref,
		VALUE(Catalog.ItemsCharacteristics.EmptyRef)))).*,
	ItemPricesCrossSectionOfTheLatest.PriceKind.*,
	ItemPricesCrossSectionOfTheLatest.Price,
	ItemPricesCrossSectionOfTheLatest.Package.*,
	ItemPricesCrossSectionOfTheLatest.Currency.*}</query>
	</dataSet>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Sum(Price)</expression>
	</totalField>
	<totalField>
		<dataPath>Currency</dataPath>
		<expression>Max(Currency)</expression>
	</totalField>
	<totalField>
		<dataPath>Package</dataPath>
		<expression>Max(Package)</expression>
	</totalField>
	<totalField>
		<dataPath>Qty</dataPath>
		<expression>Sum(Qty)</expression>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Sum(Sum)</expression>
	</totalField>
	<parameter>
