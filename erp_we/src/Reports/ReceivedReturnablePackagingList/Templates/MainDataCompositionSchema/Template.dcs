				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Para birimi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tiền tệ</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ReceivedReturnablePackagingBalanceAndTurnovers.Partner,
	ReceivedReturnablePackagingBalanceAndTurnovers.Products,
	ReceivedReturnablePackagingBalanceAndTurnovers.Characteristic,
	ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow,
	SUM(CASE
		WHEN
			ReceivedReturnablePackaging.Buyout
		THEN
			0
		ELSE
			ReceivedReturnablePackagingBalanceAndTurnovers.CountExpense
	END) AS QuantityReturned,
	SUM(CASE
		WHEN
			ReceivedReturnablePackaging.Buyout
		THEN
			ReceivedReturnablePackagingBalanceAndTurnovers.CountExpense
		ELSE
			0
	END) AS QuantityRedeemed,
	SUM(CASE
		WHEN
			ReceivedReturnablePackaging.Buyout
		THEN
			0
		ELSE
			ReceivedReturnablePackagingBalanceAndTurnovers.SumExpense
	END) AS AmountReturned,
	SUM(CASE
		WHEN
			ReceivedReturnablePackaging.Buyout
		THEN
			ReceivedReturnablePackagingBalanceAndTurnovers.SumExpense
		ELSE
			0
	END) AS AmountRedeemed
INTO
	ReceivedReturnablePackaging
FROM
	AccumulationRegister.ReceivedReturnablePackaging.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Record, , ) AS ReceivedReturnablePackagingBalanceAndTurnovers
		LEFT JOIN AccumulationRegister.ReceivedReturnablePackaging AS ReceivedReturnablePackaging
		ON ReceivedReturnablePackagingBalanceAndTurnovers.Recorder = ReceivedReturnablePackaging.Recorder
			AND ReceivedReturnablePackagingBalanceAndTurnovers.LineNumber = ReceivedReturnablePackaging.LineNumber
			AND ReceivedReturnablePackagingBalanceAndTurnovers.Period = ReceivedReturnablePackaging.Period
			AND ReceivedReturnablePackagingBalanceAndTurnovers.Partner = ReceivedReturnablePackaging.Partner
			AND ReceivedReturnablePackagingBalanceAndTurnovers.Products =  ReceivedReturnablePackaging.Products
			AND ReceivedReturnablePackagingBalanceAndTurnovers.Characteristic =  ReceivedReturnablePackaging.Characteristic
			AND ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow =  ReceivedReturnablePackaging.DocumentInflow
WHERE
	ReceivedReturnablePackagingBalanceAndTurnovers.Recorder &lt;&gt; UNDEFINED
GROUP BY
	ReceivedReturnablePackagingBalanceAndTurnovers.Partner,
	ReceivedReturnablePackagingBalanceAndTurnovers.Products,
	ReceivedReturnablePackagingBalanceAndTurnovers.Characteristic,
	ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow
;
SELECT ALLOWED
	ReceivedReturnablePackagingBalanceAndTurnovers.Partner,
	ReceivedReturnablePackagingBalanceAndTurnovers.Products,
	ReceivedReturnablePackagingBalanceAndTurnovers.Characteristic,
	ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow,
	CASE WHEN 
		ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow.Currency &lt;&gt; VALUE(Catalog.Currencies.EmptyRef)
			THEN
				ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow.Currency
			ELSE
				ManagementAccountingCurrency.Value
	END AS Currency,
	ReceivedReturnablePackagingBalanceAndTurnovers.CountOpeningBalance,
	ReceivedReturnablePackagingBalanceAndTurnovers.CountClosingBalance,
	ReceivedReturnablePackagingBalanceAndTurnovers.SumOpeningBalance,
	ReceivedReturnablePackagingBalanceAndTurnovers.SumClosingBalance,
	ReceivedReturnablePackagingBalanceAndTurnovers.CountReceipt AS QuantityAccepted,
	ReceivedReturnablePackagingBalanceAndTurnovers.SumReceipt AS AmountAccepted,
	ReceivedReturnablePackaging.QuantityReturned AS QuantityReturned,
	ReceivedReturnablePackaging.QuantityRedeemed AS QuantityRedeemed,
	ReceivedReturnablePackaging.AmountReturned AS AmountReturned,
	ReceivedReturnablePackaging.AmountRedeemed AS AmountRedeemed
FROM
	AccumulationRegister.ReceivedReturnablePackaging.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, , , ) AS ReceivedReturnablePackagingBalanceAndTurnovers
LEFT JOIN
	ReceivedReturnablePackaging
		ON ReceivedReturnablePackagingBalanceAndTurnovers.Partner = ReceivedReturnablePackaging.Partner
		AND ReceivedReturnablePackagingBalanceAndTurnovers.Products =  ReceivedReturnablePackaging.Products
		AND ReceivedReturnablePackagingBalanceAndTurnovers.Characteristic =  ReceivedReturnablePackaging.Characteristic
		AND ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow =  ReceivedReturnablePackaging.DocumentInflow
LEFT JOIN
	Constant.ManagementAccountingCurrency AS ManagementAccountingCurrency
		ON TRUE
</query>
	</dataSet>
