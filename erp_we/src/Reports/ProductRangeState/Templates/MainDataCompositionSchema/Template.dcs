		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TypesOfPrices.Ref AS PriceKind
INTO PermittedTypesOfPrices
FROM
	Catalog.TypesOfPrices AS TypesOfPrices
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductRange.PlanningObject AS StoreFormat,
	ProductRange.Products AS Products,
	ProductRange.ProductRangeRole AS ProductRangeRole,
	CASE
		WHEN ProductRange.Products IS NULL 
			THEN VALUE(Enum.ProductRangePhases.EmptyRef)
		WHEN ProductRange.SalesAreAllowed
				AND ProductRange.PurchasesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.PurchasesAndSalesArePermitted)
		WHEN ProductRange.SalesAreAllowed
				AND NOT ProductRange.PurchasesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.OnlySalesAreAllowed)
		WHEN ProductRange.PurchasesAreAllowed
				AND NOT ProductRange.SalesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.OnlyPurchasesAreAllowed)
		ELSE VALUE(Enum.ProductRangePhases.SalesAndPurchasesAreProhibited)
	END AS ProductRangePhase,
	PermittedTypesOfPrices.PriceKind AS PriceKind,
	ProductRange.Recorder AS Recorder,
	ProductRange.SalesRank,
	ProductRange.ItemsCollection
FROM
	InformationRegister.ProductRange.SliceLast(ENDOFPERIOD(&amp;OnDate, DAY), ) AS ProductRange
		LEFT JOIN PermittedTypesOfPrices AS PermittedTypesOfPrices
		ON (PermittedTypesOfPrices.PriceKind = ProductRange.PriceKind)
WHERE
	ProductRange.Products = &amp;Products 
	AND &amp;UseStoreFormats OR VALUETYPE(ProductRange.PlanningObject) = TYPE(Catalog.Warehouses)</query>
	</dataSet>
	<totalField>
		<dataPath>ProductRangeRole</dataPath>
		<expression>ProductRangeRole</expression>
	</totalField>
	<totalField>
		<dataPath>ProductRangePhase</dataPath>
