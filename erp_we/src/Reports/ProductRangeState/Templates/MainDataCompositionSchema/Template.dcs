		<expression>PriceKind</expression>
	</totalField>
	<totalField>
		<dataPath>SalesRank</dataPath>
		<expression>SalesRank</expression>
	</totalField>
	<totalField>
		<dataPath>ItemsCollection</dataPath>
		<expression>ItemsCollection</expression>
	</totalField>
