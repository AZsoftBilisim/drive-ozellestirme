		<dataSource>DataSource1</dataSource>
		<query>SELECT
	InventoryKinds.Ref AS Ref
INTO TTControlledInventoryTypes
FROM
	Catalog.InventoryKinds AS InventoryKinds
WHERE
	InventoryKinds.InventoryType IN(&amp;ControlledInventoryTypes)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CompanyGoodsBalance.Organization AS Organization,
	CompanyGoodsBalance.ItemsLocationAttributes AS ItemsLocationAttributes,
	CompanyGoodsBalance.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CompanyGoodsBalance.CCDNumber AS CCDNumber,
	CompanyGoodsBalance.CountBalance AS CountBalance
INTO BalancesAtEndOfPeriod
FROM
	AccumulationRegister.CompanyGoods.Balance(
			,
			InventoryOwnerAttribute IN
				(SELECT
					TTControlledInventoryTypes.Ref
				FROM
					TTControlledInventoryTypes AS TTControlledInventoryTypes)) AS CompanyGoodsBalance

UNION ALL

SELECT
	CompanyGoodsOnWay.Organization,
	CompanyGoodsOnWay.ItemsLocationAttributes,
	CompanyGoodsOnWay.InventoryOwnerAttribute,
	CompanyGoodsOnWay.CCDNumber,
	-CompanyGoodsOnWay.NumberIsReversed
FROM
	CompanyGoodsOnWay AS CompanyGoodsOnWay
WHERE
	CompanyGoodsOnWay.Period &lt;= &amp;EndOfPeriod
	AND CompanyGoodsOnWay.InventoryOwnerAttribute IN
			(SELECT
				TTControlledInventoryTypes.Ref
			FROM
				TTControlledInventoryTypes AS TTControlledInventoryTypes)

UNION ALL

SELECT
	CompanySafeStockBalance.Organization,
	CompanySafeStockBalance.ItemsLocationAttributes,
	CompanySafeStockBalance.InventoryOwnerAttribute,
	CompanySafeStockBalance.CCDNumber,
	CompanySafeStockBalance.CountBalance
FROM
	AccumulationRegister.CompanySafeStock.Balance(
			,
			InventoryOwnerAttribute IN
				(SELECT
					TTControlledInventoryTypes.Ref
				FROM
					TTControlledInventoryTypes AS TTControlledInventoryTypes)) AS CompanySafeStockBalance

INDEX BY
	Organization,
	ItemsLocationAttributes,
	InventoryOwnerAttribute,
	CCDNumber
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	BalancesAtEndOfPeriod.Organization AS Organization,
	BalancesAtEndOfPeriod.ItemsLocationAttributes AS ItemsLocationAttributes,
	ISNULL(InventoryKinds.SubjectToExcise, FALSE) AS SubjectToExcise
INTO FilterNegative_Balance
FROM
	BalancesAtEndOfPeriod AS BalancesAtEndOfPeriod
		LEFT JOIN Catalog.InventoryKinds AS InventoryKinds
		ON BalancesAtEndOfPeriod.InventoryOwnerAttribute = InventoryKinds.Ref

GROUP BY
	BalancesAtEndOfPeriod.Organization,
	BalancesAtEndOfPeriod.ItemsLocationAttributes,
	ISNULL(InventoryKinds.SubjectToExcise, FALSE),
	CASE
		WHEN InventoryKinds.InventoryType IN (&amp;InventoryTypesExternalOwner)
			THEN InventoryKinds.GoodsOwner
		ELSE UNDEFINED
	END

HAVING
	SUM(BalancesAtEndOfPeriod.CountBalance) &lt; 0

INDEX BY
	Organization,
	ItemsLocationAttributes,
	SubjectToExcise
;

////////////////////////////////////////////////////////////////////////////////
DROP BalancesAtEndOfPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.Organization AS Organization,
	NestedQuery.ItemsLocationAttributes AS ItemsLocationAttributes,
	NestedQuery.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	NestedQuery.CCDNumber AS CCDNumber,
	SUM(NestedQuery.StockOpeningBalance) AS StockOpeningBalance,
	SUM(NestedQuery.ReserveOpeningBalance) AS ReserveOpeningBalance,
	SUM(NestedQuery.GoodsReceipt) AS GoodsReceipt,
	SUM(NestedQuery.ReserveReceipt) AS ReserveReceipt,
	SUM(NestedQuery.GoodsConsumption) AS GoodsConsumption,
	SUM(NestedQuery.ReserveConsumption) AS ReserveConsumption,
	SUM(NestedQuery.ClosingStockBalance) AS ClosingStockBalance,
	SUM(NestedQuery.ReserveClosingBalance) AS ReserveClosingBalance
FROM
	(SELECT
		GoodsOfOrganizationsBalancesAndTurnover.Organization AS Organization,
		GoodsOfOrganizationsBalancesAndTurnover.ItemsLocationAttributes AS ItemsLocationAttributes,
		GoodsOfOrganizationsBalancesAndTurnover.InventoryOwnerAttribute AS InventoryOwnerAttribute,
		GoodsOfOrganizationsBalancesAndTurnover.CCDNumber AS CCDNumber,
		GoodsOfOrganizationsBalancesAndTurnover.CountOpeningBalance AS StockOpeningBalance,
		0 AS ReserveOpeningBalance,
		GoodsOfOrganizationsBalancesAndTurnover.CountReceipt AS GoodsReceipt,
		0 AS ReserveReceipt,
		GoodsOfOrganizationsBalancesAndTurnover.CountExpense AS GoodsConsumption,
		0 AS ReserveConsumption,
		GoodsOfOrganizationsBalancesAndTurnover.CountClosingBalance AS ClosingStockBalance,
		0 AS ReserveClosingBalance
	FROM
		AccumulationRegister.CompanyGoods.BalanceAndTurnovers(
				,
				,
				,
				,
				(Organization, ItemsLocationAttributes, InventoryOwnerAttribute.SubjectToExcise) IN
						(SELECT
							FilterNegative_Balance.Organization,
							FilterNegative_Balance.ItemsLocationAttributes,
							FilterNegative_Balance.SubjectToExcise
						FROM
							FilterNegative_Balance)
					AND InventoryOwnerAttribute IN
						(SELECT
							TTControlledInventoryTypes.Ref AS Ref
						FROM
							TTControlledInventoryTypes)) AS GoodsOfOrganizationsBalancesAndTurnover
	
	UNION ALL
	
	SELECT
		CompanyGoodsOnWay.Organization,
		CompanyGoodsOnWay.ItemsLocationAttributes,
		CompanyGoodsOnWay.InventoryOwnerAttribute,
		CompanyGoodsOnWay.CCDNumber,
		-CompanyGoodsOnWay.NumberIsReversed,
		0,
		0,
		0,
		0,
		0,
		0,
		0
	FROM
		CompanyGoodsOnWay AS CompanyGoodsOnWay
	WHERE
		CompanyGoodsOnWay.Period &lt; &amp;BeginOfPeriod
		AND (CompanyGoodsOnWay.Organization, CompanyGoodsOnWay.ItemsLocationAttributes) IN
				(SELECT
					FilterNegative_Balance.Organization,
					FilterNegative_Balance.ItemsLocationAttributes
				FROM
					FilterNegative_Balance)
		AND CompanyGoodsOnWay.InventoryOwnerAttribute IN
				(SELECT
					TTControlledInventoryTypes.Ref AS Ref
				FROM
					TTControlledInventoryTypes)
	
	UNION ALL
	
	SELECT
		CompanyGoodsOnWay.Organization,
		CompanyGoodsOnWay.ItemsLocationAttributes,
		CompanyGoodsOnWay.InventoryOwnerAttribute,
		CompanyGoodsOnWay.CCDNumber,
		0,
		0,
		CASE
			WHEN CompanyGoodsOnWay.NumberIsReversed &gt;= 0
				THEN -CompanyGoodsOnWay.NumberIsReversed
			ELSE 0
		END,
		0,
		CASE
			WHEN CompanyGoodsOnWay.NumberIsReversed &gt;= 0
				THEN 0
			ELSE -CompanyGoodsOnWay.NumberIsReversed
		END,
		0,
		0,
		0
	FROM
		CompanyGoodsOnWay AS CompanyGoodsOnWay
	WHERE
		CompanyGoodsOnWay.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
		AND (CompanyGoodsOnWay.Organization, CompanyGoodsOnWay.ItemsLocationAttributes) IN
				(SELECT
					FilterNegative_Balance.Organization,
					FilterNegative_Balance.ItemsLocationAttributes
				FROM
					FilterNegative_Balance)
		AND CompanyGoodsOnWay.InventoryOwnerAttribute IN
				(SELECT
					TTControlledInventoryTypes.Ref AS Ref
				FROM
					TTControlledInventoryTypes)
	
	UNION ALL
	
	SELECT
		CompanyGoodsOnWay.Organization,
		CompanyGoodsOnWay.ItemsLocationAttributes,
		CompanyGoodsOnWay.InventoryOwnerAttribute,
		CompanyGoodsOnWay.CCDNumber,
		0,
		0,
		0,
		0,
		0,
		0,
		-CompanyGoodsOnWay.NumberIsReversed,
		0
	FROM
		CompanyGoodsOnWay AS CompanyGoodsOnWay
	WHERE
		CompanyGoodsOnWay.Period &lt;= &amp;EndOfPeriod
		AND (CompanyGoodsOnWay.Organization, CompanyGoodsOnWay.ItemsLocationAttributes) IN
				(SELECT
					FilterNegative_Balance.Organization,
					FilterNegative_Balance.ItemsLocationAttributes
				FROM
					FilterNegative_Balance)
		AND CompanyGoodsOnWay.InventoryOwnerAttribute IN
				(SELECT
					TTControlledInventoryTypes.Ref AS Ref
				FROM
					TTControlledInventoryTypes)
	
	UNION ALL
	
	SELECT
		CompanySafeStockBalanceAndTurnovers.Organization,
		CompanySafeStockBalanceAndTurnovers.ItemsLocationAttributes,
		CompanySafeStockBalanceAndTurnovers.InventoryOwnerAttribute,
		CompanySafeStockBalanceAndTurnovers.CCDNumber,
		0,
		CompanySafeStockBalanceAndTurnovers.CountOpeningBalance,
		0,
		CompanySafeStockBalanceAndTurnovers.CountReceipt,
		0,
		CompanySafeStockBalanceAndTurnovers.CountExpense,
		0,
		CompanySafeStockBalanceAndTurnovers.CountClosingBalance
	FROM
		AccumulationRegister.CompanySafeStock.BalanceAndTurnovers(
				,
				,
				,
				,
				(Organization, ItemsLocationAttributes) IN
						(SELECT
							FilterNegative_Balance.Organization,
							FilterNegative_Balance.ItemsLocationAttributes
						FROM
							FilterNegative_Balance)
					AND InventoryOwnerAttribute IN
						(SELECT
							TTControlledInventoryTypes.Ref AS Ref
						FROM
							TTControlledInventoryTypes)) AS CompanySafeStockBalanceAndTurnovers) AS NestedQuery

GROUP BY
	NestedQuery.Organization,
	NestedQuery.ItemsLocationAttributes,
	NestedQuery.InventoryOwnerAttribute,
	NestedQuery.CCDNumber
;

////////////////////////////////////////////////////////////////////////////////
DROP CompanyGoodsOnWay
;

////////////////////////////////////////////////////////////////////////////////
DROP TTControlledInventoryTypes
;

////////////////////////////////////////////////////////////////////////////////
DROP FilterNegative_Balance</query>
	</dataSet>
	<totalField>
		<dataPath>ReserveClosingBalance</dataPath>
		<expression>Sum(ReserveClosingBalance)</expression>
	</totalField>
	<totalField>
