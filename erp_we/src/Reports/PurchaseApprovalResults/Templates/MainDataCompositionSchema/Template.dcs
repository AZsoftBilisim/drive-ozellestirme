			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Purchase approval</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تأیید خرید</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Acquisizioni concordate</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Uzgodnione zakupy</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Согласование закупки</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Satın alım onayı</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Thống nhất mua hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	PurchaseApproval.Ref  AS PurchaseApproval,
	PurchaseApproval.SubjectOf AS SubjectOf
FROM
	BusinessProcess.PurchaseApproval AS PurchaseApproval
{WHERE
	(PurchaseApproval.Ref IN (&amp;PurchaseApproval)),
	(PurchaseApproval.SubjectOf IN (&amp;SubjectOf))}</query>
	</dataSet>
