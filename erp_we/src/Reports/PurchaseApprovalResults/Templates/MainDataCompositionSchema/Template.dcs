		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	PurchaseApprovalApprovalResults.RoutePoint         AS RoutePoint,
	PurchaseApprovalApprovalResults.Reviewer             AS Reviewer,
	PurchaseApprovalApprovalResults.ApprovalResult AS ApprovalResult,
	PurchaseApprovalApprovalResults.Comment           AS Comment,
	PurchaseApprovalApprovalResults.ApprovalDate      AS ApprovalDate,
	PurchaseApprovalApprovalResults.Ref                AS Ref,
	PurchaseApprovalApprovalResults.LineNumber           AS LineNumber,
	PurchaseApprovalApprovalResults.VersionNumber           AS VersionNumber

FROM
	BusinessProcess.PurchaseApproval.ApprovalResults AS PurchaseApprovalApprovalResults
{WHERE
	(PurchaseApprovalApprovalResults.Ref IN (&amp;PurchaseApproval)),
	(PurchaseApprovalApprovalResults.Ref.SubjectOf IN (&amp;SubjectOf))}</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>DataSet1</sourceDataSet>
		<destinationDataSet>DataSet2</destinationDataSet>
		<sourceExpression>PurchaseApproval</sourceExpression>
		<destinationExpression>Ref</destinationExpression>
	</dataSetLink>
