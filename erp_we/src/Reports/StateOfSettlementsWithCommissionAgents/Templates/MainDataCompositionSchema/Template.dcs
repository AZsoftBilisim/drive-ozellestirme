		<item xsi:type="DataSetQuery">
			<name>CustomersARAPAccounting</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Organization</dataPath>
				<field>Organization</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
					<dcscom:parentDimension>AnalysisOfSettlementsWithCounterparties</dcscom:parentDimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>AccountingDimensionByPartners</dataPath>
				<field>AccountingDimensionByPartners</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Currency</dataPath>
				<field>Currency</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Consignee</dataPath>
				<field>Consignee</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>AccountsPayableOfCompany</dataPath>
				<field>AccountsPayableOfCompany</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CommissionAgentSDebt</dataPath>
				<field>CommissionAgentSDebt</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Partner</dataPath>
				<field>Partner</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PartnersSegment</dataPath>
				<field>PartnersSegment</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>LineOfBusiness</dataPath>
				<field>LineOfBusiness</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPObject</dataPath>
				<field>ARAPObject</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPDocument</dataPath>
				<field>ARAPDocument</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>AR/AP document</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>سند دریافتنی/پرداختنی</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Documento di regolamento</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Dokument rozliczeniowy</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Расчетный документ</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Alacak/Borç belgesi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Chứng từ hạch toán</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ARAPObjects.Ref AS ARAPObject
INTO ARAPObjects
FROM Catalog.ARAPObjects AS ARAPObjects
WHERE
	NOT ARAPObjects.DeletionMark
	AND (ARAPObjects.Object REFS Document.ConsignmentReportFromCustomer
				OR ARAPObjects.Object REFS Document.WriteOffReportFromCommissionAgent
				OR ARAPObjects.Object IN
					(SELECT
						CounterpartyContracts.Ref
					FROM
						Catalog.CounterpartyContracts AS CounterpartyContracts
					WHERE
						CounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
						AND NOT CounterpartyContracts.ConsignmentSales25))
INDEX BY
	ARAPObject
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterAccountingAnalyticsForPartners.Organization AS Organization,
	RegisterAccountingAnalyticsForPartners.Partner AS Consignee,
	CASE WHEN NOT CustomersARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE CustomersARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	CustomersARAPAccounting.Currency AS Currency,
	CustomersARAPAccounting.ARAPObject AS ARAPDocument,
	CASE
		WHEN CustomersARAPAccounting.SumBalance &gt; 0
			THEN CustomersARAPAccounting.SumBalance
		ELSE 0
	END AS CommissionAgentSDebt,
	CASE
		WHEN CustomersARAPAccounting.SumBalance &lt; 0
			THEN -CustomersARAPAccounting.SumBalance
		ELSE 0
	END AS AccountsPayableOfCompany
FROM
	AccumulationRegister.CustomersARAPAccounting.Balance(
			{(&amp;EndOfPeriod)},
			ARAPObject IN (SELECT ARAPObject FROM ARAPObjects)) AS CustomersARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey}
{WHERE
	(RegisterAccountingAnalyticsForPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
		</item>
