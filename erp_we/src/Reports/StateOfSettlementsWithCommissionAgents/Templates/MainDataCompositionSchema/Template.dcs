////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ARAPObjects.Ref AS ARAPObject
INTO ARAPObjects
FROM Catalog.ARAPObjects AS ARAPObjects
WHERE
	NOT ARAPObjects.DeletionMark
	AND (ARAPObjects.Object REFS Document.ConsignmentReportFromCustomer
	OR ARAPObjects.Object IN
		(SELECT
			CounterpartyContracts.Ref
		FROM
			Catalog.CounterpartyContracts AS CounterpartyContracts
		WHERE
			CounterpartyContracts.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
			AND NOT CounterpartyContracts.ConsignmentSales25))
INDEX BY
	ARAPObject
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterAccountingAnalyticsForPartners.Organization AS Organization,
	RegisterAccountingAnalyticsForPartners.Partner AS Consignee,
	CASE WHEN NOT VendorsARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	VendorsARAPAccounting.Currency AS Currency,
	VendorsARAPAccounting.ARAPObject AS ARAPDocument,
	CASE
		WHEN VendorsARAPAccounting.SumBalance &gt; 0
			THEN VendorsARAPAccounting.SumBalance
		ELSE 0
	END AS CommissionAgentSDebt,
	CASE
		WHEN VendorsARAPAccounting.SumBalance &lt; 0
			THEN -VendorsARAPAccounting.SumBalance
		ELSE 0
	END AS AccountsPayableOfCompany
FROM
	AccumulationRegister.VendorsARAPAccounting.Balance(
			{(&amp;EndOfPeriod)},
			ARAPObject IN (SELECT ARAPObject FROM ARAPObjects)) AS VendorsARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey}
{WHERE
	(RegisterAccountingAnalyticsForPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
		</item>
