		<dataPath>PartnerDebtTotal</dataPath>
		<expression>Sum(IsNull(SumClosingBalance,0))
+ Sum(IsNull(CommissionAgentSDebt, 0))
- Sum(IsNull(AccountsPayableOfCompany, 0))</expression>
