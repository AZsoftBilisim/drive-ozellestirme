		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TransferredReturnablePackagingBalance.Partner,
	TransferredReturnablePackagingBalance.Products,
	TransferredReturnablePackagingBalance.Characteristic,
	TransferredReturnablePackagingBalance.DocumentTransfers_,
	TransferredReturnablePackagingBalance.DocumentTransfers_.ReusablePackagesReturnDate AS ReturnCycleLength,
	TransferredReturnablePackagingBalance.DocumentTransfers_.Currency AS Currency,
	SUM(TransferredReturnablePackagingBalance.CountBalance) AS Count,
	SUM(TransferredReturnablePackagingBalance.SumBalance) AS SecurityDepositValue
FROM
	AccumulationRegister.TransferredReturnablePackaging.Balance AS TransferredReturnablePackagingBalance
GROUP BY
	TransferredReturnablePackagingBalance.Partner,
	TransferredReturnablePackagingBalance.Products,
	TransferredReturnablePackagingBalance.Characteristic,
	TransferredReturnablePackagingBalance.DocumentTransfers_
</query>
	</dataSet>
	<totalField>
		<dataPath>ReturnCycleLength</dataPath>
		<expression>Min(ReturnCycleLength)</expression>
		<group>Currency</group>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Partner</group>
		<group>Partner Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
		<group>Currency</group>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>SecurityDepositValue</dataPath>
		<expression>Sum(SecurityDepositValue)</expression>
	</totalField>
