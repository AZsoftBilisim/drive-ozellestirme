			<field xsi:type="DataSetFieldField">
				<dataPath>SalesOrder</dataPath>
				<field>SalesOrder</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Sales order</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>سفارش فروش</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Ordine del cliente</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
