						<v8:content>Nhóm kế toán tài chính</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SalesOrder</dataPath>
				<field>SalesOrder</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Sales order</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>سفارش فروش</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Ordine del cliente</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Zamówienie klienta</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Заказ клиента</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Müşteri siparişi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Đơn hàng của khách</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CreditPlanned</dataPath>
				<field>CreditPlanned</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Credit after shipment</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>اعتباری پس از ارسال</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Credito dopo la spedizione</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Kredyt po wysyłce</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Кредит после отгрузки</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Kredili (sevkiyat sonrası)</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Trả sau sau khi giao hàng</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	DocumentData.Ref AS Ref,
	DocumentData.Status AS Status,
	DocumentData.ARAPObjectSettings AS ARAPObjectSettings,
	DocumentData.Partner AS Partner,
	DocumentData.Terms AS Terms,
	DocumentData.Contract AS Contract,
	DocumentData.Terms.FinancialAccountingGroup AS FinancialAccountingGroup,
	DocumentData.Currency AS Currency,
	DocumentData.Organization AS Organization,
	DocumentData.Counterparty AS Counterparty,
	DocumentData.DocumentAmount AS DocumentAmount,
	DocumentData.AmountPrepaymentBeforeGoodsIssue AS AmountPrepaymentBeforeGoodsIssue,
	DocumentData.AmountOfPrepaymentBeforeShipment AS AmountOfPrepaymentBeforeShipment,
	DocumentData.LineOfBusiness AS LineOfBusiness
INTO ARAPObjects
FROM
	Document.SalesOrder AS DocumentData
WHERE
	DocumentData.Partner = &amp;Partner

UNION ALL

SELECT
	DocumentData.Ref,
	DocumentData.Status,
	DocumentData.ARAPObjectSettings,
	DocumentData.Partner,
	DocumentData.Terms,
	DocumentData.Contract,
	DocumentData.Terms.FinancialAccountingGroup,
	DocumentData.Currency,
	DocumentData.Organization,
	DocumentData.Counterparty,
	DocumentData.ReplacementAmount,
	DocumentData.AmountPrepaymentBeforeGoodsIssue,
	DocumentData.AmountOfPrepaymentBeforeShipment,
	DocumentData.LineOfBusiness 
FROM
	Document.RequestForReturnOfGoodsFromCustomer AS DocumentData
WHERE
	DocumentData.Partner = &amp;Partner

UNION ALL

SELECT
	DocumentData.Ref,
	CASE
		WHEN DocumentData.Status = VALUE(Enum.StatusesOfCustomerInvoices.ForPrepayment)
			THEN VALUE(Enum.SalesOrderStatuses.ToSupply)
		ELSE VALUE(Enum.SalesOrderStatuses.Closed)
	END,
	DocumentData.ARAPObjectSettings,
	DocumentData.Partner,
	DocumentData.Terms,
	DocumentData.Contract,
	DocumentData.Terms.FinancialAccountingGroup,
	DocumentData.Currency,
	DocumentData.Organization,
	DocumentData.Counterparty,
	DocumentData.AmountARAP,
	0,
	SUM(StageData_1.AmountARAP),
	DocumentData.LineOfBusiness
FROM
	Document.CustomerInvoice AS DocumentData
		LEFT JOIN Document.CustomerInvoice.PaymentScheduleSteps AS StageData_1
			ON StageData_1.Ref = DocumentData.Ref
				AND StageData_1.PaymentOption IN (VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeProvision),
												VALUE(Enum.CustomerPaymentControlOptions.PrepaymentBeforeShipment))
WHERE
	DocumentData.Partner = &amp;Partner
GROUP BY
	DocumentData.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CustomersARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners, 
	CustomersARAPAccounting.ARAPObject AS SalesOrder,
	CASE
		WHEN CustomersARAPAccounting.ARAPObject.Object REFS Catalog.CounterpartyContracts
			THEN TRUE
		ELSE FALSE
	END AS SettlementsUnderContract,
	CustomersARAPAccounting.ARAPObject.FinancialAccountingGroup AS FinancialAccountingGroup,
	CustomersARAPAccounting.Currency AS Currency,
	DimensionByPartners.Partner AS Partner,
	DimensionByPartners.Organization AS Organization,
	DimensionByPartners.Counterparty AS Counterparty,
	DimensionByPartners.Contract AS Contract,
	CustomersARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness,
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance &gt; 0
			THEN CustomersARAPAccounting.SumClosingBalance
		ELSE 0
	END AS CustomerAccountsReceivable,
	CASE
		WHEN CustomersARAPAccounting.SumClosingBalance &lt; 0
			THEN -CustomersARAPAccounting.SumClosingBalance
		ELSE 0
	END AS AccountsPayableOfCompany,
	CustomersARAPAccounting.SumClosingBalance AS DebtBalance,
	CASE
		WHEN CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN CustomersARAPAccounting.AmountDueClosingBalance
		ELSE 0
	END AS AmountDue,
	CASE
		WHEN CustomersARAPAccounting.AmountDueClosingBalance &lt; 0
			THEN -CustomersARAPAccounting.AmountDueClosingBalance
		ELSE 0
	END AS ForCashReturn,
	CASE
		WHEN CustomersARAPAccounting.ToShipClosingBalance &lt; 0
			THEN -CustomersARAPAccounting.ToShipClosingBalance
		ELSE 0
	END AS ToShip,
	CASE
		WHEN CustomersARAPAccounting.BeingShippedClosingBalance &gt; 0
			THEN CustomersARAPAccounting.BeingShippedClosingBalance
		ELSE 0
	END AS BeingShipped,
	CASE
		WHEN OrderDocument.AmountPrepaymentBeforeGoodsIssue &gt; 0
				AND CustomersARAPAccounting.AmountDueReceipt - CustomersARAPAccounting.AmountDueClosingBalance &lt; OrderDocument.AmountPrepaymentBeforeGoodsIssue
			THEN OrderDocument.AmountPrepaymentBeforeGoodsIssue - (CustomersARAPAccounting.AmountDueReceipt - CustomersARAPAccounting.AmountDueClosingBalance)
		ELSE 0
	END AS PrepaymentBeforeProvision,
	CASE
		WHEN OrderDocument.AmountOfPrepaymentBeforeShipment &gt; 0
				AND OrderDocument.AmountPrepaymentBeforeGoodsIssue &gt; 0
				AND CustomersARAPAccounting.AmountDueReceipt - CustomersARAPAccounting.AmountDueClosingBalance &lt; OrderDocument.AmountPrepaymentBeforeGoodsIssue
			THEN OrderDocument.AmountOfPrepaymentBeforeShipment
		WHEN OrderDocument.AmountOfPrepaymentBeforeShipment &gt; 0
				AND CustomersARAPAccounting.AmountDueReceipt - CustomersARAPAccounting.AmountDueClosingBalance &lt; OrderDocument.AmountOfPrepaymentBeforeShipment + OrderDocument.AmountPrepaymentBeforeGoodsIssue
				AND CustomersARAPAccounting.AmountDueReceipt - CustomersARAPAccounting.AmountDueClosingBalance &gt;= OrderDocument.AmountPrepaymentBeforeGoodsIssue
			THEN OrderDocument.AmountOfPrepaymentBeforeShipment + OrderDocument.AmountPrepaymentBeforeGoodsIssue - (CustomersARAPAccounting.AmountDueReceipt - CustomersARAPAccounting.AmountDueClosingBalance)
		ELSE 0
	END AS PrepaymentBeforeShipment,
	CASE
		WHEN CustomersARAPAccounting.ARAPObject.Object &lt;&gt; UNDEFINED
				AND OrderDocument.Ref IS NULL 
				AND CustomersARAPAccounting.AmountDueClosingBalance &gt; 0
			THEN CustomersARAPAccounting.AmountDueClosingBalance
		WHEN CustomersARAPAccounting.AmountDueReceipt - OrderDocument.AmountPrepaymentBeforeGoodsIssue - OrderDocument.AmountOfPrepaymentBeforeShipment &gt; 0
				AND CustomersARAPAccounting.AmountDueReceipt - CustomersARAPAccounting.AmountDueClosingBalance &lt;= OrderDocument.AmountOfPrepaymentBeforeShipment + OrderDocument.AmountPrepaymentBeforeGoodsIssue
			THEN CustomersARAPAccounting.AmountDueReceipt - OrderDocument.AmountPrepaymentBeforeGoodsIssue - OrderDocument.AmountOfPrepaymentBeforeShipment
		WHEN CustomersARAPAccounting.AmountDueReceipt - OrderDocument.AmountPrepaymentBeforeGoodsIssue - OrderDocument.AmountOfPrepaymentBeforeShipment &gt; 0
				AND CustomersARAPAccounting.AmountDueReceipt - CustomersARAPAccounting.AmountDueClosingBalance &gt; OrderDocument.AmountOfPrepaymentBeforeShipment + OrderDocument.AmountPrepaymentBeforeGoodsIssue
			THEN CustomersARAPAccounting.AmountDueClosingBalance
		ELSE 0
	END AS CreditPlanned
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(
			,
			,
			,
			,
			ARAPObject.Partner = &amp;Partner) AS CustomersARAPAccounting
		LEFT JOIN Document.SalesOrder AS OrderDocument
		ON CustomersARAPAccounting.ARAPObject.Object = OrderDocument.Ref
		{INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
WHERE
	(CustomersARAPAccounting.AmountDueClosingBalance &lt;&gt; 0
			OR CustomersARAPAccounting.ToShipClosingBalance &lt;&gt; 0
			OR CustomersARAPAccounting.BeingShippedClosingBalance &lt;&gt; 0)
	AND (&amp;UseAdvancedFeaturesOfSalesOrder
			OR NOT &amp;UseAdvancedFeaturesOfSalesOrder
				AND NOT CustomersARAPAccounting.ARAPObject.Object REFS Document.RequestForReturnOfGoodsFromCustomer
				AND NOT CustomersARAPAccounting.ARAPObject.Object REFS Document.SalesOrder)

UNION ALL

SELECT
	CustomersARAPAccounting.AccountingDimensionByPartners,  
	ARAPObjects.Ref,
	CASE
		WHEN ARAPObjects.ARAPObjectSettings = VALUE(Enum.ARAPObjectSettings.ByCounterpartyContracts)
			THEN TRUE
		ELSE FALSE
	END,
	ARAPObjects.FinancialAccountingGroup,
	ARAPObjects.Currency,
	ARAPObjects.Partner,
	ARAPObjects.Organization,
	ARAPObjects.Counterparty,
	ARAPObjects.Contract,
	ARAPObjects.LineOfBusiness,	
	CASE
		WHEN ISNULL(CustomersARAPAccounting.SumClosingBalance, 0) &gt; 0
			THEN ISNULL(CustomersARAPAccounting.SumClosingBalance, 0)
		ELSE 0
	END,
	CASE
		WHEN ISNULL(CustomersARAPAccounting.SumClosingBalance, 0) &lt; 0
			THEN ISNULL(-CustomersARAPAccounting.SumClosingBalance, 0)
		ELSE 0
	END,
	ISNULL(CustomersARAPAccounting.SumClosingBalance, 0),
	CASE
		WHEN ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &gt; 0
			THEN ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0)
		WHEN ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) = 0
				AND ISNULL(CustomersARAPAccounting.AmountDueTurnover, 0) = 0
			THEN ARAPObjects.DocumentAmount
		WHEN ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &lt; 0
			THEN ARAPObjects.DocumentAmount + ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0)
		ELSE 0
	END,
	CASE
		WHEN ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &lt; 0
			THEN ISNULL(-CustomersARAPAccounting.AmountDueClosingBalance, 0)
		ELSE 0
	END,
	CASE
		WHEN ISNULL(CustomersARAPAccounting.ToShipClosingBalance, 0) &lt; 0
			THEN ISNULL(-CustomersARAPAccounting.ToShipClosingBalance, 0)
		ELSE 0
	END,
	CASE
		WHEN ISNULL(CustomersARAPAccounting.BeingShippedClosingBalance, 0) &gt; 0
			THEN ISNULL(CustomersARAPAccounting.BeingShippedClosingBalance, 0)
		ELSE 0
	END,
	CASE
		WHEN ARAPObjects.AmountPrepaymentBeforeGoodsIssue &gt; 0
				AND ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &lt; ARAPObjects.AmountPrepaymentBeforeGoodsIssue
			THEN ARAPObjects.AmountPrepaymentBeforeGoodsIssue - (ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0))
		ELSE 0
	END,
	CASE
		WHEN ARAPObjects.AmountOfPrepaymentBeforeShipment &gt; 0
				AND ARAPObjects.AmountPrepaymentBeforeGoodsIssue &gt; 0
				AND ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &lt; ARAPObjects.AmountPrepaymentBeforeGoodsIssue
			THEN ARAPObjects.AmountOfPrepaymentBeforeShipment
		WHEN ARAPObjects.AmountOfPrepaymentBeforeShipment &gt; 0
				AND ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &lt; ARAPObjects.AmountOfPrepaymentBeforeShipment + ARAPObjects.AmountPrepaymentBeforeGoodsIssue
				AND ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &gt;= ARAPObjects.AmountPrepaymentBeforeGoodsIssue
			THEN ARAPObjects.AmountOfPrepaymentBeforeShipment + ARAPObjects.AmountPrepaymentBeforeGoodsIssue - (ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0))
		ELSE 0
	END,
	CASE
		WHEN CustomersARAPAccounting.ARAPObject.Object &lt;&gt; UNDEFINED
				AND ARAPObjects.Ref IS NULL 
				AND ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &gt; 0
			THEN ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0)
		WHEN ARAPObjects.DocumentAmount - (ARAPObjects.AmountPrepaymentBeforeGoodsIssue + ARAPObjects.AmountOfPrepaymentBeforeShipment) &gt; 0
				AND ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &lt; ARAPObjects.DocumentAmount - (ARAPObjects.AmountPrepaymentBeforeGoodsIssue + ARAPObjects.AmountOfPrepaymentBeforeShipment)
			THEN ARAPObjects.DocumentAmount - (ARAPObjects.AmountPrepaymentBeforeGoodsIssue + ARAPObjects.AmountOfPrepaymentBeforeShipment)
		WHEN ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ARAPObjects.AmountPrepaymentBeforeGoodsIssue - ARAPObjects.AmountOfPrepaymentBeforeShipment &gt; 0
				AND ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &lt;= ARAPObjects.AmountOfPrepaymentBeforeShipment + ARAPObjects.AmountPrepaymentBeforeGoodsIssue
			THEN ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ARAPObjects.AmountPrepaymentBeforeGoodsIssue - ARAPObjects.AmountOfPrepaymentBeforeShipment
		WHEN ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ARAPObjects.AmountPrepaymentBeforeGoodsIssue - ARAPObjects.AmountOfPrepaymentBeforeShipment &gt; 0
				AND ISNULL(CustomersARAPAccounting.AmountDueReceipt, 0) - ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0) &gt; ARAPObjects.AmountOfPrepaymentBeforeShipment + ARAPObjects.AmountPrepaymentBeforeGoodsIssue
			THEN ISNULL(CustomersARAPAccounting.AmountDueClosingBalance, 0)
		ELSE 0
	END
FROM
	ARAPObjects AS ARAPObjects
		LEFT JOIN AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(
				,
				,
				,
				,
				ARAPObject.Partner = &amp;Partner) AS CustomersARAPAccounting
		ON (CustomersARAPAccounting.ARAPObject.Object = ARAPObjects.Ref)
WHERE
	NOT &amp;UseAdvancedFeaturesOfSalesOrder
	AND (ARAPObjects.Ref REFS Document.RequestForReturnOfGoodsFromCustomer
			OR ARAPObjects.Ref REFS Document.SalesOrder)
	AND ARAPObjects.DocumentAmount &lt;&gt; 0</query>
		</item>
