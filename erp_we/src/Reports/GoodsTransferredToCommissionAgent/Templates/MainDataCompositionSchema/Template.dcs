			<field xsi:type="DataSetFieldField">
				<dataPath>SecondPeriod</dataPath>
				<field>SecondPeriod</field>
				<role>
					<dcscom:periodNumber>2</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterTable.ItemsLocationAttributes AS ItemsLocationAttributes,
	RegisterTable.Terms AS Terms,
	RegisterTable.Organization AS Organization,
	RegisterTable.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	RegisterTable.CCDNumber AS CCDNumber,
	RegisterTable.SecondPeriod AS SecondPeriod,
	RegisterTable.Recorder AS Recorder,
	RegisterTable.CountOpeningBalance AS CountOpeningBalance,
	RegisterTable.CountTurnover AS CountTurnover,
	RegisterTable.CountReceipt AS CountReceipt,
	RegisterTable.CountExpense AS CountExpense,
	RegisterTable.CountClosingBalance AS CountClosingBalance,
	RegisterTable.QuantityByGBRNOpeningBalance AS QuantityByGBRNOpeningBalance,
	RegisterTable.QuantityByGBRNTurnover AS QuantityByGBRNTurnover,
	RegisterTable.QuantityByGBRNReceipt AS QuantityByGBRNReceipt,
	RegisterTable.QuantityByGBRNExpense AS QuantityByGBRNExpense,
	RegisterTable.QuantityByGBRNClosingBalance AS QuantityByGBRNClosingBalance
INTO TableOfTurnoverBalances
{SELECT
	ItemsLocationAttributes.*,
	Terms.*,
	Organization.*,
	InventoryOwnerAttribute.*,
	CCDNumber.*,
	SecondPeriod,
	Recorder.*}
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent.BalanceAndTurnovers(, , Auto, RegisterRecordsAndPeriodBoundaries, {(ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.Characteristic).* AS Characteristic, (ItemsLocationAttributes.Partner).* AS Consignee, ((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (ItemsLocationAttributes.Partner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS RegisterTable
{WHERE
	RegisterTable.ItemsLocationAttributes.*,
	RegisterTable.Terms.*,
	RegisterTable.Organization.*,
	RegisterTable.InventoryOwnerAttribute.*,
	RegisterTable.CCDNumber.*,
	RegisterTable.Recorder.*,
	RegisterTable.SecondPeriod}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TableOfTurnoverBalances.Organization AS Organization,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	DimensionOfProductItem.Characteristic AS Characteristic,
	DimensionOfProductItem.Partner AS Consignee,
	TableOfTurnoverBalances.Terms AS Terms,
	TableOfTurnoverBalances.Terms.Currency AS Currency,
	TableOfTurnoverBalances.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	TableOfTurnoverBalances.CCDNumber AS CCDNumber,
	TableOfTurnoverBalances.Recorder AS Recorder,
	TableOfTurnoverBalances.SecondPeriod AS SecondPeriod,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfTurnoverBalances.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN TableOfTurnoverBalances.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountOpeningBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfTurnoverBalances.CountReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN TableOfTurnoverBalances.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountReceipt,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfTurnoverBalances.CountExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN TableOfTurnoverBalances.CountExpense / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountExpense,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableOfTurnoverBalances.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN TableOfTurnoverBalances.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountClosingBalance,
	TableOfTurnoverBalances.CountOpeningBalance * &amp;QueryTextItemWeight AS StartBalanceWeight,
	TableOfTurnoverBalances.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem AS StartBalanceVolume,
	TableOfTurnoverBalances.CountReceipt * &amp;QueryTextItemWeight AS ReceiptWeight,
	TableOfTurnoverBalances.CountReceipt * &amp;QueryTextTheVolumeOfTheItem AS ReceiptVolume,
	TableOfTurnoverBalances.CountExpense * &amp;QueryTextItemWeight AS ConsumptionWeight,
	TableOfTurnoverBalances.CountExpense * &amp;QueryTextTheVolumeOfTheItem AS ConsumptionVolume,
	TableOfTurnoverBalances.CountClosingBalance * &amp;QueryTextItemWeight AS ClosingBalanceWeight,
	TableOfTurnoverBalances.CountClosingBalance * &amp;QueryTextTheVolumeOfTheItem AS ClosingBalanceVolume,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.ConsignmentReportFromCustomer
			THEN CASE
					WHEN &amp;QuantityUnits = 0
						THEN TableOfTurnoverBalances.CountExpense
					WHEN &amp;QuantityUnits = 1
						THEN CASE
								WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
									THEN TableOfTurnoverBalances.CountExpense / DimensionOfProductItem.Products.UnitFactorForReports
								ELSE 0
							END
				END
		ELSE 0
	END AS QuantitySold,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.WriteOffReportFromCommissionAgent
			THEN CASE
					WHEN &amp;QuantityUnits = 0
						THEN TableOfTurnoverBalances.CountExpense
					WHEN &amp;QuantityUnits = 1
						THEN CASE
								WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
									THEN TableOfTurnoverBalances.CountExpense / DimensionOfProductItem.Products.UnitFactorForReports
								ELSE 0
							END
				END
		ELSE 0
	END AS QuantityConsumed,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.ReturnOfGoodsFromCustomer
			THEN CASE
					WHEN &amp;QuantityUnits = 0
						THEN TableOfTurnoverBalances.CountExpense
					WHEN &amp;QuantityUnits = 1
						THEN CASE
								WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
									THEN TableOfTurnoverBalances.CountExpense / DimensionOfProductItem.Products.UnitFactorForReports
								ELSE 0
							END
				END
		ELSE 0
	END AS QuantityReturned,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.ConsignmentReportFromCustomer
			THEN TableOfTurnoverBalances.CountExpense * &amp;QueryTextItemWeight
		ELSE 0
	END AS SoldWeight,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.ConsignmentReportFromCustomer
			THEN TableOfTurnoverBalances.CountExpense * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS SoldVolume,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.WriteOffReportFromCommissionAgent
			THEN TableOfTurnoverBalances.CountExpense * &amp;QueryTextItemWeight
		ELSE 0
	END AS WrittenOffWeight,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.WriteOffReportFromCommissionAgent
			THEN TableOfTurnoverBalances.CountExpense * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS WrittenOffVolume,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.ReturnOfGoodsFromCustomer
			THEN TableOfTurnoverBalances.CountExpense * &amp;QueryTextItemWeight
		ELSE 0
	END AS ReturnedWeight,
	CASE
		WHEN TableOfTurnoverBalances.Recorder REFS Document.ReturnOfGoodsFromCustomer
			THEN TableOfTurnoverBalances.CountExpense * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS ReturnedVolume,
	TableOfTurnoverBalances.ItemsLocationAttributes AS ItemsLocationAttributes,
	NULL AS RevenueAmount,
	NULL AS CommissionAmount
FROM
	TableOfTurnoverBalances AS TableOfTurnoverBalances
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON TableOfTurnoverBalances.ItemsLocationAttributes = DimensionOfProductItem.Ref
			AND (DimensionOfProductItem.StorageLocation &lt;&gt; VALUE(Catalog.Partners.OurEnterprise))</query>
			<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
		</item>
