	</totalField>
	<totalField>
		<dataPath>ReturnedVolume</dataPath>
		<expression>Sum(ReturnedVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>CountExpense</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(CountExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ConsumptionWeight</dataPath>
		<expression>Sum(ConsumptionWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ConsumptionVolume</dataPath>
		<expression>Sum(ConsumptionVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>CommissionAmount</dataPath>
		<expression>Sum(CommissionAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>RevenueAmount</dataPath>
		<expression>Sum(RevenueAmount)</expression>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره</v8:content>
			</v8:item>
