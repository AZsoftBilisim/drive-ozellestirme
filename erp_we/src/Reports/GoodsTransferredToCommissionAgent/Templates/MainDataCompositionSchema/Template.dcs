						<v8:lang>ru</v8:lang>
						<v8:content>Заказано объем</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Sipariş verilen hacim</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Đã đặt hàng, khối lượng</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Series</dataPath>
				<field>Series</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Factor</dataPath>
				<field>Factor</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ReferenceOrder</dataPath>
				<field>ReferenceOrder</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Ordered</dataPath>
				<field>Ordered</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ShipmentReferences.ReferenceOrder AS ReferenceOrder
INTO CurrentOrders
FROM
	InformationRegister.ShipmentAndReturnReferencesToFulfill AS ShipmentReferences
WHERE
	VALUETYPE(ShipmentReferences.ReferenceOrder) = TYPE(Document.SalesOrder)
	AND ShipmentReferences.DocumentStateOrdered &lt;&gt; VALUE(Enum.StateOfRegisteringDocumentsByReference.Decorated)
	AND ShipmentReferences.BusinessOperation = VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
	AND CAST(ShipmentReferences.ReferenceOrder AS Document.SalesOrder).Status &lt;&gt; VALUE(Enum.SalesOrderStatuses.NotApproved)
{WHERE
	(ShipmentReferences.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

INDEX BY
	ReferenceOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DocumentData.Organization AS Organization,
	SalesOrders.Products AS Products,
	SalesOrders.Products.UnitOfMeasure AS StorageUnit,
	SalesOrders.Products.UnitForReports AS UnitForReports,
	SalesOrders.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	SalesOrders.Characteristic AS Characteristic,
	DocumentData.Partner AS Consignee,
	DocumentData.Terms AS Terms,
	DocumentData.Currency AS Currency,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CASE
				WHEN SalesOrders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
					THEN SalesOrders.CountTurnover
				ELSE -SalesOrders.CountTurnover
			END
		WHEN &amp;QuantityUnits = 1
				AND SalesOrders.Products.UnitFactorForReports &lt;&gt; 0
			THEN CASE
				WHEN SalesOrders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
					THEN SalesOrders.CountTurnover
				ELSE -SalesOrders.CountTurnover
			END / SalesOrders.Products.UnitFactorForReports
		ELSE 0
	END AS Ordered,
	CASE
		WHEN SalesOrders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
			THEN SalesOrders.CountTurnover
		ELSE -SalesOrders.CountTurnover
	END * &amp;QueryTextItemWeight AS OrderedWeight,
	CASE
		WHEN SalesOrders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered)
			THEN SalesOrders.CountTurnover
		ELSE -SalesOrders.CountTurnover
	END * &amp;QueryTextTheVolumeOfTheItem AS OrderedAmount
FROM
	AccumulationRegister.ShipmentAndReturnReferences.Turnovers(
			,
			{(&amp;EndOfPeriod)},
			,
			ReferenceOrder IN
					(SELECT
						CurrentOrders.ReferenceOrder
					FROM
						CurrentOrders AS CurrentOrders)
				AND (NOT CAST(ReferenceOrder AS Document.SalesOrder).ToReturnReusablePackage
					OR Products.ItemsType &lt;&gt; VALUE(Enum.ItemsTypes.ReusablePackage))
				AND RowCode &lt;&gt; 0
				AND Factor IN
					(VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Ordered),
					VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1))
				{((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS SalesOrders
		INNER JOIN Document.SalesOrder AS DocumentData
		ON SalesOrders.ReferenceOrder = DocumentData.Ref</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>AmountsOfRevenueRewards</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Organization</dataPath>
				<field>Organization</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ProductsWeight</dataPath>
				<field>ProductsWeight</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Items weight</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>وزن اقلام</v8:content>
					</v8:item>
