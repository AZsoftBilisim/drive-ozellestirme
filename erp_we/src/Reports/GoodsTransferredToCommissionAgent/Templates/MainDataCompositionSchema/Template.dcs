			<field xsi:type="DataSetFieldField">
				<dataPath>Ref</dataPath>
				<field>Ref</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>RevenueAmount</dataPath>
				<field>RevenueAmount</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CommissionAmount</dataPath>
				<field>CommissionAmount</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	GoodsTransferredToCommissionAgent.Organization AS Organization,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	DimensionOfProductItem.Characteristic AS Characteristic,
	DimensionOfProductItem.Partner AS Consignee,
	GoodsTransferredToCommissionAgent.Terms AS Terms,
	GoodsTransferredToCommissionAgent.Terms.Currency AS Currency,
	GoodsTransferredToCommissionAgent.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	GoodsTransferredToCommissionAgent.CCDNumber AS CCDNumber,
	GoodsTransferredToCommissionAgent.Recorder AS Recorder,
	GoodsTransferredToCommissionAgent.Period AS SecondPeriod,
	DimensionOfProductItem.Ref,
	GoodsTransferredToCommissionAgent.RevenueAmount,
	GoodsTransferredToCommissionAgent.CommissionAmount
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent AS GoodsTransferredToCommissionAgent
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON GoodsTransferredToCommissionAgent.ItemsLocationAttributes = DimensionOfProductItem.Ref
		AND (DimensionOfProductItem.StorageLocation &lt;&gt; VALUE(Catalog.Partners.OurEnterprise))
{WHERE
	GoodsTransferredToCommissionAgent.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod}</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità di misura</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>J. m.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ед. изм.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ölçü birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị tính</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>Ordered</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Ordered)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityReturned</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantityReturned)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountReceipt</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantitySold</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantitySold)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityConsumed</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantityConsumed)
End</expression>
	</totalField>
	<totalField>
		<dataPath>OrderedWeight</dataPath>
		<expression>Sum(OrderedWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>OrderedAmount</dataPath>
		<expression>Sum(OrderedAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>StartBalanceWeight</dataPath>
		<expression>Sum(StartBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>StartBalanceVolume</dataPath>
		<expression>Sum(StartBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceWeight</dataPath>
		<expression>Sum(ClosingBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceVolume</dataPath>
		<expression>Sum(ClosingBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ReceiptWeight</dataPath>
		<expression>Sum(ReceiptWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ReceiptVolume</dataPath>
		<expression>Sum(ReceiptVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>SoldWeight</dataPath>
		<expression>Sum(SoldWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>SoldVolume</dataPath>
		<expression>Sum(SoldVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>WrittenOffWeight</dataPath>
