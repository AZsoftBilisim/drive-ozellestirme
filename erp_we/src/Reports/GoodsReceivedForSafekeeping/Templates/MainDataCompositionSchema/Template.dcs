				<dataPath>Contract</dataPath>
				<field>Contract</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>StorageLocation</dataPath>
				<field>StorageLocation</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Products</dataPath>
