				<dataPath>UnitForReports</dataPath>
				<field>UnitForReports</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ReportUnit</dataPath>
				<field>ReportUnit</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Currency</dataPath>
				<field>Currency</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>UnitFactorForReports</dataPath>
				<field>UnitFactorForReports</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>InitialBalanceCost</dataPath>
				<field>InitialBalanceCost</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ReceivedQuantity</dataPath>
				<field>ReceivedQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ReceivedCost</dataPath>
				<field>ReceivedCost</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ShippedQuantity</dataPath>
				<field>ShippedQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ShippedCost</dataPath>
				<field>ShippedCost</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>RedeemedQuantity</dataPath>
				<field>RedeemedQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>RedeemedValue</dataPath>
				<field>RedeemedValue</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>QuantityToBeRedeemed</dataPath>
				<field>QuantityToBeRedeemed</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>RedeemableCost</dataPath>
				<field>RedeemableCost</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>DebitedQuantity</dataPath>
				<field>DebitedQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>DebitedCost</dataPath>
				<field>DebitedCost</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>AmountToBeDebited</dataPath>
				<field>AmountToBeDebited</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ToWriteOffCost</dataPath>
				<field>ToWriteOffCost</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>WrittenOffInProductionQuantity</dataPath>
				<field>WrittenOffInProductionQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>WrittenOffInProductionCost</dataPath>
				<field>WrittenOffInProductionCost</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>FinalRemainderCost</dataPath>
				<field>FinalRemainderCost</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	GoodsReceivedForSafekeeping.Recorder                 AS Recorder,
	GoodsReceivedForSafekeeping.SecondPeriod               AS SecondPeriod,
	GoodsReceivedForSafekeeping.DayPeriod                  AS DayPeriod,
	GoodsReceivedForSafekeeping.WeekPeriod                AS WeekPeriod,
	GoodsReceivedForSafekeeping.TenDaysPeriod                AS TenDaysPeriod,
	GoodsReceivedForSafekeeping.MonthPeriod                 AS MonthPeriod,
	GoodsReceivedForSafekeeping.QuarterPeriod               AS QuarterPeriod,
	GoodsReceivedForSafekeeping.HalfYearPeriod             AS HalfYearPeriod,
	GoodsReceivedForSafekeeping.YearPeriod                   AS YearPeriod,
	
	GoodsReceivedForSafekeeping.Organization                 AS Organization,
	GoodsReceivedForSafekeeping.Owner                    AS Owner,
	GoodsReceivedForSafekeeping.Contract                     AS Contract,
	GoodsReceivedForSafekeeping.StorageLocation               AS StorageLocation,
	GoodsReceivedForSafekeeping.Products                AS Products,
	GoodsReceivedForSafekeeping.Characteristic              AS Characteristic,
	GoodsReceivedForSafekeeping.Purpose                  AS Purpose,
	GoodsReceivedForSafekeeping.Series                       AS Series,
	GoodsReceivedForSafekeeping.PriceKind                     AS PriceKind,
	GoodsReceivedForSafekeeping.CCDNumber                    AS CCDNumber,
	SUM(GoodsReceivedForSafekeeping.InitialBalanceQuantity)     AS InitialBalanceQuantity,
	SUM(GoodsReceivedForSafekeeping.ReceivedQuantity)            AS ReceivedQuantity,
	SUM(GoodsReceivedForSafekeeping.ShippedQuantity)            AS ShippedQuantity,
	SUM(GoodsReceivedForSafekeeping.RedeemedQuantity)            AS RedeemedQuantity,
	SUM(GoodsReceivedForSafekeeping.QuantityToBeRedeemed)              AS QuantityToBeRedeemed,
	SUM(GoodsReceivedForSafekeeping.DebitedQuantity)              AS DebitedQuantity,
	SUM(GoodsReceivedForSafekeeping.AmountToBeDebited)            AS AmountToBeDebited,
	SUM(GoodsReceivedForSafekeeping.WrittenOffInProductionQuantity) AS WrittenOffInProductionQuantity,
	SUM(GoodsReceivedForSafekeeping.FinalRemainderQuantity)      AS FinalRemainderQuantity
{SELECT
	Recorder,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	
	Organization.*,
	Owner.*,
	Contract.*,
	StorageLocation.*,
	Products.*,
	Characteristic.*,
	Purpose.*,
	Series.*,
	CCDNumber.*,
	PriceKind.*,
	InitialBalanceQuantity,
	ReceivedQuantity,
	ShippedQuantity,
	RedeemedQuantity,
	QuantityToBeRedeemed,
	DebitedQuantity,
	AmountToBeDebited,
	WrittenOffInProductionQuantity,
	FinalRemainderQuantity
}
INTO GoodsInStorage
FROM
	(SELECT
		
		CASE
			WHEN CompanyGoods.Recorder = UNDEFINED
				THEN NULL
			ELSE CompanyGoods.Recorder
		END                                                 AS Recorder,
		CompanyGoods.SecondPeriod                       AS SecondPeriod,
		CompanyGoods.DayPeriod                          AS DayPeriod,
		CompanyGoods.WeekPeriod                        AS WeekPeriod,
		CompanyGoods.TenDaysPeriod                        AS TenDaysPeriod,
		CompanyGoods.MonthPeriod                         AS MonthPeriod,
		CompanyGoods.QuarterPeriod                       AS QuarterPeriod,
		CompanyGoods.HalfYearPeriod                     AS HalfYearPeriod,
		CompanyGoods.YearPeriod                           AS YearPeriod,
		
		CompanyGoods.Organization                         AS Organization,
		CompanyGoods.InventoryOwnerAttribute.GoodsOwner           AS Owner,
		CompanyGoods.InventoryOwnerAttribute.Contract                  AS Contract,
		CompanyGoods.ItemsLocationAttributes.StorageLocation  AS StorageLocation,
		CompanyGoods.ItemsLocationAttributes.Products   AS Products,
		CompanyGoods.ItemsLocationAttributes.Characteristic AS Characteristic,
		CompanyGoods.ItemsLocationAttributes.Purpose     AS Purpose,
		CompanyGoods.ItemsLocationAttributes.Series          AS Series,
		CompanyGoods.InventoryOwnerAttribute.PriceKind                  AS PriceKind,
		CompanyGoods.CCDNumber                            AS CCDNumber,
		CompanyGoods.CountOpeningBalance          AS InitialBalanceQuantity,
		0                                                     AS ReceivedQuantity,
		0                                                     AS ShippedQuantity,
		0                                                     AS RedeemedQuantity,
		0                                                     AS QuantityToBeRedeemed,
		0                                                     AS DebitedQuantity,
		0                                                     AS AmountToBeDebited,
		0                                                     AS WrittenOffInProductionQuantity,
		CompanyGoods.CountClosingBalance           AS FinalRemainderQuantity
	{SELECT
		Recorder,
		SecondPeriod,
		DayPeriod,
		WeekPeriod,
		TenDaysPeriod,
		MonthPeriod,
		QuarterPeriod,
		HalfYearPeriod,
		YearPeriod,
		
		Organization.*,
		Owner.*,
		Contract.*,
		StorageLocation.*,
		Products.*,
		Characteristic.*,
		Purpose.*,
		Series.*,
		CCDNumber.*,
		PriceKind.*,
		InitialBalanceQuantity,
		ReceivedQuantity,
		ShippedQuantity,
		RedeemedQuantity,
		QuantityToBeRedeemed,
		DebitedQuantity,
		AmountToBeDebited,
		WrittenOffInProductionQuantity,
		FinalRemainderQuantity
	}
	FROM
		AccumulationRegister.CompanyGoods.BalanceAndTurnovers(
			{&amp;StartDate},
			{&amp;EndDate},
			Auto,,
			{Organization.*,
			ItemsLocationAttributes.*,
			InventoryOwnerAttribute.*,
			CCDNumber.*}) AS CompanyGoods
	WHERE
		CompanyGoods.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.GoodsInStorageWithRightToSell)
	{WHERE
		CompanyGoods.InventoryOwnerAttribute.*,
		CompanyGoods.ItemsLocationAttributes.*,
		CASE
			WHEN CompanyGoods.Recorder = UNDEFINED
				THEN NULL
			ELSE CompanyGoods.Recorder
		END                                                 AS Recorder,
		CompanyGoods.SecondPeriod                       AS SecondPeriod,
		CompanyGoods.DayPeriod                          AS DayPeriod,
		CompanyGoods.WeekPeriod                        AS WeekPeriod,
		CompanyGoods.TenDaysPeriod                        AS TenDaysPeriod,
		CompanyGoods.MonthPeriod                         AS MonthPeriod,
		CompanyGoods.QuarterPeriod                       AS QuarterPeriod,
		CompanyGoods.HalfYearPeriod                     AS HalfYearPeriod,
		CompanyGoods.YearPeriod                           AS YearPeriod,
		
		CompanyGoods.Organization.*                       AS Organization,
		CompanyGoods.InventoryOwnerAttribute.GoodsOwner.*         AS Owner,
		CompanyGoods.InventoryOwnerAttribute.Contract.*                AS Contract,
		CompanyGoods.ItemsLocationAttributes.StorageLocation.*  AS StorageLocation,
		CompanyGoods.ItemsLocationAttributes.Products.*   AS Products,
		CompanyGoods.ItemsLocationAttributes.Characteristic.* AS Characteristic,
		CompanyGoods.ItemsLocationAttributes.Purpose.*     AS Purpose,
		CompanyGoods.ItemsLocationAttributes.Series.*          AS Series,
		CompanyGoods.InventoryOwnerAttribute.PriceKind.*                AS PriceKind,
		CompanyGoods.CCDNumber.*                          AS CCDNumber,
		CompanyGoods.CountOpeningBalance          AS InitialBalanceQuantity,
		CompanyGoods.CountClosingBalance           AS FinalRemainderQuantity
	}
	UNION ALL
	
	SELECT
		CASE
			WHEN CompanySafeStock.Recorder = UNDEFINED
				THEN NULL
			ELSE CompanySafeStock.Recorder
		END                                                AS Recorder,
		CompanySafeStock.SecondPeriod              AS SecondPeriod,
		CompanySafeStock.DayPeriod                 AS DayPeriod,
		CompanySafeStock.WeekPeriod               AS WeekPeriod,
		CompanySafeStock.TenDaysPeriod               AS TenDaysPeriod,
		CompanySafeStock.MonthPeriod                AS MonthPeriod,
		CompanySafeStock.QuarterPeriod              AS QuarterPeriod,
		CompanySafeStock.HalfYearPeriod            AS HalfYearPeriod,
		CompanySafeStock.YearPeriod                  AS YearPeriod,
		
		CompanySafeStock.Organization                AS Organization,
		CompanySafeStock.InventoryOwnerAttribute.GoodsOwner                 AS Owner,
		CompanySafeStock.InventoryOwnerAttribute.Contract                        AS Contract,
		CompanySafeStock.ItemsLocationAttributes.StorageLocation  AS StorageLocation,
		CompanySafeStock.ItemsLocationAttributes.Products   AS Products,
		CompanySafeStock.ItemsLocationAttributes.Characteristic AS Characteristic,
		CompanySafeStock.ItemsLocationAttributes.Purpose     AS Purpose,
		CompanySafeStock.ItemsLocationAttributes.Series          AS Series,
		CompanySafeStock.InventoryOwnerAttribute.PriceKind         AS PriceKind,
		CompanySafeStock.CCDNumber                   AS CCDNumber,
		CompanySafeStock.CountOpeningBalance AS InitialBalanceQuantity,
		0                                                    AS ReceivedQuantity,
		0                                                    AS ShippedQuantity,
		0                                                    AS RedeemedQuantity,
		0                                                    AS QuantityToBeRedeemed,
		0                                                    AS DebitedQuantity,
		0                                                    AS AmountToBeDebited,
		0                                                    AS WrittenOffInProductionQuantity,
		CompanySafeStock.CountClosingBalance  AS FinalRemainderQuantity
	FROM
		AccumulationRegister.CompanySafeStock.BalanceAndTurnovers(
			{&amp;StartDate},
			{&amp;EndDate},
			Auto,,
			{Organization.*,
			ItemsLocationAttributes.*,
			InventoryOwnerAttribute.*,
			CCDNumber.*}) AS CompanySafeStock
	WHERE
		CompanySafeStock.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.GoodsInStorageWithRightToSell)
	{WHERE
		CompanySafeStock.ItemsLocationAttributes.*,
		CompanySafeStock.InventoryOwnerAttribute.*,
		CASE
			WHEN CompanySafeStock.Recorder = UNDEFINED
				THEN NULL
			ELSE CompanySafeStock.Recorder
		END                                                 AS Recorder,
		CompanySafeStock.SecondPeriod               AS SecondPeriod,
		CompanySafeStock.DayPeriod                  AS DayPeriod,
		CompanySafeStock.WeekPeriod                AS WeekPeriod,
		CompanySafeStock.TenDaysPeriod                AS TenDaysPeriod,
		CompanySafeStock.MonthPeriod                 AS MonthPeriod,
		CompanySafeStock.QuarterPeriod               AS QuarterPeriod,
		CompanySafeStock.HalfYearPeriod             AS HalfYearPeriod,
		CompanySafeStock.YearPeriod                   AS YearPeriod,
		
		CompanySafeStock.Organization.*               AS Organization,
		CompanySafeStock.InventoryOwnerAttribute.GoodsOwner.* AS Owner,
		CompanySafeStock.InventoryOwnerAttribute.Contract.*                        AS Contract,
		CompanySafeStock.ItemsLocationAttributes.StorageLocation.*  AS StorageLocation,
		CompanySafeStock.ItemsLocationAttributes.Products.*   AS Products,
		CompanySafeStock.ItemsLocationAttributes.Characteristic.* AS Characteristic,
		CompanySafeStock.ItemsLocationAttributes.Purpose.*     AS Purpose,
		CompanySafeStock.ItemsLocationAttributes.Series.*          AS Series,
		CompanySafeStock.InventoryOwnerAttribute.PriceKind.*        AS PriceKind,
		CompanySafeStock.CCDNumber.*                  AS CCDNumber,
		CompanySafeStock.CountOpeningBalance  AS InitialBalanceQuantity,
		CompanySafeStock.CountClosingBalance   AS FinalRemainderQuantity
	}
	) AS GoodsReceivedForSafekeeping

GROUP BY
	GoodsReceivedForSafekeeping.Recorder,
	GoodsReceivedForSafekeeping.SecondPeriod,
	GoodsReceivedForSafekeeping.DayPeriod,
	GoodsReceivedForSafekeeping.WeekPeriod,
	GoodsReceivedForSafekeeping.TenDaysPeriod,
	GoodsReceivedForSafekeeping.MonthPeriod,
	GoodsReceivedForSafekeeping.QuarterPeriod,
	GoodsReceivedForSafekeeping.HalfYearPeriod,
	GoodsReceivedForSafekeeping.YearPeriod,
	
	GoodsReceivedForSafekeeping.Organization,
	GoodsReceivedForSafekeeping.Owner,
	GoodsReceivedForSafekeeping.Contract,
	GoodsReceivedForSafekeeping.StorageLocation,
	GoodsReceivedForSafekeeping.Products,
	GoodsReceivedForSafekeeping.Characteristic,
	GoodsReceivedForSafekeeping.Purpose,
	GoodsReceivedForSafekeeping.Series,
	GoodsReceivedForSafekeeping.PriceKind,
	GoodsReceivedForSafekeeping.CCDNumber

INDEX BY
	Owner,
	PriceKind,
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemsPrices.Partner           AS Owner,
	ItemsPrices.VendorPriceKind AS PriceKind,
	ItemsPrices.Products      AS Products,
	ItemsPrices.Characteristic    AS Characteristic,
	ItemsPrices.Price / ISNULL(&amp;QueryTextPackagingFactor, 1) AS Price,
	ItemsPrices.Currency            AS Currency
INTO ItemsPricesOfVendor
FROM
	InformationRegister.ItemsPricesOfVendor.SliceLast({&amp;EndDate},
			(Partner, VendorPriceKind, Products, Characteristic) IN
				(SELECT
					GoodsInStorage.Owner,
					GoodsInStorage.PriceKind,
					GoodsInStorage.Products,
					GoodsInStorage.Characteristic
				FROM
					GoodsInStorage AS GoodsInStorage)
		) AS ItemsPrices

INDEX BY
	Owner,
	PriceKind,
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsInStorage.Recorder         AS Recorder,
	GoodsInStorage.SecondPeriod       AS SecondPeriod,
	GoodsInStorage.DayPeriod          AS DayPeriod,
	GoodsInStorage.WeekPeriod        AS WeekPeriod,
	GoodsInStorage.TenDaysPeriod        AS TenDaysPeriod,
	GoodsInStorage.MonthPeriod         AS MonthPeriod,
	GoodsInStorage.QuarterPeriod       AS QuarterPeriod,
	GoodsInStorage.HalfYearPeriod     AS HalfYearPeriod,
	GoodsInStorage.YearPeriod           AS YearPeriod,
	
	GoodsInStorage.Organization         AS Organization,
	GoodsInStorage.Owner            AS Owner,
	GoodsInStorage.Contract             AS Contract,
	GoodsInStorage.StorageLocation       AS StorageLocation,
	GoodsInStorage.Products        AS Products,
	ProductData_1.UnitOfMeasure  AS StorageUnit,
	ProductData_1.UnitForReports AS UnitForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductData_1.UnitOfMeasure
		WHEN &amp;QuantityUnits = 1
			THEN ProductData_1.UnitForReports
	END                                AS ReportUnit,
	ProductData_1.UnitFactorForReports AS UnitFactorForReports,
	GoodsInStorage.Characteristic      AS Characteristic,
	GoodsInStorage.Purpose          AS Purpose,
	GoodsInStorage.Series               AS Series,
	GoodsInStorage.PriceKind             AS PriceKind,
	GoodsInStorage.CCDNumber            AS CCDNumber,
	ISNULL(ItemsPrices.Currency, VALUE(Catalog.Currencies.EmptyRef)) AS Currency,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.InitialBalanceQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.InitialBalanceQuantity / ProductData_1.UnitFactorForReports
	END                                      AS InitialBalanceQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.InitialBalanceQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.InitialBalanceQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS InitialBalanceCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.ReceivedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.ReceivedQuantity / ProductData_1.UnitFactorForReports
	END                                      AS ReceivedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.ReceivedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.ReceivedQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS ReceivedCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.ShippedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.ShippedQuantity / ProductData_1.UnitFactorForReports
	END                                      AS ShippedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.ShippedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.ShippedQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS ShippedCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.RedeemedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.RedeemedQuantity / ProductData_1.UnitFactorForReports
	END                                      AS RedeemedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.RedeemedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.RedeemedQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS RedeemedValue,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.QuantityToBeRedeemed
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.QuantityToBeRedeemed / ProductData_1.UnitFactorForReports
	END                                      AS QuantityToBeRedeemed,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.QuantityToBeRedeemed
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.QuantityToBeRedeemed / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS RedeemableCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.DebitedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.DebitedQuantity / ProductData_1.UnitFactorForReports
	END                                      AS DebitedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.DebitedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.DebitedQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS DebitedCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.AmountToBeDebited
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.AmountToBeDebited / ProductData_1.UnitFactorForReports
	END                                      AS AmountToBeDebited,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.AmountToBeDebited
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.AmountToBeDebited / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS ToWriteOffCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.WrittenOffInProductionQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.WrittenOffInProductionQuantity / ProductData_1.UnitFactorForReports
	END                                      AS WrittenOffInProductionQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.WrittenOffInProductionQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.WrittenOffInProductionQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS WrittenOffInProductionCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.FinalRemainderQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.FinalRemainderQuantity / ProductData_1.UnitFactorForReports
	END                                      AS FinalRemainderQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.FinalRemainderQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.FinalRemainderQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS FinalRemainderCost
{SELECT
	Recorder,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	Organization.*,
	Owner.*,
	Contract.*,
	StorageLocation.*,
	Products.*,
	StorageUnit.*,
	UnitForReports.*,
	ReportUnit.*,
	Characteristic.*,
	Purpose.*,
	Series.*,
	PriceKind.*,
	CCDNumber.*,
	Currency.*,
	UnitFactorForReports,
	InitialBalanceQuantity,
	InitialBalanceCost,
	ReceivedQuantity,
	ReceivedCost,
	ShippedQuantity,
	ShippedCost,
	RedeemedQuantity,
	RedeemedValue,
	QuantityToBeRedeemed,
	RedeemableCost,
	DebitedQuantity,
	DebitedCost,
	AmountToBeDebited,
	ToWriteOffCost,
	WrittenOffInProductionQuantity,
	WrittenOffInProductionCost,
	FinalRemainderQuantity,
	FinalRemainderCost
}
FROM
	GoodsInStorage AS GoodsInStorage
	
	LEFT JOIN ItemsPricesOfVendor AS ItemsPrices
	ON GoodsInStorage.Owner = ItemsPrices.Owner
	AND GoodsInStorage.PriceKind = ItemsPrices.PriceKind
	AND GoodsInStorage.Products = ItemsPrices.Products
	AND GoodsInStorage.Characteristic = ItemsPrices.Characteristic
	
	LEFT JOIN Catalog.Products AS ProductData_1
	ON GoodsInStorage.Products = ProductData_1.Ref
	
{WHERE
	ProductData_1.UnitOfMeasure.*                                                AS StorageUnit,
	ProductData_1.UnitForReports.*                                               AS UnitForReports,
	(CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductData_1.UnitOfMeasure
		WHEN &amp;QuantityUnits = 1
			THEN ProductData_1.UnitForReports
	END).*                                                                             AS ReportUnit,
	(ISNULL(ItemsPrices.Currency, VALUE(Catalog.Currencies.EmptyRef))).*      AS Currency,
	ProductData_1.UnitFactorForReports                                      AS UnitFactorForReports,
	
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.InitialBalanceQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.InitialBalanceQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS InitialBalanceCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.ReceivedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.ReceivedQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS ReceivedCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.ShippedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.ShippedQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS ShippedCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.RedeemedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.RedeemedQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS RedeemedValue,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.QuantityToBeRedeemed
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.QuantityToBeRedeemed / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS RedeemableCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.DebitedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.DebitedQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS DebitedCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.AmountToBeDebited
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.AmountToBeDebited / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS ToWriteOffCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.WrittenOffInProductionQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.WrittenOffInProductionQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS WrittenOffInProductionCost,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsInStorage.FinalRemainderQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsInStorage.FinalRemainderQuantity / ProductData_1.UnitFactorForReports
	END * ISNULL(ItemsPrices.Price, 0) AS FinalRemainderCost
}</query>
		</item>
