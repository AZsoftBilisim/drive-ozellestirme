			<field xsi:type="DataSetFieldField">
				<dataPath>Purpose</dataPath>
				<field>Purpose</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Series</dataPath>
				<field>Series</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PriceKind</dataPath>
				<field>PriceKind</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CCDNumber</dataPath>
				<field>CCDNumber</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>InitialBalanceQuantity</dataPath>
				<field>InitialBalanceQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>FinalRemainderQuantity</dataPath>
				<field>FinalRemainderQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>InventoryOwnerAttribute</dataPath>
				<field>InventoryOwnerAttribute</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ItemsLocationAttributes</dataPath>
				<field>ItemsLocationAttributes</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ThisIsReverseTransaction</dataPath>
				<field>ThisIsReverseTransaction</field>
