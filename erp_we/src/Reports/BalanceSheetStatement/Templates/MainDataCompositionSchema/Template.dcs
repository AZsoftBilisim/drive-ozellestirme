		<field xsi:type="DataSetFieldField">
			<dataPath>BaseCurrency</dataPath>
			<field>BaseCurrency</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ExchangeRateManCurrency.Currency AS Man,
	ExchangeRateManCurrency.CourseNumerator AS ManSCourse,
	ExchangeRateManCurrency.CourseDenominator AS MultiplicityOfMan,
	ExchangeRateReportCurrency.Currency AS Report,
	ExchangeRateReportCurrency.CourseNumerator AS CourseReport,
	ExchangeRateReportCurrency.CourseDenominator AS MultiplicityReport,
	ExchangeRateManCurrency.CourseNumerator/ExchangeRateManCurrency.CourseDenominator / ISNULL(ExchangeRateReportCurrency.CourseNumerator,1)/ISNULL(ExchangeRateReportCurrency.CourseDenominator,1) AS ZoomRatio	
INTO ttCurrencies
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency  = &amp;ManagementAccountingCurrency AND BaseCurrency = &amp;DefaultBaseCurrency) AS ExchangeRateManCurrency
	INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;EndOfPeriod, Currency = &amp;ReportCurrency AND BaseCurrency = &amp;DefaultBaseCurrency) AS ExchangeRateReportCurrency
	ON TRUE
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ArticleData.AddlOrderingAttribute * 10 AS Order,
	CASE WHEN ArticleData.AssetLiability = &amp;AssetLiability
		THEN &amp;Liabilities
		ELSE ArticleData.AssetLiability
	END AS IndicatorType,
	AssetsLiabilities.AssetRef AS Factor,
	ArticleData.Description AS TurnoverPresentation,
	
	ArticleData.OutputTurnover AS DisplayTurnoverByArticle,
	ArticleData.ItemDebitPresentation AS ItemDebitPresentation,
	ArticleData.PresentationOfCrBalanceOfAssetAndLiabilityItems AS PresentationOfCrBalanceOfAssetAndLiabilityItems,
	
	AssetsLiabilities.SumOpeningBalance * Currencies.ZoomRatio AS SumOpeningBalance,
	AssetsLiabilities.SumReceipt * Currencies.ZoomRatio AS SumReceipt,
	AssetsLiabilities.SumExpense * Currencies.ZoomRatio AS SumExpense,
	AssetsLiabilities.SumClosingBalance * Currencies.ZoomRatio AS SumClosingBalance,
	AssetsLiabilities.SumClosingBalance * Currencies.ZoomRatio AS SumBalance,
	
	AssetsLiabilities.Organization AS Organization,
	AssetsLiabilities.Department AS Department,
	AssetsLiabilities.LineOfBusiness AS LineOfBusiness,
	
	&amp;ManagementAccountingCurrency AS Currency,
	&amp;ReportCurrency AS ReportCurrency,
	
	AssetsLiabilities.SecondPeriod AS SecondPeriod,
	AssetsLiabilities.MonthPeriod AS MonthPeriod,
	AssetsLiabilities.QuarterPeriod AS QuarterPeriod,
	AssetsLiabilities.HalfYearPeriod AS HalfYearPeriod,
	AssetsLiabilities.YearPeriod AS YearPeriod,
	
	CASE WHEN AssetsLiabilities.Recorder = UNDEFINED
		THEN NULL
		ELSE AssetsLiabilities.Recorder
	END AS Recorder,
	VALUETYPE(AssetsLiabilities.Recorder) AS TypeOfRegistrar
INTO TTBalancesAndRevolutionsAP
FROM
	AccumulationRegister.OtherAssetsLiabilities.BalanceAndTurnovers(, , Auto, , {(LineOfBusiness), (Organization), (Department)}) AS AssetsLiabilities
		LEFT JOIN ChartOfCharacteristicTypes.AssetLiabilityItems AS ArticleData
		ON AssetsLiabilities.AssetRef = ArticleData.Ref
		LEFT JOIN  ttCurrencies AS Currencies
		ON TRUE
;

////////////////////////////////////////////////////////////////////////////////
SELECT //Remaining Assets\Liabilities
	BalanceAndTurnovers.Order AS Order,
	BalanceAndTurnovers.IndicatorType AS IndicatorType,
	BalanceAndTurnovers.Factor AS Factor,	
	BalanceAndTurnovers.TurnoverPresentation AS TurnoverPresentation,
	
	BalanceAndTurnovers.SumOpeningBalance AS SumOpeningBalance,
	BalanceAndTurnovers.SumClosingBalance AS SumClosingBalance,
	
	BalanceAndTurnovers.SumBalance AS SumBalance,
	0 AS SumTurnover,
	
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Department AS Department,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.ReportCurrency AS ReportCurrency,
	
	BalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	BalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	BalanceAndTurnovers.HalfYearPeriod AS HalfYearPeriod,
	BalanceAndTurnovers.YearPeriod AS YearPeriod,
	
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.TypeOfRegistrar AS TypeOfRegistrar,
	&amp;AmountTypeBalance AS AmountType
FROM
	TTBalancesAndRevolutionsAP AS BalanceAndTurnovers

UNION ALL

SELECT //Increase - Arrival Of Assets
	BalanceAndTurnovers.Order + 1 AS Order,
	BalanceAndTurnovers.IndicatorType AS IndicatorType,
	BalanceAndTurnovers.Factor AS Factor,
	
	CASE WHEN BalanceAndTurnovers.ItemDebitPresentation = &amp;IsBlankString
		THEN &amp;Increase
		ELSE BalanceAndTurnovers.ItemDebitPresentation
	END AS TurnoverPresentation,
	
	0 AS SumOpeningBalance,
	0 AS SumClosingBalance,
	
	0 AS SumBalance,
	BalanceAndTurnovers.SumReceipt AS SumTurnover,
	
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Department AS Department,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.ReportCurrency AS ReportCurrency,
	
	BalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	BalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	BalanceAndTurnovers.HalfYearPeriod AS HalfYearPeriod,
	BalanceAndTurnovers.YearPeriod AS YearPeriod,
	
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.TypeOfRegistrar AS TypeOfRegistrar,
	&amp;AmountTypeTurnover AS AmountType
FROM
	TTBalancesAndRevolutionsAP AS BalanceAndTurnovers
WHERE
	&amp;DisplayTurnoverByArticle_
	AND BalanceAndTurnovers.DisplayTurnoverByArticle
	AND BalanceAndTurnovers.IndicatorType = &amp;AssetBalanceSheetName

UNION ALL

SELECT //Increase - Expenditure Of Liabilities
	BalanceAndTurnovers.Order + 1 AS Order,
	BalanceAndTurnovers.IndicatorType AS IndicatorType,
	BalanceAndTurnovers.Factor AS Factor,
	
	CASE WHEN BalanceAndTurnovers.PresentationOfCrBalanceOfAssetAndLiabilityItems = &amp;IsBlankString
		THEN &amp;Increase
		ELSE BalanceAndTurnovers.PresentationOfCrBalanceOfAssetAndLiabilityItems
	END AS TurnoverPresentation,
	0 AS SumOpeningBalance,
	0 AS SumClosingBalance,
	
	0 AS SumBalance,
	-BalanceAndTurnovers.SumExpense AS SumTurnover,
	
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Department AS Department,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.ReportCurrency AS ReportCurrency,
	
	BalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	BalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	BalanceAndTurnovers.HalfYearPeriod AS HalfYearPeriod,
	BalanceAndTurnovers.YearPeriod AS YearPeriod,
	
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.TypeOfRegistrar AS TypeOfRegistrar,
	&amp;AmountTypeTurnover AS AmountType
FROM
	TTBalancesAndRevolutionsAP AS BalanceAndTurnovers
WHERE
	&amp;DisplayTurnoverByArticle_
	AND BalanceAndTurnovers.DisplayTurnoverByArticle
	AND BalanceAndTurnovers.IndicatorType = &amp;Liabilities

UNION ALL

SELECT  //Decrease - Expenditure Of Assets
	BalanceAndTurnovers.Order + 2 AS Order,
	BalanceAndTurnovers.IndicatorType AS IndicatorType,
	BalanceAndTurnovers.Factor AS Factor,
	
	CASE WHEN BalanceAndTurnovers.PresentationOfCrBalanceOfAssetAndLiabilityItems = &amp;IsBlankString
		THEN &amp;Decrease
		ELSE BalanceAndTurnovers.PresentationOfCrBalanceOfAssetAndLiabilityItems
	END AS TurnoverPresentation,
	0 AS SumOpeningBalance,
	0 AS SumClosingBalance,
	
	0 AS SumBalance,
	-BalanceAndTurnovers.SumExpense AS SumTurnover,
	
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Department AS Department,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.ReportCurrency AS ReportCurrency,
	
	BalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	BalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	BalanceAndTurnovers.HalfYearPeriod AS HalfYearPeriod,
	BalanceAndTurnovers.YearPeriod AS YearPeriod,
	
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.TypeOfRegistrar AS TypeOfRegistrar,
	&amp;AmountTypeTurnover AS AmountType
FROM
	TTBalancesAndRevolutionsAP AS BalanceAndTurnovers
WHERE
	&amp;DisplayTurnoverByArticle_
	AND BalanceAndTurnovers.DisplayTurnoverByArticle
	AND BalanceAndTurnovers.IndicatorType = &amp;AssetBalanceSheetName

UNION ALL

SELECT //Decrease - The Arrival Of Liabilities
	BalanceAndTurnovers.Order + 2 AS Order,
	BalanceAndTurnovers.IndicatorType AS IndicatorType,
	BalanceAndTurnovers.Factor AS Factor,
	
	CASE WHEN BalanceAndTurnovers.ItemDebitPresentation = &amp;IsBlankString
		THEN &amp;Decrease
		ELSE BalanceAndTurnovers.ItemDebitPresentation
	END AS TurnoverPresentation,
	0 AS SumOpeningBalance,
	0 AS SumClosingBalance,
	
	0 AS SumBalance,
	BalanceAndTurnovers.SumReceipt AS SumTurnover,
	
	BalanceAndTurnovers.Organization AS Organization,
	BalanceAndTurnovers.Department AS Department,
	BalanceAndTurnovers.LineOfBusiness AS LineOfBusiness,
	
	BalanceAndTurnovers.Currency AS Currency,
	BalanceAndTurnovers.ReportCurrency AS ReportCurrency,
	
	BalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	BalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	BalanceAndTurnovers.HalfYearPeriod AS HalfYearPeriod,
	BalanceAndTurnovers.YearPeriod AS YearPeriod,
	
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.TypeOfRegistrar AS TypeOfRegistrar,
	&amp;AmountTypeTurnover AS AmountType
FROM
	TTBalancesAndRevolutionsAP AS BalanceAndTurnovers
WHERE
	&amp;DisplayTurnoverByArticle_
	AND BalanceAndTurnovers.DisplayTurnoverByArticle
	AND BalanceAndTurnovers.IndicatorType = &amp;Liabilities

ORDER BY
	Order</query>
	</dataSet>
