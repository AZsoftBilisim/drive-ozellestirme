					<v8:lang>it</v8:lang>
					<v8:content>Importo saldo finale</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Wartość saldo końcowe</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
