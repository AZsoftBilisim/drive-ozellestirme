End</expression>
	</totalField>
	<totalField>
		<dataPath>WriteOffRevaluation</dataPath>
		<expression>Case
    When Sum(WriteOffRevaluation) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(WriteOffRevaluation), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(WriteOffRevaluation)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PartnerDebt_OpeningBalance</dataPath>
		<expression>Cast(0, "Number(31,2)")</expression>
		<group>Recorder</group>
	</totalField>
