End</expression>
	</totalField>
	<totalField>
		<dataPath>InitialBalance_</dataPath>
		<expression>Case
    When Sum(InitialBalance_) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(InitialBalance_), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
