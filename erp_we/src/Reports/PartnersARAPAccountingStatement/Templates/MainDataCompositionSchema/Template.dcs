			</field>
			<dataSource>CustomersARAPAccounting</dataSource>
			<query>SELECT
	VALUE(Catalog.Companies.EmptyRef)             AS Organization,
	VALUE(Catalog.Partners.EmptyRef)                AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef)             AS Counterparty,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS Contract,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS ARAPObject,
	VALUE(Catalog.Currencies.EmptyRef)                  AS Currency,
	UNDEFINED                                              AS ARAPDocument,
	DATETIME(1,1,1)                                          AS OccurrenceDate,
	DATETIME(1,1,1)                                          AS PlannedRepaymentDate,
	
	0                                                         AS PartnerDebt_OpeningBalance,
	0                                                         AS AccountsPayableOfCompanyOpeningBalance,
	0                                                         AS InitialBalance_,
	
	0                                                         AS PaidToPartner,
	0                                                         AS ShippedToPartner,
	0                                                         AS SetOff,
	0                                                         AS ShippedToUs,
	0                                                         AS PaidToUs,
	0                                                         AS WriteOffRevaluation,
	
	0                                                         AS PartnerDebt_ClosingBalance,
	0                                                         AS AccountsPayableOfCompanyClosingBalance,
	0                                                         AS FinalBalance,
	
	VALUE(Catalog.PartnersSegments.EmptyRef)       AS PartnersSegment,
	0                                                         AS PaymentType_,
	UNDEFINED                                              AS Recorder,
	UNDEFINED                                              AS ARAPAccountingRecorder,
	
	DATETIME(1,1,1)                                          AS SecondPeriod,
	DATETIME(1,1,1)                                          AS DayPeriod,
	DATETIME(1,1,1)                                          AS WeekPeriod,
	DATETIME(1,1,1)                                          AS TenDaysPeriod,
	DATETIME(1,1,1)                                          AS MonthPeriod,
	DATETIME(1,1,1)                                          AS QuarterPeriod,
	DATETIME(1,1,1)                                          AS HalfYearPeriod,
	DATETIME(1,1,1)                                          AS YearPeriod
</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>PartnerDebt_OpeningBalance</dataPath>
		<expression>Case
    When Sum(PartnerDebt_OpeningBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(PartnerDebt_OpeningBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(PartnerDebt_OpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompanyOpeningBalance</dataPath>
		<expression>Case
    When Sum(AccountsPayableOfCompanyOpeningBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(AccountsPayableOfCompanyOpeningBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(AccountsPayableOfCompanyOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PaidToPartner</dataPath>
		<expression>Case
    When Sum(PaidToPartner) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
       JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(PaidToPartner), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(PaidToPartner)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ShippedToPartner</dataPath>
		<expression>Case
    When Sum(ShippedToPartner) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ShippedToPartner), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(ShippedToPartner)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SetOff</dataPath>
		<expression>Case
    When Sum(SetOff) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SetOff), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(SetOff)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ShippedToUs</dataPath>
		<expression>Case
    When Sum(ShippedToUs) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
       JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ShippedToUs), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(ShippedToUs)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PaidToUs</dataPath>
		<expression>Case
    When Sum(PaidToUs) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(PaidToUs), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(PaidToUs)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PartnerDebt_ClosingBalance</dataPath>
		<expression>Case
    When Sum(PartnerDebt_ClosingBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(PartnerDebt_ClosingBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(PartnerDebt_ClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompanyClosingBalance</dataPath>
		<expression>Case
    When Sum(AccountsPayableOfCompanyClosingBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(AccountsPayableOfCompanyClosingBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
        Sum(AccountsPayableOfCompanyClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>FinalBalance</dataPath>
		<expression>Case
    When Sum(FinalBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(FinalBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
    Else
