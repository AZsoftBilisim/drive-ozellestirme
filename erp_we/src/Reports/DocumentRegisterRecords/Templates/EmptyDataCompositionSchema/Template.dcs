			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Negativo con rosso</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Ujemne na czerwono</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
