							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>gdzie [1, 2, 3, 4, 5, 6, 7] - numery kolumn</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>где [1, 2, 3, 4, 5, 6, 7] - номера колонок</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>buradaki [1, 2, 3, 4, 5, 6, 7] sütun numaralarıdır</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>trong đó [1, 2, 3, 4, 5, 6, 7] - số cột</v8:content>
							</v8:item>
