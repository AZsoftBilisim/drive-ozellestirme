		<field xsi:type="DataSetFieldField">
			<dataPath>DepreciationMethodVersionLA</dataPath>
			<field>DepreciationMethodVersionLA</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DepreciationMethodVersionMA</dataPath>
			<field>DepreciationMethodVersionMA</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CASE
		WHEN TabDepreciation.AccrualPeriod &lt;&gt; DATETIME(1,1,1)
			THEN ENDOFPERIOD(TabDepreciation.AccrualPeriod, DAY)
		ELSE TabDepreciation.Period
	END AS Period,
	TabDepreciation.Period AS CalculationPeriod,
	TabDepreciation.Recorder AS DepreciationCalculationDocument,
	CASE
		WHEN TabDepreciation.AccrualPeriod &lt;&gt; DATETIME(1,1,1)
			THEN BEGINOFPERIOD(TabDepreciation.AccrualPeriod, YEAR)
		ELSE BEGINOFPERIOD(TabDepreciation.Period, YEAR)
	END AS BegOfYear,
	CASE
		WHEN TabDepreciation.AccrualPeriod &lt;&gt; DATETIME(1,1,1)
			THEN BEGINOFPERIOD(TabDepreciation.AccrualPeriod, MONTH)
		ELSE BEGINOFPERIOD(TabDepreciation.Period, MONTH)
	END AS BegOfMonth,
	TabDepreciation.Organization AS Organization,
	TabDepreciation.FixedAsset AS FixedAsset,
	TabDepreciation.Organization.ParentCompany AS ParentCompany,
	TabDepreciation.Depreciation AS DepreciationManagementAccounting,
	TabDepreciation.DepreciationLocal + TabDepreciation.FixedAssetDepreciationTargetFinancing AS DepreciationInAccounting,
	TabDepreciation.LifeSpentPastPeriod AS ResourceDevelopedOverPastPeriodMA,
	TabDepreciation.LifeSpentPastPeriodAccounting AS LifeSpentPastPeriodAccounting,
	TabDepreciation.LifeSpentCurrentPeriod AS ResourceDevelopedForCurPeriodMA,
	TabDepreciation.LifeSpentCurrentPeriodAccounting AS LifeSpentCurrentPeriodAccounting,
	TabDepreciation.CostUsedToCalculateDepreciationManag AS CostUsedToCalculateDepreciationInManagementAccounting,
	TabDepreciation.CostUsedToCalculateDepreciationLocal AS CostUsedToCalculateDepreciationInAccounting,
	TabDepreciation.AccountingProcedureMA AS AccountingProcedureMA,
	TabDepreciation.ProcedureForCalculatingDepreciationOfMa AS ProcedureForCalculatingDepreciationOfMa,
	TabDepreciation.ProcedureForCalculatingDepreciationAC AS ProcedureForCalculatingDepreciationAC,
	TabDepreciation.DepreciationMethodVersionMA AS DepreciationMethodVersionMA,
	TabDepreciation.DepreciationMethodVersionLA AS DepreciationMethodVersionLA,
	TabDepreciation.ThisIsAnAdditionalAccrual AS ThisIsAnAdditionalAccrual,
	TabDepreciation.ThisIsAdditionalChargeAccounting AS ThisIsAdditionalChargeAccounting
INTO TT_Depreciation
FROM
	AccumulationRegister.FixedAssetsDepreciationCharge AS TabDepreciation
WHERE
	(TabDepreciation.Period &gt;= &amp;BeginOfPeriod
			OR &amp;BeginOfPeriod = DATETIME(1, 1, 1))
	AND (TabDepreciation.Period &lt;= &amp;EndOfPeriod
			OR &amp;EndOfPeriod = DATETIME(1, 1, 1))
	AND TabDepreciation.Recorder REFS Document.FixedAssetsDepreciationCharge2_4
	AND TabDepreciation.RecordType = VALUE(AccumulationRecordType.Expense)
	AND NOT TabDepreciation.ThisIsRecordingOfDifference
{WHERE
	TabDepreciation.Organization.* AS Organization,
	TabDepreciation.FixedAsset.* AS FixedAsset,
	(CAST(TabDepreciation.Recorder AS Document.FixedAssetsDepreciationCharge2_4)) AS DepreciationCalculationDocument,
	TabDepreciation.Depreciation AS DepreciationManagementAccounting,
	(TabDepreciation.DepreciationLocal + TabDepreciation.FixedAssetDepreciationTargetFinancing) AS DepreciationInAccounting}

INDEX BY
	Period,
	FixedAsset,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	TT_Depreciation.Period AS Period,
	TT_Depreciation.Organization AS Organization,
	MAX(TableLastPeriod.Period) AS CutOffPeriodOfLatter
INTO AccountingPolicy_SliceOfLatest
FROM
	TT_Depreciation AS TT_Depreciation
		INNER JOIN InformationRegister.FinancialAccountingPolicy AS TableLastPeriod
		ON (TableLastPeriod.Organization = TT_Depreciation.Organization)
			AND (TableLastPeriod.Period &lt;= TT_Depreciation.Period)

GROUP BY
	TT_Depreciation.Period,
	TT_Depreciation.Organization

INDEX BY
	Period,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SliceTable.Period AS Period,
	SliceTable.Organization AS Organization,
	RegisterTableAsOfDate.ProcedureOfFixedAssetDepreciationCharge AS ProcedureOfFixedAssetDepreciationCharge,
	RegisterTableAsOfDate.ProcedureOfFixedAssetDepreciationChargeLocal AS ProcedureOfFixedAssetDepreciationChargeLocal
INTO AccountingPolicy
FROM
	AccountingPolicy_SliceOfLatest AS SliceTable
		INNER JOIN InformationRegister.FinancialAccountingPolicy AS RegisterTableAsOfDate
		ON (RegisterTableAsOfDate.Organization = SliceTable.Organization)
			AND (RegisterTableAsOfDate.Period = SliceTable.CutOffPeriodOfLatter)

INDEX BY
	Organization,
	Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	CASE
		WHEN (Depreciation.ProcedureForCalculatingDepreciationAC = VALUE(Enum.DepreciationProcedure.FromDateOfRecognitionInAccounting)
				OR Depreciation.ProcedureForCalculatingDepreciationAC = VALUE(Enum.DepreciationProcedure.EmptyRef)
						AND ISNULL(AccountingPolicy.ProcedureOfFixedAssetDepreciationCharge, VALUE(Enum.DepreciationProcedure.FromDateOfRecognitionInAccounting)) = VALUE(Enum.DepreciationProcedure.FromDateOfRecognitionInAccounting))
			THEN Depreciation.Period
		ELSE ENDOFPERIOD(DATEADD(Depreciation.Period, MONTH, -1), MONTH)
	END AS ParameterPeriod,
	Depreciation.Period AS Period,
	Depreciation.Organization AS Organization,
	Depreciation.ParentCompany AS ParentCompany,
	Depreciation.FixedAsset AS FixedAsset
INTO PeriodsOfACParameters
FROM
	TT_Depreciation AS Depreciation
		LEFT JOIN AccountingPolicy AS AccountingPolicy
		ON AccountingPolicy.Organization = Depreciation.Organization
			AND AccountingPolicy.Period = Depreciation.Period
WHERE
	Depreciation.DepreciationInAccounting &lt;&gt; 0

INDEX BY
	FixedAsset,
	Organization,
	ParentCompany,
	ParameterPeriod
;
	
////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	CASE
		WHEN (Depreciation.ProcedureForCalculatingDepreciationOfMa = VALUE(Enum.DepreciationProcedure.FromDateOfRecognitionInAccounting)
				OR Depreciation.ProcedureForCalculatingDepreciationOfMa = VALUE(Enum.DepreciationProcedure.EmptyRef)
						AND ISNULL(AccountingPolicy.ProcedureOfFixedAssetDepreciationCharge, VALUE(Enum.DepreciationProcedure.FromDateOfRecognitionInAccounting)) = VALUE(Enum.DepreciationProcedure.FromDateOfRecognitionInAccounting))
			THEN Depreciation.Period
		ELSE ENDOFPERIOD(DATEADD(Depreciation.Period, MONTH, -1), MONTH)
	END AS ParameterPeriod,
	Depreciation.Period AS Period,
	Depreciation.Organization AS Organization,
	Depreciation.FixedAsset AS FixedAsset
INTO PeriodsOfMaParameters
FROM
	TT_Depreciation AS Depreciation
		LEFT JOIN AccountingPolicy AS AccountingPolicy
		ON AccountingPolicy.Organization = Depreciation.Organization
			AND AccountingPolicy.Period = Depreciation.Period	
WHERE
	Depreciation.DepreciationManagementAccounting &lt;&gt; 0

INDEX BY
	FixedAsset,
	Organization,
	ParameterPeriod
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ParameterPeriods.Period AS Period,
	ParameterPeriods.ParameterPeriod AS ParameterPeriod,
	ParameterPeriods.Organization AS Organization,
	ParameterPeriods.FixedAsset AS FixedAsset,
	MAX(TableLastPeriod.Period) AS CutOffPeriodOfLatter
INTO Osuu_SliceDepreciationParameters
FROM
	PeriodsOfMaParameters AS ParameterPeriods
		INNER JOIN InformationRegister.FixedAssetDepreciationParametersManagementAccounting AS TableLastPeriod
		ON (TableLastPeriod.Organization = ParameterPeriods.Organization)
			AND (TableLastPeriod.FixedAsset = ParameterPeriods.FixedAsset)
			AND (TableLastPeriod.Period &lt;= ParameterPeriods.ParameterPeriod)
			AND (TableLastPeriod.CorrectionDate = DATETIME(1,1,1))

GROUP BY
	ParameterPeriods.Period,
	ParameterPeriods.ParameterPeriod,
	ParameterPeriods.Organization,
	ParameterPeriods.FixedAsset

INDEX BY
	FixedAsset,
	Organization,
	CutOffPeriodOfLatter
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SliceTable.Period AS Period,
	SliceTable.FixedAsset AS FixedAsset,
	SliceTable.Organization AS Organization,
	RegisterTableAsOfDate.DepreciationMethod AS DepreciationMethod,
	RegisterTableAsOfDate.ResidualValueMan AS ResidualValueMan,
	RegisterTableAsOfDate.ResidualValueLocal AS ResidualValueLocal,
	RegisterTableAsOfDate.UsefulLifeMonths AS UsefulLifeMonths,
	RegisterTableAsOfDate.UsefulLifeForCalculatingDepreciationMonth AS UsefulLifeForCalculatingDepreciationMonth,
	RegisterTableAsOfDate.CostUsedToCalculateDepreciationManag AS CostUsedToCalculateDepreciationManag,
	RegisterTableAsOfDate.VolumeOfProductsWorksForCalculatingDepreciationInPhysicalUnits AS VolumeOfProductsWorksForCalculatingDepreciationInPhysicalUnits,
	RegisterTableAsOfDate.AccelerationFactor AS AccelerationFactor,
	RegisterTableAsOfDate.LastChangeDate AS LastChangeDate
INTO FixedAssetDepreciationParametersManagementAccounting
FROM
	Osuu_SliceDepreciationParameters AS SliceTable
		INNER JOIN InformationRegister.FixedAssetDepreciationParametersManagementAccounting AS RegisterTableAsOfDate
		ON (RegisterTableAsOfDate.Organization = SliceTable.Organization)
			AND (RegisterTableAsOfDate.FixedAsset = SliceTable.FixedAsset)
			AND (RegisterTableAsOfDate.Period = SliceTable.CutOffPeriodOfLatter)
			AND (RegisterTableAsOfDate.CorrectionDate = DATETIME(1,1,1))

INDEX BY
	FixedAsset,
	Organization,
	Period
;

////////////////////////////////////////////////////////////////////////////////
DROP Osuu_SliceDepreciationParameters

;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ParameterPeriods.Period AS Period,
	ParameterPeriods.ParameterPeriod AS ParameterPeriod,
	ParameterPeriods.Organization AS Organization,
	ParameterPeriods.FixedAsset AS FixedAsset,
	MAX(TableLastPeriod.Period) AS CutOffPeriodOfLatter
INTO DepreciationParametersOfOSBU_SectionOfLast
FROM
	PeriodsOfACParameters AS ParameterPeriods
		INNER JOIN InformationRegister.OSBUDepreciationParameters AS TableLastPeriod
		ON (TableLastPeriod.Organization = ParameterPeriods.Organization)
			AND (TableLastPeriod.FixedAsset = ParameterPeriods.FixedAsset)
			AND (TableLastPeriod.Period &lt;= ParameterPeriods.ParameterPeriod)
			AND (TableLastPeriod.CorrectionDate = DATETIME(1,1,1))

GROUP BY
	ParameterPeriods.Period,
	ParameterPeriods.ParameterPeriod,
	ParameterPeriods.Organization,
	ParameterPeriods.FixedAsset

INDEX BY
	FixedAsset,
	Organization,
	CutOffPeriodOfLatter
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SliceTable.Period AS Period,
	SliceTable.FixedAsset AS FixedAsset,
	SliceTable.Organization AS Organization,
	RegisterTableAsOfDate.UsefulLifeForCalculatingDepreciationMonth AS UsefulLifeForCalculatingDepreciationMonth,
	RegisterTableAsOfDate.VolumeOfProductsWorksForCalculatingDepreciationInPhysicalUnits AS VolumeOfProductsWorksForCalculatingDepreciationInPhysicalUnits,
	RegisterTableAsOfDate.AccelerationFactor AS AccelerationFactor,
	RegisterTableAsOfDate.LastChangeDate AS LastChangeDate,
	RegisterTableAsOfDate.ResidualValueMan AS ResidualValueMan	
INTO OSBUDepreciationParameters
FROM
	DepreciationParametersOfOSBU_SectionOfLast AS SliceTable
		INNER JOIN InformationRegister.OSBUDepreciationParameters AS RegisterTableAsOfDate
		ON (RegisterTableAsOfDate.Organization = SliceTable.Organization)
			AND (RegisterTableAsOfDate.FixedAsset = SliceTable.FixedAsset)
			AND (RegisterTableAsOfDate.Period = SliceTable.CutOffPeriodOfLatter)
			AND (RegisterTableAsOfDate.CorrectionDate = DATETIME(1,1,1))

INDEX BY
	FixedAsset,
	Organization,
	Period
;

////////////////////////////////////////////////////////////////////////////////
DROP DepreciationParametersOfOSBU_SectionOfLast
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ParameterPeriods.Period AS Period,
	ParameterPeriods.ParameterPeriod AS ParameterPeriod,
	ParameterPeriods.Organization AS Organization,
	ParameterPeriods.FixedAsset AS FixedAsset,
	MAX(TableLastPeriod.Period) AS CutOffPeriodOfLatter
INTO InitialInformationOS_SliceOfLatest
FROM
	PeriodsOfACParameters AS ParameterPeriods
		INNER JOIN InformationRegister.InitialFixedAssetsInformation AS TableLastPeriod
		ON (TableLastPeriod.Organization = ParameterPeriods.Organization)
			AND (TableLastPeriod.FixedAsset = ParameterPeriods.FixedAsset)
			AND (TableLastPeriod.Period &lt;= ParameterPeriods.ParameterPeriod)
			AND (TableLastPeriod.CorrectionDate = DATETIME(1,1,1))

GROUP BY
	ParameterPeriods.Period,
	ParameterPeriods.ParameterPeriod,
	ParameterPeriods.Organization,
	ParameterPeriods.FixedAsset

INDEX BY
	FixedAsset,
	Organization,
	CutOffPeriodOfLatter
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SliceTable.Period AS Period,
	SliceTable.FixedAsset AS FixedAsset,
	SliceTable.Organization AS Organization,
	RegisterTableAsOfDate.DepreciationMethodAccounting AS DepreciationMethodAccounting,
	RegisterTableAsOfDate.CommissioningDateMA AS CommissioningDateMA
INTO InitialFixedAssetsInformation
FROM
	InitialInformationOS_SliceOfLatest AS SliceTable
		INNER JOIN InformationRegister.InitialFixedAssetsInformation AS RegisterTableAsOfDate
		ON (RegisterTableAsOfDate.Organization = SliceTable.Organization)
			AND (RegisterTableAsOfDate.FixedAsset = SliceTable.FixedAsset)
			AND (RegisterTableAsOfDate.Period = SliceTable.CutOffPeriodOfLatter)
			AND (RegisterTableAsOfDate.CorrectionDate = DATETIME(1,1,1))

INDEX BY
	FixedAsset,
	Organization,
	Period
;

////////////////////////////////////////////////////////////////////////////////
DROP InitialInformationOS_SliceOfLatest
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ParameterPeriods.Period AS Period,
	ParameterPeriods.ParameterPeriod AS ParameterPeriod,
	ParameterPeriods.FixedAsset AS FixedAsset,
	MAX(TableLastPeriod.Period) AS CutOffPeriodOfLatter
INTO AccountingProcedureForOS_Slices
FROM
	PeriodsOfACParameters AS ParameterPeriods
		INNER JOIN InformationRegister.FixedAssetsAccountingProcedure AS TableLastPeriod
		ON (TableLastPeriod.FixedAsset = ParameterPeriods.FixedAsset)
			AND (TableLastPeriod.Period &lt;= ParameterPeriods.ParameterPeriod)
			AND (TableLastPeriod.CorrectionDate = DATETIME(1,1,1))

GROUP BY
	ParameterPeriods.Period,
	ParameterPeriods.ParameterPeriod,
	ParameterPeriods.FixedAsset

INDEX BY
	FixedAsset,
	CutOffPeriodOfLatter
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SliceTable.Period AS Period,
	SliceTable.FixedAsset AS FixedAsset,
	RegisterTableAsOfDate.RunningTimeValue AS RunningTimeValue
INTO FixedAssetsAccountingProcedure
FROM
	AccountingProcedureForOS_Slices AS SliceTable
		INNER JOIN InformationRegister.FixedAssetsAccountingProcedure AS RegisterTableAsOfDate
		ON (RegisterTableAsOfDate.FixedAsset = SliceTable.FixedAsset)
			AND (RegisterTableAsOfDate.Period = SliceTable.CutOffPeriodOfLatter)
			AND (RegisterTableAsOfDate.CorrectionDate = DATETIME(1,1,1))

INDEX BY
	FixedAsset,
	Period
;

////////////////////////////////////////////////////////////////////////////////
DROP AccountingProcedureForOS_Slices
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Depreciation.Period AS Period,
	Depreciation.Organization AS Organization,
	Depreciation.FixedAsset AS FixedAsset,
	FixedAssetsAccountingProcedure.RunningTimeValue AS RunningTimeValue,
	ENDOFPERIOD(Depreciation.Period, MONTH) AS EndOfMonth,
	CASE
		WHEN MONTH(InitialFixedAssetsInformation.CommissioningDateMA) = MONTH(Depreciation.Period) - 1
			THEN TRUE
		ELSE FALSE
	END AS TakenIntoAccountLastMonth
INTO VT_OSList_Output
FROM
	TT_Depreciation AS Depreciation
		LEFT JOIN InitialFixedAssetsInformation AS InitialFixedAssetsInformation
		ON (InitialFixedAssetsInformation.Organization = Depreciation.Organization)
			AND (InitialFixedAssetsInformation.FixedAsset = Depreciation.FixedAsset)
			AND (InitialFixedAssetsInformation.Period = Depreciation.Period)
		LEFT JOIN FixedAssetsAccountingProcedure AS FixedAssetsAccountingProcedure
		ON (FixedAssetsAccountingProcedure.FixedAsset = Depreciation.FixedAsset)
			AND (FixedAssetsAccountingProcedure.Period = Depreciation.Period)
		LEFT JOIN FixedAssetDepreciationParametersManagementAccounting AS FixedAssetDepreciationParametersManagementAccounting
		ON (FixedAssetDepreciationParametersManagementAccounting.Organization = Depreciation.Organization)
			AND (FixedAssetDepreciationParametersManagementAccounting.FixedAsset = Depreciation.FixedAsset)
			AND (FixedAssetDepreciationParametersManagementAccounting.Period = Depreciation.Period)
WHERE
	FixedAssetDepreciationParametersManagementAccounting.DepreciationMethod = VALUE(Enum.AccrualMethodOfFixedAssetsDepreciation.ByUnitsOfProduction)

INDEX BY
	FixedAsset,
	RunningTimeValue
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ListOfFA.Period AS Period,
	BEGINOFPERIOD(ListOfFA.Period, MONTH) AS BegOfMonth,
	ListOfFA.FixedAsset AS FixedAsset,
	ListOfFA.RunningTimeValue AS RunningTimeValue
INTO VT_OSList_NotTakenIntoAccountLastMonth
FROM
	VT_OSList_Output AS ListOfFA
WHERE
	NOT ListOfFA.TakenIntoAccountLastMonth

INDEX BY
	FixedAsset,
	RunningTimeValue
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ListOfFA.Period AS Period,
	BEGINOFPERIOD(DATEADD(ListOfFA.Period, MONTH, -1), MONTH) AS BegOfMonth,
	ListOfFA.FixedAsset AS FixedAsset,
	ListOfFA.RunningTimeValue AS RunningTimeValue
INTO VT_OSList_TakenIntoAccountLastMonth
FROM
	VT_OSList_Output AS ListOfFA
WHERE
	ListOfFA.TakenIntoAccountLastMonth

INDEX BY
	FixedAsset,
	RunningTimeValue
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ParameterPeriods.Period AS Period,
	ParameterPeriods.FixedAsset AS FixedAsset,
	ParameterPeriods.RunningTimeValue AS RunningTimeValue,
	MAX(TableLastPeriod.Period) AS CutOffPeriodOfLatter
INTO OperatingTime_CutOfLast_AtBeginningOfMonth
FROM
	VT_OSList_NotTakenIntoAccountLastMonth AS ParameterPeriods
		INNER JOIN InformationRegister.AssetActivityRecords AS TableLastPeriod
		ON (TableLastPeriod.Asset = ParameterPeriods.FixedAsset)
			AND (TableLastPeriod.RunningTimeValue = ParameterPeriods.RunningTimeValue)
			AND (TableLastPeriod.Period &lt; ParameterPeriods.BegOfMonth)

GROUP BY
	ParameterPeriods.Period,
	ParameterPeriods.FixedAsset,
	ParameterPeriods.RunningTimeValue

INDEX BY
	FixedAsset,
	RunningTimeValue,
	CutOffPeriodOfLatter
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SliceTable.Period AS Period,
	SliceTable.FixedAsset AS FixedAsset,
	RegisterTableAsOfDate.RunningTimeValue AS RunningTimeValue,
	RegisterTableAsOfDate.Value AS OutputVolume
INTO VT_OS_ProductionAtBeginningOfMonth
FROM
	OperatingTime_CutOfLast_AtBeginningOfMonth AS SliceTable
		INNER JOIN InformationRegister.AssetActivityRecords AS RegisterTableAsOfDate
		ON (RegisterTableAsOfDate.Asset = SliceTable.FixedAsset)
			AND (RegisterTableAsOfDate.RunningTimeValue = SliceTable.RunningTimeValue)
			AND (RegisterTableAsOfDate.Period = SliceTable.CutOffPeriodOfLatter)

INDEX BY
	FixedAsset,
	RunningTimeValue,
	Period
;

////////////////////////////////////////////////////////////////////////////////
DROP OperatingTime_CutOfLast_AtBeginningOfMonth
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ParameterPeriods.Period AS Period,
	ParameterPeriods.FixedAsset AS FixedAsset,
	ParameterPeriods.RunningTimeValue AS RunningTimeValue,
	MAX(TableLastPeriod.Period) AS CutOffPeriodOfLatter
INTO OperatingTime_CutOfLast_AtEndOfMonth
FROM
	VT_OSList_Output AS ParameterPeriods
		INNER JOIN InformationRegister.AssetActivityRecords AS TableLastPeriod
		ON (TableLastPeriod.Asset = ParameterPeriods.FixedAsset)
			AND (TableLastPeriod.RunningTimeValue = ParameterPeriods.RunningTimeValue)
			AND (TableLastPeriod.Period &lt;= ParameterPeriods.EndOfMonth)

GROUP BY
	ParameterPeriods.Period,
	ParameterPeriods.FixedAsset,
	ParameterPeriods.RunningTimeValue

INDEX BY
	FixedAsset,
	RunningTimeValue,
	CutOffPeriodOfLatter
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SliceTable.Period AS Period,
	SliceTable.FixedAsset AS FixedAsset,
	RegisterTableAsOfDate.RunningTimeValue AS RunningTimeValue,
	RegisterTableAsOfDate.Value AS OutputVolume,
	ListOfFA.TakenIntoAccountLastMonth AS TakenIntoAccountLastMonth
INTO VT_OS_OutputAtEndOfMonth
FROM
	OperatingTime_CutOfLast_AtEndOfMonth AS SliceTable
		INNER JOIN InformationRegister.AssetActivityRecords AS RegisterTableAsOfDate
		ON (RegisterTableAsOfDate.Asset = SliceTable.FixedAsset)
			AND (RegisterTableAsOfDate.RunningTimeValue = SliceTable.RunningTimeValue)
			AND (RegisterTableAsOfDate.Period = SliceTable.CutOffPeriodOfLatter)
		LEFT JOIN VT_OSList_Output AS ListOfFA
		ON (ListOfFA.FixedAsset = SliceTable.FixedAsset)
			AND (ListOfFA.RunningTimeValue = SliceTable.RunningTimeValue)
			AND (ListOfFA.Period = SliceTable.Period)

INDEX BY
	FixedAsset,
	RunningTimeValue,
	Period
;

////////////////////////////////////////////////////////////////////////////////
DROP OperatingTime_CutOfLast_AtEndOfMonth
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ParameterPeriods.Period AS Period,
	ParameterPeriods.FixedAsset AS FixedAsset,
	ParameterPeriods.RunningTimeValue AS RunningTimeValue,
	MAX(TableLastPeriod.Period) AS CutOffPeriodOfLatter
INTO OperatingTime_CutOfLast_AtBeginningOfPreviousMonth
FROM
	VT_OSList_TakenIntoAccountLastMonth AS ParameterPeriods
		INNER JOIN InformationRegister.AssetActivityRecords AS TableLastPeriod
		ON (TableLastPeriod.Asset = ParameterPeriods.FixedAsset)
			AND (TableLastPeriod.RunningTimeValue = ParameterPeriods.RunningTimeValue)
			AND (TableLastPeriod.Period &lt; ParameterPeriods.BegOfMonth)

GROUP BY
	ParameterPeriods.Period,
	ParameterPeriods.FixedAsset,
	ParameterPeriods.RunningTimeValue

INDEX BY
	FixedAsset,
	RunningTimeValue,
	CutOffPeriodOfLatter
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SliceTable.Period AS Period,
	SliceTable.FixedAsset AS FixedAsset,
	RegisterTableAsOfDate.RunningTimeValue AS RunningTimeValue,
	RegisterTableAsOfDate.Value AS OutputVolume
INTO VT_OS_ProductionAtBeginningOfPreviousMonth
FROM
	OperatingTime_CutOfLast_AtBeginningOfPreviousMonth AS SliceTable
		INNER JOIN InformationRegister.AssetActivityRecords AS RegisterTableAsOfDate
		ON (RegisterTableAsOfDate.Asset = SliceTable.FixedAsset)
			AND (RegisterTableAsOfDate.RunningTimeValue = SliceTable.RunningTimeValue)
			AND (RegisterTableAsOfDate.Period = SliceTable.CutOffPeriodOfLatter)

INDEX BY
	FixedAsset,
	RunningTimeValue,
	Period
;

////////////////////////////////////////////////////////////////////////////////
DROP OperatingTime_CutOfLast_AtBeginningOfPreviousMonth
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ISNULL(OperatingTimePeriodStart.Period, OperatingTimePeriodEnd.Period) AS Period,
	ISNULL(OperatingTimePeriodStart.FixedAsset, OperatingTimePeriodEnd.FixedAsset) AS FixedAsset,
	ISNULL(OperatingTimePeriodEnd.OutputVolume, 0) - ISNULL(OperatingTimePeriodStart.OutputVolume, 0) AS OutputVolume,
	ISNULL(OperatingTimePeriodStart.OutputVolume, 0) AS OutputAtBeginningOfMonth
INTO TT_FAGeneration
FROM
	VT_OS_ProductionAtBeginningOfMonth AS OperatingTimePeriodStart
		FULL JOIN VT_OS_OutputAtEndOfMonth AS OperatingTimePeriodEnd
		ON OperatingTimePeriodStart.FixedAsset = OperatingTimePeriodEnd.FixedAsset
			AND OperatingTimePeriodStart.RunningTimeValue = OperatingTimePeriodEnd.RunningTimeValue
			AND OperatingTimePeriodStart.Period = OperatingTimePeriodEnd.Period
WHERE
	NOT OperatingTimePeriodEnd.TakenIntoAccountLastMonth

UNION ALL

SELECT
	ISNULL(OperatingTimePeriodStart.Period, OperatingTimePeriodEnd.Period),
	ISNULL(OperatingTimePeriodStart.FixedAsset, OperatingTimePeriodEnd.FixedAsset),
	ISNULL(OperatingTimePeriodEnd.OutputVolume, 0) - ISNULL(OperatingTimePeriodStart.OutputVolume, 0),
	0
FROM
	VT_OS_ProductionAtBeginningOfPreviousMonth AS OperatingTimePeriodStart
		FULL JOIN VT_OS_OutputAtEndOfMonth AS OperatingTimePeriodEnd
		ON OperatingTimePeriodStart.FixedAsset = OperatingTimePeriodEnd.FixedAsset
			AND OperatingTimePeriodStart.RunningTimeValue = OperatingTimePeriodEnd.RunningTimeValue
			AND OperatingTimePeriodStart.Period = OperatingTimePeriodEnd.Period
WHERE
	OperatingTimePeriodEnd.TakenIntoAccountLastMonth

INDEX BY
	FixedAsset,
	Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Depreciation.Period AS Period,
	Depreciation.Period AS ACPeriod,
	Depreciation.DepreciationCalculationDocument AS DepreciationCalculationDocument,
	Depreciation.Organization AS Organization,
	Depreciation.FixedAsset AS FixedAsset,
	Depreciation.DepreciationManagementAccounting AS DepreciationManagementAccounting,
	Depreciation.DepreciationInAccounting AS DepreciationInAccounting,
	InitialFixedAssetsInformation.DepreciationMethodAccounting AS DepreciationMethodAccounting,
	FixedAssetDepreciationParametersManagementAccounting.DepreciationMethod AS DepreciationAccrualMethodManagementAccounting,
	TT_FAGeneration.OutputVolume AS ACProduction,
	CASE
		WHEN FixedAssetDepreciationParametersManagementAccounting.UsefulLifeForCalculatingDepreciationMonth / 12 &lt; 1
			THEN 0
		ELSE CAST(FixedAssetDepreciationParametersManagementAccounting.UsefulLifeForCalculatingDepreciationMonth / 12 - 0.5 AS NUMBER(4, 0))
	END + CASE
		WHEN FixedAssetDepreciationParametersManagementAccounting.UsefulLifeForCalculatingDepreciationMonth / 12 - CASE
				WHEN FixedAssetDepreciationParametersManagementAccounting.UsefulLifeForCalculatingDepreciationMonth / 12 &lt; 1
					THEN 0
				ELSE CAST(FixedAssetDepreciationParametersManagementAccounting.UsefulLifeForCalculatingDepreciationMonth / 12 - 0.5 AS NUMBER(4, 0))
			END &gt; 0
			THEN 1
		ELSE 0
	END AS NumberOfYearsOfUseOfMa,
	CASE
		WHEN ((YEAR(Depreciation.Period) - YEAR(BEGINOFPERIOD(FixedAssetDepreciationParametersManagementAccounting.LastChangeDate, MONTH))) * 12 + MONTH(Depreciation.Period) - MONTH(BEGINOFPERIOD(FixedAssetDepreciationParametersManagementAccounting.LastChangeDate, MONTH))) / 12 &lt; 1
			THEN 0
		ELSE CAST(((YEAR(Depreciation.Period) - YEAR(BEGINOFPERIOD(FixedAssetDepreciationParametersManagementAccounting.LastChangeDate, MONTH))) * 12 + MONTH(Depreciation.Period) - MONTH(BEGINOFPERIOD(FixedAssetDepreciationParametersManagementAccounting.LastChangeDate, MONTH))) / 12 - 0.5 AS NUMBER(4, 0))
	END AS NumberOfPastMaYears,
	Depreciation.ResourceDevelopedOverPastPeriodMA AS ResourceDevelopedOverPastPeriodMA,
	Depreciation.LifeSpentPastPeriodAccounting AS LifeSpentPastPeriodAccounting,
	Depreciation.ResourceDevelopedForCurPeriodMA AS ResourceDevelopedForCurPeriodMA,
	Depreciation.LifeSpentCurrentPeriodAccounting AS LifeSpentCurrentPeriodAccounting,
	Depreciation.CostUsedToCalculateDepreciationInManagementAccounting AS CostUsedToCalculateDepreciationInManagementAccounting,
	Depreciation.CostUsedToCalculateDepreciationInAccounting AS CostUsedToCalculateDepreciationInAccounting,
	CASE
		WHEN Depreciation.ThisIsAnAdditionalAccrual
			THEN 0
		ELSE FixedAssetDepreciationParametersManagementAccounting.ResidualValueMan
	END AS ResidualValueMan,
	CASE
		WHEN Depreciation.ThisIsAdditionalChargeAccounting
			THEN 0
		ELSE OSBUDepreciationParameters.ResidualValueMan
	END AS ResidualValueLocal,
	FixedAssetDepreciationParametersManagementAccounting.VolumeOfProductsWorksForCalculatingDepreciationInPhysicalUnits AS ScopeOfProductionWorksToCalculateMaDepreciation,
	OSBUDepreciationParameters.VolumeOfProductsWorksForCalculatingDepreciationInPhysicalUnits AS VolumeOfProductionWorksForCalculatingDepreciationOfBU,
	FixedAssetDepreciationParametersManagementAccounting.UsefulLifeForCalculatingDepreciationMonth AS ThePeriodOfUseForCalculatingTheDepreciationOfTheUU,
	OSBUDepreciationParameters.UsefulLifeForCalculatingDepreciationMonth AS ThePeriodOfUseForCalculatingTheDepreciationOfTheBU,
	FixedAssetDepreciationParametersManagementAccounting.AccelerationFactor AS AccelerationFactorManagementAccounting,
	OSBUDepreciationParameters.AccelerationFactor AS AccelerationFactorAccounting,
	Depreciation.AccountingProcedureMA AS AccountingProcedureMA,
	Depreciation.DepreciationMethodVersionMA AS DepreciationMethodVersionMA,
	Depreciation.DepreciationMethodVersionLA AS DepreciationMethodVersionLA,
	Depreciation.ThisIsAnAdditionalAccrual AS ThisIsAnAdditionalAccrual,
	Depreciation.ThisIsAdditionalChargeAccounting AS ThisIsAdditionalChargeAccounting,
	CASE
		WHEN YEAR(FixedAssetDepreciationParametersManagementAccounting.LastChangeDate) &lt;&gt; YEAR(Depreciation.BegOfMonth)
			THEN 13 - MONTH(FixedAssetDepreciationParametersManagementAccounting.LastChangeDate) + 12 * (YEAR(Depreciation.BegOfMonth) - YEAR(FixedAssetDepreciationParametersManagementAccounting.LastChangeDate) - 1)
		ELSE 0
	END AS WorkedMonthsFullYears
FROM
	TT_Depreciation AS Depreciation
		LEFT JOIN Catalog.Assets AS Assets
		ON (Assets.Ref = Depreciation.FixedAsset)
		LEFT JOIN OSBUDepreciationParameters AS OSBUDepreciationParameters
		ON (OSBUDepreciationParameters.Period = Depreciation.Period)
			AND (OSBUDepreciationParameters.FixedAsset = Depreciation.FixedAsset)
			AND (OSBUDepreciationParameters.Organization = Depreciation.Organization)
		LEFT JOIN FixedAssetDepreciationParametersManagementAccounting AS FixedAssetDepreciationParametersManagementAccounting
		ON (FixedAssetDepreciationParametersManagementAccounting.Period = Depreciation.Period)
			AND (FixedAssetDepreciationParametersManagementAccounting.FixedAsset = Depreciation.FixedAsset)
			AND (FixedAssetDepreciationParametersManagementAccounting.Organization = Depreciation.Organization)
		LEFT JOIN InitialFixedAssetsInformation AS InitialFixedAssetsInformation
		ON (InitialFixedAssetsInformation.Period = Depreciation.Period)
			AND (InitialFixedAssetsInformation.FixedAsset = Depreciation.FixedAsset)
			AND (InitialFixedAssetsInformation.Organization = Depreciation.Organization)
		LEFT JOIN TT_FAGeneration AS TT_FAGeneration
		ON (TT_FAGeneration.Period = Depreciation.Period)
			AND (TT_FAGeneration.FixedAsset = Depreciation.FixedAsset)</query>
	</dataSet>
	<totalField>
		<dataPath>DepreciationInAccounting</dataPath>
		<expression>Sum(DepreciationInAccounting)</expression>
	</totalField>
	<totalField>
		<dataPath>DepreciationManagementAccounting</dataPath>
		<expression>Sum(DepreciationManagementAccounting)</expression>
	</totalField>
	<totalField>
		<dataPath>ACProduction</dataPath>
		<expression>Max(ACProduction)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>ResourceDevelopedOverPastPeriodMA</dataPath>
		<expression>Max(ResourceDevelopedOverPastPeriodMA)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>ResourceDevelopedForCurPeriodMA</dataPath>
		<expression>Max(ResourceDevelopedForCurPeriodMA)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>ThePeriodOfUseForCalculatingTheDepreciationOfTheUU</dataPath>
		<expression>Max(ThePeriodOfUseForCalculatingTheDepreciationOfTheUU)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>CostUsedToCalculateDepreciationInManagementAccounting</dataPath>
		<expression>Max(CostUsedToCalculateDepreciationInManagementAccounting)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>ScopeOfProductionWorksToCalculateMaDepreciation</dataPath>
		<expression>Max(ScopeOfProductionWorksToCalculateMaDepreciation)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>AccelerationFactorManagementAccounting</dataPath>
		<expression>Max(AccelerationFactorManagementAccounting)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>WorkedMonthsFullYears</dataPath>
		<expression>Max(WorkedMonthsFullYears)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>NumberOfYearsOfUseOfMa</dataPath>
		<expression>Max(NumberOfYearsOfUseOfMa)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>NumberOfPastMaYears</dataPath>
		<expression>Max(NumberOfPastMaYears)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>CostUsedToCalculateDepreciationInAccounting</dataPath>
		<expression>Max(CostUsedToCalculateDepreciationInAccounting)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>ResidualValueLocal</dataPath>
		<expression>Max(ResidualValueLocal)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>LifeSpentCurrentPeriodAccounting</dataPath>
		<expression>Max(LifeSpentCurrentPeriodAccounting)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>LifeSpentPastPeriodAccounting</dataPath>
		<expression>Max(LifeSpentPastPeriodAccounting)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>AccelerationFactorAccounting</dataPath>
		<expression>Max(AccelerationFactorAccounting)</expression>
		<group>Period</group>
		<group>ACPeriod</group>
	</totalField>
	<totalField>
		<dataPath>ThePeriodOfUseForCalculatingTheDepreciationOfTheBU</dataPath>
