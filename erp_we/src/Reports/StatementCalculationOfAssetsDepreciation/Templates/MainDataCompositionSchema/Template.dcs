		<field xsi:type="DataSetFieldField">
			<dataPath>Period</dataPath>
			<field>Period</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период (упр)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem (yönetim)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Case When ThisIsAnAdditionalAccrual Then Format(Period, "DLF=D") + " " + NStr("ru = '(доначисление)'; vi = '(tính bổ sung)'; en = '(additional accrual)'; it = '(maturazione aggiuntiva)'; pl = '(doliczenie)'; tr = '(hesap öncesi)'") Else Format(Period, "DLF=D") End</presentationExpression>
		</field>
