					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Depreciation calculation formula:
( [1] - [2] ) * [3] * [4] / ( [5] - [6] + [4] -1 )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>فرمول محاسبه استهلاک:
( [1] - [2] ) * [3] * [4] / ( [5] - [6] + [4] -1 )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Формула расчета амортизации:
( [1] - [2] ) * [3] * [4] / ( [5] - [6] + [4] -1 )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Amortisman hesaplama formülü:
( [1] - [2] ) * [3] * [4] / ( [5] - [6] + [4] -1 )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Depreciation calculation formula:
( [1] - [2] ) * [3] * [4] / ( [5] - [6] + [4] -1 )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Depreciation calculation formula:
( [1] - [2] ) * [3] * [4] / ( [5] - [6] + [4] -1 )</v8:content>
							</v8:item>
							<v8:item>
