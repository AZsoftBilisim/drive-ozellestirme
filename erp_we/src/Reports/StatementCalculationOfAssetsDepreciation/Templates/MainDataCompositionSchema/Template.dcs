	<template>
		<name>Template11</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Declining balance</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>مانده نزولی</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Del residuo ridotto</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Zmniejszanego ostatku</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Уменьшаемого остатка (управленческий учет)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Azalan bakiyenin (yönetim muhasebesi)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Số dư giảm dần</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Font</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="14" bold="false" italic="false" underline="false" strikeout="false" kind="Absolute" scale="100"/>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>Placement</dcscor:parameter>
							<dcscor:value xsi:type="dcscor:DataCompositionTextPlacementType">Wrap</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>MinWidth</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">86.75</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>MaxWidth</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">86.75</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Depreciation calculation formula:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (last year of use)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>فرمول محاسبه استهلاک:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (آخرین سال استفاده)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Formula di calcolo dell'ammortamento:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (nell'ultimo anno di utilizzo)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Wzór obliczenia amortyzacji:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (w ostatnim roku korzystania)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Формула расчета амортизации:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (в последний год использования)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Amortisman hesaplama formülü: 
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (son kullanım yılında)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Công thức tính khấu hao:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (trong năm sử dụng cuối cùng)</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Font</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="10" bold="false" italic="false" underline="false" strikeout="false" kind="Absolute" scale="100"/>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>where [1, 2, 3, 4, 5, 6, 7] are numbers of columns</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>که در آن [1, 2, 3, 4, 5, 6, 7] شماره ستون‌ها هستند</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
