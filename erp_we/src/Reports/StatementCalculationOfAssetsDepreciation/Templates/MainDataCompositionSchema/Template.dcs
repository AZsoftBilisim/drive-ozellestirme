					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>where [1, 2, 3, 4, 5] - numbers of columns</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>که در آن [1, 2, 3, 4, 5] شماره ستون‌ها هستند</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>dove [1, 2, 3, 4, 5] - numeri di colonne</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>gdzie [1, 2, 3, 4, 5] - numery kolumn</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>где [1, 2, 3, 4, 5] - номера колонок</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>buradaki [1, 2, 3, 4, 5] sütun numaralarıdır</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>trong đó [1, 2, 3, 4, 5] là số cột</v8:content>
							</v8:item>
