		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DepreciationMethodAccounting</dataPath>
			<field>DepreciationMethodAccounting</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Depreciation charge method (local)</v8:content>
				</v8:item>
