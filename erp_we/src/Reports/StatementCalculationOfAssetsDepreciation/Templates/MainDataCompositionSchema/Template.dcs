	<template>
		<name>Template2</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>By asset activity measure (local accounting)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>بر اساس معیار فعالیت دارایی (حسابداری محلی)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Per sviluppo (contabilità)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Wg ilości wykonanej pracy (ewidencja księgowa)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>По наработке (бухгалтерский учет)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>İş başında (muhasebe)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Theo sản lượng (kế toán doanh nghiệp)</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Font</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="14" bold="false" italic="false" underline="false" strikeout="false" kind="Absolute" scale="100"/>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>Placement</dcscor:parameter>
							<dcscor:value xsi:type="dcscor:DataCompositionTextPlacementType">Wrap</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>MinWidth</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">86.75</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>MaxWidth</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">86.75</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Depreciation calculation formula: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>فرمول محاسبه استهلاک: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Formula di calcolo dell'ammortamento: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Wzór rozliczenia amortyzacji: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Формула расчета амортизации: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Amortisman hesaplama formülü: ([1] -[2]) * [3] / ([4] - [5])</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Công thức tính khấu hao: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Font</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="10" bold="false" italic="false" underline="false" strikeout="false" kind="Absolute" scale="100"/>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>where [1, 2, 3, 4, 5] - numbers of columns</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>که در آن [1, 2, 3, 4, 5] شماره ستون‌ها هستند</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>dove [1, 2, 3, 4, 5] - numeri di colonne</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>gdzie [1, 2, 3, 4, 5] - numery kolumn</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>где [1, 2, 3, 4, 5] - номера колонок</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>buradaki [1, 2, 3, 4, 5] sütun numaralarıdır</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>trong đó [1, 2, 3, 4, 5] là số cột</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Font</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="8" bold="false" italic="true" underline="false" strikeout="false" kind="Absolute" scale="100"/>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
	</template>
	<template>
		<name>Template3</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Declining balance (local accounting)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>مانده نزولی (حسابداری محلی)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Saldo da ridurre (contabilità)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Zmniejszanego stanu (ewidencja księgowa)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Уменьшаемого остатка (бухгалтерский учет)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Azalan bakiyenin (muhasebe)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Số dư giảm dần (kế toán doanh nghiệp)</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Font</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="14" bold="false" italic="false" underline="false" strikeout="false" kind="Absolute" scale="100"/>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>Placement</dcscor:parameter>
							<dcscor:value xsi:type="dcscor:DataCompositionTextPlacementType">Wrap</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>MinWidth</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">86.75</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>MaxWidth</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">86.75</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Depreciation calculation formula:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (last year of use)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>فرمول محاسبه استهلاک:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (آخرین سال استفاده)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Formula di calcolo dell'ammortamento:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (nell'ultimo anno di utilizzo)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Wzór obliczenia amortyzacji:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (w ostatnim roku korzystania)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Формула расчета амортизации:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (в последний год использования)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Amortisman hesaplama formülü: 
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (son kullanım yılında)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Công thức tính khấu hao:
[1] * [3] * [4] / ( [5] - [4] * ( [6] - [7] ) )
( [1] - [2] ) * [3] / ( [5] - [6] ) (vào năm cuối cùng sử dụng)</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Font</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="10" bold="false" italic="false" underline="false" strikeout="false" kind="Absolute" scale="100"/>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>where [1, 2, 3, 4, 5, 6, 7] are numbers of columns</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>که در آن [1, 2, 3, 4, 5, 6, 7] شماره ستون‌ها هستند</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>dove [1, 2, 3, 4, 5, 6, 7] sono i numeri delle colonne</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>gdzie [1, 2, 3, 4, 5, 6, 7] - numery kolumn</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>где [1, 2, 3, 4, 5, 6, 7] - номера колонок</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>buradaki [1, 2, 3, 4, 5, 6, 7] sütun numaralarıdır</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>trong đó [1, 2, 3, 4, 5, 6, 7] là số cột</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Font</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="8" bold="false" italic="true" underline="false" strikeout="false" kind="Absolute" scale="100"/>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
	</template>
	<template>
		<name>Template7</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="dcscor:Parameter">Period</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Details</dcscor:parameter>
							<dcscor:value xsi:type="dcscor:Parameter">DepreciationCalculationDocument</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>Period</dcsat:name>
			<dcsat:expression>Case When ThisIsAnAdditionalAccrual Then Format(Period, "DLF=D") + " " + NStr("ru = '(доначисление)'; vi = '(tính bổ sung)'; en = '(additional amortization charge)'; it = '(additional amortization charge)'; pl = '(additional amortization charge)'; tr = '(hesap öncesi)'") Else Format(Period, "DLF=D") End</dcsat:expression>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:DetailsAreaTemplateParameter">
			<dcsat:name>DepreciationCalculationDocument</dcsat:name>
			<dcsat:fieldExpression>
				<dcsat:field>DepreciationCalculationDocument</dcsat:field>
				<dcsat:expression>DepreciationCalculationDocument</dcsat:expression>
			</dcsat:fieldExpression>
			<dcsat:mainAction>OpenValue</dcsat:mainAction>
		</parameter>
	</template>
	<template>
		<name>Template8</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="dcscor:Parameter">ACPeriod</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>Details</dcscor:parameter>
							<dcscor:value xsi:type="dcscor:Parameter">DepreciationCalculationDocument</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
			</dcsat:item>
		</template>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:DetailsAreaTemplateParameter">
			<dcsat:name>DepreciationCalculationDocument</dcsat:name>
			<dcsat:fieldExpression>
				<dcsat:field>DepreciationCalculationDocument</dcsat:field>
				<dcsat:expression>DepreciationCalculationDocument</dcsat:expression>
			</dcsat:fieldExpression>
			<dcsat:mainAction>OpenValue</dcsat:mainAction>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>ACPeriod</dcsat:name>
			<dcsat:expression>Case When ThisIsAdditionalChargeAccounting Then Format(ACPeriod, "DLF=D") + " " + NStr("ru = '(доначисление)'; vi = '(tính bổ sung)'; en = '(additional amortization charge)'; it = '(additional amortization charge)'; pl = '(additional amortization charge)'; tr = '(hesap öncesi)'") Else Format(ACPeriod, "DLF=D") End</dcsat:expression>
		</parameter>
	</template>
	<template>
		<name>Template12</name>
