			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Depreciation calculation formula: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>فرمول محاسبه استهلاک: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Formula di calcolo dell'ammortamento: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Wzór rozliczenia amortyzacji: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Формула расчета амортизации: ( [1] - [2] ) * [3] / ( [4] - [5] )</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Amortisman hesaplama formülü: ([1] -[2]) * [3] / ([4] - [5])</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Công thức tính khấu hao: ([1] - [2]) * [3] / ([4] - [5])</v8:content>
							</v8:item>
						</dcsat:value>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
