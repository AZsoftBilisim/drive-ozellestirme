		<field xsi:type="DataSetFieldField">
			<dataPath>BudgetingStep</dataPath>
			<field>BudgetingStep</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Budgeting step</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مرحله بودجه‌بندی</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Fase di preparazione dei bilanci</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Etap przygotowania budżetów</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Этап подготовки бюджетов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Bütçe hazırlama aşaması</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Giai đoạn chuẩn bị ngân sách</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	BudgetTask.BudgetingModel,
	BudgetTask.BudgetingStep,
	BudgetTask.CompletionDate,
	BudgetTask.TaskDueDate,
	BudgetTask.Ref AS Task,
	BudgetTask.Number,
	BudgetTask.Date,
	BudgetTask.Executed,
	BudgetTask.Period,
	BudgetTask.Performer,
	1 AS TaskCount,
	CASE
		WHEN BudgetTask.Executed
				AND (BudgetTask.TaskDueDate &gt;= BudgetTask.CompletionDate
					OR BudgetTask.TaskDueDate = "00010101")
			THEN 1
		ELSE 0
	END AS OnTime,
	CASE
		WHEN BudgetTask.Executed
				AND BudgetTask.TaskDueDate &lt; BudgetTask.CompletionDate
				AND BudgetTask.TaskDueDate &lt;&gt; "00010101"
			THEN 1
		ELSE 0
	END AS NotOnTime,
	CASE
		WHEN BudgetTask.Executed
			THEN 1
		ELSE 0
	END AS Completed2,
	CASE
		WHEN NOT BudgetTask.Executed
			THEN 1
		ELSE 0
	END AS NotCompleted,
	CASE
		WHEN NOT BudgetTask.Executed
				AND (BudgetTask.TaskDueDate &gt;= &amp;CurrentDate
					OR BudgetTask.TaskDueDate = "00010101")
			THEN 1
		ELSE 0
	END AS IsRunning,
	CASE
		WHEN NOT BudgetTask.Executed
				AND BudgetTask.TaskDueDate &lt; &amp;CurrentDate
				AND BudgetTask.TaskDueDate &lt;&gt; "00010101"
			THEN 1
		ELSE 0
	END AS Overdue1,
	CASE
		WHEN BudgetTask.Executed
				AND BudgetTask.TaskDueDate &lt; BudgetTask.CompletionDate
			THEN DATEDIFF(BudgetTask.TaskDueDate, BudgetTask.CompletionDate, DAY)
		WHEN NOT BudgetTask.Executed
				AND BudgetTask.TaskDueDate &lt; &amp;CurrentDate
			THEN DATEDIFF(BudgetTask.TaskDueDate, &amp;CurrentDate, DAY)
	END AS AverageDelayDays
FROM
	Task.BudgetTask AS BudgetTask
WHERE
	NOT BudgetTask.DeletionMark
	AND CASE
			WHEN &amp;DisplayOnlySubordinateTasks
				THEN NOT 1 IN
							(SELECT TOP 1
								1
							FROM
								Task.BudgetTask AS Filter
							WHERE
								Filter.MainTask_ = BudgetTask.Ref)
			ELSE TRUE
		END
	AND CASE
			WHEN &amp;BeginOfPeriod &lt;&gt; DATETIME(1, 1, 1)
				THEN BudgetTask.Date &gt;= &amp;BeginOfPeriod
			ELSE TRUE
		END
	AND CASE
			WHEN &amp;EndOfPeriod &lt;&gt; DATETIME(1, 1, 1)
				THEN BudgetTask.Date &lt;= ENDOFPERIOD(&amp;EndOfPeriod, DAY)
			ELSE TRUE
		END</query>
	</dataSet>
