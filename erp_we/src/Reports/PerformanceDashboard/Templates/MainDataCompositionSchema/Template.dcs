		</availableValue>
		<availableValue>
			<value xsi:type="xs:decimal">5</value>
		</availableValue>
		<availableValue>
			<value xsi:type="xs:decimal">6</value>
		</availableValue>
		<availableValue>
			<value xsi:type="xs:decimal">7</value>
		</availableValue>
		<availableValue>
			<value xsi:type="xs:decimal">8</value>
		</availableValue>
