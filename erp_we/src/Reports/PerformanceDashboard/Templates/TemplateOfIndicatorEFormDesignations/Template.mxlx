					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Indicator state check boxes</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>کادرهای وضعیت شاخص</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Stati di flag degli indici</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Flagi stanów wskaźników</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Флажки состояний показателей</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Gösterge durumu onay işaretleri</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Ô tích trạng thái chỉ tiêu</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
