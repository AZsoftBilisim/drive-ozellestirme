					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Interpretation examples</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>مثال‌های تفسیر</v8:content>
						</v8:item>
						<v8:item>
