    </title>
    <title>
      <key>vi</key>
      <value>Bảng điều khiển</value>
    </title>
    <id>19</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Dashboards.DeletionMark</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Dashboards.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogPerformanceDashboards.Ref AS Ref,
	CatalogPerformanceDashboards.DeletionMark AS DeletionMark,
	CatalogPerformanceDashboards.Description AS Description,
	CatalogPerformanceDashboards.AddlOrderingAttribute AS AddlOrderingAttribute,
	CAST(&quot;&quot; AS STRING(200)) AS Icon
FROM
	Catalog.PerformanceDashboards AS CatalogPerformanceDashboards
WHERE
	CatalogPerformanceDashboards.Author = &amp;CurrentUser
	AND CatalogPerformanceDashboards.AuthorOnly

UNION ALL

SELECT
	PerformanceDashboards.Ref,
	PerformanceDashboards.DeletionMark,
	PerformanceDashboards.Description,
	PerformanceDashboards.AddlOrderingAttribute,
	CAST(&quot;&quot; AS STRING(200))
FROM
	Catalog.PerformanceDashboards.DashboardUser AS PerformanceDashboardsDashboardUser
		INNER JOIN Catalog.PerformanceDashboards AS PerformanceDashboards
		ON PerformanceDashboardsDashboardUser.Ref = PerformanceDashboards.Ref
			AND (PerformanceDashboardsDashboardUser.User = &amp;CurrentUser)</queryText>
      <mainTable>Catalog.PerformanceDashboards</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
