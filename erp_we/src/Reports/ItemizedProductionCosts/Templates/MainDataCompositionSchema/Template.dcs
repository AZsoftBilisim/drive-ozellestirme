	<settingsVariant>
		<dcsset:name>MovementOfItemizedExpenses</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Movement of itemized expenses by companies</v8:content>
