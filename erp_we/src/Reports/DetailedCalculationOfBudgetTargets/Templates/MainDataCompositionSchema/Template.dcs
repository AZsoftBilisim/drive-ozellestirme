							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Rule</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>قاعده</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Regola</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Reguła</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Правило</v8:content>
