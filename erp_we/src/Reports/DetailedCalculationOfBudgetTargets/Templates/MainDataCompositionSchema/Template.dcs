								<v8:content>Quy tắc</v8:content>
							</v8:item>
						</title>
					</field>
					<dataSource>DataSource1</dataSource>
					<query>SELECT
	ActualDataQueryRulesByBudgetBalanceItems.BudgetBalanceItem AS BudgetBalanceItem,
	ActualDataQueryRulesByBudgetBalanceItems.DataSource AS DataSource,
	ActualDataQueryRulesByBudgetBalanceItems.TotalType AS TotalType,
	ActualDataQueryRulesByBudgetBalanceItems.FilterPresentation AS Filter,
	ActualDataQueryRulesByBudgetBalanceItems.DataSourceSection AS DataSourceSection,
	ActualDataQueryRulesByBudgetBalanceItems.Ref AS Rule
{SELECT
	DataSourceSection.*,
	BudgetBalanceItem.*,
	DataSource.*,
	TotalType.*,
	Filter,
	Rule.*}
FROM
	Catalog.ActualDataQueryRulesByBudgetBalanceItems AS ActualDataQueryRulesByBudgetBalanceItems
{WHERE
	ActualDataQueryRulesByBudgetBalanceItems.BudgetBalanceItem.* AS BudgetBalanceItem}</query>
					<autoFillFields>false</autoFillFields>
				</item>
			</dataSet>
			<calculatedField>
				<dataPath>OpeningBalance</dataPath>
				<expression>Case When &amp;Factor = "Count" Then Count Else Sum End</expression>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
