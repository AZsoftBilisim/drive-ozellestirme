						<dcscor:parameter>MinWidth</dcscor:parameter>
						<dcscor:value xsi:type="xs:decimal">16</dcscor:value>
					</dcscor:item>
				</appearance>
			</calculatedField>
			<calculatedField>
				<dataPath>Group</dataPath>
				<expression>""</expression>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Grouping</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>گروه‌بندی</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Raggruppamento</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Grupowanie</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Группировка</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Gruplama</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Gom nhóm</v8:content>
					</v8:item>
				</title>
			</calculatedField>
			<totalField>
				<dataPath>StartBalanceAccordingToRules</dataPath>
				<expression>Sum(StartBalanceAccordingToRules)</expression>
			</totalField>
			<totalField>
				<dataPath>FinalRemainderByRules</dataPath>
				<expression>Sum(FinalRemainderByRules)</expression>
			</totalField>
			<totalField>
				<dataPath>FinalBalanceOnTurnoverOfArticles</dataPath>
				<expression>IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(Turnover),0)</expression>
			</totalField>
			<totalField>
				<dataPath>Deviation</dataPath>
				<expression>IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(Turnover),0) - IsNull(Sum(FinalRemainderByRules),0)</expression>
			</totalField>
			<totalField>
				<dataPath>VariancePercentage</dataPath>
				<expression>Case 
    When IsNull(Sum(FinalRemainderByRules),0) = 0 And (IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(Turnover),0)) = 0
    	Then 0
    When IsNull(Sum(FinalRemainderByRules),0) = 0 
        Then 1
    When (IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(Turnover),0) - IsNull(Sum(FinalRemainderByRules),0)) / Sum(FinalRemainderByRules) &lt; 0
        Then -(IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(Turnover),0) - IsNull(Sum(FinalRemainderByRules),0)) / Sum(FinalRemainderByRules)
    Else (IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(Turnover),0) - IsNull(Sum(FinalRemainderByRules),0)) / Sum(FinalRemainderByRules)
End * 100</expression>
			</totalField>
