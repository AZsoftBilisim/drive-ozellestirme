			<dataSet xsi:type="DataSetQuery">
				<name>CalculationsRules</name>
				<field xsi:type="DataSetFieldField">
					<dataPath>BudgetBalanceItem</dataPath>
					<field>BudgetBalanceItem</field>
					<title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Budget balance item</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>قلم مانده بودجه</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Indice dei bilanci</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Wskaźnik budżetowy</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Показатель бюджетов</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Bütçe kalemi</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Chỉ tiêu ngân sách</v8:content>
						</v8:item>
					</title>
					<useRestriction>
						<field>true</field>
						<group>true</group>
						<order>true</order>
					</useRestriction>
					<attributeUseRestriction>
						<field>true</field>
						<group>true</group>
						<order>true</order>
					</attributeUseRestriction>
					<role>
						<dcscom:dimension>true</dcscom:dimension>
					</role>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>Expense</dataPath>
					<field>Expense</field>
					<title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Expense</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>هزینه</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Uscita</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Rozchód</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Расход</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Çıkış</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Chi</v8:content>
						</v8:item>
					</title>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>BudgetFlowItem</dataPath>
					<field>BudgetFlowItem</field>
					<title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Budget flow item</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>قلم جریان بودجه</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Voce di bilanci</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Pozycja budżetowa</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Статья бюджетов</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Bütçe akış öğesi</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Khoản mục ngân sách</v8:content>
						</v8:item>
					</title>
					<role>
						<dcscom:dimension>true</dcscom:dimension>
					</role>
				</field>
				<dataSource>DataSource1</dataSource>
				<query>SELECT
	CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems) AS BudgetBalanceItem,
	CAST(CalculationsRules.Source AS Catalog.BudgetFlowItems) AS BudgetFlowItem,
	MAX(CalculationRulesDataCalculationSettings.ReverseSign) AS Expense
{SELECT
	BudgetBalanceItem.*,
	BudgetFlowItem.*,
	Expense}
FROM
	Catalog.RuleForCalculatingRelatedBudgetBalancesAndTurnovers AS CalculationsRules
		INNER JOIN Catalog.RuleForCalculatingRelatedBudgetBalancesAndTurnovers.DataCalculationSettings AS CalculationRulesDataCalculationSettings
		ON CalculationsRules.Ref = CalculationRulesDataCalculationSettings.Ref
{WHERE
	(CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems)).* AS BudgetBalanceItem}

GROUP BY
	CAST(CalculationsRules.Receiver AS Catalog.BudgetBalanceItems),
	CAST(CalculationsRules.Source AS Catalog.BudgetFlowItems)</query>
				<autoFillFields>false</autoFillFields>
			</dataSet>
