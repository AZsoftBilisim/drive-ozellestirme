				<dataSource>DataSource1</dataSource>
				<query>SELECT
	ActualDataQueryRulesByBudgetFlowItems.BudgetFlowItem AS BudgetFlowItem,
	ActualDataQueryRulesByBudgetFlowItems.DataSource AS DataSource,
	ActualDataQueryRulesByBudgetFlowItems.TransactionAmountSource AS TransactionAmountSource,
	ActualDataQueryRulesByBudgetFlowItems.CorDataSource AS BalancedAccount,
	ActualDataQueryRulesByBudgetFlowItems.DataSourceSection AS DataSourceSection,
	ActualDataQueryRulesByBudgetFlowItems.FilterPresentation AS Filter,
	ActualDataQueryRulesByBudgetFlowItems.TotalType AS TotalType, 
	ActualDataQueryRulesByBudgetFlowItems.Ref AS Rule
{SELECT
	BudgetFlowItem.*,
	DataSource.*,
	TransactionAmountSource.*,
	BalancedAccount.*,
	DataSourceSection.*,
	Filter,
	TotalType.*,
	Rule.*}
FROM
	Catalog.ActualDataQueryRulesByBudgetFlowItems AS ActualDataQueryRulesByBudgetFlowItems</query>
				<autoFillFields>false</autoFillFields>
