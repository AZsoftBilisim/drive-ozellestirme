			<calculatedField>
				<dataPath>Turnover</dataPath>
				<expression>Case When &amp;Factor = "Count" Then IsNull(CountReceipt,0) - IsNull(CountExpense,0) Else IsNull(SumReceipt,0) - IsNull(SumExpense,0) End</expression>
