	<calculatedField>
		<dataPath>ArticleAnalytics</dataPath>
		<expression>Cast(Presentation(AssetRef), "String") + Case When Cast(Presentation(Dimension), "String") = "" Then " " + NStr("ru = '(без аналитики)'; vi = '(không có đối tượng phân tích)'; en = '(without dimension)'; it = '(senza analitica)'; pl = '(bez analityki)'; tr = '(boyut olmadan)'") Else ", " + Cast(Presentation(Dimension), "String") End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Item and dimension of reserve use</v8:content>
