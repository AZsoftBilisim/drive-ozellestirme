			<dataPath>SecondPeriod</dataPath>
			<field>SecondPeriod</field>
			<role>
				<dcscom:periodNumber>2</dcscom:periodNumber>
				<dcscom:periodType>Additional</dcscom:periodType>
				<dcscom:required>true</dcscom:required>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	FutureExpenseCommitmentsBalanceAndTurnovers.Organization AS Organization,
	FutureExpenseCommitmentsBalanceAndTurnovers.ReserveKind AS ReserveKind,
	FutureExpenseCommitmentsBalanceAndTurnovers.ProvisionObject AS ProvisionObject,
	CASE
		WHEN &amp;ReportData = 0
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplOpeningBalance
		WHEN &amp;ReportData = 2
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFAOpeningBalance
		ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManOpeningBalance
	END AS SumOpeningBalance,
	CASE
		WHEN &amp;ReportData = 0
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplClosingBalance
		WHEN &amp;ReportData = 2
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFAClosingBalance
		ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManClosingBalance
	END AS SumClosingBalance,
	CASE
		WHEN &amp;ReportData = 0
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplReceipt
		WHEN &amp;ReportData = 2
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFAReceipt
		ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManReceipt
	END AS WrittenOff,
	CASE
		WHEN &amp;ReportData = 0
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplExpense
		WHEN &amp;ReportData = 2
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFAExpense
		ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManExpense
	END AS Accrued,
	CASE
		WHEN &amp;ReportData = 0
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplTurnover
		WHEN &amp;ReportData = 2
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFATurnover
		ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManTurnover
	END AS Sum,
	FutureExpenseCommitmentsBalanceAndTurnovers.Recorder AS Recorder,
	FutureExpenseCommitmentsBalanceAndTurnovers.SecondPeriod AS SecondPeriod
{SELECT
	Organization.*,
	ReserveKind.*,
	ProvisionObject.*,
	SumOpeningBalance,
	SumClosingBalance,
	WrittenOff,
	Accrued}
FROM
	AccumulationRegister.FutureExpenseCommitments.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, RegisterRecordsAndPeriodBoundaries, ) AS FutureExpenseCommitmentsBalanceAndTurnovers
{WHERE
	FutureExpenseCommitmentsBalanceAndTurnovers.Organization.*,
	FutureExpenseCommitmentsBalanceAndTurnovers.ReserveKind.*,
	FutureExpenseCommitmentsBalanceAndTurnovers.ProvisionObject.*,
	(CASE
			WHEN &amp;ReportData = 0
				THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplOpeningBalance
			WHEN &amp;ReportData = 2
				THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFAOpeningBalance
			ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManOpeningBalance
		END) AS SumOpeningBalance,
	(CASE
			WHEN &amp;ReportData = 0
				THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplClosingBalance
			WHEN &amp;ReportData = 2
				THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFAClosingBalance
			ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManClosingBalance
		END) AS SumClosingBalance,
	(CASE
		WHEN &amp;ReportData = 0
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplReceipt
		WHEN &amp;ReportData = 2
			THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFAReceipt
		ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManReceipt
	END) AS WrittenOff,
	(CASE
			WHEN &amp;ReportData = 0
				THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplExpense
			WHEN &amp;ReportData = 2
				THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFAExpense
			ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManExpense
		END) AS Accrued,
	(CASE
			WHEN &amp;ReportData = 0
				THEN FutureExpenseCommitmentsBalanceAndTurnovers.SumComplTurnover
			WHEN &amp;ReportData = 2
				THEN FutureExpenseCommitmentsBalanceAndTurnovers.AmountFATurnover
			ELSE FutureExpenseCommitmentsBalanceAndTurnovers.SumManTurnover
		END) AS Sum,
	FutureExpenseCommitmentsBalanceAndTurnovers.Recorder.*}</query>
	</dataSet>
