				<v8:lang>vi</v8:lang>
				<v8:content>Dạng và đối tượng phân tích sử dụng cho dự phòng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:string</v8:Type>
			<v8:StringQualifiers>
				<v8:Length>0</v8:Length>
				<v8:AllowedLength>Variable</v8:AllowedLength>
			</v8:StringQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>Used_</dataPath>
		<expression>Sum(Used_)</expression>
	</totalField>
