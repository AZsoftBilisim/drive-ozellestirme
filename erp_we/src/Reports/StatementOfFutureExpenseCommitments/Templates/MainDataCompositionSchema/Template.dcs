				</v8:item>
			</title>
			<role>
				<dcscom:periodNumber>2</dcscom:periodNumber>
				<dcscom:periodType>Additional</dcscom:periodType>
				<dcscom:required>true</dcscom:required>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	OtherExpenses.Organization AS Organization,
	OtherExpenses.AdjReserveKind AS ReserveKind,
	OtherExpenses.CorProvisionObject AS ProvisionObject,
	OtherExpenses.ExpenseItem AS AssetRef,
	OtherExpenses.DimensionOfExpenses AS Dimension,
	OtherExpenses.LineOfBusiness AS LineOfBusiness,
	OtherExpenses.Department AS Department,
	CASE
		WHEN &amp;ReportData = 0
			THEN OtherExpenses.SumCompl
		WHEN &amp;ReportData = 2
			THEN OtherExpenses.SumCompl - OtherExpenses.PermanentDifference - OtherExpenses.CostTD
		ELSE OtherExpenses.SumMan
	END AS Used_,
	OtherExpenses.Recorder AS Recorder,
	OtherExpenses.Period AS SecondPeriod
{SELECT
	Organization.*,
	ReserveKind.*,
	ProvisionObject.*,
	AssetRef.*,
	Dimension.*,
	LineOfBusiness.*,
	Department.*,
	Used_,
	Recorder.*,
	SecondPeriod}
FROM
	AccumulationRegister.OtherExpenses AS OtherExpenses
WHERE
	OtherExpenses.RecordType = VALUE(AccumulationRecordType.Expense)
{WHERE
	OtherExpenses.Organization.*,
	OtherExpenses.AdjReserveKind.* AS ReserveKind,
	OtherExpenses.CorProvisionObject.* AS ProvisionObject,
	OtherExpenses.ExpenseItem.* AS AssetRef,
	OtherExpenses.DimensionOfExpenses.* AS Dimension,
	OtherExpenses.LineOfBusiness.*,
	OtherExpenses.Department.*,
	(CASE
			WHEN &amp;ReportData = 0
				THEN OtherExpenses.SumCompl
			WHEN &amp;ReportData = 2
				THEN OtherExpenses.SumCompl - OtherExpenses.PermanentDifference - OtherExpenses.CostTD
			ELSE OtherExpenses.SumMan
		END) AS Used_,
	OtherExpenses.Recorder.*}</query>
	</dataSet>
