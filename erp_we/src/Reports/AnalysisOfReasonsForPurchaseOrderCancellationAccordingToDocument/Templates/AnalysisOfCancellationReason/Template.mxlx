					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Analysis of reasons for purchase order cancellation from [SupplierName]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>تحلیل دلایل لغو سفارش خرید از [SupplierName]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Analisi delle cause di annullamento degli ordini dalla parte di [SupplierName]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Analiza anulowania zamówień ze strony[SupplierName]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Анализ причин отмены заказов со стороны [SupplierName]</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>[SupplierName] tarafından siparişlerin iptal nedenlerinin analizi</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Phân tích nguyên nhân hủy bỏ đơn hàng từ phía [SupplierName]</v8:content>
						</v8:item>
					</tl>
