	<totalField>
		<dataPath>Rebate.ToWriteOffClosingBalance</dataPath>
		<expression>Case
	When Sum(Rebate.ToWriteOffClosingBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ToWriteOffClosingBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.ToWriteOffClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.AmountBonusClosingBalance</dataPath>
		<expression>Case
	When Sum(Rebate.AmountBonusClosingBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.AmountBonusClosingBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.AmountBonusClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.AmountBonusOpeningBalance</dataPath>
		<expression>Case
	When Sum(Rebate.AmountBonusOpeningBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.AmountBonusOpeningBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.AmountBonusOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.AmountBonusReceipt</dataPath>
		<expression>Case
	When Sum(Rebate.AmountBonusReceipt) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.AmountBonusReceipt), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.AmountBonusReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.AmountBonusExpense</dataPath>
		<expression>Case
	When Sum(Rebate.AmountBonusExpense) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.AmountBonusExpense), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.AmountBonusExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.AvailableBalance</dataPath>
		<expression>Case
	When Sum(Rebate.AmountBonusClosingBalance) -
		Sum(Rebate.ToCertifyClosingBalance) -
		Sum(Rebate.ToSignClosingBalance) -
		Sum(Rebate.ToWriteOffClosingBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.AmountBonusClosingBalance) - Sum(Rebate.ToCertifyClosingBalance) - Sum(Rebate.ToSignClosingBalance) - Sum(Rebate.ToWriteOffClosingBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.AmountBonusClosingBalance) -
		Sum(Rebate.ToCertifyClosingBalance) -
		Sum(Rebate.ToSignClosingBalance) -
		Sum(Rebate.ToWriteOffClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.ToCertifyClosingBalance</dataPath>
		<expression>Case
	When Sum(Rebate.ToCertifyClosingBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ToCertifyClosingBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.ToCertifyClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.ToSignClosingBalance</dataPath>
		<expression>Case
	When Sum(Rebate.ToSignClosingBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ToSignClosingBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.ToSignClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.ReflectedByActsClosingBalance</dataPath>
		<expression>Case
	When Sum(Rebate.ToCertifyClosingBalance) +
		Sum(Rebate.ToSignClosingBalance) +
		Sum(Rebate.ToWriteOffClosingBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ToCertifyClosingBalance) + Sum(Rebate.ToSignClosingBalance) + Sum(Rebate.ToWriteOffClosingBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.ToCertifyClosingBalance) +
		Sum(Rebate.ToSignClosingBalance) +
		Sum(Rebate.ToWriteOffClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.ToCertifyTurnover</dataPath>
		<expression>Case
    When Sum(Rebate.ToCertifyReceipt) -
		Sum(Rebate.ToCertifyExpense) &lt;&gt; 0
    And Count(Distinct Currency) &gt; 1
        Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ToCertifyReceipt) - Sum(Rebate.ToCertifyExpense), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
    Else Sum(Rebate.ToCertifyReceipt) -
		Sum(Rebate.ToCertifyExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.ToSignTurnover</dataPath>
		<expression>Case
    When Sum(Rebate.ToSignReceipt) -
		Sum(Rebate.ToSignExpense) &lt;&gt; 0
    And Count(Distinct Currency) &gt; 1
        Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ToSignReceipt) - Sum(Rebate.ToSignExpense), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
    Else Sum(Rebate.ToSignReceipt) -
		Sum(Rebate.ToSignExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.ToWriteOffTurnover</dataPath>
		<expression>Case
    When Sum(Rebate.ToWriteOffReceipt) -
		Sum(Rebate.ToWriteOffExpense) &lt;&gt; 0
    And Count(Distinct Currency) &gt; 1
        Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ToWriteOffReceipt) - Sum(Rebate.ToWriteOffExpense), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
    Else Sum(Rebate.ToWriteOffReceipt) -
		Sum(Rebate.ToWriteOffExpense)
End</expression>
	</totalField>
