				<v8:content>Customer rebate statement</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>صورت تخفیف حجمی مشتری</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
