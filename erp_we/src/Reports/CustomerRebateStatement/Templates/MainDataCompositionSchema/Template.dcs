		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CASE
		WHEN DataTable.Recorder = UNDEFINED
			THEN NULL
		ELSE DataTable.Recorder
	END AS Recorder,
	DataTable.SecondPeriod AS SecondPeriod,
	DataTable.DayPeriod AS DayPeriod,
	DataTable.WeekPeriod AS WeekPeriod,
	DataTable.MonthPeriod AS MonthPeriod,
	DataTable.QuarterPeriod AS QuarterPeriod,
	DataTable.HalfYearPeriod AS HalfYearPeriod,
	DataTable.YearPeriod AS YearPeriod,
	DataTable.Organization AS Organization,
	DataTable.Counterparty AS Counterparty,
	DataTable.Partner AS Partner,
	DataTable.BeginOfPeriod AS BeginOfPeriod,
	DataTable.PeriodEnding AS PeriodEnding,
	CustomerRebatesConditions.ValidOnDate AS ValidOnDate,
	CustomerRebatesConditions.ValidTo AS ValidTo,
	DataTable.TermDocument AS TermDocument,
	DataTable.Currency AS Currency,
	CustomerRebatesConditions.Kind AS Kind,
	DataTable.AmountBonusOpeningBalance AS AmountBonusOpeningBalance,
	DataTable.AmountBonusReceipt AS AmountBonusReceipt,
	DataTable.AmountBonusExpense AS AmountBonusExpense,
	DataTable.AmountBonusClosingBalance AS AmountBonusClosingBalance,
	DataTable.ToWriteOffOpeningBalance AS ToWriteOffOpeningBalance,
	DataTable.ToWriteOffReceipt AS ToWriteOffReceipt,
	DataTable.ToWriteOffExpense AS ToWriteOffExpense,
	DataTable.ToWriteOffClosingBalance AS ToWriteOffClosingBalance,
	CustomerRebatesConditions.LongDesc AS LongDesc,
	DataTable.ToCertifyOpeningBalance AS ToCertifyOpeningBalance,
	DataTable.ToCertifyReceipt AS ToCertifyReceipt,
	DataTable.ToCertifyExpense AS ToCertifyExpense,
	DataTable.ToCertifyClosingBalance AS ToCertifyClosingBalance,
	DataTable.ToSignOpeningBalance AS ToSignOpeningBalance,
	DataTable.ToSignReceipt AS ToSignReceipt,
	DataTable.ToSignExpense AS ToSignExpense,
	DataTable.ToSignClosingBalance AS ToSignClosingBalance
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	Organization.*,
	Counterparty.*,
	Partner.*,
	BeginOfPeriod,
	PeriodEnding,
	TermDocument.*,
	Currency.*,
	AmountBonusOpeningBalance,
	AmountBonusReceipt,
	AmountBonusExpense,
	AmountBonusClosingBalance,
	ToWriteOffOpeningBalance,
	ToWriteOffReceipt,
	ToWriteOffExpense,
	ToWriteOffClosingBalance,
	LongDesc,
	Kind.*,
	ToCertifyOpeningBalance,
	ToCertifyReceipt,
	ToCertifyExpense,
	ToCertifyClosingBalance,
	ToSignOpeningBalance,
	ToSignReceipt,
	ToSignExpense,
	ToSignClosingBalance}
FROM
	AccumulationRegister.CustomerRebates.BalanceAndTurnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto, , {(Organization).* AS Organization, (Counterparty).* AS Counterparty, (Partner).* AS Partner, (TermDocument).* AS TermDocument, (Currency).* AS Currency}) AS DataTable
		{LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON DataTable.TermDocument = CustomerRebatesConditions.TermDocument}
{WHERE
	CustomerRebatesConditions.LongDesc}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
