	<calculatedField>
		<dataPath>DiscrepancyByFlightCalculation</dataPath>
		<expression>EvalExpressionWithGroupArray("Case
	When (Sum(InTrip) - Max(ShipmentIsAboutToBeMade) - Max(CollectedShipment)) &lt; 0
		Then 0
	Else Sum(InTrip) - Max(ShipmentIsAboutToBeMade) - Max(CollectedShipment)
End","Products,Characteristic,Series,ReferenceOrder")</expression>
