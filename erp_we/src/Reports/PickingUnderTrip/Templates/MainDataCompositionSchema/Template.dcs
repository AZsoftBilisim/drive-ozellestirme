	<totalField>
		<dataPath>Discrepancy</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(DiscrepancyCalculation)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PointPoint</dataPath>
		<expression>JoinStrings(PointPoint)</expression>
		<group>Products</group>
		<group>Series</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>AssemblyInProgress</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(AssemblyInProgress)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Assembled</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(CollectedCalculation)
End</expression>
	</totalField>
	<totalField>
		<dataPath>InTrip</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(InTrip)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ForAssembly</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(ForAssembly)
End</expression>
	</totalField>
	<totalField>
		<dataPath>KittingIsScheduled</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(KittingIsScheduled)
End</expression>
	</totalField>
	<totalField>
		<dataPath>GoingToTotal</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(GoingToTotal)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PointPoint</dataPath>
		<expression>""</expression>
		<group>ReferenceOrder</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Discrepancy_ByOrder</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(DiscrepancyByOrderOfCalculation)
End</expression>
	</totalField>
	<totalField>
		<dataPath>TripDiscrepancy</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(DiscrepancyByFlightCalculation)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToShip</dataPath>
		<expression>Max(ToShip)</expression>
	</totalField>
	<totalField>
		<dataPath>ShipmentIsAboutToBeMade</dataPath>
		<expression>Max(ShipmentIsAboutToBeMade)</expression>
	</totalField>
	<totalField>
		<dataPath>CollectedShipment</dataPath>
		<expression>Max(CollectedShipment)</expression>
	</totalField>
	<totalField>
		<dataPath>ToShip</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(ToBeShippedCalculation)
End</expression>
		<group>ReferenceOrder</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>ShipmentIsAboutToBeMade</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(ShipmentIsGoingToBeCalculated)
End</expression>
		<group>ReferenceOrder</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>CollectedShipment</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(CollectedShipmentSettlement)
End</expression>
		<group>ReferenceOrder</group>
		<group>Overall</group>
	</totalField>
