		<dataSource>DataSource1</dataSource>
		<query>SELECT
	DeliveryTurnover.Products AS Products,
	DeliveryTurnover.Characteristic AS Characteristic,
	DeliveryTurnover.Series AS Series,
	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	DeliveryTurnover.Recipient AS Recipient,
	DeliveryTurnover.RecipientPoint AS RecipientPoint,
	DeliveryTurnover.InTripTurnover AS InTrip,
	DeliveryTurnover.ForAssemblyTurnover AS ForAssembly,
	DeliveryTurnover.KittingIsScheduledTurnover AS KittingIsScheduled,
	DeliveryTurnover.AssemblyInProgressTurnover AS AssemblyInProgress,
	DeliveryTurnover.AssembledTurnover AS Assembled
INTO TT_DeliveryData
FROM
	AccumulationRegister.Delivery.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;EndOfPeriod)},
			,
			Trip = &amp;Trip
				AND DeliveryType = VALUE(Enum.DeliveryTypes.OutgoingInfo)
				AND Arm IN (&amp;ShoulderNumbers)) AS DeliveryTurnover
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DeliveryData.Products AS Products,
	DeliveryData.Characteristic AS Characteristic,
	DeliveryData.Series AS Series,
	DeliveryData.ReferenceOrder AS ReferenceOrder,
	SUM(DeliveryData.KittingIsScheduled) AS KittingIsScheduled,
	SUM(DeliveryData.AssemblyInProgress) AS AssemblyInProgress,
	SUM(DeliveryData.Assembled) AS Assembled
INTO TT_DataKit
FROM
	TT_DeliveryData AS DeliveryData

GROUP BY
	DeliveryData.Products,
	DeliveryData.Characteristic,
	DeliveryData.Series,
	DeliveryData.ReferenceOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	GoodsForShipmentTurnover.DocumentShipments AS DocumentShipments,
	GoodsForShipmentTurnover.Products AS Products,
	GoodsForShipmentTurnover.Characteristic AS Characteristic,
	GoodsForShipmentTurnover.Series AS Series,
	GoodsForShipmentTurnover.ToShipReceipt AS ToShip,
	GoodsForShipmentTurnover.ForAssemblyTurnover + GoodsForShipmentTurnover.AssemblyInProgressTurnover AS AssemblyInProgress,
	GoodsForShipmentTurnover.AssembledTurnover + GoodsForShipmentTurnover.ToShipExpense AS Assembled
INTO TT_ShipmentData
FROM
	AccumulationRegister.GoodsForIssue.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;EndOfPeriod)},
			,
			(DocumentShipments, Products, Characteristic, Series) IN
				(SELECT
					Table.ReferenceOrder AS DocumentShipments,
					Table.Products AS Products,
					Table.Characteristic AS Characteristic,
					Table.Series AS Series
				FROM
					TT_DataKit AS Table)) AS GoodsForShipmentTurnover
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DeliveryData.ReferenceOrder AS ReferenceOrder,
	DeliveryData.Products AS Products,
	DeliveryData.Characteristic AS Characteristic,
	DeliveryData.Series AS Series,
	DeliveryData.Recipient AS Recipient,
	DeliveryData.RecipientPoint AS RecipientPoint,
	DeliveryData.InTrip AS InTrip,
	DeliveryData.ForAssembly AS ForAssembly,
	ISNULL(DataKit.KittingIsScheduled, 0) AS KittingIsScheduled,
	ISNULL(DataKit.AssemblyInProgress, 0) AS AssemblyInProgress,
	ISNULL(DataKit.Assembled, 0) AS Assembled,
	ISNULL(ShipmentData.AssemblyInProgress, 0) AS ShipmentIsAboutToBeMade,
	ISNULL(ShipmentData.ToShip, 0) AS ToShip,
	ISNULL(ShipmentData.Assembled, 0) AS CollectedShipment
{SELECT
	ReferenceOrder.*,
	Products.*,
	Characteristic.*,
	Series.*,
	Recipient.* AS PointOfRoute,
	RecipientPoint.* AS DeliveryPoint,
	InTrip,
	ForAssembly,
	KittingIsScheduled,
	AssemblyInProgress,
	Assembled,
	ShipmentIsAboutToBeMade,
	ToShip,
	CollectedShipment}
FROM
	TT_DeliveryData AS DeliveryData
		{LEFT JOIN TT_DataKit AS DataKit
		ON DeliveryData.ReferenceOrder = DataKit.ReferenceOrder
			AND DeliveryData.Products = DataKit.Products
			AND DeliveryData.Characteristic = DataKit.Characteristic
			AND DeliveryData.Series = DataKit.Series}
		{LEFT JOIN TT_ShipmentData AS ShipmentData
		ON DeliveryData.ReferenceOrder = ShipmentData.DocumentShipments
			AND DeliveryData.Products = ShipmentData.Products
			AND DeliveryData.Characteristic = ShipmentData.Characteristic
			AND DeliveryData.Series = ShipmentData.Series}
{WHERE
	DeliveryData.ReferenceOrder.*,
	DeliveryData.Recipient.* AS PointOfRoute,
	DeliveryData.Products.*,
	DeliveryData.Characteristic.*}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
