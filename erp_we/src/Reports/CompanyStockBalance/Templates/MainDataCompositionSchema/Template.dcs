	</totalField>
	<totalField>
		<dataPath>insufficient</dataPath>
		<expression>Case When Sum(Count) &gt; Sum(IsNull(AvailableBalance, 0)) Then
Sum(Count) - Sum(IsNull(AvailableBalance, 0))
Else
0
End</expression>
		<group>Products</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>AvailableBalance</dataPath>
		<expression>Sum(AvailableBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>DateOfReceipt</dataPath>
		<expression>Max(DateOfReceipt)</expression>
		<group>InventoryOwnerAttribute</group>
		<group>CCDNumber</group>
	</totalField>
	<totalField>
		<dataPath>QuantityToWriteOff</dataPath>
		<expression>Sum(QuantityToWriteOff)</expression>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Series</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>AvailableRemainingGoodsWithoutIntercompany</dataPath>
		<expression>Sum(AvailableRemainingGoodsWithoutIntercompany)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityToRecordAsReceived</dataPath>
		<expression>Sum(QuantityToRecordAsReceived)</expression>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Series</group>
		<group>Characteristic</group>
	</totalField>
