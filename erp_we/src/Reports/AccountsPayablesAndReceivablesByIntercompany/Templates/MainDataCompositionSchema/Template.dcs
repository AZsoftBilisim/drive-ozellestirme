			<field xsi:type="DataSetFieldField">
				<dataPath>Recorder</dataPath>
				<field>Recorder</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Customer</dataPath>
				<field>Customer</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Seller</dataPath>
				<field>Seller</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BuyerSDebtClosingBalance</dataPath>
				<field>BuyerSDebtClosingBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BuyerSDebtOpeningBalance</dataPath>
				<field>BuyerSDebtOpeningBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SellerDebtClosingBalance</dataPath>
				<field>SellerDebtClosingBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SellerDebtOpeningBalance</dataPath>
				<field>SellerDebtOpeningBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPDocument</dataPath>
				<field>ARAPDocument</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>LineOfBusiness</dataPath>
				<field>LineOfBusiness</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PlannedRepaymentDate</dataPath>
				<field>PlannedRepaymentDate</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPObject</dataPath>
				<field>ARAPObject</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>OccurrenceDate</dataPath>
				<field>OccurrenceDate</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SecondPeriod</dataPath>
				<field>SecondPeriod</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	1 AS PaymentType_,
	CustomersARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization AS Seller,
	CAST(RegisterAccountingAnalyticsForPartners.Counterparty AS Catalog.Companies) AS Customer,
	CASE WHEN NOT CustomersARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE CustomersARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	CustomersARAPAccounting.Currency AS Currency,
	CustomersARAPAccounting.ARAPObject AS ARAPObject,
	
	CASE WHEN CustomersARAPAccounting.Recorder = UNDEFINED THEN
		NULL
	ELSE
		CustomersARAPAccounting.Recorder
	END AS Recorder,
	
	CASE WHEN CustomersARAPAccounting.SumOpeningBalance &gt; 0 THEN
		CustomersARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS BuyerSDebtOpeningBalance,
	
	CASE WHEN CustomersARAPAccounting.SumOpeningBalance &lt; 0 THEN
		-CustomersARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS SellerDebtOpeningBalance,
	
	CustomersARAPAccounting.SumOpeningBalance AS DebtOpeningBalance,
	CustomersARAPAccounting.SumReceipt AS DebtReduction,
	CustomersARAPAccounting.SumExpense AS DebtIncrease_,
	CustomersARAPAccounting.SumClosingBalance AS DebtClosingBalance,
	
	CASE WHEN CustomersARAPAccounting.SumClosingBalance &gt; 0 THEN
		CustomersARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS BuyerSDebtClosingBalance,
	
	CASE WHEN CustomersARAPAccounting.SumClosingBalance &lt; 0 THEN
		-CustomersARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS SellerDebtClosingBalance,
	CustomersARAPAccounting.SecondPeriod AS SecondPeriod
		
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(
		,
		,
		Auto
	) AS CustomersARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData = 1 // In the settlement currency

UNION ALL

SELECT
	1 AS PaymentType_,
	CustomersARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization AS Seller,
	CAST(RegisterAccountingAnalyticsForPartners.Counterparty AS Catalog.Companies) AS Customer,
	CASE WHEN NOT CustomersARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE CustomersARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		&amp;ManagementAccountingCurrency
	ELSE
		RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS Currency,
	CustomersARAPAccounting.ARAPObject AS ARAPObject,
	
	NULL AS Recorder,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.ARAPManOpeningBalance - CustomersARAPAccounting.PrepaymentManOpeningBalance &gt; 0 THEN
			CustomersARAPAccounting.ARAPManOpeningBalance - CustomersARAPAccounting.PrepaymentManOpeningBalance
		ELSE
			0
		END
	ELSE // In the currency of the regl. accounting
		CASE WHEN CustomersARAPAccounting.DebtLocalOpeningBalance - CustomersARAPAccounting.PrepaymentLocalOpeningBalance &gt; 0 THEN
			CustomersARAPAccounting.DebtLocalOpeningBalance - CustomersARAPAccounting.PrepaymentLocalOpeningBalance
		ELSE
			0
		END
	END AS BuyerSDebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.ARAPManOpeningBalance - CustomersARAPAccounting.PrepaymentManOpeningBalance &lt; 0 THEN
			-(CustomersARAPAccounting.ARAPManOpeningBalance - CustomersARAPAccounting.PrepaymentManOpeningBalance)
		ELSE
			0
		END
	ELSE // In the currency of the regl. accounting
		CASE WHEN CustomersARAPAccounting.DebtLocalOpeningBalance - CustomersARAPAccounting.PrepaymentLocalOpeningBalance &lt; 0 THEN
			-(CustomersARAPAccounting.DebtLocalOpeningBalance - CustomersARAPAccounting.PrepaymentLocalOpeningBalance)
		ELSE
			0
		END
	END AS SellerDebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CustomersARAPAccounting.ARAPManOpeningBalance - CustomersARAPAccounting.PrepaymentManOpeningBalance
	ELSE
		CustomersARAPAccounting.DebtLocalOpeningBalance - CustomersARAPAccounting.PrepaymentLocalOpeningBalance
	END AS DebtOpeningBalance,
	
	0 AS DebtReduction,
	0 AS DebtIncrease_,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CustomersARAPAccounting.ARAPManClosingBalance - CustomersARAPAccounting.PrepaymentManClosingBalance
	ELSE
		CustomersARAPAccounting.DebtLocalClosingBalance - CustomersARAPAccounting.PrepaymentLocalClosingBalance
	END AS DebtClosingBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.ARAPManClosingBalance - CustomersARAPAccounting.PrepaymentManClosingBalance &gt; 0 THEN
			CustomersARAPAccounting.ARAPManClosingBalance - CustomersARAPAccounting.PrepaymentManClosingBalance
		ELSE
			0
		END
	ELSE
		CASE WHEN CustomersARAPAccounting.DebtLocalClosingBalance - CustomersARAPAccounting.PrepaymentLocalClosingBalance &gt; 0 THEN
			CustomersARAPAccounting.DebtLocalClosingBalance - CustomersARAPAccounting.PrepaymentLocalClosingBalance
		ELSE
			0
		END
	END AS BuyerSDebtClosingBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.ARAPManClosingBalance - CustomersARAPAccounting.PrepaymentManClosingBalance &lt; 0 THEN
			-(CustomersARAPAccounting.ARAPManClosingBalance - CustomersARAPAccounting.PrepaymentManClosingBalance)
		ELSE
			0
		END
	ELSE
		CASE WHEN CustomersARAPAccounting.DebtLocalClosingBalance - CustomersARAPAccounting.PrepaymentLocalClosingBalance &lt; 0 THEN
			-(CustomersARAPAccounting.DebtLocalClosingBalance - CustomersARAPAccounting.PrepaymentLocalClosingBalance)
		ELSE
			0
		END
	END AS SellerDebtClosingBalance,
	CustomersARAPAccounting.SecondPeriod

FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates.BalanceAndTurnovers(
		,
		,
		Auto
	) AS CustomersARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData IN (2,3) // In the currency of upr. accounting, in the currency of regl. accounting

UNION ALL

SELECT
	1 AS PaymentType_,
	CustomersARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization AS Seller,
	CAST(RegisterAccountingAnalyticsForPartners.Counterparty AS Catalog.Companies) AS Customer,
	CASE WHEN NOT CustomersARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE CustomersARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		&amp;ManagementAccountingCurrency
	ELSE
		RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS Currency,
	CustomersARAPAccounting.ARAPObject AS ARAPObject,
	
	CustomersARAPAccounting.DocumentRecorder AS Recorder,
	
	0 AS BuyerSDebtOpeningBalance,
	0 AS SellerDebtOpeningBalance,
	0 AS DebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
				CustomersARAPAccounting.ARAPMan
			WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense)THEN
				CustomersARAPAccounting.PrepaymentMan
			ELSE
				0
		END
	ELSE
		CASE WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
				CustomersARAPAccounting.DebtLocal
			WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense)THEN
				CustomersARAPAccounting.PrepaymentLocal
			ELSE
				0
		END
	END AS DebtReduction,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense) THEN
				CustomersARAPAccounting.ARAPMan
			WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt)THEN
				CustomersARAPAccounting.PrepaymentMan
			ELSE
				0
		END
	ELSE
		CASE WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense) THEN
				CustomersARAPAccounting.DebtLocal
			WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt)THEN
				CustomersARAPAccounting.PrepaymentLocal
			ELSE
				0
		END
	END AS DebtIncrease_,
	
	0 AS DebtClosingBalance,
	0 AS BuyerSDebtClosingBalance,
	0 AS SellerDebtClosingBalance,
	CustomersARAPAccounting.Period

FROM
	AccumulationRegister.CustomersARAPAccountingByDueDates AS CustomersARAPAccounting
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData IN (2,3) // In the currency of upr. accounting, in the currency of regl. accounting
	AND CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
				CustomersARAPAccounting.ARAPMan
			WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense)THEN
				CustomersARAPAccounting.PrepaymentMan
			ELSE
				0
		END
	ELSE
		CASE WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
				CustomersARAPAccounting.DebtLocal
			WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense)THEN
				CustomersARAPAccounting.PrepaymentLocal
			ELSE
				0
		END
	END - 
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense) THEN
				CustomersARAPAccounting.ARAPMan
			WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt)THEN
				CustomersARAPAccounting.PrepaymentMan
			ELSE
				0
		END
	ELSE
		CASE WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense) THEN
				CustomersARAPAccounting.DebtLocal
			WHEN CustomersARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt)THEN
				CustomersARAPAccounting.PrepaymentLocal
			ELSE
				0
		END
	END &lt;&gt; 0
	{WHERE CustomersARAPAccounting.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod}
</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>VendorsARAPAccounting</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>AccountingDimensionByPartners</dataPath>
				<field>AccountingDimensionByPartners</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
