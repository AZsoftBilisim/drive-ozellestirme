				<dataPath>Customer</dataPath>
				<field>Customer</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Seller</dataPath>
				<field>Seller</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BuyerSDebtClosingBalance</dataPath>
				<field>BuyerSDebtClosingBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BuyerSDebtOpeningBalance</dataPath>
				<field>BuyerSDebtOpeningBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SellerDebtClosingBalance</dataPath>
				<field>SellerDebtClosingBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SellerDebtOpeningBalance</dataPath>
				<field>SellerDebtOpeningBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPDocument</dataPath>
				<field>ARAPDocument</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>LineOfBusiness</dataPath>
				<field>LineOfBusiness</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PlannedRepaymentDate</dataPath>
				<field>PlannedRepaymentDate</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ARAPObject</dataPath>
				<field>ARAPObject</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>OccurrenceDate</dataPath>
				<field>OccurrenceDate</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SecondPeriod</dataPath>
				<field>SecondPeriod</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	2 AS PaymentType_,
	VendorsARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization AS Customer,
	CAST(RegisterAccountingAnalyticsForPartners.Counterparty AS Catalog.Companies) AS Seller,
	CASE WHEN NOT VendorsARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	VendorsARAPAccounting.Currency AS Currency,
	VendorsARAPAccounting.ARAPObject AS ARAPObject,
	
	CASE WHEN VendorsARAPAccounting.Recorder = UNDEFINED THEN
		NULL
	ELSE
		VendorsARAPAccounting.Recorder
	END AS Recorder,
	
	CASE WHEN VendorsARAPAccounting.SumOpeningBalance &gt; 0 THEN
		VendorsARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS SellerDebtOpeningBalance,
	
	CASE WHEN VendorsARAPAccounting.SumOpeningBalance &lt; 0 THEN
		-VendorsARAPAccounting.SumOpeningBalance
	ELSE
		0
	END AS BuyerSDebtOpeningBalance,
	
	VendorsARAPAccounting.SumOpeningBalance AS DebtOpeningBalance,
	VendorsARAPAccounting.SumReceipt AS DebtReduction,
	VendorsARAPAccounting.SumExpense AS DebtIncrease_,
	VendorsARAPAccounting.SumClosingBalance AS DebtClosingBalance,
	
	CASE WHEN VendorsARAPAccounting.SumClosingBalance &gt; 0 THEN
		VendorsARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS SellerDebtClosingBalance,
	
	CASE WHEN VendorsARAPAccounting.SumClosingBalance &lt; 0 THEN
		-VendorsARAPAccounting.SumClosingBalance
	ELSE
		0
	END AS BuyerSDebtClosingBalance,
	VendorsARAPAccounting.SecondPeriod AS SecondPeriod
	
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(
		,
		,
		Auto
	) AS VendorsARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData = 1 // In the settlement currency

UNION ALL

SELECT
	2 AS PaymentType_,
	VendorsARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization AS Customer,
	CAST(RegisterAccountingAnalyticsForPartners.Counterparty AS Catalog.Companies) AS Seller,
	CASE WHEN NOT VendorsARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.ARAPObject.LineOfBusiness
	END  AS LineOfBusiness,
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		&amp;ManagementAccountingCurrency
	ELSE
		RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS Currency,
	VendorsARAPAccounting.ARAPObject AS ARAPObject,
	
	NULL AS Recorder,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.PrepaymentManOpeningBalance - VendorsARAPAccounting.ARAPManOpeningBalance &gt; 0 THEN
			VendorsARAPAccounting.PrepaymentManOpeningBalance - VendorsARAPAccounting.ARAPManOpeningBalance
		ELSE
			0
		END
	ELSE // In the currency of the regl. accounting
		CASE WHEN VendorsARAPAccounting.PrepaymentLocalOpeningBalance - VendorsARAPAccounting.DebtLocalOpeningBalance &gt; 0 THEN
			VendorsARAPAccounting.PrepaymentLocalOpeningBalance - VendorsARAPAccounting.DebtLocalOpeningBalance
		ELSE
			0
		END
	END AS SellerDebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.PrepaymentManOpeningBalance - VendorsARAPAccounting.ARAPManOpeningBalance &lt; 0 THEN
			-(VendorsARAPAccounting.PrepaymentManOpeningBalance - VendorsARAPAccounting.ARAPManOpeningBalance)
		ELSE
			0
		END
	ELSE // In the currency of the regl. accounting
		CASE WHEN VendorsARAPAccounting.PrepaymentLocalOpeningBalance - VendorsARAPAccounting.DebtLocalOpeningBalance &lt; 0 THEN
			-(VendorsARAPAccounting.PrepaymentLocalOpeningBalance - VendorsARAPAccounting.DebtLocalOpeningBalance)
		ELSE
			0
		END
	END AS BuyerSDebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		VendorsARAPAccounting.PrepaymentManOpeningBalance - VendorsARAPAccounting.ARAPManOpeningBalance
	ELSE
		VendorsARAPAccounting.PrepaymentLocalOpeningBalance - VendorsARAPAccounting.DebtLocalOpeningBalance
	END AS DebtOpeningBalance,
	
	0 AS DebtReduction,
	0 AS DebtIncrease_,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		VendorsARAPAccounting.PrepaymentManClosingBalance - VendorsARAPAccounting.ARAPManClosingBalance
	ELSE
		VendorsARAPAccounting.PrepaymentLocalClosingBalance - VendorsARAPAccounting.DebtLocalClosingBalance
	END AS DebtClosingBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.PrepaymentManClosingBalance - VendorsARAPAccounting.ARAPManClosingBalance &gt; 0 THEN
			VendorsARAPAccounting.PrepaymentManClosingBalance - VendorsARAPAccounting.ARAPManClosingBalance
		ELSE
			0
		END
	ELSE
		CASE WHEN VendorsARAPAccounting.PrepaymentLocalClosingBalance - VendorsARAPAccounting.DebtLocalClosingBalance &gt; 0 THEN
			VendorsARAPAccounting.PrepaymentLocalClosingBalance - VendorsARAPAccounting.DebtLocalClosingBalance
		ELSE
			0
		END
	END AS SellerDebtClosingBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.PrepaymentManClosingBalance - VendorsARAPAccounting.ARAPManClosingBalance &lt; 0 THEN
			-(VendorsARAPAccounting.PrepaymentManClosingBalance - VendorsARAPAccounting.ARAPManClosingBalance)
		ELSE
			0
		END
	ELSE
		CASE WHEN VendorsARAPAccounting.PrepaymentLocalClosingBalance - VendorsARAPAccounting.DebtLocalClosingBalance &lt; 0 THEN
			-(VendorsARAPAccounting.PrepaymentLocalClosingBalance - VendorsARAPAccounting.DebtLocalClosingBalance)
		ELSE
			0
		END
	END AS BuyerSDebtClosingBalance,
	VendorsARAPAccounting.SecondPeriod

FROM
	AccumulationRegister.VendorsARAPAccountingByDueDates.BalanceAndTurnovers(
		,
		,
		Auto
	) AS VendorsARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData IN (2,3) // In the currency of upr. accounting, in the currency of regl. accounting

UNION ALL

SELECT
	2 AS PaymentType_,
	VendorsARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization AS Customer,
	CAST(RegisterAccountingAnalyticsForPartners.Counterparty AS Catalog.Companies) AS Seller,
	CASE WHEN NOT VendorsARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		&amp;ManagementAccountingCurrency
	ELSE
		RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS Currency,
	VendorsARAPAccounting.ARAPObject AS ARAPObject,
	
	VendorsARAPAccounting.DocumentRecorder AS Recorder,
	
	0 AS SellerDebtOpeningBalance,
	0 AS BuyerSDebtOpeningBalance,
	0 AS DebtOpeningBalance,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense) THEN
				VendorsARAPAccounting.ARAPMan
			WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt)THEN
				VendorsARAPAccounting.PrepaymentMan
			ELSE
				0
		END
	ELSE
		CASE WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense) THEN
				VendorsARAPAccounting.DebtLocal
			WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt)THEN
				VendorsARAPAccounting.PrepaymentLocal
			ELSE
				0
		END
	END AS DebtReduction,
	
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
				VendorsARAPAccounting.ARAPMan
			WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense)THEN
				VendorsARAPAccounting.PrepaymentMan
			ELSE
				0
		END
	ELSE
		CASE WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
				VendorsARAPAccounting.DebtLocal
			WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense)THEN
				VendorsARAPAccounting.PrepaymentLocal
			ELSE
				0
		END
	END AS DebtIncrease_,
	
	0 AS DebtClosingBalance,
	0 AS SellerDebtClosingBalance,
	0 AS BuyerSDebtClosingBalance,
	VendorsARAPAccounting.Period

FROM
	AccumulationRegister.VendorsARAPAccountingByDueDates AS VendorsARAPAccounting
	
	{
	LEFT JOIN
		InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
	ON
		VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
	}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData IN (2,3) // In the currency of upr. accounting, in the currency of regl. accounting
	AND CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
				VendorsARAPAccounting.ARAPMan
			WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense)THEN
				VendorsARAPAccounting.PrepaymentMan
			ELSE
				0
		END
	ELSE
		CASE WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt) THEN
				VendorsARAPAccounting.DebtLocal
			WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense)THEN
				VendorsARAPAccounting.PrepaymentLocal
			ELSE
				0
		END
	END -
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		CASE WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense) THEN
				VendorsARAPAccounting.ARAPMan
			WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt)THEN
				VendorsARAPAccounting.PrepaymentMan
			ELSE
				0
		END
	ELSE
		CASE WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Expense) THEN
				VendorsARAPAccounting.DebtLocal
			WHEN VendorsARAPAccounting.RecordType = VALUE(AccumulationRecordType.Receipt)THEN
				VendorsARAPAccounting.PrepaymentLocal
			ELSE
				0
		END
	END &lt;&gt; 0
	{WHERE VendorsARAPAccounting.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod}</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>DebtClosingBalance</dataPath>
		<expression>Sum(DebtClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>DebtOpeningBalance</dataPath>
		<expression>Sum(DebtOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>DebtIncrease_</dataPath>
		<expression>Sum(DebtIncrease_)</expression>
	</totalField>
	<totalField>
		<dataPath>DebtReduction</dataPath>
		<expression>Sum(DebtReduction)</expression>
	</totalField>
	<totalField>
		<dataPath>BuyerSDebtOpeningBalance</dataPath>
		<expression>Sum(BuyerSDebtOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>BuyerSDebtClosingBalance</dataPath>
		<expression>Sum(BuyerSDebtClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>SellerDebtOpeningBalance</dataPath>
		<expression>Sum(SellerDebtOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>SellerDebtClosingBalance</dataPath>
		<expression>Sum(SellerDebtClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>BuyerSDebtClosingBalance</dataPath>
		<expression>Cast(0, "Number(31,2)")</expression>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>BuyerSDebtOpeningBalance</dataPath>
