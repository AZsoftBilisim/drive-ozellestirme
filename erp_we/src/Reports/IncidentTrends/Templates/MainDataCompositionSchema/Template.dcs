<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ref</dataPath>
			<field>Ref</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>IncidentKind</dataPath>
			<field>IncidentKind</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Count</dataPath>
			<field>Count</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Quantity</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مقدار</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Quantità</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Ilość</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Miktar</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số lượng</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Period</dataPath>
			<field>Period</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Incidents.Ref AS Ref,
	Incidents.IncidentKind AS IncidentKind,
	CASE
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.DAY)
			THEN BEGINOFPERIOD(Incidents.RegistrationDate, DAY)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(Incidents.RegistrationDate, WEEK)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(Incidents.RegistrationDate, TENDAYS)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(Incidents.RegistrationDate, MONTH)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(Incidents.RegistrationDate, HALFYEAR)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(Incidents.RegistrationDate, HALFYEAR)
		WHEN &amp;ReportFrequency = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(Incidents.RegistrationDate, YEAR)
		ELSE Incidents.RegistrationDate
	END AS Period,
	1 AS Count
FROM
	Catalog.Incidents AS Incidents
WHERE
	Incidents.DeletionMark = FALSE	
{WHERE
	(Incidents.RegistrationDate &gt;= &amp;StartDate),
	(Incidents.RegistrationDate &lt;= &amp;EndDate)}</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
