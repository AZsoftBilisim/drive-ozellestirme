						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>NFD=2</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MinWidth</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE
		WHEN &amp;Periodicity = 1
			THEN OtherExpensesBalanceAndTurnovers.MonthPeriod
		WHEN &amp;Periodicity = 2
			THEN OtherExpensesBalanceAndTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = 3
			THEN OtherExpensesBalanceAndTurnovers.YearPeriod
		ELSE OtherExpensesBalanceAndTurnovers.DayPeriod
	END AS Period,
	CASE
		WHEN OtherExpensesBalanceAndTurnovers.Recorder = UNDEFINED
			THEN NULL
		ELSE OtherExpensesBalanceAndTurnovers.Recorder
	END AS Recorder,
	CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.AmountExcludingVATOpeningBalance
				ELSE 0
			END
		WHEN &amp;ReportData = 2
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumManOpeningBalance
				ELSE 0
			END
		WHEN &amp;ReportData = 3
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionLocal = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumComplOpeningBalance
				ELSE 0
			END
		WHEN &amp;ReportData = 4
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionTax = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumComplOpeningBalance -
						OtherExpensesBalanceAndTurnovers.PermanentDifferenceOpeningBalance -
						OtherExpensesBalanceAndTurnovers.CostTDOpeningBalance
				ELSE 0
			END
		ELSE CASE
			WHEN NOT &amp;SelectionByDistributionOption
			OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
				THEN OtherExpensesBalanceAndTurnovers.SumOpeningBalance
			ELSE 0
		END
	END AS OpeningBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.AmountExcludingVATReceipt
				ELSE 0
			END
		WHEN &amp;ReportData = 2
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumManReceipt
				ELSE 0
			END
		WHEN &amp;ReportData = 3
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionLocal = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumComplReceipt
				ELSE 0
			END
		WHEN &amp;ReportData = 4
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionTax = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumComplReceipt - OtherExpensesBalanceAndTurnovers.PermanentDifferenceReceipt -
						OtherExpensesBalanceAndTurnovers.CostTDReceipt
				ELSE 0
			END
		ELSE CASE
			WHEN NOT &amp;SelectionByDistributionOption
			OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
				THEN OtherExpensesBalanceAndTurnovers.SumReceipt
			ELSE 0
		END
	END AS Receipt,
	CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.AmountExcludingVATExpense
				ELSE 0
			END
		WHEN &amp;ReportData = 2
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumManExpense
				ELSE 0
			END
		WHEN &amp;ReportData = 3
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionLocal = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumComplExpense
				ELSE 0
			END
		WHEN &amp;ReportData = 4
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionTax = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumComplExpense - OtherExpensesBalanceAndTurnovers.PermanentDifferenceExpense -
						OtherExpensesBalanceAndTurnovers.CostTDExpense
				ELSE 0
			END
		ELSE CASE
			WHEN NOT &amp;SelectionByDistributionOption
			OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
				THEN OtherExpensesBalanceAndTurnovers.SumExpense
			ELSE 0
		END
	END AS Expense,
	CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.AmountExcludingVATClosingBalance
				ELSE 0
			END
		WHEN &amp;ReportData = 2
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumManClosingBalance
				ELSE 0
			END
		WHEN &amp;ReportData = 3
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionLocal = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumComplClosingBalance
				ELSE 0
			END
		WHEN &amp;ReportData = 4
			THEN CASE
				WHEN NOT &amp;SelectionByDistributionOption
				OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionTax = &amp;AllocationOption
					THEN OtherExpensesBalanceAndTurnovers.SumComplClosingBalance -
						OtherExpensesBalanceAndTurnovers.PermanentDifferenceClosingBalance -
						OtherExpensesBalanceAndTurnovers.CostTDClosingBalance
				ELSE 0
			END
		ELSE CASE
			WHEN NOT &amp;SelectionByDistributionOption
			OR OtherExpensesBalanceAndTurnovers.ExpenseItem.CostAllocationOptionManag = &amp;AllocationOption
				THEN OtherExpensesBalanceAndTurnovers.SumClosingBalance
			ELSE 0
		END
	END AS ClosingBalance
FROM
	AccumulationRegister.OtherExpenses.BalanceAndTurnovers(,, Auto, RegisterRecords, {(Organization), (Department),
		(LineOfBusiness), (ExpenseItem), (DimensionOfExpenses)}) AS OtherExpensesBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>ClosingBalance</dataPath>
		<expression>ClosingBalance</expression>
		<group>Period</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>OpeningBalance</dataPath>
		<expression>OpeningBalance</expression>
		<group>Period</group>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>Receipt</dataPath>
		<expression>Sum(Receipt)</expression>
	</totalField>
	<totalField>
		<dataPath>Expense</dataPath>
		<expression>Sum(Expense)</expression>
	</totalField>
