		<field xsi:type="DataSetFieldField">
			<dataPath>Country</dataPath>
			<field>Country</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	ENDOFPERIOD(CompanyGoodsBalance.Period, DAY) AS Period,
	ProductsTable.Ref AS Products,
	ISNULL(ProductsVATRates.VATRate, ISNULL(VATRatesForEmptyCountryProducts.VATRate,
		ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef)))) AS VATRate,
	ProductsTable.ItemsType AS ItemsType,
	ProductsTable.FinancialAccountingGroup AS FinancialAccountingGroup,
	KeyTable_.Characteristic AS Characteristic,
	KeyTable_.Series AS Series,
	KeyTable_.Purpose AS Purpose,
	KeyTable_.StorageLocation AS StorageLocation,
	KeyTable_.WarehouseArea AS StorageLocationWarehouse,
	KeyTable_.Contract AS StorageLocationContract,
	KeyTable_.Counterparty AS StorageLocationCounterparty,
	KeyTable_.Partner AS StorageLocationPartner,
	KeyTable_.Department AS StorageLocationDepartment,
	KeyTable_.StorageType AS StorageType,
	CompanyGoodsBalance.Organization AS Organization,
	CompanyGoodsBalance.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CompanyGoodsBalance.InventoryOwnerAttribute.VATTaxation AS VATTaxationOfInventoryKind,
	CompanyGoodsBalance.InventoryOwnerAttribute.GoodsOwner AS GoodsInventoryKindOwner,
	CompanyGoodsBalance.InventoryOwnerAttribute.InventoryType AS InventoryType,
	CompanyGoodsBalance.CCDNumber AS CCDNumber,
	KeyTable_.Ref AS ItemsLocationAttributes,
	CASE
		WHEN CompanyGoodsBalance.CountClosingBalance &gt;= 0
			THEN 0
		WHEN CompanyGoodsBalance.CountOpeningBalance &gt;= 0
			THEN -CompanyGoodsBalance.CountClosingBalance
		WHEN CompanyGoodsBalance.CountOpeningBalance - CompanyGoodsBalance.CountClosingBalance &gt; 0
			THEN CompanyGoodsBalance.CountOpeningBalance - CompanyGoodsBalance.CountClosingBalance
		ELSE 0
	END AS QuantityToTransfer
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Day,,
		(InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.OwnGoods)
	OR InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	AND InventoryOwnerAttribute.GoodsOwner REFS Catalog.Companies)
	AND ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
		{((ItemsLocationAttributes.Products, ItemsLocationAttributes.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
		(ItemsLocationAttributes.Products).* AS Products, (ItemsLocationAttributes.StorageLocation).* AS
		Warehouse}) AS CompanyGoodsBalance
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS KeyTable_
		ON CompanyGoodsBalance.ItemsLocationAttributes = KeyTable_.Ref
		INNER JOIN Catalog.Products AS ProductsTable
		ON KeyTable_.Products = ProductsTable.Ref
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&amp;EndOfPeriod) AS ProductsVATRates
		ON KeyTable_.Products = ProductsVATRates.Products
		AND CompanyGoodsBalance.Organization.RegistrationCountry = ProductsVATRates.Country
		LEFT JOIN InformationRegister.BasicVATRates.SliceLast(&amp;EndOfPeriod) AS BasicVATRates
		ON CompanyGoodsBalance.Organization.RegistrationCountry = BasicVATRates.Country
		LEFT JOIN InformationRegister.ProductsVATRates.SliceLast(&amp;EndOfPeriod,
			Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS VATRatesForEmptyCountryProducts
		ON KeyTable_.Products = VATRatesForEmptyCountryProducts.Products
WHERE
	CASE
		WHEN CompanyGoodsBalance.CountClosingBalance &gt;= 0
			THEN 0
		WHEN CompanyGoodsBalance.CountOpeningBalance &gt;= 0
			THEN -CompanyGoodsBalance.CountClosingBalance
		WHEN CompanyGoodsBalance.CountOpeningBalance - CompanyGoodsBalance.CountClosingBalance &gt; 0
			THEN CompanyGoodsBalance.CountOpeningBalance - CompanyGoodsBalance.CountClosingBalance
		ELSE 0
	END &gt; 0</query>
	</dataSet>
	<parameter>
		<name>FilterByProductSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter by item segment is used</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>فیلتر بر اساس بخش قلم استفاده می‌شود</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Viene utilizzata la selezione per segmento degli articoli</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jest używany filtr wg segmentu wierszy pozycji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Используется отбор по сегменту номенклатуры</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Stok segmentine göre filtre kullanılıyor</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Sử dụng lọc theo phân khúc mặt hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
