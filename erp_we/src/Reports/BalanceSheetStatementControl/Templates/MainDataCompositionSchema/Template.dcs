		<dataSource>DataSource1</dataSource>
		<query>SELECT
	AssetLiabilityItems.Ref AS AssetRef,
	AssetLiabilityItems.Parent AS Parent
FROM
	ChartOfCharacteristicTypes.AssetLiabilityItems AS AssetLiabilityItems
WHERE
	AssetLiabilityItems.Ref IN (&amp;ListOfArticles)
	AND AssetLiabilityItems.Parent &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef)</query>
	</dataSet>
