		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	AssetsLiabilities.Recorder AS Recorder,
	SUM(AssetsLiabilities.SumReceipt) AS SumReceipt,
	SUM(AssetsLiabilities.SumExpense) AS SumExpense,
	SUM(AssetsLiabilities.SumReceipt) - SUM(AssetsLiabilities.SumExpense) AS Control
INTO TTBalanceControl
FROM
	AccumulationRegister.OtherAssetsLiabilities.Turnovers(, , Auto, {(LineOfBusiness), (Organization), (Department)}) AS AssetsLiabilities
WHERE
	NOT AssetsLiabilities.AssetRef IN (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOwnFundsInvestments), VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOwnFundsWithdrawals))

GROUP BY
	AssetsLiabilities.Recorder

HAVING
	SUM(AssetsLiabilities.SumReceipt) &lt;&gt; SUM(AssetsLiabilities.SumExpense)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN AssetsLiabilities.Recorder = UNDEFINED
			THEN NULL
		ELSE AssetsLiabilities.Recorder
	END AS Recorder,
	AssetsLiabilities.AssetRef AS AssetRef,
	AssetsLiabilities.SumReceipt AS SumReceipt,
	AssetsLiabilities.SumExpense AS SumExpense,
	BalanceControl.Control AS BalanceControl,
	AssetsLiabilities.Organization AS Organization,
	AssetsLiabilities.Department AS Department,
	AssetsLiabilities.LineOfBusiness AS LineOfBusiness
FROM
	AccumulationRegister.OtherAssetsLiabilities.Turnovers(, , Auto, {(LineOfBusiness), (Organization), (Department)}) AS AssetsLiabilities
		INNER JOIN TTBalanceControl AS BalanceControl
		ON AssetsLiabilities.Recorder = BalanceControl.Recorder
WHERE
	NOT AssetsLiabilities.AssetRef IN (VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOwnFundsInvestments), VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.ManBalanceOwnFundsWithdrawals))</query>
	</dataSet>
