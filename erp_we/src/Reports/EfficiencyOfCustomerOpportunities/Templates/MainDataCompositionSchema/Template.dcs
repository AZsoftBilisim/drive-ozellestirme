			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceParameters</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameters">
						<dcscor:item>
							<dcscor:choiceParameter>Filter.GenerationMethod</dcscor:choiceParameter>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.UpdateRegularly</dcscor:value>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.GenerateManually</dcscor:value>
						</dcscor:item>
					</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SalesOpportunitiesToCustomer.Status AS Status,
	SalesOpportunitiesToCustomer.Ref AS SalesOpportunity,
	SalesOpportunitiesToCustomer.SalesOpportunityKind AS SalesOpportunityKind,
	SalesOpportunitiesToCustomer.Partner AS Partner,
	SalesOpportunitiesToCustomer.EmployeeResponsible AS EmployeeResponsible,
	SalesOpportunitiesToCustomer.CustomerTermsOfSales AS CustomerTermsOfSales,
	1 AS TransactionNumber,
	SalesOpportunitiesToCustomer.PotentialSaleAmount AS PotentialSaleAmount
{SELECT
	Status.*,
	SalesOpportunity.*,
	SalesOpportunityKind.*,
	Partner.*,
	EmployeeResponsible.*,
	CustomerTermsOfSales.*,
	TransactionNumber,
	PotentialSaleAmount}
FROM
	Catalog.SalesOpportunitiesToCustomer AS SalesOpportunitiesToCustomer
WHERE
	NOT SalesOpportunitiesToCustomer.DeletionMark
{WHERE
	(SalesOpportunitiesToCustomer.StartDate &lt;= &amp;PeriodEnding),
	(SalesOpportunitiesToCustomer.EndDate &gt;= &amp;BeginOfPeriod
			OR SalesOpportunitiesToCustomer.EndDate = DATETIME(1, 1, 1)),
	SalesOpportunitiesToCustomer.EmployeeResponsible.*,
	SalesOpportunitiesToCustomer.CustomerTermsOfSales.*,
	SalesOpportunitiesToCustomer.SalesOpportunityKind.*,
	SalesOpportunitiesToCustomer.Status.*,
	(SalesOpportunitiesToCustomer.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	SalesOpportunitiesToCustomer.Partner.*}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>TransactionNumber.DeviationFromAverageByTransactionType</dataPath>
		<expression>0</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Quantity (variance from the average by sales opportunity kinds)</v8:content>
