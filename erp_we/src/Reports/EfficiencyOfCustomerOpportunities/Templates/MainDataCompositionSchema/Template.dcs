	<totalField>
		<dataPath>TransactionNumber</dataPath>
		<expression>Sum(TransactionNumber)</expression>
	</totalField>
	<totalField>
		<dataPath>PotentialSaleAmount</dataPath>
		<expression>Sum(PotentialSaleAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>TransactionNumber.DeviationFromAverageByTransactionType</dataPath>
		<expression>Sum(TransactionNumber) 
- Case 
    When EvalExpression("Count(Distinct SalesOpportunityKind)",,"Overall") &lt;&gt; 0 
    Then EvalExpression("Sum(TransactionNumber)",,"Overall") / EvalExpression("Count(Distinct SalesOpportunityKind)",,"Overall")
    Else 0 
  End</expression>
		<group>SalesOpportunityKind</group>
	</totalField>
	<totalField>
		<dataPath>PotentialSaleAmount.DeviationFromAverageByTransactionType</dataPath>
		<expression>Sum(PotentialSaleAmount) 
- Case 
    When EvalExpression("Count(Distinct SalesOpportunityKind)",,"Overall") &lt;&gt; 0 
    Then EvalExpression("Sum(PotentialSaleAmount)",,"Overall") / EvalExpression("Count(Distinct SalesOpportunityKind)",,"Overall")
    Else 0 
  End</expression>
		<group>SalesOpportunityKind</group>
	</totalField>
	<totalField>
		<dataPath>TransactionNumber.DeviationFromAverageByCustomers</dataPath>
		<expression>Sum(TransactionNumber) 
- Case 
    When EvalExpression("Count(Distinct Partner)",,"Overall") &lt;&gt; 0 
    Then EvalExpression("Sum(TransactionNumber)",,"Overall") / EvalExpression("Count(Distinct Partner)",,"Overall")
    Else 0 
  End</expression>
		<group>Partner</group>
		<group>Partner Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>PotentialSaleAmount.DeviationFromAverageByCustomers</dataPath>
		<expression>Sum(PotentialSaleAmount) 
- Case 
    When EvalExpression("Count(Distinct Partner)",,"Overall") &lt;&gt; 0 
    Then EvalExpression("Sum(PotentialSaleAmount)",,"Overall") / EvalExpression("Count(Distinct Partner)",,"Overall")
    Else 0 
  End</expression>
		<group>Partner</group>
		<group>Partner Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>TransactionNumber.DeviationFromAverageByResponsiblePersons</dataPath>
		<expression>Sum(TransactionNumber) 
- Case 
    When EvalExpression("Count(Distinct EmployeeResponsible)",,"Overall") &lt;&gt; 0 
    Then EvalExpression("Sum(TransactionNumber)",,"Overall") / EvalExpression("Count(Distinct EmployeeResponsible)",,"Overall")
    Else 0 
  End</expression>
		<group>EmployeeResponsible</group>
	</totalField>
	<totalField>
		<dataPath>PotentialSaleAmount.DeviationFromAverageByResponsiblePersons</dataPath>
		<expression>Sum(PotentialSaleAmount) 
- Case 
    When EvalExpression("Count(Distinct EmployeeResponsible)",,"Overall") &lt;&gt; 0 
    Then EvalExpression("Sum(PotentialSaleAmount)",,"Overall") / EvalExpression("Count(Distinct EmployeeResponsible)",,"Overall")
    Else 0 
  End</expression>
		<group>EmployeeResponsible</group>
	</totalField>
	<totalField>
		<dataPath>TransactionNumber.DeviationFromAverageByAgreements</dataPath>
		<expression>Sum(TransactionNumber) 
- Case 
    When EvalExpression("Count(Distinct CustomerTermsOfSales)",,"Overall") &lt;&gt; 0 
    Then EvalExpression("Sum(TransactionNumber)",,"Overall") / EvalExpression("Count(Distinct CustomerTermsOfSales)",,"Overall")
    Else 0 
  End</expression>
		<group>CustomerTermsOfSales</group>
	</totalField>
	<totalField>
		<dataPath>PotentialSaleAmount.DeviationFromAverageByAgreements</dataPath>
		<expression>Sum(PotentialSaleAmount) 
- Case 
    When EvalExpression("Count(Distinct CustomerTermsOfSales)",,"Overall") &lt;&gt; 0 
    Then EvalExpression("Sum(PotentialSaleAmount)",,"Overall") / EvalExpression("Count(Distinct CustomerTermsOfSales)",,"Overall")
    Else 0 
  End</expression>
		<group>CustomerTermsOfSales</group>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
