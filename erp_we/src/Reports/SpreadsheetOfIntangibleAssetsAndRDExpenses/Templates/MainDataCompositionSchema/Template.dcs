	<totalField>
		<dataPath>DepreciationClosingBalance</dataPath>
		<expression>Sum(DepreciationClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>DepreciationOpeningBalance</dataPath>
		<expression>Sum(DepreciationOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>DepreciationReceipt</dataPath>
		<expression>Sum(DepreciationReceipt)</expression>
	</totalField>
