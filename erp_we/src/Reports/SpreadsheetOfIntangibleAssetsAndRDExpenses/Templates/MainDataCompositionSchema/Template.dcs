			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Dichiarazione per beni immateriali e spese in Ricerca&amp;Sviluppo (contabilità)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Zestawienie według aktywów niematerialnych i rozchodów na B+R (ewidencja księgowa)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ведомость по НМА и расходам на НИОКР (бухгалтерский учет)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Maddi olmayan varlıklar ve Ar-Ge harcamalarına ilişkin bildiri (muhasebe)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Bảng kê TSCĐ vô hình và chi phí nghiên cứu, triển khai (kế toán doanh nghiệp)</v8:content>
			</v8:item>
		</dcsset:presentation>
