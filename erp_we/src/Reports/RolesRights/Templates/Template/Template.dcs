					<v8:content>Mã phần tử</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Case
	When ItemPresentation = TagName Then ItemPresentation
	When &amp;NameFormatSelected = 1 Then TagName
	When &amp;NameFormatSelected = 2 Then ItemPresentation + " (" + TagName + ")"
	When &amp;NameFormatSelected = 3 Then TagName + " (" + ItemPresentation + ")"
	Else ItemPresentation
End</presentationExpression>
