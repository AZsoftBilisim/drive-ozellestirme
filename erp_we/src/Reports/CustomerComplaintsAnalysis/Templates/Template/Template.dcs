{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(CustomerClaims.RegistrationDate, MONTH) AS Month,
	COUNT(DISTINCT CustomerClaims.Ref) AS NumberOfClaimsDynamics,
	CASE
		WHEN CustomerClaims.Status = VALUE(Enum.CustomerComplaintStatuses.Fulfilled_)
				OR CustomerClaims.Status = VALUE(Enum.CustomerComplaintStatuses.NotFulfilled_)
			THEN TRUE
		ELSE FALSE
	END AS Completed_
FROM
	Catalog.Complaints AS CustomerClaims
WHERE
	(NOT CustomerClaims.DeletionMark)
	AND (NOT CustomerClaims.ThisIsClaimToVendor)
{WHERE
	(CustomerClaims.RegistrationDate BETWEEN &amp;StartDate AND &amp;EndDate),
	(CustomerClaims.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	MONTH(CustomerClaims.RegistrationDate),
	YEAR(CustomerClaims.RegistrationDate),
	BEGINOFPERIOD(CustomerClaims.RegistrationDate, MONTH),
	CASE
		WHEN CustomerClaims.Status = VALUE(Enum.CustomerComplaintStatuses.Fulfilled_)
				OR CustomerClaims.Status = VALUE(Enum.CustomerComplaintStatuses.NotFulfilled_)
			THEN TRUE
		ELSE FALSE
	END</query>
	</dataSet>
