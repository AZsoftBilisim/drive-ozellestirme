		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT TOP 5
	COUNT(DISTINCT CustomerClaims.Ref) AS Count,
	CustomerClaims.GuiltyBusinessUnit AS Department
INTO NotOther
FROM
	Catalog.Complaints AS CustomerClaims
WHERE
	(NOT CustomerClaims.DeletionMark)
	AND (NOT CustomerClaims.ThisIsClaimToVendor)
{WHERE
	CustomerClaims.RegistrationDate BETWEEN &amp;StartDate AND &amp;EndDate,
	(CustomerClaims.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	CustomerClaims.GuiltyBusinessUnit
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	COUNT(DISTINCT CustomerClaims.Ref) AS NumberByDivisionDynamics,
	CustomerClaims.GuiltyBusinessUnit AS GuiltyDivision,
	BEGINOFPERIOD(CustomerClaims.RegistrationDate, MONTH) AS DivisionPeriod,
	0 AS AddAdjustmentDepartmentAttributes
FROM
	Catalog.Complaints AS CustomerClaims
WHERE
	(NOT CustomerClaims.DeletionMark)
	AND (NOT CustomerClaims.ThisIsClaimToVendor)
	AND CustomerClaims.GuiltyBusinessUnit IN
			(SELECT
				NotOther.Department
			FROM
				NotOther)
{WHERE
	CustomerClaims.RegistrationDate BETWEEN &amp;StartDate AND &amp;EndDate}

GROUP BY
	CustomerClaims.GuiltyBusinessUnit,
	BEGINOFPERIOD(CustomerClaims.RegistrationDate, MONTH)

UNION ALL

SELECT
	NestedQuery.Count,
	&amp;LineOther_,
	NestedQuery.Period,
	1
FROM
	(SELECT
		COUNT(DISTINCT CustomerClaims.Ref) AS Count,
		BEGINOFPERIOD(CustomerClaims.RegistrationDate, MONTH) AS Period
	FROM
		Catalog.Complaints AS CustomerClaims
	WHERE
		(NOT CustomerClaims.DeletionMark)
		AND (NOT CustomerClaims.ThisIsClaimToVendor)
		AND (NOT CustomerClaims.GuiltyBusinessUnit IN
					(SELECT
						NotOther.Department
					FROM
						NotOther))
{WHERE
	CustomerClaims.RegistrationDate BETWEEN &amp;StartDate AND &amp;EndDate}
	
	GROUP BY
		BEGINOFPERIOD(CustomerClaims.RegistrationDate, MONTH)) AS NestedQuery</query>
	</dataSet>
