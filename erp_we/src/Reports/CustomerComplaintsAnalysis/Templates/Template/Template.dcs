			</title>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.ComplaintReasons</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
