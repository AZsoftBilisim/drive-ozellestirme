      Then NStr("ru = 'По всем складам'; vi = 'Theo tất cả các kho'; en = 'In all warehouses'; it = 'Per tutti i magazzini'; pl = 'Dla wszystkich magazynów'; tr = 'Tüm ambarlara göre'") 
    Else Warehouse  
End</expression>
		<title xsi:type="v8:LocalStringType">
