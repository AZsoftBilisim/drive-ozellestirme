					</dcsset:lwsTitle>
					<dcsset:detailExpression>100 * Case
	When Sum(DemandPlans) = 0
		Then 1
	Else Sum(FulfillmentPlans) / Sum(DemandPlans) - 1
End</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>100 * Case
	When Sum(DemandPlans) = 0
		Then 1
	Else Sum(FulfillmentPlans) / Sum(DemandPlans) - 1
End</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression>100 * Case
	When Sum(DemandPlans) = 0
		Then 1
	Else Sum(FulfillmentPlans) / Sum(DemandPlans) - 1
End</dcsset:totalExpression>
					<dcsset:totalExpressionPresentation>100 * Case
	When Sum(DemandPlans) = 0
		Then 1
	Else Sum(FulfillmentPlans) / Sum(DemandPlans) - 1
End</dcsset:totalExpressionPresentation>
				</dcsset:item>
