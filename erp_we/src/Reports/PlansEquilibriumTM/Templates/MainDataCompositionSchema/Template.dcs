			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cân bằng kế hoạch theo thời kỳ</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:userFields>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>UserFields.Field1</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Variance percent</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>درصد انحراف</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Deviazione percentuale</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Odchylenie procent</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Отклонение процент</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Fark yüzde</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Chênh lệch phần trăm</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:detailExpression>100 * Case
	When Sum(DemandPlans) = 0
		Then 1
	Else Sum(FulfillmentPlans) / Sum(DemandPlans) - 1
End</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>100 * Case
	When Sum(DemandPlans) = 0
		Then 1
	Else Sum(FulfillmentPlans) / Sum(DemandPlans) - 1
End</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression>100 * Case
	When Sum(DemandPlans) = 0
		Then 1
	Else Sum(FulfillmentPlans) / Sum(DemandPlans) - 1
End</dcsset:totalExpression>
					<dcsset:totalExpressionPresentation>100 * Case
	When Sum(DemandPlans) = 0
		Then 1
	Else Sum(FulfillmentPlans) / Sum(DemandPlans) - 1
End</dcsset:totalExpressionPresentation>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>UserFields.Field2</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Variance</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>انحراف</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Variazione</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Odchylenie</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Отклонение</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Fark</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Chênh lệch</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:detailExpression>Sum(FulfillmentPlans) - Sum(DemandPlans)</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>Sum(FulfillmentPlans) - Sum(DemandPlans)</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(FulfillmentPlans) - Sum(DemandPlans)
End</dcsset:totalExpression>
					<dcsset:totalExpressionPresentation>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(FulfillmentPlans) - Sum(DemandPlans)
End</dcsset:totalExpressionPresentation>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>UserFields.Field3</dcsset:dataPath>
					<dcsset:lwsTitle>
