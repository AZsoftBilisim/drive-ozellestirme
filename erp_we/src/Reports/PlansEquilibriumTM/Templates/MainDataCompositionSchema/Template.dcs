	<totalField>
		<dataPath>PurchasePlan</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(PurchasePlan)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SalesPlan</dataPath>
