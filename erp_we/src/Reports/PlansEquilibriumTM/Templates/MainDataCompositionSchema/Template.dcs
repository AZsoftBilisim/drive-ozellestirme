					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>OrderDate</dataPath>
				<field>OrderDate</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DATEADD(&amp;BeginOfPeriod, MONTH, DateDiff.PeriodNumberFromRange) AS Date
INTO Dates
FROM
	(SELECT
		cc.c * 10 + dd.d AS PeriodNumberFromRange
	FROM
		(SELECT
			0 AS c
		
		UNION ALL
		
		SELECT
			1
		
		UNION ALL
		
		SELECT
			2
		
		UNION ALL
		
		SELECT
			3
		
		UNION ALL
		
		SELECT
			4
		
		UNION ALL
		
		SELECT
			5
		
		UNION ALL
		
		SELECT
			6
		
		UNION ALL
		
		SELECT
			7
		
		UNION ALL
		
		SELECT
			8
		
		UNION ALL
		
		SELECT
			9) AS cc
			FULL JOIN (SELECT
				0 AS d
			
			UNION ALL
			
			SELECT
				1
			
			UNION ALL
			
			SELECT
				2
			
			UNION ALL
			
			SELECT
				3
			
			UNION ALL
			
			SELECT
				4
			
			UNION ALL
			
			SELECT
				5
			
			UNION ALL
			
			SELECT
				6
			
			UNION ALL
			
			SELECT
				7
			
			UNION ALL
			
			SELECT
				8
			
			UNION ALL
			
			SELECT
				9) AS dd
			ON (TRUE)
	WHERE
		DATEADD(&amp;BeginOfPeriod, MONTH, cc.c * 10 + dd.d) &lt;= &amp;PeriodEnding) AS DateDiff

;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	PlanOfGoodsStock.BeginOfPeriod AS BeginOfPeriod,
	TRUE AS ThereIsPlanOfRemnants
INTO BalancePlansByPeriod
FROM
	Document.PlanOfGoodsStock AS PlanOfGoodsStock
WHERE
	PlanOfGoodsStock.Scenario = &amp;Scenario
	AND (PlanOfGoodsStock.BeginOfPeriod = &amp;BalanceAccumulationStartDate
			OR &amp;ByPeriods
				AND PlanOfGoodsStock.BeginOfPeriod &gt; &amp;BalanceAccumulationStartDate)
	AND PlanOfGoodsStock.Posted
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Dates.Date AS Date,
	MAX(ISNULL(BalancePlansByPeriod.BeginOfPeriod, DATETIME(1, 1, 1, 0, 0, 0))) AS
		CurrentBalancePlanPeriod
INTO CurrentPeriodsOfBalancePlanByDate
FROM
	Dates AS Dates
		LEFT JOIN BalancePlansByPeriod AS BalancePlansByPeriod
		ON (BalancePlansByPeriod.BeginOfPeriod &lt;= Dates.Date)
GROUP BY
	Dates.Date
;
////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	CASE
		WHEN PurchasePlansTurnovers.Period &gt;= &amp;BeginOfPeriod
			THEN BEGINOFPERIOD(PurchasePlansTurnovers.Period, MONTH)
		ELSE &amp;BeginOfPeriod
	END AS Period,
	PurchasePlansTurnovers.Recorder AS Recorder,
	PurchasePlansTurnovers.Products AS Products,
	PurchasePlansTurnovers.Characteristic AS Characteristic,
	CASE
		WHEN PurchasePlansTurnovers.Period &gt;= &amp;BeginOfPeriod
			THEN CASE
				WHEN PurchasePlansTurnovers.ToOrderTurnover &lt;&gt; 0
					THEN PurchasePlansTurnovers.ToOrderTurnover
				ELSE PurchasePlansTurnovers.CountTurnover
			END
		ELSE 0
	END AS PurchasePlan,
	CASE
		WHEN PurchasePlansTurnovers.Period &lt; &amp;BeginOfPeriod
			THEN CASE
				WHEN PurchasePlansTurnovers.ToOrderTurnover &lt;&gt; 0
					THEN PurchasePlansTurnovers.ToOrderTurnover
				ELSE PurchasePlansTurnovers.CountTurnover
			END
		ELSE 0
	END AS PlanOfGoodsStock,
	0 AS SalesPlan,
	0 AS AssemblyScheduleKits,
	0 AS DisassemblyScheduleKits,
	0 AS AssemblyScheduleComponents,
	0 AS DisassemblyScheduleComponents,
	0 AS InventoryConsumptionPlan,
	0 AS DemandAdjustment,
	1 AS PlanType,
	PurchasePlansTurnovers.Scenario AS Scenario,
	PurchasePlansTurnovers.Warehouse AS Warehouse,
	CASE
		WHEN &amp;PlanningByAssignments
			THEN PurchasePlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose
INTO TurnoverPlans
FROM
	AccumulationRegister.PurchasePlans.Turnovers({(&amp;BalanceAccumulationStartDate)}, {(&amp;PeriodEnding)}, Record,
		Scenario = &amp;Scenario {((Products, Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment AS SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS
		PurchasePlansTurnovers

UNION ALL

SELECT
	CASE
		WHEN TurnoverBalancePlans.Period &gt;= &amp;BeginOfPeriod
			THEN BEGINOFPERIOD(TurnoverBalancePlans.Period, MONTH)
		ELSE &amp;BeginOfPeriod
	END,
	TurnoverBalancePlans.Recorder,
	TurnoverBalancePlans.Products,
	TurnoverBalancePlans.Characteristic,
	0,
	CASE
		WHEN TurnoverBalancePlans.ToOrderTurnover &lt;&gt; 0
			THEN TurnoverBalancePlans.ToOrderTurnover
		ELSE TurnoverBalancePlans.CountTurnover
	END,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	7,
	TurnoverBalancePlans.Scenario,
	TurnoverBalancePlans.Warehouse,
	CASE
		WHEN &amp;PlanningByAssignments
			THEN TurnoverBalancePlans.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END
FROM
	AccumulationRegister.PlansOfGoodsStock.Turnovers({(&amp;BalanceAccumulationStartDate)}, {(&amp;EndOfBalanceAccumulationPeriod)},
		Record, Scenario = &amp;Scenario {((Products, Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment AS SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS
		TurnoverBalancePlans

UNION ALL

SELECT
	CASE
		WHEN SalesPlansTurnovers.Period &gt;= &amp;BeginOfPeriod
			THEN BEGINOFPERIOD(SalesPlansTurnovers.Period, MONTH)
		ELSE &amp;BeginOfPeriod
	END,
	SalesPlansTurnovers.Recorder,
	SalesPlansTurnovers.Products,
	SalesPlansTurnovers.Characteristic,
	0,
	CASE
		WHEN SalesPlansTurnovers.Period &lt; &amp;BeginOfPeriod
			THEN CASE
				WHEN SalesPlansTurnovers.ToOrderTurnover &lt;&gt; 0
					THEN -SalesPlansTurnovers.ToOrderTurnover
				ELSE -SalesPlansTurnovers.CountTurnover
			END
		ELSE 0
	END,
	CASE
		WHEN SalesPlansTurnovers.Period &gt;= &amp;BeginOfPeriod
			THEN CASE
				WHEN SalesPlansTurnovers.ToOrderTurnover &lt;&gt; 0
					THEN SalesPlansTurnovers.ToOrderTurnover
				ELSE SalesPlansTurnovers.CountTurnover
			END
		ELSE 0
	END,
	0,
	0,
	0,
	0,
	0,
	0,
	2,
	SalesPlansTurnovers.Scenario,
	SalesPlansTurnovers.Warehouse,
	CASE
		WHEN &amp;PlanningByAssignments
			THEN SalesPlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END
FROM
	AccumulationRegister.SalesPlans.Turnovers({(&amp;BalanceAccumulationStartDate)}, {(&amp;PeriodEnding)}, Record,
		Scenario = &amp;Scenario {((Products, Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment AS SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS
		SalesPlansTurnovers

UNION ALL

SELECT
	CASE
		WHEN AssemblyPlansDisassemblyRevolutions.Period &gt;= &amp;BeginOfPeriod
			THEN BEGINOFPERIOD(AssemblyPlansDisassemblyRevolutions.Period, MONTH)
		ELSE &amp;BeginOfPeriod
	END,
	AssemblyPlansDisassemblyRevolutions.Recorder,
	AssemblyPlansDisassemblyRevolutions.Products,
	AssemblyPlansDisassemblyRevolutions.Characteristic,
	0,
	CASE
		WHEN AssemblyPlansDisassemblyRevolutions.Period &lt; &amp;BeginOfPeriod
			THEN CASE
				WHEN AssemblyPlansDisassemblyRevolutions.ToOrderTurnover &lt;&gt; 0
					THEN AssemblyPlansDisassemblyRevolutions.ToOrderTurnover
				ELSE AssemblyPlansDisassemblyRevolutions.CountTurnover
			END
		ELSE 0
	END,
	0,
	CASE
		WHEN AssemblyPlansDisassemblyRevolutions.Period &gt;= &amp;BeginOfPeriod
			THEN CASE
				WHEN AssemblyPlansDisassemblyRevolutions.ToOrderTurnover &lt;&gt; 0
					THEN AssemblyPlansDisassemblyRevolutions.ToOrderTurnover
				ELSE AssemblyPlansDisassemblyRevolutions.CountTurnover
			END
		ELSE 0
	END,
	0,
	0,
	0,
