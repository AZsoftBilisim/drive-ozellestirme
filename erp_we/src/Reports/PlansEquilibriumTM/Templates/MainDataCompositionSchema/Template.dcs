UNION ALL

SELECT
	CASE
		WHEN AdjustmentsToPlannedDemandsTurnovers.Period &gt;= &amp;BeginOfPeriod
			THEN BEGINOFPERIOD(AdjustmentsToPlannedDemandsTurnovers.Period, MONTH)
		ELSE &amp;BeginOfPeriod
	END,
	AdjustmentsToPlannedDemandsTurnovers.Recorder,
	AdjustmentsToPlannedDemandsTurnovers.Products,
	AdjustmentsToPlannedDemandsTurnovers.Characteristic,
	0,
	CASE
		WHEN AdjustmentsToPlannedDemandsTurnovers.Period &lt; &amp;BeginOfPeriod
			THEN -AdjustmentsToPlannedDemandsTurnovers.CountTurnover
		ELSE 0
	END,
	0,
	0,
	0,
	0,
	0,
	0,
	CASE
		WHEN AdjustmentsToPlannedDemandsTurnovers.Period &gt;= &amp;BeginOfPeriod
			THEN AdjustmentsToPlannedDemandsTurnovers.CountTurnover
		ELSE 0
	END,
	10,
	AdjustmentsToPlannedDemandsTurnovers.Scenario,
	VALUE(Catalog.Warehouses.EmptyRef),
	CASE
		WHEN &amp;PlanningByAssignments
			THEN AdjustmentsToPlannedDemandsTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END
FROM
	AccumulationRegister.AdjustmentsToPlannedDemands.Turnovers({(&amp;BalanceAccumulationStartDate)}, {(&amp;PeriodEnding)},
		Record, Scenario = &amp;Scenario {((Products, Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment AS SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS
		AdjustmentsToPlannedDemandsTurnovers
;
////////////////////////////////////////////////////////////////////////////////
 SELECT
	TurnoverPlans.Period AS Period,
	TurnoverPlans.Recorder AS Recorder,
	TurnoverPlans.Products AS Products,
	TurnoverPlans.Characteristic AS Characteristic,
	TurnoverPlans.PurchasePlan AS PurchasePlan,
	TurnoverPlans.PlanOfGoodsStock AS PlanOfGoodsStock,
	TurnoverPlans.SalesPlan AS SalesPlan,
	TurnoverPlans.AssemblyScheduleKits AS AssemblyScheduleKits,
	TurnoverPlans.DisassemblyScheduleKits AS DisassemblyScheduleKits,
	TurnoverPlans.AssemblyScheduleComponents AS AssemblyScheduleComponents,
	TurnoverPlans.DisassemblyScheduleComponents AS DisassemblyScheduleComponents,
	TurnoverPlans.InventoryConsumptionPlan AS InventoryConsumptionPlan,
	TurnoverPlans.DemandAdjustment AS DemandAdjustment,
	TurnoverPlans.PlanType AS PlanType,
	TurnoverPlans.Scenario AS Scenario,
	TurnoverPlans.Warehouse AS Warehouse,
	TurnoverPlans.Purpose AS Purpose,
	CurrentPeriodsOfBalancePlanByDate.CurrentBalancePlanPeriod AS CurrentBalancePlanPeriod
FROM
	TurnoverPlans AS TurnoverPlans
		LEFT JOIN CurrentPeriodsOfBalancePlanByDate AS CurrentPeriodsOfBalancePlanByDate
		ON (CurrentPeriodsOfBalancePlanByDate.Date = TurnoverPlans.Period)</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>SetOfComparisonScenarios</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Purpose</dataPath>
				<field>Purpose</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Characteristic</dataPath>
				<field>Characteristic</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Plan</dataPath>
				<field>Plan</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ProductSegment</dataPath>
				<field>ProductSegment</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Inventory segment</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>بخش موجودی</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Segmento degli articoli</v8:content>
					</v8:item>
					<v8:item>
