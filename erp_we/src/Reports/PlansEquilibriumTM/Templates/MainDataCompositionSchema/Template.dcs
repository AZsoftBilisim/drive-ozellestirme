					THEN -AssemblyPlansDisassemblyRevolutions.ToOrderTurnover
				ELSE -AssemblyPlansDisassemblyRevolutions.CountTurnover
			END
		ELSE 0
	END,
	0,
	0,
	CASE
		WHEN AssemblyPlansDisassemblyRevolutions.Period &gt;= &amp;BeginOfPeriod
			THEN CASE
				WHEN AssemblyPlansDisassemblyRevolutions.ToOrderTurnover &lt;&gt; 0
					THEN AssemblyPlansDisassemblyRevolutions.ToOrderTurnover
