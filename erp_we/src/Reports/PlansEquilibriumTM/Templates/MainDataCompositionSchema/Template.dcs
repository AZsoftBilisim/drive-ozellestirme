	</totalField>
	<totalField>
		<dataPath>BuildPlanForScenarios</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(BuildPlanForScenarios)
End</expression>
	</totalField>
	<totalField>
		<dataPath>BuildPlanScenarioKits</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(BuildPlanScenarioKits)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AdjustingScenarioNeeds</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(AdjustingScenarioNeeds)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ScenarioNeedsPlans</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(ScenarioNeedsPlans)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ScenarioAssurancePlans</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(ScenarioAssurancePlans)
End</expression>
	</totalField>
	<totalField>
		<dataPath>IncreasingInitialRemainder</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Case When Period &gt; &amp;BeginOfPeriod Then Sum(PlanScenarioBalancesByPeriod) + Sum(ScenarioAssurancePlansBottomLine) - Sum(ScenarioNeedsPlansBottomLine) Else Sum(PlanScenarioBalancesByPeriod) End
End</expression>
	</totalField>
	<totalField>
		<dataPath>ScenarioRemainderPlan</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1
		Then 0
	Else Sum(ScenarioRemainderPlan)
End</expression>
	</totalField>
