					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Gereksinimlerin düzeltilmesi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Điều chỉnh nhu cầu</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>PlanProfileStage</dataPath>
				<field>PlanProfileStage</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>InventoryConsumptionPlan</dataPath>
				<field>InventoryConsumptionPlan</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Inventory consumption plan</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>برنامه مصرف موجودی</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Piano di consumi interni</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Plan konsumpcji wewnętrznych</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>План внутренних потреблений</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>İç tüketim planı</v8:content>
					</v8:item>
					<v8:item>
