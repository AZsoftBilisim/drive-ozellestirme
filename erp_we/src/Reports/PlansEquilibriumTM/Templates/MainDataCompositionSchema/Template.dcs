		Scenario = &amp;Scenario
	AND BusinessOperation = VALUE(Enum.BusinessTransactions.DisassemblyIntoComponents) {((Products,
		Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
