		Scenario = &amp;Scenario
	AND BusinessOperation = VALUE(Enum.BusinessTransactions.AssemblyFromComponents) {((Products, Characteristic)
		IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment AS SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS
		AssemblyPlansDisassemblyRevolutions

UNION ALL

SELECT
	CASE
		WHEN PlansForConsumptionOfComponentsTurnover.Period &gt;= &amp;BeginOfPeriod
			THEN BEGINOFPERIOD(PlansForConsumptionOfComponentsTurnover.Period, MONTH)
		ELSE &amp;BeginOfPeriod
	END,
	PlansForConsumptionOfComponentsTurnover.Recorder,
	PlansForConsumptionOfComponentsTurnover.Products,
	PlansForConsumptionOfComponentsTurnover.Characteristic,
	0,
	CASE
		WHEN PlansForConsumptionOfComponentsTurnover.Period &lt; &amp;BeginOfPeriod
			THEN CASE
				WHEN PlansForConsumptionOfComponentsTurnover.ToOrderTurnover &lt;&gt; 0
					THEN PlansForConsumptionOfComponentsTurnover.ToOrderTurnover
				ELSE PlansForConsumptionOfComponentsTurnover.CountTurnover
			END
		ELSE 0
	END,
	0,
	0,
	0,
	0,
	CASE
		WHEN PlansForConsumptionOfComponentsTurnover.Period &gt;= &amp;BeginOfPeriod
			THEN CASE
				WHEN PlansForConsumptionOfComponentsTurnover.ToOrderTurnover &lt;&gt; 0
					THEN PlansForConsumptionOfComponentsTurnover.ToOrderTurnover
				ELSE PlansForConsumptionOfComponentsTurnover.CountTurnover
			END
		ELSE 0
	END,
	0,
	0,
	4,
	PlansForConsumptionOfComponentsTurnover.Scenario,
	PlansForConsumptionOfComponentsTurnover.Warehouse,
	CASE
		WHEN &amp;PlanningByAssignments
			THEN PlansForConsumptionOfComponentsTurnover.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END
FROM
	AccumulationRegister.ComponentsConsumptionPlans.Turnovers({(&amp;BalanceAccumulationStartDate)}, {(&amp;PeriodEnding)},
		Record, Scenario = &amp;Scenario
	AND BusinessOperation = VALUE(Enum.BusinessTransactions.DisassemblyIntoComponents) {((Products,
		Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment AS SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
		(Products).* AS ProductsKit, (Characteristic).* AS CharacteristicSet}) AS
		PlansForConsumptionOfComponentsTurnover

UNION ALL

SELECT
	CASE
		WHEN PlansForConsumptionOfComponentsTurnover.Period &gt;= &amp;BeginOfPeriod
			THEN BEGINOFPERIOD(PlansForConsumptionOfComponentsTurnover.Period, MONTH)
		ELSE &amp;BeginOfPeriod
	END,
	PlansForConsumptionOfComponentsTurnover.Recorder,
	PlansForConsumptionOfComponentsTurnover.Products,
	PlansForConsumptionOfComponentsTurnover.Characteristic,
	0,
	CASE
		WHEN PlansForConsumptionOfComponentsTurnover.Period &lt; &amp;BeginOfPeriod
			THEN CASE
				WHEN PlansForConsumptionOfComponentsTurnover.ToOrderTurnover &lt;&gt; 0
					THEN -PlansForConsumptionOfComponentsTurnover.ToOrderTurnover
				ELSE -PlansForConsumptionOfComponentsTurnover.CountTurnover
			END
		ELSE 0
	END,
	0,
	0,
