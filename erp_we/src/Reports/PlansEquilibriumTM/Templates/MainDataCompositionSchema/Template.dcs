		<expression>IsNull(EvalExpression("Sum(FulfillmentPlans)", "Period", , "BoundaryValue(CurrentBalancePlanPeriod)", "Current"), 0)</expression>
	</totalField>
	<totalField>
		<dataPath>IncrementalCosts</dataPath>
		<expression>IsNull(EvalExpression("Sum(DemandPlans)", "Period", , "BoundaryValue(CurrentBalancePlanPeriod)", "Current"), 0)</expression>
	</totalField>
