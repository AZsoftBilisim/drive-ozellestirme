		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ProcurementPlanDeviation</dataPath>
		<expression>Case
	When &amp;ScenarioComparison
		Then Case
				When &amp;ByPeriods
					Then IsNull(EvalExpression("PurchasePlan", "Period"), 0)
				Else IsNull(EvalExpression("PurchasePlan", "RejectionHeader"), 0)
			End - Case
				When ScenarioProcurementPlan &lt;&gt; 0
					Then ScenarioProcurementPlan
				Else 0
			End
	Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Purchase plan deviation</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
