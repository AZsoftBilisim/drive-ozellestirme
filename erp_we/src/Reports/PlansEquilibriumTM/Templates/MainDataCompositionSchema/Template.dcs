			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>SalesPlanDeviation</dataPath>
		<expression>Case
	When &amp;ScenarioComparison
		Then Case
				When &amp;ByPeriods
					Then IsNull(EvalExpression("SalesPlan", "Period"), 0)
				Else IsNull(EvalExpression("SalesPlan", "RejectionHeader"), 0)
			End - Case
				When ScenarioSalesPlan &lt;&gt; 0
					Then ScenarioSalesPlan
				Else 0
			End
	Else 0
End</expression>
