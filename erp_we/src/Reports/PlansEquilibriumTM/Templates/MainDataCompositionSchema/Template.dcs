UNION ALL

SELECT
	CASE
		WHEN InventoryConsumptionPlansTurnovers.Period &gt;= &amp;BeginOfPeriod
			THEN BEGINOFPERIOD(InventoryConsumptionPlansTurnovers.Period, MONTH)
		ELSE &amp;BeginOfPeriod
	END,
	InventoryConsumptionPlansTurnovers.Recorder,
	InventoryConsumptionPlansTurnovers.Products,
	InventoryConsumptionPlansTurnovers.Characteristic,
	0,
	CASE
		WHEN InventoryConsumptionPlansTurnovers.Period &lt; &amp;BeginOfPeriod
			THEN CASE
				WHEN InventoryConsumptionPlansTurnovers.ToOrderTurnover &lt;&gt; 0
					THEN -InventoryConsumptionPlansTurnovers.ToOrderTurnover
				ELSE -InventoryConsumptionPlansTurnovers.CountTurnover
			END
		ELSE 0
	END,
	0,
	0,
	0,
	0,
	0,
	CASE
		WHEN InventoryConsumptionPlansTurnovers.Period &gt;= &amp;BeginOfPeriod
			THEN CASE
				WHEN InventoryConsumptionPlansTurnovers.ToOrderTurnover &lt;&gt; 0
					THEN InventoryConsumptionPlansTurnovers.ToOrderTurnover
				ELSE InventoryConsumptionPlansTurnovers.CountTurnover
			END
