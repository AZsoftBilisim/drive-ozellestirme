	<totalField>
		<dataPath>VolumeVoid</dataPath>
		<expression>Case
    When Sum(BinVolumeUsable) - Sum(Case
       When NotLimitedByDimensions
            Then 0
        Else IsNull(InStockBalance, 0) * IsNull(PackageVolume, 0)
    End) &lt; 0
    Then 0
    Else Sum(BinVolumeUsable) - Sum(Case
        When NotLimitedByDimensions
            Then 0
        Else IsNull(InStockBalance, 0) * IsNull(PackageVolume, 0)
    End)
End</expression>
		<group>Address</group>
		<group>StorageArea</group>
		<group>Premise</group>
		<group>WarehouseZone</group>
		<group>Warehouse</group>
