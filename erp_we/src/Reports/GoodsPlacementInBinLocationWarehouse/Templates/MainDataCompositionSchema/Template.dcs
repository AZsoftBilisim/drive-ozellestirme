	<calculatedField>
		<dataPath>OverloadedBins</dataPath>
		<expression>Case
	When Case
		When BinVolumeUsable &lt;&gt; 0 Then
			Case
		When NotLimitedByDimensions
			Then 0
		Else IsNull(InStockBalance, 0) * IsNull(PackageVolume, 0)
	End / BinVolumeUsable * 100
		Else 0
	End &gt; 100 Or 
	Case
    	When CarryingCapacityOfStorageBinUseful &lt;&gt; 0 Then
	        Case
		When NotLimitedByCarryingCapacity
			Then 0
		Else IsNull(InStockBalance, 0) * IsNull(PackageWeight, 0)
	End / CarryingCapacityOfStorageBinUseful * 100
    	Else 0
	End &gt; 100 Then 1
	Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Overloaded bins</v8:content>
			</v8:item>
