		<group>Package</group>
		<group>Package Hierarchy</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>OverfillingVolume</dataPath>
		<expression>Case
    When Sum(BinVolumeUsable) - Sum(Case
       When NotLimitedByDimensions
            Then 0
        Else IsNull(InStockBalance, 0) * IsNull(PackageVolume, 0)
    End) &lt; 0
    Then -Sum(BinVolumeUsable) + Sum(Case
        When NotLimitedByDimensions
            Then 0
        Else IsNull(InStockBalance, 0) * IsNull(PackageVolume, 0)
    End)
    Else 0
End</expression>
		<group>Address</group>
