		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	StorageBins.Owner AS Warehouse,
	StorageBins.Premise,
	StorageBins.StorageArea,
	StorageBins.WarehouseZone,
	StorageBins.Ref AS Address,
	TRUE AS AddressFlag,
	StorageBins.StorageBinType,
	ISNULL(StorageBins.StandardSize.NotLimitedByDimensions, TRUE) AS NotLimitedByDimensions,
	StorageBins.MaximumFillingRateByVolume,
	StorageBins.StandardSize.VolumeM3 * ((StorageBins.StandardSize.VolumeUnitOfMeasure.Numerator / StorageBins.StandardSize.VolumeUnitOfMeasure.Denominator) / &amp;NumberOfCubicMetersPerUnitOfVolume) AS StorageBinVolume,
	StorageBins.StandardSize.VolumeM3 * ((StorageBins.StandardSize.VolumeUnitOfMeasure.Numerator / StorageBins.StandardSize.VolumeUnitOfMeasure.Denominator) / &amp;NumberOfCubicMetersPerUnitOfVolume) * StorageBins.MaximumFillingRateByVolume / 100 AS BinVolumeUsable,
	StorageBins.StandardSize.NotLimitedByCarryingCapacity AS NotLimitedByCarryingCapacity,
	StorageBins.MaximumFillingRateByWeight,
	StorageBins.StandardSize.CarryingCapacity * ((StorageBins.StandardSize.WeightUnitOfMeasure.Numerator / StorageBins.StandardSize.WeightUnitOfMeasure.Denominator) / &amp;NumberOfKgPerUnitOfWeight) AS CarryingCapacityOfStorageBin,
	StorageBins.StandardSize.CarryingCapacity * ((StorageBins.StandardSize.WeightUnitOfMeasure.Numerator / StorageBins.StandardSize.WeightUnitOfMeasure.Denominator) / &amp;NumberOfKgPerUnitOfWeight) * StorageBins.MaximumFillingRateByWeight / 100 AS CarryingCapacityOfStorageBinUseful,
	StorageBinsLocks.LockType
FROM
	Catalog.StorageBins AS StorageBins
		LEFT JOIN InformationRegister.StorageBinsLocks AS StorageBinsLocks
		ON StorageBins.Ref = StorageBinsLocks.Cell
WHERE
	NOT StorageBins.StorageArea IS NULL 
	AND CASE
			WHEN StorageBins.Owner.UseWarerooms
				THEN StorageBins.Premise.UseBinLocationWarehousing
			ELSE StorageBins.Owner.UseBinLocationWarehousing
		END
	AND NOT StorageBins.DeletionMark</query>
	</dataSet>
