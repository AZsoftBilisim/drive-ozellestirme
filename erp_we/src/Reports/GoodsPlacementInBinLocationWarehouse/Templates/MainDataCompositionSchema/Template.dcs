		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	GoodsInStorageBinsBalance.Products,
	GoodsInStorageBinsBalance.Characteristic,
	GoodsInStorageBinsBalance.Package,
	&amp;QueryTextPackageVolume AS PackageVolume,
	&amp;QueryTextPackageWeight AS PackageWeight,
	GoodsInStorageBinsBalance.Cell AS Address,
	TRUE AS AddressFlag,
	GoodsInStorageBinsBalance.Series,
	CASE
		WHEN GoodsInStorageBinsBalance.Cell.StorageBinType = VALUE(Enum.TypesOfStorageCells.Location)
				OR GoodsInStorageBinsBalance.Cell.StorageBinType = VALUE(Enum.TypesOfStorageCells.Archive)
			THEN GoodsInStorageBinsBalance.InStockBalance
		ELSE 0
	END AS InStockBalance,
	CASE
		WHEN GoodsInStorageBinsBalance.Cell.StorageBinType = VALUE(Enum.TypesOfStorageCells.Receiving)
				OR GoodsInStorageBinsBalance.Cell.StorageBinType = VALUE(Enum.TypesOfStorageCells.Shipment)
				OR GoodsInStorageBinsBalance.Cell.StorageBinType = VALUE(Enum.TypesOfStorageCells.ShipmentIncludingBalances)
			THEN GoodsInStorageBinsBalance.InStockBalance
		ELSE 0
	END AS AcceptanceShipmentBalance
FROM
	AccumulationRegister.GoodsInStorageBins.Balance AS GoodsInStorageBinsBalance</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>StorageBins</sourceDataSet>
		<destinationDataSet>GoodsInStorageBins</destinationDataSet>
		<sourceExpression>Address</sourceExpression>
		<destinationExpression>Address</destinationExpression>
	</dataSetLink>
	<calculatedField>
		<dataPath>VolumeOccupied</dataPath>
		<expression>Case
		When NotLimitedByDimensions
			Then 0
		Else IsNull(InStockBalance, 0) * IsNull(PackageVolume, 0)
	End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
