	<calculatedField>
		<dataPath>TotalStorageBinsQuantity</dataPath>
		<expression>Case
	When StorageBinType = Value(Enum.TypesOfStorageCells.Receiving)
			Or StorageBinType = Value(Enum.TypesOfStorageCells.Shipment)
			Or StorageBinType = Value(Enum.TypesOfStorageCells.ShipmentIncludingBalances)
		Then 0
	Else 1
End</expression>
