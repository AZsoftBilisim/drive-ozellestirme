		<dataSource>DataSource1</dataSource>
		<query>SELECT
	DocumentRegisteredRecords.ProvisionObject AS ProvisionObject,
	CASE
		WHEN DocumentRegisteredRecords.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInterestOnDiscounting)
			THEN DocumentRegisteredRecords.DiscountingAmountMan
		ELSE 0
	END AS AccruedInterestMan,
	CASE
		WHEN DocumentRegisteredRecords.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInterestOnDiscounting)
			THEN DocumentRegisteredRecords.DiscountingAmountCompl
		ELSE 0	
	END AS LocalInterestAccrued,
	CASE
		WHEN DocumentRegisteredRecords.BusinessOperation = VALUE(Enum.BusinessTransactions.DiscountingInterestWriteOff)
			THEN DocumentRegisteredRecords.DiscountingAmountMan
		ELSE 0
	END AS InterestWrittenOffMan,
	CASE
		WHEN DocumentRegisteredRecords.BusinessOperation = VALUE(Enum.BusinessTransactions.DiscountingInterestWriteOff)
			THEN DocumentRegisteredRecords.DiscountingAmountCompl
		ELSE 0
	END AS LocalInterestDeducted,
	-ReserveBalances.SumManBalance - ReserveBalances.DiscountingAmountManBalance AS SumManBalance,
	-ReserveBalances.SumComplBalance - ReserveBalances.DiscountingAmountComplBalance AS SumComplBalance,
	ReserveBalances.DiscountingAmountManBalance AS DiscountingAmountManBalance,
	ReserveBalances.DiscountingAmountComplBalance AS DiscountingAmountComplBalance
FROM
	AccumulationRegister.FutureExpenseCommitments AS DocumentRegisteredRecords
		LEFT JOIN AccumulationRegister.FutureExpenseCommitments.Balance(&amp;Period, ) AS ReserveBalances
		ON (DocumentRegisteredRecords.Organization = ReserveBalances.Organization
				AND DocumentRegisteredRecords.ReserveKind = ReserveBalances.ReserveKind
				AND DocumentRegisteredRecords.LineOfBusiness = ReserveBalances.LineOfBusiness
				AND DocumentRegisteredRecords.ProvisionObject = ReserveBalances.ProvisionObject)
WHERE
	DocumentRegisteredRecords.Recorder = &amp;Recorder
	AND DocumentRegisteredRecords.BusinessOperation IN(VALUE(Enum.BusinessTransactions.AccrualOfInterestOnDiscounting), VALUE(Enum.BusinessTransactions.DiscountingInterestWriteOff))
	AND (DocumentRegisteredRecords.DiscountingAmountMan &lt;&gt; 0 OR DocumentRegisteredRecords.DiscountingAmountCompl &lt;&gt; 0)</query>
	</dataSet>
