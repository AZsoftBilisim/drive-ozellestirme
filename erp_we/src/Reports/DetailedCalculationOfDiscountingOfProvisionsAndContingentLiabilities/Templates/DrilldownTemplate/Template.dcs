			<field>LineOfBusiness</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ProvisionObject</dataPath>
			<field>ProvisionObject</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	FutureExpenseCommitmentsBalanceAndTurnovers.Period AS MovementPeriod,
	ENDOFPERIOD(FutureExpenseCommitmentsBalanceAndTurnovers.Period, MONTH) AS Period,
	FutureExpenseCommitmentsBalanceAndTurnovers.Recorder AS Recorder,
	-FutureExpenseCommitmentsBalanceAndTurnovers.SumManClosingBalance AS SumManClosingBalance,
	-FutureExpenseCommitmentsBalanceAndTurnovers.SumComplClosingBalance AS SumComplClosingBalance,
	FutureExpenseCommitmentsBalanceAndTurnovers.DiscountingAmountManReceipt AS DiscountingAmountManReceipt,
	FutureExpenseCommitmentsBalanceAndTurnovers.DiscountingAmountManExpense AS DiscountingAmountManExpense,
	FutureExpenseCommitmentsBalanceAndTurnovers.DiscountingAmountComplReceipt AS DiscountingAmountComplReceipt,
	FutureExpenseCommitmentsBalanceAndTurnovers.DiscountingAmountComplExpense AS DiscountingAmountComplExpense
INTO RegisteredRecordsOfReserve
FROM
	AccumulationRegister.FutureExpenseCommitments.BalanceAndTurnovers(, &amp;Period, Recorder, RegisterRecordsAndPeriodBoundaries,
		Organization = &amp;Organization
	AND ReserveKind = &amp;ReserveKind
	AND ProvisionObject = &amp;ProvisionObject) AS FutureExpenseCommitmentsBalanceAndTurnovers

INDEX BY
	Period
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	RegisteredRecordsOfReserve.Recorder AS Recorder,
	MAX(PeriodOfDiscountingOfProvisionsAndContingentLiabilities.Period) AS Period,
	PeriodOfDiscountingOfProvisionsAndContingentLiabilities.ProvisionObject AS ProvisionObject
INTO TermsOfDiscountingMaxima
FROM
	RegisteredRecordsOfReserve AS RegisteredRecordsOfReserve
		INNER JOIN InformationRegister.PeriodOfDiscountingOfProvisionsAndContingentLiabilities AS
			PeriodOfDiscountingOfProvisionsAndContingentLiabilities
		ON (RegisteredRecordsOfReserve.Period &gt;= PeriodOfDiscountingOfProvisionsAndContingentLiabilities.Period)
WHERE
	PeriodOfDiscountingOfProvisionsAndContingentLiabilities.ProvisionObject = &amp;ProvisionObject
GROUP BY
	RegisteredRecordsOfReserve.Recorder,
	PeriodOfDiscountingOfProvisionsAndContingentLiabilities.ProvisionObject

INDEX BY
	Period,
	ProvisionObject
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	TermsOfDiscountingMaxima.Recorder AS Recorder,
	PeriodOfDiscountingOfProvisionsAndContingentLiabilities.CompletionDate AS CompletionDate
INTO TermsOfDiscounting
FROM
	TermsOfDiscountingMaxima AS TermsOfDiscountingMaxima
		INNER JOIN InformationRegister.PeriodOfDiscountingOfProvisionsAndContingentLiabilities AS
			PeriodOfDiscountingOfProvisionsAndContingentLiabilities
		ON (PeriodOfDiscountingOfProvisionsAndContingentLiabilities.Period = TermsOfDiscountingMaxima.Period
		AND
			PeriodOfDiscountingOfProvisionsAndContingentLiabilities.ProvisionObject = TermsOfDiscountingMaxima.ProvisionObject)

INDEX BY
	Recorder
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	RegisteredRecordsOfReserve.Recorder AS Recorder,
	ProvisionDiscountingRates.Organization AS Organization,
	ProvisionDiscountingRates.ReserveKind AS ReserveKind,
	MAX(ProvisionDiscountingRates.Period) AS Period
INTO DiscountRatesMaxima
FROM
	RegisteredRecordsOfReserve AS RegisteredRecordsOfReserve
		INNER JOIN InformationRegister.ProvisionDiscountingRates AS ProvisionDiscountingRates
		ON (RegisteredRecordsOfReserve.Period &gt;= ProvisionDiscountingRates.Period)
WHERE
	ProvisionDiscountingRates.Organization = &amp;Organization
	AND ProvisionDiscountingRates.ReserveKind = &amp;ReserveKind
GROUP BY
	RegisteredRecordsOfReserve.Recorder,
	ProvisionDiscountingRates.Organization,
	ProvisionDiscountingRates.ReserveKind

INDEX BY
	Period,
	Organization,
	ReserveKind
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	DiscountRatesMaxima.Recorder AS Recorder,
	ProvisionDiscountingRates.DiscountRate AS DiscountRate
INTO DiscountRates
FROM
	DiscountRatesMaxima AS DiscountRatesMaxima
		INNER JOIN InformationRegister.ProvisionDiscountingRates AS ProvisionDiscountingRates
		ON (DiscountRatesMaxima.Period = ProvisionDiscountingRates.Period
		AND DiscountRatesMaxima.Organization = ProvisionDiscountingRates.Organization
		AND DiscountRatesMaxima.ReserveKind = ProvisionDiscountingRates.ReserveKind)

INDEX BY
	Recorder
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	RegisteredRecordsOfReserve.MovementPeriod AS Period,
	RegisteredRecordsOfReserve.Recorder AS Recorder,
	RegisteredRecordsOfReserve.SumManClosingBalance AS CostMan,
	RegisteredRecordsOfReserve.SumComplClosingBalance AS LocalCost,
	CAST(RegisteredRecordsOfReserve.SumManClosingBalance / POW(1 + DiscountRates.DiscountRate / 100,
		DATEDIFF(RegisteredRecordsOfReserve.MovementPeriod, TermsOfDiscounting.CompletionDate, DAY) / 365) AS NUMBER(15, 2)) AS
		PresentValueOfMan,
	CAST(RegisteredRecordsOfReserve.SumComplClosingBalance / POW(1 + DiscountRates.DiscountRate / 100,
		DATEDIFF(RegisteredRecordsOfReserve.MovementPeriod, TermsOfDiscounting.CompletionDate, DAY) / 365) AS NUMBER(15, 2)) AS
		PresentValueLocal,
	CAST(RegisteredRecordsOfReserve.SumManClosingBalance * (1 - 1 / POW(1 + DiscountRates.DiscountRate /
		100, DATEDIFF(RegisteredRecordsOfReserve.MovementPeriod, TermsOfDiscounting.CompletionDate, DAY) / 365)) AS NUMBER(15,
		2)) AS BalanceOfInterestMan,
	CAST(RegisteredRecordsOfReserve.SumComplClosingBalance * (1 - 1 / POW(1 + DiscountRates.DiscountRate /
		100, DATEDIFF(RegisteredRecordsOfReserve.MovementPeriod, TermsOfDiscounting.CompletionDate, DAY) / 365)) AS NUMBER(15,
		2)) AS BalanceOfInterestIsLocal,
	RegisteredRecordsOfReserve.DiscountingAmountManReceipt AS AccrualOfInterestMan,
	RegisteredRecordsOfReserve.DiscountingAmountManExpense AS WriteOffOfManSInterest,
	RegisteredRecordsOfReserve.DiscountingAmountComplReceipt AS InterestAccrualLocal,
	RegisteredRecordsOfReserve.DiscountingAmountComplExpense AS WriteOffOfLocalInterest,
	TermsOfDiscounting.CompletionDate AS CompletionDate,
	DiscountRates.DiscountRate AS DiscountRate,
	DATEDIFF(RegisteredRecordsOfReserve.MovementPeriod, TermsOfDiscounting.CompletionDate, DAY) AS DaysOfDiscounting
FROM
	RegisteredRecordsOfReserve AS RegisteredRecordsOfReserve
		LEFT JOIN TermsOfDiscounting AS TermsOfDiscounting
		ON (RegisteredRecordsOfReserve.Recorder = TermsOfDiscounting.Recorder)
		LEFT JOIN DiscountRates AS DiscountRates
		ON (RegisteredRecordsOfReserve.Recorder = DiscountRates.Recorder)

ORDER BY
	Period,
	Recorder</query>
	</dataSet>
