			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CustomerRebatesConditions.Organization AS Organization,
	CustomerRebatesCounterparties.TermDocument AS TermDocument,
	CustomerRebatesCounterparties.ValidOnDate AS ValidOnDate,
	CustomerRebatesCounterparties.ValidTo AS ValidTo,
	CustomerRebatesCounterparties.Counterparty AS Counterparty,
	CustomerRebatesCounterparties.Partner AS Partner,
	CustomerRebatesConditions.Kind AS Kind,
	CustomerRebatesConditions.LongDesc AS LongDesc,
	CustomerRebatesConditions.Attendees AS Attendees,
	CustomerRebatesConditions.PartyList AS PartyList
INTO TT_RebatesTermsAndConditions
FROM
	InformationRegister.CustomerRebatesCounterparties AS CustomerRebatesCounterparties
		LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON CustomerRebatesCounterparties.TermDocument = CustomerRebatesConditions.TermDocument
WHERE
	(CustomerRebatesCounterparties.Counterparty = &amp;Counterparty
			OR CustomerRebatesCounterparties.Counterparty IN (&amp;PartnerCounterparties)
			OR CustomerRebatesCounterparties.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
	AND CustomerRebatesConditions.Attendees = VALUE(Enum.RebatesLists.Selected_)
	AND &amp;ReportDate BETWEEN CustomerRebatesCounterparties.ValidOnDate AND CustomerRebatesCounterparties.ValidTo
	AND &amp;ReportVariant = 3
{WHERE
	(CustomerRebatesConditions.Organization = &amp;Organization),
	CustomerRebatesConditions.Kind.*,
	CustomerRebatesConditions.Attendees.*,
	CustomerRebatesConditions.PartyList.*,
	CustomerRebatesCounterparties.TermDocument.*}

UNION

SELECT
	CustomerRebatesConditions.Organization,
	CustomerRebatesCounterparties.TermDocument,
	CustomerRebatesCounterparties.ValidOnDate,
	CustomerRebatesCounterparties.ValidTo,
	CustomerRebatesCounterparties.Counterparty,
	CustomerRebatesCounterparties.Partner,
	CustomerRebatesConditions.Kind,
	CustomerRebatesConditions.LongDesc,
	CustomerRebatesConditions.Attendees,
	CustomerRebatesConditions.PartyList
FROM
	InformationRegister.CustomerRebatesCounterparties AS CustomerRebatesCounterparties
		LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON CustomerRebatesCounterparties.TermDocument = CustomerRebatesConditions.TermDocument
WHERE
	(CustomerRebatesCounterparties.Partner = &amp;Partner
			OR CustomerRebatesCounterparties.Partner = &amp;CounterpartySPartner
			OR CustomerRebatesCounterparties.Partner = VALUE(Catalog.Partners.EmptyRef))
	AND CustomerRebatesConditions.Attendees = VALUE(Enum.RebatesLists.Selected_)
	AND &amp;ReportDate BETWEEN CustomerRebatesCounterparties.ValidOnDate AND CustomerRebatesCounterparties.ValidTo
	AND &amp;ReportVariant = 3
{WHERE
	(CustomerRebatesConditions.Organization = &amp;Organization),
	CustomerRebatesConditions.Kind.*,
	CustomerRebatesConditions.Attendees.*,
	CustomerRebatesConditions.PartyList.*,
	CustomerRebatesCounterparties.TermDocument.*}

INDEX BY
	Counterparty,
	Partner,
	Attendees,
	PartyList
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CustomerRebatesConditions.Organization AS Organization,
	CustomerRebatesTIN.TermDocument AS TermDocument,
	CustomerRebatesTIN.ValidOnDate AS ValidOnDate,
	CustomerRebatesTIN.ValidTo AS ValidTo,
	CustomerRebatesTIN.TIN AS CounterpartyTIN,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	CustomerRebatesConditions.Kind AS Kind,
	CustomerRebatesConditions.LongDesc AS LongDesc,
	CustomerRebatesConditions.Attendees AS Attendees,
	CustomerRebatesConditions.PartyList AS PartyList
INTO TT_RetroBonusesConditionsOtherThanSelectedTIN
FROM
	InformationRegister.CustomerRebatesTIN AS CustomerRebatesTIN
		LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON CustomerRebatesTIN.TermDocument = CustomerRebatesConditions.TermDocument
WHERE
	CustomerRebatesConditions.Attendees = VALUE(Enum.RebatesLists.ExceptForSelectedOnes)
	AND &amp;ReportDate BETWEEN CustomerRebatesTIN.ValidOnDate AND CustomerRebatesTIN.ValidTo
	AND &amp;ReportVariant = 3
{WHERE
	(CustomerRebatesConditions.Organization = &amp;Organization),
	CustomerRebatesConditions.Kind.*,
	CustomerRebatesConditions.Attendees.*,
	CustomerRebatesConditions.PartyList.*,
	CustomerRebatesTIN.TermDocument.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CustomerRebatesConditions.Organization AS Organization,
	CustomerRebatesCounterparties.TermDocument AS TermDocument,
	CustomerRebatesCounterparties.ValidOnDate AS ValidOnDate,
	CustomerRebatesCounterparties.ValidTo AS ValidTo,
	CustomerRebatesCounterparties.Counterparty AS Counterparty,
	CustomerRebatesCounterparties.Partner AS Partner,
	CustomerRebatesConditions.Kind AS Kind,
	CustomerRebatesConditions.LongDesc AS LongDesc,
	CustomerRebatesConditions.Attendees AS Attendees,
	CustomerRebatesConditions.PartyList AS PartyList
INTO TT_RetroBonusesConditionsOtherThanSelected
FROM
	InformationRegister.CustomerRebatesCounterparties AS CustomerRebatesCounterparties
		LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON CustomerRebatesCounterparties.TermDocument = CustomerRebatesConditions.TermDocument
WHERE
	&amp;ReportDate BETWEEN CustomerRebatesCounterparties.ValidOnDate AND CustomerRebatesCounterparties.ValidTo
	AND CustomerRebatesConditions.Attendees = VALUE(Enum.RebatesLists.ExceptForSelectedOnes)
	AND &amp;ReportVariant = 3
{WHERE
	(CustomerRebatesConditions.Organization = &amp;Organization),
	CustomerRebatesConditions.Kind.*,
	CustomerRebatesConditions.Attendees.*,
	CustomerRebatesConditions.PartyList.*,
	CustomerRebatesCounterparties.TermDocument.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	CustomerRebatesConditions.Organization AS Organization,
	CustomerRebatesTIN.TermDocument AS TermDocument,
	CustomerRebatesTIN.ValidOnDate AS ValidOnDate,
	CustomerRebatesTIN.ValidTo AS ValidTo,
	&amp;Counterparty AS Counterparty,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	CustomerRebatesConditions.Kind AS Kind,
	CustomerRebatesConditions.LongDesc AS LongDesc,
	CustomerRebatesConditions.Attendees AS Attendees,
	CustomerRebatesConditions.PartyList AS PartyList,
	VALUE(Catalog.CounterpartyContracts.EmptyRef) AS Contract,
	VALUE(Catalog.TermsOfSale.EmptyRef) AS Terms
{SELECT
	Organization.*,
	TermDocument.*,
	ValidOnDate,
	ValidTo,
	Counterparty.*,
	Partner.*,
	Kind.*,
	LongDesc,
	Attendees.*,
	PartyList.*,
	Contract.*,
	Terms.*}
FROM
	InformationRegister.CustomerRebatesTIN AS CustomerRebatesTIN
		LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON CustomerRebatesTIN.TermDocument = CustomerRebatesConditions.TermDocument
WHERE
	CustomerRebatesConditions.Attendees = VALUE(Enum.RebatesLists.Selected_)
	AND CustomerRebatesTIN.TIN = &amp;TIN
	AND &amp;ReportDate BETWEEN CustomerRebatesTIN.ValidOnDate AND CustomerRebatesTIN.ValidTo
	AND &amp;ReportVariant = 3
{WHERE
	(CustomerRebatesConditions.Organization = &amp;Organization),
	CustomerRebatesConditions.Attendees.*,
	CustomerRebatesConditions.PartyList.* AS PartyList,
	CustomerRebatesTIN.TermDocument.*,
	CustomerRebatesConditions.Kind.*}

UNION ALL

SELECT DISTINCT
	CustomerRebatesConditions.Organization,
	CustomerRebatesConditions.TermDocument,
	CustomerRebatesConditions.ValidOnDate,
	CustomerRebatesConditions.ValidTo,
	&amp;Counterparty,
	&amp;Partner,
	CustomerRebatesConditions.Kind,
	CustomerRebatesConditions.LongDesc,
	CustomerRebatesConditions.Attendees,
	CustomerRebatesConditions.PartyList,
	VALUE(Catalog.CounterpartyContracts.EmptyRef),
	VALUE(Catalog.TermsOfSale.EmptyRef)
FROM
	InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
WHERE
	&amp;ReportDate BETWEEN CustomerRebatesConditions.ValidOnDate AND CustomerRebatesConditions.ValidTo
	AND CustomerRebatesConditions.Attendees = VALUE(Enum.RebatesLists.ALL)
	AND &amp;ReportVariant = 3
{WHERE
	(CustomerRebatesConditions.Organization = &amp;Organization),
	CustomerRebatesConditions.Kind.*,
	CustomerRebatesConditions.Attendees.*,
	CustomerRebatesConditions.PartyList.* AS PartyList,
	CustomerRebatesConditions.TermDocument.*}

UNION

SELECT
	TT_RebatesTermsAndConditions.Organization,
	TT_RebatesTermsAndConditions.TermDocument,
	TT_RebatesTermsAndConditions.ValidOnDate,
	TT_RebatesTermsAndConditions.ValidTo,
	TT_RebatesTermsAndConditions.Counterparty,
	TT_RebatesTermsAndConditions.Partner,
	TT_RebatesTermsAndConditions.Kind,
	TT_RebatesTermsAndConditions.LongDesc,
	TT_RebatesTermsAndConditions.Attendees,
	TT_RebatesTermsAndConditions.PartyList,
	VALUE(Catalog.CounterpartyContracts.EmptyRef),
	VALUE(Catalog.TermsOfSale.EmptyRef)
FROM
	TT_RebatesTermsAndConditions AS TT_RebatesTermsAndConditions
WHERE
	TT_RebatesTermsAndConditions.PartyList = VALUE(Enum.RebatesParticipants.Counterparties)
	AND TT_RebatesTermsAndConditions.Counterparty = &amp;Counterparty
	AND (TT_RebatesTermsAndConditions.Partner = &amp;Partner
			OR TT_RebatesTermsAndConditions.Partner = VALUE(Catalog.Partners.EmptyRef))

UNION

SELECT
	TT_RebatesTermsAndConditions.Organization,
	TT_RebatesTermsAndConditions.TermDocument,
	TT_RebatesTermsAndConditions.ValidOnDate,
	TT_RebatesTermsAndConditions.ValidTo,
	TT_RebatesTermsAndConditions.Counterparty,
	TT_RebatesTermsAndConditions.Partner,
	TT_RebatesTermsAndConditions.Kind,
	TT_RebatesTermsAndConditions.LongDesc,
	TT_RebatesTermsAndConditions.Attendees,
	TT_RebatesTermsAndConditions.PartyList,
	VALUE(Catalog.CounterpartyContracts.EmptyRef),
	VALUE(Catalog.TermsOfSale.EmptyRef)
FROM
	TT_RebatesTermsAndConditions AS TT_RebatesTermsAndConditions
WHERE
	TT_RebatesTermsAndConditions.PartyList = VALUE(Enum.RebatesParticipants.Customers)
	AND TT_RebatesTermsAndConditions.Partner = &amp;Partner
	AND (TT_RebatesTermsAndConditions.Counterparty = &amp;Counterparty
			OR TT_RebatesTermsAndConditions.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))

UNION

SELECT DISTINCT
	TT_RetroBonusesConditionsOtherThanSelected.Organization,
	TT_RetroBonusesConditionsOtherThanSelected.TermDocument,
	TT_RetroBonusesConditionsOtherThanSelected.ValidOnDate,
	TT_RetroBonusesConditionsOtherThanSelected.ValidTo,
	&amp;Counterparty,
	VALUE(Catalog.Partners.EmptyRef),
	TT_RetroBonusesConditionsOtherThanSelected.Kind,
	TT_RetroBonusesConditionsOtherThanSelected.LongDesc,
	TT_RetroBonusesConditionsOtherThanSelected.Attendees,
	TT_RetroBonusesConditionsOtherThanSelected.PartyList,
	VALUE(Catalog.CounterpartyContracts.EmptyRef),
	VALUE(Catalog.TermsOfSale.EmptyRef)
FROM
	TT_RetroBonusesConditionsOtherThanSelectedTIN AS TT_RetroBonusesConditionsOtherThanSelected
		LEFT JOIN TT_RetroBonusesConditionsOtherThanSelectedTIN AS TT_RetroBonusesConditionsSelection
		ON TT_RetroBonusesConditionsOtherThanSelected.TermDocument = TT_RetroBonusesConditionsSelection.TermDocument
			AND (TT_RetroBonusesConditionsSelection.CounterpartyTIN = &amp;TIN)
WHERE
	TT_RetroBonusesConditionsSelection.TermDocument IS NULL

UNION

SELECT DISTINCT
	TT_RetroBonusesConditionsOtherThanSelected.Organization,
	TT_RetroBonusesConditionsOtherThanSelected.TermDocument,
	TT_RetroBonusesConditionsOtherThanSelected.ValidOnDate,
	TT_RetroBonusesConditionsOtherThanSelected.ValidTo,
	&amp;Counterparty,
	&amp;Partner,
	TT_RetroBonusesConditionsOtherThanSelected.Kind,
	TT_RetroBonusesConditionsOtherThanSelected.LongDesc,
	TT_RetroBonusesConditionsOtherThanSelected.Attendees,
	TT_RetroBonusesConditionsOtherThanSelected.PartyList,
	VALUE(Catalog.CounterpartyContracts.EmptyRef),
	VALUE(Catalog.TermsOfSale.EmptyRef)
FROM
	TT_RetroBonusesConditionsOtherThanSelected AS TT_RetroBonusesConditionsOtherThanSelected
		LEFT JOIN TT_RetroBonusesConditionsOtherThanSelected AS TT_RetroBonusesConditionsSelection
		ON TT_RetroBonusesConditionsOtherThanSelected.TermDocument = TT_RetroBonusesConditionsSelection.TermDocument
			AND (TT_RetroBonusesConditionsSelection.PartyList = VALUE(Enum.RebatesParticipants.Counterparties))
			AND (TT_RetroBonusesConditionsSelection.Counterparty = &amp;Counterparty)
			AND (TT_RetroBonusesConditionsSelection.Partner = &amp;Partner
				OR TT_RetroBonusesConditionsSelection.Partner = VALUE(Catalog.Partners.EmptyRef))
WHERE
	TT_RetroBonusesConditionsOtherThanSelected.PartyList = VALUE(Enum.RebatesParticipants.Counterparties)
	AND TT_RetroBonusesConditionsSelection.TermDocument IS NULL

UNION

SELECT DISTINCT
	TT_RetroBonusesConditionsOtherThanSelected.Organization,
	TT_RetroBonusesConditionsOtherThanSelected.TermDocument,
	TT_RetroBonusesConditionsOtherThanSelected.ValidOnDate,
	TT_RetroBonusesConditionsOtherThanSelected.ValidTo,
	&amp;Counterparty,
	&amp;Partner,
	TT_RetroBonusesConditionsOtherThanSelected.Kind,
	TT_RetroBonusesConditionsOtherThanSelected.LongDesc,
	TT_RetroBonusesConditionsOtherThanSelected.Attendees,
	TT_RetroBonusesConditionsOtherThanSelected.PartyList,
	VALUE(Catalog.CounterpartyContracts.EmptyRef),
	VALUE(Catalog.TermsOfSale.EmptyRef)
FROM
	TT_RetroBonusesConditionsOtherThanSelected AS TT_RetroBonusesConditionsOtherThanSelected
		LEFT JOIN TT_RetroBonusesConditionsOtherThanSelected AS TT_RetroBonusesConditionsSelection
		ON TT_RetroBonusesConditionsOtherThanSelected.TermDocument = TT_RetroBonusesConditionsSelection.TermDocument
			AND (TT_RetroBonusesConditionsSelection.PartyList = VALUE(Enum.RebatesParticipants.Customers))
			AND (TT_RetroBonusesConditionsSelection.Partner = &amp;Partner)
			AND (TT_RetroBonusesConditionsSelection.Counterparty = &amp;Counterparty
				OR TT_RetroBonusesConditionsSelection.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
WHERE
	TT_RetroBonusesConditionsOtherThanSelected.PartyList = VALUE(Enum.RebatesParticipants.Customers)
	AND TT_RetroBonusesConditionsSelection.TermDocument IS NULL

UNION ALL

SELECT
	ISNULL(CustomerRebatesConditions.Organization, VALUE(Catalog.Companies.EmptyRef)),
	CustomerRebatesContractsTermsOfSales.TermDocument,
	CustomerRebatesContractsTermsOfSales.ValidOnDate,
	CustomerRebatesContractsTermsOfSales.ValidTo,
	TermsOfSale.Counterparty,
	TermsOfSale.Partner,
	ISNULL(CustomerRebatesConditions.Kind, VALUE(Catalog.CustomerRebatesKinds.EmptyRef)),
	ISNULL(CustomerRebatesConditions.LongDesc, ""),
	ISNULL(CustomerRebatesConditions.Attendees, VALUE(Enum.RebatesLists.EmptyRef)),
	ISNULL(CustomerRebatesConditions.PartyList, VALUE(Enum.RebatesParticipants.EmptyRef)),
	CustomerRebatesContractsTermsOfSales.Contract,
	CustomerRebatesContractsTermsOfSales.Terms
FROM
	InformationRegister.CustomerRebatesContractsTermsOfSales AS CustomerRebatesContractsTermsOfSales
		INNER JOIN Catalog.TermsOfSale AS TermsOfSale
		ON CustomerRebatesContractsTermsOfSales.Terms = TermsOfSale.Ref
		LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON CustomerRebatesContractsTermsOfSales.TermDocument = CustomerRebatesConditions.TermDocument
WHERE
	&amp;ReportDate BETWEEN CustomerRebatesContractsTermsOfSales.ValidOnDate AND CustomerRebatesContractsTermsOfSales.ValidTo
	AND (TermsOfSale.Partner = &amp;Partner
			OR TermsOfSale.Partner = VALUE(Catalog.Partners.EmptyRef))
	AND (TermsOfSale.Counterparty = &amp;Counterparty
			OR TermsOfSale.Counterparty = VALUE(Catalog.Counterparties.EmptyRef))
	AND &amp;ReportVariant = 3
{WHERE
	(ISNULL(CustomerRebatesConditions.Organization, VALUE(Catalog.Companies.EmptyRef)) = &amp;Organization),
	(ISNULL(CustomerRebatesConditions.Kind, VALUE(Catalog.CustomerRebatesKinds.EmptyRef))).* AS Kind,
	(ISNULL(CustomerRebatesConditions.PartyList, VALUE(Enum.RebatesParticipants.EmptyRef))).* AS PartyList,
	(ISNULL(CustomerRebatesConditions.Attendees, VALUE(Enum.RebatesLists.EmptyRef))).* AS Attendees,
	CustomerRebatesContractsTermsOfSales.TermDocument.*}

UNION ALL

SELECT
	ISNULL(CustomerRebatesConditions.Organization, VALUE(Catalog.Companies.EmptyRef)),
	CustomerRebatesContractsTermsOfSales.TermDocument,
	CustomerRebatesContractsTermsOfSales.ValidOnDate,
	CustomerRebatesContractsTermsOfSales.ValidTo,
	CounterpartyContracts.Counterparty,
	CounterpartyContracts.Partner,
	ISNULL(CustomerRebatesConditions.Kind, VALUE(Catalog.CustomerRebatesKinds.EmptyRef)),
	ISNULL(CustomerRebatesConditions.LongDesc, ""),
	ISNULL(CustomerRebatesConditions.Attendees, VALUE(Enum.RebatesLists.EmptyRef)),
	ISNULL(CustomerRebatesConditions.PartyList, VALUE(Enum.RebatesParticipants.EmptyRef)),
	CustomerRebatesContractsTermsOfSales.Contract,
	CustomerRebatesContractsTermsOfSales.Terms
FROM
	InformationRegister.CustomerRebatesContractsTermsOfSales AS CustomerRebatesContractsTermsOfSales
		INNER JOIN Catalog.CounterpartyContracts AS CounterpartyContracts
		ON CustomerRebatesContractsTermsOfSales.Contract = CounterpartyContracts.Ref
		AND CustomerRebatesContractsTermsOfSales.Contract IN(&amp;Contracts)
		LEFT JOIN InformationRegister.CustomerRebatesConditions AS CustomerRebatesConditions
		ON CustomerRebatesContractsTermsOfSales.TermDocument = CustomerRebatesConditions.TermDocument
WHERE
	&amp;ReportDate BETWEEN CustomerRebatesContractsTermsOfSales.ValidOnDate AND CustomerRebatesContractsTermsOfSales.ValidTo
	AND &amp;ReportVariant = 3
{WHERE
	(ISNULL(CustomerRebatesConditions.Organization, VALUE(Catalog.Companies.EmptyRef)) = &amp;Organization),
	(ISNULL(CustomerRebatesConditions.Kind, VALUE(Catalog.CustomerRebatesKinds.EmptyRef))).* AS Kind,
	(ISNULL(CustomerRebatesConditions.PartyList, VALUE(Enum.RebatesParticipants.EmptyRef))).* AS PartyList,
	(ISNULL(CustomerRebatesConditions.Attendees, VALUE(Enum.RebatesLists.EmptyRef))).* AS Attendees,
	CustomerRebatesContractsTermsOfSales.TermDocument.*}</query>
			<autoFillFields>false</autoFillFields>
		</item>
	</dataSet>
