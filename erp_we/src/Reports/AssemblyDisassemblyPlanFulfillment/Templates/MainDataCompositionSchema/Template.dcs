		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.DayPeriod, DAY)
	END AS DynamicPeriod,
	AssemblyPlansDisassemblyRevolutions.Warehouse AS Warehouse,
	AssemblyPlansDisassemblyRevolutions.Products AS Products,
	AssemblyPlansDisassemblyRevolutions.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN AssemblyPlansDisassemblyRevolutions.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	AssemblyPlansDisassemblyRevolutions.BusinessOperation AS BusinessOperation,
	AssemblyPlansDisassemblyRevolutions.Recorder AS Recorder,
	SUM(AssemblyPlansDisassemblyRevolutions.CountTurnover) AS Count
INTO AssemblyDisassemblyPlan
{SELECT
	Warehouse.*}
FROM
	AccumulationRegister.AssemblyDisassemblyPlans.Turnovers(
		,
		,
		Auto,
		Scenario = &amp;Scenario
		{(Warehouse), ((Products, Characteristic) IN
			(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment AS SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))
		}) AS AssemblyPlansDisassemblyRevolutions

GROUP BY
	AssemblyPlansDisassemblyRevolutions.Products,
	AssemblyPlansDisassemblyRevolutions.Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN AssemblyPlansDisassemblyRevolutions.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	AssemblyPlansDisassemblyRevolutions.Warehouse,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(AssemblyPlansDisassemblyRevolutions.DayPeriod, DAY)
	END,
	AssemblyPlansDisassemblyRevolutions.BusinessOperation,
	AssemblyPlansDisassemblyRevolutions.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(CompanyGoods.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(CompanyGoods.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(CompanyGoods.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(CompanyGoods.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(CompanyGoods.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(CompanyGoods.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(CompanyGoods.DayPeriod, DAY)
	END AS DynamicPeriod,
	CompanyGoods.ItemsLocationAttributes.StorageLocation AS Warehouse,
	CompanyGoods.ItemsLocationAttributes.Products AS Products,
	CompanyGoods.ItemsLocationAttributes.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN CompanyGoods.ItemsLocationAttributes.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	Assembly.BusinessOperation AS BusinessOperation,
	CompanyGoods.Recorder AS Recorder,
	SUM(CompanyGoods.CountReceipt) AS FactQuantity
INTO ActualAssemblyDisassembly
FROM
	AccumulationRegister.CompanyGoods.Turnovers(
		,
		,
		Auto,
		{(CASE
			WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
				THEN ItemsLocationAttributes IN
					(SELECT DISTINCT
							ItemsLocationAttributes.DimensionKey
						FROM
							AssemblyDisassemblyPlan AS AssemblyDisassemblyPlan
							INNER JOIN InformationRegister.ItemsLocationAttributes AS ItemsLocationAttributes
							ON AssemblyDisassemblyPlan.Products = ItemsLocationAttributes.Products
							 AND AssemblyDisassemblyPlan.Characteristic = ItemsLocationAttributes.Characteristic)
			ELSE TRUE
		END)}) AS CompanyGoods
		INNER JOIN Document.AssemblyFromComponents AS Assembly
		ON (Assembly.Ref = CompanyGoods.Recorder)
{WHERE
	CompanyGoods.Organization.* AS Organization,
	CompanyGoods.ItemsLocationAttributes.Products.* AS Products,
	CompanyGoods.ItemsLocationAttributes.StorageLocation.* AS Warehouse}

GROUP BY
	CompanyGoods.ItemsLocationAttributes.StorageLocation,
	CompanyGoods.ItemsLocationAttributes.Characteristic,
	CompanyGoods.ItemsLocationAttributes.Products,
	CASE
		WHEN &amp;SpecifyTargets
			THEN CompanyGoods.ItemsLocationAttributes.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(CompanyGoods.WeekPeriod, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(CompanyGoods.TenDaysPeriod, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(CompanyGoods.MonthPeriod, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(CompanyGoods.QuarterPeriod, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(CompanyGoods.HalfYearPeriod, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(CompanyGoods.YearPeriod, YEAR)
		ELSE ENDOFPERIOD(CompanyGoods.DayPeriod, DAY)
	END,
	Assembly.BusinessOperation,
	CompanyGoods.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, YEAR)
		ELSE ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, DAY)
	END AS DynamicPeriod,
	Orders.Warehouse AS Warehouse,
	Orders.Products AS Products,
	Orders.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN Orders.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	Orders.BusinessOperation AS BusinessOperation,
	Orders.Ref AS Recorder,
	SUM(CASE
		WHEN OrdersToBeRegistered.ByAssemblyDisassemblyOrder IS NULL
			THEN Orders.Count
		ELSE ISNULL(OrdersToBeRegistered.ToRegisterBalance, 0)
	END) AS OrderedQuantity
INTO Orders
FROM
	Document.ByAssemblyDisassemblyOrder AS Orders
		
		LEFT JOIN AccumulationRegister.AssemblyOrders.Balance(
			,
			CASE
				WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
					THEN (Products, Characteristic) IN
						(SELECT
							AssemblyDisassemblyPlan.Products AS Products,
							AssemblyDisassemblyPlan.Characteristic AS Characteristic
						FROM
							AssemblyDisassemblyPlan AS AssemblyDisassemblyPlan)
				ELSE TRUE
			END) AS OrdersToBeRegistered
		ON Orders.Ref         = OrdersToBeRegistered.ByAssemblyDisassemblyOrder
		 AND Orders.Products   = OrdersToBeRegistered.Products
		 AND Orders.Characteristic = OrdersToBeRegistered.Characteristic
WHERE
	Orders.Posted
	AND Orders.Status IN (VALUE(Enum.InternalOrderStatuses.ForCompletion), VALUE(Enum.InternalOrderStatuses.Closed))
	AND Orders.AssemblyDisassemblyEnd &gt;= &amp;BeginOfPeriod
	AND Orders.AssemblyDisassemblyEnd &lt;= &amp;EndOfPeriod
	AND CASE
		WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
			THEN (Orders.Products, Orders.Characteristic) IN
				(SELECT DISTINCT
						AssemblyDisassemblyPlan.Products,
						AssemblyDisassemblyPlan.Characteristic
					FROM
						AssemblyDisassemblyPlan AS AssemblyDisassemblyPlan)
		ELSE TRUE
	END
	
GROUP BY
	Orders.Warehouse,
	Orders.Products,
	Orders.Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN Orders.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, YEAR)
		ELSE ENDOFPERIOD(Orders.AssemblyDisassemblyEnd, DAY)
	END,
	Orders.BusinessOperation,
	Orders.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DynamicPeriod AS DynamicPeriod,
	NestedQuery.Warehouse AS Warehouse,
	NestedQuery.Products AS Products,
	NestedQuery.Characteristic AS Characteristic,
	NestedQuery.Purpose AS Purpose,
	NestedQuery.BusinessOperation AS BusinessOperation,
	NestedQuery.Recorder AS Recorder,
	SUM(NestedQuery.PlanQuantity) AS PlanQuantity,
	SUM(NestedQuery.FactQuantity) AS FactQuantity,
	SUM(NestedQuery.OrderedQuantity) AS OrderedQuantity
INTO AssemblyDisassemblyPlanFact
FROM
	(SELECT
		AssemblyDisassemblyPlan.DynamicPeriod AS DynamicPeriod,
		AssemblyDisassemblyPlan.Warehouse AS Warehouse,
		AssemblyDisassemblyPlan.Products AS Products,
		AssemblyDisassemblyPlan.Characteristic AS Characteristic,
		AssemblyDisassemblyPlan.Purpose AS Purpose,
		AssemblyDisassemblyPlan.BusinessOperation AS BusinessOperation,
		AssemblyDisassemblyPlan.Recorder AS Recorder,
		AssemblyDisassemblyPlan.Count AS PlanQuantity,
		0 AS FactQuantity,
		0 AS OrderedQuantity
	FROM
		AssemblyDisassemblyPlan AS AssemblyDisassemblyPlan
	
	UNION ALL
	
	SELECT
		ActualAssemblyDisassembly.DynamicPeriod,
		ActualAssemblyDisassembly.Warehouse,
		ActualAssemblyDisassembly.Products,
		ActualAssemblyDisassembly.Characteristic,
		ActualAssemblyDisassembly.Purpose,
		ActualAssemblyDisassembly.BusinessOperation,
		ActualAssemblyDisassembly.Recorder,
		0,
		ActualAssemblyDisassembly.FactQuantity,
		0
	FROM
		ActualAssemblyDisassembly AS ActualAssemblyDisassembly
	
	UNION ALL
	
	SELECT
		Orders.DynamicPeriod,
		Orders.Warehouse,
		Orders.Products,
		Orders.Characteristic,
		Orders.Purpose,
		Orders.BusinessOperation,
		Orders.Recorder,
		0,
		0,
		Orders.OrderedQuantity
	FROM
		Orders AS Orders) AS NestedQuery

GROUP BY
	NestedQuery.DynamicPeriod,
	NestedQuery.Characteristic,
	NestedQuery.Products,
	NestedQuery.Purpose,
	NestedQuery.Warehouse,
	NestedQuery.BusinessOperation,
	NestedQuery.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	AssemblyDisassemblyPlanFact.DynamicPeriod,
	AssemblyDisassemblyPlanFact.Warehouse AS Warehouse,
	AssemblyDisassemblyPlanFact.Products,
	AssemblyDisassemblyPlanFact.Characteristic,
	AssemblyDisassemblyPlanFact.Purpose,
	AssemblyDisassemblyPlanFact.BusinessOperation,
	AssemblyDisassemblyPlanFact.Recorder,
	SUM(AssemblyDisassemblyPlanFact.PlanQuantity) AS PlanQuantity,
	SUM(AssemblyDisassemblyPlanFact.FactQuantity) AS FactQuantity,
	100 * (CASE
		WHEN SUM(AssemblyDisassemblyPlanFact.PlanQuantity) = 0
			THEN 0
		ELSE SUM(AssemblyDisassemblyPlanFact.FactQuantity) / SUM(AssemblyDisassemblyPlanFact.PlanQuantity)
	END) AS ExecutionOfPlanQuantity,
	SUM(AssemblyDisassemblyPlanFact.OrderedQuantity) AS OrderedQuantity
FROM
	AssemblyDisassemblyPlanFact AS AssemblyDisassemblyPlanFact
WHERE
	AssemblyDisassemblyPlanFact.DynamicPeriod BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	AssemblyDisassemblyPlanFact.DynamicPeriod,
	AssemblyDisassemblyPlanFact.Products,
	AssemblyDisassemblyPlanFact.Characteristic,
	AssemblyDisassemblyPlanFact.Purpose,
	AssemblyDisassemblyPlanFact.BusinessOperation,
	AssemblyDisassemblyPlanFact.Recorder,
	AssemblyDisassemblyPlanFact.Warehouse</query>
	</dataSet>
	<totalField>
		<dataPath>Ordered.Count</dataPath>
		<expression>Sum(Ordered.Count)</expression>
	</totalField>
	<totalField>
		<dataPath>PlanExecution.Count</dataPath>
		<expression>100 * (Case When Sum(Plan.Count) = 0 Then 0 Else Sum(Real.Count) / Sum(Plan.Count) End)</expression>
	</totalField>
	<totalField>
		<dataPath>Plan.Count</dataPath>
		<expression>Sum(Plan.Count)</expression>
	</totalField>
	<totalField>
		<dataPath>Real.Count</dataPath>
		<expression>Sum(Real.Count)</expression>
	</totalField>
	<parameter>
		<name>ReleasePeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Release period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره خروجی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Periodo di emissione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
