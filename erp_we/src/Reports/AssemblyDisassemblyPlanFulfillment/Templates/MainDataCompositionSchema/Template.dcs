	<settingsVariant>
		<dcsset:name>ExecutionOfPlanOfAssemblyDisassemblyByWarehouses</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Kitting plan by warehouses</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>برنامه کیت‌سازی بر اساس انبارها</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Esecuzione del piano di assemblagio (disassemblaggio) per magazzini</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wykonanie planu montażu (demontażu) wg magazynów</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Исполнение плана сборки (разборки) по складам</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ambarlara göre montaj (demontaj) planı uygulaması</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Thực hiện kế hoạch đóng bộ (tách bộ) theo kho</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:userFields>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>UserFields.Field1</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Plan fulfillment (variance)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>اجرای برنامه (انحراف)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Esecuzione del piano (variazione)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Realizacja planu (odchylenie)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Исполнение плана (отклонение)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Planın uygulanması (fark)</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Thực hiện kế hoạch (chênh lệch)</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:detailExpression>Case
	When Plan.Count = 0 And Real.Count = 0
		Then 0
	When PlanExecution.Count &gt; 100
		Then PlanExecution.Count - 100
	Else 100 - PlanExecution.Count
End</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>Case
	When Plan.Count = 0 And Real.Count = 0
		Then 0
	When PlanExecution.Count &gt; 100
		Then PlanExecution.Count - 100
	Else 100 - PlanExecution.Count
End</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression>Cast(Case
		When Plan.Count = 0 And Real.Count = 0
			Then 0
		When PlanExecution.Count &gt; 100
			Then PlanExecution.Count - 100
		Else 100 - PlanExecution.Count
	End, "Number(15,2)")</dcsset:totalExpression>
					<dcsset:totalExpressionPresentation>Cast(Case
		When Plan.Count = 0 And Real.Count = 0
			Then 0
		When PlanExecution.Count &gt; 100
			Then PlanExecution.Count - 100
		Else 100 - PlanExecution.Count
	End, "Number(15,2)")</dcsset:totalExpressionPresentation>
				</dcsset:item>
			</dcsset:userFields>
