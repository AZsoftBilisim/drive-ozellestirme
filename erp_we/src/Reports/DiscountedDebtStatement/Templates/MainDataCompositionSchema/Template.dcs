		<field xsi:type="DataSetFieldField">
			<dataPath>DiscountingAmountReceipt</dataPath>
			<field>DiscountingAmountReceipt</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Discounting amount inflow</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>ورودی مبلغ تنزیل</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Importo sconto in sospeso</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Kwota dyskontowania przychód</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма дисконтирования приход</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>İskonto tutarı giriş</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số tiền tính chiết khấu thu nhập</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	DiscountInterestExpenseBalanceAndTurnovers.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	DiscountInterestExpenseBalanceAndTurnovers.Currency AS Currency,
	DiscountInterestExpenseBalanceAndTurnovers.ARAPObject AS ARAPObject,
	DiscountInterestExpenseBalanceAndTurnovers.ARAPDocument AS ARAPDocument,
	CASE &amp;ReportData
		WHEN 1
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountOpeningBalance
		WHEN 2
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountManOpeningBalance
		ELSE DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountComplOpeningBalance
	END AS DiscountingAmountOpeningBalance,
	CASE &amp;ReportData
		WHEN 1
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountClosingBalance
		WHEN 2
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountManClosingBalance
		ELSE DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountComplClosingBalance
	END AS DiscountingAmountClosingBalance,
	CASE &amp;ReportData
		WHEN 1
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountTurnover
		WHEN 2
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountManTurnover
		ELSE DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountComplTurnover
	END AS DiscountingAmountTurnover,
	CASE &amp;ReportData
		WHEN 1
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountReceipt
		WHEN 2
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountManReceipt
		ELSE DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountComplReceipt
	END AS DiscountingAmountReceipt,
	CASE &amp;ReportData
		WHEN 1
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountExpense
		WHEN 2
			THEN DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountManExpense
		ELSE DiscountInterestExpenseBalanceAndTurnovers.DiscountingAmountComplExpense
	END AS DiscountingAmountExpense,
	CASE
		WHEN DiscountInterestExpenseBalanceAndTurnovers.Recorder = UNDEFINED
			THEN NULL
		ELSE DiscountInterestExpenseBalanceAndTurnovers.Recorder
	END AS Recorder,
	DiscountInterestExpenseBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	DiscountInterestExpenseBalanceAndTurnovers.MinutePeriod AS MinutePeriod,
	DiscountInterestExpenseBalanceAndTurnovers.HourPeriod AS HourPeriod,
	DiscountInterestExpenseBalanceAndTurnovers.DayPeriod AS DayPeriod,
	DiscountInterestExpenseBalanceAndTurnovers.WeekPeriod AS WeekPeriod,
	DiscountInterestExpenseBalanceAndTurnovers.TenDaysPeriod AS TenDaysPeriod,
	DiscountInterestExpenseBalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	DiscountInterestExpenseBalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	DiscountInterestExpenseBalanceAndTurnovers.HalfYearPeriod AS HalfYearPeriod,
	DiscountInterestExpenseBalanceAndTurnovers.YearPeriod AS YearPeriod
FROM
	AccumulationRegister.DiscountInterestExpense.BalanceAndTurnovers(, , Auto, , ) AS DiscountInterestExpenseBalanceAndTurnovers</query>
	</dataSet>
