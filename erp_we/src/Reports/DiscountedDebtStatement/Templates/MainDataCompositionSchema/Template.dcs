		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.ARAPObject AS ARAPObject,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.Currency AS Currency,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.ARAPDocument AS ARAPDocument,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.PlannedRepaymentDate AS PlannedRepaymentDate,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.OccurrenceDate AS OccurrenceDate,
	CASE &amp;ReportData
		WHEN 1
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtOpeningBalance
		WHEN 2
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.ARAPManOpeningBalance
		ELSE VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtLocalOpeningBalance
	END AS NominalDebtOpeningBalance,
	CASE &amp;ReportData
		WHEN 1
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtClosingBalance
		WHEN 2
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.ARAPManClosingBalance
		ELSE VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtLocalClosingBalance
	END AS NominalDebtClosingBalance,
	CASE &amp;ReportData
		WHEN 1
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtReceipt
		WHEN 2
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.ARAPManReceipt
		ELSE VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtLocalReceipt
	END AS NominalDebtReceipt,
	CASE &amp;ReportData
		WHEN 1
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtExpense
		WHEN 2
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.ARAPManExpense
		ELSE VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtLocalExpense
	END AS NominalDebtExpense,
	CASE &amp;ReportData
		WHEN 1
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtTurnover
		WHEN 2
			THEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.ARAPManTurnover
		ELSE VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DebtLocalTurnover
	END AS NominalDebtTurnover,
	CASE
		WHEN VendorsARAPAccountingByDueDatesBalanceAndTurnovers.Recorder = UNDEFINED
			THEN NULL
		ELSE VendorsARAPAccountingByDueDatesBalanceAndTurnovers.Recorder
	END AS Recorder,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.MinutePeriod AS MinutePeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.HourPeriod AS HourPeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.DayPeriod AS DayPeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.WeekPeriod AS WeekPeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.TenDaysPeriod AS TenDaysPeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.HalfYearPeriod AS HalfYearPeriod,
	VendorsARAPAccountingByDueDatesBalanceAndTurnovers.YearPeriod AS YearPeriod
FROM
	AccumulationRegister.VendorsARAPAccountingByDueDates.BalanceAndTurnovers(, , Auto, , ) AS VendorsARAPAccountingByDueDatesBalanceAndTurnovers</query>
	</dataSet>
