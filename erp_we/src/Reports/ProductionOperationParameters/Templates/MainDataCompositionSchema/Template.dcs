			<dataPath>OperationKind</dataPath>
			<field>OperationKind</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Operations.Ref AS Operation,
	Operations.Department AS Department,
	Operations.Performer AS Performer,
	Operations.OperationKind AS OperationKind,
	Operations.Stage.ProductionLot AS Lot,
	Operations.Stage.ProductionLot.MainProductProducts AS Product,
	Operations.Stage.ProductionLot.MainProductCharacteristic AS Characteristic,
	Parameters.Property AS Parameter,
	Parameters.Value AS Value,
	ISNULL(Standards.ValueMin, 0) AS StandardMin,
	ISNULL(Standards.ValueMax, 0) AS NormativeStandardMax
FROM
	Document.ProductionOperation2_2 AS Operations
		LEFT JOIN Document.ProductionOperation2_2.AdditionalAttributes AS Parameters
		ON Operations.Ref = Parameters.Ref
		LEFT JOIN Catalog.ManufacturingOperations.OperationKindStandards AS Standards
		ON Operations.Operation = Standards.Ref
			AND (Parameters.Property = Standards.Property)
WHERE
	Operations.Posted
	AND Parameters.Ref IS NOT NULL

UNION ALL

SELECT
	Operations.Ref,
	Operations.Department,
	Operations.Performer,
	Operations.OperationKind,
	Operations.Stage.ProductionLot,
	Operations.Stage.ProductionLot.MainProductProducts,
	Operations.Stage.ProductionLot.MainProductCharacteristic,
	AdditionalInfo.Property,
	AdditionalInfo.Value,
	0,
	0
FROM
	Document.ProductionOperation2_2 AS Operations
		INNER JOIN InformationRegister.AdditionalInfo AS AdditionalInfo
		ON Operations.Ref = AdditionalInfo.Object
WHERE
	Operations.Posted</query>
	</dataSet>
	<calculatedField>
		<dataPath>Deviation</dataPath>
		<expression>Case
When ValueType(Value) &lt;&gt; Type("Number")
Then 0
When (StandardMin &lt;&gt; 0 And Value &lt; StandardMin)
   Or (StandardMin = 0 And NormativeStandardMax &lt;&gt; 0 And Value &lt; StandardMin)
   Or (StandardMin &lt;&gt; 0 And NormativeStandardMax = 0 And Value &gt; StandardMin)
Then Value - StandardMin
When NormativeStandardMax &lt;&gt; 0 And Value &gt; NormativeStandardMax
Then Value - NormativeStandardMax
Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Variance</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>انحراف</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Variazione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Odchylenie</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отклонение</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Sapma</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chênh lệch</v8:content>
			</v8:item>
		</title>
	</calculatedField>
