		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	LimitsByBudgetingData.LimitationPeriod AS LimitationPeriod,
	LimitsByBudgetingData.LimitsRule AS LimitsRule,
	LimitsByBudgetingData.Organization AS Organization,
	LimitsByBudgetingData.Department AS Department,
	LimitsByBudgetingData.Dimension1 AS Dimension1,
	LimitsByBudgetingData.Dimension2 AS Dimension2,
	LimitsByBudgetingData.Dimension3 AS Dimension3,
	LimitsByBudgetingData.Dimension4 AS Dimension4,
	LimitsByBudgetingData.Dimension5 AS Dimension5,
	LimitsByBudgetingData.Dimension6 AS Dimension6
INTO TT_DocumentLimits
FROM
	AccumulationRegister.LimitsByBudgetingData AS LimitsByBudgetingData
WHERE
	LimitsByBudgetingData.Recorder = &amp;ReservationDocument
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	LimitsByBudgetingData.LimitationPeriod AS LimitationPeriod,
	LimitsByBudgetingData.LimitsRule AS LimitsRule,
	LimitsByBudgetingData.Organization AS Organization,
	LimitsByBudgetingData.Currency AS CurrencyPlan,
	LimitsByBudgetingData.Department AS Department,
	LimitsByBudgetingData.Dimension1 AS Dimension1,
	LimitsByBudgetingData.Dimension2 AS Dimension2,
	LimitsByBudgetingData.Dimension3 AS Dimension3,
	LimitsByBudgetingData.Dimension4 AS Dimension4,
	LimitsByBudgetingData.Dimension5 AS Dimension5,
	LimitsByBudgetingData.Dimension6 AS Dimension6,
	VALUE(Catalog.Companies.EmptyRef) AS CompanyActual,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS DepartmentActual,
	UNDEFINED AS Dimension1Real,
	UNDEFINED AS Dimension2Real,
	UNDEFINED AS Dimension3Real,
	UNDEFINED AS Dimension4Real,
	UNDEFINED AS Dimension5Real,
	UNDEFINED AS Dimension6Real,
	FALSE AS ThisIsAFactLine,
	LimitsByBudgetingData.Recorder AS Recorder,
	LimitsByBudgetingData.LimitTurnover AS Limit,
	LimitsByBudgetingData.ApplicationAmountTurnover AS ApplicationAmount,
	CASE
		WHEN NOT &amp;ReservationDocument IN (UNDEFINED, VALUE(Document.ApplicationForBusinessTrip.EmptyRef),
			VALUE(Document.PaymentRequest.EmptyRef),
			VALUE(Document.PurchaseRequest.EmptyRef),
			VALUE(Document.ApplicationForCollateral.EmptyRef))
			AND VALUETYPE(LimitsByBudgetingData.Recorder) IN (TYPE(Document.CashVoucher), TYPE(Document.BankAccountIssue))
			THEN -LimitsByBudgetingData.ApplicationAmountTurnover
		WHEN &amp;OutputAnalytics
			THEN 0
		ELSE LimitsByBudgetingData.SumRealTurnover
	END AS SumReal
FROM
	AccumulationRegister.LimitsByBudgetingData.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto, CASE
		WHEN &amp;ReservationDocument IN (UNDEFINED, VALUE(Document.ApplicationForBusinessTrip.EmptyRef),
			VALUE(Document.PaymentRequest.EmptyRef),
			VALUE(Document.PurchaseRequest.EmptyRef),
			VALUE(Document.ApplicationForCollateral.EmptyRef))
			THEN TRUE
		ELSE (LimitationPeriod, LimitsRule, Organization, Department, Dimension1, Dimension2, Dimension3,
			Dimension4, Dimension5, Dimension6) IN
			(SELECT
				TT_DocumentLimits.LimitationPeriod,
				TT_DocumentLimits.LimitsRule,
				TT_DocumentLimits.Organization,
				TT_DocumentLimits.Department,
				TT_DocumentLimits.Dimension1,
				TT_DocumentLimits.Dimension2,
				TT_DocumentLimits.Dimension3,
				TT_DocumentLimits.Dimension4,
				TT_DocumentLimits.Dimension5,
				TT_DocumentLimits.Dimension6
			FROM
				TT_DocumentLimits AS TT_DocumentLimits)
	END) AS LimitsByBudgetingData

UNION ALL

SELECT
	LimitsByBudgetingData.LimitationPeriod,
	LimitsByBudgetingData.LimitsRule,
	LimitsByBudgetingData.Organization,
	LimitsByBudgetingData.Currency,
	LimitsByBudgetingData.Department,
	LimitsByBudgetingData.Dimension1,
	LimitsByBudgetingData.Dimension2,
	LimitsByBudgetingData.Dimension3,
	LimitsByBudgetingData.Dimension4,
	LimitsByBudgetingData.Dimension5,
	LimitsByBudgetingData.Dimension6,
	LimitsByBudgetingData.CompanyActual,
	LimitsByBudgetingData.DepartmentActual,
	LimitsByBudgetingData.Dimension1Real,
	LimitsByBudgetingData.Dimension2Real,
	LimitsByBudgetingData.Dimension3Real,
	LimitsByBudgetingData.Dimension4Real,
	LimitsByBudgetingData.Dimension5Real,
	LimitsByBudgetingData.Dimension6Real,
	TRUE,
	LimitsByBudgetingData.Recorder,
	0,
	0,
	LimitsByBudgetingData.SumReal
FROM
	AccumulationRegister.LimitsByBudgetingData AS LimitsByBudgetingData
WHERE
	&amp;OutputAnalytics
	AND LimitsByBudgetingData.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND LimitsByBudgetingData.SumReal &lt;&gt; 0
	AND CASE
		WHEN &amp;ReservationDocument IN (UNDEFINED, VALUE(Document.ApplicationForBusinessTrip.EmptyRef),
			VALUE(Document.PaymentRequest.EmptyRef),
			VALUE(Document.PurchaseRequest.EmptyRef),
			VALUE(Document.ApplicationForCollateral.EmptyRef))
			THEN TRUE
		ELSE TRUE IN
			(SELECT TOP 1
				TRUE
			FROM
				TT_DocumentLimits AS TT_DocumentLimits
			WHERE
				TT_DocumentLimits.LimitationPeriod = LimitsByBudgetingData.LimitationPeriod
				AND TT_DocumentLimits.LimitsRule = LimitsByBudgetingData.LimitsRule
				AND TT_DocumentLimits.Organization = LimitsByBudgetingData.Organization
				AND TT_DocumentLimits.Department = LimitsByBudgetingData.Department
				AND TT_DocumentLimits.Dimension1 = LimitsByBudgetingData.Dimension1
				AND TT_DocumentLimits.Dimension2 = LimitsByBudgetingData.Dimension2
				AND TT_DocumentLimits.Dimension3 = LimitsByBudgetingData.Dimension3
				AND TT_DocumentLimits.Dimension4 = LimitsByBudgetingData.Dimension4
				AND TT_DocumentLimits.Dimension5 = LimitsByBudgetingData.Dimension5
				AND TT_DocumentLimits.Dimension6 = LimitsByBudgetingData.Dimension6)
	END</query>
	</dataSet>
