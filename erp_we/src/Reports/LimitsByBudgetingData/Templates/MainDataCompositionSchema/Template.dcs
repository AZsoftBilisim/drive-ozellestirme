	<totalField>
		<dataPath>Limit</dataPath>
		<expression>Sum(Limit)</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>ApplicationAmount</dataPath>
		<expression>Sum(ApplicationAmount)</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>SumReal</dataPath>
		<expression>Sum(SumReal)</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>overspending</dataPath>
		<expression>Case When &amp;ExplanationModeByRecorder Then 0 Else Case When Sum(Limit) &lt; Sum(LimitConsumptionAmount) Then Sum(LimitConsumptionAmount) - Sum(Limit) Else 0 End End</expression>
		<group>DimensionValue1</group>
		<group>DimensionValue2</group>
		<group>DimensionValue3</group>
		<group>DimensionValue4</group>
		<group>DimensionValue5</group>
		<group>DimensionValue6</group>
		<group>DimensionValue7</group>
		<group>DimensionValue8</group>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PercentageOfOverspending</dataPath>
		<expression>Case When &amp;ExplanationModeByRecorder Then 0 Else Case When Sum(Limit) &lt;&gt; 0 And Sum(Limit) &lt; Sum(LimitConsumptionAmount) Then Round(((Sum(LimitConsumptionAmount) - Sum(Limit)) / Sum(Limit) * 100), 2) Else 0 End End</expression>
		<group>DimensionValue1</group>
		<group>DimensionValue2</group>
		<group>DimensionValue3</group>
		<group>DimensionValue4</group>
		<group>DimensionValue5</group>
		<group>DimensionValue6</group>
		<group>DimensionValue7</group>
		<group>DimensionValue8</group>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PlanBalance</dataPath>
		<expression>Case When &amp;ExplanationModeByRecorder Then 0 Else Case When Sum(Limit) &gt; Sum(LimitConsumptionAmount) Then Sum(Limit) - Sum(LimitConsumptionAmount) Else 0 End End</expression>
		<group>DimensionValue1</group>
		<group>DimensionValue2</group>
		<group>DimensionValue3</group>
		<group>DimensionValue4</group>
		<group>DimensionValue5</group>
		<group>DimensionValue6</group>
		<group>DimensionValue7</group>
		<group>DimensionValue8</group>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PercentageOfPlanBalance</dataPath>
		<expression>Case When &amp;ExplanationModeByRecorder Then 0 Else Case When Sum(Limit) &lt;&gt; 0 And Sum(Limit) &gt; Sum(LimitConsumptionAmount) Then Round((Sum(Limit) - Sum(LimitConsumptionAmount)) / Sum(Limit) * 100, 2) Else 0 End End</expression>
		<group>DimensionValue1</group>
		<group>DimensionValue2</group>
		<group>DimensionValue3</group>
		<group>DimensionValue4</group>
		<group>DimensionValue5</group>
		<group>DimensionValue6</group>
		<group>DimensionValue7</group>
		<group>DimensionValue8</group>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PresentationOfOtherAnalytics1</dataPath>
		<expression>Max(PresentationOfOtherAnalytics1)</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PresentationOfOtherAnalytics2</dataPath>
		<expression>Max(PresentationOfOtherAnalytics2)</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PresentationOfOtherAnalytics3</dataPath>
