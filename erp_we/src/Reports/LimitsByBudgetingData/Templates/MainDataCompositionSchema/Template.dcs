		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>LimitedTransaction</dcsat:name>
			<dcsat:expression>Case
 When LimitedTransaction = Value(Enum.LimitedTransactions.Expenses) Then "Budget of income and expenses" Else "Cash flow budget" End</dcsat:expression>
		</parameter>
