	<calculatedField>
		<dataPath>LimitType</dataPath>
		<expression>LimitsRule.LimitType</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Limit type</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>نوع سقف</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Tipo di limitazione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Rodzaj limitu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Тип лимита</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Limit tipi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Loại hạn mức</v8:content>
			</v8:item>
		</title>
		<orderExpression>
			<dcscom:expression>Case When LimitsRule.LimitType = Value(Enum.TypesOfCashExpenseLimit.AllowingWithinLimit) Then 1 When LimitsRule.LimitType = Value(Enum.TypesOfCashExpenseLimit.AdditionallyLimiting) Then 2 Else 3 End</dcscom:expression>
			<dcscom:orderType>Asc</dcscom:orderType>
			<dcscom:autoOrder>false</dcscom:autoOrder>
		</orderExpression>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:EnumRef.TypesOfCashExpenseLimit</v8:Type>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>LimitPeriodicity</dataPath>
		<expression>LimitsRule.Periodicity</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Limit periodicity</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تناوب سقف</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Periodicità del limite</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Okresowość limitu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Периодичность лимита</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Limitin sıklığı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Giới hạn tần số</v8:content>
			</v8:item>
		</title>
		<orderExpression>
			<dcscom:expression>Case When LimitsRule.Periodicity = Value(Enum.Periodicity.Year) Then 7 When LimitsRule.Periodicity = Value(Enum.Periodicity.HalfYear) Then 6 When LimitsRule.Periodicity = Value(Enum.Periodicity.Quarter) Then 5 When LimitsRule.Periodicity = Value(Enum.Periodicity.Month) Then 4 When LimitsRule.Periodicity = Value(Enum.Periodicity.TenDays) Then 3 When LimitsRule.Periodicity = Value(Enum.Periodicity.Week) Then 2 When LimitsRule.Periodicity = Value(Enum.Periodicity.Day) Then 1 Else 0 End</dcscom:expression>
			<dcscom:orderType>Asc</dcscom:orderType>
			<dcscom:autoOrder>false</dcscom:autoOrder>
		</orderExpression>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:EnumRef.Periodicity</v8:Type>
		</valueType>
	</calculatedField>
