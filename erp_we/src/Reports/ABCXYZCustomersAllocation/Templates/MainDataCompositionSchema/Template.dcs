		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ABCXYZCustomerClassificationSliceLast.Partner AS Partner,
	ABCXYZCustomerClassificationSliceLast.Class AS Class,
	ABCXYZCustomerClassificationSliceLast.ClassificationParameterValue AS ClassificationParameterValue
INTO ClassificationABC
FROM
	InformationRegister.ABCXYZCustomerClassification.SliceLast(&amp;CurrentPeriod, ) AS ABCXYZCustomerClassificationSliceLast
WHERE
	ABCXYZCustomerClassificationSliceLast.ClassificationType = VALUE(Enum.TypesOfClassification.ABC)
	AND ABCXYZCustomerClassificationSliceLast.ClassificationParameterType = &amp;ClassificationParameterType

;
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
SELECT
	ABCXYZCustomerClassificationSliceLast.Partner AS Partner,
	ABCXYZCustomerClassificationSliceLast.Class AS Class
INTO ClassificationOfXYZ
FROM
	InformationRegister.ABCXYZCustomerClassification.SliceLast(&amp;CurrentPeriod, ) AS ABCXYZCustomerClassificationSliceLast
WHERE
	ABCXYZCustomerClassificationSliceLast.ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)
	AND ABCXYZCustomerClassificationSliceLast.ClassificationParameterType = &amp;ClassificationParameterType

;
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	Partners.Ref AS Partner,
	ISNULL(ClassificationOfXYZ.Class, VALUE(Enum.XYZClassification.EmptyRef)) AS XYZClass,
	ISNULL(ClassificationABC.Class, VALUE(Enum.ABCClassification.EmptyRef)) AS ABCClass,
	ISNULL(ClassificationABC.ClassificationParameterValue, 0) AS ClassificationParameterValue
FROM
	Catalog.Partners AS Partners
		LEFT JOIN ClassificationABC AS ClassificationABC
		ON Partners.Ref = ClassificationABC.Partner
		LEFT JOIN ClassificationOfXYZ AS ClassificationOfXYZ
		ON Partners.Ref = ClassificationOfXYZ.Partner
WHERE
	Partners.RegistrationDate &lt;= &amp;CurrentPeriod
	AND Partners.Client
	AND (NOT Partners.DeletionMark)</query>
