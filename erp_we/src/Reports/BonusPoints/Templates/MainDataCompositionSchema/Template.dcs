		<field xsi:type="DataSetFieldField">
			<dataPath>PartnersSegment</dataPath>
			<field>PartnersSegment</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Customer segment</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>بخش مشتری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Segmento clienti</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Segment klientów</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сегмент клиентов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Müşteri segmenti</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Phân khúc khách hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;


////////////////////////////////////////////////////////////////////////////////
SELECT
	BonusPointsBalance.LoyaltyProgram AS LoyaltyProgram,
	BonusPointsBalance.Partner AS Partner,

	CASE
		WHEN BonusPointsBalance.AccruedBalance - CASE WHEN BonusPointsBalance.ToWriteOffBalance &gt; 0 THEN BonusPointsBalance.ToWriteOffBalance ELSE 0 END &gt;= 0
			THEN BonusPointsBalance.AccruedBalance - CASE WHEN BonusPointsBalance.ToWriteOffBalance &gt; 0 THEN BonusPointsBalance.ToWriteOffBalance ELSE 0 END
		ELSE 0
	END AS Balance

FROM
	AccumulationRegister.BonusPoints.Balance(ENDOFPERIOD(&amp;CurrentDate, DAY), {(LoyaltyProgram), (Partner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)) AS Field2}) AS BonusPointsBalance
WHERE
	CASE
		WHEN BonusPointsBalance.AccruedBalance - CASE WHEN BonusPointsBalance.ToWriteOffBalance &gt; 0 THEN BonusPointsBalance.ToWriteOffBalance ELSE 0 END &gt;= 0
			THEN BonusPointsBalance.AccruedBalance - CASE WHEN BonusPointsBalance.ToWriteOffBalance &gt; 0 THEN BonusPointsBalance.ToWriteOffBalance ELSE 0 END
		ELSE 0
	END &lt;&gt; 0</query>
	</dataSet>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Sum(Balance)</expression>
	</totalField>
