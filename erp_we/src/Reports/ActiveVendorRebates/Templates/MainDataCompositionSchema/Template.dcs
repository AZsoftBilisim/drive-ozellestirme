		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ISNULL(VendorRebatesConditions.Organization, VALUE(Catalog.Companies.EmptyRef)) AS Organization,
	VendorRebatesVendors.Counterparty AS Counterparty,
	VendorRebatesVendors.Partner AS Partner,
	VendorRebatesVendors.Contract AS Contract,
	VendorRebatesVendors.Terms AS Terms,
	VendorRebatesVendors.TermDocument AS TermDocument,
	ISNULL(VendorRebatesConditions.LongDesc, "") AS LongDesc,
	VendorRebatesVendors.ValidOnDate AS ValidOnDate,
	VendorRebatesVendors.ValidTo AS ValidTo,
	ISNULL(VendorRebatesConditions.Kind, VALUE(Catalog.VendorRebateKinds.EmptyRef)) AS RebateKind,
	ISNULL(VendorRebatesConditions.DateOfRemainingGoods, DATETIME(1, 1, 1)) AS DateOfRemainingGoods
{SELECT
	Organization.*,
	Counterparty.*,
	Partner.*,
	Contract.*,
	Terms.*,
	TermDocument.*,
	LongDesc,
	ValidOnDate,
	ValidTo,
	RebateKind.*,
	DateOfRemainingGoods}
FROM
	InformationRegister.VendorRebatesVendors AS VendorRebatesVendors
		LEFT JOIN InformationRegister.VendorRebatesConditions AS VendorRebatesConditions
		ON VendorRebatesVendors.TermDocument = VendorRebatesConditions.TermDocument
WHERE
	ISNULL(VendorRebatesConditions.BonusType, VALUE(Enum.VendorRebateTypes.EmptyRef)) &lt;&gt; VALUE(Enum.VendorRebateTypes.Balance)
{WHERE
	(VendorRebatesVendors.ValidTo &gt;= &amp;ValidOnDate),
	(VendorRebatesVendors.ValidOnDate &lt;= &amp;ValidTo),
	(ISNULL(VendorRebatesConditions.Organization, VALUE(Catalog.Companies.EmptyRef))).* AS Organization,
	VendorRebatesVendors.Counterparty.*,
	VendorRebatesVendors.Partner.*,
	VendorRebatesVendors.Contract.*,
	VendorRebatesVendors.Terms.*,
	VendorRebatesVendors.TermDocument.*,
	(ISNULL(VendorRebatesConditions.Kind, VALUE(Catalog.VendorRebateKinds.EmptyRef))).* AS RebateKind}

UNION ALL

SELECT
	VendorRebatesConditions.Organization,
	ISNULL(VendorRebatesVendors.Counterparty, VALUE(Catalog.Counterparties.EmptyRef)),
	ISNULL(VendorRebatesVendors.Partner, VALUE(Catalog.Partners.EmptyRef)),
	ISNULL(VendorRebatesVendors.Contract, VALUE(Catalog.CounterpartyContracts.EmptyRef)),
	ISNULL(VendorRebatesVendors.Terms, VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef)),
	VendorRebatesConditions.TermDocument,
	VendorRebatesConditions.LongDesc,
	DATETIME(1, 1, 1),
	DATETIME(1, 1, 1),
	VendorRebatesConditions.Kind,
	VendorRebatesConditions.DateOfRemainingGoods
FROM
	InformationRegister.VendorRebatesConditions AS VendorRebatesConditions
		LEFT JOIN InformationRegister.VendorRebatesVendors AS VendorRebatesVendors
		ON VendorRebatesConditions.TermDocument = VendorRebatesVendors.TermDocument
WHERE
	VendorRebatesConditions.BonusType = VALUE(Enum.VendorRebateTypes.Balance)
{WHERE
	(VendorRebatesConditions.DateOfRemainingGoods BETWEEN &amp;ValidOnDate AND &amp;ValidTo),
	VendorRebatesConditions.Organization.*,
	(ISNULL(VendorRebatesVendors.Counterparty, VALUE(Catalog.Counterparties.EmptyRef))).* AS Counterparty,
	(ISNULL(VendorRebatesVendors.Partner, VALUE(Catalog.Partners.EmptyRef))).* AS Partner,
	(ISNULL(VendorRebatesVendors.Contract, VALUE(Catalog.CounterpartyContracts.EmptyRef))).* AS Contract,
	(ISNULL(VendorRebatesVendors.Terms, VALUE(Catalog.TermsOfPurchaseFromVendors.EmptyRef))).* AS Terms,
	VendorRebatesConditions.TermDocument.*,
	VendorRebatesConditions.Kind.* AS RebateKind}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
