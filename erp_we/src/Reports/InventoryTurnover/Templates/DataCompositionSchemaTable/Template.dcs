		<field xsi:type="DataSetFieldField">
			<dataPath>ClassificationType</dataPath>
			<field>ClassificationType</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Table.Products   AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse          AS Warehouse,
	
	ISNULL(SettingUpAGrouping.InventoryReplenishmentMethod,
		Table.InventoryReplenishmentMethod) AS InventoryReplenishmentMethod
	
INTO ProductRestrictions
	
FROM
	InformationRegister.ProductRestrictions AS Table
		
		LEFT JOIN InformationRegister.ProductRestrictions AS SettingUpAGrouping
		ON Table.GroupingProductRestrictions &lt;&gt; VALUE(Catalog.GoodsRestrictionGrouping.EmptyRef)
			AND SettingUpAGrouping.Products   = VALUE(Catalog.Products.EmptyRef)
			AND SettingUpAGrouping.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
			AND SettingUpAGrouping.Warehouse          = VALUE(Catalog.Warehouses.EmptyRef)
			AND SettingUpAGrouping.GroupingProductRestrictions    = Table.GroupingProductRestrictions
			AND SettingUpAGrouping.InventoryReplenishmentMethod &lt;&gt; VALUE(Enum.InventoryReplenishmentMethods.OrderAgainstOrder)

WHERE
	Table.InventoryReplenishmentMethod &lt;&gt; VALUE(Enum.InventoryReplenishmentMethods.OrderAgainstOrder)
	AND Table.Products &lt;&gt; VALUE(Catalog.Products.EmptyRef)
	AND (Table.Products.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.DontUse)
		OR Table.Characteristic &lt;&gt; VALUE(Catalog.ItemsCharacteristics.EmptyRef))
	AND CASE
			WHEN &amp;Products = VALUE(Catalog.Products.EmptyRef)
				THEN TRUE
			ELSE Table.Products = &amp;Products
		END
	AND CASE
			WHEN &amp;Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
				THEN TRUE
			ELSE Table.Characteristic = &amp;Characteristic
		END

UNION ALL

SELECT
	Table.Products        AS Products,
	CharacteristicTable.Ref AS Characteristic,
	Table.Warehouse               AS Warehouse,
	
	Table.InventoryReplenishmentMethod AS InventoryReplenishmentMethod
	
FROM
	InformationRegister.ProductRestrictions AS Table
		
		LEFT JOIN Catalog.Products AS ProductsTable
		ON ProductsTable.Ref = Table.Products
		
		LEFT JOIN Catalog.ItemsCharacteristics AS CharacteristicTable
		ON CharacteristicTable.Owner
			= CASE WHEN ProductsTable.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.SpecialForItems) THEN
						ProductsTable.Ref
					WHEN ProductsTable.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonForItemKind) THEN
						ProductsTable.ProductKind
					WHEN ProductsTable.UseVariants = VALUE(Enum.ItemVariantsUsageOptions.CommonWithOtherItemKind) THEN
						ProductsTable.ItemVariantsOwner
				END
		
		LEFT JOIN InformationRegister.ProductRestrictions AS DetailedSetup
		ON DetailedSetup.Products      = Table.Products
			AND DetailedSetup.Characteristic = CharacteristicTable.Ref
			AND DetailedSetup.Warehouse          = Table.Warehouse
			
WHERE
	Table.InventoryReplenishmentMethod &lt;&gt; VALUE(Enum.InventoryReplenishmentMethods.OrderAgainstOrder)
	AND Table.Products  &lt;&gt; VALUE(Catalog.Products.EmptyRef)
	AND Table.Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	AND Table.Products.UseVariants &lt;&gt; VALUE(Enum.ItemVariantsUsageOptions.DontUse)
	AND DetailedSetup.Warehouse IS NULL
	AND NOT CharacteristicTable.Ref IS NULL
	AND CASE
			WHEN &amp;Products = VALUE(Catalog.Products.EmptyRef)
				THEN TRUE
			ELSE Table.Products = &amp;Products
		END
	AND CASE
			WHEN &amp;Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
				THEN TRUE
			ELSE CharacteristicTable.Ref = &amp;Characteristic
		END
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BalanceOfGoods.GoodsStatus,
	BalanceOfGoods.PartnerWarehouse_ AS PartnerWarehouse_,
	BalanceOfGoods.Warehouse AS Warehouse,
	BalanceOfGoods.Partner AS Partner,
	BalanceOfGoods.Products AS Products,
	BalanceOfGoods.Characteristic,
	BalanceOfGoods.Period AS Period,
	BalanceOfGoods.OpeningBalance AS OpeningBalance,
	BalanceOfGoods.ClosingBalance AS ClosingBalance,
	ISNULL(ABCInventoryClassification.Class, VALUE(Enum.ABCClassification.EmptyRef)) AS ABC,
	ISNULL(XYZInventoryClassification.Class, VALUE(Enum.XYZClassification.EmptyRef)) AS XYZ
FROM
	(SELECT
		"ProductStock" AS GoodsStatus,
		GoodsInWarehousesBalancesAndTurnover.Warehouse AS PartnerWarehouse_,
		GoodsInWarehousesBalancesAndTurnover.Warehouse AS Warehouse,
		NULL AS Partner,
		GoodsInWarehousesBalancesAndTurnover.Products AS Products,
		GoodsInWarehousesBalancesAndTurnover.Characteristic AS Characteristic,
		GoodsInWarehousesBalancesAndTurnover.Period AS Period,
		ISNULL(GoodsInWarehousesBalancesAndTurnover.InStockOpeningBalance, 0) AS OpeningBalance,
		ISNULL(GoodsInWarehousesBalancesAndTurnover.InStockTurnover, 0) AS Turnover,
		ISNULL(GoodsInWarehousesBalancesAndTurnover.InStockClosingBalance, 0) AS ClosingBalance
	FROM
		AccumulationRegister.ProductStock.BalanceAndTurnovers(
				&amp;StrtDate,
				&amp;FinishDate,
				Month,
				,
				CASE
						WHEN &amp;Products = VALUE(Catalog.Products.EmptyRef)
							THEN TRUE
						ELSE Products = &amp;Products
					END
					AND CASE
						WHEN &amp;Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
							THEN TRUE
						ELSE Characteristic = &amp;Characteristic
					END) AS GoodsInWarehousesBalancesAndTurnover
			LEFT JOIN ProductRestrictions AS ProductRestrictions
			ON ProductRestrictions.Warehouse = GoodsInWarehousesBalancesAndTurnover.Warehouse
				AND ProductRestrictions.Products = GoodsInWarehousesBalancesAndTurnover.Products
				AND ProductRestrictions.Characteristic = GoodsInWarehousesBalancesAndTurnover.Characteristic
	WHERE
		(&amp;AllGoods
				OR &amp;ProductStock)
			AND (NOT &amp;OnlyGoodsOfSupportedStock OR NOT ProductRestrictions.Products IS NULL)
	
	UNION ALL
	
	SELECT
		"GoodsFromCommissionAgents",
		GoodsTransferredToCommissionAgentBalanceAndTurnovers.ItemsLocationAttributes.Partner,
		NULL,
		GoodsTransferredToCommissionAgentBalanceAndTurnovers.ItemsLocationAttributes.Partner,
		GoodsTransferredToCommissionAgentBalanceAndTurnovers.ItemsLocationAttributes.Products,
		GoodsTransferredToCommissionAgentBalanceAndTurnovers.ItemsLocationAttributes.Characteristic,
		GoodsTransferredToCommissionAgentBalanceAndTurnovers.Period,
		ISNULL(GoodsTransferredToCommissionAgentBalanceAndTurnovers.CountOpeningBalance, 0),
		ISNULL(GoodsTransferredToCommissionAgentBalanceAndTurnovers.CountTurnover, 0),
		ISNULL(GoodsTransferredToCommissionAgentBalanceAndTurnovers.CountClosingBalance, 0)
	FROM
		AccumulationRegister.GoodsTransferredToCommissionAgent.BalanceAndTurnovers(
				&amp;StrtDate,
				&amp;FinishDate,
				Month,
				,
				CASE
						WHEN &amp;Products = VALUE(Catalog.Products.EmptyRef)
							THEN TRUE
						ELSE ItemsLocationAttributes.Products = &amp;Products
					END
					AND CASE
						WHEN &amp;Characteristic = VALUE(Catalog.ItemsCharacteristics.EmptyRef)
							THEN TRUE
						ELSE ItemsLocationAttributes.Characteristic = &amp;Characteristic
					END) AS GoodsTransferredToCommissionAgentBalanceAndTurnovers
	WHERE
		(&amp;AllGoods
				OR &amp;GoodsFromCommissionAgents)) AS BalanceOfGoods
		LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				&amp;FinishDate,
				ClassificationType = VALUE(Enum.TypesOfClassification.ABC)
					AND CASE
						WHEN &amp;ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.EmptyRef)
							THEN FALSE
						ELSE ClassificationParameterType = &amp;ClassificationParameterType
					END) AS ABCInventoryClassification
		ON BalanceOfGoods.Warehouse = ABCInventoryClassification.ClassificationSection
			AND BalanceOfGoods.Products = ABCInventoryClassification.Products
			AND BalanceOfGoods.Characteristic = ABCInventoryClassification.Characteristic
		LEFT JOIN InformationRegister.ABCXYZInventoryClassification.SliceLast(
				&amp;FinishDate,
				ClassificationType = VALUE(Enum.TypesOfClassification.XYZ)
					AND CASE
						WHEN &amp;ClassificationParameterType = VALUE(Enum.TypesOfClassificationParameters.EmptyRef)
							THEN FALSE
						ELSE ClassificationParameterType = &amp;ClassificationParameterType
					END) AS XYZInventoryClassification
		ON BalanceOfGoods.Warehouse = XYZInventoryClassification.ClassificationSection
			AND BalanceOfGoods.Products = XYZInventoryClassification.Products
			AND BalanceOfGoods.Characteristic = XYZInventoryClassification.Characteristic
WHERE
	CASE
			WHEN &amp;PartnerWarehouse_ = VALUE(Catalog.Warehouses.EmptyRef)
					OR &amp;PartnerWarehouse_ = VALUE(Catalog.Partners.EmptyRef)
					OR &amp;PartnerWarehouse_ = UNDEFINED
				THEN TRUE
			ELSE BalanceOfGoods.PartnerWarehouse_ = &amp;PartnerWarehouse_
		END</query>
	</dataSet>
