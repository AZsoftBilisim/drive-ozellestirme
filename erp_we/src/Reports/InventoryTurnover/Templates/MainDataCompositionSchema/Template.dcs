				<v8:lang>tr</v8:lang>
				<v8:content>Devir sapması (verilen)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chênh lệch quay vòng (đã thực hiện)</v8:content>
			</v8:item>
		</title>
		<presentationExpression>Case When Case When &amp;CalculationMethod_2 = 1 Then
TurnoverDeviation
Else
TurnoverDeviationAmount
End &lt;&gt; 0 Then String(Cast(Case When &amp;CalculationMethod_2 = 1 Then
TurnoverDeviation
Else
TurnoverDeviationAmount
End, "Number(20,2)")) + "%" Else Case When &amp;CalculationMethod_2 = 1 Then
TurnoverDeviation
Else
TurnoverDeviationAmount
End End</presentationExpression>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
