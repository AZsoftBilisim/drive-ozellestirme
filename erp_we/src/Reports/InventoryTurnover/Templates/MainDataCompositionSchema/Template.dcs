	</calculatedField>
	<totalField>
		<dataPath>NumberOfIntervalsInPeriod</dataPath>
		<expression>Max(NumberOfIntervalsInPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalance</dataPath>
		<expression>Sum(ClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>FinalBalanceAmount</dataPath>
		<expression>Sum(FinalBalanceAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForThePeriod</dataPath>
		<expression>Sum(AverageBalanceForThePeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForPeriodAmount</dataPath>
		<expression>Sum(AverageBalanceForPeriodAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseForPeriod</dataPath>
		<expression>Sum(ExpenseForPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseForPeriodAmount</dataPath>
		<expression>Sum(ExpenseForPeriodAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverRatio</dataPath>
		<expression>Case When Sum(AverageBalanceForThePeriod) = 0 Then 0 Else Cast(Sum(ExpenseForPeriod) / Sum(AverageBalanceForThePeriod), "Number(20, 3)") End</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverRatioSum</dataPath>
		<expression>Case When Sum(AverageBalanceForPeriodAmount) = 0 Then 0 Else Cast(Sum(ExpenseForPeriodAmount) / Sum(AverageBalanceForPeriodAmount),  "Number(20, 3)") End</expression>
	</totalField>
	<totalField>
		<dataPath>Turnover_</dataPath>
		<expression>Case When Sum(ExpenseForPeriod) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriod) * Sum(AverageBalanceForThePeriod) / Sum(ExpenseForPeriod), "Number(20, 3)") End</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverAmount</dataPath>
		<expression>Case When Sum(ExpenseForPeriodAmount) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriod) * Sum(AverageBalanceForPeriodAmount) / Sum(ExpenseForPeriodAmount), "Number(20, 3)") End</expression>
	</totalField>
	<totalField>
		<dataPath>MediumExpense</dataPath>
		<expression>Sum(MediumExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>AverageExpenseAmount</dataPath>
		<expression>Sum(AverageExpenseAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>StockLevel</dataPath>
		<expression>Min(StockLevel)</expression>
	</totalField>
	<totalField>
		<dataPath>StockLevelAmount</dataPath>
		<expression>Min(StockLevelAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>Reserve</dataPath>
		<expression>Sum(Reserve)</expression>
	</totalField>
	<totalField>
		<dataPath>ReserveAmount</dataPath>
		<expression>Sum(ReserveAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForPeriodPriorPeriod</dataPath>
		<expression>Sum(AverageBalanceForPeriodPriorPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForPeriodAmountOfPreviousPeriod</dataPath>
		<expression>Sum(AverageBalanceForPeriodAmountOfPreviousPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForPeriodLastYear</dataPath>
		<expression>Sum(AverageBalanceForPeriodLastYear)</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForPeriodLastYear_</dataPath>
		<expression>Sum(AverageBalanceForPeriodLastYear_)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseForPeriodPreviousPeriod</dataPath>
		<expression>Sum(ExpenseForPeriodPreviousPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseForPeriodAmountOfPreviousPeriod</dataPath>
		<expression>Sum(ExpenseForPeriodAmountOfPreviousPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenditureForPeriodLastYear</dataPath>
		<expression>Sum(ExpenditureForPeriodLastYear)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseForPeriodLastYear</dataPath>
		<expression>Sum(ExpenseForPeriodLastYear)</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverPreviousPeriod</dataPath>
		<expression>Case When Sum(ExpenseForPeriodPreviousPeriod) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriodPreviousPeriod) * Sum(AverageBalanceForPeriodPriorPeriod) / Sum(ExpenseForPeriodPreviousPeriod), "Number(20, 3)") End</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverAmountPreviousPeriod</dataPath>
		<expression>Case When Sum(ExpenseForPeriodAmountOfPreviousPeriod) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriodPreviousPeriod) * Sum(AverageBalanceForPeriodAmountOfPreviousPeriod) / Sum(ExpenseForPeriodAmountOfPreviousPeriod), "Number(20, 3)") End</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverLastYear</dataPath>
		<expression>Case When Sum(ExpenditureForPeriodLastYear) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriodLastYear) * Sum(AverageBalanceForPeriodLastYear) / Sum(ExpenditureForPeriodLastYear), "Number(20, 3)") End</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverLastYear_</dataPath>
		<expression>Case When Sum(ExpenseForPeriodLastYear) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriodLastYear) * Sum(AverageBalanceForPeriodLastYear_) / Sum(ExpenseForPeriodLastYear), "Number(20, 3)") End</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfIntervalsInPeriodLastYear</dataPath>
		<expression>Max(NumberOfIntervalsInPeriodLastYear)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfIntervalsInPeriodPreviousPeriod</dataPath>
		<expression>Max(NumberOfIntervalsInPeriodPreviousPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>DynamicsOfLastYear</dataPath>
		<expression>Count(DynamicsOfLastYear)</expression>
	</totalField>
	<totalField>
		<dataPath>DynamicsOverPastYear</dataPath>
		<expression>Count(DynamicsOverPastYear)</expression>
	</totalField>
	<totalField>
		<dataPath>DynamicsPreviousPeriod</dataPath>
		<expression>Count(DynamicsPreviousPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>DynamicsForPreviousPeriod</dataPath>
		<expression>Count(DynamicsForPreviousPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>FinalRemainder</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(ClosingBalance)
Else
Sum(FinalBalanceAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForReportingPeriod</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(AverageBalanceForThePeriod)
Else
Sum(AverageBalanceForPeriodAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseForReportingPeriod</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(ExpenseForPeriod)
Else
Sum(ExpenseForPeriodAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>LedTurnoverRatio</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Case When Sum(AverageBalanceForThePeriod) = 0 Then 0 Else Cast(Sum(ExpenseForPeriod) / Sum(AverageBalanceForThePeriod), "Number(20, 3)") End
Else
Case When Sum(AverageBalanceForPeriodAmount) = 0 Then 0 Else Cast(Sum(ExpenseForPeriodAmount) / Sum(AverageBalanceForPeriodAmount),  "Number(20, 3)") End
End</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverReduced</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Case When Sum(ExpenseForPeriod) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriod) * Sum(AverageBalanceForThePeriod) / Sum(ExpenseForPeriod), "Number(20, 3)") End
Else
Case When Sum(ExpenseForPeriodAmount) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriod) * Sum(AverageBalanceForPeriodAmount) / Sum(ExpenseForPeriodAmount), "Number(20, 3)") End
End</expression>
	</totalField>
	<totalField>
		<dataPath>AverageFuelConsumption</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(MediumExpense)
Else
Sum(AverageExpenseAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>InventoryLevelGiven</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Min(StockLevel)
Else
Min(StockLevelAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>LedReserve</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(Reserve)
Else
Sum(ReserveAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForPeriodPreviousReportingPeriod</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(AverageBalanceForPeriodPriorPeriod)
Else
Sum(AverageBalanceForPeriodAmountOfPreviousPeriod)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AverageBalanceForPeriodLastYearGiven</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(AverageBalanceForPeriodLastYear)
Else
Sum(AverageBalanceForPeriodLastYear_)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseForPeriodLastYearGiven</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(ExpenditureForPeriodLastYear)
Else
Sum(ExpenseForPeriodLastYear)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseForPeriodPreviousPeriodGiven</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Sum(ExpenseForPeriodPreviousPeriod)
Else
Sum(ExpenseForPeriodAmountOfPreviousPeriod)
End</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverPreviousPeriodGiven</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Case When Sum(ExpenseForPeriodPreviousPeriod) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriodPreviousPeriod) * Sum(AverageBalanceForPeriodPriorPeriod) / Sum(ExpenseForPeriodPreviousPeriod), "Number(20, 3)") End
Else
Case When Sum(ExpenseForPeriodAmountOfPreviousPeriod) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriodPreviousPeriod) * Sum(AverageBalanceForPeriodAmountOfPreviousPeriod) / Sum(ExpenseForPeriodAmountOfPreviousPeriod), "Number(20, 3)") End
End</expression>
	</totalField>
	<totalField>
		<dataPath>TurnoverLastYearGiven</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Case When Sum(ExpenditureForPeriodLastYear) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriodLastYear) * Sum(AverageBalanceForPeriodLastYear) / Sum(ExpenditureForPeriodLastYear), "Number(20, 3)") End
Else
Case When Sum(ExpenseForPeriodLastYear) = 0 Then 0 Else Cast(Max(NumberOfIntervalsInPeriodLastYear) * Sum(AverageBalanceForPeriodLastYear_) / Sum(ExpenseForPeriodLastYear), "Number(20, 3)") End
End</expression>
	</totalField>
	<totalField>
		<dataPath>DynamicsLastYearGiven</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Count(DynamicsOfLastYear)
Else
Count(DynamicsOverPastYear)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DynamicsOfPreviousPeriodGiven</dataPath>
		<expression>Case When &amp;CalculationMethod_2 = 1 Then
Count(DynamicsPreviousPeriod)
Else
Count(DynamicsForPreviousPeriod)
End</expression>
	</totalField>
