			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Rebate.OpeningBalance</dataPath>
		<expression>Case
	When Sum(Rebate.OpeningBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
	And Count(Distinct TermDocument) = 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.OpeningBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	When Count(Distinct TermDocument) = 1
	And Count(Distinct Currency) = 1
	Then Sum(Rebate.OpeningBalance)
	Else 0
End</expression>
		<group>TermDocument</group>
	</totalField>
	<totalField>
		<dataPath>Rebate.Accrued</dataPath>
		<expression>Case
	When Sum(Rebate.Accrued) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.Accrued), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.Accrued)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.Certified</dataPath>
		<expression>Case
	When Sum(Rebate.Certified) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.Certified), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.Certified)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.WrittenOff</dataPath>
		<expression>Case
	When Sum(Rebate.WrittenOff) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.WrittenOff), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.WrittenOff)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.ToWriteOff</dataPath>
		<expression>Case
	When Sum(Rebate.ToWriteOff) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ToWriteOff), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	Else Sum(Rebate.ToWriteOff)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Rebate.ClosingBalance</dataPath>
		<expression>Case
	When Sum(Rebate.ClosingBalance) &lt;&gt; 0
	And Count(Distinct Currency) &gt; 1
	And Count(Distinct TermDocument) = 1
		Then DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Rebate.ClosingBalance), ""NFD=2; NZ=0,00""), Currency","Currency")), ";", "")
	When Count(Distinct TermDocument) = 1
	And Count(Distinct Currency) = 1
	Then Sum(Rebate.ClosingBalance)
	Else 0
End</expression>
		<group>TermDocument</group>
	</totalField>
	<totalField>
		<dataPath>Comment</dataPath>
		<expression>Case
	When &amp;ContextConditionsDocument
		Then Comment
	Else ""
End</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Comment</dataPath>
		<expression>Case
	When Not &amp;ContextConditionsDocument
		Then Comment
	Else "" 
End
</expression>
		<group>TermDocument</group>
	</totalField>
	<totalField>
		<dataPath>Completed</dataPath>
		<expression>Case
	When &amp;ContextConditionsDocument
		Then Completed
	Else ""
End</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Completed</dataPath>
		<expression>Case
	When Not &amp;ContextConditionsDocument
		Then Case
			When TermDocument &lt;&gt; Value(Document.ConditionsOfVendorRebates.EmptyRef)
				Then Completed
			Else ""
		End
	Else "" 
End</expression>
		<group>TermDocument</group>
	</totalField>
