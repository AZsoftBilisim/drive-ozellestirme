		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CASE
		WHEN DataTable.Recorder = UNDEFINED
			THEN NULL
		ELSE DataTable.Recorder
	END AS Recorder,
	DataTable.SecondPeriod AS SecondPeriod,
	DataTable.DayPeriod AS DayPeriod,
	DataTable.WeekPeriod AS WeekPeriod,
	DataTable.MonthPeriod AS MonthPeriod,
	DataTable.QuarterPeriod AS QuarterPeriod,
	DataTable.HalfYearPeriod AS HalfYearPeriod,
	DataTable.YearPeriod AS YearPeriod,
	DataTable.Organization AS Organization,
	DataTable.Counterparty AS Counterparty,
	DataTable.Partner AS Partner,
	DataTable.Contract AS Contract,
	DataTable.BeginOfPeriod AS BeginOfPeriod,
	DataTable.PeriodEnding AS PeriodEnding,
	DataTable.TermDocument AS TermDocument,
	DataTable.Currency AS Currency,
	CASE
		WHEN DataTable.TypeOfRegisterMovement = VALUE(Enum.AccumulationRecordTypes.Receipt)
			THEN DataTable.AccruedTurnover
		ELSE -DataTable.ToWriteOffTurnover - DataTable.WrittenOffTurnover - DataTable.CertifiedTurnover
	END AS OpeningBalance,
	0 AS Accrued,
	0 AS ToWriteOff,
	0 AS WrittenOff,
	0 AS Certified,
	ISNULL(VendorRebatesConditions.ValidOnDate, DATETIME(1, 1, 1)) AS ValidOnDate,
	ISNULL(VendorRebatesConditions.ValidTo, DATETIME(1, 1, 1)) AS ValidTo,
	ISNULL(VendorRebatesConditions.LongDesc, "") AS LongDesc,
	ISNULL(VendorRebatesConditions.Kind, VALUE(Catalog.VendorRebateKinds.EmptyRef)) AS Kind,
	ISNULL(VendorRebatesConditions.BonusType, VALUE(Enum.VendorRebateTypes.EmptyRef)) AS BonusType,
	ISNULL(CompletedRebatesTermsAndConditions.Completed, FALSE) AS Completed
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	Organization.*,
	Counterparty.*,
	Partner.*,
	Contract.*,
	TermDocument.*,
	BeginOfPeriod,
	PeriodEnding,
	Currency.*,
	OpeningBalance,
	Accrued,
	ToWriteOff,
	WrittenOff,
	Certified,
	ValidOnDate,
	ValidTo,
	LongDesc,
	Kind.*,
	BonusType.*,
	Completed}
FROM
	AccumulationRegister.VendorRebates.Turnovers(, {(&amp;EndOfPeriodOpeningBalance)}, Auto, &amp;PeriodIsSpecified {(Organization).* AS Organization, (Counterparty).* AS Counterparty, (Partner).* AS Partner, (Contract).* AS Contract, (TermDocument).* AS TermDocument, (Currency).* AS Currency}) AS DataTable
		{LEFT JOIN InformationRegister.VendorRebatesConditions AS VendorRebatesConditions
		ON DataTable.TermDocument = VendorRebatesConditions.TermDocument}
		LEFT JOIN InformationRegister.CompletedConditionsOfVendorRebates AS CompletedRebatesTermsAndConditions
		ON DataTable.TermDocument = CompletedRebatesTermsAndConditions.TermDocument
WHERE
	DataTable.TermDocument &lt;&gt; VALUE(Document.ConditionsOfVendorRebates.EmptyRef)

UNION ALL

SELECT
	CASE
		WHEN DataTable.Recorder = UNDEFINED
			THEN NULL
		ELSE DataTable.Recorder
	END,
	DataTable.SecondPeriod,
	DataTable.DayPeriod,
	DataTable.WeekPeriod,
	DataTable.MonthPeriod,
	DataTable.QuarterPeriod,
	DataTable.HalfYearPeriod,
	DataTable.YearPeriod,
	DataTable.Organization,
	DataTable.Counterparty,
	DataTable.Partner,
	DataTable.Contract,
	DataTable.BeginOfPeriod,
	DataTable.PeriodEnding,
	DataTable.TermDocument,
	DataTable.Currency,
	0,
	CASE
		WHEN DataTable.TypeOfRegisterMovement = VALUE(Enum.AccumulationRecordTypes.Receipt)
			THEN DataTable.AccruedTurnover
		ELSE 0
	END,
	CASE
		WHEN DataTable.TypeOfRegisterMovement = VALUE(Enum.AccumulationRecordTypes.Expense)
			THEN DataTable.ToWriteOffTurnover
		ELSE 0
	END,
	CASE
		WHEN DataTable.TypeOfRegisterMovement = VALUE(Enum.AccumulationRecordTypes.Expense)
			THEN DataTable.WrittenOffTurnover
		ELSE 0
	END,
	CASE
		WHEN DataTable.TypeOfRegisterMovement = VALUE(Enum.AccumulationRecordTypes.Expense)
			THEN DataTable.CertifiedTurnover
		ELSE 0
	END,
	ISNULL(VendorRebatesConditions.ValidOnDate, DATETIME(1, 1, 1)),
	ISNULL(VendorRebatesConditions.ValidTo, DATETIME(1, 1, 1)),
	ISNULL(VendorRebatesConditions.LongDesc, ""),
	ISNULL(VendorRebatesConditions.Kind, VALUE(Catalog.VendorRebateKinds.EmptyRef)),
	ISNULL(VendorRebatesConditions.BonusType, VALUE(Enum.VendorRebateTypes.EmptyRef)),
	ISNULL(CompletedRebatesTermsAndConditions.Completed, FALSE)
FROM
	AccumulationRegister.VendorRebates.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto, {(Organization).* AS Organization, (Counterparty).* AS Counterparty, (Partner).* AS Partner, (Contract).* AS Contract, (TermDocument).* AS TermDocument, (Currency).* AS Currency}) AS DataTable
		{LEFT JOIN InformationRegister.VendorRebatesConditions AS VendorRebatesConditions
		ON DataTable.TermDocument = VendorRebatesConditions.TermDocument}
		LEFT JOIN InformationRegister.CompletedConditionsOfVendorRebates AS CompletedRebatesTermsAndConditions
		ON DataTable.TermDocument = CompletedRebatesTermsAndConditions.TermDocument</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>Comment</dataPath>
		<expression>Case
	When TermDocument = Value(Document.ConditionsOfVendorRebates.EmptyRef)
		Then &amp;CommentEmptyCondition
	When Completed
		Then &amp;CommentCompleted
	Else ""
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Comment</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>توضیحات</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Commento</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Komentarz</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Комментарий</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Yorum</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Ghi chú</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:string</v8:Type>
			<v8:StringQualifiers>
				<v8:Length>0</v8:Length>
				<v8:AllowedLength>Variable</v8:AllowedLength>
			</v8:StringQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>Rebate.ClosingBalance</dataPath>
		<expression>Case
	When Completed
		Or TermDocument = Value(Document.ConditionsOfVendorRebates.EmptyRef)
		Then 0
	Else Rebate.OpeningBalance + Rebate.Accrued - Rebate.WrittenOff - Rebate.ToWriteOff - Rebate.Certified
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Closing discrepancy</v8:content>
