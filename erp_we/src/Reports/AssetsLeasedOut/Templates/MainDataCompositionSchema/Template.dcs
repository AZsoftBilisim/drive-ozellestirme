		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	AssetsLeasedOut.Organization AS Organization,
	AssetsLeasedOut.FixedAsset AS FixedAsset,
	AssetsLeasedOut.Partner AS Leaseholder,
	AssetsLeasedOut.Counterparty AS Counterparty,
	AssetsLeasedOut.Contract AS Contract,
	AssetsLeasedOut.SecurityDepositValue AS SecurityDepositValue,
	AssetsLeasedOut.TransferDate AS TransferDate,
	AssetsLeasedOut.Contract.LeaseContracts AS LeaseContracts,
	AssetsLeasedOut.Contract.ContractType AS ContractType
{WHERE
	AssetsLeasedOut.Partner.* AS Leaseholder,
	AssetsLeasedOut.Organization.* AS Organization}
INTO TT_AssetsLeasedOut
FROM
	InformationRegister.AssetsLeasedOut.SliceLast({&amp;Period}) AS AssetsLeasedOut
WHERE
	AssetsLeasedOut.State = VALUE(Enum.FixedAssetsStates.LeasedOut)

INDEX BY
	FixedAsset
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	FALocation.FixedAsset AS FixedAsset,
	FALocation.Organization AS Organization,
	FALocation.FixedAssetsLocation AS Department,
	FALocation.FinanciallyLiablePerson AS FinanciallyLiablePerson
INTO TT_FALocation
FROM
	InformationRegister.FALocation.SliceLast({&amp;Period}, CorrectionDate = DATETIME(1, 1, 1)
	AND FixedAsset IN
		(SELECT
			TT_AssetsLeasedOut.FixedAsset
		FROM
			TT_AssetsLeasedOut)) AS FALocation

INDEX BY
	FixedAsset
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AccountingProcedureForOSBU.Organization AS Organization,
	AccountingProcedureForOSBU.FixedAsset AS FixedAsset,
	AccountingProcedureForOSBU.DepreciationGroup AS DepreciationGroup,
	AccountingProcedureForOSBU.RealEstate AS RealEstate
INTO TT_AccountingProcedureForOSBU
FROM
	InformationRegister.AccountingProcedureForOSBU.SliceLast(
		{&amp;Period}, 
		CorrectionDate = DATETIME(1,1,1)
			AND FixedAsset IN
				(SELECT
					TT_AssetsLeasedOut.FixedAsset
				FROM
					TT_AssetsLeasedOut)) AS AccountingProcedureForOSBU
{WHERE
	AccountingProcedureForOSBU.DepreciationGroup.* AS DepreciationGroup,
	AccountingProcedureForOSBU.RealEstate AS RealEstate}

INDEX BY
	FixedAsset
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	InvestmentInRentBalance.Organization AS Organization,
	InvestmentInRentBalance.Contract AS Contract,
	InvestmentInRentBalance.FixedAsset AS FixedAsset,
	InvestmentInRentBalance.NonGuaranteedResidualValueLocalBalance AS NonGuaranteedResidualValueLocal
INTO VT_ENGLSForRent
FROM
	AccumulationRegister.InvestmentInRent.Balance({&amp;Period}, {Organization.*}) AS InvestmentInRentBalance

INDEX BY
	FixedAsset
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN TT_AssetsLeasedOut.ContractType NOT IN (VALUE(Enum.ContractTypes.TransferToRental),
			VALUE(Enum.ContractTypes.Sublease))
			THEN 1
		WHEN TT_AssetsLeasedOut.ContractType = VALUE(Enum.ContractTypes.TransferToRental)
			THEN 2
		WHEN TT_AssetsLeasedOut.ContractType = VALUE(Enum.ContractTypes.Sublease)
			THEN 3
		ELSE 1
	END AS ContractType,
	TT_FALocation.Organization AS Organization,
	TT_FALocation.Department AS Department,
	TT_FALocation.FinanciallyLiablePerson AS FinanciallyLiablePerson,
	TT_FALocation.FixedAsset AS FixedAsset,
	TT_AssetsLeasedOut.Leaseholder AS Leaseholder,
	TT_AssetsLeasedOut.Counterparty AS Counterparty,
	TT_AssetsLeasedOut.Contract AS Contract,
	TT_AssetsLeasedOut.Contract.ValidityStartDate AS ContractIsValidFrom,
	TT_AssetsLeasedOut.Contract.ValidityEndDate AS ContractIsValidFor,
	TT_AssetsLeasedOut.TransferDate AS TransferDate,
	TT_AssetsLeasedOut.SecurityDepositValue AS SecurityDepositValue,
	TT_AssetsLeasedOut.LeaseContracts AS LeaseContracts,
	TT_AssetsLeasedOut.LeaseContracts.Partner AS PartnerLandlord,
	TT_AssetsLeasedOut.LeaseContracts.Counterparty AS CounterpartyLessor,
	TT_AssetsLeasedOut.LeaseContracts.ValidityStartDate AS LeaseContractIsValidFrom,
	TT_AssetsLeasedOut.LeaseContracts.ValidityEndDate AS LeaseContractIsValidFor,
	VT_ENGLSForRent.NonGuaranteedResidualValueLocal AS NonGuaranteedResidualValueLocal,
	TT_AccountingProcedureForOSBU.DepreciationGroup AS DepreciationGroup,
	TT_AccountingProcedureForOSBU.RealEstate AS RealEstate
FROM
	TT_FALocation AS TT_FALocation
		
		LEFT JOIN TT_AssetsLeasedOut AS TT_AssetsLeasedOut
		ON TT_AssetsLeasedOut.Organization = TT_FALocation.Organization
			AND TT_AssetsLeasedOut.FixedAsset = TT_FALocation.FixedAsset

		LEFT JOIN VT_ENGLSForRent AS VT_ENGLSForRent
		ON TT_FALocation.Organization = VT_ENGLSForRent.Organization
			AND TT_FALocation.FixedAsset = VT_ENGLSForRent.FixedAsset
		
		LEFT JOIN TT_AccountingProcedureForOSBU AS TT_AccountingProcedureForOSBU
		ON TT_AccountingProcedureForOSBU.Organization = TT_FALocation.Organization		
			AND TT_AccountingProcedureForOSBU.FixedAsset = TT_FALocation.FixedAsset
		</query>
	</dataSet>
	<totalField>
		<dataPath>SecurityDepositValue</dataPath>
		<expression>Sum(SecurityDepositValue)</expression>
	</totalField>
	<totalField>
		<dataPath>NonGuaranteedResidualValueLocal</dataPath>
		<expression>Sum(NonGuaranteedResidualValueLocal)</expression>
	</totalField>
