				<dcscom:dimension>true</dcscom:dimension>
				<dcscom:parentDimension>Products</dcscom:parentDimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN MaterialConsumptionPlansTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN MaterialConsumptionPlansTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN MaterialConsumptionPlansTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN MaterialConsumptionPlansTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN MaterialConsumptionPlansTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN MaterialConsumptionPlansTurnovers.YearPeriod
		ELSE MaterialConsumptionPlansTurnovers.DayPeriod
	END AS DynamicPeriod,
	MaterialConsumptionPlansTurnovers.Products AS Products,
	MaterialConsumptionPlansTurnovers.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN MaterialConsumptionPlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	MaterialConsumptionPlansTurnovers.ProductionDispatcherBusinessUnit AS ProductionDispatcherBusinessUnit,
	MaterialConsumptionPlansTurnovers.AssigneeBusinessUnit AS AssigneeBusinessUnit,
	MaterialConsumptionPlansTurnovers.Warehouse AS Warehouse,
	MaterialConsumptionPlansTurnovers.ProductsItems AS ProductsItems,
	MaterialConsumptionPlansTurnovers.ItemVariant AS ItemVariant,
	CASE
		WHEN &amp;SpecifyTargets
			THEN MaterialConsumptionPlansTurnovers.AssignmentOfProducts
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS AssignmentOfProducts,
	ProductionPlansTurnovers.Products.UnitOfMeasure AS StorageUnit,
	ProductionPlansTurnovers.Products.UnitForReports AS UnitForReports,
	ProductionPlansTurnovers.BillOfMaterials AS BillOfMaterials,
	MaterialConsumptionPlansTurnovers.ProductionPlan AS ProductionPlan,
	MaterialConsumptionPlansTurnovers.ProductionDate AS ProductionDate,
	MaterialConsumptionPlansTurnovers.ThisIsASemiFinishedProduct AS ThisIsASemiFinishedProduct,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN MaterialConsumptionPlansTurnovers.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN MaterialConsumptionPlansTurnovers.ProductsItems.UnitFactorForReports &lt;&gt; 0
						THEN MaterialConsumptionPlansTurnovers.CountTurnover / MaterialConsumptionPlansTurnovers.Products.UnitFactorForReports
					ELSE 0
				END
	END AS MaterialQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductionPlansTurnovers.CountTurnover
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN ProductionPlansTurnovers.Products.UnitFactorForReports &lt;&gt; 0
						THEN ProductionPlansTurnovers.CountTurnover / ProductionPlansTurnovers.Products.UnitFactorForReports
					ELSE 0
				END
	END AS ProductsQuantity
FROM
	AccumulationRegister.MaterialConsumptionPlans.Turnovers(, , Auto, Scenario = &amp;Scenario) AS MaterialConsumptionPlansTurnovers
		{LEFT JOIN AccumulationRegister.ProductionPlans.Turnovers({(&amp;PlanPeriodStart)}, {(&amp;PlanPeriodEnd)}, Day, Scenario = &amp;Scenario {(Products) AS ProductsItems, (Characteristic) AS ItemVariant, (Department) AS ProductionDispatcherBusinessUnit, (Purpose) AS AssignmentOfProducts}) AS ProductionPlansTurnovers
		ON MaterialConsumptionPlansTurnovers.ProductsItems = ProductionPlansTurnovers.Products
			AND MaterialConsumptionPlansTurnovers.ItemVariant = ProductionPlansTurnovers.Characteristic
			AND MaterialConsumptionPlansTurnovers.AssignmentOfProducts = ProductionPlansTurnovers.Purpose
			AND MaterialConsumptionPlansTurnovers.ProductionDispatcherBusinessUnit = ProductionPlansTurnovers.Department
			AND MaterialConsumptionPlansTurnovers.Scenario = ProductionPlansTurnovers.Scenario
			AND MaterialConsumptionPlansTurnovers.ProductionPlan = ProductionPlansTurnovers.ProductionPlan
			AND MaterialConsumptionPlansTurnovers.ProductionDate = ProductionPlansTurnovers.Period}</query>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        Products.UnitOfMeasure
    When &amp;QuantityUnits = 1 Then
        Products.UnitForReports
End</expression>
