		<field xsi:type="DataSetFieldField">
			<dataPath>Organization</dataPath>
			<field>Organization</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	EmploymentRecordSliceLast.Period AS Period,
	EmploymentRecordSliceLast.Organization AS Organization,
	EmploymentRecordSliceLast.Employee AS Employee
INTO TT_Total
FROM
	InformationRegister.EmploymentRecord.SliceLast(&amp;PeriodEnding, ) AS EmploymentRecordSliceLast
WHERE
	CASE
			WHEN EmploymentRecordSliceLast.EventKind = VALUE(Enum.HREventKindsPayrollAndHumanResources.Move)
				THEN EmploymentRecordSliceLast.WorksInBusinessUnit
			ELSE TRUE
		END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SUM(CASE
			WHEN ISNULL(EmploymentRecordSliceFirst.Period, DATETIME(1, 1, 1)) &lt;= &amp;BeginOfPeriod
					AND (ISNULL(PersonnelHistoryHRSectionOfLastFired.Period, DATETIME(1, 1, 1)) = DATETIME(1, 1, 1)
						OR ISNULL(PersonnelHistoryHRSectionOfLastFired.Period, DATETIME(1, 1, 1)) &gt; &amp;BeginOfPeriod)
				THEN 1
			ELSE 0
		END) AS TheyWorkAtBeginningOfTotalPeriod,
	SUM(CASE
			WHEN ISNULL(EmploymentRecordSliceFirst.Period, DATETIME(1, 1, 1)) BETWEEN &amp;BeginOfPeriod AND &amp;PeriodEnding
				THEN 1
			ELSE 0
		END) AS AcceptedForPeriodTotal,
	SUM(CASE
			WHEN ISNULL(PersonnelHistoryHRSectionOfLastFired.Period, DATETIME(1, 1, 1)) BETWEEN &amp;BeginOfPeriod AND &amp;PeriodEnding
				THEN 1
			ELSE 0
		END) AS DismissedForPeriodTotal,
	SUM(CASE
			WHEN ISNULL(EmploymentRecordSliceFirst.Period, DATETIME(1, 1, 1)) &lt;= &amp;PeriodEnding
					AND (ISNULL(PersonnelHistoryHRSectionOfLastFired.Period, DATETIME(1, 1, 1)) = DATETIME(1, 1, 1)
						OR ISNULL(PersonnelHistoryHRSectionOfLastFired.Period, DATETIME(1, 1, 1)) &gt; &amp;PeriodEnding)
				THEN 1
			ELSE 0
		END) AS TheyWorkAtEndOfTotalPeriod
FROM
	TT_Total AS TT_Total
		LEFT JOIN InformationRegister.EmploymentRecord.SliceFirst(, EventKind = VALUE(Enum.HREventKindsPayrollAndHumanResources.Reception)) AS EmploymentRecordSliceFirst
		ON (EmploymentRecordSliceFirst.Organization = TT_Total.Organization)
			AND (EmploymentRecordSliceFirst.Employee = TT_Total.Employee)
		LEFT JOIN InformationRegister.EmploymentRecord.SliceLast(, EventKind = VALUE(Enum.HREventKindsPayrollAndHumanResources.Dismissal)) AS PersonnelHistoryHRSectionOfLastFired
		ON (PersonnelHistoryHRSectionOfLastFired.Organization = TT_Total.Organization)
			AND (PersonnelHistoryHRSectionOfLastFired.Employee = TT_Total.Employee)
WHERE
	CASE
			WHEN NOT ISNULL(PersonnelHistoryHRSectionOfLastFired.Period, DATETIME(1, 1, 1)) = DATETIME(1, 1, 1)
					AND NOT BEGINOFPERIOD(ISNULL(PersonnelHistoryHRSectionOfLastFired.Period, DATETIME(1, 1, 1)), DAY) &gt;= &amp;BeginOfPeriod
				THEN FALSE
			ELSE TRUE
		END</query>
	</dataSet>
	<calculatedField>
		<dataPath>Total</dataPath>
		<expression>"The result:"</expression>
	</calculatedField>
