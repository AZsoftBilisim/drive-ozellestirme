			<dataPath>SupplyOption</dataPath>
			<field>SupplyOption</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	ScheduleOfProductionStages2_2.Stage AS Stage,
	BEGINOFPERIOD(ScheduleOfProductionStages2_2.Begin, DAY) AS DemandDate,
	UsedMaterials.Products AS Products,
	UsedMaterials.Characteristic AS Characteristic,
	UsedMaterials.Warehouse AS Warehouse,
	UsedMaterials.SupplyOption AS SupplyOption,
	UsedMaterials.Products.UnitOfMeasure AS StorageUnit,
	UsedMaterials.Products.UnitForReports AS UnitForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN UsedMaterials.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN UsedMaterials.Products.UnitFactorForReports &lt;&gt; 0
						THEN UsedMaterials.Count / UsedMaterials.Products.UnitFactorForReports
					ELSE 0
				END
	END AS Count,
	UsedMaterials.Count * &amp;ItemWeight AS Weight,
	UsedMaterials.Count * &amp;TheVolumeOfTheItem AS VolumeM3
{SELECT
	Stage.*,
	DemandDate,
	Products.*,
	Characteristic.*,
	Warehouse.*,
	SupplyOption,
	StorageUnit.*,
	UnitForReports.*,
	Count,
	Weight,
	VolumeM3}
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
		INNER JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS UsedMaterials
		ON ScheduleOfProductionStages2_2.Stage = UsedMaterials.Ref
WHERE
	ScheduleOfProductionStages2_2.ProductionOrder = &amp;ReferenceOrder
	AND ScheduleOfProductionStages2_2.ScheduleStatus = &amp;ScheduleStatus
	AND NOT UsedMaterials.Produced
	AND NOT UsedMaterials.Canceled
{WHERE
	ScheduleOfProductionStages2_2.Stage.*,
	(BEGINOFPERIOD(ScheduleOfProductionStages2_2.Begin, DAY)) AS DemandDate,
	UsedMaterials.Products.*,
	UsedMaterials.Characteristic.*,
	UsedMaterials.Warehouse.*,
	UsedMaterials.SupplyOption,
	UsedMaterials.Products.UnitOfMeasure.* AS StorageUnit,
	UsedMaterials.Products.UnitForReports.* AS UnitForReports,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN UsedMaterials.Count
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN UsedMaterials.Products.UnitFactorForReports &lt;&gt; 0
							THEN UsedMaterials.Count / UsedMaterials.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS Count,
	(UsedMaterials.Count * &amp;ItemWeight) AS Weight,
	(UsedMaterials.Count * &amp;TheVolumeOfTheItem) AS VolumeM3}

UNION ALL

SELECT
	ScheduleOfProductionStages2_2.Stage AS Stage,
	BEGINOFPERIOD(ScheduleOfProductionStages2_2.Begin, DAY) AS DemandDate,
	UsedMaterials.Products AS Products,
	UsedMaterials.Characteristic AS Characteristic,
	UsedMaterials.Warehouse AS Warehouse,
	NULL AS SupplyOption,
	UsedMaterials.Products.UnitOfMeasure AS StorageUnit,
	UsedMaterials.Products.UnitForReports AS UnitForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN SUM(UsedMaterials.ToSupply) + SUM(UsedMaterials.Ordered)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN UsedMaterials.Products.UnitFactorForReports &lt;&gt; 0
						THEN (SUM(UsedMaterials.ToSupply) + SUM(UsedMaterials.Ordered)) / UsedMaterials.Products.UnitFactorForReports
					ELSE 0
				END
	END AS Count,
	(SUM(UsedMaterials.ToSupply - UsedMaterials.Replaced) + SUM(UsedMaterials.Ordered)) * &amp;ItemWeight AS Weight,
	(SUM(UsedMaterials.ToSupply - UsedMaterials.Replaced) + SUM(UsedMaterials.Ordered)) * &amp;TheVolumeOfTheItem AS VolumeM3
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
		INNER JOIN InformationRegister.OrderStructure AS UsedMaterials
		ON ScheduleOfProductionStages2_2.KeyLot = UsedMaterials.KeyLot
						AND ScheduleOfProductionStages2_2.Stage = UsedMaterials.Stage
WHERE
	ScheduleOfProductionStages2_2.ProductionOrder = &amp;ReferenceOrder
	AND ScheduleOfProductionStages2_2.ScheduleStatus = &amp;ScheduleStatus
{WHERE
	ScheduleOfProductionStages2_2.Stage.*,
	(BEGINOFPERIOD(ScheduleOfProductionStages2_2.Begin, DAY)) AS DemandDate,
	UsedMaterials.Products.*,
	UsedMaterials.Characteristic.*,
	UsedMaterials.Warehouse.*,
	UsedMaterials.Products.UnitOfMeasure.* AS StorageUnit,
	UsedMaterials.Products.UnitForReports.* AS UnitForReports,
	(CASE
			WHEN &amp;QuantityUnits = 0
				THEN SUM(UsedMaterials.ToSupply) + SUM(UsedMaterials.Ordered)
			WHEN &amp;QuantityUnits = 1
				THEN CASE
						WHEN UsedMaterials.Products.UnitFactorForReports &lt;&gt; 0
							THEN (SUM(UsedMaterials.ToSupply) + SUM(UsedMaterials.Ordered)) / UsedMaterials.Products.UnitFactorForReports
						ELSE 0
					END
		END) AS Count,
	((SUM(UsedMaterials.ToSupply - UsedMaterials.Replaced) + SUM(UsedMaterials.Ordered)) * &amp;ItemWeight) AS Weight,
	((SUM(UsedMaterials.ToSupply - UsedMaterials.Replaced) + SUM(UsedMaterials.Ordered)) * &amp;TheVolumeOfTheItem) AS VolumeM3}

GROUP BY
	ScheduleOfProductionStages2_2.Stage,
	BEGINOFPERIOD(ScheduleOfProductionStages2_2.Begin, DAY),
	UsedMaterials.Products,
	UsedMaterials.Characteristic,
	UsedMaterials.Warehouse</query>
	</dataSet>
