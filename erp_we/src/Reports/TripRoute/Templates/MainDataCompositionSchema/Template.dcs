			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Final delivery point</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Final delivery point</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Final delivery point</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>FinalDeliveryZoneSettlement</dataPath>
		<expression>Case
	When  RouteLineNumber &lt;&gt; 1
		And FinalDeliveryArea  = Value(Catalog.DeliveryZones.EmptyRef)
		Then DeliveryZone
	Else FinalDeliveryArea
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Final delivery area</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>منطقه نهایی تحویل</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конечная зона доставки</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Son teslimat bölgesi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Final delivery area</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Final delivery area</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Final delivery area</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>FinalRecipient</dataPath>
		<expression>Case
	When  RouteLineNumber &lt;&gt; 1
		And FinalDeliveryPoint  = Value(Catalog.DeliveryPoints.EmptyRef)
		Then PointOfRoute
	Else FinalDeliveryPoint.Owner
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Final recipient</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>گیرنده نهایی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конечный получатель</v8:content>
