				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Route point</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Route point</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Route point</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Route.Ref AS Ref,
	Route.LineNumber AS LineNumber,
	Route.Point AS Point,
	Route.DeliveryPoint AS DeliveryPoint,
	Route.DeliveryZone AS DeliveryZone,
	Route.Operation AS Operation,
	ISNULL(Content.LineNumber, 0) AS ContentLineNumber,
	ISNULL(Content.ReferenceOrder, UNDEFINED) AS ReferenceOrder,
	ISNULL(Content.Products, VALUE(Catalog.Products.EmptyRef)) AS Products,
	ISNULL(Content.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)) AS Characteristic,
	ISNULL(Content.Series, VALUE(Catalog.ItemsBatches.EmptyRef)) AS Series,
	ISNULL(Content.Count, 0) AS Count,
	ISNULL(Content.FinalDeliveryPoint, VALUE(Catalog.DeliveryPoints.EmptyRef)) AS	FinalDeliveryPoint,
	ISNULL(Content.FinalDeliveryArea, VALUE(Catalog.DeliveryZones.EmptyRef)) AS FinalDeliveryArea
{SELECT
	Ref.* AS Trip,
	LineNumber AS RouteLineNumber,
	Point.* AS PointOfRoute,
	DeliveryPoint.*,
	DeliveryZone.*,
	Operation,
	ContentLineNumber,
	ReferenceOrder.*,
	Products.*,
	Characteristic.*,
	Series.*,
	Count,
	FinalDeliveryPoint.*,
	FinalDeliveryArea
}
FROM
	Document.Trip.Route AS Route
		LEFT JOIN Document.Trip.Content AS Content
		ON Route.Ref = Content.Ref
		AND Route.ConnectionKey = Content.ConnectionKey
		AND NOT Content.Canceled
WHERE
	Route.Ref = &amp;Trip
	AND NOT Route.Canceled
{WHERE
	Point.*,
	Route.LineNumber AS RouteLineNumber,
	DeliveryPoint.*,
	DeliveryZone.*,
	Operation,
	ReferenceOrder.*,
	Products.*,
	Characteristic.*,
	Series.*,
	Count
}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>DeliveryEndPointSettlement</dataPath>
		<expression>Case
	When RouteLineNumber &lt;&gt; 1
		And FinalDeliveryPoint  = Value(Catalog.DeliveryPoints.EmptyRef)
		Then DeliveryPoint
	Else FinalDeliveryPoint
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Final delivery point</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>نقطه نهایی تحویل</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конечная точка доставки</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
