		<field xsi:type="DataSetFieldField">
			<dataPath>PointOfRoute</dataPath>
			<field>PointOfRoute</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Route point</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نقطه مسیر</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Пункт маршрута</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
