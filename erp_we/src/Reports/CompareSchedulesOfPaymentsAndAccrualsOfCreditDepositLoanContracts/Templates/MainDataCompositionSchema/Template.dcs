	<settingsVariant>
		<dcsset:name>CompareChartOptions</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Compare schedules of payments and interest charges of credit, deposit, loan contracts</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>مقایسه برنامه‌های پرداخت و هزینه‌های بهره قراردادهای اعتبار، سپرده و وام</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Comparazione dei grafici di pagamenti e accrediti dei contratti di crediti, depositi, prestiti</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Porównanie wykresów płatności i naliczeń kontraktów kredytów, lokat, pożyczek</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сравнение графиков оплат и начислений договоров кредитов, депозитов, займов</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kredi, mevduat ve borç sözleşmeleri için ödeme planı ve tahakkuk planlarının karşılaştırılması</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>So sánh lịch biểu thanh toán và tính toán hợp đồng cho vay, tiết kiệm</v8:content>
			</v8:item>
		</dcsset:presentation>
