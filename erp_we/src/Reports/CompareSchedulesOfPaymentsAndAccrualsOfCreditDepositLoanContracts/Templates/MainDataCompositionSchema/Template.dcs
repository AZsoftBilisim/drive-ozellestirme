			<dataSource>DataSource1</dataSource>
			<query>SELECT
	ScheduleOfTrancheForLoansAndDeposits.Period,
	ScheduleOfTrancheForLoansAndDeposits.ScheduleOption.Owner AS Contract,
	ScheduleOfTrancheForLoansAndDeposits.ScheduleOption AS ScheduleOption,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Tranches) AS ScheduleType,
	YEAR(ScheduleOfTrancheForLoansAndDeposits.Period) AS YearNumber,
	BEGINOFPERIOD(ScheduleOfTrancheForLoansAndDeposits.Period, MONTH) AS MonthName,
	ScheduleOfTrancheForLoansAndDeposits.Sum AS TrancheAmount1,
	0 AS AmountOfDebt1,
	0 AS PayPercentage1,
	0 AS PaymentCommission1,
	0 AS AccrualPercentage1,
	0 AS AccrualFee1,
	0 AS TrancheAmount2,
	0 AS AmountOfDebt2,
	0 AS PayPercentage2,
	0 AS PaymentCommission2,
	0 AS AccrualPercentage2,
	0 AS AccrualCommission2
FROM
	InformationRegister.ScheduleOfTrancheForLoansAndDeposits AS ScheduleOfTrancheForLoansAndDeposits
WHERE
	ScheduleOfTrancheForLoansAndDeposits.ScheduleOption = &amp;ScheduleOption1

UNION ALL

SELECT
	ScheduleOfPaymentForLoansAndDeposits.Period,
	ScheduleOfPaymentForLoansAndDeposits.ScheduleOption.Owner,
	ScheduleOfPaymentForLoansAndDeposits.ScheduleOption,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Payments),
	YEAR(ScheduleOfPaymentForLoansAndDeposits.Period),
	BEGINOFPERIOD(ScheduleOfPaymentForLoansAndDeposits.Period, MONTH),
	0,
	ScheduleOfPaymentForLoansAndDeposits.Sum,
	ScheduleOfPaymentForLoansAndDeposits.Interests,
	ScheduleOfPaymentForLoansAndDeposits.Fee,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0
FROM
	InformationRegister.ScheduleOfPaymentForLoansAndDeposits AS ScheduleOfPaymentForLoansAndDeposits
WHERE
	ScheduleOfPaymentForLoansAndDeposits.ScheduleOption = &amp;ScheduleOption1

UNION ALL

