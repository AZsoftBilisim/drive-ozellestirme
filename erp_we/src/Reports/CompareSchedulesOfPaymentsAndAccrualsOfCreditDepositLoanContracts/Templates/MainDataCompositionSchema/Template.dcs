	ScheduleOfAccrualsForLoansAndDeposits.ScheduleOption.Owner,
	ScheduleOfAccrualsForLoansAndDeposits.ScheduleOption,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Accruals),
	YEAR(ScheduleOfAccrualsForLoansAndDeposits.Period),
	BEGINOFPERIOD(ScheduleOfAccrualsForLoansAndDeposits.Period, MONTH),
	0,
	0,
	0,
	0,
	ScheduleOfAccrualsForLoansAndDeposits.Interests,
	ScheduleOfAccrualsForLoansAndDeposits.Fee,
	0,
	0,
	0,
	0,
	0,
	0
FROM
	InformationRegister.ScheduleOfAccrualsForLoansAndDeposits AS ScheduleOfAccrualsForLoansAndDeposits
WHERE
	ScheduleOfAccrualsForLoansAndDeposits.ScheduleOption = &amp;ScheduleOption1</query>
