	<calculatedField>
		<dataPath>ItemizedVariances1</dataPath>
		<expression>Case When ExpenseType = "Itemized" Then Cost - CostPlan Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
