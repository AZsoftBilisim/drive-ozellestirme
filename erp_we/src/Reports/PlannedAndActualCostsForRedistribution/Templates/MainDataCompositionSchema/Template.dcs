						<dcsset:item xsi:type="dcsset:SelectedItemField">
							<dcsset:field>PKf</dcsset:field>
							<dcsset:lwsTitle>
								<v8:item>
									<v8:lang>en</v8:lang>
									<v8:content>PKf = PK / PKP * FKP</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>fa</v8:lang>
									<v8:content>PKf = PK / PKP * FKP</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>it</v8:lang>
									<v8:content>Quantità pianificata effettiva (quanti materiali dovrebbero essere consumati per ottenere una certa quantità di prodotto) = Quantità pianificata / Quantità pianificata di prodotto * Quantità effettiva di prodotto</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>pl</v8:lang>
									<v8:content>Planowana ilość materiału obliczona wg faktycznej ilości produkcji = Ilość planowana / Planowana ilość produkcji * Faktyczna ilość produkcji</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>ПКф = ПК / ПКП * ФКП</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>tr</v8:lang>
									<v8:content>PKf = PK / PKP * FKP</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>vi</v8:lang>
									<v8:content>PKF = PK / PKP * FKP</v8:content>
								</v8:item>
							</dcsset:lwsTitle>
						</dcsset:item>
