	<totalField>
		<dataPath>Cost</dataPath>
		<expression>Sum(Cost)</expression>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
		<group>Cost_</group>
	</totalField>
	<totalField>
		<dataPath>CostPlan</dataPath>
		<expression>Sum(CostPlan)</expression>
	</totalField>
	<totalField>
		<dataPath>CountPlan</dataPath>
		<expression>Sum(CountPlan)</expression>
		<group>Cost_</group>
	</totalField>
	<totalField>
		<dataPath>PricePlan</dataPath>
		<expression>Avg(PricePlan)</expression>
		<group>Cost_</group>
	</totalField>
	<totalField>
		<dataPath>PriceActual</dataPath>
		<expression>Case When Sum(Count) = 0 Then 0 Else Sum(Cost) / Sum(Count) End</expression>
		<group>Cost_</group>
	</totalField>
	<totalField>
		<dataPath>GPC</dataPath>
		<expression>Round(
	Round(Case When ThisIsASemiFinishedProduct
			Then 0
			Else (Sum(Count) - Sum(CountPlan))
				*
				Case When Sum(CountPlan) = 0 
					Then Avg(PricePlan)
					Else Sum(CostPlan) / Sum(CountPlan)
				End 
		End
	, 2)
	+ Round(
		Case When ThisIsASemiFinishedProduct Or Avg(PricePlan) = 0
			Then 0
			Else
			(
				Case When Sum(Count) = 0
					Then Avg(PriceActual)
					Else Sum(Cost) / Sum(Count)
				End
				-
				Case When Sum(CountPlan) = 0
					Then Avg(PricePlan)
					Else Sum(CostPlan) / Sum(CountPlan)
				End
			) * Sum(Count)
		End
	, 2)
	+ Sum(ItemizedVariances1)
, 2)</expression>
	</totalField>
	<totalField>
		<dataPath>GPCk</dataPath>
		<expression>Round(
	Case When ThisIsASemiFinishedProduct
		Then 0
		Else (Sum(Count) - Sum(CountPlan))
			*
			Case When Sum(CountPlan) = 0
				Then Avg(PricePlan)
				Else Sum(CostPlan) / Sum(CountPlan)
			End 
	End
, 2)</expression>
	</totalField>
	<totalField>
		<dataPath>GPCc</dataPath>
		<expression>Round(
	Case
		When ThisIsASemiFinishedProduct Or Avg(PricePlan) = 0
			Then 0
		Else
			(
				Case
					When Sum(Count) = 0 Then Avg(PriceActual)
					Else Sum(Cost) / Sum(Count)
				End
				-
				Case
					When Sum(CountPlan) = 0 Then Avg(PricePlan)
					Else Sum(CostPlan) / Sum(CountPlan)
				End
			) * Sum(Count)
	End
,2)
</expression>
	</totalField>
	<totalField>
		<dataPath>PKf</dataPath>
		<expression>Round(Case When Sum(QuantityReleasePlan) = 0 Then 0 Else Sum(CountPlan) / Sum(QuantityReleasePlan) * Sum(QuantityRelease) End, 3)</expression>
	</totalField>
	<totalField>
		<dataPath>CIC</dataPath>
		<expression>Round(
	Round(
		(Sum(Count)
			- Round(Case When Sum(QuantityReleasePlan) = 0 Then 0 Else Sum(CountPlan) / Sum(QuantityReleasePlan) * Sum(QuantityRelease) End, 3)
		)
		*
		Case When ThisIsASemiFinishedProduct Or Sum(CountPlan) = 0
			Then Avg(PricePlan)
			Else Sum(CostPlan) / Sum(CountPlan) 
		End
	, 2)
	+ Round(
			Case When ThisIsASemiFinishedProduct Or Avg(PricePlan) = 0
				Then 0
				Else
					(
						Case When Sum(Count) = 0 Then Avg(PriceActual) Else Sum(Cost) / Sum(Count) End
						- 
						Case When Sum(CountPlan) = 0 Then Avg(PricePlan) Else Sum(CostPlan) / Sum(CountPlan) End
					)
					* Sum(Count)
			End
		,2)
	+
	Sum(ItemizedVariances1)
, 2)</expression>
	</totalField>
	<totalField>
		<dataPath>CICk</dataPath>
		<expression>Round(
	(
		Sum(Count)
		- Round(
			Case When Sum(QuantityReleasePlan) = 0
				Then 0
				Else Sum(CountPlan) / Sum(QuantityReleasePlan) * Sum(QuantityRelease)
			End
		, 3)
	)
	*
	Case When ThisIsASemiFinishedProduct Or Sum(CountPlan) = 0
		Then Avg(PricePlan)
		Else Sum(CostPlan) / Sum(CountPlan)
	End
, 2)</expression>
	</totalField>
	<totalField>
		<dataPath>CICc</dataPath>
		<expression>Round(
	Case When ThisIsASemiFinishedProduct Or Avg(PricePlan) = 0
		Then 0
	Else
		(
			Case When Sum(Count) = 0
				Then Avg(PriceActual)
				Else Sum(Cost) / Sum(Count)
				End
			-
			Case When Sum(CountPlan) = 0
				Then Avg(PricePlan)
				Else Sum(CostPlan) / Sum(CountPlan)
			End
		) * Sum(Count)
	End,
2)</expression>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(QuantityRelease)</expression>
	</totalField>
	<totalField>
		<dataPath>CountPlan</dataPath>
		<expression>Sum(QuantityReleasePlan)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityReleasePlan</dataPath>
		<expression>StringFunctionsClientServer.SubstituteParametersToString(Max(PlanPresentation), Format(Sum(IsNull(QuantityReleasePlan, 0)), "NFD=3"))</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityRelease</dataPath>
		<expression>StringFunctionsClientServer.SubstituteParametersToString(Max(FactPresentation), Format(Sum(IsNull(QuantityRelease, 0)), "NFD=3"))</expression>
	</totalField>
	<totalField>
		<dataPath>ItemizedVariances</dataPath>
		<expression>Sum(ItemizedVariances)</expression>
	</totalField>
	<totalField>
		<dataPath>ItemizedVariances1</dataPath>
		<expression>Sum(ItemizedVariances1)</expression>
	</totalField>
	<totalField>
		<dataPath>CostOffBalanceSheetPlan</dataPath>
		<expression>Sum(CostOffBalanceSheetPlan)</expression>
	</totalField>
	<totalField>
		<dataPath>CostOffBalanceSheetFact</dataPath>
		<expression>Sum(CostOffBalanceSheetFact)</expression>
	</totalField>
