		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	DATETIME(1, 1, 1) AS Period,
	DATETIME(1, 1, 1) AS CalculationPeriod,
	VendorRebatesConditions.TermDocument AS ConditionOfRebateBonusIs,
	VALUE(Enum.TargetSalesIndicatorsOfRebatesByGoods.EmptyRef) AS GoodsIndicator,
	VALUE(Enum.ARAPAccountingDrilldownsOfRebatesParticipants.EmptyRef) AS PartyCountDetails,
	VALUE(Enum.RebatesFrequencies.EmptyRef) AS ConditionFrequency,
	VendorRebatesVendors.Counterparty AS CounterpartySupplier,
	VendorRebatesVendors.Partner AS PartnerVendor,
	VendorRebatesVendors.Terms AS SupplierTerms,
	VendorRebatesVendors.Contract AS SupplierAgreement,
	VALUE(Document.CustomerInvoice.EmptyRef) AS DocumentRecorder,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	VendorRebatesConditions.Organization AS Organization,
	VendorRebatesCounterparties.Counterparty AS CounterpartyCustomer,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS UnitOfMeasure,
	FALSE AS ItemVariantsAreUsed,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS CharacteristicsOfSalesPurchases,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	UNDEFINED AS PropertyValue,
	0 AS RangeNumber,
	"" AS PresentationOfRangeUnit,
	0 AS RangeFrom,
	0 AS RangeBy,
	FALSE AS RestrictAccrualOverPlan,
	FALSE AS PlanIsFulfilled,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	0 AS BasePrice,
	0 AS AmountOfTurnoverWithVAT,
	0 AS AmountOfTurnoverExcludingVAT,
	0 AS AmountInBasePrices,
	0 AS CountTurnover,
	0 AS CountBalance,
	0 AS AmountBonus,
	0 AS SumPlan,
	0 AS CountPlan,
	0 AS BonusPercent,
	0 AS CalculationBase,
	0 AS NumberOfPackages_,
	0 AS BonusAmountPerUnit
{SELECT
	ConditionOfRebateBonusIs.*,
	Period,
	CalculationPeriod,
	GoodsIndicator,
	PartyCountDetails,
	ConditionFrequency,
	RestrictAccrualOverPlan,
	DocumentRecorder.*,
	Warehouse.*,
	Organization.*,
	CounterpartySupplier.*,
	PartnerVendor.*,
	CounterpartyCustomer.*,
	Products.*,
	UnitOfMeasure.*,
	ItemVariantsAreUsed,
	CharacteristicsOfSalesPurchases.*,
	Characteristic.*,
	PropertyValue,
	RangeNumber,
	PresentationOfRangeUnit,
	RangeFrom,
	RangeBy,
	PlanIsFulfilled,
	BonusPercent,
	CountTurnover,
	CountBalance,
	Currency,
	BasePrice,
	AmountOfTurnoverWithVAT,
	AmountOfTurnoverExcludingVAT,
	AmountInBasePrices,
	AmountBonus,
	SumPlan,
	CountPlan,
	CalculationBase,
	NumberOfPackages_,
	BonusAmountPerUnit,
	SupplierTerms.*,
	SupplierAgreement.*}
FROM
	InformationRegister.VendorRebatesConditions AS VendorRebatesConditions
		LEFT JOIN InformationRegister.VendorRebatesCounterparties AS VendorRebatesCounterparties
		ON VendorRebatesConditions.TermDocument = VendorRebatesCounterparties.TermDocument
		LEFT JOIN InformationRegister.VendorRebatesVendors AS VendorRebatesVendors
		ON VendorRebatesConditions.TermDocument = VendorRebatesVendors.TermDocument
WHERE
	VendorRebatesConditions.TermDocument = &amp;DocumentTermsOfRetroBonuses
{WHERE
	(VALUE(Document.CustomerInvoice.EmptyRef)) AS DocumentRecorder,
	(VALUE(Catalog.Warehouses.EmptyRef)).* AS Warehouse,
	VendorRebatesConditions.Organization.* AS Organization,
	(VALUE(Catalog.Currencies.EmptyRef)).* AS Currency,
	VendorRebatesVendors.Counterparty.* AS CounterpartySupplier,
	VendorRebatesVendors.Partner.* AS PartnerVendor,
	VendorRebatesCounterparties.Counterparty.* AS CounterpartyCustomer,
	(DATETIME(1, 1, 1)) AS CalculationPeriod,
	(VALUE(Catalog.Products.EmptyRef)).* AS Products,
	(VALUE(Catalog.ItemsCharacteristics.EmptyRef)).* AS Characteristic,
	UNDEFINED AS PropertyValue,
	VendorRebatesVendors.Contract.* AS SupplierAgreement,
	VendorRebatesVendors.Terms.* AS SupplierTerms}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>CountTurnover</dataPath>
		<expression>Sum(CountTurnover)</expression>
		<group>PropertyValue</group>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>AmountBonus</dataPath>
		<expression>Case
	When Count(Distinct Currency) &gt; 1
		Then 0
    Else Sum(AmountBonus)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountInBasePrices</dataPath>
		<expression>Case
	When Count(Distinct Currency) &gt; 1
		Then 0
    Else Sum(AmountInBasePrices)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountOfTurnoverExcludingVAT</dataPath>
		<expression>Case
    When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(AmountOfTurnoverExcludingVAT)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountOfTurnoverWithVAT</dataPath>
		<expression>Case
    When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(AmountOfTurnoverWithVAT)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CalculationBase</dataPath>
		<expression>Case
    When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(CalculationBase)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountBalance</dataPath>
		<expression>Sum(CountBalance)</expression>
		<group>PropertyValue</group>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>AmountInBasePrices</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>AmountOfTurnoverExcludingVAT</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>AmountOfTurnoverWithVAT</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>CountTurnover</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>ItemVariantsAreUsed</dataPath>
		<expression>Max(ItemVariantsAreUsed)</expression>
		<group>Products</group>
	</totalField>
	<parameter>
		<name>DocumentTermsOfRetroBonuses</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Rebate conditions document</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>سند شرایط تخفیف حجمی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Документ условий ретро бонусов</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Retro-bonus koşullar belgesi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chứng từ điều kiện thưởng lũy kế</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Rebate conditions document</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Rebate conditions document</v8:content>
			</v8:item>
