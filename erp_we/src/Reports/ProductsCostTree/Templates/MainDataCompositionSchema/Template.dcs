		<dataSource>DataSource1</dataSource>
		<query>//////////////////////////////
// COMMENTS ARE USED //
// THIS IS THE TEMPLATE				//
//////////////////////////////

SELECT TOP 1
	&amp;Cost_Data AS Cost_Data,
	&amp;StartDate AS StartDate,
	&amp;EndDate AS EndDate,
	&amp;UnitOfMeasure AS UnitOfMeasure,
	&amp;DecryptionOfDocumentRegisteredRecords AS DecryptionOfDocumentRegisteredRecords,
	
	InventoryCost.Period AS OriginalBatchDate,
	InventoryCost.Organization AS Organization,
	InventoryCost.Organization.LocalAccountingCurrency AS Currency,
	InventoryCost.Lot AS ProductsBatch,
	InventoryCost.LotVendorAttributes AS ProductBatchAccountingDimension,
	InventoryCost.ItemsLocationAttributes AS ProductsAccountingDimension,
	InventoryCost.ItemsLocationAttributes.Products AS ManufacturedProduct,
	InventoryCost.ItemsLocationAttributes.Products.Description AS ManufacturedProductPresentation,
	InventoryCost.ItemsLocationAttributes.Characteristic AS ItemVariant,
	InventoryCost.ItemsLocationAttributes.Characteristic.Description AS ItemVariantPresentation,
	InventoryCost.ItemsLocationAttributes.Series AS ProductionSeries_,
	InventoryCost.ItemsLocationAttributes.Series.Description AS ProductionSeries_Presentation,
	InventoryCost.ItemsLocationAttributes.Purpose AS AssignmentOfProducts,
	InventoryCost.ItemsLocationAttributes.Purpose.Description AS AssignmentOfProductsPresentation,
	InventoryCost.ItemsLocationAttributes.Products.UnitOfMeasure AS UnitOfMeasurementProducts,
	CASE
		WHEN TRUE
			THEN InventoryCost.ItemsLocationAttributes.WarehouseArea.Department
		ELSE InventoryCost.ItemsLocationAttributes.StorageLocation
	END AS Department,
	&amp;TypeOfCostsManufacturedProducts AS ExpenseType,
	FALSE AS ExplosionIsRequired,   
	
	InventoryCost.Count AS Numerator,
	InventoryCost.Count AS Denominator,
	InventoryCost.Count AS NumberOfProducts_1, 
	
// The cost according to the parameter "Data of the cost"	
	InventoryCost.Cost						AS Material_,
	InventoryCost.LaborCosts					AS LaborCosts,
	InventoryCost.ItemizedFixedCostsIncludingVAT		AS ItemizedFixed,
	InventoryCost.ItemizedVariableCostsIncludingVAT		AS ItemizedVariable,
	InventoryCost.AddExpensesForGoods						AS AddExpensesForGoods,
	InventoryCost.OffBalanceCost			AS AmountOffBalanceSheetProducts,
	InventoryCost.Cost						AS TotalOutput,
	InventoryCost.CostOfPersonalIncomeTax					AS AIT, 

// Costs without VAT
	InventoryCost.CostExcludingVAT				AS TangibleExcludingVAT,
	InventoryCost.ItemizedFixedCostsExcludingVAT	AS ItemizedFixedCostsExcludingVAT,
	InventoryCost.ItemizedVariableCostsExcludingVAT	AS ItemizedVariableCostsExcludingVAT,
	InventoryCost.AdditionalExpensesExcludingVAT				AS AdditionalExpensesExcludingVAT,     

// Regl Costs	
	InventoryCost.LocalCost					AS TangibleCompl,
	InventoryCost.LaborCostsLocal				AS LaborCostsLocal,
	InventoryCost.ItemizedFixedCostsCompl		AS ItemizedFixedCostsCompl,
	InventoryCost.ItemizedVariableCostsCompl		AS ItemizedVariableCostsCompl,
	InventoryCost.AddExpensesLocal					AS AddExpensesLocal,
	InventoryCost.OffBalanceCostLocal		AS OffBalanceCostLocal,
	
// Costs with VAT
	InventoryCost.Cost						AS TangibleIncludingVAT,
	InventoryCost.LaborCosts					AS LaborCostsIncludingVAT,
	InventoryCost.ItemizedFixedCostsIncludingVAT		AS ItemizedFixedCostsIncludingVAT,
	InventoryCost.ItemizedVariableCostsIncludingVAT		AS ItemizedVariableCostsIncludingVAT,
	InventoryCost.AddExpensesForGoods						AS AdditionalExpensesIncludingVAT,

// The Cost of Upr
	InventoryCost.CostMan					AS MaterialMan,
	InventoryCost.LaborCostsMan				AS LaborCostsMan,
	InventoryCost.ItemizedFixedCostsManag		AS ItemizedFixedCostsManag,
	InventoryCost.ItemizedVariableCostsManag		AS ItemizedVariableCostsManag,
	InventoryCost.AddExpensesMan					AS AddExpensesMan,
	InventoryCost.OffBalanceCost			AS CostOffBalanceSheetMan,
	
// Tax accounting	
	InventoryCost.LocalCost					AS TaxAccounting,
	InventoryCost.PermanentDifference				AS PermanentDifference,
	InventoryCost.CostTD				AS CostTD    
	
INTO IssuedProducts

FROM
	AccumulationRegister.InventoryCost AS InventoryCost
WHERE
	InventoryCost.Recorder = &amp;Recorders
	AND &amp;ConnectionConditions_NodeSelectionTable

;   

// Added for the possibility of programmatic work with the layout Template.
// Deleted from the resulting query.
SELECT
	IssuedProducts.OriginalBatchDate	AS OriginalBatchDate,
	
	IssuedProducts.Organization						AS Organization,
	IssuedProducts.Currency							AS Currency,
	IssuedProducts.ProductsBatch					AS ProductsBatch,
	IssuedProducts.ProductBatchAccountingDimension	AS ProductBatchAccountingDimension,
	IssuedProducts.ProductsAccountingDimension			AS ProductsAccountingDimension,
	IssuedProducts.ManufacturedProduct						AS ManufacturedProduct,
	IssuedProducts.ManufacturedProductPresentation			AS ManufacturedProductPresentation,
	IssuedProducts.ItemVariant			AS ItemVariant,
	IssuedProducts.ItemVariantPresentation AS ItemVariantPresentation,
	IssuedProducts.ProductionSeries_					AS ProductionSeries_,
	IssuedProducts.ProductionSeries_Presentation		AS ProductionSeries_Presentation,
	IssuedProducts.AssignmentOfProducts				AS AssignmentOfProducts,
	IssuedProducts.AssignmentOfProductsPresentation AS AssignmentOfProductsPresentation,
	IssuedProducts.UnitOfMeasurementProducts		AS UnitOfMeasurementProducts,
	IssuedProducts.Department					AS Department,
	IssuedProducts.ExpenseType						AS ExpenseType,
	IssuedProducts.ExplosionIsRequired			AS ExplosionIsRequired,
	IssuedProducts.Numerator						AS Numerator,
	IssuedProducts.Denominator						AS Denominator,
	IssuedProducts.NumberOfProducts_1				AS NumberOfProducts_1,

// The cost according to the parameter "Data of the cost"
	IssuedProducts.Material_					AS Material_,
	IssuedProducts.LaborCosts					AS LaborCosts,
	IssuedProducts.ItemizedFixed			AS ItemizedFixed,
	IssuedProducts.ItemizedVariable			AS ItemizedVariable,
	IssuedProducts.AddExpensesForGoods						AS AddExpensesForGoods,
	IssuedProducts.AmountOffBalanceSheetProducts		AS AmountOffBalanceSheetProducts,
	IssuedProducts.TotalOutput					AS TotalOutput,
	IssuedProducts.AIT								AS AIT,

// Costs with VAT
	IssuedProducts.TangibleIncludingVAT				AS TangibleIncludingVAT,
	IssuedProducts.LaborCostsIncludingVAT				AS LaborCostsIncludingVAT,
	IssuedProducts.ItemizedFixedCostsIncludingVAT		AS ItemizedFixedCostsIncludingVAT,
	IssuedProducts.ItemizedVariableCostsIncludingVAT		AS ItemizedVariableCostsIncludingVAT,
	IssuedProducts.AdditionalExpensesIncludingVAT					AS AdditionalExpensesIncludingVAT,

// Costs without VAT
	IssuedProducts.TangibleExcludingVAT				AS TangibleExcludingVAT,
	IssuedProducts.ItemizedFixedCostsExcludingVAT		AS ItemizedFixedCostsExcludingVAT,
	IssuedProducts.ItemizedVariableCostsExcludingVAT		AS ItemizedVariableCostsExcludingVAT,
	IssuedProducts.AdditionalExpensesExcludingVAT				AS AdditionalExpensesExcludingVAT,

// The Cost of Upr
	IssuedProducts.MaterialMan					AS MaterialMan,
	IssuedProducts.LaborCostsMan					AS LaborCostsMan,
	IssuedProducts.ItemizedFixedCostsManag		AS ItemizedFixedCostsManag,
	IssuedProducts.ItemizedVariableCostsManag		AS ItemizedVariableCostsManag,
	IssuedProducts.AddExpensesMan					AS AddExpensesMan,
	IssuedProducts.CostOffBalanceSheetMan		AS CostOffBalanceSheetMan,
	
// Regl Costs
	IssuedProducts.TangibleCompl				AS TangibleCompl,
	IssuedProducts.LaborCostsLocal				AS LaborCostsLocal,
	IssuedProducts.ItemizedFixedCostsCompl		AS ItemizedFixedCostsCompl,
	IssuedProducts.ItemizedVariableCostsCompl		AS ItemizedVariableCostsCompl,
	IssuedProducts.AddExpensesLocal					AS AddExpensesLocal,
	IssuedProducts.OffBalanceCostLocal		AS OffBalanceCostLocal,
	
// Tax accounting
	IssuedProducts.TaxAccounting					AS TaxAccounting,
	IssuedProducts.PermanentDifference				AS PermanentDifference,
	IssuedProducts.CostTD				AS CostTD
	
FROM
	IssuedProducts AS IssuedProducts
</query>
	</dataSet>
