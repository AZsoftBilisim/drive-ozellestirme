				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tiền tệ cơ sở</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO ManSExchangeRate
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;DateOfCourse, Currency IN
		(SELECT
			Constants.ManagementAccountingCurrency
		FROM
			Constants AS Constants)
	AND BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	AssignmentToSalesRepresentativeGoods.Ref.SalesRepresentative AS SalesRepresentative,
	AssignmentToSalesRepresentativeGoods.Ref.Partner AS Partner,
	SUM(AssignmentToSalesRepresentativeGoods.CountPlan) AS CountPlan,
	SUM(AssignmentToSalesRepresentativeGoods.Count) AS Count,
	AssignmentToSalesRepresentativeGoods.Ref AS Job,
	AssignmentToSalesRepresentativeGoods.Products AS Products,
	AssignmentToSalesRepresentativeGoods.Products.UnitOfMeasure AS StorageUnit,
	AssignmentToSalesRepresentativeGoods.Products.UnitForReports AS UnitForReports,
	AssignmentToSalesRepresentativeGoods.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume
FROM
	Document.JobForSalesRepresentative.Goods AS AssignmentToSalesRepresentativeGoods
		LEFT JOIN ManSExchangeRate AS ManSExchangeRate
		ON (TRUE)
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;DateOfCourse, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
		ON AssignmentToSalesRepresentativeGoods.Ref.Currency = CurrencyRatesCut.Currency
		LEFT JOIN Document.JobForSalesRepresentative AS JobForSalesRepresentative
		ON AssignmentToSalesRepresentativeGoods.Ref = JobForSalesRepresentative.Ref
WHERE
	NOT JobForSalesRepresentative.DeletionMark
	AND JobForSalesRepresentative.Status IN (VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing),
		VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_),
		VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_))
{WHERE
	(AssignmentToSalesRepresentativeGoods.Ref.PlannedVisitDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	OR AssignmentToSalesRepresentativeGoods.Ref.ActualVisitDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod),
	((AssignmentToSalesRepresentativeGoods.Products, AssignmentToSalesRepresentativeGoods.Characteristic) IN
		(SELECT
			SelectionByProductSegment.Products,
			SelectionByProductSegment.Characteristic
		FROM
			SelectionByProductSegment
		WHERE
			SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
GROUP BY
	AssignmentToSalesRepresentativeGoods.Ref.SalesRepresentative,
	AssignmentToSalesRepresentativeGoods.Ref.Partner,
	AssignmentToSalesRepresentativeGoods.Ref,
	AssignmentToSalesRepresentativeGoods.Products,
	AssignmentToSalesRepresentativeGoods.Products.UnitOfMeasure,
	AssignmentToSalesRepresentativeGoods.Products.UnitForReports,
	AssignmentToSalesRepresentativeGoods.Products.UnitFactorForReports</query>
	</dataSet>
	<calculatedField>
		<dataPath>DifferenceInQuantity</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Count
	When &amp;QuantityUnits = 1 Then
		Count / UnitFactorForReports
End - Case
	When &amp;QuantityUnits = 0 Then
		CountPlan
	When &amp;QuantityUnits = 1 Then
		CountPlan / UnitFactorForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
