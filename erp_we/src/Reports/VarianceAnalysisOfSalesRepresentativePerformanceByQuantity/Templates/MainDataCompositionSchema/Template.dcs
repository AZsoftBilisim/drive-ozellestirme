	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Count)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountPlan</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountPlan)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DifferenceInQuantity</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(DifferenceInQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityWeight</dataPath>
		<expression>Sum(QuantityWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityVolume</dataPath>
		<expression>Sum(QuantityVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityPlanWeight</dataPath>
		<expression>Sum(QuantityPlanWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityPlanVolume</dataPath>
		<expression>Sum(QuantityPlanVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>DifferenceInQuantityWeight</dataPath>
		<expression>Sum(DifferenceInQuantityWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>DifferenceInQuantityIsVolume</dataPath>
		<expression>Sum(DifferenceInQuantityIsVolume)</expression>
	</totalField>
