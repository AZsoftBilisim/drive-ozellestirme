						<dcscom:periodType>Additional</dcscom:periodType>
					</role>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>HalfYearPeriod</dataPath>
					<field>HalfYearPeriod</field>
					<role>
						<dcscom:periodNumber>7</dcscom:periodNumber>
						<dcscom:periodType>Additional</dcscom:periodType>
					</role>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>SecondPeriod</dataPath>
					<field>SecondPeriod</field>
					<role>
						<dcscom:periodNumber>1</dcscom:periodNumber>
						<dcscom:periodType>Main</dcscom:periodType>
					</role>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>ARAPDocument</dataPath>
					<field>ARAPDocument</field>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>Recorder</dataPath>
					<field>Recorder</field>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>PartnersSegment</dataPath>
					<field>PartnersSegment</field>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>PaymentType_</dataPath>
					<field>PaymentType_</field>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>LineOfBusiness</dataPath>
					<field>LineOfBusiness</field>
					<title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Line of business</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>خط کسب‌وکار</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Settore di attività</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Rodzaj działalności</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Направление деятельности</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>İş kolu</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Lĩnh vực hoạt động</v8:content>
						</v8:item>
					</title>
				</field>
				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	0 AS PaymentType_,
	CustomersARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	RegisterAccountingAnalyticsForPartners.Contract,
	CASE WHEN NOT CustomersARAPAccounting.SalesOrder.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE CustomersARAPAccounting.SalesOrder.LineOfBusiness
	END AS LineOfBusiness,
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		&amp;ManagementAccountingCurrency
	ELSE
		RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS Currency,
	CustomersARAPAccounting.SalesOrder AS OrderDocument,
	CustomersARAPAccounting.SalesOrder.FinancialAccountingGroup AS FinancialAccountingGroup,
	CASE
		WHEN CustomersARAPAccounting.Recorder = UNDEFINED
			THEN NULL
		ELSE CustomersARAPAccounting.Recorder
	END AS Recorder,
	CustomersARAPAccounting.SecondPeriod AS SecondPeriod,
	CustomersARAPAccounting.DayPeriod AS DayPeriod,
	CustomersARAPAccounting.WeekPeriod AS WeekPeriod,
	CustomersARAPAccounting.TenDaysPeriod AS TenDaysPeriod,
	CustomersARAPAccounting.MonthPeriod AS MonthPeriod,
	CustomersARAPAccounting.QuarterPeriod AS QuarterPeriod,
	CustomersARAPAccounting.HalfYearPeriod AS HalfYearPeriod,
	CustomersARAPAccounting.YearPeriod AS YearPeriod,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CASE
					WHEN CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance &gt; 0
						THEN CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance
					ELSE 0
				END
		ELSE CASE
				WHEN CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance &gt; 0
					THEN CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance
				ELSE 0
			END
	END AS PartnerDebt_OpeningBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CASE
					WHEN CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance &lt; 0
						THEN -(CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance)
					ELSE 0
				END
		ELSE CASE
				WHEN CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance &lt; 0
					THEN -(CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance)
				ELSE 0
			END
	END AS AccountsPayableOfCompanyOpeningBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CustomersARAPAccounting.ARAPManOpeningBalance + CustomersARAPAccounting.PrepaymentManOpeningBalance
		ELSE CustomersARAPAccounting.DebtLocalOpeningBalance + CustomersARAPAccounting.PrepaymentLocalOpeningBalance
	END AS DebtOpeningBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CustomersARAPAccounting.ARAPManReceipt + CustomersARAPAccounting.PrepaymentManReceipt
		ELSE CustomersARAPAccounting.DebtLocalReceipt + CustomersARAPAccounting.PrepaymentLocalReceipt
	END AS DebtIncrease_,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CustomersARAPAccounting.ARAPManExpense + CustomersARAPAccounting.PrepaymentManExpense
		ELSE CustomersARAPAccounting.DebtLocalExpense + CustomersARAPAccounting.PrepaymentLocalExpense
	END AS DebtReduction,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance
		ELSE CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance
	END AS DebtClosingBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CASE
					WHEN CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance &gt; 0
						THEN CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance
					ELSE 0
				END
		ELSE CASE
				WHEN CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance &gt; 0
					THEN CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance
				ELSE 0
			END
	END AS PartnerDebt_ClosingBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CASE
					WHEN CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance &lt; 0
						THEN -(CustomersARAPAccounting.ARAPManClosingBalance + CustomersARAPAccounting.PrepaymentManClosingBalance)
					ELSE 0
				END
		ELSE CASE
				WHEN CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance &lt; 0
					THEN -(CustomersARAPAccounting.DebtLocalClosingBalance + CustomersARAPAccounting.PrepaymentLocalClosingBalance)
				ELSE 0
			END
	END AS AccountsPayableOfCompanyClosingBalance
FROM
	AccumulationRegister.CustomersARAPAccountingByDocuments.BalanceAndTurnovers(, , Auto, , ) AS CustomersARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData IN (2, 3)
{WHERE
	(RegisterAccountingAnalyticsForPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
			</item>
		</item>
