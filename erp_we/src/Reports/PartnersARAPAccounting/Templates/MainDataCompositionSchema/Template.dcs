				<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	1 AS PaymentType_,
	VendorsARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	RegisterAccountingAnalyticsForPartners.Contract,  
	CASE WHEN NOT VendorsARAPAccounting.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	VendorsARAPAccounting.Currency AS Currency,
	VendorsARAPAccounting.ARAPObject AS OrderDocument,
	VendorsARAPAccounting.ARAPObject.FinancialAccountingGroup AS FinancialAccountingGroup,
	CASE
		WHEN VendorsARAPAccounting.Recorder = UNDEFINED
			THEN NULL
		ELSE VendorsARAPAccounting.Recorder
	END AS Recorder,
	VendorsARAPAccounting.SecondPeriod AS SecondPeriod,
	VendorsARAPAccounting.DayPeriod AS DayPeriod,
	VendorsARAPAccounting.WeekPeriod AS WeekPeriod,
	VendorsARAPAccounting.TenDaysPeriod AS TenDaysPeriod,
	VendorsARAPAccounting.MonthPeriod AS MonthPeriod,
	VendorsARAPAccounting.QuarterPeriod AS QuarterPeriod,
	VendorsARAPAccounting.HalfYearPeriod AS HalfYearPeriod,
	VendorsARAPAccounting.YearPeriod AS YearPeriod,
	CASE
		WHEN VendorsARAPAccounting.SumOpeningBalance &gt; 0
			THEN VendorsARAPAccounting.SumOpeningBalance
		ELSE 0
	END AS PartnerDebt_OpeningBalance,
	CASE
		WHEN VendorsARAPAccounting.SumOpeningBalance &lt; 0
			THEN -VendorsARAPAccounting.SumOpeningBalance
		ELSE 0
	END AS AccountsPayableOfCompanyOpeningBalance,
	VendorsARAPAccounting.SumOpeningBalance AS DebtOpeningBalance,
	VendorsARAPAccounting.SumReceipt AS DebtIncrease_,
	VendorsARAPAccounting.SumExpense AS DebtReduction,
	VendorsARAPAccounting.SumClosingBalance AS DebtClosingBalance,
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance &gt; 0
			THEN VendorsARAPAccounting.SumClosingBalance
		ELSE 0
	END AS PartnerDebt_ClosingBalance,
	CASE
		WHEN VendorsARAPAccounting.SumClosingBalance &lt; 0
			THEN -VendorsARAPAccounting.SumClosingBalance
		ELSE 0
	END AS AccountsPayableOfCompanyClosingBalance
FROM
	AccumulationRegister.VendorsARAPAccounting.BalanceAndTurnovers(, , Auto, , ) AS VendorsARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData = 1
{WHERE
	(RegisterAccountingAnalyticsForPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
			</item>
