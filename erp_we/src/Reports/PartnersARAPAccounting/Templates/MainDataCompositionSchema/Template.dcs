	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	1 AS PaymentType_,
	VendorsARAPAccounting.AccountingDimensionByPartners,
	RegisterAccountingAnalyticsForPartners.Organization,
	RegisterAccountingAnalyticsForPartners.Partner,
	RegisterAccountingAnalyticsForPartners.Counterparty,
	RegisterAccountingAnalyticsForPartners.Contract,  
	CASE WHEN NOT VendorsARAPAccounting.PurchaseOrder.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
		THEN RegisterAccountingAnalyticsForPartners.LineOfBusiness
		ELSE VendorsARAPAccounting.PurchaseOrder.LineOfBusiness
	END AS LineOfBusiness,
	CASE WHEN &amp;SettlementsData = 2 THEN // In the currency of the accounting department
		&amp;ManagementAccountingCurrency
	ELSE
		RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
	END AS Currency,
	VendorsARAPAccounting.PurchaseOrder AS OrderDocument,
	VendorsARAPAccounting.PurchaseOrder.FinancialAccountingGroup AS FinancialAccountingGroup,
	CASE
		WHEN VendorsARAPAccounting.Recorder = UNDEFINED
			THEN NULL
		ELSE VendorsARAPAccounting.Recorder
	END AS Recorder,
	VendorsARAPAccounting.SecondPeriod AS SecondPeriod,
	VendorsARAPAccounting.DayPeriod AS DayPeriod,
	VendorsARAPAccounting.WeekPeriod AS WeekPeriod,
	VendorsARAPAccounting.TenDaysPeriod AS TenDaysPeriod,
	VendorsARAPAccounting.MonthPeriod AS MonthPeriod,
	VendorsARAPAccounting.QuarterPeriod AS QuarterPeriod,
	VendorsARAPAccounting.HalfYearPeriod AS HalfYearPeriod,
	VendorsARAPAccounting.YearPeriod AS YearPeriod,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CASE
					WHEN VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance &gt; 0
						THEN VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance
					ELSE 0
				END
		ELSE CASE
				WHEN VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance &gt; 0
					THEN VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance
				ELSE 0
			END
	END AS PartnerDebt_OpeningBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CASE
					WHEN VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance &lt; 0
						THEN -(VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance)
					ELSE 0
				END
		ELSE CASE
				WHEN VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance &lt; 0
					THEN -(VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance)
				ELSE 0
			END
	END AS AccountsPayableOfCompanyOpeningBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN VendorsARAPAccounting.ARAPManOpeningBalance + VendorsARAPAccounting.PrepaymentManOpeningBalance
		ELSE VendorsARAPAccounting.DebtLocalOpeningBalance + VendorsARAPAccounting.PrepaymentLocalOpeningBalance
	END AS DebtOpeningBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN VendorsARAPAccounting.ARAPManReceipt + VendorsARAPAccounting.PrepaymentManReceipt
		ELSE VendorsARAPAccounting.DebtLocalReceipt + VendorsARAPAccounting.PrepaymentLocalReceipt
	END AS DebtIncrease_,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN VendorsARAPAccounting.ARAPManExpense + VendorsARAPAccounting.PrepaymentManExpense
		ELSE VendorsARAPAccounting.DebtLocalExpense + VendorsARAPAccounting.PrepaymentLocalExpense
	END AS DebtReduction,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance
		ELSE VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance
	END AS DebtClosingBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CASE
					WHEN VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance &gt; 0
						THEN VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance
					ELSE 0
				END
		ELSE CASE
				WHEN VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance &gt; 0
					THEN VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance
				ELSE 0
			END
	END AS PartnerDebt_ClosingBalance,
	CASE
		WHEN &amp;SettlementsData = 2
			THEN CASE
					WHEN VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance &lt; 0
						THEN -(VendorsARAPAccounting.ARAPManClosingBalance + VendorsARAPAccounting.PrepaymentManClosingBalance)
					ELSE 0
				END
		ELSE CASE
				WHEN VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance &lt; 0
					THEN -(VendorsARAPAccounting.DebtLocalClosingBalance + VendorsARAPAccounting.PrepaymentLocalClosingBalance)
				ELSE 0
			END
	END AS AccountsPayableOfCompanyClosingBalance
FROM
	AccumulationRegister.VendorsARAPAccountingByDocuments.BalanceAndTurnovers(, , Auto, , ) AS VendorsARAPAccounting
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON VendorsARAPAccounting.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey}
WHERE
	RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND &amp;SettlementsData IN (2, 3)
{WHERE
	(RegisterAccountingAnalyticsForPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
			</item>
		</item>
	</dataSet>
	<totalField>
		<dataPath>DebtClosingBalance</dataPath>
		<expression>Sum(DebtClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>DebtOpeningBalance</dataPath>
		<expression>Sum(DebtOpeningBalance)</expression>
	</totalField>
