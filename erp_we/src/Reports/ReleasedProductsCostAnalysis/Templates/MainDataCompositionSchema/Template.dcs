					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>// Is being refilled in the object module

SELECT ALLOWED TOP 0
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS ProductDepartment,
	VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef) AS ManufacturedProductDimension,
	VALUE(Catalog.Products.EmptyRef) AS ManufacturedProduct,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS ItemVariant,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS ProductUnitOfMeasure,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS ProductionSeries_,
	VALUE(Catalog.ProductCostElements.EmptyRef) AS ProductCostElement,
	"Lots" AS CostKind,
	VALUE(Catalog.Products.EmptyRef) AS Cost_,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS CostCharacteristic,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS SeriesCosts,
	
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS CostUnitOfMeasure,
	
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	UNDEFINED AS ProductionOrder,
	VALUE(Catalog.AnalyticalInventoryGroups.EmptyRef) AS ProductsGroup,
	VALUE(Catalog.InventoryKinds.EmptyRef) AS InventoryOwnerAttribute,
	VALUE(Catalog.Assignments.EmptyRef) AS AssignmentOfProducts,
	
	0 AS NumberOfCosts,
	0 AS CostOfCosts,
	0 AS CostTD,
	0 AS PermanentDifference,
	//0 AS NDD,
	UNDEFINED AS Recorder
</query>
		</item>
