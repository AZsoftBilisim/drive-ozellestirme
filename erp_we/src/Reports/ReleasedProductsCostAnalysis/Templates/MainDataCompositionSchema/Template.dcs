	<settingsVariant>
		<dcsset:name>AnalysisOfReleasedProductCostByEnterprise</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Analysis of released product cost by enterprise</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تحلیل بهای محصول خروجی بر اساس سازمان</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Analisi dei costi di produzione dei prodotti fabbricati secondo l'impresa</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Analiza kosztów produkcji w przedsiębiorstwie</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Анализ себестоимости выпущенной продукции по предприятию</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>İmal edilen ürün maliyetinin işletmeye göre analizi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Phân tích giá thành xuất xưởng theo Tập đoàn</v8:content>
			</v8:item>
		</dcsset:presentation>
