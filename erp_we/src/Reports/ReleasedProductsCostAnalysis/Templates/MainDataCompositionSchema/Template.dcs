				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Cost</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>بهای تمام‌شده</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
