	<totalField>
		<dataPath>NumberOfCosts</dataPath>
		<expression>Sum(NumberOfCosts)</expression>
		<group>CostUnitOfMeasure</group>
		<group>Cost_</group>
		<group>SeriesCosts</group>
		<group>ProductCostElement</group>
		<group>CostCharacteristic</group>
	</totalField>
	<totalField>
		<dataPath>CostOfCosts</dataPath>
		<expression>Sum(CostOfCosts)</expression>
	</totalField>
	<totalField>
		<dataPath>CostPerProductItem</dataPath>
		<expression>Case When Sum(ProductsQuantity) &lt;&gt; 0 Then
	Sum(CostOfCosts) / Sum(ProductsQuantity)
Else
	Sum(CostOfCosts)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityOfCostsPerProductUnit</dataPath>
		<expression>Case When Sum(ProductsQuantity) &lt;&gt; 0 Then
	Sum(NumberOfCosts) / Sum(ProductsQuantity)
Else
	Sum(NumberOfCosts)
End</expression>
		<group>CostUnitOfMeasure</group>
		<group>Cost_</group>
		<group>SeriesCosts</group>
		<group>CostCharacteristic</group>
	</totalField>
	<totalField>
		<dataPath>CostOfOffBalanceSheetCosts</dataPath>
		<expression>Sum(CostOfOffBalanceSheetCosts)</expression>
	</totalField>
	<totalField>
		<dataPath>CostInTaxAccounting</dataPath>
		<expression>Sum(CostInTaxAccounting)</expression>
	</totalField>
	<totalField>
		<dataPath>CostTD</dataPath>
		<expression>Sum(CostTD)</expression>
	</totalField>
	<totalField>
		<dataPath>PermanentDifference</dataPath>
		<expression>Sum(PermanentDifference)</expression>
	</totalField>
	<totalField>
		<dataPath>CostPerUnitCostOffBalance</dataPath>
		<expression>Case When Sum(ProductsQuantity) &lt;&gt; 0 Then
	Sum(CostOfOffBalanceSheetCosts) / Sum(ProductsQuantity)
Else
	Sum(CostOfOffBalanceSheetCosts)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AIT</dataPath>
		<expression>Sum(AIT)</expression>
	</totalField>
	<totalField>
		<dataPath>TargetCost</dataPath>
		<expression>Sum(TargetCost)</expression>
		<group>ManufacturedProductDimension</group>
		<group>AssignmentOfProducts</group>
		<group>Organization</group>
		<group>ManufacturedProduct</group>
		<group>ProductionSeries_</group>
		<group>ItemVariant</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>DeviationInCostOfManufacturedProducts</dataPath>
		<expression>Sum(CostOfCosts) - Sum(TargetCost)</expression>
		<group>ManufacturedProductDimension</group>
		<group>AssignmentOfProducts</group>
		<group>Organization</group>
		<group>ManufacturedProduct</group>
		<group>ProductionSeries_</group>
		<group>ItemVariant</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>ProductsQuantity</dataPath>
		<expression>Sum(ProductsQuantity)</expression>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
