	<settingsVariant>
		<dcsset:name>CompareReleasedProductCostByOrdersByEnterprise</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Compare released product cost by orders by enterprise</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>مقایسه بهای محصول خروجی بر اساس سفارش‌ها در سطح سازمان</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Confronto dei costi di produzione dei prodotti fabbricati secondo gli ordini dell'impresa</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Porównanie kosztów produkcji dla zamówień dla przedsiębiorstwa</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сравнение себестоимости выпущенной продукции по заказам по предприятию</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>İşletmeye göre siparişler için imal edilen ürün maliyetinin karşılaştırılması</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>So sánh chi phí sản xuất cho các đơn đặt hàng theo Tập đoàn</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
