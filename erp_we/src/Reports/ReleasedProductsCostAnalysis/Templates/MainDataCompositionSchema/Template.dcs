		<dataSource>DataSource1</dataSource>
		<query>// !!! TAGS ARE USED !!!
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	InventoryCost.Organization AS Organization,
	BEGINOFPERIOD(InventoryCost.Period, MONTH) AS ActionPeriod
INTO PeriodsOfActionOfMediumSlip
FROM
	AccumulationRegister.InventoryCost AS InventoryCost
WHERE
	InventoryCost.CostDefiningMethod = VALUE(Enum.WaysToCalculateInventoryCost.ByMovingAverage)
	AND (InventoryCost.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
{WHERE
	InventoryCost.Organization.*
}

INDEX BY
	ActionPeriod,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductionIssue.Organization AS Organization,
	CASE
		WHEN NOT Constants.UseProductionManagement2_2
			THEN UNDEFINED
		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Department)
			THEN Dimension.Department
		WHEN Dimension.StorageType = VALUE(Enum.StorageLocationTypes.Partner)
			THEN Dimension.Partner
		ELSE Dimension.WarehouseArea.Department
	END AS ProductDepartment,
	CASE
		WHEN FALSE THEN UNDEFINED // for easy tag placement
		ELSE
			ProductionIssue.ItemsLocationAttributes
	END AS ManufacturedProductDimension,
	ProductionIssue.Department AS ReleaseDepartment,
	Dimension.Products AS ManufacturedProduct,
	Dimension.Characteristic AS ItemVariant,
	Dimension.Purpose AS AssignmentOfProducts,
	Dimension.Series AS ProductionSeries_,
	CASE
		WHEN NOT ProductionStage2_2.Ref IS NULL
			THEN ProductionStage2_2.ReferenceOrder
		WHEN ProductionIssue.OrderDocument REFS Document.MaterialProviderOrder2_5
			THEN ProductionIssue.Recorder
		WHEN ProductionIssue.OrderDocument = UNDEFINED
			THEN UNDEFINED
		ELSE ProductionIssue.OrderDocument
	END AS ProductionOrder,
	CASE
		WHEN PeriodsOfActionOfMediumSlip.Organization IS NULL
			THEN ProductionIssue.Recorder
		ELSE UNDEFINED
	END AS Recorder,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductionIssue.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN Dimension.Products.UnitFactorForReports &lt;&gt; 0
						THEN ProductionIssue.Count / Dimension.Products.UnitFactorForReports
					ELSE 0
				END
	END AS ProductsQuantity
{SELECT
	Organization.*,
	ProductDepartment.*,
	ReleaseDepartment.*,
	ManufacturedProduct.*,
	ItemVariant.*,
	AssignmentOfProducts.*,
	ProductionSeries_.*,
	ProductionOrder.*,
	Recorder.*,
	ProductsQuantity}
FROM
	AccumulationRegister.ProductsRelease AS ProductionIssue
		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
		ON ProductionIssue.ItemsLocationAttributes = Dimension.Ref
		LEFT JOIN Constants AS Constants
		ON (TRUE)
		LEFT JOIN PeriodsOfActionOfMediumSlip AS PeriodsOfActionOfMediumSlip
			ON PeriodsOfActionOfMediumSlip.Organization = ProductionIssue.Organization
			AND PeriodsOfActionOfMediumSlip.ActionPeriod = BEGINOFPERIOD(ProductionIssue.Period, MONTH)
		
		LEFT JOIN Document.ProductionStage2_2 AS ProductionStage2_2
		ON ProductionIssue.Recorder = ProductionStage2_2.Ref
		
		// We exclude documents for which a correction has been entered or storno in the current period.
		LEFT JOIN InformationRegister.DocumentsRegistry AS Register3
		ON Register3.ReversedDocument = ProductionIssue.Recorder
			AND Register3.ReverseTransactionCorrection
			AND (Register3.IBDocumentDate &lt;= &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
			AND Register3.Posted
WHERE
	(ProductionIssue.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
	AND NOT ProductionIssue.ReversingEntry
	AND Register3.Ref IS NULL
		
{WHERE
	ProductionIssue.Organization.*,
	Dimension.Products.* AS ManufacturedProduct,
	Dimension.Characteristic.* AS ItemVariant,
	Dimension.Purpose.* AS AssignmentOfProducts,
	Dimension.Series.* AS ProductionSeries_,
	(CASE
		WHEN PeriodsOfActionOfMediumSlip.Organization IS NULL
			THEN ProductionIssue.Recorder
		ELSE UNDEFINED
	END).* AS Recorder,
	ProductionIssue.Department.* AS ReleaseDepartment,
	(Dimension.Products, Dimension.Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}</query>
	</dataSet>
