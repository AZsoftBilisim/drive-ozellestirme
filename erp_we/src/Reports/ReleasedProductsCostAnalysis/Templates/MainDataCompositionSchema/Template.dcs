	<settingsVariant>
		<dcsset:name>ProductionAtPlannedCostByCompany</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Product release at standard cost by company</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>خروجی محصول به بهای استاندارد بر اساس شرکت</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Выпуск продукции по плановой стоимости по организации</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>İş yeri dahilinde planlanan değerde üretim</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Xuất xưởng thành phẩm theo giá trị dự tính theo doanh nghiệp</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Product release at standard cost by company</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Product release at standard cost by company</v8:content>
			</v8:item>
		</dcsset:presentation>
