						<v8:lang>it</v8:lang>
						<v8:content>AIT</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>AIT</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>// !!! TAGS ARE USED !!!
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	InventoryCost.Organization AS Organization,
	BEGINOFPERIOD(InventoryCost.Period, MONTH) AS ActionPeriod
INTO PeriodsOfActionOfMediumSlip
FROM
	AccumulationRegister.InventoryCost AS InventoryCost
WHERE
	InventoryCost.CostDefiningMethod = VALUE(Enum.WaysToCalculateInventoryCost.ByMovingAverage)
	AND (InventoryCost.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
{WHERE
	InventoryCost.Organization.*
}

INDEX BY
	ActionPeriod,
	Organization
;


////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	UnfinishedProductionCosts.Organization,
	CASE
		WHEN NOT Constants.UseProductionManagement2_2
			THEN UNDEFINED
		WHEN IssueAnalytics.StorageType = VALUE(Enum.StorageLocationTypes.Department)
			THEN IssueAnalytics.Department
		WHEN IssueAnalytics.StorageType = VALUE(Enum.StorageLocationTypes.Partner)
			THEN IssueAnalytics.Partner
		ELSE IssueAnalytics.WarehouseArea.Department
	END AS ProductDepartment,
	UnfinishedProductionCosts.ProductsAccountingDimension AS ManufacturedProductDimension,
	IssueAnalytics.Products AS ManufacturedProduct,
	IssueAnalytics.Characteristic AS ItemVariant,
	IssueAnalytics.Products.UnitOfMeasure AS ProductUnitOfMeasure,
	CASE 
		WHEN &amp;ShowDetailsByReleaseSeries 
			THEN IssueAnalytics.Series 
		ELSE VALUE(Catalog.ItemsBatches.EmptyRef) 
	END AS ProductionSeries_,
	IssueAnalytics.Purpose AS AssignmentOfProducts,
	CASE
		WHEN NOT &amp;DetailByPurposes
			THEN VALUE(Catalog.Assignments.EmptyRef)
		WHEN NOT StageProduction.Purpose IS NULL
			THEN StageProduction.Purpose
		WHEN NOT StageByProducts_.Purpose IS NULL
			THEN StageByProducts_.Purpose
		WHEN TRUE
			THEN IssueAnalytics.Purpose
	END AS AssignAProductReceiver,
	UnfinishedProductionCosts.ProductCostElement,
	"OtherExpenses" AS CostKind,
	UnfinishedProductionCosts.ExpenseItem AS Cost_,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS CostCharacteristic,
	VALUE(Catalog.ItemsBatches.EmptyRef) AS SeriesCosts,
	UNDEFINED AS CostUnitOfMeasure,
	UnfinishedProductionCosts.Department,
	(CASE
		WHEN ProductionStage2_2.Ref IS NOT NULL THEN ProductionStage2_2.ReferenceOrder
		WHEN UnfinishedProductionCosts.ProductionOrder IS NULL THEN UNDEFINED
		WHEN UnfinishedProductionCosts.ProductionOrder = VALUE(Catalog.BillsOfMaterials.EmptyRef) THEN UNDEFINED

		
		
		ELSE UnfinishedProductionCosts.ProductionOrder END) AS ProductionOrder,
	CASE 
		WHEN &amp;DetailByBatchOfProduction 
			THEN UnfinishedProductionCosts.ProductionLot 
		ELSE VALUE(Catalog.ProductionLots.EmptyRef) 
	END AS ProductionLot,
	UnfinishedProductionCosts.RowCodeProducts,
	UnfinishedProductionCosts.Stage,
	UnfinishedProductionCosts.ProductsGroup,
	0 AS NumberOfCosts,
	CASE WHEN &amp;Cost_Data = 1 THEN
		UnfinishedProductionCosts.Cost
	WHEN &amp;Cost_Data = 2 THEN
		UnfinishedProductionCosts.CostExcludingVAT
	WHEN &amp;Cost_Data = 3 THEN
		UnfinishedProductionCosts.CostMan
	WHEN &amp;Cost_Data = 4 THEN
		UnfinishedProductionCosts.LocalCost
	ELSE
		CASE WHEN &amp;ByEnterprise
			THEN UnfinishedProductionCosts.CostExcludingVAT
			ELSE UnfinishedProductionCosts.CostMan
		END
	END AS CostOfCosts,
	CASE
		WHEN &amp;Cost_Data = 4
			THEN UnfinishedProductionCosts.CostTD
		ELSE 0
	END AS CostTD,
	CASE
		WHEN &amp;Cost_Data = 4
			THEN UnfinishedProductionCosts.PermanentDifference
		ELSE 0
	END AS PermanentDifference,
	CASE
		WHEN &amp;Cost_Data = 4
			THEN UnfinishedProductionCosts.CostOfPersonalIncomeTax
		ELSE 0
	END AS AIT,
	CASE
		WHEN VALUETYPE(UnfinishedProductionCosts.Recorder) = TYPE(Document.CostCalculationRecorder)
			THEN UNDEFINED
		WHEN PeriodsOfActionOfMediumSlip.Organization IS NULL
			THEN UnfinishedProductionCosts.Recorder
		ELSE UNDEFINED
	END AS Recorder
FROM
	AccumulationRegister.OtherWorkInProgressExpenses AS UnfinishedProductionCosts
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS IssueAnalytics
		ON UnfinishedProductionCosts.ProductsAccountingDimension = IssueAnalytics.Ref
		LEFT JOIN Constants AS Constants
		ON (TRUE)
		LEFT JOIN PeriodsOfActionOfMediumSlip AS PeriodsOfActionOfMediumSlip
			ON PeriodsOfActionOfMediumSlip.Organization = UnfinishedProductionCosts.Organization
			AND PeriodsOfActionOfMediumSlip.ActionPeriod = BEGINOFPERIOD(UnfinishedProductionCosts.Period, MONTH)
		
		LEFT JOIN Catalog.KeysForLotVendorAttributes AS PartyAnalysts_
			ON PartyAnalysts_.Ref = UnfinishedProductionCosts.LotVendorAttributesCorr
		LEFT JOIN Document.ProductionStage2_2.ManufacturedProducts AS StageProduction
			ON UnfinishedProductionCosts.Recorder = StageProduction.Ref
			AND PartyAnalysts_.RowCode = StageProduction.RowCode
			AND NOT StageProduction.Canceled
		LEFT JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS StageByProducts_
			ON UnfinishedProductionCosts.Recorder = StageByProducts_.Ref
			AND PartyAnalysts_.RowCode = StageByProducts_.RowCode
			AND NOT StageByProducts_.Canceled
		LEFT JOIN Document.ProductionStage2_2 AS ProductionStage2_2
			ON UnfinishedProductionCosts.Recorder = ProductionStage2_2.Ref
		LEFT JOIN InformationRegister.DocumentsRegistry AS Register3
		ON Register3.ReversedDocument = UnfinishedProductionCosts.Recorder
			AND Register3.ReverseTransactionCorrection
			AND (Register3.IBDocumentDate &lt;= &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
			AND Register3.Posted
WHERE
	UnfinishedProductionCosts.RecordType = VALUE(AccumulationRecordType.Expense)
	AND (UnfinishedProductionCosts.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod OR &amp;EndOfPeriod = DATETIME(1,1,1))
	
	// We exclude documents for which a correction has been entered or storno in the current period.
	AND Register3.Ref IS NULL
	AND NOT UnfinishedProductionCosts.ReversingEntry
{WHERE
	((UnfinishedProductionCosts.ManufacturedProduct, UnfinishedProductionCosts.ItemVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
</query>
		</item>
