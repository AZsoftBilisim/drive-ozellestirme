		<dataSource>DataSource1</dataSource>
		<query>SELECT
	T.Organization								AS Organization,
	T.ItemsLocationAttributes				AS ItemsLocationAttributes,
	T.ItemsLocationAttributes.Products	AS Products,
	SUM(T.BalanceGoodsOfOrganizations)			AS BalanceGoodsOfOrganizations,
	SUM(T.BalanceCost)				AS BalanceCost
INTO TTDiscrepanciesPreliminary
FROM
	(
	// Inventory cost
	SELECT
		T.Organization					AS Organization,
		T.ItemsLocationAttributes	AS ItemsLocationAttributes,
		0								AS BalanceGoodsOfOrganizations,
		T.CountClosingBalance		AS BalanceCost
	FROM
		AccumulationRegister.InventoryCost.BalanceAndTurnovers(,
			&amp;EndOfPeriod,,
			RegisterRecordsAndPeriodBoundaries,
			&amp;GenerateReport_
			AND NOT AccountingSection IN (
				VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress),
				VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit))
			AND ItemsLocationAttributes.Products.ItemsType IN (
				VALUE(Enum.ItemsTypes.OwnGoods),
				VALUE(Enum.ItemsTypes.ReusablePackage))
			// We exclude goods accepted for commission that have been redeemed.
			AND NOT (AccountingSection = VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock)
				AND ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Partner))
			AND NOT VALUETYPE(Lot) IN (
				TYPE(Catalog.ProductionLots))
	
	) AS T
	
	UNION ALL
	
	// Products of organizations
	SELECT
		T.Organization				AS Organization,
		CASE
			WHEN &amp;KeepRecordsOfInventoryCostByAssignments
				THEN T.ItemsLocationAttributes
			ELSE AnalyticsWithoutAssignment.DimensionKey
		END						AS ItemsLocationAttributes,
		T.CountClosingBalance	AS BalanceGoodsOfOrganizations,
		0							AS BalanceCost
	FROM
		AccumulationRegister.CompanyGoods.BalanceAndTurnovers(,
			&amp;EndOfPeriod,,
			RegisterRecordsAndPeriodBoundaries, &amp;GenerateReport_) AS T
		
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		ON NOT &amp;KeepRecordsOfInventoryCostByAssignments
		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
		
	
	UNION ALL
	
	// Materials in the production
	SELECT
		T.Organization				AS Organization,
		CASE
			WHEN &amp;KeepRecordsOfInventoryCostByAssignments
				THEN Dimension.DimensionKey
			ELSE AnalyticsWithoutAssignment.DimensionKey
		END						AS ItemsLocationAttributes,
		T.CountClosingBalance	AS BalanceGoodsOfOrganizations,
		0							AS BalanceCost
	FROM
		AccumulationRegister.MaterialsAndWorksInProduction.BalanceAndTurnovers(,
			&amp;EndOfPeriod,,
			RegisterRecordsAndPeriodBoundaries,
			&amp;GenerateReport_
			AND Products.ItemsType IN (
				VALUE(Enum.ItemsTypes.OwnGoods),
				VALUE(Enum.ItemsTypes.ReusablePackage))
		) AS T
		
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS Dimension
		ON Dimension.Products = T.Products
		AND Dimension.Characteristic = T.Characteristic
		AND Dimension.StorageLocation = T.Department
		AND Dimension.Series = T.Series
		AND Dimension.Purpose = T.Purpose
		AND Dimension.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		ON NOT &amp;KeepRecordsOfInventoryCostByAssignments
		AND AnalyticsWithoutAssignment.Products = Dimension.Products
		AND AnalyticsWithoutAssignment.Characteristic = Dimension.Characteristic
		AND AnalyticsWithoutAssignment.StorageLocation = Dimension.StorageLocation
		AND AnalyticsWithoutAssignment.Series = Dimension.Series
		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		AND AnalyticsWithoutAssignment.ProductCostElement = Dimension.ProductCostElement
	
	UNION ALL
	
	// Products of organizations to be transferred
	SELECT
		T.SellerInventoryOwnerAttribute.Organization	AS Organization,
		CASE
			WHEN &amp;KeepRecordsOfInventoryCostByAssignments
				THEN T.ItemsLocationAttributes
			ELSE AnalyticsWithoutAssignment.DimensionKey
		END								AS ItemsLocationAttributes,
		T.CountClosingBalance			AS BalanceGoodsOfOrganizations,
		0									AS BalanceCost
	FROM
		AccumulationRegister.CompanyGoodsForTransfer.BalanceAndTurnovers(,
			&amp;EndOfPeriod,,
			RegisterRecordsAndPeriodBoundaries, &amp;GenerateReport_) AS T
	
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		ON NOT &amp;KeepRecordsOfInventoryCostByAssignments
		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement

	
	
	UNION ALL
	
	// The goods transferred to the Commission
	SELECT
		T.InventoryOwnerAttribute.Organization	AS Organization,
		CASE
			WHEN &amp;KeepRecordsOfInventoryCostByAssignments
				THEN T.ItemsLocationAttributes
			ELSE AnalyticsWithoutAssignment.DimensionKey
		END						AS ItemsLocationAttributes,
		T.CountClosingBalance	AS BalanceGoodsOfOrganizations,
		0							AS BalanceCost
	FROM
		AccumulationRegister.GoodsTransferredToCommissionAgent.BalanceAndTurnovers(,
			&amp;EndOfPeriod,,
			RegisterRecordsAndPeriodBoundaries, &amp;GenerateReport_) AS T
	
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		ON NOT &amp;KeepRecordsOfInventoryCostByAssignments
		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
	
	UNION ALL
	
	// Goods for customs Declaration processing
	SELECT
		T.Organization				AS Organization,
		CASE
			WHEN &amp;KeepRecordsOfInventoryCostByAssignments
				THEN T.ItemsLocationAttributes
			ELSE AnalyticsWithoutAssignment.DimensionKey
		END						AS ItemsLocationAttributes,
		T.CountClosingBalance	AS BalanceGoodsOfOrganizations,
		0							AS BalanceCost
	FROM
		AccumulationRegister.GoodsForRegistrationOfImportDocuments.BalanceAndTurnovers(,
			&amp;EndOfPeriod,,
			RegisterRecordsAndPeriodBoundaries, &amp;GenerateReport_ AND ImportDocumentType = &amp;ImportDocumentType) AS T
	
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		ON NOT &amp;KeepRecordsOfInventoryCostByAssignments
		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
	
	UNION ALL
	
	// We exclude movements from the cost price performed offline
	SELECT
		T.Organization					AS Organization,
		T.ItemsLocationAttributes	AS ItemsLocationAttributes,
		0								AS BalanceGoodsOfOrganizations,
		T.Count					AS BalanceCost
	FROM
		AccumulationRegister.InventoryCost AS T
	WHERE
		&amp;GenerateReport_
		AND T.Period BETWEEN BEGINOFPERIOD(&amp;EndOfPeriod, MONTH) AND &amp;EndOfPeriod
		AND T.RecordType = VALUE(AccumulationRecordType.Expense)
		AND NOT T.Count = 0
		AND VALUETYPE(T.Recorder) IN (
			TYPE(Document.ProductionCostAllocation))
		AND T.ItemsLocationAttributes.Products.ItemsType IN (
			VALUE(Enum.ItemsTypes.OwnGoods),
			VALUE(Enum.ItemsTypes.ReusablePackage))
		AND (VALUETYPE(T.CorLot) IN (
			TYPE(Catalog.ProductionLots))
			)
			
	UNION ALL
	
	// We exclude movements from the goods of organizations performed offline
	SELECT
		T.Organization	AS Organization,
		CASE
			WHEN &amp;KeepRecordsOfInventoryCostByAssignments
				THEN T.ItemsLocationAttributes
			ELSE AnalyticsWithoutAssignment.DimensionKey
		END			AS ItemsLocationAttributes,
		T.Count	AS BalanceGoodsOfOrganizations,
		0				AS BalanceCost
	FROM
		AccumulationRegister.CompanyGoods AS T
	
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		ON NOT &amp;KeepRecordsOfInventoryCostByAssignments
		AND AnalyticsWithoutAssignment.Products = T.ItemsLocationAttributes.Products
		AND AnalyticsWithoutAssignment.Characteristic = T.ItemsLocationAttributes.Characteristic
		AND AnalyticsWithoutAssignment.StorageLocation = T.ItemsLocationAttributes.StorageLocation
		AND AnalyticsWithoutAssignment.Series = T.ItemsLocationAttributes.Series
		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		AND AnalyticsWithoutAssignment.ProductCostElement = T.ItemsLocationAttributes.ProductCostElement
	
	WHERE
		&amp;GenerateReport_
		AND T.Period BETWEEN BEGINOFPERIOD(&amp;EndOfPeriod, MONTH) AND &amp;EndOfPeriod
		AND VALUETYPE(T.Recorder) = TYPE(Document.ProductionCostAllocation)
		AND T.RecordType = VALUE(AccumulationRecordType.Expense)
	
	UNION ALL
	
	// We exclude movements from materials in offline production
	SELECT
		T.Organization	AS Organization,
		CASE
			WHEN &amp;KeepRecordsOfInventoryCostByAssignments
				THEN Dimension.DimensionKey
			ELSE AnalyticsWithoutAssignment.DimensionKey
		END			AS ItemsLocationAttributes,
		T.Count	AS BalanceGoodsOfOrganizations,
		0				AS BalanceCost
	FROM
		AccumulationRegister.MaterialsAndWorksInProduction AS T
		
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS Dimension
		ON Dimension.Products = T.Products
		AND Dimension.Characteristic = T.Characteristic
		AND Dimension.StorageLocation = T.Department
		AND Dimension.Series = T.Series
		AND Dimension.Purpose = T.Purpose
		AND Dimension.ProductCostElement = VALUE(Catalog.ProductCostElements.EmptyRef)
	
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS AnalyticsWithoutAssignment
		ON NOT &amp;KeepRecordsOfInventoryCostByAssignments
		AND AnalyticsWithoutAssignment.Products = Dimension.Products
		AND AnalyticsWithoutAssignment.Characteristic = Dimension.Characteristic
		AND AnalyticsWithoutAssignment.StorageLocation = Dimension.StorageLocation
		AND AnalyticsWithoutAssignment.Series = Dimension.Series
		AND AnalyticsWithoutAssignment.Purpose = VALUE(Catalog.Assignments.EmptyRef)
		AND AnalyticsWithoutAssignment.ProductCostElement = Dimension.ProductCostElement

	WHERE
		&amp;GenerateReport_
		AND T.Period BETWEEN BEGINOFPERIOD(&amp;EndOfPeriod, MONTH) AND &amp;EndOfPeriod
		AND T.RecordType = VALUE(AccumulationRecordType.Expense)
		AND VALUETYPE(T.Recorder) IN (
										TYPE(Document.ProductionCostAllocation))
		AND T.Products.ItemsType IN (
			VALUE(Enum.ItemsTypes.OwnGoods),
			VALUE(Enum.ItemsTypes.ReusablePackage))
	) AS T

GROUP BY
	T.Organization,
	T.ItemsLocationAttributes,
	T.ItemsLocationAttributes.Products

HAVING
	SUM(T.BalanceCost) &gt;= 0
	AND (NOT &amp;DisplayVariancesOnly
		OR SUM(T.BalanceGoodsOfOrganizations) &lt;&gt; SUM(T.BalanceCost))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	T.Organization,
	T.ItemsLocationAttributes,
	T.Products,
	T.BalanceCost,
	T.BalanceGoodsOfOrganizations
FROM
	TTDiscrepanciesPreliminary AS T
</query>
	</dataSet>
	<totalField>
		<dataPath>BalanceCost</dataPath>
		<expression>Sum(BalanceCost)</expression>
		<group>ItemsLocationAttributes</group>
	</totalField>
	<totalField>
		<dataPath>BalanceGoodsOfOrganizations</dataPath>
		<expression>Sum(BalanceGoodsOfOrganizations)</expression>
		<group>ItemsLocationAttributes</group>
	</totalField>
