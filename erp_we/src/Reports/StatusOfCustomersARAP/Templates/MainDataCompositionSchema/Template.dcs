			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CustomersARAPAccounting.AccountingDimensionByPartners AS AccountingDimensionByPartners,
	CustomersARAPAccounting.ARAPObject AS SalesOrder,
	CASE
		WHEN CustomersARAPAccounting.ARAPObject.Object REFS Catalog.CounterpartyContracts
			THEN TRUE
		ELSE FALSE
	END AS SettlementsUnderContract,
	CustomersARAPAccounting.ARAPObject.FinancialAccountingGroup AS FinancialAccountingGroup,
	CustomersARAPAccounting.Currency AS Currency,
	DimensionByPartners.Partner AS Partner,
	DimensionByPartners.Organization AS Organization,
	DimensionByPartners.Counterparty AS Counterparty,
	DimensionByPartners.Contract AS Contract,
	CustomersARAPAccounting.ARAPObject.LineOfBusiness AS LineOfBusiness,
	CASE
		WHEN CustomersARAPAccounting.AmountDueBalance &gt; 0
			THEN CustomersARAPAccounting.AmountDueBalance
		ELSE 0
	END AS ForPaymentOverdue,
	CASE
		WHEN SettlementsWithCustomersNextDay.AmountDueBalance &lt; 0
			AND (SettlementsWithCustomersNextDay.ARAPObject.Object REFS Document.ReturnOfGoodsFromCustomer
				OR SettlementsWithCustomersNextDay.ARAPObject.Object REFS Document.RequestForReturnOfGoodsFromCustomer)
			THEN -SettlementsWithCustomersNextDay.AmountDueBalance
		ELSE 0
	END AS ForCashReturnOverdue,
	CASE
		WHEN CustomersARAPAccounting.ToShipBalance &lt; 0
			THEN -CustomersARAPAccounting.ToShipBalance
		ELSE 0
	END AS ToShipOverdue
FROM
	AccumulationRegister.CustomersARAPAccounting.Balance({&amp;ReportDate}) AS CustomersARAPAccounting
		{INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionByPartners
		ON CustomersARAPAccounting.AccountingDimensionByPartners = DimensionByPartners.DimensionKey}
		{LEFT JOIN AccumulationRegister.CustomersARAPAccounting.Balance({DATEADD(&amp;ReportDate, SECOND, 1)}) AS SettlementsWithCustomersNextDay
		ON SettlementsWithCustomersNextDay.AccountingDimensionByPartners = CustomersARAPAccounting.AccountingDimensionByPartners
			AND SettlementsWithCustomersNextDay.ARAPObject = CustomersARAPAccounting.ARAPObject
			AND SettlementsWithCustomersNextDay.Currency = CustomersARAPAccounting.Currency}
WHERE
	DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
	AND (CustomersARAPAccounting.AmountDueBalance &gt; 0
			OR CustomersARAPAccounting.ToShipBalance &lt; 0
			OR CustomersARAPAccounting.BeingShippedBalance &lt; 0)
	AND (CASE
			WHEN CustomersARAPAccounting.AmountDueBalance &gt; 0
				THEN CustomersARAPAccounting.AmountDueBalance
			ELSE 0
		END &lt;&gt; 0
		OR
		CASE
			WHEN SettlementsWithCustomersNextDay.AmountDueBalance &lt; 0
				AND (SettlementsWithCustomersNextDay.ARAPObject.Object REFS Document.ReturnOfGoodsFromCustomer
					OR SettlementsWithCustomersNextDay.ARAPObject.Object REFS Document.RequestForReturnOfGoodsFromCustomer)
				THEN -SettlementsWithCustomersNextDay.AmountDueBalance
			ELSE 0
		END &lt;&gt; 0
		OR
		CASE
			WHEN CustomersARAPAccounting.ToShipBalance &lt; 0
				THEN -CustomersARAPAccounting.ToShipBalance
			ELSE 0
		END &lt;&gt; 0)
			
{WHERE
	(DimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>CustomerAccountsReceivable</dataPath>
		<expression>Sum(CustomerAccountsReceivable)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountDue</dataPath>
		<expression>Sum(AmountDue)</expression>
	</totalField>
	<totalField>
		<dataPath>ToShip</dataPath>
		<expression>Sum(ToShip)</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompany</dataPath>
		<expression>Sum(AccountsPayableOfCompany)</expression>
	</totalField>
	<totalField>
		<dataPath>PrepaymentBeforeProvision</dataPath>
		<expression>Sum(PrepaymentBeforeProvision)</expression>
	</totalField>
	<totalField>
		<dataPath>PrepaymentBeforeShipment</dataPath>
		<expression>Sum(PrepaymentBeforeShipment)</expression>
	</totalField>
	<totalField>
		<dataPath>CreditPlanned</dataPath>
		<expression>Case When Sum(CreditPlanned) &lt; 0 Then 0 Else Sum(CreditPlanned) End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtBalance</dataPath>
		<expression>Sum(DebtBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>ForPaymentOverdue</dataPath>
		<expression>Case When IsNull(Sum(ForPaymentOverdue),0) &lt;= IsNull(Sum(AmountDue),0) Then
Sum(ForPaymentOverdue)
Else
Sum(AmountDue)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToShipOverdue</dataPath>
		<expression>Sum(ToShipOverdue)</expression>
	</totalField>
	<totalField>
		<dataPath>ForCashReturn</dataPath>
		<expression>Sum(ForCashReturn)</expression>
	</totalField>
	<totalField>
		<dataPath>BeingShipped</dataPath>
		<expression>Sum(BeingShipped)</expression>
	</totalField>
	<totalField>
		<dataPath>BeingPaid</dataPath>
		<expression>Sum(BeingPaid)</expression>
	</totalField>
	<totalField>
		<dataPath>ForCashReturnOverdue</dataPath>
		<expression>Sum(ForCashReturnOverdue)</expression>
	</totalField>
	<parameter>
		<name>ReportPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
