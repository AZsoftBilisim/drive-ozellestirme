		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TermsOfLeaseContractsSliceLast.Contract,
	TermsOfLeaseContractsSliceLast.InterestRate,
	TermsOfLeaseContractsSliceLast.LeaseStartDate
FROM
	InformationRegister.TermsOfLeaseContracts.SliceLast(&amp;Period {&amp;Period} ) AS TermsOfLeaseContractsSliceLast</query>
