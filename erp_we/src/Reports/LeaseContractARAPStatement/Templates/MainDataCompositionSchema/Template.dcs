		<dataSource>DataSource1</dataSource>
		<query>SELECT
	VALUE(Catalog.LeaseContract.EmptyRef) AS Contract,
	0                                                AS RentalItems_Cost,
	0                                                AS RentalItems_AccruedDepreciation,
	0                                                AS RentalItems_ResidualValue
</query>
