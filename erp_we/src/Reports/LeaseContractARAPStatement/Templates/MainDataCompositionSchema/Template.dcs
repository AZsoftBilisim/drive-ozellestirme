		<dataSource>DataSource1</dataSource>
		<query>SELECT
	VALUE(Catalog.Companies.EmptyRef)                          AS Organization,
	VALUE(Catalog.Partners.EmptyRef)                             AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef)                          AS Counterparty,
	VALUE(Catalog.LeaseContract.EmptyRef)                       AS Contract,
	VALUE(Catalog.Currencies.EmptyRef)		                       AS Currency,
	VALUE(Catalog.LinesOfBusiness.EmptyRef)              AS LineOfBusiness,
	VALUE(Enum.TypesOfLeaseContracts.EmptyRef)                AS ContractType,
	VALUE(Enum.LeasedAssetHolder.EmptyRef)    AS AssetHolder,
	VALUE(Enum.TypesOfLeasePayments.EmptyRef)               AS AmountType,
	
	0                                                                      AS Calculations_Interests_Total,
	0                                                                      AS Calculations_Interests_Accrued,
	0                                                                      AS Settlements_Interest_Debited,
	
	0                                                                      AS Calculations_BuyoutValue_Paid,
	0                                                                      AS Calculations_BuyoutValue_Accrued,
	
	0                                                                      AS Calculations_DepositPayment_Paid,
	0                                                                      AS Calculations_DepositPayment_SetOff,
	
	0                                                                      AS Calculations_Commitments_Accrued,
	0                                                                      AS Calculations_Commitments_Repaid,
	
	0                                                                      AS Calculations_RentalService_Paid,
	0                                                                      AS Calculations_RentalService_Accrued,
	
	0                                                                      AS Calculations_VAT_ClosingBalance,
	
	0                                                                      AS Calculations_ClosingBalance</query>
	</dataSet>
