							<dcscor:parameter>PictureVerticalAlign</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:VerticalAlign">Top</dcscor:value>
						</dcscor:item>
					</dcsat:appearance>
				</dcsat:tableCell>
