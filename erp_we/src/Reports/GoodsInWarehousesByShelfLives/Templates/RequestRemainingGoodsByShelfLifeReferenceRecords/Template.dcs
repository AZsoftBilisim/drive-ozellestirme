		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products	AS Products,
	Segments.Characteristic	AS Characteristic,
	TRUE					AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductStockBalance.Products,
	ProductStockBalance.Products.ExpirationDate_ AS ExpirationDateAutoCalculation,
	ProductStockBalance.Products.ShelfLifeUnitOfMeasure AS UnitOfMeasurementOfExpirationDateAutoCalculation,
	ProductStockBalance.Products.UnitOfMeasure AS StorageUnitAutoCalculation,
	ProductStockBalance.Products.UnitForReports AS UnitForAutoCalculationReports,
	ProductStockBalance.Products.UnitFactorForReports AS UnitFactorForAutoCalculationReports,
	&amp;QueryTextItemWeight AS ProductsWeightAutoCalculation,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolumeAutoCalculation,
	ProductStockBalance.Characteristic,
	ProductStockBalance.Purpose,
	ProductStockBalance.Warehouse,
	ProductStockBalance.Premise,
	ProductStockBalance.InStockBalance,
	ISNULL(GoodsBatchMovement.Series.ValidUntil_, DATETIME(1, 1, 1)) AS ValidUntilAutorouteSeries,
	ISNULL(GoodsBatchMovement.Series, VALUE(Catalog.ItemsBatches.EmptyRef)) AS SeriesAutomaticCalculation,
	ISNULL(GoodsBatchMovement.Count, 0) AS QuantitySeries,
	CASE
		WHEN ISNULL(GoodsBatchMovement.Series.ProductKind.PrecisionOfBatchShelfLifeIndication, VALUE(Enum.AccuracyOfShelfLifeIndication.EmptyRef)) = VALUE(Enum.AccuracyOfShelfLifeIndication.UpToHours)
			THEN TRUE
		ELSE FALSE
	END AS SpecifyExpirationDateUpToHoursAutoCalculation
FROM
	AccumulationRegister.ProductStock.Balance(
			,
			(Products.ProductKind, Warehouse) IN
				(SELECT
					BatchAccountingPolicies.Ref AS ProductKind,
					BatchAccountingPolicies.Warehouse AS Warehouse
				FROM
					Catalog.ItemKinds.BatchAccountingPolicies AS BatchAccountingPolicies
				WHERE
					BatchAccountingPolicies.BatchAccountingPolicy.PolicyType = VALUE(Enum.TypesOfBatchSpecificationPolicies.FEFOAutoCalculationOfRemainingBatch))
				
			{((Products, Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
			
		) AS ProductStockBalance
		
		LEFT JOIN AccumulationRegister.GoodsBatchMovement AS GoodsBatchMovement
		ON ProductStockBalance.Products = GoodsBatchMovement.Products
			AND ProductStockBalance.Characteristic = GoodsBatchMovement.Characteristic
			AND ProductStockBalance.Warehouse = GoodsBatchMovement.Recipient
			AND ProductStockBalance.Premise = GoodsBatchMovement.WareroomOfRecipient
			AND (GoodsBatchMovement.WarehouseOperation IN (&amp;WarehouseOperationsOfGoodsAcceptance)
				OR GoodsBatchMovement.WarehouseOperation = VALUE(Enum.WarehouseTransactions.DamageRecord)
					AND NOT GoodsBatchMovement.Recipient REFS Catalog.Products)
			AND ProductStockBalance.Purpose = GoodsBatchMovement.Purpose</query>
	</dataSet>
	<totalField>
		<dataPath>InStockBalance</dataPath>
		<expression>Max(InStockBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantitySeries</dataPath>
		<expression>Sum(QuantitySeries)</expression>
	</totalField>
