		<field xsi:type="DataSetFieldField">
			<dataPath>SpecifyExpirationToThePrecisionOfTheHour</dataPath>
			<field>SpecifyExpirationToThePrecisionOfTheHour</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Specify expiration to the precision of hours</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تعیین انقضا با دقت ساعت</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Indica la data di scadenza incluse le ore esatte</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Podawać termin ważności z dokładnością do godzin</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Указывать срок годности с точностью до часов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Son kullanma tarihini saate kadar tam olarak belirt</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Cho biết ngày hết hạn chính xác đến giờ</v8:content>
				</v8:item>
			</title>
			<attributeUseRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
			<valueType>
				<v8:Type>xs:boolean</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ValidUntil_</dataPath>
			<field>ValidUntil_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Expiration date</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تاریخ انقضا</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Valido fino</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Ważny do</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Годен до</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Son kullanma tarihi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Hạn dùng đến</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
			<valueType>
				<v8:Type>xs:dateTime</v8:Type>
				<v8:DateQualifiers>
					<v8:DateFractions>DateTime</v8:DateFractions>
				</v8:DateQualifiers>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Products.ExpirationDate_</dataPath>
			<field>ExpirationDate_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Expiration date</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تاریخ انقضا</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Data di scadenza</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Termin ważności</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Срок годности</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Son kullanma tarihi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Ngày hết hạn</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Case
	When Not ValueIsFilled(Products.ExpirationDate_)
		Then NStr("ru = '&lt;не указан&gt;'; vi = '&lt;chưa chỉ ra&gt;'; en = '&lt;not specified&gt;'; it = '&lt;non specificato&gt;'; pl = '&lt;nie określono&gt;'; tr = '&lt;belirtilmedi&gt;'")
	When Not ValueIsFilled(Products.ShelfLifeUnitOfMeasure)
		Then NStr("ru = '&lt;не указана ед. изм.&gt;'; vi = '&lt;chưa chỉ ra đvt.&gt;'; en = '&lt;Unit is not specified&gt;'; it = '&lt;unità di misura non indicata&gt;'; pl = '&lt;nie podano jednostki miary&gt;'; tr = '&lt;ölçü birimi belirtilmedi&gt;'")
	Else String(Products.ExpirationDate_) + " " + String(Products.ShelfLifeUnitOfMeasure)
End</presentationExpression>
			<valueType>
