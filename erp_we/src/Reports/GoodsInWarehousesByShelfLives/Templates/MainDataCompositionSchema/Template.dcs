			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(Balance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SpecifyExpirationToThePrecisionOfTheHour</dataPath>
		<expression>SpecifyExpirationToThePrecisionOfTheHour</expression>
		<group>Series</group>
	</totalField>
	<totalField>
		<dataPath>MonthsBeforeSpoilage</dataPath>
		<expression>Case 
When Max(ValidUntil_) = DateTime(1,1,1) Then &amp;StringIsNotLimited
When Min(MonthsBeforeSpoilage) &lt; 0 Then &amp;LineNotUsable 
Else Min(MonthsBeforeSpoilage) End</expression>
		<group>Series</group>
	</totalField>
	<totalField>
		<dataPath>DaysBeforeSpoilage</dataPath>
		<expression>Case 
When Max(ValidUntil_) = DateTime(1,1,1) Then &amp;StringIsNotLimited
When Min(DaysBeforeSpoilage) &lt; 0 Then &amp;LineNotUsable Else Min(DaysBeforeSpoilage) End</expression>
		<group>Series</group>
	</totalField>
	<totalField>
		<dataPath>HoursBeforeSpoilage</dataPath>
		<expression>Case 
When Max(ValidUntil_) = DateTime(1,1,1) Then &amp;StringIsNotLimited
When Min(HoursBeforeSpoilage) &lt; 0 Then &amp;LineNotUsable Else Min(HoursBeforeSpoilage) End</expression>
		<group>Series</group>
	</totalField>
	<totalField>
		<dataPath>DateOfManufacture</dataPath>
		<expression>DateOfManufacture</expression>
		<group>Series</group>
	</totalField>
	<totalField>
		<dataPath>RelativeShelfLifeBalance</dataPath>
		<expression>RelativeShelfLifeBalance</expression>
		<group>Series</group>
	</totalField>
	<totalField>
		<dataPath>RemainingGoodsWeight</dataPath>
		<expression>Sum(RemainingGoodsWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>RemainingGoodsVolume</dataPath>
		<expression>Sum(RemainingGoodsVolume)</expression>
	</totalField>
