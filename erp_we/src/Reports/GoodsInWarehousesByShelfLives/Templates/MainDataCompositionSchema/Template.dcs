			<field xsi:type="DataSetFieldField">
				<dataPath>ControlledLotReference</dataPath>
				<field>ControlledLotReference</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Products	AS Products,
	Segments.Characteristic	AS Characteristic,
	TRUE					AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductStockBalance.Series AS Series,
	CASE
		WHEN ProductStockBalance.Series.ProductionDate = DATETIME(1, 1, 1)
			THEN NULL
		ELSE ProductStockBalance.Series.ProductionDate
	END AS ProductionDate,
	ProductStockBalance.Series.ValidUntil_ AS ValidUntil_,
	ProductStockBalance.Series.ProductKind.PrecisionOfBatchShelfLifeIndication = VALUE(Enum.AccuracyOfShelfLifeIndication.UpToHours) AS SpecifyExpirationToThePrecisionOfTheHour,
	ProductStockBalance.Products,
	ProductStockBalance.Products.UnitOfMeasure AS StorageUnit,
	ProductStockBalance.Products.UnitForReports AS UnitForReports,
	ProductStockBalance.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	ProductStockBalance.Products.ExpirationDate_ AS ExpirationDate_,
	ProductStockBalance.Products.ShelfLifeUnitOfMeasure AS ShelfLifeUnitOfMeasure,
	ProductStockBalance.Characteristic,
	ProductStockBalance.Purpose,
	ProductStockBalance.ControlledLotReference,
	ProductStockBalance.Warehouse,
	ProductStockBalance.Premise,
	ProductStockBalance.InStockBalance AS Balance
FROM
	AccumulationRegister.ProductStock.Balance(
			,
			(Products.ProductKind, Warehouse) IN
				(SELECT
					BatchAccountingPolicies.Ref AS ProductKind,
					BatchAccountingPolicies.Warehouse AS Warehouse
				FROM
					Catalog.ItemKinds.BatchAccountingPolicies AS BatchAccountingPolicies
				WHERE
					BatchAccountingPolicies.BatchAccountingPolicy.AccountForRemainingSeries
					AND NOT BatchAccountingPolicies.BatchAccountingPolicy.PolicyType = VALUE(Enum.TypesOfBatchSpecificationPolicies.FEFOAutoCalculationOfRemainingBatch)
					AND BatchAccountingPolicies.Ref.UseShelfLifeOnBatchRegistration)
			
			{((Products, Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}
			
		) AS ProductStockBalance
{WHERE ISNULL(ProductStockBalance.Series.ValidUntil_, DATETIME(1, 1, 1)) BETWEEN &amp;RemainingFinishedGoodsOnThePeriodStart AND &amp;RemainingFinishedGoodsOnThePeriodEnd}</query>
		</item>
