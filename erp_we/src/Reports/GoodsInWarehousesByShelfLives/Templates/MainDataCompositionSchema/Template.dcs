			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType"/>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MaxWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>DateOfManufacture</dataPath>
		<expression>Case
	When Not ValueIsFilled(Products.ExpirationDate_)
		Then DateTime(1, 1, 1)
	Else
		Case
			When Products.ShelfLifeUnitOfMeasure = Value(Enum.TimeMeasureUnits.Hour)
				Then DateAdd(ValidUntil_, "Hour", -Products.ExpirationDate_)
			When Products.ShelfLifeUnitOfMeasure = Value(Enum.TimeMeasureUnits.Days1)
				Then DateAdd(ValidUntil_, "Day", -Products.ExpirationDate_)
			When Products.ShelfLifeUnitOfMeasure = Value(Enum.TimeMeasureUnits.Month)
				Then DateAdd(ValidUntil_, "Month", -Products.ExpirationDate_)
			When Products.ShelfLifeUnitOfMeasure = Value(Enum.TimeMeasureUnits.Year)
				Then DateAdd(ValidUntil_, "Year", -Products.ExpirationDate_)
		End
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Production date</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تاریخ تولید</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Data di produzione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Data produkcji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата изготовления</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Üretim tarihi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Ngày sản xuất</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">13</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MaxWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">13</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>RelativeShelfLifeBalance</dataPath>
		<expression>Case
    When Products.ShelfLifeUnitOfMeasure = Value(Enum.TimeMeasureUnits.Hour)
        Then
            Case
                When IsNull(ProductionDate, DateAdd(ValidUntil_, "Hour", -Products.ExpirationDate_)) &gt;= CurrentDate()
                    Then 100
                Else
                    Case
                        When SpecifyExpirationToThePrecisionOfTheHour
                            Then
                                Case
                                    When DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Hour", -Products.ExpirationDate_)), ValidUntil_, "Hour") &gt; 0
                                            And DateDiff(CurrentDate(), ValidUntil_, "Hour") &gt; 0
                                        Then DateDiff(CurrentDate(), ValidUntil_, "Hour") / DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Hour", -Products.ExpirationDate_)), ValidUntil_, "Hour") * 100
                                    Else 0
                                End
                            Else
                                Case
                                    When DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Hour", -Products.ExpirationDate_)), ValidUntil_, "Day") &gt; 0 
                                            And DateDiff(CurrentDate(), ValidUntil_, "Day") &gt; 0
                                        Then DateDiff(CurrentDate(), ValidUntil_, "Day") / DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Hour", -Products.ExpirationDate_)), ValidUntil_, "Day") * 100
                                    Else 0
                                End
                    End
            End
    When Products.ShelfLifeUnitOfMeasure = Value(Enum.TimeMeasureUnits.Days1)
        Then
            Case
                When IsNull(ProductionDate, DateAdd(ValidUntil_, "Day", -Products.ExpirationDate_)) &gt;= CurrentDate()
                    Then 100
                Else
                    Case
                        When SpecifyExpirationToThePrecisionOfTheHour
                            Then
                                Case
                                    When DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Day", -Products.ExpirationDate_)), ValidUntil_, "Hour") &gt; 0 
                                            And DateDiff(CurrentDate(), ValidUntil_, "Hour") &gt; 0
                                        Then DateDiff(CurrentDate(), ValidUntil_, "Hour") / DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Day", -Products.ExpirationDate_)), ValidUntil_, "Hour") * 100
                                    Else 0
                                End
                            Else
                                Case
                                    When DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Day", -Products.ExpirationDate_)), ValidUntil_, "Day") &gt; 0 
                                            And DateDiff(CurrentDate(), ValidUntil_, "Day") &gt; 0
                                        Then DateDiff(CurrentDate(), ValidUntil_, "Day") / DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Day", -Products.ExpirationDate_)), ValidUntil_, "Day") * 100
                                    Else 0
                                End
                    End
            End
    When Products.ShelfLifeUnitOfMeasure = Value(Enum.TimeMeasureUnits.Month)
        Then
            Case
                When IsNull(ProductionDate, DateAdd(ValidUntil_, "Month", -Products.ExpirationDate_)) &gt;= CurrentDate()
                    Then 100
                Else
                    Case
                        When SpecifyExpirationToThePrecisionOfTheHour
                            Then
                                Case
                                    When DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Month", -Products.ExpirationDate_)), ValidUntil_, "Hour") &gt; 0 
                                            And DateDiff(CurrentDate(), ValidUntil_, "Hour") &gt; 0
                                        Then DateDiff(CurrentDate(), ValidUntil_, "Hour") / DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Month", -Products.ExpirationDate_)), ValidUntil_, "Hour") * 100
                                    Else 0
                                End
                            Else
                                Case
                                    When DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Month", -Products.ExpirationDate_)), ValidUntil_, "Day") &gt; 0 
                                            And DateDiff(CurrentDate(), ValidUntil_, "Day") &gt; 0
                                        Then DateDiff(CurrentDate(), ValidUntil_, "Day") / DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Month", -Products.ExpirationDate_)), ValidUntil_, "Day") * 100
                                    Else 0
                                End
                    End
            End
    When Products.ShelfLifeUnitOfMeasure = Value(Enum.TimeMeasureUnits.Year)
        Then
            Case
                When IsNull(ProductionDate, DateAdd(ValidUntil_, "Year", -Products.ExpirationDate_)) &gt;= CurrentDate()
                    Then 100
                Else
                    Case
                        When SpecifyExpirationToThePrecisionOfTheHour
                            Then
                                Case
                                    When DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Year", -Products.ExpirationDate_)), ValidUntil_, "Hour") &gt; 0 
                                            And DateDiff(CurrentDate(), ValidUntil_, "Hour") &gt; 0
                                        Then DateDiff(CurrentDate(), ValidUntil_, "Hour") / DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Year", -Products.ExpirationDate_)), ValidUntil_, "Hour") * 100
                                    Else 0
                                End
                            Else
                                Case
                                    When DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Year", -Products.ExpirationDate_)), ValidUntil_, "Day") &gt; 0 
                                            And DateDiff(CurrentDate(), ValidUntil_, "Day") &gt; 0
                                        Then DateDiff(CurrentDate(), ValidUntil_, "Day") / DateDiff(IsNull(ProductionDate, DateAdd(ValidUntil_, "Year", -Products.ExpirationDate_)), ValidUntil_, "Day") * 100
                                    Else 0
                                End
                    End
            End
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Time before expiration, %</v8:content>
			</v8:item>
			<v8:item>
