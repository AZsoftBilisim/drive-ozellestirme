			<order>true</order>
		</useRestriction>
	</calculatedField>
	<calculatedField>
		<dataPath>ExpirationPeriodStart</dataPath>
		<expression>Case
	When &amp;RemainingFinishedGoodsOnThePeriodStart Is NULL
		Then DateTime(1, 1, 1)
	Else &amp;RemainingFinishedGoodsOnThePeriodStart
End
</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Expiration period start</v8:content>
			</v8:item>
