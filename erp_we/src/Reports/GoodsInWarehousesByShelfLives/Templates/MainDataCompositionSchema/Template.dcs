	<calculatedField>
		<dataPath>ExpirationPeriodEnd</dataPath>
		<expression>Case
    When &amp;RemainingFinishedGoodsOnThePeriodEnd Is NULL
        Then DateTime(1, 1, 1)
    Else &amp;RemainingFinishedGoodsOnThePeriodEnd
End
</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
