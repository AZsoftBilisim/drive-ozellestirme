		<field xsi:type="DataSetFieldField">
			<dataPath>Recorder</dataPath>
			<field>Recorder</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	DeliveryTurnover.Recorder AS Recorder,
	DeliveryTurnover.PlanningDocument AS PlanningDocument,
	DeliveryTurnover.Trip AS Trip,
	DeliveryTurnover.Products AS Products,
	DeliveryTurnover.Characteristic AS Characteristic,
	DeliveryTurnover.Series AS Series,
	DeliveryTurnover.RowCode AS RowCode,
	DeliveryTurnover.Recipient AS Recipient,
	DeliveryTurnover.RecipientPoint AS RecipientPoint,
	DeliveryTurnover.InTripTurnover - DeliveryTurnover.CanceledTurnover AS InTrip
INTO VT_TripDeliveryPreparation
{SELECT
	Recorder}
FROM
	AccumulationRegister.Delivery.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;EndOfPeriod)},
			Auto,
			DeliveryType = VALUE(Enum.DeliveryTypes.OutgoingInfo)
				AND DeliveryMethod &lt;&gt; &amp;DeliveryMethodIsSelfPickup
				AND Trip = &amp;Trip
				AND Arm IN (&amp;ShoulderNumbers)) AS DeliveryTurnover
WHERE
	DeliveryTurnover.InTripTurnover - DeliveryTurnover.CanceledTurnover &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DeliveryData.ReferenceOrder AS ReferenceOrder,
	DeliveryData.Recorder AS Recorder,
	DeliveryData.PlanningDocument AS PlanningDocument,
	NOT DeliveryData.ReferenceOrder REFS Document.SalesOrder AS NoOrderRequired,
	DeliveryData.ReferenceOrder REFS Document.SalesOrder
		AND NOT DeliveryData.PlanningDocument REFS Document.CustomerInvoice
		AND NOT DeliveryData.PlanningDocument REFS Document.GoodsShipmentToCustomer AS ByOrder,
	DeliveryData.ReferenceOrder REFS Document.SalesOrder
		AND (DeliveryData.PlanningDocument REFS Document.CustomerInvoice
			OR DeliveryData.PlanningDocument REFS Document.GoodsShipmentToCustomer) AS ExceedingOrder,
	DeliveryData.Trip AS Trip,
	DeliveryData.Products AS Products,
	DeliveryData.Characteristic AS Characteristic,
	DeliveryData.Series AS Series,
	DeliveryData.RowCode AS RowCode,
	DeliveryData.Recipient AS Recipient,
	DeliveryData.RecipientPoint AS RecipientPoint,
	DeliveryData.InTrip AS InTrip
INTO TT_DeliveryByFlight
{SELECT
	Recorder}
FROM
	VT_TripDeliveryPreparation AS DeliveryData
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	DeliveryData.ReferenceOrder AS ReferenceOrder,
	DeliveryData.Recorder AS Recorder,
	DeliveryData.ByOrder AS ByOrder,
	DeliveryData.NoOrderRequired AS NoOrderRequired,
	DeliveryData.Trip AS Trip,
	DeliveryData.Products AS Products,
	DeliveryData.Characteristic AS Characteristic,
	DeliveryData.Series AS Series,
	DeliveryData.RowCode AS RowCode
INTO VT_TripDeliveryOrder
{SELECT
	Recorder}
FROM
	TT_DeliveryByFlight AS DeliveryData
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DeliveryTurnover.ReferenceOrder AS ReferenceOrder,
	DeliveryTurnover.Recorder AS Recorder,
	DeliveryTurnover.PlanningDocument AS PlanningDocument,
	DeliveryTurnover.Products AS Products,
	DeliveryTurnover.Characteristic AS Characteristic,
	DeliveryTurnover.Series AS Series,
	DeliveryTurnover.DeliveryMethod AS DeliveryMethod,
	DeliveryTurnover.RowCode AS RowCode,
	DeliveryTurnover.ReferenceOrder REFS Document.SalesOrder
		AND NOT DeliveryTurnover.PlanningDocument REFS Document.CustomerInvoice
		AND NOT DeliveryTurnover.PlanningDocument REFS Document.GoodsShipmentToCustomer AS ByOrder,
	CASE
		WHEN DeliveryTurnover.DeliveryMethod &lt;&gt; &amp;DeliveryMethodIsSelfPickup
			THEN DeliveryTurnover.ToDeliverTurnover
		ELSE 0
	END AS Deliver,
	DeliveryTurnover.ToDeliverTurnover AS DeliverEverything,
	CASE
		WHEN DeliveryTurnover.DeliveryMethod &lt;&gt; &amp;DeliveryMethodIsSelfPickup
			THEN DeliveryTurnover.InTripTurnover - DeliveryTurnover.CanceledTurnover
		ELSE 0
	END AS InTrip
INTO VT_DeliveryOnOtherTripsPreparation
{SELECT
	Recorder}
FROM
	AccumulationRegister.Delivery.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;EndOfPeriod)},
			Auto,
			DeliveryType = VALUE(Enum.DeliveryTypes.OutgoingInfo)
				AND Trip &lt;&gt; &amp;Trip
				AND Arm IN (&amp;ShoulderNumbers)
				AND (ReferenceOrder, RowCode) IN
					(SELECT
						Table.ReferenceOrder,
						Table.RowCode
					FROM
						TT_DeliveryByFlight AS Table)) AS DeliveryTurnover
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DeliveryData.ReferenceOrder AS ReferenceOrder,
	DeliveryData.Recorder AS Recorder,
	DeliveryData.PlanningDocument AS PlanningDocument,
	DeliveryData.Products AS Products,
	DeliveryData.Characteristic AS Characteristic,
	DeliveryData.Series AS Series,
	DeliveryData.RowCode AS RowCode,
	DeliveryData.ByOrder AS ByOrder,
	SUM(DeliveryData.InTrip) AS InTrip,
	SUM(DeliveryData.Deliver) AS Deliver,
	SUM(DeliveryData.DeliverEverything) AS DeliverEverything
INTO TT_OtherFlightsPlanning
{SELECT
	Recorder}
FROM
	VT_DeliveryOnOtherTripsPreparation AS DeliveryData

GROUP BY
	DeliveryData.ReferenceOrder,
	DeliveryData.Recorder,
	DeliveryData.PlanningDocument,
	DeliveryData.Products,
	DeliveryData.Characteristic,
	DeliveryData.Series,
	DeliveryData.RowCode,
	DeliveryData.ByOrder

HAVING
	(SUM(DeliveryData.DeliverEverything) &lt;&gt; 0
		OR SUM(DeliveryData.InTrip) &lt;&gt; 0)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DeliveryData.ReferenceOrder AS ReferenceOrder,
	DeliveryData.Recorder AS Recorder,
	DeliveryData.Products AS Products,
	DeliveryData.Characteristic AS Characteristic,
	DeliveryData.Series AS Series,
	DeliveryData.RowCode AS RowCode,
	DeliveryData.ByOrder AS ByOrder,
	SUM(DeliveryData.InTrip) AS InTrip,
	SUM(DeliveryData.Deliver) AS Deliver,
	SUM(DeliveryData.DeliverEverything) AS DeliverEverything
INTO TT_OtherTripsAvailable
{SELECT
	Recorder}
FROM
	VT_DeliveryOnOtherTripsPreparation AS DeliveryData

GROUP BY
	DeliveryData.ReferenceOrder,
	DeliveryData.Recorder,
	DeliveryData.Products,
	DeliveryData.Characteristic,
	DeliveryData.Series,
	DeliveryData.RowCode,
	DeliveryData.ByOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	OrdersForShipmentAndReturnTurnover.ReferenceOrder AS ReferenceOrder,
	OrdersForShipmentAndReturnTurnover.Recorder AS Recorder,
	OrdersForShipmentAndReturnTurnover.Products AS Products,
	OrdersForShipmentAndReturnTurnover.Characteristic AS Characteristic,
	OrdersForShipmentAndReturnTurnover.Series AS Series,
	OrdersForShipmentAndReturnTurnover.RowCode AS RowCode,
	CASE
		WHEN OrdersForShipmentAndReturnTurnover.Factor = &amp;IndicatorToBeShipped
			THEN OrdersForShipmentAndReturnTurnover.CountTurnover
		ELSE 0
	END AS ToShip,
	CASE
		WHEN OrdersForShipmentAndReturnTurnover.Factor = &amp;ShippedIndicator
			THEN OrdersForShipmentAndReturnTurnover.CountTurnover
		ELSE 0
	END AS Issued_1
INTO VT_ShipmentDataPreparation
{SELECT
	Recorder}
FROM
	AccumulationRegister.ShipmentAndReturnReferences.Turnovers(
			{(&amp;BeginOfPeriod)},
			{(&amp;EndOfPeriod)},
			Auto,
			(ReferenceOrder, RowCode, Products, Characteristic, Series) IN
					(SELECT
						Table.ReferenceOrder,
						Table.RowCode,
						Table.Products,
						Table.Characteristic,
						Table.Series
					FROM
						TT_DeliveryByFlight AS Table)
				AND Factor IN (&amp;Indicators)) AS OrdersForShipmentAndReturnTurnover
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ShipmentData.ReferenceOrder AS ReferenceOrder,
	ShipmentData.Recorder AS Recorder,
	ShipmentData.Products AS Products,
	ShipmentData.Characteristic AS Characteristic,
	ShipmentData.Series AS Series,
	ShipmentData.RowCode AS RowCode,
	SUM(ShipmentData.ToShip) AS ToShip,
	SUM(ShipmentData.Issued_1) AS Issued_1
INTO TT_ShipmentData
{SELECT
	Recorder}
FROM
	VT_ShipmentDataPreparation AS ShipmentData

GROUP BY
	ShipmentData.ReferenceOrder,
	ShipmentData.Recorder,
	ShipmentData.Products,
	ShipmentData.Characteristic,
	ShipmentData.Series,
	ShipmentData.RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DeliveryByFlight.ReferenceOrder AS ReferenceOrder,
	DeliveryByFlight.Recorder AS Recorder,
	DeliveryByFlight.Products AS Products,
	DeliveryByFlight.Characteristic AS Characteristic,
	DeliveryByFlight.Series AS Series,
	DeliveryByFlight.RowCode AS RowCode,
	DeliveryByFlight.Recipient AS Recipient,
	DeliveryByFlight.RecipientPoint AS RecipientPoint,
	DeliveryByFlight.InTrip AS OnCurrentTrip,
	0 AS Deliver,
	0 AS OnOtherTrips,
	0 AS ToShip,
	0 AS Issued_1
INTO TT_Indicators
{SELECT
	Recorder}
FROM
	TT_DeliveryByFlight AS DeliveryByFlight

UNION ALL

SELECT
	DeliveryByFlight.ReferenceOrder,
	OtherFlightsPlanning.Recorder,
	DeliveryByFlight.Products,
	DeliveryByFlight.Characteristic,
	DeliveryByFlight.Series,
	DeliveryByFlight.RowCode,
	VALUE(Catalog.Partners.EmptyRef),
	VALUE(Catalog.DeliveryPoints.EmptyRef),
	0,
	OtherFlightsPlanning.Deliver,
	OtherFlightsPlanning.InTrip,
	OtherFlightsPlanning.DeliverEverything,
	OtherFlightsPlanning.DeliverEverything
FROM
	TT_DeliveryByFlight AS DeliveryByFlight
		INNER JOIN TT_OtherFlightsPlanning AS OtherFlightsPlanning
		ON DeliveryByFlight.ReferenceOrder = OtherFlightsPlanning.ReferenceOrder
			AND DeliveryByFlight.PlanningDocument = OtherFlightsPlanning.PlanningDocument
			AND DeliveryByFlight.Products = OtherFlightsPlanning.Products
			AND DeliveryByFlight.Characteristic = OtherFlightsPlanning.Characteristic
			AND DeliveryByFlight.Series = OtherFlightsPlanning.Series
			AND DeliveryByFlight.RowCode = OtherFlightsPlanning.RowCode
			AND (DeliveryByFlight.ExceedingOrder)

UNION ALL

SELECT
	DeliveryByFlight.ReferenceOrder,
	ISNULL(OtherTripsAvailable.Recorder, UNDEFINED),
	DeliveryByFlight.Products,
	DeliveryByFlight.Characteristic,
	DeliveryByFlight.Series,
	DeliveryByFlight.RowCode,
	VALUE(Catalog.Partners.EmptyRef),
	VALUE(Catalog.DeliveryPoints.EmptyRef),
	0,
	ISNULL(OtherTripsAvailable.Deliver, 0),
	ISNULL(OtherTripsAvailable.InTrip, 0),
	ISNULL(OtherTripsAvailable.DeliverEverything, 0),
	ISNULL(OtherTripsAvailable.DeliverEverything, 0)
FROM
	VT_TripDeliveryOrder AS DeliveryByFlight
		LEFT JOIN TT_OtherTripsAvailable AS OtherTripsAvailable
		ON DeliveryByFlight.ReferenceOrder = OtherTripsAvailable.ReferenceOrder
			AND DeliveryByFlight.Products = OtherTripsAvailable.Products
			AND DeliveryByFlight.Characteristic = OtherTripsAvailable.Characteristic
			AND DeliveryByFlight.Series = OtherTripsAvailable.Series
			AND DeliveryByFlight.RowCode = OtherTripsAvailable.RowCode
WHERE
	DeliveryByFlight.NoOrderRequired

UNION ALL

SELECT
	DeliveryByFlight.ReferenceOrder,
	ISNULL(OtherTripsAvailable.Recorder, UNDEFINED),
	DeliveryByFlight.Products,
	DeliveryByFlight.Characteristic,
	DeliveryByFlight.Series,
	DeliveryByFlight.RowCode,
	VALUE(Catalog.Partners.EmptyRef),
	VALUE(Catalog.DeliveryPoints.EmptyRef),
	0,
	ISNULL(OtherTripsAvailable.Deliver, 0),
	ISNULL(OtherTripsAvailable.InTrip, 0),
	0,
	0
FROM
	VT_TripDeliveryOrder AS DeliveryByFlight
		LEFT JOIN TT_OtherTripsAvailable AS OtherTripsAvailable
		ON DeliveryByFlight.ReferenceOrder = OtherTripsAvailable.ReferenceOrder
			AND DeliveryByFlight.Products = OtherTripsAvailable.Products
			AND DeliveryByFlight.Characteristic = OtherTripsAvailable.Characteristic
			AND DeliveryByFlight.Series = OtherTripsAvailable.Series
			AND DeliveryByFlight.RowCode = OtherTripsAvailable.RowCode
			AND (OtherTripsAvailable.ByOrder)
WHERE
	DeliveryByFlight.ByOrder

UNION ALL

SELECT
	DeliveryByFlight.ReferenceOrder,
	ISNULL(ShipmentData.Recorder, UNDEFINED),
	DeliveryByFlight.Products,
	DeliveryByFlight.Characteristic,
	DeliveryByFlight.Series,
	DeliveryByFlight.RowCode,
	VALUE(Catalog.Partners.EmptyRef),
	VALUE(Catalog.DeliveryPoints.EmptyRef),
	0,
	0,
	0,
	ISNULL(ShipmentData.ToShip, 0),
	ISNULL(ShipmentData.Issued_1, 0)
FROM
	VT_TripDeliveryOrder AS DeliveryByFlight
		LEFT JOIN TT_ShipmentData AS ShipmentData
		ON DeliveryByFlight.ReferenceOrder = ShipmentData.ReferenceOrder
			AND DeliveryByFlight.RowCode = ShipmentData.RowCode
			AND DeliveryByFlight.Products = ShipmentData.Products
			AND DeliveryByFlight.Characteristic = ShipmentData.Characteristic
			AND DeliveryByFlight.Series = ShipmentData.Series
WHERE
	DeliveryByFlight.ByOrder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Indicators.ReferenceOrder AS ReferenceOrder,
	Indicators.Products AS Products,
	Indicators.Characteristic AS Characteristic,
	Indicators.Series AS Series,
	Indicators.RowCode AS RowCode,
	Indicators.Recorder AS Recorder,
	Indicators.Recipient AS Recipient,
	Indicators.RecipientPoint AS RecipientPoint,
	Indicators.OnCurrentTrip AS OnCurrentTrip,
	Indicators.Deliver AS Deliver,
	Indicators.OnOtherTrips AS OnOtherTrips,
	Indicators.ToShip AS ToShip,
	Indicators.Issued_1 AS Issued_1
{SELECT
	ReferenceOrder.*,
	Recorder.*,
	Products.*,
	Characteristic.*,
	Series.*,
	RowCode,
	OnCurrentTrip,
	Recipient,
	RecipientPoint,
	Deliver,
	OnOtherTrips,
	ToShip,
	Issued_1}
FROM
	TT_Indicators AS Indicators
{WHERE
	Indicators.ReferenceOrder.*,
	Indicators.Products.*,
	Indicators.Characteristic.*,
	Indicators.Series.*,
	Indicators.RowCode}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
