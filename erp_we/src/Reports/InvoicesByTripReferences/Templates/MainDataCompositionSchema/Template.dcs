		<dataPath>PointPoint</dataPath>
		<expression>JoinStrings(PointPoint)</expression>
		<group>Products</group>
		<group>Recorder</group>
		<group>Series</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>OnCurrentTrip</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(OnCurrentTrip)
End</expression>
		<group>Products</group>
		<group>ReferenceOrder</group>
		<group>Recorder</group>
		<group>Series</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>OnOtherTrips</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(OnOtherTrips)
End</expression>
		<group>Products</group>
		<group>ReferenceOrder</group>
		<group>Recorder</group>
		<group>Series</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Deliver</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(Deliver)
End</expression>
		<group>Products</group>
		<group>ReferenceOrder</group>
		<group>Recorder</group>
		<group>Series</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>ToShip</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(ToShip)
End</expression>
		<group>Products</group>
		<group>ReferenceOrder</group>
		<group>Recorder</group>
		<group>Series</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Issued_1</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(Issued_1)
End</expression>
		<group>Products</group>
		<group>ReferenceOrder</group>
		<group>Recorder</group>
		<group>Series</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>ToRegister</dataPath>
		<expression>Case
	When Count(Distinct Products.UnitOfMeasure) &gt; 1 Then 0
	Else Sum(ToShip) - Sum(Issued_1)
End</expression>
		<group>Products</group>
		<group>ReferenceOrder</group>
		<group>Recorder</group>
		<group>Series</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>ToRegister</dataPath>
		<expression>Sum(ToRegister)</expression>
	</totalField>
