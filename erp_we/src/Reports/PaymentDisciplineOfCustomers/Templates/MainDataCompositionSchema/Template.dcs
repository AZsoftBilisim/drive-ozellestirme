			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MaxWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>ProportionOfOverdueDebt</dataPath>
		<expression>Case When CustomerAccountsReceivable &lt;&gt; 0 Then OverdueCustomerDebt / CustomerAccountsReceivable * 100 Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Total receivables (overdue), %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>کل دریافتنی‌ها (سررسیدگذشته)، درصد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Debito del cliente (ritardo), %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Zadłużenie klienta (przeterminowane), %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Долг клиента (просрочено), %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Müşteri borcu (vadesi geçmiş), %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Phải thu (quá hạn), %</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>TextColor</dcscor:parameter>
				<dcscor:value xmlns:d5p1="http://v8.1c.ru/8.1/data/ui/style" xsi:type="v8ui:Color">d5p1:OverdueDataColor</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>ND=10; NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>ND=10; NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>HN=10; HDH=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>ЧЦ (ND) = 0; ЧДЦ (NFD)=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ND=10; NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>ND=10; NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>ND=10; NFD=0</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MaxWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<totalField>
		<dataPath>AverageDelayTime</dataPath>
		<expression>Sum(AverageDelayTime)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOrders</dataPath>
		<expression>Count(Distinct SalesOrder)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfOrdersInArrears</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Max(NumberOfOrdersInArrears)", "SalesOrder"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfOverdueOrders</dataPath>
		<expression>Case When Count(Distinct SalesOrder) &lt;&gt; 0 Then Sum(EvalExpressionWithGroupArray("Max(NumberOfOrdersInArrears)", "SalesOrder")) / Count(Distinct SalesOrder) * 100 Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>CustomerAccountsReceivable</dataPath>
		<expression>Sum(CustomerAccountsReceivable)</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueCustomerDebt</dataPath>
		<expression>Sum(OverdueCustomerDebt)</expression>
	</totalField>
	<totalField>
		<dataPath>ProportionOfOverdueDebt</dataPath>
		<expression>Case When Sum(CustomerAccountsReceivable) &lt;&gt; 0 Then Sum(OverdueCustomerDebt) / Sum(CustomerAccountsReceivable) * 100 Else 0 End</expression>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
