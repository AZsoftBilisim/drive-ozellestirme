		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RMActivities.Ref AS RMActivity,
	RMOrder.Asset AS Asset,
	RMOrder.Ref AS RMOrder,
	RMOrder.Status AS Status,
	CASE
		WHEN RMOrder.Status = VALUE(Enum.RMOrderStatuses.Closed)
			THEN 100
		ELSE 0
	END AS ProgressPercent,
	RMOrder.StartDate AS StartDate,
	RMOrder.CompletedOn AS CompletedOn,
	DATEDIFF(RMOrder.StartDate, RMOrder.CompletedOn, DAY) + 1 AS Duration,
	RMOrder.EmployeeResponsible AS EmployeeResponsible,
	RMOrder.Department AS Department,
	RMOrder.Asset.OperatingBusinessUnit AS OperatingUnitOfRepairFacility,
	RMOrder.Asset.RMBusinessUnit AS RepairUnitOfRepairObject,
	CASE
		WHEN RMOrder.Status IN (VALUE(Enum.RMOrderStatuses.Running), VALUE(Enum.RMOrderStatuses.Closed))
			THEN RMOrder.StartDateActual
		ELSE DATETIME(1, 1, 1, 0, 0, 0)
	END AS ActualStartDate,
	CASE
		WHEN RMOrder.Status = VALUE(Enum.RMOrderStatuses.Closed)
			THEN RMOrder.ActualCompletionDate
		ELSE DATETIME(1, 1, 1, 0, 0, 0)
	END AS ActualEndDate,
	CASE
		WHEN RMOrder.Status = VALUE(Enum.RMOrderStatuses.Closed)
			THEN DATEDIFF(RMOrder.StartDateActual, RMOrder.ActualCompletionDate, DAY) + 1
		ELSE 0
	END AS ActualDuration
FROM
	InformationRegister.RMPlan AS RMPlan
		LEFT JOIN Document.RMOrder AS RMOrder
			LEFT JOIN Catalog.RMActivities AS RMActivities
			ON RMOrder.RMActivity = RMActivities.Ref
		ON RMPlan.Recorder = RMOrder.Ref</query>
	</dataSet>
	<calculatedField>
		<dataPath>OverdueDaysFromStart</dataPath>
		<expression>Case When ValueIsFilled(ActualStartDate) Then
DateDiff(StartDate, ActualStartDate, "Day")
Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
