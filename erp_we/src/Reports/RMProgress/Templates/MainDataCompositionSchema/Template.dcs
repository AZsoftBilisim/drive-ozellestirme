	<totalField>
		<dataPath>CompletedOn</dataPath>
		<expression>Max(CompletedOn)</expression>
	</totalField>
	<totalField>
		<dataPath>StartDate</dataPath>
		<expression>Min(StartDate)</expression>
	</totalField>
	<totalField>
		<dataPath>Duration</dataPath>
		<expression>Max(Duration)</expression>
	</totalField>
	<totalField>
		<dataPath>Status</dataPath>
		<expression>Max(Status)</expression>
	</totalField>
	<totalField>
		<dataPath>ProgressPercent</dataPath>
		<expression>Format(Sum(ProgressPercent)/Count(ProgressPercent), "ND=5; NFD=2; NZ=0,00")</expression>
	</totalField>
	<totalField>
		<dataPath>ActualStartDate</dataPath>
		<expression>Min(ActualStartDate)</expression>
	</totalField>
	<totalField>
		<dataPath>ActualEndDate</dataPath>
		<expression>Max(ActualEndDate)</expression>
	</totalField>
	<totalField>
		<dataPath>ActualDuration</dataPath>
		<expression>Case When Min(ProgressPercent) = 100 Then DateDiff(Min(ActualStartDate), Max(ActualEndDate), "Day") Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueDaysFromStart</dataPath>
		<expression>Case When Min(ProgressPercent) = 100 Then  Max(OverdueDaysFromStart) Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueDaysUponCompletion</dataPath>
		<expression>Case When Min(ProgressPercent) = 100 Then  Max(OverdueDaysUponCompletion) Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>Status</dataPath>
		<expression>Format(Sum(ProgressPercent)/Count(ProgressPercent), "ND=5; NFD=2; NZ=0,00")</expression>
		<group>Overall</group>
	</totalField>
