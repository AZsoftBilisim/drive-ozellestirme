					<tl>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Distribution of customers by segments for repeated sales</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>توزیع مشتریان بر اساس بخش‌ها برای فروش‌های تکراری</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Distribuzione dei clienti per segmenti per la pubblicazione delle vendite ripetute</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>Podział klientów wg segmentów w celu przeprowadzenia powtórnych sprzedaż</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Распределение клиентов по сегментам для проведения повторных продаж</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
