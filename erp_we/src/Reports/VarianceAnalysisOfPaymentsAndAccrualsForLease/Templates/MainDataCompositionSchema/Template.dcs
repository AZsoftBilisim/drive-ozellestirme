				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	"Payments" AS RowType,
	BEGINOFPERIOD(LeasePayments.Period, DAY) AS Period,
	LeasePayments.Recorder AS Recorder,
	LeasePayments.Contract AS Contract,
	LeasePayments.AmountType AS AmountType,
	YEAR(LeasePayments.Period) AS YearNumber,
	BEGINOFPERIOD(LeasePayments.Period, MONTH) AS MonthName,
	CASE
		WHEN LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.RentalService)
				OR LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.RentalServicePrepayment)
			THEN LeasePayments.Sum
		ELSE 0
	END AS RentalServicePaymentFact,
	CASE
		WHEN LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.DepositPayment)
			THEN LeasePayments.Sum
		ELSE 0
	END AS SecurityPaymentPaymentFact,
	CASE
		WHEN LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.BuyoutValue)
				OR LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.BuyoutValuePrepayment)
			THEN LeasePayments.Sum
		ELSE 0
	END AS RedemptionValuePaymentFact,
	0 AS RentalServiceAccrualFact,
	0 AS SecurityPaymentAccrualFact,
	0 AS RedemptionValueAccrualFact,
	0 AS InterestAccrualFact
FROM
	AccumulationRegister.FinancialInstrumentsARAP AS LeasePayments
WHERE
	LeasePayments.ScheduleType = VALUE(Enum.FinancialInstrumentScheduleTypes.Payments)
	AND LeasePayments.Contract REFS Catalog.LeaseContract

UNION ALL

SELECT
	"Accruals",
	BEGINOFPERIOD(LeasePayments.Period, DAY),
	LeasePayments.Recorder,
	LeasePayments.Contract,
	LeasePayments.AmountType,
	YEAR(LeasePayments.Period),
	BEGINOFPERIOD(LeasePayments.Period, MONTH),
	0,
	0,
	0,
	CASE
		WHEN LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.RentalService)
				OR LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.RentalServicePrepayment)
				OR LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.VAT)
					AND LeasePayments.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.AccrualOfVATInPartOfLeaseService)
			THEN LeasePayments.Sum
		ELSE 0
	END,
	CASE
		WHEN LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.DepositPayment)
				OR LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.VAT)
					AND LeasePayments.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.AccrualOfVATInPartOfSecurityPayment)
			THEN LeasePayments.Sum
		ELSE 0
	END,
	CASE
		WHEN LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.BuyoutValue)
				OR LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.BuyoutValuePrepayment)
				OR LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.VAT)
					AND LeasePayments.BusinessTransactionSetting = VALUE(Catalog.BusinessTransactionsSettings.AccrualOfVATInPartOfBuyoutValue)
			THEN LeasePayments.Sum
		ELSE 0
	END,
	CASE
		WHEN LeasePayments.AmountType = VALUE(Enum.TypesOfLeasePayments.Interests)
			THEN LeasePayments.Sum
		ELSE 0
	END
FROM
	AccumulationRegister.FinancialInstrumentsARAP AS LeasePayments
WHERE
	LeasePayments.ScheduleType = VALUE(Enum.FinancialInstrumentScheduleTypes.Accruals)
	AND LeasePayments.Contract REFS Catalog.LeaseContract</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>RentalService.PaymentDeviation</dataPath>
		<expression>Case When Period &gt; CurrentDate() Then 0 Else  IsNull(RentalService.PaymentFact, 0) - IsNull(RentalService.PaymentPlan, 0) End</expression>
		<title xsi:type="v8:LocalStringType">
