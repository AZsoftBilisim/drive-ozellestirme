			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	TermsOfLeaseContracts.EffectiveContractTerms AS EffectiveContractTerms,
	TermsOfLeaseContracts.Contract AS Contract,
	TermsOfLeaseContracts.Period AS Period,
	TermsOfLeaseContracts.State AS State
INTO TermsOfLeaseContracts
FROM
	InformationRegister.TermsOfLeaseContracts.SliceLast AS TermsOfLeaseContracts

INDEX BY
	EffectiveContractTerms,
	Contract
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	TermsOfLeaseContracts.EffectiveContractTerms AS EffectiveContractTerms,
	TermsOfLeaseContracts.Contract AS Contract,
	TermsOfLeaseContracts.Period AS Period
INTO TermsOfLeaseContractsAreNotValid
FROM
	TermsOfLeaseContracts AS TermsOfLeaseContracts
WHERE
	TermsOfLeaseContracts.State = VALUE(Enum.CounterpartyContractStates.Closed)

INDEX BY
	EffectiveContractTerms,
	Contract
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	"Payments" AS RowType,
	PaymentSchedule.Date AS Period,
	PaymentSchedule.Contract AS Contract,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Payments) AS ScheduleType,
	YEAR(PaymentSchedule.Date) AS YearNumber,
	BEGINOFPERIOD(PaymentSchedule.Date, MONTH) AS MonthName,
	PaymentSchedule.RentalService AS RentalServicePaymentPlan,
	PaymentSchedule.DepositPayment AS SecurityPaymentPaymentPlan,
	PaymentSchedule.BuyoutValue + PaymentSchedule.BuyoutValuePrepayment AS RedemptionValuePaymentPlan,
	0 AS RentalServiceAccrualPlan,
	0 AS SecurityPaymentAccrualPlan,
	0 AS RedemptionValueAccrualPlan,
	0 AS InterestAccrualPlan
FROM
	InformationRegister.LeaseServicesPaymentSchedule AS PaymentSchedule
		LEFT JOIN TermsOfLeaseContractsAreNotValid AS TermsOfLeaseContractsAreNotValid
		ON PaymentSchedule.EffectiveContractTerms = TermsOfLeaseContractsAreNotValid.EffectiveContractTerms
		AND PaymentSchedule.Contract = TermsOfLeaseContractsAreNotValid.Contract
WHERE
	PaymentSchedule.Active
	AND (PaymentSchedule.EffectiveContractTerms, PaymentSchedule.Contract) IN
		(SELECT
			T.EffectiveContractTerms,
			T.Contract
		FROM
			TermsOfLeaseContracts AS T)
	AND PaymentSchedule.Date &lt;= ISNULL(TermsOfLeaseContractsAreNotValid.Period, DATETIME(3999, 12, 31, 23, 59, 59))

UNION ALL

SELECT
	"Accruals",
	ScheduleOfAccruals.Date,
	ScheduleOfAccruals.Contract,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Accruals),
	YEAR(ScheduleOfAccruals.Date),
	BEGINOFPERIOD(ScheduleOfAccruals.Date, MONTH),
	0,
	0,
	0,
	ScheduleOfAccruals.RentalService,
	ScheduleOfAccruals.DepositPayment,
	ScheduleOfAccruals.BuyoutValue,
	0
FROM
	InformationRegister.LeaseServicesAccrualSchedule AS ScheduleOfAccruals
		LEFT JOIN TermsOfLeaseContractsAreNotValid AS TermsOfLeaseContractsAreNotValid
		ON ScheduleOfAccruals.EffectiveContractTerms = TermsOfLeaseContractsAreNotValid.EffectiveContractTerms
		AND ScheduleOfAccruals.Contract = TermsOfLeaseContractsAreNotValid.Contract
WHERE
	ScheduleOfAccruals.Active
	AND (ScheduleOfAccruals.EffectiveContractTerms, ScheduleOfAccruals.Contract) IN
		(SELECT
			T.EffectiveContractTerms,
			T.Contract
		FROM
			TermsOfLeaseContracts AS T)
	AND ScheduleOfAccruals.Date &lt;= ISNULL(TermsOfLeaseContractsAreNotValid.Period, DATETIME(3999, 12, 31, 23, 59, 59))

UNION ALL

SELECT
	"Accruals",
	ScheduleOfAccruals.Date,
	ScheduleOfAccruals.Contract,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Accruals),
	YEAR(ScheduleOfAccruals.Date),
	BEGINOFPERIOD(ScheduleOfAccruals.Date, MONTH),
	0,
	0,
	0,
	0,
	0,
	0,
	ScheduleOfAccruals.Interests
FROM
	InformationRegister.LeaseInterestAccrualSchedule AS ScheduleOfAccruals
		LEFT JOIN TermsOfLeaseContractsAreNotValid AS TermsOfLeaseContractsAreNotValid
		ON ScheduleOfAccruals.EffectiveContractTerms = TermsOfLeaseContractsAreNotValid.EffectiveContractTerms
		AND ScheduleOfAccruals.Contract = TermsOfLeaseContractsAreNotValid.Contract
WHERE
	ScheduleOfAccruals.Active
	AND (ScheduleOfAccruals.EffectiveContractTerms, ScheduleOfAccruals.Contract) IN
		(SELECT
			T.EffectiveContractTerms,
			T.Contract
		FROM
			TermsOfLeaseContracts AS T)
	AND ScheduleOfAccruals.Date &lt;= ISNULL(TermsOfLeaseContractsAreNotValid.Period, DATETIME(3999, 12, 31, 23, 59, 59))</query>
		</item>
