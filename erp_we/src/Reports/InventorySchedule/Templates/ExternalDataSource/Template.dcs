		<dataSource>DataSource1</dataSource>
		<query>////////////////////////////////////////////////////////
// Selection by segments.
SELECT ALLOWED DISTINCT
	Segments.Products,
	Segments.Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}
;

////////////////////////////////////////////////////////
// Inventory and needs.
SELECT ALLOWED
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.OrderDocument AS OrderDocument,
	Table.EventDate AS EventDate,
	Table.OrderedBalance AS Ordered,
	Table.Received_1Balance AS Received_1,
	Table.LockedReceiptBalance AS LockedReceipt,
	Table.ToUnlockBalance AS ToUnlock,
	Table.ReserveAtWarehouseBalance
		+ Table.ReserveAsReceivedBalance
		+ Table.SnoozeReservationBalance
		+ Table.ToSupplyBalance AS Demand
INTO InventoryAndDemands
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		Warehouse REFS Catalog.Warehouses
			{(Products, Characteristic) IN(
				SELECT
					FilterTable.Products AS Products,
					FilterTable.Characteristic AS Characteristic
				FROM
					SelectionByProductSegment AS FilterTable
				WHERE
					FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			{Products.* AS Products,
				Characteristic.* AS Characteristic,
				Warehouse.* AS Warehouse,
				Purpose.* AS Purpose}
			{EventDate &lt; &amp;CurrentDate OR EventDate &lt;= ENDOFPERIOD(&amp;EndDate, DAY)}) AS Table
;

////////////////////////////////////////////////////////
// Inventory and needs, the Balance is blocked.
SELECT ALLOWED
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.InStockBalance AS InStock,
	Table.LockedInStockBalance AS LockedInStock
INTO InventoryAndAvailabilityRequirements
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		Warehouse REFS Catalog.Warehouses
			{(Products, Characteristic) IN(
				SELECT
					FilterTable.Products AS Products,
					FilterTable.Characteristic AS Characteristic
				FROM
					SelectionByProductSegment AS FilterTable
				WHERE
					FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
			{Products.* AS Products,
				Characteristic.* AS Characteristic,
				Warehouse.* AS Warehouse,
				Purpose.* AS Purpose}
			{EventDate &lt; &amp;CurrentDate OR EventDate &lt;= ENDOFPERIOD(&amp;EndDate, DAY)}) AS Table
;

////////////////////////////////////////////////////////
// Inventory distribution.
SELECT ALLOWED
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.InventoryState AS InventoryState,
	Table.DemandCharacteristic AS DemandCharacteristic,
	Table.ShipmentOrder AS ShipmentOrder,
	Table.RequestShipmentOn AS RequestShipmentOn,
	Table.DateOfReceipt AS DateOfReceipt,
	Table.AvailabilityDate AS AvailabilityDate,
	Table.Count AS Count
INTO InventoryAllocation
FROM
	InformationRegister.InventoryAllocation AS Table
		{INNER JOIN SelectionByProductSegment AS FilterTable
		ON FilterTable.Products   = Table.Products
		 AND FilterTable.Characteristic = Table.Characteristic}
WHERE
	&amp;DisplayShipmentsOnCollateralDate
		AND Table.Warehouse REFS Catalog.Warehouses
		AND Table.DemandCharacteristic IN(
			VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
			VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
			VALUE(Enum.DemandCharacteristics.SnoozeReservation),
			VALUE(Enum.DemandCharacteristics.ToSupply))

UNION ALL

SELECT
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.InventoryState AS InventoryState,
	Table.DemandCharacteristic AS DemandCharacteristic,
	Table.ShipmentOrder AS ShipmentOrder,
	Table.RequestShipmentOn AS RequestShipmentOn,
	Table.DateOfReceipt AS DateOfReceipt,
	Table.AvailabilityDate AS AvailabilityDate,
	Table.Count AS Count
FROM
	InformationRegister.InventoryAllocation AS Table
		{INNER JOIN SelectionByProductSegment AS FilterTable
		ON FilterTable.Products   = Table.Products
		 AND FilterTable.Characteristic = Table.Characteristic}
WHERE
	Table.Warehouse REFS Catalog.Warehouses
		AND Table.DemandCharacteristic IN(
			VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked),
			VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked))

{WHERE
	FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed}
{WHERE
	Table.InventoryState IN(
			VALUE(Enum.InventoryStates.NotProvided),
			VALUE(Enum.InventoryStates.PendingSupplyApproval))
		OR Table.RequestShipmentOn &lt; &amp;CurrentDate AND Table.DateOfReceipt &lt; &amp;CurrentDate
		OR Table.RequestShipmentOn &lt; ENDOFPERIOD(&amp;EndDate, DAY) AND Table.DateOfReceipt &lt; ENDOFPERIOD(&amp;EndDate, DAY)}
{WHERE
	Table.Products.* AS Products,
	Table.Characteristic.* AS Characteristic,
	Table.Warehouse.* AS Warehouse,
	Table.Purpose.* AS Purpose}
;

////////////////////////////////////////////////////////
// A temp table of the planned access and loading of the dynamic structure of the order.
SELECT ALLOWED
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.ProductionOrder AS ProductionOrder,
	Table.KeyProducts AS KeyProducts,
	MAX(
		CASE
			WHEN Table.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
				THEN ISNULL(BEGINOFPERIOD(ScheduleDates.Begin, DAY), Table.ProductionOrder.EarliestStartDate)
			ELSE DATETIME(1, 1, 1)
		END) AS StartDateOfStage,
	CASE
		WHEN Table.LineKind IN(
				VALUE(Enum.KindsOfProductionOrderStructureLines.AvailableRelease),
				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
				VALUE(Enum.KindsOfProductionOrderStructureLines.Move))
			THEN ISNULL(BEGINOFPERIOD(ScheduleDates.Ending, DAY), DATETIME(1, 1, 1))
		ELSE NULL
	END AS EndDateOfStage,
	
	// Filled in for Enumeration only.Types of structstryzakazanaproduction.Reserved
	Table.ReceiptOrder AS ReceiptOrder,
	Table.DateOfReceipt AS DateOfReceipt,
	
	SUM(Table.Scheduled) AS Scheduled,
	SUM(Table.ToSupply - Table.Replaced) AS ToSupply,
	SUM(Table.AllocatedFromAvailableInventory + Table.AllocatedFromAvailableInventoryWithAssignment) AS AllocatedFromAvailableInventory,
	SUM(Table.AllocatedInFreeProductionLots + Table.AllocatedInAssignedProductionLots) AS AllocatedInFreeProductionLots
	
INTO PlannedReceiptsAndShipmentsOfDynamicOrderStructure
FROM
	InformationRegister.OrderStructure AS Table
		
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleDates
		ON Table.ProductionOrder = ScheduleDates.ProductionOrder
		 AND ScheduleDates.ScheduleStatus = 0
		 AND Table.Stage = ScheduleDates.Stage
		 AND Table.KeyLot = ScheduleDates.KeyLot
		
		{INNER JOIN SelectionByProductSegment AS FilterTable
		ON FilterTable.Products   = Table.Products
		 AND FilterTable.Characteristic = Table.Characteristic}
WHERE
	Table.Warehouse REFS Catalog.Warehouses
	AND Table.LineKind IN(
		// VALUE(Enumeration.Types of structstryzakazanaproduction.Products) - we do not take this Receipt, since it is a Receipt for a production Order, which is in the distribution of inventory
		// VALUE(Enumeration.Types of structstryzakazanaproduction.Production of products) - we do not take this Receipt, so it is a Receipt by Stage, which is in the distribution of inventory
		
		// The expected Receipt of the semi-finished din is planned. But he's the Dean provided for it. By Receipt, part of the need
		// is distributed among the parties... The part of the din demand provided by the surplus from the inventory distribution. stages and din. movements, if this surplus is Receipt by din. stage
		VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
		
		// Co-provision - Replaced. All the need for dean. stages and din. movements.
		VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption),
		
		// The expected Receipt of the semi-finished din. transfer is planned.
		VALUE(Enum.KindsOfProductionOrderStructureLines.Move),
		
		// Distributed inventory... The part of the din demand provided by the surplus from the distribution of inventory. stages and din. movements, if this surplus is not a Receipt by din. stage.
		VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved),
		
		// Planned.
		VALUE(Enum.KindsOfProductionOrderStructureLines.AvailableRelease))
		
		// VALUE(Enumeration.Types of structstryzakazanaproduction.Running) - has nothing to do with providing
		// VALUE(Enumeration.Types of structstryzakazanaproduction.Disassembly)
		// VALUE(Enumeration.Types of structstryzakazanaproduction.Closed) - has nothing to do with providing
{WHERE
	FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed}
{WHERE
	Table.Products.* AS Products,
	Table.Characteristic.* AS Characteristic,
	Table.Warehouse.* AS Warehouse,
	Table.Purpose.* AS Purpose}
GROUP BY
	Table.Products,
	Table.Characteristic,
	Table.Warehouse,
	Table.Purpose,
	Table.ProductionOrder,
	Table.KeyProducts,
	CASE
		WHEN Table.LineKind IN(
				VALUE(Enum.KindsOfProductionOrderStructureLines.AvailableRelease),
				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
				VALUE(Enum.KindsOfProductionOrderStructureLines.Move))
			THEN ISNULL(BEGINOFPERIOD(ScheduleDates.Ending, DAY), DATETIME(1, 1, 1))
		ELSE NULL
	END,
	Table.ReceiptOrder,
	Table.DateOfReceipt
HAVING
	SUM(Table.Scheduled) &gt; 0
		OR SUM(Table.ToSupply - Table.Replaced) &gt; 0
		OR SUM(Table.AllocatedFromAvailableInventory + Table.AllocatedFromAvailableInventoryWithAssignment) &gt; 0
		OR SUM(Table.AllocatedInFreeProductionLots + Table.AllocatedInAssignedProductionLots) &gt; 0
INDEX BY
	Products, Characteristic, Warehouse, Purpose, ProductionOrder, KeyProducts, ReceiptOrder, DateOfReceipt, ToSupply
;


////////////////////////////////////////////////////////
// A temporary table of planned receipts and shipments.
SELECT
	Set.GroupOfPeriods AS GroupOfPeriods,
	Set.Products AS Products,
	Set.Characteristic AS Characteristic,
	Set.Warehouse AS Warehouse,
	Set.Purpose AS Purpose,
	Set.Recorder AS Recorder,
	Set.Period AS Period,
	SUM(Set.CountReceipt) AS CountReceipt,
	SUM(Set.CountExpense) AS CountExpense,
	SUM(Set.FollowUpReceipt) AS FollowUpReceipt,
	SUM(Set.FollowUpExpense) AS FollowUpExpense
INTO ArrivalAndExpenditure
FROM(
	
	
	// Planned receipts according to the dynamic structure of the production order.
	SELECT
		CASE
			WHEN Table.EndDateOfStage &lt; &amp;CurrentDate
				THEN 0
			ELSE 1
		END AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.ProductionOrder AS Recorder,
		CASE
			WHEN Table.EndDateOfStage &lt; &amp;CurrentDate THEN
				DATETIME(1, 1, 1)
			ELSE Table.EndDateOfStage
		END AS Period,
		Table.Scheduled AS CountReceipt,
		0 AS CountExpense,
		0 AS FollowUpReceipt,
		0 AS FollowUpExpense
	FROM
		PlannedReceiptsAndShipmentsOfDynamicOrderStructure AS Table
	WHERE
		Table.Scheduled &gt; 0
	{WHERE
		Table.EndDateOfStage &lt; &amp;CurrentDate
			OR Table.EndDateOfStage &lt;= ENDOFPERIOD(&amp;EndDate, DAY)}
	
	UNION ALL
	
	// The needs of the dynamic structure of the production order, displayed on the date of shipment.
	SELECT
		CASE
			WHEN &amp;DisplayShipmentsOnCollateralDate
				THEN 2
			WHEN Table.StartDateOfStage &lt; &amp;CurrentDate
				THEN 0
			ELSE 1
		END AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.ProductionOrder AS Recorder,
		CASE
			WHEN &amp;DisplayShipmentsOnCollateralDate
				THEN DATETIME(1, 1, 1)
			WHEN Table.StartDateOfStage &lt; &amp;CurrentDate THEN
				DATETIME(1, 1, 1)
			ELSE Table.StartDateOfStage
		END AS Period,
		0 AS CountReceipt,
		Table.ToSupply AS CountExpense,
		0 AS FollowUpReceipt,
		0 AS FollowUpExpense
	FROM
		PlannedReceiptsAndShipmentsOfDynamicOrderStructure AS Table
	WHERE
		Table.ToSupply &gt; 0
	{WHERE
		Table.StartDateOfStage &lt; &amp;CurrentDate
			OR Table.StartDateOfStage &lt;= ENDOFPERIOD(&amp;EndDate, DAY)}
	
	UNION ALL
	
	// Storno the needs of the dynamic structure of the production order, displayed on the date of shipment.
	SELECT
		2 AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.ProductionOrder AS Recorder,
		DATETIME(1 ,1, 1) AS Period,
		0 AS CountReceipt,
		- (Table.AllocatedFromAvailableInventory + Table.AllocatedInFreeProductionLots + Table.Scheduled) AS CountExpense,
		0 AS FollowUpReceipt,
		0 AS FollowUpExpense
	FROM
		PlannedReceiptsAndShipmentsOfDynamicOrderStructure AS Table
			
			INNER JOIN PlannedReceiptsAndShipmentsOfDynamicOrderStructure AS Demand
			ON Demand.Products = Table.Products
			 AND Demand.Characteristic = Table.Characteristic
			 AND Demand.Warehouse = Table.Warehouse
			 AND Demand.Purpose = Table.Purpose
			 AND Demand.ProductionOrder = Table.ProductionOrder
			 AND Demand.KeyProducts = Table.KeyProducts
			 AND Demand.ReceiptOrder = UNDEFINED
			 AND Demand.DateOfReceipt = UNDEFINED
			 AND Demand.ToSupply &gt; 0
	WHERE
		&amp;DisplayShipmentsOnCollateralDate
			AND (Table.AllocatedFromAvailableInventory &gt; 0 OR Table.AllocatedInFreeProductionLots &gt; 0 OR Table.Scheduled &gt; 0)
	{WHERE
		Demand.StartDateOfStage &lt; &amp;CurrentDate
			OR Demand.StartDateOfStage &lt; ENDOFPERIOD(&amp;EndDate, DAY)}
	
	UNION ALL
	
	// The needs of the dynamic order structure for production, displayed on the date of provision.
	SELECT
		CASE
			WHEN Demand.StartDateOfStage &lt; &amp;CurrentDate AND ISNULL(Table.EndDateOfStage, Table.DateOfReceipt) &lt; &amp;CurrentDate
				THEN 0
			ELSE 1
		END AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		CASE
			WHEN Table.ReceiptOrder &lt;&gt; UNDEFINED
				THEN Table.ReceiptOrder
			ELSE Table.ProductionOrder
		END AS Recorder,
		CASE
			WHEN Demand.StartDateOfStage &lt; &amp;CurrentDate AND ISNULL(Table.EndDateOfStage, Table.DateOfReceipt) &lt; &amp;CurrentDate
				THEN DATETIME(1 ,1, 1)
			WHEN Demand.StartDateOfStage &lt; ISNULL(Table.EndDateOfStage, Table.DateOfReceipt)
				THEN ISNULL(Table.EndDateOfStage, Table.DateOfReceipt)
			ELSE Demand.StartDateOfStage
		END AS Period,
		0 AS CountReceipt,
		Table.AllocatedFromAvailableInventory + Table.AllocatedInFreeProductionLots + Table.Scheduled AS CountExpense,
		0 AS FollowUpReceipt,
		0 AS FollowUpExpense
	FROM
		PlannedReceiptsAndShipmentsOfDynamicOrderStructure AS Table
			
			INNER JOIN PlannedReceiptsAndShipmentsOfDynamicOrderStructure AS Demand
			ON Demand.Products = Table.Products
			 AND Demand.Characteristic = Table.Characteristic
			 AND Demand.Warehouse = Table.Warehouse
			 AND Demand.Purpose = Table.Purpose
			 AND Demand.ProductionOrder = Table.ProductionOrder
			 AND Demand.KeyProducts = Table.KeyProducts
			 AND Demand.ReceiptOrder = UNDEFINED
			 AND Demand.DateOfReceipt = UNDEFINED
			 AND Demand.ToSupply &gt; 0
	WHERE
		&amp;DisplayShipmentsOnCollateralDate
			AND (Table.AllocatedFromAvailableInventory &gt; 0 OR Table.AllocatedInFreeProductionLots &gt; 0 OR Table.Scheduled &gt; 0)
	{WHERE
		Demand.StartDateOfStage &lt; &amp;CurrentDate AND ISNULL(Table.EndDateOfStage, Table.DateOfReceipt) &lt; &amp;CurrentDate
			OR Demand.StartDateOfStage &lt; ENDOFPERIOD(&amp;EndDate, DAY) AND ISNULL(Table.EndDateOfStage, Table.DateOfReceipt) &lt; ENDOFPERIOD(&amp;EndDate, DAY)}
	
	UNION ALL
	
	
	// Unconfirmed planned receipts.
	SELECT
		2 AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.OrderDocument AS Recorder,
		DATETIME(1, 1, 1) AS Period,
		Table.Ordered - Table.Received_1 AS CountReceipt,
		0 AS CountExpense,
		0 AS FollowUpReceipt,
		0 AS FollowUpExpense
	FROM
		InventoryAndDemands AS Table
	WHERE
		Table.Ordered - Table.Received_1 &gt; 0
	
	UNION ALL
	
	// Confirmed planned receipts, including overdue ones.
	SELECT
		CASE
			WHEN Table.EventDate &lt; &amp;CurrentDate
				THEN 0
			ELSE 1
		END AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.OrderDocument AS Recorder,
		CASE
			WHEN Table.EventDate &lt; &amp;CurrentDate
				THEN DATETIME(1, 1, 1)
			ELSE Table.EventDate
		END AS Period,
		Table.Received_1 - Table.LockedReceipt + Table.ToUnlock AS CountReceipt,
		0 AS CountExpense,
		Table.LockedReceipt AS FollowUpReceipt,
		Table.ToUnlock AS FollowUpExpense
	FROM
		InventoryAndDemands AS Table
	WHERE
		Table.Received_1 &gt; 0 OR Table.LockedReceipt &gt; 0 OR Table.ToUnlock &gt; 0
	
	UNION ALL
	
	// Requirements according to the online register, displayed on the date of shipment.
	SELECT
		CASE
			WHEN Table.EventDate &lt; &amp;CurrentDate
				THEN 0
			ELSE 1
		END AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.OrderDocument AS Recorder,
		CASE
			WHEN Table.EventDate &lt; &amp;CurrentDate
				THEN DATETIME(1, 1, 1)
			ELSE Table.EventDate
		END AS Period,
		0 AS CountReceipt,
		Table.Demand AS CountExpense,
		0 AS FollowUpReceipt,
		0 AS FollowUpExpense
	FROM
		InventoryAndDemands AS Table
	WHERE
		NOT &amp;DisplayShipmentsOnCollateralDate
			AND Table.Demand &gt; 0
	
	UNION ALL
	
	// Needs according to offline register data, displayed on the date of provision.
	SELECT
		CASE
			WHEN Table.InventoryState IN(
					VALUE(Enum.InventoryStates.NotProvided),
					VALUE(Enum.InventoryStates.PendingSupplyApproval))
				THEN 2
			WHEN Table.RequestShipmentOn &lt; &amp;CurrentDate AND Table.AvailabilityDate &lt; &amp;CurrentDate
				THEN 0
			ELSE 1
		END AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.ShipmentOrder AS Recorder,
		CASE
			WHEN Table.InventoryState IN(
						VALUE(Enum.InventoryStates.NotProvided),
						VALUE(Enum.InventoryStates.PendingSupplyApproval))
					OR Table.RequestShipmentOn &lt; &amp;CurrentDate AND Table.AvailabilityDate &lt; &amp;CurrentDate
				THEN DATETIME(1, 1, 1)
			WHEN Table.RequestShipmentOn &lt; Table.AvailabilityDate
				THEN Table.AvailabilityDate
			ELSE Table.RequestShipmentOn
		END AS Period,
		0 AS CountReceipt,
		Table.Count AS CountExpense,
		0 AS FollowUpReceipt,
		0 AS FollowUpExpense
	FROM
		InventoryAllocation AS Table
	WHERE
		&amp;DisplayShipmentsOnCollateralDate
			AND Table.DemandCharacteristic IN(
				VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
				VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
				VALUE(Enum.DemandCharacteristics.SnoozeReservation),
				VALUE(Enum.DemandCharacteristics.ToSupply))
	
	UNION ALL
	
	// The needs for the blocked goods according to the offline register, displayed on the date of provision as a negative arrival.
	SELECT
		CASE
			WHEN Table.InventoryState IN(
					VALUE(Enum.InventoryStates.NotProvided),
					VALUE(Enum.InventoryStates.PendingSupplyApproval))
				THEN 2
			WHEN Table.RequestShipmentOn &lt; &amp;CurrentDate AND Table.DateOfReceipt &lt; &amp;CurrentDate
				THEN 0
			ELSE 1
		END AS GroupOfPeriods,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.ShipmentOrder AS Recorder,
		CASE
			WHEN Table.InventoryState IN(
						VALUE(Enum.InventoryStates.NotProvided),
						VALUE(Enum.InventoryStates.PendingSupplyApproval))
					OR Table.RequestShipmentOn &lt; &amp;CurrentDate AND Table.DateOfReceipt &lt; &amp;CurrentDate
				THEN DATETIME(1, 1, 1)
			WHEN Table.RequestShipmentOn &lt; Table.DateOfReceipt
				THEN Table.DateOfReceipt
			ELSE Table.RequestShipmentOn
		END AS Period,
		0 AS CountReceipt,
		0 AS CountExpense,
		- Table.Count AS FollowUpReceipt,
		0 AS FollowUpExpense
	FROM
		InventoryAllocation AS Table
	WHERE
		Table.DemandCharacteristic IN(
			VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked),
			VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked))) AS Set
GROUP BY
	Set.GroupOfPeriods,
	Set.Products,
	Set.Characteristic,
	Set.Warehouse,
	Set.Purpose,
	Set.Recorder,
	Set.Period
INDEX BY
	Products, Characteristic, Warehouse, Purpose
;
////////////////////////////////////////////////////////
// The main table for building the report.
SELECT ALLOWED
	Table.GroupOfPeriods AS GroupOfPeriods,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	CAST(Table.Warehouse AS Catalog.Warehouses) AS Warehouse,
	Table.Purpose AS Purpose,
	Table.Recorder AS Recorder,
	Table.Period AS Period,
	ReportOrders.IBDocumentDate AS Date,
	Table.CountReceipt * &amp;RequestTextCoefficientOfOne AS CountReceipt,
	Table.CountReceipt * &amp;QueryTextItemWeight AS QuantityReceiptWeight,
	Table.CountReceipt * &amp;QueryTextTheVolumeOfTheItem AS QuantityReceiptVolume,
	Table.CountExpense * &amp;RequestTextCoefficientOfOne AS CountExpense,
	Table.CountExpense * &amp;QueryTextItemWeight AS QuantityConsumptionWeight,
	Table.CountExpense * &amp;QueryTextTheVolumeOfTheItem AS QuantityConsumptionVolume,
	Table.FollowUpReceipt * &amp;RequestTextCoefficientOfOne AS FollowUpReceipt,
	Table.FollowUpReceipt * &amp;QueryTextItemWeight AS QuantityUnderControlReceiptWeight,
	Table.FollowUpReceipt * &amp;QueryTextTheVolumeOfTheItem AS QuantityUnderControlReceiptVolume,
	Table.FollowUpExpense * &amp;RequestTextCoefficientOfOne AS FollowUpExpense,
	Table.FollowUpExpense * &amp;QueryTextItemWeight AS QuantityUnderControlExpenseWeight,
	Table.FollowUpExpense * &amp;QueryTextTheVolumeOfTheItem AS QuantityUnderControlExpenseVolume,
	ISNULL(WarehouseStockBalance.InStock - WarehouseStockBalance.LockedInStock, 0) * &amp;RequestTextCoefficientOfOne AS OpeningBalance,
	ISNULL(WarehouseStockBalance.InStock - WarehouseStockBalance.LockedInStock, 0) * &amp;QueryTextItemWeight AS StartBalanceWeight,
	ISNULL(WarehouseStockBalance.InStock - WarehouseStockBalance.LockedInStock, 0) * &amp;QueryTextTheVolumeOfTheItem AS StartBalanceVolume,
	ISNULL(WarehouseStockBalance.LockedInStock, 0) * &amp;RequestTextCoefficientOfOne AS OpeningBalanceOnControl,
	ISNULL(WarehouseStockBalance.LockedInStock, 0) * &amp;QueryTextItemWeight AS OpeningBalanceOnControlIsWeight,
	ISNULL(WarehouseStockBalance.LockedInStock, 0) * &amp;QueryTextTheVolumeOfTheItem AS OpeningBalanceOnVolumeControl
INTO TTProductCalendar
FROM
	ArrivalAndExpenditure AS Table
		
		LEFT JOIN InformationRegister.DocumentsRegistry AS ReportOrders
		ON ReportOrders.Ref = Table.Recorder
		AND NOT ReportOrders.AdditionalRecord
		
		LEFT JOIN InventoryAndAvailabilityRequirements AS WarehouseStockBalance
		ON WarehouseStockBalance.Products = Table.Products
		 AND WarehouseStockBalance.Characteristic = Table.Characteristic
		 AND WarehouseStockBalance.Warehouse = Table.Warehouse
		 AND WarehouseStockBalance.Purpose = Table.Purpose

UNION ALL

SELECT
	-1 AS GroupOfPeriods,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	CAST(Table.Warehouse AS Catalog.Warehouses) AS Warehouse,
	Table.Purpose AS Purpose,
	UNDEFINED AS Recorder,
	DATETIME(1, 1, 1) AS Period,
	DATETIME(1, 1, 1) AS Date,
	0 AS CountReceipt,
	0 AS QuantityReceiptWeight,
	0 AS QuantityReceiptVolume,
	0 AS CountExpense,
	0 AS QuantityConsumptionWeight,
	0 AS QuantityConsumptionVolume,
	0 AS FollowUpReceipt,
	0 AS QuantityUnderControlReceiptWeight,
	0 AS QuantityUnderControlReceiptVolume,
	0 AS FollowUpExpense,
	0 AS QuantityUnderControlExpenseWeight,
	0 AS QuantityUnderControlExpenseVolume,
	(Table.InStock - Table.LockedInStock) * &amp;RequestTextCoefficientOfOne AS OpeningBalance,
	(Table.InStock - Table.LockedInStock) * &amp;QueryTextItemWeight AS StartBalanceWeight,
	(Table.InStock - Table.LockedInStock) * &amp;QueryTextTheVolumeOfTheItem AS StartBalanceVolume,
	Table.LockedInStock * &amp;RequestTextCoefficientOfOne AS OpeningBalanceOnControl,
	Table.LockedInStock * &amp;QueryTextItemWeight AS OpeningBalanceOnControlIsWeight,
	Table.LockedInStock * &amp;QueryTextTheVolumeOfTheItem AS OpeningBalanceOnVolumeControl
FROM
	InventoryAndAvailabilityRequirements AS Table
		
		LEFT JOIN ArrivalAndExpenditure AS ThereAreRecords
		ON ThereAreRecords.Products = Table.Products
		 AND ThereAreRecords.Characteristic = Table.Characteristic
		 AND ThereAreRecords.Warehouse = Table.Warehouse
		 AND ThereAreRecords.Purpose = Table.Purpose
WHERE
	Table.InStock &lt;&gt; 0 OR Table.LockedInStock &lt;&gt; 0

INDEX BY
	Products, Characteristic, Warehouse, Purpose
;
////////////////////////////////////////////////////////
SELECT TOP 1
	Table.GroupOfPeriods AS GroupOfPeriods,
	Table.Products AS Products,
