		<expression>Sum(StartBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceWeight</dataPath>
		<expression>Sum(ClosingBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityReceiptVolume</dataPath>
		<expression>Sum(QuantityReceiptVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityConsumptionVolume</dataPath>
		<expression>Sum(QuantityConsumptionVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>StartBalanceVolume</dataPath>
		<expression>Sum(StartBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceVolume</dataPath>
		<expression>Sum(ClosingBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>FollowUpReceipt</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(FollowUpReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityUnderControlReceiptWeight</dataPath>
		<expression>Sum(QuantityUnderControlReceiptWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityUnderControlReceiptVolume</dataPath>
		<expression>Sum(QuantityUnderControlReceiptVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>FollowUpExpense</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(FollowUpExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityUnderControlExpenseWeight</dataPath>
		<expression>Sum(QuantityUnderControlExpenseWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityUnderControlExpenseVolume</dataPath>
		<expression>Sum(QuantityUnderControlExpenseVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>OpeningBalanceOnControl</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(OpeningBalanceOnControl)
End</expression>
	</totalField>
	<totalField>
		<dataPath>OpeningBalanceOnControlIsWeight</dataPath>
		<expression>Sum(OpeningBalanceOnControlIsWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>OpeningBalanceOnVolumeControl</dataPath>
		<expression>Sum(OpeningBalanceOnVolumeControl)</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceIsUnderControl</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(ClosingBalanceIsUnderControl)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceOnControlWeight</dataPath>
