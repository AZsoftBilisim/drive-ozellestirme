		<dataSource>DataSource1</dataSource>
		<query>SELECT TOP 1
	Segments.Segment AS ProductSegment
INTO TTSelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE Segments.Segment.* AS ProductSegment}
;
//////////////////////////////////////////////
SELECT
	AllProducts.Ref                       AS Products,
	
	AllProducts.UnitOfMeasure             AS StorageUnit,
	AllProducts.UnitForReports            AS UnitForReports,
	AllProducts.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight                 AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem               AS ProductsVolume
FROM
	Catalog.Products AS AllProducts</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>MainSet</sourceDataSet>
		<destinationDataSet>CatProducts</destinationDataSet>
		<sourceExpression>Products</sourceExpression>
		<destinationExpression>Products</destinationExpression>
	</dataSetLink>
	<calculatedField>
		<dataPath>Products.ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità di misura</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>J. m.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ед. изм.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ölçü birimi.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị tính</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>OpeningBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(OpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ClosingBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(ClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountExpense</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityReceiptWeight</dataPath>
		<expression>Sum(QuantityReceiptWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityConsumptionWeight</dataPath>
		<expression>Sum(QuantityConsumptionWeight)</expression>
	</totalField>
	<totalField>
