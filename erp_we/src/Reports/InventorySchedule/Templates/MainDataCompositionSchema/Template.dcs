	</totalField>
	<totalField>
		<dataPath>CountReceipt</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountReceipt)
End</expression>
	</totalField>
	<parameter>
		<name>DisplayShipmentsOnCollateralDate</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Shift shipments taking supply into account</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>جابه‌جایی ارسال‌ها با درنظرگرفتن تأمین</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
