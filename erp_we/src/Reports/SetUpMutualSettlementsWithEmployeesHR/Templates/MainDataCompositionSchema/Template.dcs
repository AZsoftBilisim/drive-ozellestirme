		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Turnovers.Organization AS Organization,
	Turnovers.Individual AS Individual,
	CASE
		WHEN Turnovers.SumOpeningBalance &gt;= 0
			THEN Turnovers.SumOpeningBalance
		ELSE 0
	END AS AmountAtBeginningOfPeriodAdvances,
	CASE
		WHEN Turnovers.SumOpeningBalance &lt; 0
			THEN -1 * Turnovers.SumOpeningBalance
		ELSE 0
	END AS AmountDueAtBeginningOfPeriod,
	CASE
		WHEN Turnovers.SumManOpeningBalance &gt;= 0
			THEN Turnovers.SumManOpeningBalance
		ELSE 0
	END AS ManSAmountOpeningBalanceAdvances,
	CASE
		WHEN Turnovers.SumManOpeningBalance &lt; 0
			THEN -1 * Turnovers.SumManOpeningBalance
		ELSE 0
	END AS ManSAmountOpeningBalanceDebt,
	CASE
		WHEN Turnovers.SumComplOpeningBalance &gt;= 0
			THEN Turnovers.SumComplOpeningBalance
		ELSE 0
	END AS LocalOpeningBalanceAmountAdvances,
	CASE
		WHEN Turnovers.SumComplOpeningBalance &lt; 0
			THEN -1 * Turnovers.SumComplOpeningBalance
		ELSE 0
	END AS LocalOpeningBalanceAmountOutstanding,
	Turnovers.SumManOpeningBalance AS SumManOpeningBalance,
	Turnovers.SumComplOpeningBalance AS SumComplOpeningBalance,
	Turnovers.SumClosingBalance AS ClosingAmount,
	Turnovers.SumManClosingBalance AS SumManClosingBalance,
	Turnovers.SumComplClosingBalance AS SumComplClosingBalance,
	Turnovers.SumReceipt AS SumReceipt,
	Turnovers.SumExpense AS SumExpense,
	Turnovers.SumManReceipt AS SumManReceipt,
	Turnovers.SumManExpense AS SumManExpense,
	Turnovers.SumComplReceipt AS SumComplReceipt,
	Turnovers.SumComplExpense AS SumComplExpense,
	CASE
		WHEN Turnovers.SumClosingBalance &gt;= 0
			THEN Turnovers.SumClosingBalance
		ELSE 0
	END AS AmountClosingBalanceAdvances,
	CASE
		WHEN Turnovers.SumClosingBalance &lt; 0
			THEN -1 * Turnovers.SumClosingBalance
		ELSE 0
	END AS AmountOfClosingBalanceOutstanding,
	CASE
		WHEN Turnovers.SumManClosingBalance &gt;= 0
			THEN Turnovers.SumManClosingBalance
		ELSE 0
	END AS ManSAmountClosingBalanceAdvances,
	CASE
		WHEN Turnovers.SumManClosingBalance &lt; 0
			THEN -1 * Turnovers.SumManClosingBalance
		ELSE 0
	END AS AmountOfManSClosingBalanceIsDebt,
	CASE
		WHEN Turnovers.SumComplClosingBalance &gt;= 0
			THEN Turnovers.SumComplClosingBalance
		ELSE 0
	END AS LocalClosingBalanceAmountAdvances,
	CASE
		WHEN Turnovers.SumComplClosingBalance &lt; 0
			THEN -1 * Turnovers.SumComplClosingBalance
		ELSE 0
	END AS LocalClosingBalanceAmountOutstanding
FROM
	AccumulationRegister.PayrollCalculationsHR.BalanceAndTurnovers(, , , , ) AS Turnovers</query>
	</dataSet>
