		<expression>Max(ThisIsOutput_)</expression>
	</totalField>
	<parameter>
		<name>Cost_Data</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Cost data</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>داده‌های بها</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Dati secondo il costo di produzione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Dane dot. kosztów własnych</v8:content>
			</v8:item>
			<v8:item>
