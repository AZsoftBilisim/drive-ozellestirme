		<field xsi:type="DataSetFieldField">
			<dataPath>Rule</dataPath>
			<field>Rule</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Rule</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>قاعده</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Regola</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Reguła</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Правило</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Kural</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Quy tắc</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys) AS
		ItemsLocationAttributes,
	MIN(CAST(BalanceTable.Rule AS
		Catalog.RulesForCalculationOfInventoryImpairmentProvision).Priority) AS Priority,
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting) AS AccountingSection,
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds) AS InventoryOwnerAttribute,
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes) AS InventoryType,
	CAST(BalanceTable.Organization AS Catalog.Companies) AS Organization,
	BalanceTable.Lot AS Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS LotVendorAttributes,
	BalanceTable.FinancialAccountingDimension AS FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes) AS VATActivityType,
	TRUE AS LocalAccounting,
	FALSE AS ManagementAccounting
INTO RulePriority
FROM
	TemporaryTableOfBalances AS BalanceTable
WHERE
	CAST(BalanceTable.Rule AS
		Catalog.RulesForCalculationOfInventoryImpairmentProvision).LocalAccounting
GROUP BY
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys),
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting),
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds),
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes),
	CAST(BalanceTable.Organization AS Catalog.Companies),
	BalanceTable.Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes),
	BalanceTable.FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes)

UNION ALL

SELECT
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys) AS
		ItemsLocationAttributes,
	MIN(CAST(BalanceTable.Rule AS
		Catalog.RulesForCalculationOfInventoryImpairmentProvision).Priority) AS Priority,
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting) AS AccountingSection,
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds) AS InventoryOwnerAttribute,
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes) AS InventoryType,
	CAST(BalanceTable.Organization AS Catalog.Companies) AS Organization,
	BalanceTable.Lot AS Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS LotVendorAttributes,
	BalanceTable.FinancialAccountingDimension AS FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes) AS VATActivityType,
	FALSE AS LocalAccounting,
	TRUE AS ManagementAccounting
FROM
	TemporaryTableOfBalances AS BalanceTable
WHERE
	CAST(BalanceTable.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision).ManagementAccounting
GROUP BY
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys),
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting),
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds),
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes),
	CAST(BalanceTable.Organization AS Catalog.Companies),
	BalanceTable.Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes),
	BalanceTable.FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes)

INDEX BY
	ItemsLocationAttributes,
	Priority,
	AccountingSection,
	InventoryOwnerAttribute,
	InventoryType,
	Organization,
	Lot,
	LotVendorAttributes,
	FinancialAccountingDimension,
	VATActivityType,
	LocalAccounting,
	ManagementAccounting
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys) AS
		ItemsLocationAttributes,
	MAX(CAST(BalanceTable.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision)) AS
		LocalRule,
	VALUE(Catalog.RulesForCalculationOfInventoryImpairmentProvision.EmptyRef) AS ManSRule,
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting) AS AccountingSection,
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds) AS InventoryOwnerAttribute,
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes) AS InventoryType,
	CAST(BalanceTable.Organization AS Catalog.Companies) AS Organization,
	BalanceTable.Lot AS Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS LotVendorAttributes,
	BalanceTable.FinancialAccountingDimension AS FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes) AS VATActivityType,
	CAST(BalanceTable.NetSaleValueOfLocal AS NUMBER(31, 2)) AS NetSaleValueOfLocal,
	0 AS NetSellingValueOfMan
INTO Rules
FROM
	TemporaryTableOfBalances AS BalanceTable
		INNER JOIN RulePriority AS RulePriority
		ON BalanceTable.ItemsLocationAttributes = RulePriority.ItemsLocationAttributes
		AND BalanceTable.AccountingSection = RulePriority.AccountingSection
		AND BalanceTable.InventoryOwnerAttribute = RulePriority.InventoryOwnerAttribute
		AND BalanceTable.Organization = RulePriority.Organization
		AND BalanceTable.Lot = RulePriority.Lot
		AND BalanceTable.LotVendorAttributes = RulePriority.LotVendorAttributes
		AND BalanceTable.FinancialAccountingDimension = RulePriority.FinancialAccountingDimension
		AND BalanceTable.VATActivityType = RulePriority.VATActivityType
		AND CAST(BalanceTable.Rule AS
			Catalog.RulesForCalculationOfInventoryImpairmentProvision).Priority = RulePriority.Priority
WHERE
	RulePriority.LocalAccounting
	AND CAST(BalanceTable.Rule AS
		Catalog.RulesForCalculationOfInventoryImpairmentProvision).LocalAccounting
GROUP BY
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys),
	VALUE(Catalog.RulesForCalculationOfInventoryImpairmentProvision.EmptyRef),
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting),
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds),
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes),
	CAST(BalanceTable.Organization AS Catalog.Companies),
	BalanceTable.Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes),
	BalanceTable.FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes),
	CAST(BalanceTable.NetSaleValueOfLocal AS NUMBER(31, 2))

UNION ALL

SELECT
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys) AS
		ItemsLocationAttributes,
	VALUE(Catalog.RulesForCalculationOfInventoryImpairmentProvision.EmptyRef) AS LocalRule,
	MAX(CAST(BalanceTable.Rule AS Catalog.RulesForCalculationOfInventoryImpairmentProvision)) AS
		ManSRule,
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting) AS AccountingSection,
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds) AS InventoryOwnerAttribute,
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes) AS InventoryType,
	CAST(BalanceTable.Organization AS Catalog.Companies) AS Organization,
	BalanceTable.Lot AS Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes) AS LotVendorAttributes,
	BalanceTable.FinancialAccountingDimension AS FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes) AS VATActivityType,
	0 AS NetSaleValueOfLocal,
	CAST(BalanceTable.NetSellingValueOfMan AS NUMBER(31, 2)) AS NetSellingValueOfMan
FROM
	TemporaryTableOfBalances AS BalanceTable
		INNER JOIN RulePriority AS RulePriority
		ON BalanceTable.ItemsLocationAttributes = RulePriority.ItemsLocationAttributes
		AND BalanceTable.AccountingSection = RulePriority.AccountingSection
		AND BalanceTable.InventoryOwnerAttribute = RulePriority.InventoryOwnerAttribute
		AND BalanceTable.Organization = RulePriority.Organization
		AND BalanceTable.Lot = RulePriority.Lot
		AND BalanceTable.LotVendorAttributes = RulePriority.LotVendorAttributes
		AND BalanceTable.FinancialAccountingDimension = RulePriority.FinancialAccountingDimension
		AND BalanceTable.VATActivityType = RulePriority.VATActivityType
		AND CAST(BalanceTable.Rule AS
			Catalog.RulesForCalculationOfInventoryImpairmentProvision).Priority = RulePriority.Priority
WHERE
	RulePriority.ManagementAccounting
	AND CAST(BalanceTable.Rule AS
		Catalog.RulesForCalculationOfInventoryImpairmentProvision).ManagementAccounting
GROUP BY
	CAST(BalanceTable.ItemsLocationAttributes AS Catalog.InventoryLocationAttributeKeys),
	VALUE(Catalog.RulesForCalculationOfInventoryImpairmentProvision.EmptyRef),
	CAST(BalanceTable.AccountingSection AS Enum.SectionsOfInventoryCostAccounting),
	CAST(BalanceTable.InventoryOwnerAttribute AS Catalog.InventoryKinds),
	CAST(BalanceTable.InventoryType AS Enum.InventoryTypes),
	CAST(BalanceTable.Organization AS Catalog.Companies),
	BalanceTable.Lot,
	CAST(BalanceTable.LotVendorAttributes AS Catalog.KeysForLotVendorAttributes),
	BalanceTable.FinancialAccountingDimension,
	CAST(BalanceTable.VATActivityType AS Enum.VATTaxationTypes),
	CAST(BalanceTable.NetSellingValueOfMan AS NUMBER(31, 2))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Rules.ItemsLocationAttributes,
	MAX(Rules.LocalRule) AS LocalRule,
	MAX(Rules.ManSRule) AS ManSRule,
	Rules.AccountingSection,
	Rules.InventoryOwnerAttribute,
	Rules.InventoryType,
	Rules.Organization,
	Rules.Lot,
	Rules.LotVendorAttributes,
	Rules.FinancialAccountingDimension,
	Rules.VATActivityType,
	SUM(Rules.NetSaleValueOfLocal) AS NetSaleValueOfLocal,
	SUM(Rules.NetSellingValueOfMan) AS NetSellingValueOfMan
INTO NetSellingPrices
FROM
	Rules AS Rules
GROUP BY
	Rules.ItemsLocationAttributes,
	Rules.AccountingSection,
	Rules.InventoryOwnerAttribute,
	Rules.InventoryType,
	Rules.Organization,
	Rules.Lot,
	Rules.LotVendorAttributes,
	Rules.FinancialAccountingDimension,
	Rules.VATActivityType

INDEX BY
	ItemsLocationAttributes,
	AccountingSection,
	InventoryOwnerAttribute,
	LotVendorAttributes,
	VATActivityType,
	Lot,
	Organization,
	FinancialAccountingDimension
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes AS ItemsLocationAttributes,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Products AS Products,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Characteristic AS Characteristic,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Series AS Series,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.StorageLocation AS StorageLocation,
	CASE
		WHEN &amp;ReportData = 1
			THEN NetSellingPrices.ManSRule
		ELSE NetSellingPrices.LocalRule
	END AS Rule,
	InventoryCostBalanceAndTurnovers.AccountingSection AS AccountingSection,
	InventoryCostBalanceAndTurnovers.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	InventoryCostBalanceAndTurnovers.Organization AS Organization,
	InventoryCostBalanceAndTurnovers.Lot AS Lot,
	InventoryCostBalanceAndTurnovers.LotVendorAttributes AS LotVendorAttributes,
	InventoryCostBalanceAndTurnovers.FinancialAccountingDimension AS FinancialAccountingDimension,
	InventoryCostBalanceAndTurnovers.VATActivityType AS VATActivityType,
	InventoryCostBalanceAndTurnovers.CountClosingBalance AS CountBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManReceipt
		ELSE -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalReceipt
	END AS ProvisionForImpairmentReceipt,
	CASE
		WHEN &amp;ReportData = 1
			THEN -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManExpense
		ELSE -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalExpense
	END AS ProvisionForImpairmentExpense,
	CASE
		WHEN &amp;ReportData = 1
			THEN InventoryCostBalanceAndTurnovers.CostManClosingBalance +
				InventoryCostBalanceAndTurnovers.AddExpensesManClosingBalance +
				InventoryCostBalanceAndTurnovers.LaborCostsManClosingBalance +
				InventoryCostBalanceAndTurnovers.ItemizedFixedCostsManagClosingBalance +
				InventoryCostBalanceAndTurnovers.ItemizedVariableCostsManagClosingBalance
		ELSE InventoryCostBalanceAndTurnovers.LocalCostClosingBalance +
			InventoryCostBalanceAndTurnovers.AddExpensesLocalClosingBalance +
			InventoryCostBalanceAndTurnovers.LaborCostsLocalClosingBalance +
			InventoryCostBalanceAndTurnovers.ItemizedFixedCostsComplClosingBalance +
			InventoryCostBalanceAndTurnovers.ItemizedVariableCostsComplClosingBalance
	END AS Cost_,
	CASE
		WHEN &amp;ReportData = 1
			THEN -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManOpeningBalance
		ELSE -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalOpeningBalance
	END AS ProvisionForImpairmentOpeningBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManClosingBalance
		ELSE -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalClosingBalance
	END AS ProvisionForImpairmentClosingBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN NetSellingPrices.NetSellingValueOfMan
		ELSE NetSellingPrices.NetSaleValueOfLocal
	END AS NetSellingValue
{SELECT
	ItemsLocationAttributes.*,
	Products.*,
	Characteristic.*,
	Series.*,
	StorageLocation.*,
	Rule.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	CountBalance,
	ProvisionForImpairmentReceipt,
	ProvisionForImpairmentExpense,
	Cost_,
	ProvisionForImpairmentOpeningBalance,
	ProvisionForImpairmentClosingBalance,
	NetSellingValue}
FROM
	AccumulationRegister.InventoryCost.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod,,,) AS
		InventoryCostBalanceAndTurnovers
		INNER JOIN NetSellingPrices AS NetSellingPrices
		ON InventoryCostBalanceAndTurnovers.ItemsLocationAttributes = NetSellingPrices.ItemsLocationAttributes
		AND InventoryCostBalanceAndTurnovers.AccountingSection = NetSellingPrices.AccountingSection
		AND InventoryCostBalanceAndTurnovers.InventoryOwnerAttribute = NetSellingPrices.InventoryOwnerAttribute
		AND InventoryCostBalanceAndTurnovers.Organization = NetSellingPrices.Organization
		AND InventoryCostBalanceAndTurnovers.Lot = NetSellingPrices.Lot
		AND InventoryCostBalanceAndTurnovers.LotVendorAttributes = NetSellingPrices.LotVendorAttributes
		AND InventoryCostBalanceAndTurnovers.FinancialAccountingDimension = NetSellingPrices.FinancialAccountingDimension
		AND InventoryCostBalanceAndTurnovers.VATActivityType = NetSellingPrices.VATActivityType
WHERE
	CASE
		WHEN &amp;ReportData = 1
			THEN CASE
				WHEN NOT InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManReceipt = 0
					THEN TRUE
				WHEN NOT InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManExpense = 0
					THEN TRUE
				WHEN NOT InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManOpeningBalance = 0
					THEN TRUE
				WHEN NOT InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManExpense = 0
					THEN TRUE
				ELSE FALSE
			END
		ELSE CASE
			WHEN NOT InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalReceipt = 0
				THEN TRUE
			WHEN NOT InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalExpense = 0
				THEN TRUE
			WHEN NOT InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalOpeningBalance = 0
				THEN TRUE
			WHEN NOT InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalExpense = 0
				THEN TRUE
			ELSE FALSE
		END
	END
{WHERE
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.* AS ItemsLocationAttributes,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Products.* AS Products,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Characteristic.* AS Characteristic,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Series.* AS Series,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.StorageLocation.* AS StorageLocation,
	CASE
		WHEN &amp;ReportData = 1
			THEN NetSellingPrices.ManSRule
		ELSE NetSellingPrices.LocalRule
	END AS Rule,
	InventoryCostBalanceAndTurnovers.AccountingSection.* AS AccountingSection,
	InventoryCostBalanceAndTurnovers.InventoryOwnerAttribute.* AS InventoryOwnerAttribute,
	InventoryCostBalanceAndTurnovers.Organization.* AS Organization,
	InventoryCostBalanceAndTurnovers.Lot.* AS Lot,
	InventoryCostBalanceAndTurnovers.LotVendorAttributes.* AS LotVendorAttributes,
	InventoryCostBalanceAndTurnovers.FinancialAccountingDimension.* AS FinancialAccountingDimension,
	InventoryCostBalanceAndTurnovers.VATActivityType.* AS VATActivityType,
	InventoryCostBalanceAndTurnovers.CountClosingBalance AS CountBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManReceipt
		ELSE -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalReceipt
	END AS ProvisionForImpairmentReceipt,
	CASE
		WHEN &amp;ReportData = 1
			THEN -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManExpense
		ELSE -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalExpense
	END AS ProvisionForImpairmentExpense,
	CASE
		WHEN &amp;ReportData = 1
			THEN InventoryCostBalanceAndTurnovers.CostManClosingBalance +
				InventoryCostBalanceAndTurnovers.AddExpensesManClosingBalance +
				InventoryCostBalanceAndTurnovers.LaborCostsManClosingBalance +
				InventoryCostBalanceAndTurnovers.ItemizedFixedCostsManagClosingBalance +
			InventoryCostBalanceAndTurnovers.ItemizedVariableCostsComplClosingBalance
		ELSE InventoryCostBalanceAndTurnovers.LocalCostClosingBalance +
			InventoryCostBalanceAndTurnovers.AddExpensesLocalClosingBalance +
			InventoryCostBalanceAndTurnovers.LaborCostsLocalClosingBalance +
			InventoryCostBalanceAndTurnovers.ItemizedFixedCostsComplClosingBalance +
			InventoryCostBalanceAndTurnovers.ItemizedVariableCostsComplClosingBalance
	END AS Cost_,
	CASE
		WHEN &amp;ReportData = 1
			THEN -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManOpeningBalance
		ELSE -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalOpeningBalance
	END AS ProvisionForImpairmentOpeningBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManClosingBalance
		ELSE -InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalClosingBalance
	END AS ProvisionForImpairmentClosingBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN NetSellingPrices.NetSellingValueOfMan
		ELSE NetSellingPrices.NetSaleValueOfLocal
	END AS NetSellingValue}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
