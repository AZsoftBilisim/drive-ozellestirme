				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED
	OrderStructure.Products AS Products,
	OrderStructure.Characteristic AS Characteristic,
	CASE
		WHEN OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
			THEN OrderStructure.BillOfMaterials
		ELSE VALUE(Catalog.BillsOfMaterials.EmptyRef)
	END AS BillOfMaterials,           
	OrderStructure.Products.UnitOfMeasure AS UnitOfMeasure,
	SUM(OrderStructure.ToSupply + OrderStructure.Ordered - OrderStructure.Replaced) AS Required2,
	SUM(OrderStructure.Scheduled + OrderStructure.ReverseKittingScheduled) AS Scheduled,
	SUM(OrderStructure.Launched + OrderStructure.ReverseKittingStarted) AS Launched,
	SUM(OrderStructure.AllocatedFromAvailableInventoryWithAssignment) + SUM(OrderStructure.AllocatedFromAvailableInventory) AS InStock,
	0 AS ForTransferToWarehouse,
	0 AS ExceedingOrder
{SELECT
	Products.*,
	Characteristic.*,
	UnitOfMeasure.*,
	BillOfMaterials.*,
	Required2,
	Scheduled,
	Launched,
	InStock,
	ForTransferToWarehouse,
	ExceedingOrder}
FROM
	InformationRegister.OrderStructure AS OrderStructure
		LEFT JOIN InformationRegister.ProductsBOM AS ProductsBOM
		ON NOT &amp;ShowSideIssue
			AND (OrderStructure.BillOfMaterials = ProductsBOM.BillOfMaterials)
			AND (OrderStructure.Products.ProductKind = ProductsBOM.ProductKind)
			AND (ProductsBOM.Products IN (OrderStructure.Products, VALUE(Catalog.Products.EmptyRef)))
			AND (ProductsBOM.Characteristic IN (OrderStructure.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)))
WHERE
	OrderStructure.ProductionOrder = &amp;ProductionOrder
	AND TRUE IN
			(SELECT TOP 1
				TRUE
			FROM
				InformationRegister.OrderStructure AS Products_1
			WHERE
				Products_1.ProductionOrder = OrderStructure.ProductionOrder
				AND Products_1.Products = OrderStructure.Products
				AND Products_1.Characteristic = OrderStructure.Characteristic
				AND Products_1.LineKind IN (
					VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts), 
					VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct), 
					VALUE(Enum.KindsOfProductionOrderStructureLines.Launched), 
					VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly), 
					VALUE(Enum.KindsOfProductionOrderStructureLines.AvailableRelease)
				))
	AND NOT TRUE IN
				(SELECT TOP 1
					TRUE
				FROM
					InformationRegister.OrderStructure AS Transfers
				WHERE
					Transfers.KeyLot = OrderStructure.KeyLot
					AND Transfers.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Move))
	AND (&amp;ShowSideIssue
			OR NOT ISNULL(ProductsBOM.SideExit, TRUE)
			OR (OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption))
			OR (OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct)))
{WHERE
	(OrderStructure.Products = &amp;Products),
	OrderStructure.ToSupply + OrderStructure.Ordered - OrderStructure.Replaced AS Required2,
	OrderStructure.Scheduled + OrderStructure.ReverseKittingScheduled AS Scheduled,
	OrderStructure.Launched + OrderStructure.ReverseKittingStarted AS Launched,
	OrderStructure.BillOfMaterials.*,
	(0) AS ExceedingOrder}

GROUP BY
	OrderStructure.Products,
	OrderStructure.Characteristic,
	OrderStructure.Products.UnitOfMeasure,
	CASE
		WHEN OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
			THEN OrderStructure.BillOfMaterials
		ELSE VALUE(Catalog.BillsOfMaterials.EmptyRef)
	END

HAVING
	SUM(OrderStructure.ToSupply + OrderStructure.Ordered - OrderStructure.Replaced) + SUM(OrderStructure.Scheduled + OrderStructure.ReverseKittingScheduled) + SUM(OrderStructure.Launched + OrderStructure.ReverseKittingStarted) &lt;&gt; 0

UNION ALL

SELECT
	ReferencesToTransferFromProductionBalance.Products AS Products,
	ReferencesToTransferFromProductionBalance.Characteristic AS Characteristic,
	VALUE(Catalog.BillsOfMaterials.EmptyRef) AS BillOfMaterials,
	ReferencesToTransferFromProductionBalance.Products.UnitOfMeasure AS UnitOfMeasure,
	0 AS Required2,
	0 AS Scheduled,
	0 AS Launched,
	0 AS OnBalance,
	ReferencesToTransferFromProductionBalance.CountBalance AS ForTransferToWarehouse,
	0 AS ExceedingOrder
FROM
	AccumulationRegister.ReferencesToTransferFromProduction.Balance(
			,
			CAST(ReferenceOrder AS Document.ProductionStage2_2).ReferenceOrder = &amp;ProductionOrder {(Products = &amp;Products)}) AS ReferencesToTransferFromProductionBalance
	LEFT JOIN InformationRegister.ProductsBOM AS ProductsBOM
	ON  NOT &amp;ShowSideIssue
		AND (CAST(ReferencesToTransferFromProductionBalance.ReferenceOrder AS Document.ProductionStage2_2).BillOfMaterials = ProductsBOM.BillOfMaterials)
		AND ReferencesToTransferFromProductionBalance.Products.ProductKind = ProductsBOM.ProductKind
		AND (ProductsBOM.Products IN (ReferencesToTransferFromProductionBalance.Products, VALUE(Catalog.Products.EmptyRef)))
		AND (ProductsBOM.Characteristic IN (ReferencesToTransferFromProductionBalance.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)))
	WHERE
		&amp;ShowSideIssue OR NOT ISNULL(ProductsBOM.SideExit, TRUE)</query>
				<autoFillFields>false</autoFillFields>
			</dataSet>
