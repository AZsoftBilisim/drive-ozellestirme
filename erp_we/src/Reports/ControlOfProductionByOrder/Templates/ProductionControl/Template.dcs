				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.InStockBalance AS InStockBalance,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.OrderedBalance AS OrderedBalance,
	Inventories.Received_1Balance AS Received_1Balance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
	Inventories.ToSupplyBalance AS ToSupplyBalance,
	Inventories.NotProvideBalance AS NotProvideBalance
INTO InventoryAndDemandsBalance
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		{Products = &amp;Products}) AS Inventories
INDEX BY
	Products, Characteristic, Warehouse, Purpose
;

////////////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.OrderDocument AS OrderDocument,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ToUnlockBalance AS ToUnlockBalance,
	Inventories.ReserveAtWarehouseFromLockedBalance AS ReserveAtWarehouseFromLockedBalance,
	Inventories.ReserveUponReceiptFromLockedBalance AS ReserveUponReceiptFromLockedBalance
	
INTO InventoryAndNeedsBalanceOfControlledLotsReference
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		{Products = &amp;Products}) AS Inventories
INDEX BY
	Products, Characteristic, Warehouse, Purpose
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Balance.Products AS Products,
	Balance.Characteristic AS Characteristic,
	CASE
		WHEN SUM(Balance.Surplus) &gt; 0
			THEN SUM(Balance.Surplus)
		ELSE 0
	END AS Surplus,
	CASE
		WHEN SUM(Balance.Surplus) &lt; 0
			THEN - SUM(Balance.Surplus)
		ELSE 0
	END AS Deficit
{SELECT
	Products.*,
	Characteristic.*,
	Surplus,
	Deficit}
FROM
	(SELECT
		Surpluses.Products AS Products,
		Surpluses.Characteristic AS Characteristic,
		Surpluses.InStock
		+ Surpluses.AvailableWithLock
		+ Surpluses.Expected_
		+ Surpluses.ExpectedWithBlocking
		+ Surpluses.AwaitingApproval
		- Surpluses.ToReserve_
		- Surpluses.ToReserveAsNeeded
		- Surpluses.Snooze
		- Surpluses.ToSupply
		// Further, the requirements for orders for the movement of items,
		// including Lots references blocked "forever" (without the possibility of unblocking), are deducted.
		- Surpluses.Reserve_FromBlocked
		- Surpluses.ReserveAsNeeded_FromBlocked
		// Since the inventory of items blocked "forever" did not hit the "plus"
		// , you need to adjust the "minus" for these quantities.
		+ Surpluses.AvailableWithoutUnlocking_Reserve_FromLocked
		+ Surpluses.AvailableWithoutUnlocking_ReserveAsNeeded_FromBlocked
		+ Surpluses.ExpectedWithoutUnlocking_ReserveAsNeeded_FromBlocked AS Surplus
		// We neglect the unsecured needs for moving Lot references of blocked goods (restriction).
		
	FROM
		SubstitutionInventoryAllocation AS Surpluses
	
	UNION ALL
	
	SELECT
		OrderStructure.Products AS Products,
		OrderStructure.Characteristic AS Characteristic,
		- CASE
			WHEN OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts)
				THEN 0
			ELSE OrderStructure.ToSupply
		END
		+ CASE
			WHEN OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts)
				THEN 0
			ELSE OrderStructure.Scheduled + OrderStructure.ReverseKittingScheduled
		END AS Surplus
	FROM
		InformationRegister.OrderStructure AS OrderStructure
	WHERE
		OrderStructure.Warehouse REFS Catalog.Warehouses
		AND NOT OrderStructure.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct)
		AND (OrderStructure.ToSupply &lt;&gt; 0
				OR OrderStructure.AllocatedFromAvailableInventoryWithAssignment &lt;&gt; 0
				OR OrderStructure.AllocatedInAssignedProductionLots &lt;&gt; 0
				OR OrderStructure.Scheduled &lt;&gt; 0
				OR OrderStructure.ReverseKittingScheduled &lt;&gt; 0)
	{WHERE
		(OrderStructure.Products = &amp;Products)}) AS Balance

GROUP BY
	Balance.Products,
	Balance.Characteristic</query>
				<autoFillFields>false</autoFillFields>
			</dataSet>
			<dataSetLink>
				<sourceDataSet>ProductionControl</sourceDataSet>
				<destinationDataSet>Surplus_Deficit</destinationDataSet>
				<sourceExpression>Products</sourceExpression>
				<destinationExpression>Products</destinationExpression>
			</dataSetLink>
			<dataSetLink>
				<sourceDataSet>ProductionControl</sourceDataSet>
				<destinationDataSet>Surplus_Deficit</destinationDataSet>
				<sourceExpression>Characteristic</sourceExpression>
				<destinationExpression>Characteristic</destinationExpression>
			</dataSetLink>
			<totalField>
				<dataPath>Required2</dataPath>
				<expression>Sum(Required2) - Sum(InStock)</expression>
			</totalField>
			<totalField>
				<dataPath>Scheduled</dataPath>
				<expression>Sum(Scheduled)</expression>
				<group>Products</group>
				<group>Characteristic</group>
			</totalField>
			<totalField>
				<dataPath>Scheduled</dataPath>
				<expression>0</expression>
				<group>BillOfMaterials</group>
			</totalField>
			<totalField>
				<dataPath>Launched</dataPath>
				<expression>Sum(Launched)</expression>
				<group>Products</group>
				<group>Characteristic</group>
			</totalField>
			<totalField>
				<dataPath>Launched</dataPath>
				<expression>0</expression>
				<group>BillOfMaterials</group>
			</totalField>
			<totalField>
				<dataPath>ForTransferToWarehouse</dataPath>
				<expression>Sum(ForTransferToWarehouse)</expression>
				<group>Products</group>
				<group>Characteristic</group>
			</totalField>
			<totalField>
				<dataPath>ForTransferToWarehouse</dataPath>
				<expression>0</expression>
				<group>BillOfMaterials</group>
			</totalField>
			<totalField>
				<dataPath>ExceedingOrder</dataPath>
				<expression>Case When Sum(Scheduled) + Sum(Launched) + Sum(ForTransferToWarehouse) + Sum(InStock) - Sum(Required2) &gt; 0 Then
	Sum(Scheduled) + Sum(Launched) + Sum(ForTransferToWarehouse) + Sum(InStock) - Sum(Required2)
Else 0 End</expression>
				<group>Products</group>
				<group>Characteristic</group>
			</totalField>
			<totalField>
				<dataPath>ExceedingOrder</dataPath>
				<expression>0</expression>
				<group>BillOfMaterials</group>
			</totalField>
			<totalField>
				<dataPath>Surplus</dataPath>
				<expression>Sum(Surplus)</expression>
				<group>Products</group>
				<group>Characteristic</group>
			</totalField>
			<totalField>
				<dataPath>Surplus</dataPath>
				<expression>0</expression>
				<group>BillOfMaterials</group>
			</totalField>
			<totalField>
				<dataPath>Deficit</dataPath>
				<expression>Sum(Deficit)</expression>
				<group>Products</group>
				<group>Characteristic</group>
			</totalField>
			<totalField>
				<dataPath>Deficit</dataPath>
				<expression>0</expression>
				<group>BillOfMaterials</group>
			</totalField>
			<totalField>
				<dataPath>InStock</dataPath>
				<expression>Sum(InStock)</expression>
			</totalField>
			<parameter>
				<name>ProductionOrder</name>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
