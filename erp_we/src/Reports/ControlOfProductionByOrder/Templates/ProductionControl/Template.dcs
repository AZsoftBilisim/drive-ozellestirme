				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED
	ProductionStage2_2OutputProducts.Products AS Products,
	ProductionStage2_2OutputProducts.Characteristic AS Characteristic,
	ProductionStage2_2OutputProducts.Products.UnitOfMeasure AS UnitOfMeasure,
	ProductionStage2_2OutputProducts.Recipient AS Recipient,
	ProductionStage2_2OutputProducts.Purpose AS Purpose,
	ProductionStage2_2OutputProducts.Count AS Manufactured,
	0 AS ForTransferToWarehouse,
	ProductionStage2_2OutputProducts.Ref.Date AS DateOfProduction
{SELECT
	Products.*,
	Characteristic.*,
	UnitOfMeasure.*,
	Recipient.*,
	Purpose.*,
	Manufactured,
	ForTransferToWarehouse}
FROM
	Document.ProductionStage2_2.ManufacturedProducts AS ProductionStage2_2OutputProducts
WHERE
	ProductionStage2_2OutputProducts.Ref.ReferenceOrder = &amp;ProductionOrder
	AND ProductionStage2_2OutputProducts.Ref.Posted
	AND ProductionStage2_2OutputProducts.Manufactured
{WHERE
	(ProductionStage2_2OutputProducts.Products = &amp;Products)}

UNION ALL

SELECT
	ProductionStage2_2ByProducts.Products AS Products,
	ProductionStage2_2ByProducts.Characteristic AS Characteristic,
	ProductionStage2_2ByProducts.Products.UnitOfMeasure AS UnitOfMeasure,
	ProductionStage2_2ByProducts.Recipient AS Recipient,
	ProductionStage2_2ByProducts.Purpose AS Purpose,
	ProductionStage2_2ByProducts.Count AS Manufactured,
	0 AS ForTransferToWarehouse,
	ProductionStage2_2ByProducts.Ref.Date AS DateOfProduction
FROM
	Document.ProductionStage2_2.SideAndIntermediateRelease AS ProductionStage2_2ByProducts
WHERE
	&amp;ShowSideIssue
	AND ProductionStage2_2ByProducts.Ref.ReferenceOrder = &amp;ProductionOrder
	AND ProductionStage2_2ByProducts.Ref.Posted
	AND ProductionStage2_2ByProducts.Manufactured
{WHERE
	(ProductionStage2_2ByProducts.Products = &amp;Products)}

UNION ALL

SELECT
	ReferencesToTransferFromProductionBalance.Products AS Products,
	ReferencesToTransferFromProductionBalance.Characteristic AS Characteristic,
	ReferencesToTransferFromProductionBalance.Products.UnitOfMeasure AS UnitOfMeasure,
	ReferencesToTransferFromProductionBalance.Recipient AS Recipient,
	ReferencesToTransferFromProductionBalance.Purpose AS Purpose,
	0 AS Manufactured,
	ReferencesToTransferFromProductionBalance.CountBalance AS ForTransferToWarehouse,
	CAST(ReferencesToTransferFromProductionBalance.ReferenceOrder AS Document.ProductionStage2_2).Date AS DateOfProduction
FROM
	AccumulationRegister.ReferencesToTransferFromProduction.Balance(
			,
			CAST(ReferenceOrder AS Document.ProductionStage2_2).ReferenceOrder = &amp;ProductionOrder {(Products = &amp;Products)}) AS ReferencesToTransferFromProductionBalance
	LEFT JOIN InformationRegister.ProductsBOM AS ProductsBOM
	ON  NOT &amp;ShowSideIssue
		AND (CAST(ReferencesToTransferFromProductionBalance.ReferenceOrder AS Document.ProductionStage2_2).BillOfMaterials = ProductsBOM.BillOfMaterials)
		AND ReferencesToTransferFromProductionBalance.Products.ProductKind = ProductsBOM.ProductKind
		AND (ProductsBOM.Products IN (ReferencesToTransferFromProductionBalance.Products, VALUE(Catalog.Products.EmptyRef)))
		AND (ProductsBOM.Characteristic IN (ReferencesToTransferFromProductionBalance.Characteristic, VALUE(Catalog.ItemsCharacteristics.EmptyRef)))
	WHERE
		&amp;ShowSideIssue OR NOT ISNULL(ProductsBOM.SideExit, TRUE)</query>
				<autoFillFields>false</autoFillFields>
			</dataSet>
			<totalField>
				<dataPath>ForTransferToWarehouse</dataPath>
				<expression>Sum(ForTransferToWarehouse)</expression>
			</totalField>
			<totalField>
				<dataPath>Manufactured</dataPath>
				<expression>Sum(Manufactured)</expression>
			</totalField>
