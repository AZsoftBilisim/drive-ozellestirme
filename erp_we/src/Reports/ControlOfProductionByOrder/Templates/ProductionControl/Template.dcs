								</v8:item>
								<v8:item>
									<v8:lang>fa</v8:lang>
									<v8:content>ND=15; NFD=3</v8:content>
								</v8:item>
								<v8:item>
									<v8:lang>it</v8:lang>
									<v8:content>ND=15; NFD=3</v8:content>
								</v8:item>
