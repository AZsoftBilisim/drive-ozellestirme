	<totalField>
		<dataPath>BalanceOfPreviousPeriod</dataPath>
		<expression>Case When StandardSection = &amp;RevenueLine_ 
Then Sum(IncomeBalanceOfThePreviousPeriod)
Else Sum(ExpenseBalanceOfThePreviousPeriod) 
End</expression>
	</totalField>
	<totalField>
		<dataPath>IncomeBalanceOfThePreviousPeriod</dataPath>
		<expression>Sum(IncomeBalanceOfThePreviousPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseBalanceOfThePreviousPeriod</dataPath>
		<expression>Sum(ExpenseBalanceOfThePreviousPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Case When StandardSection = &amp;RevenueLine_ 
Then Sum(IncomeAmount)
Else Sum(ExpenseAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>IncomeAmount</dataPath>
		<expression>Sum(IncomeAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseAmount</dataPath>
		<expression>Sum(ExpenseAmount)</expression>
	</totalField>
	<totalField>
		<dataPath>ProfitLoss</dataPath>
		<expression>Sum(IsNull(IncomeAmount, 0))
- Sum(IsNull(ExpenseAmount, 0))
+ Sum(IsNull(OtherWriteOffOfExpenses, 0))
+ Sum(IsNull(WrittenOffAtTheExpenseOfReserves, 0))</expression>
	</totalField>
	<totalField>
		<dataPath>AllocatedToProduction</dataPath>
		<expression>Sum(IsNull(AllocatedToProduction,0))</expression>
	</totalField>
	<totalField>
		<dataPath>AllocatedToFutureExpenses</dataPath>
		<expression>Sum(IsNull(AllocatedToFutureExpenses,0))</expression>
	</totalField>
	<totalField>
		<dataPath>AllocatedToGoodsCost</dataPath>
		<expression>Sum(IsNull(AllocatedToGoodsCost,0))</expression>
	</totalField>
	<totalField>
		<dataPath>AllocatedToFinancialResult</dataPath>
		<expression>Sum(IsNull(AllocatedToFinancialResult,0))</expression>
	</totalField>
	<totalField>
		<dataPath>OtherWriteOffOfExpenses</dataPath>
		<expression>Sum(IsNull(OtherWriteOffOfExpenses,0))</expression>
	</totalField>
	<totalField>
		<dataPath>ExpenseBalance</dataPath>
		<expression>Sum(ExpenseBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>WrittenOffAtTheExpenseOfReserves</dataPath>
		<expression>Sum(IsNull(WrittenOffAtTheExpenseOfReserves,0))</expression>
	</totalField>
	<totalField>
		<dataPath>TransitBetweenHIA</dataPath>
		<expression>Sum(TransitBetweenHIA)</expression>
	</totalField>
	<totalField>
		<dataPath>AllocatedToCostOfGoodsSold</dataPath>
		<expression>Sum(AllocatedToCostOfGoodsSold)</expression>
	</totalField>
