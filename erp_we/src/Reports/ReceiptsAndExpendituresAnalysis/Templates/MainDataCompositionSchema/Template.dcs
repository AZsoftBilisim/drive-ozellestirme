			<field xsi:type="DataSetFieldField">
				<dataPath>VariancePeriod</dataPath>
				<field>VariancePeriod</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Variance period</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>دوره انحراف</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Период отклонения</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Fark dönemi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Kỳ chênh lệch</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Variance period</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Variance period</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	DocumentExchangeRate.Currency AS Currency,
	DocumentExchangeRate.BaseCurrency AS BaseCurrency,
	DocumentExchangeRate.CourseNumerator * ManSExchangeRate.CourseDenominator / (DocumentExchangeRate.CourseDenominator *
		ManSExchangeRate.CourseNumerator) AS ManConversionFactor,
	DocumentExchangeRate.CourseNumerator * LocalCurrencyExchangeRate.CourseDenominator / (DocumentExchangeRate.CourseDenominator *
		LocalCurrencyExchangeRate.CourseNumerator) AS LocalConversionRatio
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},) AS DocumentExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},
			Currency = &amp;ManagementAccountingCurrency) AS ManSExchangeRate
		ON DocumentExchangeRate.BaseCurrency = ManSExchangeRate.BaseCurrency
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},
			Currency = &amp;LocalAccountingCurrency) AS LocalCurrencyExchangeRate
		ON DocumentExchangeRate.BaseCurrency = LocalCurrencyExchangeRate.BaseCurrency
WHERE
	ManSExchangeRate.CourseDenominator &lt;&gt; 0
	AND DocumentExchangeRate.CourseDenominator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;LineFutureExpenses AS Section,
	&amp;LineExpenses AS StandardSection,
	FALSE AS ThisIsIncome,
	CASE 
		WHEN &amp;ReportData = 4
			THEN Request.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	Request.Organization AS Organization,
	Request.Department AS Department,
	RegisterData.LineOfBusinessItems AS LineOfBusiness,

	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef) AS IncomeItem,
	RegisterData.IncomeAndExpenseItem AS ExpenseItem,
	RegisterData.DimensionOfExpenses AS DimensionOfExpenses,
	
	Request.Ref AS Recorder,
	RegisterData.SecondPeriod AS SecondPeriod,
	RegisterData.MonthPeriod AS MonthPeriod,
	RegisterData.DayPeriod AS DayPeriod,
	RegisterData.WeekPeriod AS WeekPeriod,
	RegisterData.TenDaysPeriod AS TenDaysPeriod,
	RegisterData.QuarterPeriod AS QuarterPeriod,
	RegisterData.HalfYearPeriod AS HalfYearPeriod,
	RegisterData.YearPeriod AS YearPeriod,
	DATETIME(1,1,1) AS VariancePeriod,
	
	CASE
		WHEN RegisterData.DimensionOfExpenses REFS Document.SalesOrder
				AND RegisterData.DimensionOfExpenses &lt;&gt; VALUE(Document.SalesOrder.EmptyRef)
			THEN RegisterData.DimensionOfExpenses
		ELSE NULL
	END AS OrderDocument,
	CASE
		WHEN RegisterData.DimensionOfExpenses REFS Catalog.SalesOpportunitiesToCustomer
				AND RegisterData.DimensionOfExpenses &lt;&gt; VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
			THEN RegisterData.DimensionOfExpenses
		WHEN RegisterData.DimensionOfExpenses REFS Document.SalesOrder
				AND RegisterData.DimensionOfExpenses.SalesOpportunity &lt;&gt; VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
			THEN RegisterData.DimensionOfExpenses.SalesOpportunity
		ELSE NULL
	END AS DealWithCustomers,
	CASE
		WHEN RegisterData.DimensionOfExpenses REFS Catalog.Partners
				AND RegisterData.DimensionOfExpenses &lt;&gt; VALUE(Catalog.Partners.EmptyRef)
			THEN RegisterData.DimensionOfExpenses
		ELSE NULL
	END AS Partner,

	CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		(RegisterData.AmountToBePaidWithinLimitTurnover 
		+ RegisterData.AmountToBePaidAboveLimitTurnover 
		+ RegisterData.VATAmountTurnover) * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 2 OR &amp;ReportData = 3 THEN
		(RegisterData.AmountToBePaidWithinLimitTurnover 
		+ RegisterData.AmountToBePaidAboveLimitTurnover) * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 4 THEN
		(RegisterData.AmountToBePaidWithinLimitTurnover 
		+ RegisterData.AmountToBePaidAboveLimitTurnover) * ExchangeRates.LocalConversionRatio
	ELSE
		(RegisterData.AmountToBePaidWithinLimitTurnover 
		+ RegisterData.AmountToBePaidAboveLimitTurnover) * ExchangeRates.ManConversionFactor
	END AS ExpenseAmount
FROM
	AccumulationRegister.RecordsCashIncomeExpenses.Turnovers(,,
			Auto,
			&amp;PlannedExpenses
				AND IncomeAndExpenseItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)) AS RegisterData
		INNER JOIN Document.PaymentRequest AS Request
		ON RegisterData.Recorder = Request.Ref
		{LEFT JOIN ExchangeRates AS ExchangeRates
		ON (Request.Currency = ExchangeRates.Currency
		AND Request.Organization.LocalAccountingCurrency = ExchangeRates.BaseCurrency)}
WHERE
	CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		(RegisterData.AmountToBePaidWithinLimitTurnover 
		+ RegisterData.AmountToBePaidAboveLimitTurnover 
		+ RegisterData.VATAmountTurnover) * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 2 OR &amp;ReportData = 3 THEN
		(RegisterData.AmountToBePaidWithinLimitTurnover 
		+ RegisterData.AmountToBePaidAboveLimitTurnover) * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 4 THEN
		(RegisterData.AmountToBePaidWithinLimitTurnover 
		+ RegisterData.AmountToBePaidAboveLimitTurnover) * ExchangeRates.LocalConversionRatio
	ELSE
		(RegisterData.AmountToBePaidWithinLimitTurnover 
		+ RegisterData.AmountToBePaidAboveLimitTurnover) * ExchangeRates.ManConversionFactor
	END &gt; 0</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>RegisterRecordsProductsIncomeExpenses</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Products</dataPath>
