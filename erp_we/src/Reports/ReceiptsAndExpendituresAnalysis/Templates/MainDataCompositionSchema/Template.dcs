			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DocumentExchangeRate.Currency AS Currency,
	DocumentExchangeRate.BaseCurrency AS BaseCurrency,
	DocumentExchangeRate.CourseNumerator * ManSExchangeRate.CourseDenominator / (DocumentExchangeRate.CourseDenominator *
		ManSExchangeRate.CourseNumerator) AS ManConversionFactor,
	DocumentExchangeRate.CourseNumerator * LocalCurrencyExchangeRate.CourseDenominator / (DocumentExchangeRate.CourseDenominator *
		LocalCurrencyExchangeRate.CourseNumerator) AS LocalConversionRatio
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},) AS DocumentExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},
			Currency = &amp;ManagementAccountingCurrency) AS ManSExchangeRate
		ON DocumentExchangeRate.BaseCurrency = ManSExchangeRate.BaseCurrency
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},
			Currency = &amp;LocalAccountingCurrency) AS LocalCurrencyExchangeRate
		ON DocumentExchangeRate.BaseCurrency = LocalCurrencyExchangeRate.BaseCurrency
WHERE
	ManSExchangeRate.CourseDenominator &lt;&gt; 0
	AND DocumentExchangeRate.CourseDenominator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;LineFutureExpenses AS Section,
	&amp;LineExpenses AS StandardSection,
	FALSE AS ThisIsIncome,
	CASE 
		WHEN &amp;ReportData = 4
			THEN PurchaseOrders.PurchaseOrder.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	PurchaseOrders.PurchaseOrder.Organization AS Organization,
	PurchaseOrders.PurchaseOrder.Department AS Department,
	PurchaseOrders.PurchaseOrder.LineOfBusiness AS LineOfBusiness,
	
	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef) AS IncomeItem,
	GoodsTable.ExpenseItem AS ExpenseItem,
	GoodsTable.DimensionOfExpenses AS DimensionOfExpenses,
	
	PurchaseOrders.PurchaseOrder AS Recorder,
	PurchaseOrders.SecondPeriod AS SecondPeriod,
	PurchaseOrders.MonthPeriod AS MonthPeriod,
	PurchaseOrders.DayPeriod AS DayPeriod,
	PurchaseOrders.WeekPeriod AS WeekPeriod,
	PurchaseOrders.TenDaysPeriod AS TenDaysPeriod,
	PurchaseOrders.QuarterPeriod AS QuarterPeriod,
	PurchaseOrders.HalfYearPeriod AS HalfYearPeriod,
	PurchaseOrders.YearPeriod AS YearPeriod,
	DATETIME(1,1,1) AS VariancePeriod,
	CASE
		WHEN GoodsTable.DimensionOfExpenses REFS Document.SalesOrder
				AND GoodsTable.DimensionOfExpenses &lt;&gt; VALUE(Document.SalesOrder.EmptyRef)
			THEN GoodsTable.DimensionOfExpenses
		ELSE NULL
	END AS OrderDocument,
	CASE
		WHEN GoodsTable.DimensionOfExpenses REFS Catalog.SalesOpportunitiesToCustomer
				AND GoodsTable.DimensionOfExpenses &lt;&gt; VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
			THEN GoodsTable.DimensionOfExpenses
		WHEN GoodsTable.DimensionOfExpenses REFS Document.SalesOrder
				AND GoodsTable.DimensionOfExpenses.SalesOpportunity &lt;&gt; VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
			THEN GoodsTable.DimensionOfExpenses.SalesOpportunity
		ELSE NULL
	END AS DealWithCustomers,
	CASE
		WHEN GoodsTable.DimensionOfExpenses REFS Catalog.Partners
				AND GoodsTable.DimensionOfExpenses &lt;&gt; VALUE(Catalog.Partners.EmptyRef)
			THEN GoodsTable.DimensionOfExpenses
		ELSE NULL
	END AS Partner,
	
	CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		GoodsTable.AmountIncludingVAT * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 2 OR &amp;ReportData = 3 THEN
		(GoodsTable.AmountIncludingVAT - GoodsTable.VATAmount) * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 4 THEN
		(GoodsTable.AmountIncludingVAT - GoodsTable.VATAmount) * ExchangeRates.LocalConversionRatio
	ELSE
		(GoodsTable.AmountIncludingVAT - GoodsTable.VATAmount) * ExchangeRates.ManConversionFactor
	END * PurchaseOrders.OrderedClosingBalance / GoodsTable.Count AS ExpenseAmount
FROM
	AccumulationRegister.PurchaseOrders.BalanceAndTurnovers(, , Auto, , 
			&amp;PlannedExpenses 
			AND NOT PurchaseOrder.BusinessOperation IN (
											VALUE(Enum.BusinessTransactions.TollManufacturing2_5),
											VALUE(Enum.BusinessTransactions.Subcontracting2_5),
											VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
											VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
											VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5))
			{(PurchaseOrder.Partner IN
			    (SELECT
			        SelectionByPartnerSegment.Partner
			    FROM
			        SelectionByPartnerSegment
			    WHERE
			        SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS PurchaseOrders
		{INNER JOIN Document.PurchaseOrder.Goods AS GoodsTable
		ON PurchaseOrders.PurchaseOrder = GoodsTable.Ref
			AND PurchaseOrders.RowCode = GoodsTable.RowCode
			AND (GoodsTable.ExpenseItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef))
			AND GoodsTable.DateOfReceipt &gt;= &amp;BeginOfPeriod AND GoodsTable.DateOfReceipt &lt;= &amp;EndOfPeriod}
		{LEFT JOIN ExchangeRates AS ExchangeRates
		ON PurchaseOrders.PurchaseOrder.Currency = ExchangeRates.Currency
		AND PurchaseOrders.PurchaseOrder.Organization.LocalAccountingCurrency = ExchangeRates.BaseCurrency}
WHERE
	CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		GoodsTable.AmountIncludingVAT * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 2 OR &amp;ReportData = 3 THEN
		(GoodsTable.AmountIncludingVAT - GoodsTable.VATAmount) * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 4 THEN
		(GoodsTable.AmountIncludingVAT - GoodsTable.VATAmount) * ExchangeRates.LocalConversionRatio
	ELSE
		(GoodsTable.AmountIncludingVAT - GoodsTable.VATAmount) * ExchangeRates.ManConversionFactor
	END * PurchaseOrders.OrderedClosingBalance / GoodsTable.Count &gt; 0
	AND (&amp;ReportData = 4
		AND GoodsTable.ExpenseItem.CostAllocationOptionLocal IN (VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness),
																		VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness))
		OR &amp;ReportData &lt;&gt; 4
		AND GoodsTable.ExpenseItem.CostAllocationOptionManag IN (VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness),
																		VALUE(Enum.CostAllocationOptions.ToLinesOfBusiness)))
		
</query>
		</item>
