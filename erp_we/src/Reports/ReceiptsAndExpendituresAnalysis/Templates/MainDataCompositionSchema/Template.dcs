			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;OtherRevenueLine AS Section,
	&amp;RevenueLine_ AS StandardSection,
	TRUE AS ThisIsIncome,
	CASE 
		WHEN &amp;ReportData = 4
			THEN RevenueServicesAndAssets.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	RevenueServicesAndAssets.IncomeItem,
	RevenueServicesAndAssets.DimensionOfRevenue,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,

	RevenueServicesAndAssets.Organization,
	RevenueServicesAndAssets.Department,
	RevenueServicesAndAssets.LineOfBusiness AS LineOfBusiness,

	CASE
		WHEN RevenueServicesAndAssets.DimensionOfRevenue REFS Document.PurchaseOrder
				AND RevenueServicesAndAssets.DimensionOfRevenue &lt;&gt; VALUE(Catalog.Warehouses.EmptyRef)
			THEN RevenueServicesAndAssets.DimensionOfRevenue.Warehouse
		ELSE VALUE(Catalog.Warehouses.EmptyRef)
	END AS Warehouse,
	
	VALUE(Document.SalesOrder.EmptyRef) AS OrderDocument,
	CASE
		WHEN RevenueServicesAndAssets.DimensionOfRevenue REFS Document.PurchaseOrder
				AND RevenueServicesAndAssets.DimensionOfRevenue.SalesOpportunity &lt;&gt; VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
			THEN RevenueServicesAndAssets.DimensionOfRevenue.SalesOpportunity
		ELSE VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
	END AS DealWithCustomers,
	
	CASE
		WHEN RevenueServicesAndAssets.DimensionOfRevenue REFS Document.PurchaseOrder
				AND RevenueServicesAndAssets.DimensionOfRevenue &lt;&gt; VALUE(Document.PurchaseOrder.EmptyRef)
			THEN RevenueServicesAndAssets.DimensionOfRevenue.Manager
		ELSE VALUE(Catalog.Users.EmptyRef)
	END AS Manager,
	CASE
		WHEN RevenueServicesAndAssets.DimensionOfRevenue REFS Document.PurchaseOrder
				AND RevenueServicesAndAssets.DimensionOfRevenue &lt;&gt; VALUE(Document.PurchaseOrder.EmptyRef)
			THEN RevenueServicesAndAssets.DimensionOfRevenue.Partner
		WHEN RevenueServicesAndAssets.DimensionOfRevenue REFS Catalog.Partners
				AND RevenueServicesAndAssets.DimensionOfRevenue &lt;&gt; VALUE(Catalog.Partners.EmptyRef)
			THEN RevenueServicesAndAssets.DimensionOfRevenue
		ELSE VALUE(Catalog.Partners.EmptyRef)
	END AS Partner,
	CASE
		WHEN RevenueServicesAndAssets.DimensionOfRevenue REFS Document.PurchaseOrder
				AND RevenueServicesAndAssets.DimensionOfRevenue &lt;&gt; VALUE(Document.PurchaseOrder.EmptyRef)
			THEN RevenueServicesAndAssets.DimensionOfRevenue.Terms
		ELSE NULL
	END AS Terms,
	CASE
		WHEN RevenueServicesAndAssets.DimensionOfRevenue REFS Document.PurchaseOrder
				AND RevenueServicesAndAssets.DimensionOfRevenue &lt;&gt; VALUE(Document.PurchaseOrder.EmptyRef)
			THEN RevenueServicesAndAssets.DimensionOfRevenue.Contract
		ELSE NULL
	END AS Contract,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	
	RevenueServicesAndAssets.SecondPeriod AS SecondPeriod,
	RevenueServicesAndAssets.MonthPeriod AS MonthPeriod,
	RevenueServicesAndAssets.DayPeriod AS DayPeriod,
	RevenueServicesAndAssets.WeekPeriod AS WeekPeriod,
	RevenueServicesAndAssets.TenDaysPeriod AS TenDaysPeriod,
	RevenueServicesAndAssets.QuarterPeriod AS QuarterPeriod,
	RevenueServicesAndAssets.HalfYearPeriod AS HalfYearPeriod,
	RevenueServicesAndAssets.YearPeriod AS YearPeriod,
	DATETIME(1,1,1) AS VariancePeriod,
	CASE
		WHEN RevenueServicesAndAssets.Recorder = UNDEFINED
			THEN NULL
		ELSE RevenueServicesAndAssets.Recorder
	END AS Recorder,
	
	0 AS IncomeBalanceOfThePreviousPeriod,
	
	CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		RevenueServicesAndAssets.RevenueExcludingVATManagTurnover + RevenueServicesAndAssets.VATManagTurnover
	WHEN &amp;ReportData = 2 OR &amp;ReportData = 3 THEN
		RevenueServicesAndAssets.RevenueExcludingVATManagTurnover
	WHEN &amp;ReportData = 4 THEN
		RevenueServicesAndAssets.RevenueExcludingVATLocalTurnover
	ELSE
		RevenueServicesAndAssets.RevenueExcludingVATManagTurnover
	END AS IncomeAmount,
	0 AS AllocatedIncome,
	0 AS NotAllocatedIncome
FROM
	AccumulationRegister.RevenueServicesAndAssets.Turnovers(, , Auto, {(Partner IN
			        (SELECT
			            SelectionByPartnerSegment.Partner
			        FROM
			            SelectionByPartnerSegment
			        WHERE
			            SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)
			    OR DimensionOfRevenue.Partner IN
			        (SELECT
			            SelectionByPartnerSegment.Partner
			        FROM
			            SelectionByPartnerSegment
			        WHERE
			            SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}) AS RevenueServicesAndAssets</query>
		</item>
