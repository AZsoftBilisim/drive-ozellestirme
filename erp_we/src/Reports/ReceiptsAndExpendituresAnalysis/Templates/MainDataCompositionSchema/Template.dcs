						<v8:content>Variance period</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(DocumentData.Ref.Date, MONTH) AS MonthPeriod,
	DocumentData.Organization AS Organization,
	TRUE AS PreliminaryCalculation
INTO CostCalculations
FROM
	Document.InventoryCostCalculation AS Operation
	INNER JOIN Document.InventoryCostCalculation.Companies AS DocumentData
		ON DocumentData.Ref = Operation.Ref
WHERE
	Operation.PreliminaryCalculation
	AND Operation.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND Operation.Posted
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;LineOtherExpenses AS Section,
	&amp;LineExpenses AS StandardSection,
	FALSE AS ThisIsIncome,
	CASE 
		WHEN &amp;ReportData = 4
			THEN DD.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	DD.Organization,
	DD.Department,
	DD.LineOfBusinessItems AS LineOfBusiness,
	
	DD.Warehouse,
	
	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef) AS IncomeItem,
	DD.IncomeAndExpenseItem AS ExpenseItem,
	
	InventoryLocationAttributeKeys.Products,
	
	DD.SecondPeriod AS SecondPeriod,
	DD.MonthPeriod AS MonthPeriod,
	DD.DayPeriod AS DayPeriod,
	DD.WeekPeriod AS WeekPeriod,
	DD.TenDaysPeriod AS TenDaysPeriod,
	DD.QuarterPeriod AS QuarterPeriod,
	DD.HalfYearPeriod AS HalfYearPeriod,
	DATETIME(1,1,1) AS VariancePeriod,
	DD.YearPeriod AS YearPeriod,
	CASE
		WHEN DD.Recorder = UNDEFINED THEN NULL
		ELSE DD.Recorder
	END AS Recorder,

	CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		(ISNULL(CostOfProducts.Cost, 0) + ISNULL(CostOfProducts.AdditionalExpenseCost, 0))
	WHEN &amp;ReportData = 2 THEN
		(ISNULL(CostOfProducts.CostExcludingVAT, 0) + ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0))
	WHEN &amp;ReportData = 3 THEN
		(ISNULL(CostOfProducts.CostMan, 0) + ISNULL(CostOfProducts.AddExpensesMan, 0))
	WHEN &amp;ReportData = 4 THEN
		(ISNULL(CostOfProducts.LocalCost, 0) + ISNULL(CostOfProducts.AddExpensesLocal, 0)) 
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			(ISNULL(CostOfProducts.CostExcludingVAT, 0) + ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0))
		ELSE
			(ISNULL(CostOfProducts.CostMan, 0) + ISNULL(CostOfProducts.AddExpensesMan, 0))
		END
	END * DD.CountTurnover AS ExpenseAmount
FROM
	AccumulationRegister.RegisterRecordsProductsIncomeExpenses.Turnovers(, , Auto, InventoryType &lt;&gt; VALUE(Enum.InventoryTypes.ConsignedGoods)) AS DD
	INNER JOIN CostCalculations AS CostCalculations
		ON (DD.Organization = CostCalculations.Organization)
		AND (BEGINOFPERIOD(DD.MonthPeriod, MONTH) = CostCalculations.MonthPeriod)
	{LEFT JOIN Catalog.InventoryLocationAttributeKeys AS InventoryLocationAttributeKeys
		ON DD.ItemsLocationAttributes = InventoryLocationAttributeKeys.Ref}
	{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON DD.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
		AND (DD.Organization = CostOfProducts.Organization)
		AND DD.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
		AND (BEGINOFPERIOD(DD.MonthPeriod, MONTH) = CostOfProducts.Period)
		AND (ISNULL(CostCalculations.PreliminaryCalculation, FALSE))}
WHERE
	ISNULL(CostCalculations.PreliminaryCalculation, FALSE)
	AND DD.IncomeAndExpenseItem REFS ChartOfCharacteristicTypes.ExpenseItems
{WHERE
	((InventoryLocationAttributeKeys.Products, InventoryLocationAttributeKeys.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}</query>
		</item>
