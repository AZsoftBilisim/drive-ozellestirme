			<dataSource>DataSource1</dataSource>
			<query>// Is being refilled in the module of the object - textquery()

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;LineOtherExpenses AS Section,
	&amp;LineExpenses AS StandardSection,
	FALSE AS ThisIsIncome,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	
	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef) AS IncomeItem,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	UNDEFINED AS DimensionOfExpenses,

	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,

	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	VALUE(Document.SalesOrder.EmptyRef) AS OrderDocument,
	VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef) AS DealWithCustomers,
	VALUE(Catalog.Users.EmptyRef) AS Manager,
	VALUE(Catalog.Partners.EmptyRef) AS Partner,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	UNDEFINED AS Asset,
	
	DATETIME(1,1,1) AS MonthPeriod,
	DATETIME(1,1,1) AS DayPeriod,
	DATETIME(1,1,1) AS WeekPeriod,
	DATETIME(1,1,1) AS TenDaysPeriod,
	DATETIME(1,1,1) AS QuarterPeriod,
	DATETIME(1,1,1) AS HalfYearPeriod,
	DATETIME(1,1,1) AS YearPeriod,
	DATETIME(1,1,1) AS SecondPeriod,
	UNDEFINED AS Recorder,
	DATETIME(1,1,1) AS VariancePeriod,
	
	0 AS ExpenseBalanceOfThePreviousPeriod,
	0 AS ExpenseAmount,
	0 AS WrittenOffAtTheExpenseOfReserves,
	0 AS AllocatedToGoodsCost,
	0 AS AllocatedToProduction,
	0 AS AllocatedToFinancialResult,
	0 AS AllocatedToFutureExpenses,
	0 AS AllocatedToCostOfGoodsSold,
	0 AS OtherWriteOffOfExpenses,
	0 AS TransitBetweenHIA,
	0 AS ExpenseBalance
</query>
		</item>
