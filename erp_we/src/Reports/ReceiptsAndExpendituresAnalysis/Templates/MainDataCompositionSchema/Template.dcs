	<parameter>
		<name>ExcludeTransportationCostAndDeferredExpense</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Exclude TPE and deferred expenses (included in cost)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>حذف TPE و هزینه‌های انتقالی (منظورشده در بها)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Escludi le spese di trasporto e approvvigionamento e le spese dei periodi successivi (inclusi nel costo di produzione)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wyłączyć Rozchody w bieżącym roku i Rozchody na przyszłe okresy          (włączone w koszt własny)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Исключить ТЗР и РБП (включены в себестоимость)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Nakliye ve tedarik masrafları ve ertelenmiş giderleri hariç tut (maliyetlere dahil)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Loại trừ chi phí vận chuyển và chi phí trả trước (đã bao gồm trong giá vốn)</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
