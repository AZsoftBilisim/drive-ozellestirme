			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<orderExpression>
				<dcscom:expression>Case 
	When Section = &amp;LineOfSale 
		Then 1
	When Section = &amp;LineFutureSales 
		Then 2
	When Section = &amp;OtherIncomeLine 
		Then 3
	When Section = &amp;LineOtherExpenses 
		Then 4
	When Section = &amp;LineFutureExpenses 
		Then 5
	When Section = &amp;TKRString 
		Then 6
	When Section = &amp;RBPLine 
		Then 7
	When Section = &amp;LineForCostOfGoodsSold 
		Then 8
End</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>true</dcscom:autoOrder>
			</orderExpression>
