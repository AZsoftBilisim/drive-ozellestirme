			<field xsi:type="DataSetFieldField">
				<dataPath>VariancePeriod</dataPath>
				<field>VariancePeriod</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Variance period</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>دوره انحراف</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Период отклонения</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Fark dönemi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Kỳ chênh lệch</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Variance period</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Variance period</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	BEGINOFPERIOD(DocumentData.Ref.Date, MONTH) AS MonthPeriod,
	DocumentData.Organization AS Organization,
	TRUE AS PreliminaryCalculation
INTO CostCalculations
FROM
	Document.InventoryCostCalculation AS Operation
	INNER JOIN Document.InventoryCostCalculation.Companies AS DocumentData
		ON DocumentData.Ref = Operation.Ref
WHERE
	Operation.PreliminaryCalculation
	AND Operation.Date BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND Operation.Posted
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;LineOfSale AS Section,
	&amp;LineExpenses AS StandardSection,
	FALSE AS ThisIsIncome,
	CASE 
		WHEN &amp;ReportData = 4
			THEN RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef) AS IncomeItem,
	CASE
		WHEN ISNULL(CostCalculations.PreliminaryCalculation, FALSE)
			THEN &amp;LineCostOfSalesPreliminary
		ELSE VALUE(ChartOfCharacteristicTypes.ExpenseItems.SaleCost)
	END AS ExpenseItem,
	
	RegisterAccountingAnalyticsForPartners.Organization,
	RevenueAndCOGS.Department,
	RevenueAndCOGS.CounterpartyLineOfBusiness AS LineOfBusiness,

	RevenueAndCOGS.Warehouse,

	CASE
		WHEN RevenueAndCOGS.SalesOrder REFS Document.SalesOrder
				OR RevenueAndCOGS.SalesOrder REFS Document.RequestForReturnOfGoodsFromCustomer
				OR RevenueAndCOGS.SalesOrder REFS Document.CustomerInvoice
			THEN CASE
					WHEN RevenueAndCOGS.SalesOrder = VALUE(Document.SalesOrder.EmptyRef)
							OR RevenueAndCOGS.SalesOrder = VALUE(Document.RequestForReturnOfGoodsFromCustomer.EmptyRef)
							OR RevenueAndCOGS.SalesOrder = VALUE(Document.CustomerInvoice.EmptyRef)
						THEN VALUE(Document.SalesOrder.EmptyRef)
					ELSE RevenueAndCOGS.SalesOrder
				END
		ELSE VALUE(Document.SalesOrder.EmptyRef)
	END AS OrderDocument,
	CASE
		WHEN RevenueAndCOGS.SalesOrder.SalesOpportunity = VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
				OR RevenueAndCOGS.SalesOrder.SalesOpportunity IS NULL 
			THEN VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
		ELSE RevenueAndCOGS.SalesOrder.SalesOpportunity
	END AS DealWithCustomers,

	RevenueAndCOGS.Manager,
	RegisterAccountingAnalyticsForPartners.Partner,
	RevenueAndCOGS.Terms,
	RevenueAndCOGS.Contract,
	
	InventoryLocationAttributeKeys.Products,

	RevenueAndCOGS.MonthPeriod AS MonthPeriod,
	RevenueAndCOGS.DayPeriod AS DayPeriod,
	RevenueAndCOGS.WeekPeriod AS WeekPeriod,
	RevenueAndCOGS.TenDaysPeriod AS TenDaysPeriod,
	RevenueAndCOGS.QuarterPeriod AS QuarterPeriod,
	RevenueAndCOGS.HalfYearPeriod AS HalfYearPeriod,
	RevenueAndCOGS.YearPeriod AS YearPeriod,
	RevenueAndCOGS.SecondPeriod AS SecondPeriod,
	
	DATETIME(1,1,1) AS VariancePeriod,
	
	CASE
		WHEN RevenueAndCOGS.Recorder = UNDEFINED
			THEN NULL
		ELSE RevenueAndCOGS.Recorder
	END AS Recorder,
	
	0 AS ExpenseBalanceOfThePreviousPeriod,
	CASE
		WHEN ISNULL(CostCalculations.PreliminaryCalculation, FALSE) THEN
			CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
				ISNULL(CostOfProducts.Cost, 0)
				+ ISNULL(CostOfProducts.AdditionalExpenseCost, 0)
				+ ISNULL(CostOfProducts.LaborCosts, 0)
				+ ISNULL(CostOfProducts.ItemizedFixedCostsIncludingVAT, 0)
				+ ISNULL(CostOfProducts.ItemizedVariableCostsIncludingVAT, 0)
			WHEN &amp;ReportData = 2 THEN
				ISNULL(CostOfProducts.CostExcludingVAT, 0)
				+ ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0)
				+ ISNULL(CostOfProducts.LaborCosts, 0)
				+ ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0)
				+ ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0)
			WHEN &amp;ReportData = 3 THEN
				ISNULL(CostOfProducts.CostMan, 0)
				+ ISNULL(CostOfProducts.AddExpensesMan, 0)
				+ ISNULL(CostOfProducts.LaborCostsMan, 0)
				+ ISNULL(CostOfProducts.ItemizedFixedCostsManag, 0)
				+ ISNULL(CostOfProducts.ItemizedVariableCostsManag, 0)
			WHEN &amp;ReportData = 4 THEN
				ISNULL(CostOfProducts.LocalCost, 0)
				+ ISNULL(CostOfProducts.AddExpensesLocal, 0)
				+ ISNULL(CostOfProducts.LaborCostsLocal, 0)
				+ ISNULL(CostOfProducts.ItemizedFixedCostsCompl, 0)
				+ ISNULL(CostOfProducts.ItemizedVariableCostsCompl, 0)
			ELSE
				CASE WHEN &amp;ByEnterprise THEN
					ISNULL(CostOfProducts.CostExcludingVAT, 0)
					+ ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0)
					+ ISNULL(CostOfProducts.LaborCosts, 0)
					+ ISNULL(CostOfProducts.ItemizedFixedCostsExcludingVAT, 0)
					+ ISNULL(CostOfProducts.ItemizedVariableCostsExcludingVAT, 0)
				ELSE
					ISNULL(CostOfProducts.CostMan, 0)
					+ ISNULL(CostOfProducts.AddExpensesMan, 0)
					+ ISNULL(CostOfProducts.LaborCostsMan, 0)
					+ ISNULL(CostOfProducts.ItemizedFixedCostsManag, 0)
					+ ISNULL(CostOfProducts.ItemizedVariableCostsManag, 0)
				END
			END * RevenueAndCOGS.CountTurnover
		ELSE 
			CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
				RevenueAndCOGS.CostTurnover
				+ RevenueAndCOGS.AddExpensesForGoodsTurnover
				+ RevenueAndCOGS.LaborCostsTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsIncludingVATTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsIncludingVATTurnover
			WHEN &amp;ReportData = 2 THEN
				RevenueAndCOGS.CostExcludingVATTurnover
				+ RevenueAndCOGS.AdditionalExpensesExcludingVATTurnover
				+ RevenueAndCOGS.LaborCostsTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsExcludingVATTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsExcludingVATTurnover
			WHEN &amp;ReportData = 3 THEN
				RevenueAndCOGS.CostManTurnover
				+ RevenueAndCOGS.AddExpensesManTurnover
				+ RevenueAndCOGS.LaborCostsManTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsManagTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsManagTurnover
			WHEN &amp;ReportData = 4 THEN
				RevenueAndCOGS.LocalCostTurnover
				+ RevenueAndCOGS.AddExpensesLocalTurnover
				+ RevenueAndCOGS.LaborCostsLocalTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsComplTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsComplTurnover
			ELSE
				CASE WHEN &amp;ByEnterprise THEN
					RevenueAndCOGS.CostExcludingVATTurnover
					+ RevenueAndCOGS.AdditionalExpensesExcludingVATTurnover
					+ RevenueAndCOGS.LaborCostsTurnover
					+ RevenueAndCOGS.ItemizedFixedCostsExcludingVATTurnover
					+ RevenueAndCOGS.ItemizedVariableCostsExcludingVATTurnover
				ELSE
					RevenueAndCOGS.CostManTurnover
					+ RevenueAndCOGS.AddExpensesManTurnover
					+ RevenueAndCOGS.LaborCostsManTurnover
					+ RevenueAndCOGS.ItemizedFixedCostsManagTurnover
					+ RevenueAndCOGS.ItemizedVariableCostsManagTurnover
				END
			END		
	END AS ExpenseAmount,
	CASE
		WHEN FinancialResults.ExpensesTurnover IS NULL
		 OR ISNULL(CostCalculations.PreliminaryCalculation, FALSE) THEN 0
		ELSE
		CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
				RevenueAndCOGS.CostTurnover
				+ RevenueAndCOGS.AddExpensesForGoodsTurnover
				+ RevenueAndCOGS.LaborCostsTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsIncludingVATTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsIncludingVATTurnover
			WHEN &amp;ReportData = 2 THEN
				RevenueAndCOGS.CostExcludingVATTurnover
				+ RevenueAndCOGS.AdditionalExpensesExcludingVATTurnover
				+ RevenueAndCOGS.LaborCostsTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsExcludingVATTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsExcludingVATTurnover
			WHEN &amp;ReportData = 3 THEN
				RevenueAndCOGS.CostManTurnover
				+ RevenueAndCOGS.AddExpensesManTurnover
				+ RevenueAndCOGS.LaborCostsManTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsManagTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsManagTurnover
			WHEN &amp;ReportData = 4 THEN
				RevenueAndCOGS.LocalCostTurnover
				+ RevenueAndCOGS.AddExpensesLocalTurnover
				+ RevenueAndCOGS.LaborCostsLocalTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsComplTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsComplTurnover
			ELSE
				CASE WHEN &amp;ByEnterprise THEN
					RevenueAndCOGS.CostExcludingVATTurnover
					+ RevenueAndCOGS.AdditionalExpensesExcludingVATTurnover
					+ RevenueAndCOGS.LaborCostsTurnover
					+ RevenueAndCOGS.ItemizedFixedCostsExcludingVATTurnover
					+ RevenueAndCOGS.ItemizedVariableCostsExcludingVATTurnover
				ELSE
					RevenueAndCOGS.CostManTurnover
					+ RevenueAndCOGS.AddExpensesManTurnover
					+ RevenueAndCOGS.LaborCostsManTurnover
					+ RevenueAndCOGS.ItemizedFixedCostsManagTurnover
					+ RevenueAndCOGS.ItemizedVariableCostsManagTurnover
				END
			END
	END AS AllocatedExpenses,
	CASE
		WHEN NOT FinancialResults.ExpensesTurnover IS NULL
		 AND NOT ISNULL(CostCalculations.PreliminaryCalculation, FALSE) THEN 0
		ELSE
		CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
				RevenueAndCOGS.CostTurnover
				+ RevenueAndCOGS.AddExpensesForGoodsTurnover
				+ RevenueAndCOGS.LaborCostsTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsIncludingVATTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsIncludingVATTurnover
			WHEN &amp;ReportData = 2 THEN
				RevenueAndCOGS.CostExcludingVATTurnover
				+ RevenueAndCOGS.AdditionalExpensesExcludingVATTurnover
				+ RevenueAndCOGS.LaborCostsTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsExcludingVATTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsExcludingVATTurnover
			WHEN &amp;ReportData = 3 THEN
				RevenueAndCOGS.CostManTurnover
				+ RevenueAndCOGS.AddExpensesManTurnover
				+ RevenueAndCOGS.LaborCostsManTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsManagTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsManagTurnover
			WHEN &amp;ReportData = 4 THEN
				RevenueAndCOGS.LocalCostTurnover
				+ RevenueAndCOGS.AddExpensesLocalTurnover
				+ RevenueAndCOGS.LaborCostsLocalTurnover
				+ RevenueAndCOGS.ItemizedFixedCostsComplTurnover
				+ RevenueAndCOGS.ItemizedVariableCostsComplTurnover
			ELSE
				CASE WHEN &amp;ByEnterprise THEN
					RevenueAndCOGS.CostExcludingVATTurnover
					+ RevenueAndCOGS.AdditionalExpensesExcludingVATTurnover
					+ RevenueAndCOGS.LaborCostsTurnover
					+ RevenueAndCOGS.ItemizedFixedCostsExcludingVATTurnover
					+ RevenueAndCOGS.ItemizedVariableCostsExcludingVATTurnover
				ELSE
					RevenueAndCOGS.CostManTurnover
					+ RevenueAndCOGS.AddExpensesManTurnover
					+ RevenueAndCOGS.LaborCostsManTurnover
					+ RevenueAndCOGS.ItemizedFixedCostsManagTurnover
					+ RevenueAndCOGS.ItemizedVariableCostsManagTurnover
				END
			END
	END AS NotAllocatedExpenses
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(, , Auto,
		InventoryType &lt;&gt; VALUE(Enum.InventoryTypes.ConsignedGoods)
	) AS RevenueAndCOGS
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
		ON RevenueAndCOGS.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
		LEFT JOIN AccumulationRegister.FinancialResults.Turnovers(, , Auto, ExpenseItem = VALUE(ChartOfCharacteristicTypes.ExpenseItems.SaleCost)) AS FinancialResults
		ON RevenueAndCOGS.Department = FinancialResults.Department
			AND RegisterAccountingAnalyticsForPartners.Organization = FinancialResults.Organization
			AND RevenueAndCOGS.MonthPeriod = FinancialResults.MonthPeriod
		{LEFT JOIN Catalog.InventoryLocationAttributeKeys AS InventoryLocationAttributeKeys
		ON RevenueAndCOGS.ItemsLocationAttributes = InventoryLocationAttributeKeys.Ref}
		{LEFT JOIN CostCalculations AS CostCalculations
		ON (RegisterAccountingAnalyticsForPartners.Organization = CostCalculations.Organization)
			AND (BEGINOFPERIOD(RevenueAndCOGS.MonthPeriod, MONTH) = CostCalculations.MonthPeriod)}
		{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON RevenueAndCOGS.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
			AND (RegisterAccountingAnalyticsForPartners.Organization = CostOfProducts.Organization)
			AND RevenueAndCOGS.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
			AND (BEGINOFPERIOD(RevenueAndCOGS.MonthPeriod, MONTH) = CostOfProducts.Period)
			AND (ISNULL(CostCalculations.PreliminaryCalculation, FALSE))}
WHERE
	(&amp;ShowSales_ = 1
				AND (RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
					OR RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
						AND RevenueAndCOGS.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
					)
			OR &amp;ShowSales_ = 2
				AND RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
			OR &amp;ShowSales_ = 0)
{WHERE
	(RegisterAccountingAnalyticsForPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	((InventoryLocationAttributeKeys.Products, InventoryLocationAttributeKeys.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}</query>
		</item>
