						<v8:lang>pl</v8:lang>
						<v8:content>Variance period</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DocumentExchangeRate.Currency AS Currency,
	DocumentExchangeRate.BaseCurrency AS BaseCurrency,
	DocumentExchangeRate.CourseNumerator * ManSExchangeRate.CourseDenominator / (DocumentExchangeRate.CourseDenominator *
		ManSExchangeRate.CourseNumerator) AS ManConversionFactor,
	DocumentExchangeRate.CourseNumerator * LocalCurrencyExchangeRate.CourseDenominator / (DocumentExchangeRate.CourseDenominator *
		LocalCurrencyExchangeRate.CourseNumerator) AS LocalConversionRatio
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},) AS DocumentExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},
			Currency = &amp;ManagementAccountingCurrency) AS ManSExchangeRate
		ON DocumentExchangeRate.BaseCurrency = ManSExchangeRate.BaseCurrency
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)},
			Currency = &amp;LocalAccountingCurrency) AS LocalCurrencyExchangeRate
		ON DocumentExchangeRate.BaseCurrency = LocalCurrencyExchangeRate.BaseCurrency
WHERE
	ManSExchangeRate.CourseDenominator &lt;&gt; 0
	AND DocumentExchangeRate.CourseDenominator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ShipmentReferences.ReferenceOrder AS ReferenceOrder,
	SalesOrder.Organization AS Organization
INTO SalesOrders
FROM
	InformationRegister.ShipmentAndReturnReferencesToFulfill AS ShipmentReferences
	INNER JOIN Document.SalesOrder AS SalesOrder
	ON &amp;PlannedSales
		AND SalesOrder.Ref = ShipmentReferences.ReferenceOrder
		AND SalesOrder.BusinessOperation &lt;&gt; VALUE(Enum.BusinessTransactions.TransferToCommissionAgent)
		AND SalesOrder.BusinessOperation &lt;&gt; VALUE(Enum.BusinessTransactions.ProductionByToller2_5)
		
{WHERE
	(SalesOrder.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ShipmentReferences.ReferenceOrder AS SalesOrder,
	ShipmentReferences.RowCode AS RowCode,
	MAX(CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		ISNULL(CostOfProducts.Cost, 0) + ISNULL(CostOfProducts.AdditionalExpenseCost, 0)
	WHEN &amp;ReportData = 2 THEN
		ISNULL(CostOfProducts.CostExcludingVAT, 0) + ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0)
	WHEN &amp;ReportData = 3 THEN
		ISNULL(CostOfProducts.CostMan, 0) + ISNULL(CostOfProducts.AddExpensesMan, 0)
	WHEN &amp;ReportData = 4 THEN
		ISNULL(CostOfProducts.LocalCost, 0) + ISNULL(CostOfProducts.AddExpensesLocal, 0)
	ELSE
		CASE WHEN &amp;ByEnterprise THEN
			ISNULL(CostOfProducts.CostExcludingVAT, 0) + ISNULL(CostOfProducts.AdditionalExpensesCostExcludingVAT, 0)
		ELSE
			ISNULL(CostOfProducts.CostMan, 0) + ISNULL(CostOfProducts.AddExpensesMan, 0)
		END
	END) AS Price
INTO CostOfProducts
FROM
	AccumulationRegister.ShipmentAndReturnReferences AS ShipmentReferences
		INNER JOIN SalesOrders AS SalesOrders
		ON ShipmentReferences.ReferenceOrder = SalesOrders.ReferenceOrder
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS RegisterAnalysisOfProductAccounting
		ON ShipmentReferences.Warehouse = RegisterAnalysisOfProductAccounting.StorageLocation
			AND ShipmentReferences.Products = RegisterAnalysisOfProductAccounting.Products
			AND ShipmentReferences.Characteristic = RegisterAnalysisOfProductAccounting.Characteristic
		LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON (RegisterAnalysisOfProductAccounting.DimensionKey = CostOfProducts.ItemsLocationAttributes)
			AND SalesOrders.Organization = CostOfProducts.Organization
			AND (BEGINOFPERIOD(ShipmentReferences.Period, MONTH) = CostOfProducts.Period)

GROUP BY
	ShipmentReferences.ReferenceOrder,
	ShipmentReferences.RowCode

INDEX BY
	SalesOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	T.ReferenceOrder AS OrderDocument,
	T.SecondPeriod AS SecondPeriod,
	T.MonthPeriod AS MonthPeriod,
	T.DayPeriod AS DayPeriod,
	T.WeekPeriod AS WeekPeriod,
	T.TenDaysPeriod AS TenDaysPeriod,
	T.QuarterPeriod AS QuarterPeriod,
	T.HalfYearPeriod AS HalfYearPeriod,
	T.YearPeriod AS YearPeriod,
	T.RowCode AS RowCode,
	T.ReferenceOrder AS ReferenceOrder,
	SUM(CASE
		WHEN T.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister)
			THEN T.CountTurnover
		WHEN T.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
			THEN -T.CountTurnover
		ELSE 0
	END) AS ToRegisterTurnover
INTO ShippingOrdersTurnover
FROM
	AccumulationRegister.ShipmentAndReturnReferences.Turnovers(
			,, Auto,
			ReferenceOrder IN(
				SELECT
					SalesOrders.ReferenceOrder
				FROM
					SalesOrders AS SalesOrders)
				AND Factor IN
					(VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister),
						VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1))) AS T
GROUP BY
	T.ReferenceOrder,
	T.SecondPeriod,
	T.MonthPeriod,
	T.DayPeriod,
	T.WeekPeriod,
	T.TenDaysPeriod,
	T.QuarterPeriod,
	T.HalfYearPeriod,
	T.YearPeriod,
	T.RowCode
HAVING
	SUM(CASE
		WHEN T.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToRegister)
			THEN T.CountTurnover
		WHEN T.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Issued_1)
			THEN -T.CountTurnover
		ELSE 0
	END) &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	&amp;LineFutureSales AS Section,
	&amp;RevenueLine_ AS StandardSection,
	TRUE AS ThisIsIncome,
	CASE 
		WHEN &amp;ReportData = 4
			THEN OrderHeader_.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	VALUE(ChartOfCharacteristicTypes.IncomeItems.SalesRevenue) AS IncomeItem,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	
	OrderHeader_.Organization,
	OrderHeader_.Department AS Department,
	OrderHeader_.LineOfBusiness AS LineOfBusiness,
	OrderHeader_.Partner,
	OrderHeader_.SalesOpportunity AS DealWithCustomers,
	OrderHeader_.Ref AS Recorder,	
	T.ReferenceOrder AS OrderDocument,
	
	T.SecondPeriod AS SecondPeriod,
	T.MonthPeriod AS MonthPeriod,
	T.DayPeriod AS DayPeriod,
	T.WeekPeriod AS WeekPeriod,
	T.TenDaysPeriod AS TenDaysPeriod,
	T.QuarterPeriod AS QuarterPeriod,
	T.HalfYearPeriod AS HalfYearPeriod,
	T.YearPeriod AS YearPeriod,
	DATETIME(1,1,1) AS VariancePeriod,
	
	CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		OrderLines_.AmountIncludingVAT * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 2 OR &amp;ReportData = 3 THEN
		(OrderLines_.AmountIncludingVAT - OrderLines_.VATAmount) * ExchangeRates.ManConversionFactor
	WHEN &amp;ReportData = 4 THEN
		(OrderLines_.AmountIncludingVAT - OrderLines_.VATAmount) * ExchangeRates.LocalConversionRatio
	ELSE
		(OrderLines_.AmountIncludingVAT - OrderLines_.VATAmount) * ExchangeRates.ManConversionFactor
	END * (T.ToRegisterTurnover / OrderLines_.Count) AS IncomeAmount,
	0 AS ExpenseAmount
FROM
	ShippingOrdersTurnover AS T
	INNER JOIN Document.SalesOrder AS OrderHeader_
		ON T.ReferenceOrder = OrderHeader_.Ref
	INNER JOIN Document.SalesOrder.Goods AS OrderLines_
	ON T.ReferenceOrder = OrderLines_.Ref
		AND T.RowCode = OrderLines_.RowCode
		AND OrderLines_.DateOfShipment &gt;= &amp;BeginOfPeriod AND OrderLines_.DateOfShipment &lt;= &amp;EndOfPeriod
	LEFT JOIN ExchangeRates AS ExchangeRates
	ON OrderHeader_.Currency = ExchangeRates.Currency
		AND OrderHeader_.Organization.LocalAccountingCurrency = ExchangeRates.BaseCurrency

UNION ALL

SELECT
	&amp;LineFutureSales AS Section,
	&amp;LineExpenses AS StandardSection,
	FALSE AS ThisIsIncome,
	CASE 
		WHEN &amp;ReportData = 4
			THEN OrderHeader_.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	VALUE(ChartOfCharacteristicTypes.IncomeItems.EmptyRef) AS IncomeItem,
	&amp;LineCostOfSalesPreliminary AS ExpenseItem,
	
	OrderHeader_.Organization AS Organization,
	OrderHeader_.Department AS Department,
	OrderHeader_.LineOfBusiness AS LineOfBusiness,	
	OrderHeader_.Partner AS Partner,	
	OrderHeader_.SalesOpportunity AS DealWithCustomers,	
	T.ReferenceOrder AS Recorder,
	OrderHeader_.Ref AS OrderDocument,
	
	T.SecondPeriod AS SecondPeriod,
	T.MonthPeriod AS MonthPeriod,
	T.DayPeriod AS DayPeriod,
	T.WeekPeriod AS WeekPeriod,
	T.TenDaysPeriod AS TenDaysPeriod,
	T.QuarterPeriod AS QuarterPeriod,
	T.HalfYearPeriod AS HalfYearPeriod,
	T.YearPeriod AS YearPeriod,
	DATETIME(1,1,1) AS VariancePeriod,
	
	0 AS IncomeAmount,
	ISNULL(CostOfProducts.Price, 0) * T.ToRegisterTurnover AS ExpenseAmount
FROM
	ShippingOrdersTurnover AS T

	INNER JOIN Document.SalesOrder AS OrderHeader_
	ON T.ReferenceOrder = OrderHeader_.Ref
	
	INNER JOIN Document.SalesOrder.Goods AS OrderLines_
	ON T.ReferenceOrder = OrderLines_.Ref
		AND T.RowCode = OrderLines_.RowCode
		AND OrderLines_.DateOfShipment &gt;= &amp;BeginOfPeriod AND OrderLines_.DateOfShipment &lt;= &amp;EndOfPeriod
			
	LEFT JOIN CostOfProducts AS CostOfProducts
	ON T.ReferenceOrder = CostOfProducts.SalesOrder
		AND T.RowCode = CostOfProducts.RowCode
WHERE
	ISNULL(CostOfProducts.Price, 0) * T.ToRegisterTurnover &gt; 0
</query>
		</item>
