			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	&amp;LineOfSale AS Section,
	&amp;RevenueLine_ AS StandardSection,
	TRUE AS ThisIsIncome,
	CASE 
		WHEN &amp;ReportData = 4
			THEN RegisterAccountingAnalyticsForPartners.Organization.LocalAccountingCurrency
		ELSE &amp;ManagementAccountingCurrency
	END AS Currency,
	
	VALUE(ChartOfCharacteristicTypes.IncomeItems.SalesRevenue) AS IncomeItem,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	
	RegisterAccountingAnalyticsForPartners.Organization,
	RevenueAndCOGS.Department,
	RevenueAndCOGS.CounterpartyLineOfBusiness AS LineOfBusiness,

	RevenueAndCOGS.Warehouse,

	CASE
		WHEN RevenueAndCOGS.SalesOrder REFS Document.SalesOrder
				OR RevenueAndCOGS.SalesOrder REFS Document.RequestForReturnOfGoodsFromCustomer
				OR RevenueAndCOGS.SalesOrder REFS Document.CustomerInvoice
			THEN CASE
					WHEN RevenueAndCOGS.SalesOrder = VALUE(Document.SalesOrder.EmptyRef)
							OR RevenueAndCOGS.SalesOrder = VALUE(Document.RequestForReturnOfGoodsFromCustomer.EmptyRef)
							OR RevenueAndCOGS.SalesOrder = VALUE(Document.CustomerInvoice.EmptyRef)
						THEN VALUE(Document.SalesOrder.EmptyRef)
					ELSE RevenueAndCOGS.SalesOrder
				END
		ELSE VALUE(Document.SalesOrder.EmptyRef)
	END AS OrderDocument,
	CASE
		WHEN RevenueAndCOGS.SalesOrder.SalesOpportunity = VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
				OR RevenueAndCOGS.SalesOrder.SalesOpportunity IS NULL 
			THEN VALUE(Catalog.SalesOpportunitiesToCustomer.EmptyRef)
		ELSE RevenueAndCOGS.SalesOrder.SalesOpportunity
	END AS DealWithCustomers,
	
	RevenueAndCOGS.Manager,
	RegisterAccountingAnalyticsForPartners.Partner,
	RevenueAndCOGS.Terms,
	RevenueAndCOGS.Contract,
	
	InventoryLocationAttributeKeys.Products,

	RevenueAndCOGS.MonthPeriod AS MonthPeriod,
	RevenueAndCOGS.DayPeriod AS DayPeriod,
	RevenueAndCOGS.WeekPeriod AS WeekPeriod,
	RevenueAndCOGS.TenDaysPeriod AS TenDaysPeriod,
	RevenueAndCOGS.QuarterPeriod AS QuarterPeriod,
	RevenueAndCOGS.HalfYearPeriod AS HalfYearPeriod,
	RevenueAndCOGS.YearPeriod AS YearPeriod,
	RevenueAndCOGS.SecondPeriod AS SecondPeriod,
	
	DATETIME(1,1,1) AS VariancePeriod,
	
	CASE
		WHEN RevenueAndCOGS.Recorder = UNDEFINED
			THEN NULL
		ELSE RevenueAndCOGS.Recorder
	END AS Recorder,

	0 AS IncomeBalanceOfThePreviousPeriod,
	
	CASE WHEN &amp;ReportData = 1 OR &amp;ManagementAccountingOnly THEN
		RevenueAndCOGS.RevenueAmountTurnover
	WHEN &amp;ReportData = 2 OR &amp;ReportData = 3 THEN
		RevenueAndCOGS.RevenueAmountExcludingVATTurnover 
	WHEN &amp;ReportData = 4 THEN
		RevenueAndCOGS.RevenueAmountExclVATLocalTurnover 
	ELSE
		RevenueAndCOGS.RevenueAmountExcludingVATTurnover
	END AS IncomeAmount,
	CASE
		WHEN FinancialResults.IncomeTurnover IS NULL THEN 0
		ELSE RevenueAndCOGS.RevenueAmountTurnover
	END AS AllocatedIncome,
	CASE
		WHEN NOT FinancialResults.IncomeTurnover IS NULL THEN 0
		ELSE RevenueAndCOGS.RevenueAmountTurnover
	END AS NotAllocatedIncome
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(, , Auto,
		InventoryType &lt;&gt; VALUE(Enum.InventoryTypes.ConsignedGoods)
	) AS RevenueAndCOGS
		LEFT JOIN InformationRegister.AccountingDimensionByPartners AS RegisterAccountingAnalyticsForPartners
			ON RevenueAndCOGS.AccountingDimensionByPartners = RegisterAccountingAnalyticsForPartners.DimensionKey
		LEFT JOIN AccumulationRegister.FinancialResults.Turnovers(, , Auto, IncomeItem = VALUE(ChartOfCharacteristicTypes.IncomeItems.SalesRevenue)) AS FinancialResults
		ON RevenueAndCOGS.Department = FinancialResults.Department
			AND RegisterAccountingAnalyticsForPartners.Organization = FinancialResults.Organization
			AND RevenueAndCOGS.MonthPeriod = FinancialResults.MonthPeriod
		{LEFT JOIN Catalog.InventoryLocationAttributeKeys AS InventoryLocationAttributeKeys
		ON RevenueAndCOGS.ItemsLocationAttributes = InventoryLocationAttributeKeys.Ref}
WHERE
	(&amp;ShowSales_ = 1
				AND (RegisterAccountingAnalyticsForPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
					OR RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
						AND RevenueAndCOGS.BusinessOperation = VALUE(Enum.BusinessTransactions.ConsignmentReportFromCustomer)
					)
			OR &amp;ShowSales_ = 2
				AND RegisterAccountingAnalyticsForPartners.Partner = VALUE(Catalog.Partners.OurEnterprise)
			OR &amp;ShowSales_ = 0)
{WHERE
	(RegisterAccountingAnalyticsForPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	((InventoryLocationAttributeKeys.Products, InventoryLocationAttributeKeys.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}</query>
		</item>
