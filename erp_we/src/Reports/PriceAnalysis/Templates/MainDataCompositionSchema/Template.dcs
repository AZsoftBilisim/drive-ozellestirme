		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	VALUE (Document.SalesOrder.EmptyRef)                 AS Ref,
	VALUE (Document.SalesOrder.EmptyRef)                 AS Document,
	DATETIME(1,1,1)                                              AS Date,
	VALUE (Catalog.Currencies.EmptyRef)                     AS Currency,
	NULL                                                          AS LineNumber,
	VALUE (Catalog.Products.EmptyRef)               AS Products,
	VALUE (Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	VALUE (Catalog.PackagesAndUnitsOfMeasure.EmptyRef)       AS Package,
	0                                                             AS Price,
	0                                                             AS DiscountedPrice_
INTO PreliminaryDataOfDocuments

;
// The symbol is needed to dynamically replace the query text above %1

////////////////////////////////////////////////////////////////////////////////
// EXCHANGE RATES /////////////////////////////////////////////////////////////////

SELECT ALLOWED
	CurrencyRatesCut.Currency    AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO CurrencyRatesCut
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;ReportDate}, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
INDEX BY
	Currency
;

////////////////////////////////////////////////////////////////////////////////
// DOCUMENTS WITH PRICES IN THE REQUIRED CURRENCY /////////////////////////////////////

SELECT ALLOWED
	PreliminaryDataOfDocuments.Ref          AS Ref,
	PreliminaryDataOfDocuments.Document        AS Document,
	PreliminaryDataOfDocuments.Date            AS Date,
	CASE
		WHEN
			&amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
		THEN
			PreliminaryDataOfDocuments.Currency
		ELSE
			&amp;Currency
	END AS Currency,
	PreliminaryDataOfDocuments.LineNumber     AS LineNumber,
	PreliminaryDataOfDocuments.Products    AS Products,
	PreliminaryDataOfDocuments.Characteristic  AS Characteristic,
	PreliminaryDataOfDocuments.Package        AS Package,
	CASE
		WHEN
			&amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
			OR &amp;Currency = PreliminaryDataOfDocuments.Currency
		THEN
			PreliminaryDataOfDocuments.Price
		ELSE
			CAST(PreliminaryDataOfDocuments.Price *
				CASE
					WHEN ISNULL(CurrencyExchangeRateOfSliceReport.CourseDenominator, 0) &gt; 0
						AND ISNULL(CurrencyExchangeRateOfSliceReport.CourseNumerator, 0) &gt; 0
						AND ISNULL(CurrencyExchangeRateOfDocumentSlice.CourseDenominator, 0) &gt; 0
						AND ISNULL(CurrencyExchangeRateOfDocumentSlice.CourseNumerator, 0) &gt; 0
					THEN
						(CurrencyExchangeRateOfDocumentSlice.CourseNumerator * CurrencyExchangeRateOfSliceReport.CourseDenominator)
						/ (CurrencyExchangeRateOfSliceReport.CourseNumerator * CurrencyExchangeRateOfDocumentSlice.CourseDenominator)
					ELSE
						0
				END AS NUMBER(31,2))
	END AS Price,
	CASE
		WHEN
			&amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
			OR &amp;Currency = PreliminaryDataOfDocuments.Currency
		THEN
			PreliminaryDataOfDocuments.DiscountedPrice_
		ELSE
			CAST(PreliminaryDataOfDocuments.DiscountedPrice_ *
				CASE
					WHEN ISNULL(CurrencyExchangeRateOfSliceReport.CourseDenominator, 0) &gt; 0
						AND ISNULL(CurrencyExchangeRateOfSliceReport.CourseNumerator, 0) &gt; 0
						AND ISNULL(CurrencyExchangeRateOfDocumentSlice.CourseDenominator, 0) &gt; 0
						AND ISNULL(CurrencyExchangeRateOfDocumentSlice.CourseNumerator, 0) &gt; 0
					THEN
						(CurrencyExchangeRateOfDocumentSlice.CourseNumerator * CurrencyExchangeRateOfSliceReport.CourseDenominator)
						/ (CurrencyExchangeRateOfSliceReport.CourseNumerator * CurrencyExchangeRateOfDocumentSlice.CourseDenominator)
					ELSE
						0
				END AS NUMBER(31,2))
	END AS DiscountedPrice_
INTO DocumentsData
FROM
	PreliminaryDataOfDocuments AS PreliminaryDataOfDocuments
LEFT JOIN
	CurrencyRatesCut AS CurrencyExchangeRateOfDocumentSlice
ON
	PreliminaryDataOfDocuments.Currency = CurrencyExchangeRateOfDocumentSlice.Currency
LEFT JOIN
	CurrencyRatesCut AS CurrencyExchangeRateOfSliceReport
ON
	CurrencyExchangeRateOfSliceReport.Currency = &amp;Currency
INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
// PRICES AND OTHER PARAMETERS OF THE NOMENCLATURE OF PARTNERS //////////////////////////////

SELECT ALLOWED
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products            AS Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic          AS Characteristic,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Partner                 AS Partner,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind       AS VendorPriceKind,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PartnerProducts  AS PartnerProducts,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Period                  AS RegistrationDate,
	DocumentsData.Currency                                          AS Currency,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Recorder             AS Recorder,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Recorder.Comment AS Comment,
	CAST(ISNULL(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Price,0)
			/ ISNULL(&amp;QueryTextPackagingFactor1,1)
				* CASE
					WHEN
						DocumentsData.Package &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
					THEN
						&amp;QueryTextPackagingFactor2
					ELSE
						1
				END
				* CASE
					WHEN
						PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency &lt;&gt; DocumentsData.Currency
					THEN 
						CASE
							WHEN ISNULL(CurrencyExchangeRateOfDocumentSlice.CourseDenominator, 0) &gt; 0
								AND ISNULL(CurrencyExchangeRateOfDocumentSlice.CourseNumerator, 0) &gt; 0
								AND ISNULL(CurrencyRatePricesCut.CourseDenominator, 0) &gt; 0
								AND ISNULL(CurrencyRatePricesCut.CourseNumerator, 0) &gt; 0
							THEN 
								(CurrencyRatePricesCut.CourseNumerator * CurrencyExchangeRateOfDocumentSlice.CourseDenominator)
								/ (CurrencyExchangeRateOfDocumentSlice.CourseNumerator * CurrencyRatePricesCut.CourseDenominator)
							ELSE
								0
						END
					ELSE 
						1
				END AS NUMBER(31,2))             AS SupplierPrice

INTO PricesOfSupplierNomenclatureCrossSectionOfTheLatest
FROM
	DocumentsData AS DocumentsData
LEFT JOIN
	InformationRegister.ItemsPricesOfVendor.SliceLast ({ENDOFPERIOD(&amp;ReportDate, DAY)},
		(Products, Characteristic) IN
		(SELECT
			DocumentsData.Products,
			DocumentsData.Characteristic
		FROM
			DocumentsData AS DocumentsData)
	) AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
ON
	DocumentsData.Products = PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products
	AND DocumentsData.Characteristic = PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic
	
LEFT JOIN
	CurrencyRatesCut AS CurrencyExchangeRateOfDocumentSlice
ON
	DocumentsData.Currency = CurrencyExchangeRateOfDocumentSlice.Currency
LEFT JOIN
	CurrencyRatesCut AS CurrencyRatePricesCut
ON
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency = CurrencyRatePricesCut.Currency
INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
// AGGREGATE VALUES OF PRICES AND OTHER PARAMETERS OF THE NOMENCLATURE OF PARTNERS //////////

SELECT ALLOWED
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products   AS Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic AS Characteristic,
	
	MIN (PricesOfSupplierNomenclatureCrossSectionOfTheLatest.SupplierPrice)          AS MinimumSuppliersPrice,
	MAX (PricesOfSupplierNomenclatureCrossSectionOfTheLatest.SupplierPrice)         AS MaximumSupplierPrice,
	AVG (PricesOfSupplierNomenclatureCrossSectionOfTheLatest.SupplierPrice)          AS AverageSupplierPrice
	
INTO SummaryData
FROM
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest

GROUP BY
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic
INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
// THE RESULTING QUERY ///////////////////////////////////////////////////////

SELECT ALLOWED
	DocumentsData.Ref          AS Ref,
	DocumentsData.Document        AS Document,
	DocumentsData.Date            AS DocumentDate,
	CASE
		WHEN
			&amp;Currency = VALUE(Catalog.Currencies.EmptyRef)
		THEN
			DocumentsData.Currency
		ELSE
			&amp;Currency
	END AS Currency,
	DocumentsData.LineNumber     AS LineNumber,
	DocumentsData.Products    AS Products,
	DocumentsData.Characteristic  AS Characteristic,
	DocumentsData.Package        AS Package,
	DocumentsData.Price            AS Price,
	DocumentsData.DiscountedPrice_   AS DiscountedPrice_,
	
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.VendorPriceKind      AS VendorPriceKind,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Partner                AS Partner,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.SupplierPrice         AS SupplierPrice,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.PartnerProducts AS PartnerProducts,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.RegistrationDate        AS RegistrationDate,
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Recorder            AS VendorPriceList,
	CAST(PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Comment   AS STRING(1000)) AS Comment,
	
	SummaryData.MinimumSuppliersPrice                       AS MinimumSuppliersPrice,
	SummaryData.MaximumSupplierPrice                      AS MaximumSupplierPrice,
	SummaryData.AverageSupplierPrice                           AS AverageSupplierPrice
{SELECT
	SupplierPrice,
	PartnerProducts.*,
	RegistrationDate,
	VendorPriceList.*,
	Comment,
	MinimumSuppliersPrice,
	AverageSupplierPrice,
	MaximumSupplierPrice}
	
FROM
	DocumentsData AS DocumentsData
INNER JOIN
	PricesOfSupplierNomenclatureCrossSectionOfTheLatest AS PricesOfSupplierNomenclatureCrossSectionOfTheLatest
ON
	DocumentsData.Products = PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Products
	AND DocumentsData.Characteristic = PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Characteristic
	AND DocumentsData.Currency = PricesOfSupplierNomenclatureCrossSectionOfTheLatest.Currency
LEFT JOIN
	SummaryData
ON
	DocumentsData.Products = SummaryData.Products
	AND DocumentsData.Characteristic = SummaryData.Characteristic</query>
	</dataSet>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Min(Price)</expression>
	</totalField>
	<totalField>
		<dataPath>RegistrationDate</dataPath>
		<expression>Min(RegistrationDate)</expression>
	</totalField>
	<totalField>
		<dataPath>Comment</dataPath>
		<expression>Min(Comment)</expression>
	</totalField>
	<totalField>
		<dataPath>DocumentDate</dataPath>
		<expression>Min(DocumentDate)</expression>
	</totalField>
	<totalField>
		<dataPath>MaximumSupplierPrice</dataPath>
		<expression>Min(MaximumSupplierPrice)</expression>
	</totalField>
	<totalField>
		<dataPath>MinimumSuppliersPrice</dataPath>
		<expression>Min(MinimumSuppliersPrice)</expression>
	</totalField>
	<totalField>
		<dataPath>AverageSupplierPrice</dataPath>
		<expression>Min(AverageSupplierPrice)</expression>
	</totalField>
	<totalField>
		<dataPath>SupplierPrice</dataPath>
		<expression>Min(SupplierPrice)</expression>
	</totalField>
	<totalField>
		<dataPath>DiscountedPrice_</dataPath>
		<expression>Min(DiscountedPrice_)</expression>
	</totalField>
