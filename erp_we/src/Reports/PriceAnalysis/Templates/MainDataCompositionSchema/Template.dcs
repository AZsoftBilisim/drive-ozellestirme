							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Pokaż typy cen dostępne do kupienia</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Показывать виды цен, доступные для закупки</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Tedarik için uygun fiyat türlerini göster</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Hiển thị dạng giá có sẵn để mua</v8:content>
							</v8:item>
						</dcsset:presentation>
						<dcsset:userSettingID>64d291f7-978d-4623-82ea-5f6f2869b277</dcsset:userSettingID>
					</dcsset:item>
					<dcsset:item xsi:type="dcsset:FilterItemComparison">
						<dcsset:left xsi:type="dcscor:Field">VendorPriceKind.AvailableForSaleToCustomers</dcsset:left>
						<dcsset:comparisonType>Equal</dcsset:comparisonType>
						<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
						<dcsset:presentation xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>en</v8:lang>
								<v8:content>Vendor</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>تأمین‌کننده</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
								<v8:content>Visualizza i tipi di prezzi disponibili per i clienti (il fornitore risulta un concorrente)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>pl</v8:lang>
								<v8:content>Pokaż typy cen dostępne dla klientów (dostawca jest konkurentem)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>Показывать виды цен, доступные для клиентов (поставщик является конкурентом)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>tr</v8:lang>
								<v8:content>Müşteri için uygun fiyat türlerini göster (rakip tedarikçi)</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>vi</v8:lang>
								<v8:content>Hiển thị dạng giá có sẵn cho khách hàng (nhà cung cấp là đối thủ cạnh tranh)</v8:content>
							</v8:item>
						</dcsset:presentation>
						<dcsset:userSettingID>5dda6657-d346-4895-8676-dcc0fa80530d</dcsset:userSettingID>
					</dcsset:item>
				</dcsset:item>
			</dcsset:filter>
