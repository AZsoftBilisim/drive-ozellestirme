								<v8:content>Show price types available for purchase</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>fa</v8:lang>
								<v8:content>نمایش انواع قیمت در دسترس برای خرید</v8:content>
							</v8:item>
							<v8:item>
								<v8:lang>it</v8:lang>
