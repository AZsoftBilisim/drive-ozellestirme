				</v8:item>
			</title>
			<presentationExpression>Case
	When TechnologicalProcessType = Value(Enum.TechnologicalProcessTypesOfStage.Individual_)
		Then "Individual_"
	Else
		TechnologicalProcess
End
</presentationExpression>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>MaxWidth</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">25</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>TechnologicalProcessType</dataPath>
			<field>TechnologicalProcessType</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Technological process type</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>نوع فرایند فناوری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Тип технологического процесса</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Teknolojik süreç tipi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kiểu quy trình kỹ thuật</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Technological process type</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Technological process type</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:EnumRef.TechnologicalProcessTypesOfStage</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ProductionStageStates.Stage.ProductionLot AS ProductionLot,
	ProductionStageStates.Stage                    AS Stage,
	ProductionStageStates.SupplyState = VALUE(Enum.SupplyStateOfProductionStage.PendingSupply) AS RequiresSupply
INTO TTBatchesInProduction
FROM
	InformationRegister.ProductionStageStates AS ProductionStageStates
WHERE
	ProductionStageStates.StateAtIntershopLevel IN (
			VALUE(Enum.StateOfProductionStagesAtIntershopLevel.ReadyForFulfillment),
			VALUE(Enum.StateOfProductionStagesAtIntershopLevel.PendingStart),
			VALUE(Enum.StateOfProductionStagesAtIntershopLevel.PendingCompletion))
	AND TRUE IN
			(SELECT TOP 1
				TRUE
			FROM
				Document.ProductionStage2_2 AS StagesStarted
			WHERE
				StagesStarted.ProductionLot = ProductionStageStates.Stage.ProductionLot
				AND StagesStarted.Status IN (
					VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
					VALUE(Enum.StatusesOfProductionStages2_2.Completed))
				AND StagesStarted.Posted)
{WHERE
	ProductionStageStates.ReferenceOrder.* AS ReferenceOrder,
	ProductionStageStates.Stage.ProductionLot.LineOfBusiness.* AS LineOfBusiness,
	ProductionStageStates.Stage.ProductionLot.MainProductProducts.* AS Products,
	ProductionStageStates.Stage.Department.* AS Department}
INDEX BY SETS (
	(ProductionLot),
	(Stage)
)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Stages.ProductionLot AS ProductionLot,
	Stages.Ref             AS Ref
INTO TTStagesOfParties
FROM
	Document.ProductionStage2_2 AS Stages
WHERE
	Stages.ProductionLot IN (
		SELECT
			T.ProductionLot
		FROM
			TTBatchesInProduction AS T)
INDEX BY
	Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Stages.ProductionLot                               AS ProductionLot,
	Stages.ProductionLot.MainProductProducts   AS Products,
	Stages.ProductionLot.MainProductCharacteristic AS Characteristic,
	Stages.ReferenceOrder                      AS ReferenceOrder,
	Stages.Ref                            AS Ref,
	Stages.Status                            AS Status,
	Stages.Department                     AS Department,
	Stages.DynamicStructure             AS DynamicStructure,
	Stages.ProductionProcessType      AS ProductionProcessType,
	Stages.NumberOfPackagesReal            AS NumberOfPackagesReal,
	Stages.NumberOfPackagesPlan            AS NumberOfPackagesPlan,
	Stages.PackageActualData                      AS PackageActualData,
	Stages.PackagePlan                      AS PackagePlan,
	ISNULL(&amp;PackagingFactorFact, 1)   AS PackagingFactorFact,
	ISNULL(&amp;PackagingFactorPlan, 1)   AS PackagingFactorPlan,
	Stages.UnitOfMeasureOfStageDuration AS UnitOfMeasureOfStageDuration,
	Stages.StageDuration                 AS StageDuration,
	Stages.ActualStageStart            AS ActualStageStart,
	Stages.StartingLotStageNumber          AS StartingLotStageNumber,
	CASE
		WHEN Stages.DynamicStructure OR &amp;TheProductionScheduleIsPlanned
			THEN ISNULL(ProductionSchedule.Begin, DATETIME(1,1,1))
		WHEN &amp;ThereIsRegulatorySchedule
			THEN &amp;NormativeScheduleIsBeginning
		ELSE DATETIME(1,1,1)
	END                                   AS Begin,
	CASE
		WHEN Stages.DynamicStructure OR &amp;TheProductionScheduleIsPlanned
			THEN ISNULL(ProductionSchedule.Ending, DATETIME(1,1,1))
		WHEN &amp;ThereIsRegulatorySchedule
			THEN &amp;RegulatoryScheduleEnd
		ELSE DATETIME(1,1,1)
	END                                   AS Ending,
	&amp;PresentationStage                     AS PresentationStage,
	&amp;TechnologicalProcessType            AS TechnologicalProcessType,
	&amp;TechnologicalProcess                 AS TechnologicalProcess
INTO TTStages
FROM
	TTStagesOfParties AS StagesOfParties
	
	INNER JOIN Document.ProductionStage2_2 AS Stages
	ON StagesOfParties.Ref = Stages.Ref
		AND Stages.Posted
		
	{LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS StandardProductionSchedule
	ON Stages.Ref = StandardProductionSchedule.ProductionStage
		AND Stages.ReferenceOrder = StandardProductionSchedule.ReferenceOrder}
	
	LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ProductionSchedule
	ON Stages.ReferenceOrder = ProductionSchedule.ProductionOrder
		AND Stages.Ref = ProductionSchedule.Stage
		AND ProductionSchedule.ScheduleStatus = 0
	
	{LEFT JOIN InformationRegister.TechnologicalProcessesOfProductionStages AS TechnicalProcess
	ON Stages.Ref = TechnicalProcess.Stage}

INDEX BY SETS (
	(ProductionLot),
	(Ref),
	(Ref, Products, Characteristic)
)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Table.ProductionLot AS ProductionLot,
	CASE
		WHEN Table.Stages_Completed &lt;&gt; Table.TotalStages
			THEN CASE
					WHEN Table.Total_Duration_ &lt;&gt; Table.Completed_Duration
							OR Table.Total_Duration_ = 0
						THEN CASE
								WHEN Table.Total_Duration_ &lt;&gt; 0
									THEN CASE
											WHEN Table.Completed_Duration &lt;&gt; 0
												THEN CAST(Table.Completed_Duration / Table.Total_Duration_ * 100 AS NUMBER(10, 0))
											WHEN Table.Completed_Duration = 0
													AND Table.Stages_Completed &lt;&gt; 0
												THEN 1
											ELSE 0
										END
								ELSE CAST(Table.CompletedQuantityPercentage / Table.TotalStages * 100 AS NUMBER(10, 0))
							END
					ELSE 99
				END
		ELSE 100
	END                                    AS ProgressPercent,
	Table.BatchLaunch                     AS BatchLaunch,
	Table.BatchRelease                     AS BatchRelease,
	Table.ActualStartOfParty          AS ActualStartOfParty,
	Table.CurStageNumberInLaunchBatch AS CurStageNumberInLaunchBatch
INTO TTAttributesOfParties
FROM
	(
		SELECT
			Stages.ProductionLot AS ProductionLot,
			SUM(
				CASE
					WHEN Stages.NumberOfPackagesReal &gt; 0
						AND Stages.NumberOfPackagesPlan &gt; 0
						AND Stages.PackagePlan = Stages.PackageActualData
						THEN Stages.NumberOfPackagesReal / Stages.NumberOfPackagesPlan
					WHEN Stages.NumberOfPackagesReal &gt; 0
						AND Stages.NumberOfPackagesPlan &gt; 0 
						THEN (Stages.NumberOfPackagesReal * Stages.PackagingFactorFact) / (Stages.NumberOfPackagesPlan * Stages.PackagingFactorPlan)
					ELSE 0
				END) AS CompletedQuantityPercentage,
			SUM(
				CASE
					WHEN Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
						THEN 1
					ELSE 0
				END) AS Stages_Completed,
			COUNT(Stages.Ref) AS TotalStages,
			SUM(
				CASE Stages.UnitOfMeasureOfStageDuration
					WHEN VALUE(Enum.TimeMeasureUnits.MINUTE)
						THEN 60
					WHEN VALUE(Enum.TimeMeasureUnits.HOUR)
						THEN 3600
					WHEN VALUE(Enum.TimeMeasureUnits.DAY)
						THEN 86400
					WHEN VALUE(Enum.TimeMeasureUnits.Days1)
						THEN 86400
					ELSE 1
				END
				* Stages.StageDuration
				* CASE
					WHEN Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Completed)
						THEN 1
					WHEN Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Initiated)
							AND Stages.NumberOfPackagesReal &gt; 0
							AND Stages.NumberOfPackagesPlan &gt; 0
							AND Stages.PackagePlan = Stages.PackageActualData
						THEN Stages.NumberOfPackagesReal / Stages.NumberOfPackagesPlan
					WHEN Stages.Status = VALUE(Enum.StatusesOfProductionStages2_2.Initiated)
							AND Stages.NumberOfPackagesReal &gt; 0
							AND Stages.NumberOfPackagesPlan &gt; 0
						THEN (Stages.NumberOfPackagesReal * Stages.PackagingFactorFact) / (Stages.NumberOfPackagesPlan * Stages.PackagingFactorPlan)
					ELSE 0
				END) AS Completed_Duration,
			SUM(
				CASE Stages.UnitOfMeasureOfStageDuration
					WHEN VALUE(Enum.TimeMeasureUnits.MINUTE)
						THEN 60
					WHEN VALUE(Enum.TimeMeasureUnits.HOUR)
						THEN 3600
					WHEN VALUE(Enum.TimeMeasureUnits.DAY)
						THEN 86400
					WHEN VALUE(Enum.TimeMeasureUnits.Days1)
						THEN 86400
					ELSE 1
				END
				* Stages.StageDuration) AS Total_Duration_,
			MIN(
				CASE
					WHEN Stages.Begin &lt;&gt; DATETIME(1,1,1)
						THEN Stages.Begin
				END) AS BatchLaunch,
			MAX(Stages.Ending) AS BatchRelease,
			MIN(
				CASE
					WHEN Stages.ActualStageStart &lt;&gt; DATETIME(1,1,1)
						THEN Stages.ActualStageStart
				END) AS ActualStartOfParty,
			MAX(
				CASE
					WHEN LotsInProduction.Stage IS NULL
						THEN 0
					ELSE Stages.StartingLotStageNumber
				END) AS CurStageNumberInLaunchBatch
		FROM
			TTStages AS Stages
			
			LEFT JOIN TTBatchesInProduction AS LotsInProduction
			ON Stages.Ref = LotsInProduction.Stage
			
		GROUP BY
			Stages.ProductionLot
	) AS Table
	
INDEX BY
 ProductionLot
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Stages.ProductionLot          AS ProductionLot,
	Stages.Ref                      AS Ref,
	Stages.DynamicStructure       AS DynamicStructure,
	Stages.Products                AS Products,
	Stages.Characteristic              AS Characteristic,
	ManufacturedProducts.Recipient        AS Warehouse,
	ManufacturedProducts.Purpose        AS Purpose,
	ManufacturedProducts.StageConsumer   AS StageConsumer,
	SUM(ManufacturedProducts.Count) AS Count
INTO TTWares
FROM
	TTStages AS Stages
	
	INNER JOIN Document.ProductionStage2_2.ManufacturedProducts AS ManufacturedProducts
	ON Stages.Ref = ManufacturedProducts.Ref
		AND Stages.Products = ManufacturedProducts.Products
		AND Stages.Characteristic = ManufacturedProducts.Characteristic
WHERE
	NOT ManufacturedProducts.Canceled
	
GROUP BY
	Stages.ProductionLot,
	Stages.Ref,
	Stages.DynamicStructure,
	Stages.Products,
	Stages.Characteristic,
	ManufacturedProducts.Recipient,
	ManufacturedProducts.Purpose,
	ManufacturedProducts.StageConsumer

INDEX BY SETS (
	(Products, Characteristic, Ref),
	(StageConsumer)
)
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Products_1.ProductionLot          AS ProductionLot,
	Products_1.Products                AS Products,
	Products_1.Characteristic              AS Characteristic,
	OrderStructure.Warehouse               AS Warehouse,
	OrderStructure.Purpose          AS Purpose,
	OrderStructure.ProductionOrder AS ProductionOrder,
	CASE
		WHEN OrderStructure.ConnectionKeyTransfer = &amp;EmptyLinkKey
			THEN OrderStructure.KeyProducts
		ELSE OrderStructure.ConnectionKeyTransfer
	END                               AS KeyProducts
INTO TTKeysOfNomenclature
FROM
	TTWares AS Products_1
	
	INNER JOIN InformationRegister.OrderStructure AS OrderStructure
	ON Products_1.Products = OrderStructure.Products
		AND Products_1.Characteristic = OrderStructure.Characteristic
		AND Products_1.Ref = OrderStructure.ReceiptOrder
WHERE
	Products_1.DynamicStructure
	
INDEX BY
	Products, Characteristic, Warehouse, Purpose, ProductionOrder, KeyProducts
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ProductListKeys.ProductionLot AS ProductionLot,
	ProductListKeys.Purpose         AS Purpose,
	OrderStructure.KeyLot           AS KeyLot
INTO TTKeysLotReferences
FROM
	TTKeysOfNomenclature AS ProductListKeys
	
	INNER JOIN InformationRegister.OrderStructure AS OrderStructure
	ON ProductListKeys.Products = OrderStructure.Products
		AND ProductListKeys.Characteristic = OrderStructure.Characteristic
		AND ProductListKeys.Warehouse = OrderStructure.Warehouse
		AND ProductListKeys.Purpose = OrderStructure.Purpose
		AND ProductListKeys.ProductionOrder = OrderStructure.ProductionOrder
		AND ProductListKeys.KeyProducts = OrderStructure.KeyProducts

GROUP BY
	ProductListKeys.ProductionLot,
	ProductListKeys.Products,
	ProductListKeys.Characteristic,
	ProductListKeys.Warehouse,
	ProductListKeys.Purpose,
	OrderStructure.KeyLot

HAVING
	SUM(OrderStructure.ToSupply) &gt; 0

INDEX BY
	KeyLot
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PartyKeys.ProductionLot AS ProductionLot,
	PartyKeys.Purpose         AS Purpose,
	CASE
		WHEN OrderStructure.Stage REFS Document.ProductionStage2_2
			THEN OrderStructure.Stage
		ELSE VALUE(Document.ProductionStage2_2.EmptyRef)
	END                          AS Stage,
	OrderStructure.Products   AS Products,
	OrderStructure.Characteristic AS Characteristic
INTO TTConsumers
FROM
	TTKeysLotReferences AS PartyKeys
	
	INNER JOIN InformationRegister.OrderStructure AS OrderStructure
	ON PartyKeys.KeyLot = OrderStructure.KeyLot
WHERE
	OrderStructure.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.Move)

GROUP BY
	PartyKeys.ProductionLot,
	PartyKeys.Purpose,
	OrderStructure.Products,
	OrderStructure.Characteristic,
	OrderStructure.Stage	

HAVING
	SUM(OrderStructure.Scheduled) &gt; 0
	OR SUM(OrderStructure.AllocatedInFreeProductionLots) &gt; 0
	OR SUM(OrderStructure.AllocatedInAssignedProductionLots) &gt; 0

UNION ALL

SELECT DISTINCT
	Products_1.ProductionLot AS ProductionLot,
	Products_1.Purpose         AS Purpose,
	Products_1.StageConsumer    AS Stage,
	Products_1.StageConsumer.ProductionLot.MainProductProducts   AS Products,
	Products_1.StageConsumer.ProductionLot.MainProductCharacteristic AS Characteristic
FROM
	TTWares AS Products_1
WHERE
	NOT Products_1.DynamicStructure
	AND Products_1.StageConsumer &lt;&gt; VALUE(Document.ProductionStage2_2.EmptyRef)

INDEX BY
	ProductionLot
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Products_1.ProductionLot AS ProductionLot,
	SUM(Products_1.Count)  AS Count
INTO TTQuantityOfMainProduct
FROM
	TTWares AS Products_1  
	
GROUP BY
	Products_1.ProductionLot

UNION ALL

SELECT
	Stages.ProductionLot      AS ProductionLot,
	SUM(Supply.Count) AS Count
FROM
	TTStages AS Stages
	
	INNER JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS Supply
	ON Stages.Ref = Supply.Ref
		AND Stages.Products = Supply.Products
		AND Stages.Characteristic = Supply.Characteristic
		AND NOT Supply.Canceled
WHERE
	Stages.ProductionProcessType = VALUE(Enum.ProductionProcessTypes.Disassembly)
	
GROUP BY
	Stages.ProductionLot

INDEX BY
	ProductionLot
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Stages.ProductionLot                AS ProductionLot,
	Stages.ReferenceOrder                      AS ReferenceOrder,
	Stages.Ref                            AS ProductionStage,
	Stages.Department                     AS Department,
	Stages.PresentationStage                AS PresentationStage,
	Stages.TechnologicalProcessType       AS TechnologicalProcessType,
	Stages.TechnologicalProcess            AS TechnologicalProcess,
	Stages.Products                      AS Products,
	Stages.Characteristic                    AS Characteristic,
	ISNULL(QuantityOfMainProduct.Count, 0) AS Count,
	Lots.BatchLaunch                     AS BatchLaunch,
	Lots.BatchRelease                     AS BatchRelease,
	Lots.ActualStartOfParty          AS ActualStartOfParty,
	Lots.CurStageNumberInLaunchBatch AS CurStageNumberInLaunchBatch,
	Lots.ProgressPercent                AS ProgressPercent,
	LotsInProduction.RequiresSupply  AS RequiresSupply,
	CASE
		WHEN QueueOfProductionOperations.Operation = VALUE(Catalog.ManufacturingOperations.EmptyRef)
			THEN QueueOfProductionOperations.ProductionOperation
		ELSE QueueOfProductionOperations.Operation
	END                                   AS Operation,
	ConsumerList.Products                AS ProductsManufacturedProducts,
	ConsumerList.Characteristic              AS CharacteristicManufacturedProducts,
	ConsumerList.Products.Description   AS ProductsManufacturedProductsName,
	ConsumerList.Characteristic.Description AS CharacteristicManufacturedProductsName,
	ConsumerList.Purpose                  AS Purpose,
	ConsumerList.Stage                        AS StageConsumer
FROM
	TTBatchesInProduction AS LotsInProduction
	
	INNER JOIN TTAttributesOfParties AS Lots
	ON LotsInProduction.ProductionLot = Lots.ProductionLot
	
	INNER JOIN TTStages AS Stages
	ON LotsInProduction.Stage = Stages.Ref
	
	{LEFT JOIN InformationRegister.QueueOfProductionOperations AS QueueOfProductionOperations
	 ON Stages.Ref = QueueOfProductionOperations.Stage
		AND (QueueOfProductionOperations.ExecutionIsAllowed &gt; 0
			OR QueueOfProductionOperations.Running &gt; 0)}
	
	{LEFT JOIN TTQuantityOfMainProduct AS QuantityOfMainProduct
	ON LotsInProduction.ProductionLot = QuantityOfMainProduct.ProductionLot}
	
	{LEFT JOIN TTConsumers AS ConsumerList
	ON LotsInProduction.ProductionLot = ConsumerList.ProductionLot}</query>
	</dataSet>
	<calculatedField>
		<dataPath>Delay</dataPath>
		<expression>Case 
  When IsNull(BatchLaunch, DateTime(1,1,1)) = DateTime(1,1,1)
    Then 0
  When ProductionStage.Status = Value(Enum.StatusesOfProductionStages2_2.Initiated)
    Then 
      Case
        When IsNull(ActualStartOfParty, DateTime(1,1,1)) = DateTime(1,1,1)
          Then 0
        When DateDiff(BatchLaunch,ActualStartOfParty ,"Day")&gt;DateDiff(BatchRelease,CurrentSessionDate(),"Day")
            And BatchLaunch &lt; ActualStartOfParty
          Then DateDiff(BatchLaunch,ActualStartOfParty ,"Day")
        When BatchRelease &lt; CurrentSessionDate()
          Then DateDiff(BatchRelease,CurrentSessionDate(),"Day")
        Else 0
      End
  When BatchLaunch &lt; CurrentSessionDate()
    Then DateDiff(BatchLaunch,CurrentSessionDate() ,"Day")
  Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Delay</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
