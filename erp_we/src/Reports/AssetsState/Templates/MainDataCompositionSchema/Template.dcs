		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RepairFacilities.Ref AS Asset,
	RMPlanSliceLast.RMType AS LastRepairTypeOfRepair,
	RMPlanSliceLast.Period AS LastRepairDate,
	RepairFacilities.Class,
	RepairFacilities.Subclass,
	RepairFacilities.Status,
	RepairFacilities.OperatingBusinessUnit,
	RepairFacilities.RMBusinessUnit
FROM
	Catalog.Assets AS RepairFacilities
		LEFT JOIN InformationRegister.RMPlan.SliceLast({&amp;Period}, RMCycle) AS RMPlanSliceLast
		ON (RMPlanSliceLast.Asset = RepairFacilities.Ref)
WHERE
	RepairFacilities.Status IN (VALUE(Enum.AssetStatuses.InOperation))

GROUP BY
	RepairFacilities.Ref,
	RMPlanSliceLast.RMType,
	RMPlanSliceLast.Period,
	RepairFacilities.Class,
	RepairFacilities.Subclass,
	RepairFacilities.Status,
	RepairFacilities.OperatingBusinessUnit,
	RepairFacilities.RMBusinessUnit</query>
	</dataSet>
