				</v8:item>
			</title>
			<orderExpression>
				<dcscom:expression>Case When LimitPeriodicity = Value(Enum.Periodicity.Year) Then 7 When LimitPeriodicity = Value(Enum.Periodicity.HalfYear) Then 6 When LimitPeriodicity = Value(Enum.Periodicity.Quarter) Then 5 When LimitPeriodicity = Value(Enum.Periodicity.Month) Then 4 When LimitPeriodicity = Value(Enum.Periodicity.TenDays) Then 3 When LimitPeriodicity = Value(Enum.Periodicity.Week) Then 2 When LimitPeriodicity = Value(Enum.Periodicity.Day) Then 1 Else 0 End</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>false</dcscom:autoOrder>
			</orderExpression>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:EnumRef.Periodicity</v8:Type>
			</valueType>
		</field>
