	<totalField>
		<dataPath>SumPlan</dataPath>
		<expression>Sum(SumPlan)</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>SumReal</dataPath>
		<expression>Sum(SumReal)</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>overspending</dataPath>
		<expression>Case When &amp;ExplanationModeByRecorder Then 0 Else Case When Sum(SumPlan) &lt; Sum(SumReal) Then
            Sum(SumReal) - Sum(SumPlan)
        End End</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PercentageOfOverspending</dataPath>
		<expression>Case When &amp;ExplanationModeByRecorder Then 0 Else Case When Sum(SumPlan) &lt;&gt; 0 
    And Sum(SumPlan) &lt; Sum(SumReal) Then
            Round(((Sum(SumReal) - Sum(SumPlan)) / Sum(SumPlan) * 100), 2)  
	Else 0 
End End</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PlanBalance</dataPath>
		<expression>Case When &amp;ExplanationModeByRecorder Then 0 Else Case When Sum(SumPlan) &gt; Sum(SumReal) Then Sum(SumPlan) - Sum(SumReal) End End</expression>
		<group>LimitsRule</group>
	</totalField>
	<totalField>
		<dataPath>PercentageOfPlanBalance</dataPath>
		<expression>Case When &amp;ExplanationModeByRecorder Then 0 Else Case When Sum(SumPlan) &lt;&gt; 0 
    And Sum(SumPlan) &gt; Sum(SumReal) Then
           Round((Sum(SumPlan) - Sum(SumReal))
        / Sum(SumPlan) * 100, 2) Else 0 End End</expression>
		<group>LimitsRule</group>
	</totalField>
