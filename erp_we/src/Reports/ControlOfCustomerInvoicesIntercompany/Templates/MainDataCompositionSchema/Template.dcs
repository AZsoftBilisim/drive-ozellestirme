				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED
	InventoryKinds.Ref AS InventoryOwnerAttribute
INTO TypesOfStocksCommission
FROM
	Catalog.InventoryKinds AS InventoryKinds
WHERE
	InventoryKinds.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	AND NOT InventoryKinds.SaleOfAnotherCompanyInventory
	AND InventoryKinds.GoodsOwner REFS Catalog.Companies
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.Organization AS Consignee,
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	CompanyGoods.ItemsLocationAttributes.Products AS Products,
	CompanyGoods.ItemsLocationAttributes.Characteristic AS Characteristic,
	CompanyGoods.ItemsLocationAttributes.StorageLocation AS Warehouse,
	CompanyGoods.CCDNumber AS CCDNumber,
	CompanyGoods.InventoryOwnerAttribute.GoodsOwner AS Consignor,
	CASE
		WHEN CompanyGoods.Recorder = UNDEFINED
			THEN NULL
		ELSE CompanyGoods.Recorder
	END AS Recorder,
	CompanyGoods.SecondPeriod AS SecondPeriod,
	CompanyGoods.DayPeriod AS DayPeriod,
	CompanyGoods.WeekPeriod AS WeekPeriod,
	CompanyGoods.TenDaysPeriod AS TenDaysPeriod,
	CompanyGoods.MonthPeriod AS MonthPeriod,
	CompanyGoods.QuarterPeriod AS QuarterPeriod,
	CompanyGoods.HalfYearPeriod AS HalfYearPeriod,
	CompanyGoods.YearPeriod AS YearPeriod,
	CompanyGoods.CountOpeningBalance AS QuantityAcceptedOpeningBalance,
	CompanyGoods.CountReceipt AS ConsignedQuantityReceived,
	CompanyGoods.CountExpense AS QuantityToRegisterReport,
	CompanyGoods.CountClosingBalance AS QuantityAcceptedClosingBalance
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(
			,
			,
			Auto,
			,
			InventoryOwnerAttribute IN
				(SELECT
					TypesOfStocksCommission.InventoryOwnerAttribute
				FROM
					TypesOfStocksCommission AS TypesOfStocksCommission)) AS CompanyGoods</query>
			</dataSet>
			<totalField>
				<dataPath>QuantityToRegisterReport</dataPath>
				<expression>Sum(QuantityToRegisterReport)</expression>
			</totalField>
			<totalField>
				<dataPath>QuantityAcceptedClosingBalance</dataPath>
				<expression>Sum(QuantityAcceptedClosingBalance)</expression>
			</totalField>
			<totalField>
				<dataPath>ConsignedQuantityReceived</dataPath>
				<expression>Sum(ConsignedQuantityReceived)</expression>
			</totalField>
			<totalField>
				<dataPath>QuantityAcceptedOpeningBalance</dataPath>
				<expression>Sum(QuantityAcceptedOpeningBalance)</expression>
			</totalField>
