					<dataSource>DataSource1</dataSource>
					<query>SELECT ALLOWED
	ServicesForRegistration.Organization AS Consignee,
	ServicesForRegistration.Currency AS Currency,
	ServicesForRegistration.ItemsLocationAttributes.Products AS Products,
	ServicesForRegistration.ItemsLocationAttributes.Characteristic AS Characteristic,
	ServicesForRegistration.ItemsLocationAttributes.StorageLocation AS Consignor,
	ServicesForRegistration.Terms AS Terms,
		
	CASE WHEN ServicesForRegistration.Recorder = UNDEFINED THEN
		NULL
	ELSE
		ServicesForRegistration.Recorder
	END AS Recorder,
	
	ServicesForRegistration.SecondPeriod AS SecondPeriod,
	ServicesForRegistration.DayPeriod AS DayPeriod,
	ServicesForRegistration.WeekPeriod AS WeekPeriod,
	ServicesForRegistration.TenDaysPeriod AS TenDaysPeriod,
	ServicesForRegistration.MonthPeriod AS MonthPeriod,
	ServicesForRegistration.QuarterPeriod AS QuarterPeriod,
	ServicesForRegistration.HalfYearPeriod AS HalfYearPeriod,
	ServicesForRegistration.YearPeriod AS YearPeriod,
	
	ServicesForRegistration.RevenueAmountOpeningBalance AS RevenueAmountOpeningBalance,
	ServicesForRegistration.RevenueAmountReceipt AS RevenueAmountReceipt,
	ServicesForRegistration.RevenueAmountExpense AS RevenueAmountExpense,
	ServicesForRegistration.RevenueAmountClosingBalance AS RevenueAmountClosingBalance,
	
	ServicesForRegistration.CountOpeningBalance AS QuantityToRegisterOpeningBalance,
	
	ServicesForRegistration.CountReceipt AS QuantityToRegisterReceipt,
	0 AS QuantityConsumedForIncoiceRegistrationReceipt,
	
	ServicesForRegistration.CountExpense AS QuantityToRegisterExpense,
	
	ServicesForRegistration.CountClosingBalance AS QuantityToRegisterClosingBalance
	
FROM
	AccumulationRegister.ServicesForRegistrationOfReportsToPrincipal.BalanceAndTurnovers(,,Auto,,
		ItemsLocationAttributes.StorageType = VALUE(Enum.StorageLocationTypes.Organization)
	) AS ServicesForRegistration
	
WHERE
	ServicesForRegistration.CountClosingBalance &lt;&gt; 0
	OR
	ServicesForRegistration.CountExpense &lt;&gt; 0
	OR
	ServicesForRegistration.RevenueAmountClosingBalance &lt;&gt; 0
	OR
	ServicesForRegistration.RevenueAmountExpense &lt;&gt; 0</query>
				</item>
			</dataSet>
			<totalField>
				<dataPath>QuantityToRegisterClosingBalance</dataPath>
				<expression>Sum(QuantityToRegisterClosingBalance)</expression>
			</totalField>
