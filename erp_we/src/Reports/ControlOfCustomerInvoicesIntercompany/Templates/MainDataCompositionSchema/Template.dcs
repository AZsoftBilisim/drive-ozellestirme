				<dataSource>DataSource1</dataSource>
				<query>SELECT ALLOWED
	GoodsToTransfer.Organization AS Sender,
	GoodsToTransfer.ItemsLocationAttributes.Products AS Products,
	GoodsToTransfer.ItemsLocationAttributes.Characteristic AS Characteristic,
	GoodsToTransfer.ItemsLocationAttributes.StorageLocation AS Warehouse,
	GoodsToTransfer.CCDNumber AS CCDNumber,
	GoodsToTransfer.CorInventoryOwnerAttribute AS SellerInventoryOwnerAttribute,
	GoodsToTransfer.CorCompany AS Recipient,
	0 AS QuantityToTransferOpeningBalance,
	SUM(CASE
			WHEN GoodsToTransfer.Count &gt; 0
				THEN GoodsToTransfer.Count
			ELSE 0
		END) AS QuantityToTransferReceipt,
	SUM(CASE
			WHEN GoodsToTransfer.Count &lt; 0
				THEN 0 - GoodsToTransfer.Count
			ELSE 0
		END) AS QuantityToTransferExpense,
	SUM(CASE
			WHEN GoodsToTransfer.Count &lt; 0
				THEN 0 - GoodsToTransfer.Count
			ELSE GoodsToTransfer.Count
		END) AS QuantityToTransferTurnover,
	SUM(CASE
			WHEN GoodsToTransfer.Count &lt; 0
				THEN 0 - GoodsToTransfer.Count
			ELSE GoodsToTransfer.Count
		END) AS QuantityToTransferClosingBalance
INTO RegisteredRecordsDuringPeriod
FROM
	AccumulationRegister.CompanySafeStock AS GoodsToTransfer
WHERE
	GoodsToTransfer.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND GoodsToTransfer.RecordType = VALUE(AccumulationRecordType.Expense)

GROUP BY
	GoodsToTransfer.Organization,
	GoodsToTransfer.ItemsLocationAttributes.Products,
	GoodsToTransfer.ItemsLocationAttributes.Characteristic,
	GoodsToTransfer.ItemsLocationAttributes.StorageLocation,
	GoodsToTransfer.CCDNumber,
	GoodsToTransfer.CorInventoryOwnerAttribute,
	GoodsToTransfer.CorCompany
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN GoodsToTransfer.CountBalance &lt; 0
			THEN GoodsToTransfer.Organization
		ELSE VALUE(Catalog.Companies.EmptyRef)
	END AS Sender,
	GoodsToTransfer.ItemsLocationAttributes.Products AS Products,
	GoodsToTransfer.ItemsLocationAttributes.Characteristic AS Characteristic,
	GoodsToTransfer.ItemsLocationAttributes.StorageLocation AS Warehouse,
	GoodsToTransfer.CCDNumber AS CCDNumber,
	CASE
		WHEN GoodsToTransfer.CountBalance &gt; 0
			THEN GoodsToTransfer.InventoryOwnerAttribute
		ELSE VALUE(Catalog.InventoryKinds.EmptyRef)
	END AS SellerInventoryOwnerAttribute,
	CASE
		WHEN GoodsToTransfer.CountBalance &gt; 0
			THEN GoodsToTransfer.Organization
		ELSE VALUE(Catalog.Companies.EmptyRef)
	END AS Recipient,
	GoodsToTransfer.CountBalance AS QuantityToTransferOpeningBalance,
	0 AS QuantityToTransferReceipt,
	0 AS QuantityToTransferExpense,
	0 AS QuantityToTransferTurnover,
	0 AS QuantityToTransferClosingBalance,
	0 AS AmountToTransferInCurPeriod
FROM
	AccumulationRegister.CompanySafeStock.Balance({(&amp;BeginOfPeriod)}, ) AS GoodsToTransfer

UNION ALL

SELECT
	ForThePeriod.Sender,
	ForThePeriod.Products,
	ForThePeriod.Characteristic,
	ForThePeriod.Warehouse,
	ForThePeriod.CCDNumber,
	ForThePeriod.SellerInventoryOwnerAttribute,
	ForThePeriod.Recipient,
	ForThePeriod.QuantityToTransferOpeningBalance,
	ForThePeriod.QuantityToTransferReceipt,
	ForThePeriod.QuantityToTransferExpense,
	ForThePeriod.QuantityToTransferTurnover,
	ForThePeriod.QuantityToTransferClosingBalance,
	CASE
		WHEN ForThePeriod.QuantityToTransferTurnover &gt; 0
			THEN ForThePeriod.QuantityToTransferTurnover
		ELSE 0
	END
FROM
	RegisteredRecordsDuringPeriod AS ForThePeriod

UNION ALL

SELECT
	GoodsToTransfer.CompanyOwner,
	GoodsToTransfer.ItemsLocationAttributes.Products,
	GoodsToTransfer.ItemsLocationAttributes.Characteristic,
	GoodsToTransfer.ItemsLocationAttributes.StorageLocation,
	GoodsToTransfer.CCDNumber,
	GoodsToTransfer.SellerInventoryOwnerAttribute,
	GoodsToTransfer.SellerInventoryOwnerAttribute.Organization,
	GoodsToTransfer.CountOpeningBalance,
	GoodsToTransfer.CountReceipt,
	GoodsToTransfer.CountExpense,
	GoodsToTransfer.CountTurnover,
	GoodsToTransfer.CountClosingBalance,
	CASE
		WHEN GoodsToTransfer.CountTurnover &lt; 0
			THEN 0
		ELSE GoodsToTransfer.CountTurnover
	END
FROM
	AccumulationRegister.CompanyGoodsForTransfer.BalanceAndTurnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto, , ) AS GoodsToTransfer</query>
			</dataSet>
			<totalField>
				<dataPath>QuantityToTransferClosingBalance</dataPath>
