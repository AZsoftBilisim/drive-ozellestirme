					<dataSource>DataSource1</dataSource>
					<query>SELECT ALLOWED
	GoodsForRegistration.InventoryOwnerAttribute.Organization AS Consignee,
	GoodsForRegistration.Currency AS Currency,
	GoodsForRegistration.ItemsLocationAttributes.Products AS Products,
	GoodsForRegistration.ItemsLocationAttributes.Characteristic AS Characteristic,
	GoodsForRegistration.InventoryOwnerAttribute.GoodsOwner AS Consignor,
	GoodsForRegistration.InventoryOwnerAttribute.Terms AS Terms,
		
	CASE WHEN GoodsForRegistration.Recorder = UNDEFINED THEN
		NULL
	ELSE
		GoodsForRegistration.Recorder
	END AS Recorder,
	
	GoodsForRegistration.SecondPeriod AS SecondPeriod,
	GoodsForRegistration.DayPeriod AS DayPeriod,
	GoodsForRegistration.WeekPeriod AS WeekPeriod,
	GoodsForRegistration.TenDaysPeriod AS TenDaysPeriod,
	GoodsForRegistration.MonthPeriod AS MonthPeriod,
	GoodsForRegistration.QuarterPeriod AS QuarterPeriod,
	GoodsForRegistration.HalfYearPeriod AS HalfYearPeriod,
	GoodsForRegistration.YearPeriod AS YearPeriod,
	
	GoodsForRegistration.RevenueAmountOpeningBalance AS RevenueAmountOpeningBalance,
	GoodsForRegistration.RevenueAmountReceipt AS RevenueAmountReceipt,
	GoodsForRegistration.RevenueAmountExpense AS RevenueAmountExpense,
	GoodsForRegistration.RevenueAmountClosingBalance AS RevenueAmountClosingBalance,
	
	GoodsForRegistration.CountOpeningBalance
	+ GoodsForRegistration.QuantityConsumedOpeningBalance AS QuantityToRegisterOpeningBalance,
	
	GoodsForRegistration.CountReceipt AS QuantityToRegisterReceipt,
	GoodsForRegistration.QuantityConsumedReceipt AS QuantityConsumedForIncoiceRegistrationReceipt,
	
	GoodsForRegistration.CountExpense
	+ GoodsForRegistration.QuantityConsumedExpense AS QuantityToRegisterExpense,
	
	GoodsForRegistration.CountClosingBalance
	+ GoodsForRegistration.QuantityConsumedClosingBalance AS QuantityToRegisterClosingBalance
			
FROM
	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.BalanceAndTurnovers(,,Auto,,
		InventoryOwnerAttribute.GoodsOwner REFS Catalog.Companies
	) AS GoodsForRegistration
	
WHERE
	(GoodsForRegistration.CountClosingBalance
	+ GoodsForRegistration.QuantityConsumedClosingBalance) &lt;&gt; 0
	OR
	(GoodsForRegistration.CountExpense
	+ GoodsForRegistration.QuantityConsumedExpense) &lt;&gt; 0
	OR
	GoodsForRegistration.RevenueAmountClosingBalance &lt;&gt; 0
	OR GoodsForRegistration.RevenueAmountExpense &lt;&gt; 0</query>
				</item>
