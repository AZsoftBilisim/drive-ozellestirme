			<dataSource>DataSource1</dataSource>
			<query>// !!! TAGS ARE USED !!!
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	"CompanyGoods" AS Source,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Characteristic AS Characteristic,
	DimensionOfProductItem.Series AS Series,
	DimensionOfProductItem.Purpose AS Purpose,
	DimensionOfProductItem.WarehouseArea AS Warehouse,
	DimensionOfProductItem.Contract AS Contract,
	CASE
		WHEN DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
			THEN DimensionOfProductItem.Contract.Partner
		ELSE UNDEFINED
	END AS Partner,
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	CompanyGoods.CCDNumber AS CCDNumber,
	CompanyGoods.CCDNumber.OriginCountry AS OriginCountry,
	CompanyGoods.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CompanyGoods.InventoryOwnerAttribute.InventoryType AS InventoryType,
	CompanyGoods.InventoryOwnerAttribute.GoodsOwner AS Consignor,
	CompanyGoods.InventoryOwnerAttribute.FinancialAccountingGroup AS FinancialAccountingGroup,
	CompanyGoods.Organization AS Organization,
	CompanyGoods.Organization AS CompanyCustomer,
	CASE
		WHEN CompanyGoods.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				AND CompanyGoods.InventoryOwnerAttribute.VATTaxation &lt;&gt; VALUE(Enum.VATTaxationTypes.EmptyRef)
			THEN CompanyGoods.InventoryOwnerAttribute.VATTaxation
		ELSE &amp;CompanyVATTaxation
	END AS VATTaxation,
	FALSE AS InventoryOfAnotherOrganization,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountOpeningBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountClosingBalance,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS OpeningBalanceOfSellerSOrganization,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS BalanceOfSellerSOrganization,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountReceipt,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountExpense / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END AS CountExpense,
	CompanyGoods.CountOpeningBalance * &amp;QueryTextItemWeight1 AS StartBalanceWeight,
	CompanyGoods.CountClosingBalance * &amp;QueryTextItemWeight1 AS ClosingBalanceWeight,
	CompanyGoods.CountReceipt * &amp;QueryTextItemWeight1 AS ReceiptWeight,
	CompanyGoods.CountExpense * &amp;QueryTextItemWeight1 AS ConsumptionWeight,
	CompanyGoods.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem1 AS StartBalanceVolume,
	CompanyGoods.CountClosingBalance * &amp;QueryTextTheVolumeOfTheItem1 AS ClosingBalanceVolume,
	CompanyGoods.CountReceipt * &amp;QueryTextTheVolumeOfTheItem1 AS ReceiptVolume,
	CompanyGoods.CountExpense * &amp;QueryTextTheVolumeOfTheItem1 AS ConsumptionVolume,
	CompanyGoods.SecondPeriod AS SecondPeriod,
	CompanyGoods.MinutePeriod AS MinutePeriod,
	CompanyGoods.HourPeriod AS HourPeriod,
	CompanyGoods.DayPeriod AS DayPeriod,
	CompanyGoods.WeekPeriod AS WeekPeriod,
	CompanyGoods.TenDaysPeriod AS TenDaysPeriod,
	CompanyGoods.MonthPeriod AS MonthPeriod,
	CompanyGoods.QuarterPeriod AS QuarterPeriod,
	CompanyGoods.YearPeriod AS YearPeriod,
	CASE
		WHEN CompanyGoods.Recorder = UNDEFINED
			THEN NULL
		ELSE CompanyGoods.Recorder
	END AS Recorder,
	CompanyGoods.QuantityByGBRNOpeningBalance AS QuantityByGBRNOpeningBalance,
	CompanyGoods.QuantityByGBRNClosingBalance AS QuantityByGBRNClosingBalance,
	CompanyGoods.QuantityByGBRNTurnover AS QuantityByGBRNTurnover,
	CompanyGoods.QuantityByGBRNReceipt AS QuantityByGBRNReceipt,
	CompanyGoods.QuantityByGBRNExpense AS QuantityByGBRNExpense
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(, , Auto, , ) AS CompanyGoods
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON CompanyGoods.ItemsLocationAttributes = DimensionOfProductItem.Ref
		AND (NOT &amp;SelectionForRNPTProductsIsUsed
		AND (&amp;ReportVariant = ""
		AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
		OR &amp;ReportVariant = "MovementOfGoodsTransferred"
		AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
		AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.TransferToCustody)
		OR &amp;ReportVariant = "MovementOfGoodsTransferredToCommission25"
		AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
		AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.WithConsignee)
		AND DimensionOfProductItem.Contract.ConsignmentSales25)
		OR &amp;ReportVariant = "MovementOfGoodsTransferredToProcessors"
		AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
		AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.TransferToTolling2_5)
		OR (&amp;SelectionForRNPTProductsIsUsed
		AND DimensionOfProductItem.Products.KeepRecordsByCCD
		AND ISNULL(DimensionOfProductItem.Products.TracedGoods, FALSE)))
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.WarehouseArea.* AS Warehouse,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(CompanyGoods.InventoryOwnerAttribute.InventoryType IN (&amp;InventoryTypes)),
	(NOT &amp;ExcludeTurnoverOnImportedGoodsWithEmptyCCDNumber
			OR NOT DimensionOfProductItem.Products.KeepRecordsByCCD
			OR &amp;ExcludeTurnoverOnImportedGoodsWithEmptyCCDNumber
				AND DimensionOfProductItem.Products.KeepRecordsByCCD
				AND CompanyGoods.CCDNumber &lt;&gt; VALUE(Catalog.CCDNumbers.EmptyRef)
				AND (
					(CompanyGoods.Recorder REFS Document.VendorInvoice
						AND NOT CAST(CompanyGoods.Recorder AS Document.VendorInvoice).BusinessOperation IN (
							VALUE(Enum.BusinessTransactions.PurchaseByImport),
							VALUE(Enum.BusinessTransactions.ImportFromEAEUGoodsInTransit),
							VALUE(Enum.BusinessTransactions.ImportFromEAEUInvoicedDelivery)
							)
					)
					OR (CompanyGoods.Recorder REFS Document.ReceiptOfGoodsToWarehouse
						AND NOT CAST(CompanyGoods.Recorder AS Document.ReceiptOfGoodsToWarehouse).BusinessOperation IN (
							VALUE(Enum.BusinessTransactions.PurchaseFromVendorReceiptFromGoodsInTransit),
							VALUE(Enum.BusinessTransactions.ImportReceiptFromGoodsInTransit),
							VALUE(Enum.BusinessTransactions.ImportFromEAEUReceiptFromGoodsInTransit),
							VALUE(Enum.BusinessTransactions.PurchaseFromVendorUninvoicedDelivery),
							VALUE(Enum.BusinessTransactions.ImportFromEAEUUninvoicedDelivery)
							)
					)
					OR (NOT CompanyGoods.Recorder REFS Document.VendorInvoice
						AND NOT CompanyGoods.Recorder REFS Document.ReceiptOfGoodsToWarehouse
					)
				)
		)
	}

UNION ALL

SELECT
	"CompanySafeStock",
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Products.UnitOfMeasure,
	DimensionOfProductItem.Products.UnitForReports,
	DimensionOfProductItem.Characteristic,
	DimensionOfProductItem.Series,
	DimensionOfProductItem.Purpose,
	DimensionOfProductItem.WarehouseArea,
	DimensionOfProductItem.Contract,
	CASE
		WHEN DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
			THEN DimensionOfProductItem.Contract.Partner
		ELSE UNDEFINED
	END,
	CompanyGoods.ItemsLocationAttributes,
	CompanyGoods.CCDNumber,
	CompanyGoods.CCDNumber.OriginCountry,
	CompanyGoods.InventoryOwnerAttribute,
	CompanyGoods.InventoryOwnerAttribute.InventoryType,
	CompanyGoods.InventoryOwnerAttribute.GoodsOwner,
	CompanyGoods.InventoryOwnerAttribute.FinancialAccountingGroup,
	CompanyGoods.Organization,
	CompanyGoods.Organization,
	CASE
		WHEN CompanyGoods.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				AND CompanyGoods.InventoryOwnerAttribute.VATTaxation &lt;&gt; VALUE(Enum.VATTaxationTypes.EmptyRef)
			THEN CompanyGoods.InventoryOwnerAttribute.VATTaxation
		ELSE &amp;CompanyVATTaxation
	END,
	FALSE,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	CASE
		WHEN &amp;QuantityUnits = 0 AND CompanyGoods.CountOpeningBalance &lt; 0
			THEN CompanyGoods.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1 AND CompanyGoods.CountOpeningBalance &lt; 0
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountOpeningBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	CASE
		WHEN &amp;QuantityUnits = 0 AND CompanyGoods.CountClosingBalance &lt; 0
			THEN CompanyGoods.CountClosingBalance
		WHEN &amp;QuantityUnits = 1 AND CompanyGoods.CountClosingBalance &lt; 0
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountClosingBalance / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountReceipt
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountReceipt / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN CompanyGoods.CountExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN DimensionOfProductItem.Products.UnitFactorForReports &lt;&gt; 0
						THEN CompanyGoods.CountExpense / DimensionOfProductItem.Products.UnitFactorForReports
					ELSE 0
				END
	END,
	CompanyGoods.CountOpeningBalance * &amp;QueryTextItemWeight1,
	CompanyGoods.CountClosingBalance * &amp;QueryTextItemWeight1,
	CompanyGoods.CountReceipt * &amp;QueryTextItemWeight1,
	CompanyGoods.CountExpense * &amp;QueryTextItemWeight1,
	CompanyGoods.CountOpeningBalance * &amp;QueryTextTheVolumeOfTheItem1,
	CompanyGoods.CountClosingBalance * &amp;QueryTextTheVolumeOfTheItem1,
	CompanyGoods.CountReceipt * &amp;QueryTextTheVolumeOfTheItem1,
	CompanyGoods.CountExpense * &amp;QueryTextTheVolumeOfTheItem1,
	CompanyGoods.SecondPeriod,
	CompanyGoods.MinutePeriod,
	CompanyGoods.HourPeriod,
	CompanyGoods.DayPeriod,
	CompanyGoods.WeekPeriod,
	CompanyGoods.TenDaysPeriod,
	CompanyGoods.MonthPeriod,
	CompanyGoods.QuarterPeriod,
	CompanyGoods.YearPeriod,
	CASE
		WHEN CompanyGoods.Recorder = UNDEFINED
			THEN NULL
		ELSE CompanyGoods.Recorder
	END,
	CompanyGoods.QuantityByGBRNOpeningBalance,
	CompanyGoods.QuantityByGBRNClosingBalance,
	CompanyGoods.QuantityByGBRNTurnover,
	CompanyGoods.QuantityByGBRNReceipt,
	CompanyGoods.QuantityByGBRNExpense
FROM
	AccumulationRegister.CompanySafeStock.BalanceAndTurnovers(,{&amp;ReservePeriodEnd}, Auto, , ) AS CompanyGoods
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON CompanyGoods.ItemsLocationAttributes = DimensionOfProductItem.Ref
		AND (NOT &amp;SelectionForRNPTProductsIsUsed
		AND (&amp;ReportVariant = ""
		AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse)
		OR &amp;ReportVariant = "MovementOfGoodsTransferred"
		AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
		AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.TransferToCustody)
		OR &amp;ReportVariant = "MovementOfGoodsTransferredToCommission25"
		AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
		AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.WithConsignee)
		AND DimensionOfProductItem.Contract.ConsignmentSales25)
		OR &amp;ReportVariant = "MovementOfGoodsTransferredToProcessors"
			AND DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.CounterpartyContract)
			AND DimensionOfProductItem.Contract.ContractType = VALUE(Enum.ContractTypes.TransferToTolling2_5)
			AND NOT CompanyGoods.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.SubcontractorProducts)
		OR (&amp;SelectionForRNPTProductsIsUsed
		AND DimensionOfProductItem.Products.KeepRecordsByCCD
		AND ISNULL(DimensionOfProductItem.Products.TracedGoods, FALSE)))
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.WarehouseArea.* AS Warehouse,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>ProductsFromOtherOrganizations</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Products</dataPath>
				<field>Products</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Warehouse</dataPath>
				<field>Warehouse</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Characteristic</dataPath>
