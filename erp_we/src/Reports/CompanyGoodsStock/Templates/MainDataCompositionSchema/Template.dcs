			<field xsi:type="DataSetFieldField">
				<dataPath>Purpose</dataPath>
				<field>Purpose</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	"CompanySafeStock" AS Source,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Characteristic AS Characteristic,
	DimensionOfProductItem.Series AS Series,
	DimensionOfProductItem.Purpose AS Purpose,
	DimensionOfProductItem.WarehouseArea AS Warehouse,
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	CompanyGoods.CCDNumber AS CCDNumber,
	CompanyGoods.CCDNumber.OriginCountry AS OriginCountry,
	InventoryKinds.Ref AS InventoryOwnerAttribute,
	InventoryKinds.InventoryType AS InventoryType,
	InventoryKinds.GoodsOwner AS Consignor,
	InventoryKinds.FinancialAccountingGroup AS FinancialAccountingGroup,
	NULL AS Organization,
	Setting.CompanyCustomer AS CompanyCustomer,
	CASE
		WHEN InventoryKinds.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
			THEN CASE
					WHEN Setting.GoodsTransferMethod = VALUE(Enum.GoodsTransferMethods.TransferToCommissionAgent)
						THEN InventoryKinds.VATTaxation
					ELSE &amp;CompanyVATTaxation
				END
		ELSE CASE
				WHEN Setting.GoodsTransferMethod = VALUE(Enum.GoodsTransferMethods.TransferToCommissionAgent)
					THEN &amp;CompanyOwnerVATTaxation
				ELSE &amp;CompanySellerVATTaxation
			END
	END AS VATTaxation,
	TRUE AS InventoryOfAnotherOrganization,
	CompanyGoods.CountBalance AS BalanceOfSellerSOrganization
FROM
	AccumulationRegister.CompanyGoods.Balance({(&amp;EndOfPeriod)}, &amp;IncludeTransferOfInventoryOfOtherCompanies) AS CompanyGoods
		INNER JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON CompanyGoods.ItemsLocationAttributes = DimensionOfProductItem.Ref
			AND (DimensionOfProductItem.StorageType = VALUE(Enum.StorageLocationTypes.Warehouse))
		{INNER JOIN Catalog.InventoryKinds AS InventoryKinds
		ON CompanyGoods.InventoryOwnerAttribute = InventoryKinds.Ref}
		{INNER JOIN InformationRegister.CustomizeCustomerInvoiceIntercompany AS Setting
		ON (InventoryKinds.Organization = Setting.CompanyOwner)
			AND (InventoryKinds.InventoryType = Setting.InventoryType)
			AND (Setting.GoodsTransferMethod &lt;&gt; VALUE(Enum.GoodsTransferMethods.NotTransferred))}
{WHERE
	DimensionOfProductItem.Products.* AS Products,
	DimensionOfProductItem.Characteristic.* AS Characteristic,
	DimensionOfProductItem.WarehouseArea.* AS Warehouse,
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità di misura</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>J. m.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ед. изм.</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Ölçü birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>ĐVT</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Case
