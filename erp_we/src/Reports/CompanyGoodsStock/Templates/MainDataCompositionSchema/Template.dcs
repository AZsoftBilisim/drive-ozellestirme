			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>true</useRestriction>
	</parameter>
	<parameter>
		<name>ExcludeTurnoverOnImportedGoodsWithEmptyCCDNumber</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Exclude turnovers of imported goods with empty cargo customs declaration number</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>حذف گردش‌های کالای وارداتی با شماره اظهارنامه گمرکی خالی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Escludere fatturati con articoli importati con numero di Dichiarazione Doganale vuoto</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wykluczaj obroty według towarów importowanych z pustym numerem ładunkowej deklaracji celnej</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Исключать обороты по импортным товарам с пустым номером ГТД</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kargo gümrük beyannamesi boş numarasıyla cirolara göre ithal ürünleri hariç tut</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Loại trừ doanh thu đối với hàng hóa nhập khẩu không có số tờ khai hải quan</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">true</value>
		<useRestriction>false</useRestriction>
	</parameter>
