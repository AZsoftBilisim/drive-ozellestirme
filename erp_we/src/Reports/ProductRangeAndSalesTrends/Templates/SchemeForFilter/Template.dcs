		<field xsi:type="DataSetFieldField">
			<dataPath>Warehouse</dataPath>
			<field>Warehouse</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PlanningObject</dataPath>
			<field>PlanningObject</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Shops.StoreFormat AS StoreFormat,
	Shops.Warehouse AS Store,
	ProductMixQuotasSliceLast.ProductCategory.Owner AS ProductKind,
	ProductMixQuotasSliceLast.ProductCategory AS ProductCategory,
	ProductMixQuotasSliceLast.Brand AS Brand,
	0 AS RelativeNumberChange,
	0 AS RelativeRevenueAmountChange,
	0 AS RelativeGrossProfitChange,
	ProductMixQuotasSliceLast.ItemsCollection
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast AS Shops
		INNER JOIN InformationRegister.ProductMixQuotas.SliceLast(, ) AS ProductMixQuotasSliceLast
		ON Shops.StoreFormat = ProductMixQuotasSliceLast.PlanningObject
			AND (Shops.Warehouse.WarehouseStore = VALUE(Enum.TypesOfWarehouses.RetailStore))</query>
	</dataSet>
	<totalField>
		<dataPath>RelativeNumberChange</dataPath>
		<expression>Sum(RelativeNumberChange)</expression>
	</totalField>
