		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductsInBalancesAndTurnoverCells.Products,
	ProductsInBalancesAndTurnoverCells.Characteristic,
	ProductsInBalancesAndTurnoverCells.Purpose,
	ProductsInBalancesAndTurnoverCells.Series,
	ProductsInBalancesAndTurnoverCells.Cell,
	ProductsInBalancesAndTurnoverCells.Package,
	ProductsInBalancesAndTurnoverCells.Cell.StorageArea AS StorageArea,
	ProductsInBalancesAndTurnoverCells.Package.WarehouseGroup AS WarehouseGroupOfPackages,
	ProductsInBalancesAndTurnoverCells.Products.WarehouseGroup AS WarehouseGroupOfProducts,
	ProductsInBalancesAndTurnoverCells.InStockClosingBalance AS InStockClosingBalance,
	ProductsInBalancesAndTurnoverCells.InStockReceipt AS InStockReceipt,
	ProductsInBalancesAndTurnoverCells.InStockExpense AS InStockExpense,
	ProductsInBalancesAndTurnoverCells.InStockOpeningBalance AS InStockOpeningBalance,
	ProductsInBalancesAndTurnoverCells.ForPickingClosingBalance AS ForPicking,
	ProductsInBalancesAndTurnoverCells.ForPlacementClosingBalance AS ForPlacement,
	&amp;QueryTextPackagingFactor AS PackageFactor,
	CASE
		WHEN ISNULL(&amp;QueryTextPackagingFactor, 0) = 0
			THEN ProductsInBalancesAndTurnoverCells.InStockClosingBalance
		ELSE ProductsInBalancesAndTurnoverCells.InStockClosingBalance * &amp;QueryTextPackagingFactor
	END AS InStockClosingBalanceBase,
	CASE
		WHEN ISNULL(&amp;QueryTextPackagingFactor, 0) = 0
			THEN ProductsInBalancesAndTurnoverCells.InStockReceipt
		ELSE ProductsInBalancesAndTurnoverCells.InStockReceipt * &amp;QueryTextPackagingFactor
	END AS InStockReceiptBasic,
	CASE
		WHEN ISNULL(&amp;QueryTextPackagingFactor, 0) = 0
			THEN ProductsInBalancesAndTurnoverCells.InStockExpense
		ELSE ProductsInBalancesAndTurnoverCells.InStockExpense * &amp;QueryTextPackagingFactor
	END AS InStockExpenseBasic,
	CASE
		WHEN ISNULL(&amp;QueryTextPackagingFactor, 0) = 0
			THEN ProductsInBalancesAndTurnoverCells.InStockOpeningBalance
		ELSE ProductsInBalancesAndTurnoverCells.InStockOpeningBalance * &amp;QueryTextPackagingFactor
	END AS AvailableInitialBalance,
	CASE
		WHEN ISNULL(&amp;QueryTextPackagingFactor, 0) = 0
			THEN ProductsInBalancesAndTurnoverCells.ForPickingClosingBalance
		ELSE ProductsInBalancesAndTurnoverCells.ForPickingClosingBalance * &amp;QueryTextPackagingFactor
	END AS ToSelectionOfBasic,
	CASE
		WHEN ISNULL(&amp;QueryTextPackagingFactor, 0) = 0
			THEN ProductsInBalancesAndTurnoverCells.ForPlacementClosingBalance
		ELSE ProductsInBalancesAndTurnoverCells.ForPlacementClosingBalance * &amp;QueryTextPackagingFactor
	END AS ToPlacementOfBasic,
	ProductsInBalancesAndTurnoverCells.InStockClosingBalance * &amp;QueryTextVolumeM3 AS VolumeOccupied,
	ProductsInBalancesAndTurnoverCells.ForPlacementClosingBalance * &amp;QueryTextVolumeM3 AS VolumeReserved,
	ProductsInBalancesAndTurnoverCells.Cell.StandardSize.VolumeM3 * ProductsInBalancesAndTurnoverCells.Cell.MaximumFillingRateByVolume / 100 - CASE
		WHEN ProductsInBalancesAndTurnoverCells.Cell.StandardSize.NotLimitedByDimensions
			THEN 0
		ELSE ProductsInBalancesAndTurnoverCells.InStockClosingBalance * &amp;QueryTextVolumeM3
	END - CASE
		WHEN ProductsInBalancesAndTurnoverCells.Cell.StandardSize.NotLimitedByDimensions
			THEN 0
		ELSE ProductsInBalancesAndTurnoverCells.ForPlacementClosingBalance * &amp;QueryTextVolumeM3
	END AS VolumeVoid,
	ProductsInBalancesAndTurnoverCells.ForPickingClosingBalance * &amp;QueryTextVolumeM3 AS VolumeReleased,
	ProductsInBalancesAndTurnoverCells.InStockClosingBalance * &amp;QueryTextWeight AS WeightOccupied,
	ProductsInBalancesAndTurnoverCells.ForPlacementClosingBalance * &amp;QueryTextWeight AS WeightReserved,
	ProductsInBalancesAndTurnoverCells.Cell.StandardSize.CarryingCapacity * (ProductsInBalancesAndTurnoverCells.Cell.StandardSize.WeightUnitOfMeasure.Numerator / ProductsInBalancesAndTurnoverCells.Cell.StandardSize.WeightUnitOfMeasure.Denominator) * ProductsInBalancesAndTurnoverCells.Cell.MaximumFillingRateByWeight / 100 - CASE
		WHEN ProductsInBalancesAndTurnoverCells.Cell.StandardSize.NotLimitedByCarryingCapacity
			THEN 0
		ELSE ProductsInBalancesAndTurnoverCells.InStockClosingBalance * &amp;QueryTextWeight
	END - CASE
		WHEN ProductsInBalancesAndTurnoverCells.Cell.StandardSize.NotLimitedByCarryingCapacity
			THEN 0
		ELSE ProductsInBalancesAndTurnoverCells.ForPlacementClosingBalance * &amp;QueryTextWeight
	END AS WeightFree,
	ProductsInBalancesAndTurnoverCells.ForPickingClosingBalance * &amp;QueryTextWeight AS WeightRelieved,
	ProductsInBalancesAndTurnoverCells.Cell.Owner AS Warehouse,
	ProductsInBalancesAndTurnoverCells.Cell.Premise AS Premise,
	ProductsInBalancesAndTurnoverCells.SecondPeriod AS SecondPeriod,
	ProductsInBalancesAndTurnoverCells.MinutePeriod AS MinutePeriod,
	ProductsInBalancesAndTurnoverCells.HourPeriod AS HourPeriod,
	ProductsInBalancesAndTurnoverCells.DayPeriod AS DayPeriod,
	ProductsInBalancesAndTurnoverCells.WeekPeriod AS WeekPeriod,
	ProductsInBalancesAndTurnoverCells.TenDaysPeriod AS TenDaysPeriod,
	ProductsInBalancesAndTurnoverCells.MonthPeriod AS MonthPeriod,
	ProductsInBalancesAndTurnoverCells.QuarterPeriod AS QuarterPeriod,
	ProductsInBalancesAndTurnoverCells.HalfYearPeriod AS HalfYearPeriod,
	ProductsInBalancesAndTurnoverCells.YearPeriod AS YearPeriod,
	CASE
		WHEN ProductsInBalancesAndTurnoverCells.Recorder = UNDEFINED
			THEN NULL
		ELSE ProductsInBalancesAndTurnoverCells.Recorder
	END AS Recorder,
	ProductsInBalancesAndTurnoverCells.ForPlacementOpeningBalance,
	ProductsInBalancesAndTurnoverCells.ForPickingOpeningBalance
FROM
	AccumulationRegister.GoodsInStorageBins.BalanceAndTurnovers(, , Auto, , {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (Cell.StorageArea) AS StorageArea, (Cell.Owner) AS Warehouse, (Cell.Premise) AS Premise, (Products.WarehouseGroup) AS WarehouseGroupOfProducts, (Package.WarehouseGroup) AS WarehouseGroupOfPackages}) AS ProductsInBalancesAndTurnoverCells</query>
	</dataSet>
