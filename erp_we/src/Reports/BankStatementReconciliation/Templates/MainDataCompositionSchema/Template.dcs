		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceInStatement</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(EvalExpressionWithGroupArray ("ClosingBalanceInStatement", "DayPeriod"))
End</expression>
		<group>DayPeriod</group>
	</totalField>
	<totalField>
		<dataPath>OpeningBalanceInStatement</dataPath>
