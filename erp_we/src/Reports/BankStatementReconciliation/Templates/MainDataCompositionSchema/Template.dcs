		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Cash.Organization AS Organization,
	Cash.BankAccount AS BankAccount,
	Cash.BankAccount.CashCurrency AS Currency,
	CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	Cash.SumOpeningBalance AS SumOpeningBalance,
	Cash.SumManOpeningBalance AS SumManOpeningBalance,
	Cash.SumComplOpeningBalance AS SumComplOpeningBalance,
	Cash.SumReceipt AS SumReceipt,
	Cash.SumManReceipt AS SumManReceipt,
	Cash.SumComplReceipt AS SumComplReceipt,
	Cash.SumExpense AS SumExpense,
	Cash.SumManExpense AS SumManExpense,
	Cash.SumComplExpense AS SumComplExpense,
	Cash.SumClosingBalance AS SumClosingBalance,
	Cash.SumManClosingBalance AS SumManClosingBalance,
	Cash.SumComplClosingBalance AS SumComplClosingBalance
INTO NonCashCashSystems
{SELECT
	Organization.*,
	BankAccount.*,
	Currency.*,
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	SumOpeningBalance,
	SumManOpeningBalance,
	SumComplOpeningBalance,
	SumReceipt,
	SumManReceipt,
	SumComplReceipt,
	SumExpense,
	SumManExpense,
	SumComplExpense,
	SumClosingBalance,
	SumManClosingBalance,
	SumComplClosingBalance}
FROM
	AccumulationRegister.BankAccountCash.BalanceAndTurnovers(, , Auto, , ) AS Cash
{WHERE
	Cash.Organization.*,
	Cash.BankAccount.*,
	Cash.BankAccount.CashCurrency.* AS Currency,
	(CASE
			WHEN Cash.Recorder = UNDEFINED
				THEN NULL
			ELSE Cash.Recorder
		END).* AS Recorder,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	Cash.SumOpeningBalance,
	Cash.SumManOpeningBalance,
	Cash.SumComplOpeningBalance,
	Cash.SumReceipt,
	Cash.SumManReceipt,
	Cash.SumComplReceipt,
	Cash.SumExpense,
	Cash.SumManExpense,
	Cash.SumComplExpense,
	Cash.SumClosingBalance,
	Cash.SumManClosingBalance,
	Cash.SumComplClosingBalance}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ExtractData.Period AS DayPeriod,
	ExtractData.BankAccount AS BankAccount,
	ExtractData.BankAccount.CashCurrency AS Currency,
	ExtractData.BankAccount.Owner AS Organization,
	ExtractData.OpeningBalance AS OpeningBalanceInStatement,
	ExtractData.Inpayment AS ReceiptByStatement,
	ExtractData.WriteOff AS WriteOffByStatement,
	ExtractData.ClosingBalance AS ClosingBalanceInStatement
INTO ExtractData
FROM
	InformationRegister.BankAccountBalanceAccordingToStatementData AS ExtractData
{WHERE
	(ExtractData.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod)}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ISNULL(NonCashCashSystems.Organization, ExtractData.Organization) AS Organization,
	ISNULL(NonCashCashSystems.BankAccount, ISNULL(ExtractData.BankAccount, VALUE(Catalog.CompaniesBankAccounts.EmptyRef))) AS BankAccount,
	ISNULL(NonCashCashSystems.Currency, ExtractData.Currency) AS Currency,
	NonCashCashSystems.Recorder AS Recorder,
	NonCashCashSystems.SecondPeriod AS SecondPeriod,
	ISNULL(NonCashCashSystems.DayPeriod, ExtractData.DayPeriod) AS DayPeriod,
	NonCashCashSystems.WeekPeriod AS WeekPeriod,
	NonCashCashSystems.TenDaysPeriod AS TenDaysPeriod,
	NonCashCashSystems.MonthPeriod AS MonthPeriod,
	NonCashCashSystems.QuarterPeriod AS QuarterPeriod,
	NonCashCashSystems.HalfYearPeriod AS HalfYearPeriod,
	NonCashCashSystems.YearPeriod AS YearPeriod,
	NonCashCashSystems.SumOpeningBalance AS SumOpeningBalance,
	NonCashCashSystems.SumManOpeningBalance AS SumManOpeningBalance,
	NonCashCashSystems.SumComplOpeningBalance AS SumComplOpeningBalance,
	NonCashCashSystems.SumReceipt AS SumReceipt,
	NonCashCashSystems.SumManReceipt AS SumManReceipt,
	NonCashCashSystems.SumComplReceipt AS SumComplReceipt,
	NonCashCashSystems.SumExpense AS SumExpense,
	NonCashCashSystems.SumManExpense AS SumManExpense,
	NonCashCashSystems.SumComplExpense AS SumComplExpense,
	NonCashCashSystems.SumClosingBalance AS SumClosingBalance,
	NonCashCashSystems.SumManClosingBalance AS SumManClosingBalance,
	NonCashCashSystems.SumComplClosingBalance AS SumComplClosingBalance,
	ExtractData.OpeningBalanceInStatement AS OpeningBalanceInStatement,
	ExtractData.ReceiptByStatement AS ReceiptByStatement,
	ExtractData.WriteOffByStatement AS WriteOffByStatement,
	ExtractData.ClosingBalanceInStatement AS ClosingBalanceInStatement
FROM
	NonCashCashSystems AS NonCashCashSystems
		FULL JOIN ExtractData AS ExtractData
		ON NonCashCashSystems.BankAccount = ExtractData.BankAccount
			AND NonCashCashSystems.DayPeriod = ExtractData.DayPeriod</query>
	</dataSet>
	<totalField>
		<dataPath>SumClosingBalance</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumOpeningBalance</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumReceipt</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumExpense</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumComplClosingBalance</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumComplClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumComplOpeningBalance</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumComplOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumComplReceipt</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumComplReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumComplExpense</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumComplExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumManClosingBalance</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumManClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumManOpeningBalance</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumManOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumManReceipt</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumManReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumManExpense</dataPath>
		<expression>Case When Count(Distinct Currency) &gt; 1
        Then 0
    Else Sum(SumManExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>OpeningBalanceInStatement</dataPath>
		<expression>0</expression>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>ReceiptByStatement</dataPath>
		<expression>0</expression>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>WriteOffByStatement</dataPath>
		<expression>0</expression>
		<group>Recorder</group>
	</totalField>
	<totalField>
		<dataPath>ClosingBalanceInStatement</dataPath>
