        Then 0
    Else Sum(EvalExpressionWithGroupArray ("OpeningBalanceInStatement", "DayPeriod")) End</expression>
		<group>DayPeriod</group>
	</totalField>
	<totalField>
		<dataPath>ReceiptByStatement</dataPath>
