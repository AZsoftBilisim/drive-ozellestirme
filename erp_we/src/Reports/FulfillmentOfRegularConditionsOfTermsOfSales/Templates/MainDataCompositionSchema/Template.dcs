		<dataSource>DataSource1</dataSource>
		<query>////////////////////////////////////////////////////////////////////////////////
// EXCHANGE RATES /////////////////////////////////////////////////////////////////

SELECT ALLOWED
	CurrencyRatesCut.Currency    AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO CurrencyRatesCut
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;EndDate}, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
INDEX BY
	Currency
;

////////////////////////////////////////////////////////////////////////////////
// CURRENCY OF MANAGEMENT ACCOUNTING ////////////////////////////////////////////////

SELECT ALLOWED
	Constants.ManagementAccountingCurrency AS ManagementAccountingCurrency
INTO TableOfConstants
FROM
	Constants AS Constants
;

////////////////////////////////////////////////////////////////////////////////
// TURNOVER BY REVENUE AND COST OF SALES ///////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// 1. TURNOVERS WITH A FREQUENCY OF A DAY  ///////////////////////////////////////////

SELECT ALLOWED
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms        AS Terms,
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms.Currency AS Currency,
	VALUE(Enum.Periodicity.DAY)                         AS Periodicity,
	BEGINOFPERIOD(RevenueAndCostOfSalesTurnover.Period, DAY)    AS Period,
	RevenueAndCostOfSalesTurnover.RevenueAmountTurnover             AS SalesAmount
INTO
	RevenueAndCostOfSalesTurnover
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({&amp;StartDate}, {&amp;EndDate}, Day,
		SalesOrder.Terms.Frequent AND SalesOrder.Terms.Period = VALUE(Enum.Periodicity.DAY)
		) AS RevenueAndCostOfSalesTurnover

////////////////////////////////////////////////////////////////////////////////
// 2. TURNOVERS WITH A FREQUENCY OF A WEEK  /////////////////////////////////////////

UNION ALL

SELECT
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms        AS Terms,
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms.Currency AS Currency,
	VALUE(Enum.Periodicity.WEEK)                       AS Periodicity,
	BEGINOFPERIOD(RevenueAndCostOfSalesTurnover.Period, WEEK)  AS Period,
	RevenueAndCostOfSalesTurnover.RevenueAmountTurnover             AS SalesAmount
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({&amp;StartDate}, {&amp;EndDate}, Week,
		SalesOrder.Terms.Frequent AND SalesOrder.Terms.Period = VALUE(Enum.Periodicity.WEEK)
		) AS RevenueAndCostOfSalesTurnover

////////////////////////////////////////////////////////////////////////////////
// 3. REVOLUTIONS WITH A PERIODICITY OF A DECADE  /////////////////////////////////////////

UNION ALL

SELECT
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms        AS Terms,
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms.Currency AS Currency,
	VALUE(Enum.Periodicity.TENDAYS)                       AS Periodicity,
	BEGINOFPERIOD(RevenueAndCostOfSalesTurnover.Period, TENDAYS)  AS Period,
	RevenueAndCostOfSalesTurnover.RevenueAmountTurnover             AS SalesAmount
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({&amp;StartDate}, {&amp;EndDate}, TenDays,
		SalesOrder.Terms.Frequent AND SalesOrder.Terms.Period = VALUE(Enum.Periodicity.TENDAYS)
		) AS RevenueAndCostOfSalesTurnover

////////////////////////////////////////////////////////////////////////////////
// 4. TURNOVERS WITH A PERIODICITY OF A MONTH  //////////////////////////////////////////

UNION ALL

SELECT
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms        AS Terms,
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms.Currency AS Currency,
	VALUE(Enum.Periodicity.MONTH)                        AS Periodicity,
	BEGINOFPERIOD(RevenueAndCostOfSalesTurnover.Period, MONTH)   AS Period,
	RevenueAndCostOfSalesTurnover.RevenueAmountTurnover             AS SalesAmount
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({&amp;StartDate}, {&amp;EndDate}, Month,
		SalesOrder.Terms.Frequent AND SalesOrder.Terms.Period = VALUE(Enum.Periodicity.MONTH)
		) AS RevenueAndCostOfSalesTurnover

////////////////////////////////////////////////////////////////////////////////
// 5. TURNOVERS WITH A PERIODICITY OF A QUARTER  ////////////////////////////////////////

UNION ALL

SELECT
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms        AS Terms,
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms.Currency AS Currency,
	VALUE(Enum.Periodicity.QUARTER)                      AS Periodicity,
	BEGINOFPERIOD(RevenueAndCostOfSalesTurnover.Period, QUARTER) AS Period,
	RevenueAndCostOfSalesTurnover.RevenueAmountTurnover             AS SalesAmount
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({&amp;StartDate}, {&amp;EndDate}, Quarter,
		SalesOrder.Terms.Frequent AND SalesOrder.Terms.Period = VALUE(Enum.Periodicity.QUARTER)
		) AS RevenueAndCostOfSalesTurnover

////////////////////////////////////////////////////////////////////////////////
// 6. TURNOVER WITH A PERIODICITY OF HALF A YEAR  //////////////////////////////////////

UNION ALL

SELECT
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms          AS Terms,
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms.Currency   AS Currency,
	VALUE(Enum.Periodicity.HALFYEAR)                      AS Periodicity,
	BEGINOFPERIOD(RevenueAndCostOfSalesTurnover.Period, HALFYEAR) AS Period,
	RevenueAndCostOfSalesTurnover.RevenueAmountTurnover               AS SalesAmount
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({&amp;StartDate}, {&amp;EndDate}, HalfYear,
		SalesOrder.Terms.Frequent AND SalesOrder.Terms.Period = VALUE(Enum.Periodicity.HALFYEAR)
		) AS RevenueAndCostOfSalesTurnover

////////////////////////////////////////////////////////////////////////////////
// 7. TURNOVERS WITH A PERIODICITY OF A YEAR  ////////////////////////////////////////////

UNION ALL

SELECT
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms        AS Terms,
	RevenueAndCostOfSalesTurnover.SalesOrder.Terms.Currency AS Currency,
	VALUE(Enum.Periodicity.YEAR)                          AS Periodicity,
	BEGINOFPERIOD(RevenueAndCostOfSalesTurnover.Period, YEAR)     AS Period,
	RevenueAndCostOfSalesTurnover.RevenueAmountTurnover             AS SalesAmount
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers({&amp;StartDate}, {&amp;EndDate}, Year,
		SalesOrder.Terms.Frequent AND SalesOrder.Terms.Period = VALUE(Enum.Periodicity.YEAR)
		) AS RevenueAndCostOfSalesTurnover
;

////////////////////////////////////////////////////////////////////////////////
// result ///////////////////////////////////////////////////////////////////

SELECT ALLOWED
	RevenueAndCostOfSalesTurnover.Terms                  AS Terms,
	RevenueAndCostOfSalesTurnover.Currency                      AS Currency,
	RevenueAndCostOfSalesTurnover.Periodicity               AS Periodicity,
	RevenueAndCostOfSalesTurnover.Period AS PeriodBeginning,
	SUM(CASE
		WHEN
			&amp;ReportCurrency = TableOfConstants.ManagementAccountingCurrency
			OR &amp;ReportCurrency = UNDEFINED
		THEN
			RevenueAndCostOfSalesTurnover.SalesAmount
		ELSE
			CAST(RevenueAndCostOfSalesTurnover.SalesAmount *
				CASE
					WHEN ISNULL(CurrencyExchangeRateOfSliceReport.CourseDenominator, 0) &gt; 0
						AND ISNULL(CurrencyExchangeRateOfSliceReport.CourseNumerator, 0) &gt; 0
						AND ISNULL(ExchangeRatesCutOffCurrencyOfManagementAccounting.CourseDenominator, 0) &gt; 0
						AND ISNULL(ExchangeRatesCutOffCurrencyOfManagementAccounting.CourseNumerator, 0) &gt; 0
					THEN
						(ExchangeRatesCutOffCurrencyOfManagementAccounting.CourseNumerator * CurrencyExchangeRateOfSliceReport.CourseDenominator)
						/ (CurrencyExchangeRateOfSliceReport.CourseNumerator * ExchangeRatesCutOffCurrencyOfManagementAccounting.CourseDenominator)
					ELSE
						0
				END AS NUMBER(31,2))
	END) AS SalesAmount
FROM
	RevenueAndCostOfSalesTurnover

LEFT JOIN
	TableOfConstants
ON
	TRUE

LEFT JOIN
	CurrencyRatesCut AS ExchangeRatesCutOffCurrencyOfManagementAccounting
ON
	ExchangeRatesCutOffCurrencyOfManagementAccounting.Currency = TableOfConstants.ManagementAccountingCurrency

LEFT JOIN
	CurrencyRatesCut AS CurrencyExchangeRateOfSliceReport
ON
	CurrencyExchangeRateOfSliceReport.Currency =
	CASE
		WHEN
			&amp;ReportCurrency = VALUE(Catalog.Currencies.EmptyRef)
			OR &amp;ReportCurrency =UNDEFINED
		THEN
			RevenueAndCostOfSalesTurnover.Currency
		ELSE
			&amp;ReportCurrency
	END
GROUP BY
	RevenueAndCostOfSalesTurnover.Terms,
	RevenueAndCostOfSalesTurnover.Currency,
	RevenueAndCostOfSalesTurnover.Periodicity,
	RevenueAndCostOfSalesTurnover.Period
	</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>Segments</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>FilterByPartnerSegmentIsUsed</dataPath>
