			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceParameters</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameters">
						<dcscor:item>
							<dcscor:choiceParameter>Filter.GenerationMethod</dcscor:choiceParameter>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.UpdateRegularly</dcscor:value>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.GenerateManually</dcscor:value>
						</dcscor:item>
					</dcscor:value>
				</dcscor:item>
				<dcscor:item>
					<dcscor:parameter>ChoiceFoldersAndItems</dcscor:parameter>
					<dcscor:value xmlns:d6p1="http://v8.1c.ru/8.1/data/enterprise" xsi:type="d6p1:FoldersAndItemsUse">Items</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT ALLOWED
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
{SELECT
	Partner.*}
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}
</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>Terms1</sourceDataSet>
		<destinationDataSet>ComplianceWithTermsOfAgreement</destinationDataSet>
		<sourceExpression>Terms</sourceExpression>
		<destinationExpression>Terms</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>Terms1</sourceDataSet>
		<destinationDataSet>ComplianceWithTermsOfAgreement</destinationDataSet>
		<sourceExpression>BeginOfPeriod(PeriodBeginning,"Day")</sourceExpression>
		<destinationExpression>BeginOfPeriod(PeriodBeginning,"Day")</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>Terms1</sourceDataSet>
		<destinationDataSet>Segments</destinationDataSet>
		<sourceExpression>Partner</sourceExpression>
		<destinationExpression>Partner</destinationExpression>
		<required>false</required>
	</dataSetLink>
	<calculatedField>
		<dataPath>ProgressPercent</dataPath>
		<expression>Cast(Case When Not ValueIsFilled(SalesAmount) Then Cast(0,"Number(5,2)") Else 100*IsNull(SalesAmount,0) /  AgreementAmount End,"Number(5,2)")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Progress percentage</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>درصد پیشرفت</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Percentuale di esecuzione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Procent wykonania</v8:content>
			</v8:item>
