		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TableFormats.Warehouse AS Warehouse,
	TableFormats.StoreFormat AS StoreFormat
INTO TTWarehouseFormats
FROM
	InformationRegister.HistoryOfStoreFormatChange.SliceLast(, {(Warehouse).* AS Warehouse}) AS TableFormats
WHERE
	TableFormats.StoreFormat &lt;&gt; VALUE(Catalog.StoreFormats.EmptyRef)

INDEX BY
	StoreFormat
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CatProducts.Ref AS Products,
	CatProducts.SupplyScheme AS SupplyScheme,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic
INTO TTProducts_1
FROM
	Catalog.Products AS CatProducts
WHERE
	NOT CatProducts.DeletionMark
	AND NOT CatProducts.IsFolder
	AND CatProducts.ItemsType IN (VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
{WHERE
	CatProducts.SupplyScheme.*}

UNION ALL

SELECT
	GoodsProcurementStrategy.Products,
	GoodsProcurementStrategy.Products.SupplyScheme,
	GoodsProcurementStrategy.Characteristic
FROM
	InformationRegister.GoodsProcurementStrategy AS GoodsProcurementStrategy
WHERE
	GoodsProcurementStrategy.Characteristic &lt;&gt; VALUE(Catalog.ItemsCharacteristics.EmptyRef)
	AND NOT GoodsProcurementStrategy.Products.DeletionMark
	AND GoodsProcurementStrategy.AddlOrderingAttribute = 1
{WHERE
	GoodsProcurementStrategy.Products.SupplyScheme.* AS SupplyScheme}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductMatrix.Products AS Products,
	ProductMatrix.Characteristic AS Characteristic,
	ProductMatrix.SupplyScheme AS SupplyScheme,
	VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
	VALUE(Catalog.ProcurementStrategies.EmptyRef) AS ProcurementStrategy,
	FALSE AS ThisIsAPersonalSetting,
	ProductMatrix.Products.ProductKind AS ProductKind
{SELECT
	Products.*,
	Characteristic.*,
	SupplyScheme.*,
	Warehouse.*,
	ProcurementStrategy.*,
	ThisIsAPersonalSetting,
	ProductKind.*}
FROM
	TTProducts_1 AS ProductMatrix
{WHERE
	ProductMatrix.Products.*,
	ProductMatrix.Characteristic.*,
	(VALUE(Catalog.Warehouses.EmptyRef)).* AS Warehouse,
	(VALUE(Catalog.ProcurementStrategies.EmptyRef)).* AS ProcurementStrategy,
	(FALSE) AS ThisIsAPersonalSetting,
	ProductMatrix.Products.ProductKind.* AS ProductKind}

UNION ALL

SELECT
	ProductMatrix.Products,
	ProductMatrix.Characteristic,
	ProductMatrix.SupplyScheme,
	Setting.Warehouse,
	Setting.ProcurementStrategy,
	TRUE,
	ProductMatrix.Products.ProductKind
FROM
	TTProducts_1 AS ProductMatrix
		LEFT JOIN InformationRegister.GoodsProcurementStrategy AS Setting
		ON (Setting.Products = ProductMatrix.Products)
			AND (Setting.Characteristic = ProductMatrix.Characteristic)
			AND (Setting.AddlOrderingAttribute = 1)
WHERE
	NOT Setting.Warehouse IS NULL
{WHERE
	ProductMatrix.Products.*,
	ProductMatrix.Characteristic.*,
	Setting.Warehouse.*,
	Setting.ProcurementStrategy.*,
	(TRUE) AS ThisIsAPersonalSetting,
	ProductMatrix.Products.ProductKind.* AS ProductKind}

UNION ALL

SELECT
	ProductMatrix.Products,
	ProductMatrix.Characteristic,
	ProductMatrix.SupplyScheme,
	Setting.Warehouse,
	Setting.ProcurementStrategy,
	FALSE,
	ProductMatrix.Products.ProductKind
FROM
	TTProducts_1 AS ProductMatrix
		LEFT JOIN InformationRegister.SupplySchemes AS Setting
		ON (Setting.SupplyScheme = ProductMatrix.SupplyScheme)
			AND (Setting.Warehouse REFS Catalog.Warehouses)
		LEFT JOIN InformationRegister.GoodsProcurementStrategy AS PreemptiveSetting
		ON (PreemptiveSetting.Products = ProductMatrix.Products)
			AND (PreemptiveSetting.Characteristic = ProductMatrix.Characteristic)
			AND (PreemptiveSetting.Warehouse = Setting.Warehouse)
			AND (PreemptiveSetting.AddlOrderingAttribute = 1)
WHERE
	NOT Setting.Warehouse IS NULL
	AND PreemptiveSetting.Warehouse IS NULL
{WHERE
	ProductMatrix.Products.*,
	ProductMatrix.Characteristic.*,
	Setting.Warehouse.*,
	Setting.ProcurementStrategy.*,
	(FALSE) AS ThisIsAPersonalSetting,
	ProductMatrix.Products.ProductKind.* AS ProductKind}

UNION ALL

SELECT
	ProductMatrix.Products,
	ProductMatrix.Characteristic,
	ProductMatrix.SupplyScheme,
	FormatWarehouses.Warehouse,
	Setting.ProcurementStrategy,
	FALSE,
	ProductMatrix.Products.ProductKind
FROM
	TTProducts_1 AS ProductMatrix
		LEFT JOIN InformationRegister.SupplySchemes AS Setting
		ON (Setting.SupplyScheme = ProductMatrix.SupplyScheme)
			AND (Setting.Warehouse REFS Catalog.StoreFormats)
		LEFT JOIN TTWarehouseFormats AS FormatWarehouses
		ON (FormatWarehouses.StoreFormat = Setting.Warehouse)
		LEFT JOIN InformationRegister.SupplySchemes AS PreemptiveCircuitTuning
		ON (PreemptiveCircuitTuning.SupplyScheme = ProductMatrix.SupplyScheme)
			AND (PreemptiveCircuitTuning.Warehouse REFS Catalog.Warehouses)
			AND (PreemptiveCircuitTuning.Warehouse = FormatWarehouses.Warehouse)
		LEFT JOIN InformationRegister.GoodsProcurementStrategy AS PreemptiveSetting
		ON (PreemptiveSetting.Products = ProductMatrix.Products)
			AND (PreemptiveSetting.Characteristic = ProductMatrix.Characteristic)
			AND (PreemptiveSetting.Warehouse = FormatWarehouses.Warehouse)
			AND (PreemptiveSetting.AddlOrderingAttribute = 1)
WHERE
	NOT Setting.Warehouse IS NULL
	AND NOT FormatWarehouses.Warehouse IS NULL
	AND PreemptiveCircuitTuning.Warehouse IS NULL
	AND PreemptiveSetting.Warehouse IS NULL
{WHERE
	ProductMatrix.Products.*,
	ProductMatrix.Characteristic.*,
	FormatWarehouses.Warehouse.*,
	Setting.ProcurementStrategy.*,
	(FALSE) AS ThisIsAPersonalSetting,
	ProductMatrix.Products.ProductKind.* AS ProductKind}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>ThisIsAPersonalSetting</dataPath>
		<expression>Max(ThisIsAPersonalSetting)</expression>
		<group>Products</group>
		<group>Warehouse</group>
		<group>Characteristic</group>
	</totalField>
	<totalField>
		<dataPath>ProcurementStrategy</dataPath>
		<expression>Max(ProcurementStrategy)</expression>
		<group>Products</group>
		<group>Warehouse</group>
		<group>Characteristic</group>
	</totalField>
