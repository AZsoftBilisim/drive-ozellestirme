					<v8:content>Filter by segment internal</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Filter by segment internal</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Filter by segment internal</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>//////////////////////////////////////////////////////////////////////////////////////
// Temp table of nomenclature selection segments: for selection by nomenclature segment
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products, Characteristic, FilterByProductSegmentIsUsed
;

//////////////////////////////////////////////////////////////////////////////////////
// Temp table of inventory needstatements: Inventory in stock and in expected receipts, as well as needs according to the online register.
SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.InStockBalance AS InStockBalance,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.OrderedBalance AS OrderedBalance,
	Inventories.Received_1Balance AS Received_1Balance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
	Inventories.ToSupplyBalance AS ToSupplyBalance,
	Inventories.NotProvideBalance AS NotProvideBalance
INTO InventoryAndDemandsBalance
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		Warehouse REFS Catalog.Warehouses
			AND (&amp;ShowSeparateProducts OR Purpose = VALUE(Catalog.Assignments.EmptyRef))
			{((Products, Characteristic) IN(
				SELECT
					FilterTable.Products AS Products,
					FilterTable.Characteristic AS Characteristic
				FROM
					SelectionByProductSegment AS FilterTable
				WHERE
					FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)) AS FilterBySegmentInternal}
			{Products.* AS Products,
				Characteristic.* AS Characteristic,
				Warehouse.* AS Warehouse}) AS Inventories
INDEX BY
	Products, Characteristic, Warehouse, Purpose
;

////////////////////////////////////////////////////////////////////////////////////////
// Temp table of inventory requirements for controlled parties: Inventory and plan for unlocking controlled parties according to the online register.
SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.OrderDocument AS OrderDocument,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ToUnlockBalance AS ToUnlockBalance,
	Inventories.ReserveAtWarehouseFromLockedBalance AS ReserveAtWarehouseFromLockedBalance,
	Inventories.ReserveUponReceiptFromLockedBalance AS ReserveUponReceiptFromLockedBalance
	
INTO InventoryAndNeedsBalanceOfControlledLotsReference
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		Warehouse REFS Catalog.Warehouses
			AND (&amp;ShowSeparateProducts OR Purpose = VALUE(Catalog.Assignments.EmptyRef))
			{((Products, Characteristic) IN(
				SELECT
					FilterTable.Products AS Products,
					FilterTable.Characteristic AS Characteristic
				FROM
					SelectionByProductSegment AS FilterTable
				WHERE
					FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)) AS FilterBySegmentInternal}
			{Products.* AS Products,
				Characteristic.* AS Characteristic,
				Warehouse.* AS Warehouse}) AS Inventories
INDEX BY
	Products, Characteristic, Warehouse, Purpose
;

////////////////////////////////////////////////////////////////////////////////////////
// Temp table of the product to be shipped: Shipment on orders according to the online register.
SELECT ALLOWED
	GoodsForIssue.Products AS Products,
	GoodsForIssue.Characteristic AS Characteristic,
	GoodsForIssue.Warehouse AS Warehouse,
	GoodsForIssue.Purpose AS Purpose,
	GoodsForIssue.DocumentShipments AS DocumentShipments,
	GoodsForIssue.ToShipBalance AS ToShip
INTO GoodsForIssue
FROM
	AccumulationRegister.GoodsForIssue.Balance(,
			(&amp;ShowSeparateProducts OR Purpose = VALUE(Catalog.Assignments.EmptyRef))
			{((Products, Characteristic) IN(
				SELECT
					FilterTable.Products AS Products,
					FilterTable.Characteristic AS Characteristic
				FROM
					SelectionByProductSegment AS FilterTable
				WHERE
					FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)) AS FilterBySegmentInternal}
			{Products.* AS Products,
				Characteristic.* AS Characteristic,
				Warehouse.* AS Warehouse}) AS GoodsForIssue
;

//////////////////////////////////////////////////////////////////////////////////////
// Temp table of inventory distribution: data on inventory distribution according to offline register data.
SELECT ALLOWED
	NOT InventoryAllocation.InventoryState = VALUE(Enum.InventoryStates.NotProvided)
		AND (InventoryAllocation.DemandCharacteristic IN(
				VALUE(Enum.DemandCharacteristics.SnoozeReservation),
				VALUE(Enum.DemandCharacteristics.ToSupply))
			OR InventoryAllocation.InventoryState = VALUE(Enum.InventoryStates.PendingSupplyApproval)) AS ConsiderUnsecured,
	InventoryAllocation.Products AS Products,
	InventoryAllocation.Characteristic AS Characteristic,
	InventoryAllocation.Warehouse AS Warehouse,
	InventoryAllocation.Purpose AS Purpose,
	InventoryAllocation.InventoryState AS InventoryState,
	InventoryAllocation.DemandCharacteristic AS DemandCharacteristic,
	InventoryAllocation.ShipmentOrder AS ShipmentOrder,
	InventoryAllocation.ReceiptOrder AS ReceiptOrder,
	InventoryAllocation.AvailabilityDate AS AvailabilityDate,
	InventoryAllocation.Count AS Count
INTO InventoryAllocation
FROM
	InformationRegister.InventoryAllocation AS InventoryAllocation
		{LEFT JOIN SelectionByProductSegment AS FilterTable
		ON FilterTable.Products = InventoryAllocation.Products
			AND FilterTable.Characteristic = InventoryAllocation.Characteristic}
WHERE
	InventoryAllocation.Count &lt;&gt; 0
	AND InventoryAllocation.Warehouse REFS Catalog.Warehouses
	AND InventoryAllocation.DemandCharacteristic &lt;&gt; VALUE(Enum.DemandCharacteristics.NotProvide)
	AND NOT (InventoryAllocation.DemandCharacteristic = VALUE(Enum.DemandCharacteristics.Surplus)
			AND InventoryAllocation.InventoryState = VALUE(Enum.InventoryStates.PendingSupplyApproval))
	AND (&amp;ShowSeparateProducts OR InventoryAllocation.Purpose = VALUE(Catalog.Assignments.EmptyRef))
{WHERE
	(FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed) AS FilterBySegmentInternal}
{WHERE
	InventoryAllocation.Warehouse.* AS Warehouse,
	InventoryAllocation.Products.* AS Products,
	InventoryAllocation.Characteristic.* AS Characteristic}
INDEX BY
	ConsiderUnsecured
;


//////////////////////////////////////////////////////////////////////////////////////
// Temp table of the order structure.
SELECT ALLOWED
	Plan.Products AS Products,
	Plan.Characteristic AS Characteristic,
	Plan.Warehouse AS Warehouse,
	Plan.Purpose AS Purpose,
	Plan.StructureAssignment AS StructureAssignment,
	Plan.ProductionOrder AS ProductionOrder,
	Plan.ToSupply - Plan.Replaced AS ToSupply,
	Plan.AllocatedFromAvailableInventoryWithAssignment AS AllocatedFromAvailableInventoryWithAssignment,
	Plan.AllocatedInAssignedProductionLots AS AllocatedInAssignedProductionLots,
	Plan.LineKind AS LineKind,
	Plan.Scheduled AS Scheduled,
	CASE
		WHEN Plan.DateOfReceipt &lt;&gt; DATETIME(1,1,1)
			THEN Plan.DateOfReceipt
		ELSE ISNULL(ScheduleDates.Ending, DATETIME(1,1,1))
	END AS DateOfReceipt
INTO OrderStructure
FROM
	InformationRegister.OrderStructure AS Plan
		
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleDates
		ON Plan.ProductionOrder = ScheduleDates.ProductionOrder
		 AND ScheduleDates.ScheduleStatus = 0
		 AND Plan.KeyLot = ScheduleDates.KeyLot
		 AND ScheduleDates.Stage = VALUE(Catalog.ProductionStages.EmptyRef)
		
		{INNER JOIN SelectionByProductSegment AS FilterTable
			ON FilterTable.Products = Plan.Products
			AND FilterTable.Characteristic = Plan.Characteristic}
	WHERE
		Plan.Warehouse REFS Catalog.Warehouses
		AND (&amp;ShowSeparateProducts
			OR Plan.Purpose = VALUE(Catalog.Assignments.EmptyRef)
				AND (Plan.ToSupply - Plan.Replaced &lt;&gt; 0 OR Plan.AllocatedFromAvailableInventoryWithAssignment &lt;&gt; 0 OR Plan.AllocatedInAssignedProductionLots &lt;&gt; 0 OR Plan.Scheduled &lt;&gt; 0)
			OR Plan.StructureAssignment = VALUE(Catalog.Assignments.EmptyRef)
				AND (Plan.AllocatedFromAvailableInventoryWithAssignment &lt;&gt; 0 OR Plan.AllocatedInAssignedProductionLots &lt;&gt; 0))
		AND Plan.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureOfProducts)
		AND Plan.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.Disassembly)
		AND Plan.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct)
		AND ((Plan.ToSupply - Plan.Replaced &lt;&gt; 0 OR Plan.AllocatedFromAvailableInventoryWithAssignment &lt;&gt; 0 OR Plan.AllocatedInAssignedProductionLots &lt;&gt; 0)
			OR Plan.Scheduled &lt;&gt; 0)
{WHERE
	(FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed) AS FilterBySegmentInternal}
	{WHERE
		Plan.Warehouse.* AS Warehouse,
		Plan.Products.* AS Products,
		Plan.Characteristic.* AS Characteristic}
;


//////////////////////////////////////////////////////////////////////////////////////
// Temp table of Inventory allocation records: Inventory distribution data (reserves and available) according to offline register data, spread out by report resources.
SELECT
	Table.InventoryStateForReport AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.ShipmentOrder AS ShipmentOrder,
	Table.ReceiptOrder AS ReceiptOrder,
	Table.AvailabilityDate AS AvailabilityDate,
	SUM(Table.InStock) AS InStock,
	SUM(Table.Received_1) AS Received_1,
	SUM(Table.InReserve) AS InReserve,
	SUM(Table.Available) AS Available,
	SUM(Table.ToSupply) AS ToSupply
INTO RecordsFromInventoryDistribution
FROM(
	SELECT
		CASE
			WHEN Table.InventoryState = VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock)
				THEN VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock)
			ELSE Table.InventoryState
		END AS InventoryStateForReport,
		
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		CASE
			WHEN Table.ConsiderUnsecured
				THEN UNDEFINED
			ELSE Table.ShipmentOrder
		END AS ShipmentOrder,
		Table.ReceiptOrder AS ReceiptOrder,
		Table.AvailabilityDate AS AvailabilityDate,
		
		CASE
			WHEN Table.InventoryState IN(
					VALUE(Enum.InventoryStates.InStock),
					VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
					VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking))
				THEN Table.Count
			ELSE 0
		END AS InStock,
		
		CASE
			WHEN Table.InventoryState IN(
					VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
					VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
					VALUE(Enum.InventoryStates.ExpectedForReceiptNotSubjectToUnlocking))
				THEN Table.Count
			ELSE 0
		END AS Received_1,
		
		CASE
			WHEN Table.DemandCharacteristic IN(
						VALUE(Enum.DemandCharacteristics.ReserveAtWarehouse),
						VALUE(Enum.DemandCharacteristics.ReserveAsReceived),
						VALUE(Enum.DemandCharacteristics.ReserveAtWarehouseFromLocked),
						VALUE(Enum.DemandCharacteristics.ReserveUponReceiptFromLocked))
					AND Table.InventoryState IN(
						VALUE(Enum.InventoryStates.InStock),
						VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
						VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking),
						VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
						VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
						VALUE(Enum.InventoryStates.ExpectedForReceiptNotSubjectToUnlocking))
				THEN Table.Count
			ELSE 0
		END AS InReserve,
		
		CASE
			WHEN Table.DemandCharacteristic IN(
						VALUE(Enum.DemandCharacteristics.SnoozeReservation),
						VALUE(Enum.DemandCharacteristics.ToSupply),
						VALUE(Enum.DemandCharacteristics.Surplus))
					AND Table.InventoryState IN(
						VALUE(Enum.InventoryStates.InStock),
						VALUE(Enum.InventoryStates.AvailablePendingUnlocking),
						VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking),
						VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock),
						VALUE(Enum.InventoryStates.ExpectedForReceiptWithLock),
						VALUE(Enum.InventoryStates.ExpectedForReceiptNotSubjectToUnlocking))
				THEN Table.Count
			ELSE 0
		END AS Available,
		
		CASE
			WHEN Table.InventoryState = VALUE(Enum.InventoryStates.NotProvided)
				THEN Table.Count
			ELSE 0
		END AS ToSupply
FROM
	InventoryAllocation AS Table

UNION ALL

	SELECT
		VALUE(Enum.InventoryStates.NotProvided) AS InventoryStateForReport,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.ShipmentOrder AS ShipmentOrder,
		UNDEFINED AS ReceiptOrder,
		DATETIME(1, 1, 1) AS AvailabilityDate,
		0 AS InStock,
		0 AS Received_1,
		0 AS InReserve,
		0 AS Available,
		Table.Count AS ToSupply
FROM
	InventoryAllocation AS Table
WHERE
	Table.ConsiderUnsecured) AS Table
GROUP BY
	Table.InventoryStateForReport,
	Table.Products,
	Table.Characteristic,
	Table.Warehouse,
	Table.Purpose,
	Table.ShipmentOrder,
	Table.ReceiptOrder,
	Table.AvailabilityDate
;

////////////////////////////////////////////////////////////////////////////////
// Temp table Calculation of reserves: The result of the distribution of inventory for the needs of the tested goods, taking into account the distribution of inventory for the needs of the untested goods.
SELECT
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.InStock AS InStock,
	Table.AvailableWithLock AS AvailableForQualityControl,
	Table.AvailableWithoutUnlocking AS AvailableNotSubjectToUnlocking,
	Table.Expected_
		+ Table.ExpectedWithBlocking AS Expected_,
	Table.ExpectedWithoutUnlocking AS ExpectedNotToBeUnlocked,
	Table.Available_Reserve
		+ Table.Available_ReserveAsNeeded AS InReserveNow,
	Table.AvailableWithLock_ReserveAsNeeded
		+ Table.AvailableWithLock_Reserve_FromBlocked
		+ Table.AvailableWithLock_ReserveAsNeeded_FromBlocked AS InReserveNowOnQualityControl,
	Table.ExpectedTo_ReserveAsNeeded
		+ Table.ExpectedWithLock_ReserveAsNeeded
		+ Table.ExpectedWithLock_ReserveAsNeeded_FromBlocked AS ReserveIsExpectedTo,
	Table.AvailableWithoutUnlocking_Reserve_FromLocked
		+ Table.AvailableWithoutUnlocking_ReserveAsNeeded_FromBlocked AS ReserveIsCurrentlyNotSubjectToUnblocking,
	Table.ExpectedWithoutUnlocking_ReserveAsNeeded_FromBlocked AS ReserveIsExpectedNotToBeUnblocked,
	Table.Available_Postpone
		+ Table.InStock_K
		+ Table.Available_Surplus AS AvailableNow,
	Table.AvailableWithLock_Postpone
		+ Table.AvailableWithLock_CSupply
		+ Table.AvailableWithLock_Surplus AS AvailableNowOnQualityControl,
	Table.ExpectedTo_Postpone
		+ Table._KIsExpectedToProvide
		+ Table.Expected_Surplus
		+ Table.PendingWithLock_Postpone
		+ Table.ExpectedWith_KLock
		+ Table.ExpectedWithLock_Surplus AS AvailableExpected,
	Table.AvailableWithoutUnlocking_Surplus AS AvailableNowCannotBeUnlocked,
	Table.ExpectedWithoutUnlocking_Surplus AS AvailableExpectedNotToBeUnlocked,
	Table.ToSupply
		+ Table.Snooze
		+ Table.OnApproval_ReserveAsNeeded
		+ Table.NotProvided_ReserveAsNeeded
		+ Table.NotProvided_ReserveAsNeeded_FromBlocked AS ToSupply
INTO CalculationOfReserves
FROM
	SubstitutionCalculationOfReserves AS Table
;

////////////////////////////////////////////////////////////////////////////////
// Temp table of Inventory Allocationonline
SELECT
	VALUE(Enum.InventoryStates.InStock) AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.InStock AS InStock,
	0 AS Received_1,
	Table.InReserveNow AS InReserve,
	Table.AvailableNow AS Available,
	0 AS ToSupply
INTO InventoryDistributionOnline
FROM
	CalculationOfReserves AS Table
WHERE
	Table.InStock &lt;&gt; 0 OR Table.InReserveNow &lt;&gt; 0 OR Table.AvailableNow &lt;&gt; 0

UNION ALL

SELECT
	VALUE(Enum.InventoryStates.AvailablePendingUnlocking) AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.AvailableForQualityControl AS InStock,
	0 AS Received_1,
	Table.InReserveNowOnQualityControl AS InReserve,
	Table.AvailableNowOnQualityControl AS Available,
	0 AS ToSupply
FROM
	CalculationOfReserves AS Table
WHERE
	Table.AvailableForQualityControl &lt;&gt; 0 OR Table.InReserveNowOnQualityControl &lt;&gt; 0 OR Table.AvailableNowOnQualityControl &lt;&gt; 0

UNION ALL

SELECT
	VALUE(Enum.InventoryStates.AvailableNotSubjectToUnlocking) AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.AvailableNotSubjectToUnlocking AS InStock,
	0 AS Received_1,
	Table.ReserveIsCurrentlyNotSubjectToUnblocking AS InReserve,
	Table.AvailableNowCannotBeUnlocked AS Available,
	0 AS ToSupply
FROM
	CalculationOfReserves AS Table
WHERE
	Table.AvailableNotSubjectToUnlocking &lt;&gt; 0 OR Table.ReserveIsCurrentlyNotSubjectToUnblocking &lt;&gt; 0 OR Table.AvailableNowCannotBeUnlocked &lt;&gt; 0

UNION ALL

SELECT
	VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock) AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	0 AS InStock,
	Table.Expected_ AS Received_1,
	Table.ReserveIsExpectedTo AS InReserve,
	Table.AvailableExpected AS Available,
	0 AS ToSupply
FROM
	CalculationOfReserves AS Table
WHERE
	Table.Expected_ &lt;&gt; 0 OR Table.ReserveIsExpectedTo &lt;&gt; 0 OR Table.AvailableExpected &lt;&gt; 0

UNION ALL

SELECT
	VALUE(Enum.InventoryStates.ExpectedForReceiptNotSubjectToUnlocking) AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	0 AS InStock,
	Table.ExpectedNotToBeUnlocked AS Received_1,
	Table.ReserveIsExpectedNotToBeUnblocked AS InReserve,
	Table.AvailableExpectedNotToBeUnlocked AS Available,
	0 AS ToSupply
FROM
	CalculationOfReserves AS Table
WHERE
	Table.ExpectedNotToBeUnlocked &lt;&gt; 0 OR Table.ReserveIsExpectedNotToBeUnblocked &lt;&gt; 0 OR Table.AvailableExpectedNotToBeUnlocked &lt;&gt; 0

UNION ALL

SELECT
	VALUE(Enum.InventoryStates.NotProvided) AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	0 AS InStock,
	0 AS Received_1,
	0 AS InReserve,
	0 AS Available,
	Table.ToSupply AS ToSupply
FROM
	CalculationOfReserves AS Table
WHERE
	Table.ToSupply &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
// Temp table of divergenceonlineofflineregistrations
SELECT
	Table.InventoryStateForReport AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	SUM(Table.InStock) AS InStock,
	SUM(Table.Received_1) AS Received_1,
	SUM(Table.InReserve) AS InReserve,
	SUM(Table.Available) AS Available,
	SUM(Table.ToSupply) AS ToSupply
INTO DiscrepanciesBetweenOnlineAndOfflineRegisters
FROM(
	SELECT
		Table.InventoryStateForReport AS InventoryStateForReport,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.InStock AS InStock,
		Table.Received_1 AS Received_1,
		Table.InReserve AS InReserve,
		Table.Available AS Available,
		Table.ToSupply AS ToSupply
	FROM
		InventoryDistributionOnline AS Table
	
	UNION ALL
	
	SELECT
		Table.InventoryStateForReport AS InventoryStateForReport,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		- Table.InStock AS InStock,
		- Table.Received_1 AS Received_1,
		- Table.InReserve AS InReserve,
		- Table.Available AS Available,
		- Table.ToSupply AS ToSupply
	FROM
		RecordsFromInventoryDistribution AS Table
) AS Table
GROUP BY
	Table.InventoryStateForReport,
	Table.Products,
	Table.Characteristic,
	Table.Warehouse,
	Table.Purpose
HAVING
	SUM(Table.InStock) &lt;&gt; 0
		OR SUM(Table.Received_1) &lt;&gt; 0
		OR SUM(Table.InReserve) &lt;&gt; 0
		OR SUM(Table.Available) &lt;&gt; 0
		OR SUM(Table.ToSupply) &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
// The temp table of the report data table.
// Shipped according to shipment orders.
SELECT ALLOWED
	Set.InventoryStateForReport AS InventoryStateForReport,
	Set.Products AS Products,
	Set.Characteristic AS Characteristic,
	Set.Warehouse AS Warehouse,
	Set.Purpose AS Purpose,
	Set.ShipmentOrder AS ShipmentOrder,
	Set.ReceiptOrder AS ReceiptOrder,
	Set.AvailabilityDate AS AvailabilityDate,
	SUM(Set.BeingShipped) AS BeingShipped,
	SUM(Set.InStock) AS InStock,
	SUM(Set.Received_1) AS Received_1,
	SUM(Set.InReserve) AS InReserve,
	SUM(Set.Available) AS Available,
	SUM(Set.ToSupply) AS ToSupply
INTO ReportDataTable
FROM(
	SELECT
		VALUE(Enum.InventoryStates.InStock) AS InventoryStateForReport,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.DocumentShipments AS ShipmentOrder,
		UNDEFINED AS ReceiptOrder,
		DATETIME(1, 1, 1) AS AvailabilityDate,
		Table.ToShip AS BeingShipped,
		0 AS InStock,
		0 AS Received_1,
		0 AS InReserve,
		0 AS Available,
		0 AS ToSupply
	FROM
		GoodsForIssue AS Table
	
	UNION ALL
	
	SELECT
		VALUE(Enum.InventoryStates.InStock) AS InventoryStateForReport,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		UNDEFINED AS ShipmentOrder,
		UNDEFINED AS ReceiptOrder,
		DATETIME(1, 1, 1) AS AvailabilityDate,
		0 AS BeingShipped,
		Table.ToShip AS InStock,
		0 AS Received_1,
		0 AS InReserve,
		0 AS Available,
		0 AS ToSupply
	FROM
		GoodsForIssue AS Table
	
	UNION ALL
	
	// Records of inventory, needs, available Balances, and reserves based on inventory allocation data.
	SELECT
		Table.InventoryStateForReport AS InventoryStateForReport,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.ShipmentOrder AS ShipmentOrder,
		Table.ReceiptOrder AS ReceiptOrder,
		Table.AvailabilityDate AS AvailabilityDate,
		0 AS BeingShipped,
		0 AS InStock,
		0 AS Received_1,
		Table.InReserve AS InReserve,
		0 AS Available,
		Table.ToSupply AS ToSupply
	FROM
		RecordsFromInventoryDistribution AS Table
	WHERE
		Table.InReserve &lt;&gt; 0
			OR Table.ToSupply &lt;&gt; 0
	
	UNION ALL
	
	SELECT
		Table.InventoryStateForReport AS InventoryStateForReport,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		UNDEFINED AS ShipmentOrder,
		Table.ReceiptOrder AS ReceiptOrder,
		Table.AvailabilityDate AS AvailabilityDate,
		0 AS BeingShipped,
		Table.InStock AS InStock,
		Table.Received_1 AS Received_1,
		0 AS InReserve,
		Table.Available AS Available,
		0 AS ToSupply
	FROM
		RecordsFromInventoryDistribution AS Table
	WHERE
		Table.InStock &lt;&gt; 0
			OR Table.Received_1 &lt;&gt; 0
			OR Table.Available &lt;&gt; 0
	
	UNION ALL
	
	// Adjustment of data by the amount of unprocessed tasks for the distribution of inventory.
	SELECT
		Table.InventoryStateForReport AS InventoryStateForReport,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		UNDEFINED AS ShipmentOrder,
		UNDEFINED AS ReceiptOrder,
		DATETIME(1,1,1) AS AvailabilityDate,
		0 AS BeingShipped,
		Table.InStock AS InStock,
		Table.Received_1 AS Received_1,
		Table.InReserve AS InReserve,
		Table.Available AS Available,
		Table.ToSupply AS ToSupply
	FROM
		DiscrepanciesBetweenOnlineAndOfflineRegisters AS Table
	

	UNION ALL
	
	
	// Planned receipts and needs from a dynamic structure.
	SELECT
		VALUE(Enum.InventoryStates.NotProvided) AS EntryType,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		Table.ProductionOrder AS ShipmentOrder,
		UNDEFINED AS ReceiptOrder,
		DATETIME(1, 1, 1) AS AvailabilityDate,
		0 AS BeingShipped,
		0 AS InStock,
		0 AS Received_1,
		0 AS InReserve,
		0 AS Available,
		Table.ToSupply
			- Table.AllocatedFromAvailableInventoryWithAssignment
			- Table.AllocatedInAssignedProductionLots AS ToSupply
	FROM
		OrderStructure AS Table
	WHERE
		Table.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct)
		AND (&amp;ShowSeparateProducts OR Table.Purpose = VALUE(Catalog.Assignments.EmptyRef))
	
	UNION ALL
	
	SELECT
		VALUE(Enum.InventoryStates.NotProvided) AS EntryType,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.StructureAssignment AS Purpose,
		Table.ProductionOrder AS ShipmentOrder,
		UNDEFINED AS ReceiptOrder,
		DATETIME(1, 1, 1) AS AvailabilityDate,
		0 AS BeingShipped,
		0 AS InStock,
		0 AS Received_1,
		0 AS InReserve,
		0 AS Available,
		Table.AllocatedFromAvailableInventoryWithAssignment
			+ Table.AllocatedInAssignedProductionLots AS ToSupply
	FROM
		OrderStructure AS Table
	WHERE
		Table.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.ManufacturedProduct)
		AND (&amp;ShowSeparateProducts OR Table.StructureAssignment = VALUE(Catalog.Assignments.EmptyRef))
		
	UNION ALL
	
	SELECT
		VALUE(Enum.InventoryStates.ExpectedForReceiptWithoutLock) AS EntryType,
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		UNDEFINED AS ShipmentOrder,
		Table.ProductionOrder AS ReceiptOrder,
		Table.DateOfReceipt AS AvailabilityDate,
		0 AS BeingShipped,
		0 AS InStock,
		Table.Scheduled AS Received_1,
		0 AS InReserve,
		Table.Scheduled AS Available,
		0 AS ToSupply
	FROM
		OrderStructure AS Table
	WHERE
		&amp;ShowSeparateProducts OR Table.Purpose = VALUE(Catalog.Assignments.EmptyRef)
	
	
	) AS Set
GROUP BY
	Set.InventoryStateForReport,
	Set.Products,
	Set.Characteristic,
	Set.Warehouse,
	Set.Purpose,
	Set.ShipmentOrder,
	Set.ReceiptOrder,
	Set.AvailabilityDate
HAVING
	SUM(Set.BeingShipped) &lt;&gt; 0
	OR SUM(Set.InStock) &lt;&gt; 0
	OR SUM(Set.Received_1) &lt;&gt; 0
	OR SUM(Set.InReserve) &lt;&gt; 0
	OR SUM(Set.Available) &lt;&gt; 0
	OR SUM(Set.ToSupply) &lt;&gt; 0
INDEX BY
	Products, Characteristic, Warehouse, Purpose
;

////////////////////////////////////////////////////////////////////////////////
// Calculation of surplus and deficit.
SELECT
	TableIsGrouped.Products AS Products,
	TableIsGrouped.Characteristic AS Characteristic,
	TableIsGrouped.Warehouse AS Warehouse,
	TableIsGrouped.Purpose AS Purpose,
	CASE
		WHEN
			TableIsGrouped.ToSupply
				+ TableIsGrouped.InReserve
				- CASE
					WHEN TableIsGrouped.InStock
							- TableIsGrouped.BeingShipped
							+ TableIsGrouped.Received_1 &gt; 0
						THEN TableIsGrouped.InStock
							- TableIsGrouped.BeingShipped
							+ TableIsGrouped.Received_1
					ELSE 0
				END &gt; 0
			THEN
				TableIsGrouped.ToSupply
				+ TableIsGrouped.InReserve
				- CASE
					WHEN TableIsGrouped.InStock
							- TableIsGrouped.BeingShipped
							+ TableIsGrouped.Received_1 &gt; 0
						THEN TableIsGrouped.InStock
							- TableIsGrouped.BeingShipped
							+ TableIsGrouped.Received_1
					ELSE 0
				END
		ELSE 0
	END AS Deficit,
	CASE
		WHEN
			TableIsGrouped.InStock
				- TableIsGrouped.BeingShipped
				+ TableIsGrouped.Received_1
				- TableIsGrouped.ToSupply
				- TableIsGrouped.InReserve &gt; 0
			THEN
				TableIsGrouped.InStock
					- TableIsGrouped.BeingShipped
					+ TableIsGrouped.Received_1
					- TableIsGrouped.ToSupply
					- TableIsGrouped.InReserve
		WHEN
			TableIsGrouped.InStock
				- TableIsGrouped.BeingShipped
				+ TableIsGrouped.Received_1 &lt; 0
			THEN
				TableIsGrouped.InStock
					- TableIsGrouped.BeingShipped
					+ TableIsGrouped.Received_1
		ELSE 0
	END AS Surplus
INTO ReportDataTableGrouped
FROM(
	SELECT
		Table.Products AS Products,
		Table.Characteristic AS Characteristic,
		Table.Warehouse AS Warehouse,
		Table.Purpose AS Purpose,
		SUM(Table.BeingShipped) AS BeingShipped,
		SUM(Table.InStock) AS InStock,
		SUM(Table.Received_1) AS Received_1,
		SUM(Table.InReserve) AS InReserve,
		SUM(Table.Available) AS Available,
		SUM(Table.ToSupply) AS ToSupply
	FROM
		ReportDataTable AS Table
	GROUP BY
		Table.Products,
		Table.Characteristic,
		Table.Warehouse,
		Table.Purpose) AS TableIsGrouped
		
INDEX BY
	Products, Characteristic, Warehouse, Purpose
;

////////////////////////////////////////////////////////////////////////////////
// Building a report.
SELECT ALLOWED
	Table.InventoryStateForReport AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	Table.ShipmentOrder AS ShipmentOrder,
	Table.ReceiptOrder AS ReceiptOrder,
	Table.AvailabilityDate AS AvailabilityDate,
	Table.BeingShipped AS BeingShipped,
	Table.InStock AS InStock,
	Table.Received_1 AS Received_1,
	Table.InReserve AS InReserve,
	Table.Available AS Available,
	Table.InReserve + Table.Available AS InReservePlusAvailable,
	Table.ToSupply AS ToSupply,
	ISNULL(TableIsGrouped.Deficit, 0) AS Deficit,
	ISNULL(TableIsGrouped.Surplus, 0) AS Surplus,
	ISNULL(CAST(Table.Purpose AS Catalog.Assignments).LineOfBusiness,
		VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
	ISNULL(CAST(Table.Purpose AS Catalog.Assignments).Partner,
		VALUE(Catalog.Partners.EmptyRef)) AS Partner,
	ISNULL(CAST(Table.Purpose AS Catalog.Assignments).Contract,
		VALUE(Catalog.CounterpartyContracts.EmptyRef)) AS Contract,
	CAST(Table.Products AS Catalog.Products).UnitOfMeasure AS StorageUnit,
	CAST(Table.Products AS Catalog.Products).UnitForReports AS UnitForReports,
	CAST(Table.Products AS Catalog.Products).UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS Weight,
	&amp;QueryTextTheVolumeOfTheItem AS VolumeM3
FROM
	ReportDataTable AS Table
		
		LEFT JOIN ReportDataTableGrouped AS TableIsGrouped
		ON TableIsGrouped.Products = Table.Products
		 AND TableIsGrouped.Characteristic = Table.Characteristic
		 AND TableIsGrouped.Warehouse = Table.Warehouse
		 AND TableIsGrouped.Purpose = Table.Purpose
		 AND Table.ShipmentOrder = UNDEFINED
		 AND Table.ReceiptOrder = UNDEFINED
		 AND Table.InventoryStateForReport = VALUE(Enum.InventoryStates.InStock)

UNION ALL

SELECT
	VALUE(Enum.InventoryStates.InStock) AS InventoryStateForReport,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Warehouse AS Warehouse,
	Table.Purpose AS Purpose,
	UNDEFINED AS ShipmentOrder,
	UNDEFINED AS ReceiptOrder,
	DATETIME(1, 1, 1) AS AvailabilityDate,
	0 AS BeingShipped,
	0 AS InStock,
	0 AS Received_1,
	0 AS InReserve,
	0 AS Available,
	0 AS InReservePlusAvailable,
	0 AS ToSupply,
	Table.Deficit AS Deficit,
	Table.Surplus AS Surplus,
	ISNULL(CAST(Table.Purpose AS Catalog.Assignments).LineOfBusiness,
		VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS LineOfBusiness,
	ISNULL(CAST(Table.Purpose AS Catalog.Assignments).Partner,
		VALUE(Catalog.Partners.EmptyRef)) AS Partner,
	ISNULL(CAST(Table.Purpose AS Catalog.Assignments).Contract,
		VALUE(Catalog.CounterpartyContracts.EmptyRef)) AS Contract,
	CAST(Table.Products AS Catalog.Products).UnitOfMeasure AS StorageUnit,
	CAST(Table.Products AS Catalog.Products).UnitForReports AS UnitForReports,
	CAST(Table.Products AS Catalog.Products).UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS Weight,
	&amp;QueryTextTheVolumeOfTheItem AS VolumeM3
FROM
	ReportDataTableGrouped AS Table
		
		LEFT JOIN ReportDataTable AS DataTable
		ON DataTable.Products = Table.Products
		 AND DataTable.Characteristic = Table.Characteristic
		 AND DataTable.Warehouse = Table.Warehouse
		 AND DataTable.Purpose = Table.Purpose
		 AND DataTable.ShipmentOrder = UNDEFINED
		 AND DataTable.ReceiptOrder = UNDEFINED
		 AND DataTable.InventoryStateForReport = VALUE(Enum.InventoryStates.InStock)
WHERE
	DataTable.Products IS NULL
		AND (Table.Deficit &lt;&gt; 0 OR Table.Surplus &lt;&gt; 0)
</query>
