		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Table.ReferenceOrder   AS ReferenceOrder,
	Table.Products   AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose     AS Purpose,
	
	Table.Required2Turnover + Table.DisassemblyIsRequiredTurnover AS Required2,
	
	Table.ScheduledTurnover
		+ Table.TransferredToProductionTurnover
		+ Table.ProducedTurnover
		+ Table.ManufacturedTurnover
		+ (CASE 
			WHEN Table.DisassemblyIsPlannedTurnover - Table.ReadyForDisassemblyTurnover &gt; 0
				THEN
					Table.DisassemblyIsPlannedTurnover - Table.ReadyForDisassemblyTurnover
				ELSE 0
			END) AS Scheduled,
	
	(Table.Required2Turnover
		- Table.ScheduledTurnover
		- Table.TransferredToProductionTurnover
		- Table.ProducedTurnover
		- Table.ManufacturedTurnover)
	+ 
	(Table.DisassemblyIsRequiredTurnover
		- (CASE 
			WHEN Table.DisassemblyIsPlannedTurnover - Table.ReadyForDisassemblyTurnover &gt; 0
				THEN
					Table.DisassemblyIsPlannedTurnover - Table.ReadyForDisassemblyTurnover
			ELSE
				0
			END)) AS ToTheCreation
FROM
	AccumulationRegister.ProductionProcessSupply.Turnovers() AS Table
WHERE
	(Table.Required2Turnover
		- Table.ScheduledTurnover
		- Table.TransferredToProductionTurnover
		- Table.ProducedTurnover
		- Table.ManufacturedTurnover) &gt; 0
	OR
	(Table.DisassemblyIsRequiredTurnover
		- (CASE 
			WHEN Table.DisassemblyIsPlannedTurnover - Table.ReadyForDisassemblyTurnover &gt; 0
				THEN
					Table.DisassemblyIsPlannedTurnover - Table.ReadyForDisassemblyTurnover
			ELSE
				0
			END)) &gt; 0
</query>
	</dataSet>
	<totalField>
		<dataPath>Scheduled</dataPath>
		<expression>Sum(Scheduled)</expression>
	</totalField>
	<totalField>
		<dataPath>ToTheCreation</dataPath>
		<expression>Sum(ToTheCreation)</expression>
	</totalField>
	<totalField>
		<dataPath>Required2</dataPath>
		<expression>Sum(Required2)</expression>
	</totalField>
