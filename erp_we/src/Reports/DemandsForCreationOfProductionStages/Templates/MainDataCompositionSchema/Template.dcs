When ValueIsFilled(Purpose)
Then Purpose
Else NStr("ru = '&lt;без назначения&gt;'; vi = '&lt;không mục đích&gt;'; en = '&lt;without assignment&gt;'; it = '&lt;senza assegnazione&gt;'; pl = '&lt;bez przeznaczenia&gt;'; tr = '&lt;atama olmadan&gt;'")
