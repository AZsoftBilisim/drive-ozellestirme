	<totalField>
		<dataPath>Indicators.AveragePrice.AveragePriceReceipt</dataPath>
		<expression>Case When Sum(Indicators.Count.CountReceipt) &lt;&gt; 0 Then 

    Sum(Indicators.Cost_.Cost_Receipt) / Sum(Indicators.Count.CountReceipt)

Else

    0

End</expression>
		<group>DimensionOfProductItem.Products</group>
		<group>DimensionOfProductItem.Series</group>
		<group>DimensionOfProductItem.Characteristic</group>
		<group>Document</group>
	</totalField>
