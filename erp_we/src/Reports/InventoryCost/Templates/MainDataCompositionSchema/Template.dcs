		<field xsi:type="DataSetFieldField">
			<dataPath>TurnoverDimension.Department</dataPath>
			<field>Department</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Business unit (turnover)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>واحد تجاری (گردش)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Reparto (fatturato)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Dział (wielkość)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Подразделение (об)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Departman (hacim)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Bộ phận</v8:content>
				</v8:item>
			</title>
			<attributeUseRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<presentationExpression>Case

    When TurnoverDimension.Department = "InitialResiduals"

        Then NStr("ru = '&lt;Начальный остаток&gt;'; vi = '&lt;Số dư đầu&gt;'; en = '&lt;Opening balance&gt;'; it = '&lt;Saldo iniziale&gt;'; pl = '&lt;Saldo początkowe&gt;'; tr = '&lt;Açılış bakiyesi&gt;'")

    When TurnoverDimension.Department = "FinalBalances"

        Then NStr("ru = '&lt;Конечный остаток&gt;'; vi = '&lt;Số dư cuối&gt;'; en = '&lt;Closing balance&gt;'; it = '&lt;Saldo finale&gt;'; pl = '&lt;Saldo końcowe&gt;'; tr = '&lt;Kapanış bakiyesi&gt;'")

    When TurnoverDimension.Department Is NULL

        Then NStr("ru = '&lt;Неклассифицированный оборот&gt;'; vi = '&lt;Phát sinh chưa phân loại&gt;'; en = '&lt;Unclassified turnover&gt;'; it = '&lt;Fatturato non classificato&gt;'; pl = '&lt;Obrót nieklasyfikowany&gt;'; tr = '&lt;Sınıflandırılmayan ciro&gt;'")

    Else TurnoverDimension.Department

End</presentationExpression>
			<orderExpression>
				<dcscom:expression>Case 

    When TurnoverDimension.Department = "InitialResiduals"

        Then -999999999

    When TurnoverDimension.Department Is NULL

        Then 999999998

    When TurnoverDimension.Department = "FinalBalances"

        Then 999999999

    Else 0

End</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>true</dcscom:autoOrder>
			</orderExpression>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.BusinessStructure</v8:Type>
			</valueType>
		</field>
