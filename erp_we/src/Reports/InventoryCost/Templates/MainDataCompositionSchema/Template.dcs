					<v8:lang>ru</v8:lang>
					<v8:content>Период отклонения (об)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Fark dönemi (devir)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ chênh lệch (về)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Variance period (turnover)</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Variance period (turnover)</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Case

    When TurnoverDimension.VariancePeriod = "InitialResiduals"

        Then NStr("ru = '&lt;Начальный остаток&gt;'; vi = '&lt;Số dư đầu&gt;'; en = '&lt;Opening balance&gt;'; it = '&lt;Saldo iniziale&gt;'; pl = '&lt;Saldo początkowe&gt;'; tr = '&lt;Açılış bakiyesi&gt;'")

    When TurnoverDimension.VariancePeriod = "FinalBalances"

        Then NStr("ru = '&lt;Конечный остаток&gt;'; vi = '&lt;Số dư cuối&gt;'; en = '&lt;Closing balance&gt;'; it = '&lt;Saldo finale&gt;'; pl = '&lt;Saldo końcowe&gt;'; tr = '&lt;Kapanış bakiyesi&gt;'")

    When TurnoverDimension.VariancePeriod Is NULL

        Then NStr("ru = '&lt;Неклассифицированный оборот&gt;'; vi = '&lt;Phát sinh chưa phân loại&gt;'; en = '&lt;Unclassified turnover&gt;'; it = '&lt;Fatturato non classificato&gt;'; pl = '&lt;Obrót nieklasyfikowany&gt;'; tr = '&lt;Sınıflandırılmayan ciro&gt;'")

    Else TurnoverDimension.VariancePeriod

End</presentationExpression>
			<orderExpression>
				<dcscom:expression>Case 

    When TurnoverDimension.VariancePeriod = "InitialResiduals"

        Then -999999999

    When TurnoverDimension.VariancePeriod Is NULL

        Then 999999998

    When TurnoverDimension.VariancePeriod = "FinalBalances"

        Then 999999999

    Else 0

End</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>false</dcscom:autoOrder>
			</orderExpression>
			<valueType>
				<v8:Type>xs:dateTime</v8:Type>
				<v8:DateQualifiers>
					<v8:DateFractions>Date</v8:DateFractions>
				</v8:DateQualifiers>
			</valueType>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Format</dcscor:parameter>
