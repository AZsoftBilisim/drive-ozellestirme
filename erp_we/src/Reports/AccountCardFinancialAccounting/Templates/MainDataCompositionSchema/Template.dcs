				<dataPath>YearPeriod</dataPath>
				<field>YearPeriod</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	BalanceAndTurnovers.Account AS Account,
	BalanceAndTurnovers.SumOpeningBalance AS SumOpeningBalance,
	BalanceAndTurnovers.SumTurnoverDr AS SumTurnoverDr,
	BalanceAndTurnovers.SumTurnoverCr AS SumTurnoverCr,
	BalanceAndTurnovers.SumClosingBalance AS SumClosingBalance,
	BalanceAndTurnovers.PresentationAmountOpeningBalance AS PresentationAmountOpeningBalance,
	BalanceAndTurnovers.PresentationAmountTurnoverDr AS PresentationAmountTurnoverDr,
	BalanceAndTurnovers.PresentationAmountTurnoverCr AS PresentationAmountTurnoverCr,
	BalanceAndTurnovers.PresentationAmountClosingBalance AS PresentationAmountClosingBalance,
	BalanceAndTurnovers.CurrencyAmountTurnoverDr AS CurrencyAmountTurnoverDr,
	BalanceAndTurnovers.CurrencyAmountTurnoverCr AS CurrencyAmountTurnoverCr,
	BalanceAndTurnovers.Recorder AS Recorder,
	BalanceAndTurnovers.LineNumber AS LineNumber,
	CAST(&amp;LineGrandTotals AS STRING(15)) AS GeneralResults,
	BalanceAndTurnovers.CountOpeningBalance AS CountOpeningBalance,
	BalanceAndTurnovers.CountClosingBalance AS CountClosingBalance,
	BalanceAndTurnovers.CountTurnoverDr AS CountTurnoverDr,
	BalanceAndTurnovers.CountTurnoverCr AS CountTurnoverCr,
	BalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	BalanceAndTurnovers.MinutePeriod AS MinutePeriod,
	BalanceAndTurnovers.HourPeriod AS HourPeriod,
	BalanceAndTurnovers.DayPeriod AS DayPeriod,
	BalanceAndTurnovers.WeekPeriod AS WeekPeriod,
	BalanceAndTurnovers.TenDaysPeriod AS TenDaysPeriod,
	BalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	BalanceAndTurnovers.YearPeriod AS YearPeriod
INTO BalanceAndTurnovers
FROM
	AccountingRegister.InternationalWithoutCorrespondence.BalanceAndTurnovers({&amp;BeginOfPeriod}, {&amp;EndOfPeriod}, Auto,,
		{(Account).* AS Account}, {&amp;ExtDimensionType},
	NOT ChartOfAccounts.DeletionMark
	AND ChartOfAccounts = &amp;ChartOfAccounts {(Organization).* AS Organization} {(Department).* AS Department} {(Currency).* AS
		Currency} {(LineOfBusiness).* AS LineOfBusiness} {(ExtDimension1).* AS ExtDimension1} {(ExtDimension2).* AS
		ExtDimension2} {(ExtDimension3).* AS ExtDimension3}) AS BalanceAndTurnovers

INDEX BY
	Recorder,
	LineNumber
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RecordsWithExtDimensions.Period AS Period,
	RecordsWithExtDimensions.PointInTime AS PointInTime,
	RecordsWithExtDimensions.Organization AS Organization,
	RecordsWithExtDimensions.ChartOfAccounts AS ChartOfAccounts,
	RecordsWithExtDimensions.Recorder AS Recorder,
	RecordsWithExtDimensions.LineNumber AS LineNumber,
	RecordsWithExtDimensions.Account AS Account,
	RecordsWithExtDimensions.ExtDimension1 AS ExtDimension1,
	RecordsWithExtDimensions.ExtDimension2 AS ExtDimension2,
	RecordsWithExtDimensions.ExtDimension3 AS ExtDimension3,
	RecordsWithExtDimensions.Currency AS Currency,
	RecordsWithExtDimensions.Department AS Department,
	RecordsWithExtDimensions.LineOfBusiness AS LineOfBusiness,
	RecordsWithExtDimensions.Content AS Content
INTO RecordsWithExtDimensions
FROM
	AccountingRegister.InternationalWithoutCorrespondence.RecordsWithExtDimensions({&amp;BeginOfPeriod}, {&amp;EndOfPeriod},
		Active = TRUE
	AND NOT ChartOfAccounts.DeletionMark
	AND ChartOfAccounts = &amp;ChartOfAccounts {(Organization).* AS Organization} {(Department).* AS Department} {(Currency).* AS
		Currency} {(LineOfBusiness).* AS LineOfBusiness} {(Account).* AS Account} {(ExtDimension1).* AS ExtDimension1}
		{(ExtDimension2).* AS ExtDimension2} {(ExtDimension3).* AS ExtDimension3},,) AS RecordsWithExtDimensions

INDEX BY
	Period,
	Recorder,
	LineNumber
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RecordsWithExtDimensions.Period AS Period,
	RecordsWithExtDimensions.PointInTime AS PointInTime,
	RecordsWithExtDimensions.Recorder AS Recorder,
	RecordsWithExtDimensions.Organization AS Organization,
	RecordsWithExtDimensions.ChartOfAccounts AS ChartOfAccounts,
	RecordsWithExtDimensions.LineNumber AS LineNumber,
	RecordsWithExtDimensions.Account AS Account,
	RecordsWithExtDimensions.ExtDimension1 AS ExtDimension1,
	RecordsWithExtDimensions.ExtDimension2 AS ExtDimension2,
	RecordsWithExtDimensions.ExtDimension3 AS ExtDimension3,
	RecordsWithExtDimensions.Department AS Department,
	RecordsWithExtDimensions.LineOfBusiness AS LineOfBusiness,
	RecordsWithExtDimensions.Currency AS Currency,
	RecordsWithExtDimensions.Content AS Content,
	BalanceAndTurnovers.SumOpeningBalance AS SumOpeningBalance,
	BalanceAndTurnovers.SumTurnoverDr AS SumTurnoverDr,
	BalanceAndTurnovers.SumTurnoverCr AS SumTurnoverCr,
	BalanceAndTurnovers.SumClosingBalance AS SumClosingBalance,
	BalanceAndTurnovers.PresentationAmountOpeningBalance AS PresentationAmountOpeningBalance,
	BalanceAndTurnovers.PresentationAmountTurnoverDr AS PresentationAmountTurnoverDr,
	BalanceAndTurnovers.PresentationAmountTurnoverCr AS PresentationAmountTurnoverCr,
	BalanceAndTurnovers.PresentationAmountClosingBalance AS PresentationAmountClosingBalance,
	0 AS CurrencyAmountOpeningBalance,
	BalanceAndTurnovers.CurrencyAmountTurnoverDr AS CurrencyAmountTurnoverDr,
	BalanceAndTurnovers.CurrencyAmountTurnoverCr AS CurrencyAmountTurnoverCr,
	0 AS CurrencyAmountClosingBalance,
	BalanceAndTurnovers.CountOpeningBalance AS CountOpeningBalance,
	BalanceAndTurnovers.CountClosingBalance AS CountClosingBalance,
	BalanceAndTurnovers.CountTurnoverDr AS CountTurnoverDr,
	BalanceAndTurnovers.CountTurnoverCr AS CountTurnoverCr,
	BalanceAndTurnovers.SecondPeriod AS SecondPeriod,
	BalanceAndTurnovers.MinutePeriod AS MinutePeriod,
	BalanceAndTurnovers.DayPeriod AS DayPeriod,
	BalanceAndTurnovers.WeekPeriod AS WeekPeriod,
	BalanceAndTurnovers.TenDaysPeriod AS TenDaysPeriod,
	BalanceAndTurnovers.MonthPeriod AS MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod AS QuarterPeriod,
	BalanceAndTurnovers.YearPeriod AS YearPeriod
{SELECT
	Period AS Period,
	PointInTime AS PointInTime,
	Recorder.* AS Recorder,
	Organization.* AS Organization,
	ChartOfAccounts.* AS ChartOfAccounts,
	LineNumber AS LineNumber,
	Account.* AS Account,
	ExtDimension1.* AS ExtDimension1,
	ExtDimension2.* AS ExtDimension2,
	ExtDimension3.* AS ExtDimension3,
	Department.* AS Department,
	LineOfBusiness.* AS LineOfBusiness,
	Currency.* AS Currency,
	Content AS Content,
	SumOpeningBalance AS SumOpeningBalance,
	SumTurnoverDr AS SumTurnoverDr,
	SumTurnoverCr AS SumTurnoverCr,
	SumClosingBalance AS SumClosingBalance,
	PresentationAmountOpeningBalance AS PresentationAmountOpeningBalance,
	PresentationAmountTurnoverDr AS PresentationAmountTurnoverDr,
	PresentationAmountTurnoverCr AS PresentationAmountTurnoverCr,
	PresentationAmountClosingBalance AS PresentationAmountClosingBalance,
	CurrencyAmountOpeningBalance AS CurrencyAmountOpeningBalance,
	CurrencyAmountTurnoverDr AS CurrencyAmountTurnoverDr,
	CurrencyAmountTurnoverCr AS CurrencyAmountTurnoverCr,
	CurrencyAmountClosingBalance AS CurrencyAmountClosingBalance,
	CountOpeningBalance AS CountOpeningBalance,
	CountClosingBalance AS CountClosingBalance,
	CountTurnoverDr AS CountTurnoverDr,
	CountTurnoverCr AS CountTurnoverCr,
	SecondPeriod,
	MinutePeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	YearPeriod}
FROM
	BalanceAndTurnovers AS BalanceAndTurnovers
		INNER JOIN RecordsWithExtDimensions AS RecordsWithExtDimensions
		ON BalanceAndTurnovers.Recorder = RecordsWithExtDimensions.Recorder
		AND BalanceAndTurnovers.LineNumber = RecordsWithExtDimensions.LineNumber
{WHERE
	RecordsWithExtDimensions.Period AS Period,
	RecordsWithExtDimensions.PointInTime AS PointInTime,
	RecordsWithExtDimensions.Recorder.* AS Recorder,
	RecordsWithExtDimensions.Organization.* AS Organization,
	RecordsWithExtDimensions.ChartOfAccounts.* AS ChartOfAccounts,
	RecordsWithExtDimensions.LineNumber AS LineNumber,
	RecordsWithExtDimensions.Account.* AS Account,
	RecordsWithExtDimensions.ExtDimension1.* AS ExtDimension1,
	RecordsWithExtDimensions.ExtDimension2.* AS ExtDimension2,
	RecordsWithExtDimensions.ExtDimension3.* AS ExtDimension3,
	RecordsWithExtDimensions.Department.* AS Department,
	RecordsWithExtDimensions.LineOfBusiness.* AS LineOfBusiness,
	RecordsWithExtDimensions.Currency.* AS Currency,
	RecordsWithExtDimensions.Content AS Content,
	BalanceAndTurnovers.SumOpeningBalance AS SumOpeningBalance,
	BalanceAndTurnovers.SumTurnoverDr AS SumTurnoverDr,
	BalanceAndTurnovers.SumTurnoverCr AS SumTurnoverCr,
	BalanceAndTurnovers.SumClosingBalance AS SumClosingBalance,
	BalanceAndTurnovers.PresentationAmountOpeningBalance AS PresentationAmountOpeningBalance,
	BalanceAndTurnovers.PresentationAmountTurnoverDr AS PresentationAmountTurnoverDr,
	BalanceAndTurnovers.PresentationAmountTurnoverCr AS PresentationAmountTurnoverCr,
	BalanceAndTurnovers.PresentationAmountClosingBalance AS PresentationAmountClosingBalance,
	0 AS CurrencyAmountOpeningBalance,
	BalanceAndTurnovers.CurrencyAmountTurnoverDr AS CurrencyAmountTurnoverDr,
	BalanceAndTurnovers.CurrencyAmountTurnoverCr AS CurrencyAmountTurnoverCr,
	0 AS CurrencyAmountClosingBalance,
	BalanceAndTurnovers.CountOpeningBalance AS CountOpeningBalance,
	BalanceAndTurnovers.CountClosingBalance AS CountClosingBalance,
	BalanceAndTurnovers.CountTurnoverDr AS CountTurnoverDr,
	BalanceAndTurnovers.CountTurnoverCr AS CountTurnoverCr,
	BalanceAndTurnovers.SecondPeriod,
	BalanceAndTurnovers.MinutePeriod,
	BalanceAndTurnovers.DayPeriod,
	BalanceAndTurnovers.WeekPeriod,
	BalanceAndTurnovers.TenDaysPeriod,
	BalanceAndTurnovers.MonthPeriod,
	BalanceAndTurnovers.QuarterPeriod,
	BalanceAndTurnovers.YearPeriod}</query>
			<autoFillFields>false</autoFillFields>
			<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
		</item>
