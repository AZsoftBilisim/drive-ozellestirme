				<field>WeekPeriod</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>TenDaysPeriod</dataPath>
				<field>TenDaysPeriod</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>MonthPeriod</dataPath>
				<field>MonthPeriod</field>
