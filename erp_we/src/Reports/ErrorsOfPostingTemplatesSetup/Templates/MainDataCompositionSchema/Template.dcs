					<v8:content>Nazwa szablonu</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наименование шаблона</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Şablon açıklaması</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Tên gọi khuôn mẫu</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PostingTemplates.Ref AS PostingTemplate,
	PostingTemplates.Description AS TemplateDescription,
	PostingTemplates.CrAccountDefault AS DefaultCrCount,
	PostingTemplates.DrAccountDefault AS DefaultDrCount,
	CASE
		WHEN PostingTemplates.AccountSpecificationSourceTypeDr = &amp;TypeOfDSDT
			THEN &amp;CashType_
		WHEN PostingTemplates.AccountSpecificationSourceTypeDr = &amp;TypeNomDr
			THEN &amp;TypeNom
		WHEN PostingTemplates.AccountSpecificationSourceTypeDr = &amp;DRCalculationType
			THEN &amp;TypeCalculations
		WHEN PostingTemplates.AccountSpecificationSourceTypeDr = &amp;IEDrType
			THEN &amp;IEType
		WHEN PostingTemplates.AccountSpecificationSourceTypeDr = &amp;FADrType
			THEN &amp;FAType
		ELSE
			PostingTemplates.AccountSpecificationSourceTypeDr
	END AS AccountSpecificationSourceDr,
	CASE
		WHEN PostingTemplates.AccountSpecificationSourceTypeCr = &amp;TypeOfDSCT
			THEN &amp;CashType_
		WHEN PostingTemplates.AccountSpecificationSourceTypeCr = &amp;TypeNomCT
			THEN &amp;TypeNom
		WHEN PostingTemplates.AccountSpecificationSourceTypeCr = &amp;CRCalculationType
			THEN &amp;TypeCalculations
		WHEN PostingTemplates.AccountSpecificationSourceTypeCr = &amp;IECrType
			THEN &amp;IEType
		WHEN PostingTemplates.AccountSpecificationSourceTypeCr = &amp;FACrType
			THEN &amp;FAType
		ELSE
			PostingTemplates.AccountSpecificationSourceTypeCr
	END AS AccountSpecificationSourceCr,
	PostingTemplates.BookAmountSource AS BookAmountSource,
	PostingTemplates.Operation AS BusinessOperation
INTO PostingTemplates
FROM
	Catalog.PostingTemplatesForFinancialAccounting AS PostingTemplates
	INNER JOIN 
		InformationRegister.RulesOfPostingsInFinancialAccounting AS ReflectionRules
	ON 
		ReflectionRules.PostingGenerationSetting = &amp;PostingGenerationSetting
		AND PostingTemplates.Ref = ReflectionRules.PostingTemplate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	PostingTemplates.DefaultDrCount AS DefaultAccount,
	ISNULL(PostingTemplates.AccountSpecificationSourceDr,
			 VALUE(Enum.AccountSpecificationSourceTypes.EmptyRef)) AS AccountSpecificationSource,
	VALUE(Enum.AccountingMovementKinds.Debit) AS RecordType,
	PostingTemplates.PostingTemplate AS PostingTemplate,
	PostingTemplates.TemplateDescription AS TemplateDescription,
	PostingTemplates.BookAmountSource AS BookAmountSource,
	PostingTemplates.BusinessOperation AS BusinessOperation,
	1 AS NumberOfTransactions_Dr,
	0 AS NumberOfTransactions_Cr
FROM
	PostingTemplates AS PostingTemplates

UNION ALL

SELECT
	PostingTemplates.DefaultCrCount AS DefaultAccount,
	ISNULL(PostingTemplates.AccountSpecificationSourceCr,
			 VALUE(Enum.AccountSpecificationSourceTypes.EmptyRef)) AS AccountSpecificationSource,
	VALUE(Enum.AccountingMovementKinds.Credit) AS RecordType,
	PostingTemplates.PostingTemplate AS PostingTemplate,
	PostingTemplates.TemplateDescription AS TemplateDescription,
	PostingTemplates.BookAmountSource AS BookAmountSource,
	PostingTemplates.BusinessOperation AS BusinessOperation,
	0,
	1
FROM
	PostingTemplates AS PostingTemplates
</query>
	</dataSet>
