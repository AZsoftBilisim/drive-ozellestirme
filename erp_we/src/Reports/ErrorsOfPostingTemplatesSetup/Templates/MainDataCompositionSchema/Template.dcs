		</title>
	</calculatedField>
	<totalField>
		<dataPath>HasErrors</dataPath>
		<expression>Case
	When Sum(NumberOfTransactions_Dr) &lt;&gt; Sum(NumberOfTransactions_Cr)
			   And (Sum(NumberOfTransactions_Dr) = 0 Or Sum(NumberOfTransactions_Cr) = 0)
	Then True
End</expression>
