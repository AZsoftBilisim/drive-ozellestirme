		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
// 1. EXCHANGE RATES //////////////////////////////////////////////////////////////

SELECT ALLOWED
	CurrencyRatesCut.Currency    AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO CurrencyRatesCut
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
INDEX BY
	Currency
;

//////////////////////////////////////////////////////////////////////////////////////
// 2. PARTNER SEGMENTS //////////////////////////////////////////////////////////////

SELECT ALLOWED
	SegmentPartners.Segment AS Segment
INTO SegmentPartners
FROM
	InformationRegister.SegmentPartners AS SegmentPartners
{WHERE
	SegmentPartners.Partner = &amp;Partner}
;

////////////////////////////////////////////////////////////////////////////////
// 3. AGREEMENT HEADER /////////////////////////////////////////////////////////

SELECT ALLOWED
	AgreementWithCustomerHeader.Ref                 AS Terms,
	AgreementWithCustomerHeader.PricesKind                 AS PricesKind,
	AgreementWithCustomerHeader.Currency                 AS Currency
INTO
	AgreementWithCustomerHeader
FROM
	Catalog.TermsOfSale AS AgreementWithCustomerHeader
{WHERE AgreementWithCustomerHeader.Ref IN (&amp;Document)}
{WHERE AgreementWithCustomerHeader.Standard_ = &amp;OnlyStandard
	AND NOT AgreementWithCustomerHeader.DeletionMark
	AND AgreementWithCustomerHeader.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)}
{WHERE (AgreementWithCustomerHeader.Partner = &amp;Partner OR
	AgreementWithCustomerHeader.PartnersSegment IN 
	(SELECT
		SegmentPartners.Segment AS PartnersSegment
	FROM
		SegmentPartners AS SegmentPartners))
	AND NOT AgreementWithCustomerHeader.DeletionMark
	AND AgreementWithCustomerHeader.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)}
INDEX BY
	Terms,
	PricesKind
;

////////////////////////////////////////////////////////////////////////////////
// 4. PRICE GROUPS OF THE AGREEMENT ////////////////////////////////////////////////

SELECT ALLOWED
	CustomerAgreementPriceGroups.Ref        AS Terms,
	CustomerAgreementPriceGroups.PricesKind        AS PricesKind,
	CustomerAgreementPriceGroups.PriceGroup AS PriceGroup
INTO
	CustomerAgreementPriceGroups
FROM
	Catalog.TermsOfSale.PriceGroups AS CustomerAgreementPriceGroups
{WHERE CustomerAgreementPriceGroups.Ref IN (&amp;Document)}
{WHERE CustomerAgreementPriceGroups.Ref.Standard_ = &amp;OnlyStandard
	AND NOT CustomerAgreementPriceGroups.Ref.DeletionMark
	AND CustomerAgreementPriceGroups.Ref.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)}
{WHERE (CustomerAgreementPriceGroups.Ref.Partner = &amp;Partner OR
	CustomerAgreementPriceGroups.Ref.PartnersSegment IN 
	(SELECT
		SegmentPartners.Segment AS PartnersSegment
	FROM
		SegmentPartners AS SegmentPartners))
	AND NOT CustomerAgreementPriceGroups.Ref.DeletionMark
	AND CustomerAgreementPriceGroups.Ref.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)}
INDEX BY
	Terms,
	PriceGroup,
	PricesKind
;

////////////////////////////////////////////////////////////////////////////////
// 5. GOODS OF THE AGREEMENT ////////////////////////////////////////////////////////

SELECT ALLOWED
	AgreementWithCustomerGoods.Ref         AS Terms,
	AgreementWithCustomerGoods.PriceKind        AS PriceKind,
	AgreementWithCustomerGoods.Products   AS Products,
	AgreementWithCustomerGoods.Characteristic AS Characteristic,
	AgreementWithCustomerGoods.Package       AS Package,
	AgreementWithCustomerGoods.Price           AS Price
INTO
	AgreementWithCustomerGoods
FROM
	Catalog.TermsOfSale.Goods AS AgreementWithCustomerGoods
{WHERE AgreementWithCustomerGoods.Ref IN (&amp;Document)}
{WHERE AgreementWithCustomerGoods.Ref.Standard_ = &amp;OnlyStandard
	AND NOT AgreementWithCustomerGoods.Ref.DeletionMark
	AND AgreementWithCustomerGoods.Ref.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)}
{WHERE (AgreementWithCustomerGoods.Ref.Partner = &amp;Partner OR
	AgreementWithCustomerGoods.Ref.PartnersSegment IN 
	(SELECT
		SegmentPartners.Segment AS PartnersSegment
	FROM
		SegmentPartners AS SegmentPartners))
	AND NOT AgreementWithCustomerGoods.Ref.DeletionMark
	AND AgreementWithCustomerGoods.Ref.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
}
{WHERE (Products, Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = (&amp;FilterByProductSegmentIsUsed))
}

INDEX BY
	Terms,
	Products,
	Characteristic,
	PriceKind
;

////////////////////////////////////////////////////////////////////////////////
// 6. PRICES OF THE PRICE LIST AND GOODS AGREEMENTS ////////////////////////////////////

SELECT ALLOWED
	AgreementWithCustomerHeader.Terms          AS Terms,
	ItemPricesCrossSectionOfTheLatest.Products   AS Products,
	ItemPricesCrossSectionOfTheLatest.Characteristic AS Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind        AS PriceKind,
	NULL                                         AS TypeOfAgreementPrice,
	ItemPricesCrossSectionOfTheLatest.Currency         AS Currency,
	NULL                                         AS AgreementCurrency,
	ItemPricesCrossSectionOfTheLatest.Price           AS Price,
	NULL                                         AS FixedPrice,
	ItemPricesCrossSectionOfTheLatest.Package       AS Package
INTO ItemsPrices
FROM
	AgreementWithCustomerHeader,
	InformationRegister.ItemsPrices.SliceLast({ENDOFPERIOD(&amp;Period, DAY)
	{(Products, Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
	},
	PriceKind IN (
	SELECT DISTINCT
		AgreementWithCustomerHeader.PricesKind
	FROM
		AgreementWithCustomerHeader AS AgreementWithCustomerHeader
	UNION
	SELECT DISTINCT
		CustomerAgreementPriceGroups.PricesKind
	FROM
		CustomerAgreementPriceGroups AS CustomerAgreementPriceGroups
	UNION
	SELECT DISTINCT
		AgreementWithCustomerGoods.PriceKind
	FROM
		AgreementWithCustomerGoods AS AgreementWithCustomerGoods
	)) AS ItemPricesCrossSectionOfTheLatest

UNION

SELECT
	AgreementWithCustomerGoods.Terms        AS Terms,
	AgreementWithCustomerGoods.Products      AS Products,
	AgreementWithCustomerGoods.Characteristic    AS Characteristic,
	NULL                                        AS PriceKind,
	AgreementWithCustomerGoods.PriceKind           AS TypeOfAgreementPrice,
	NULL                                        AS Currency,
	AgreementWithCustomerGoods.Terms.Currency AS AgreementCurrency,
	NULL                                        AS Price,
	AgreementWithCustomerGoods.Price              AS FixedPrice,
	AgreementWithCustomerGoods.Package          AS Package
FROM
	AgreementWithCustomerGoods AS AgreementWithCustomerGoods
INDEX BY
	Terms,
	Products,
	Characteristic,
	PriceKind
;

////////////////////////////////////////////////////////////////////////////////
// 7. TOTAL PRICES OF THE ITEM WITHOUT DUPLICATE ENTRIES /////////////////////

SELECT ALLOWED
	ItemsPrices.Terms.Currency                      AS AgreementCurrency,
	ItemsPrices.Terms                             AS Terms,
	ItemsPrices.Products                           AS Products,
	ItemsPrices.Characteristic                         AS Characteristic,
	MIN (CASE
		WHEN
			AgreementWithCustomerGoods.PriceKind IS NOT NULL 
		THEN
			AgreementWithCustomerGoods.PriceKind
		WHEN
			CustomerAgreementPriceGroups.PriceGroup IS NOT NULL
		THEN
			CustomerAgreementPriceGroups.PricesKind
		WHEN
			AgreementWithCustomerHeader.PricesKind &lt;&gt; VALUE(Catalog.TypesOfPrices.EmptyRef)
		THEN
			AgreementWithCustomerHeader.PricesKind
		ELSE
			VALUE(Catalog.TypesOfPrices.EmptyRef)
	END)                                       AS TypeOfPriceGoodsAgreements,
	MIN (ItemsPrices.PriceKind)           AS PriceKind,
	MIN (ItemsPrices.TypeOfAgreementPrice) AS TypeOfAgreementPrice,
	MIN (ItemsPrices.Currency)            AS Currency,
	MIN (ItemsPrices.Price)              AS Price,
	MIN (ItemsPrices.FixedPrice) AS FixedPrice,
	MIN (ItemsPrices.Package)          AS Package
INTO
	FinalPrices
FROM
	ItemsPrices AS ItemsPrices

LEFT JOIN
	InformationRegister.SegmentProducts AS SegmentProducts
ON
	SegmentProducts.Products = ItemsPrices.Products
	AND SegmentProducts.Characteristic = ItemsPrices.Characteristic
	AND SegmentProducts.Segment = ItemsPrices.Terms.ProductSegment

LEFT JOIN
	AgreementWithCustomerHeader AS AgreementWithCustomerHeader
ON
	ItemsPrices.Terms = AgreementWithCustomerHeader.Terms

LEFT JOIN
	CustomerAgreementPriceGroups AS CustomerAgreementPriceGroups
ON
	ItemsPrices.Terms = CustomerAgreementPriceGroups.Terms
	AND ItemsPrices.Products.PriceGroup = CustomerAgreementPriceGroups.PriceGroup

LEFT JOIN
	AgreementWithCustomerGoods AS AgreementWithCustomerGoods
ON
	ItemsPrices.Terms = AgreementWithCustomerGoods.Terms
	AND ItemsPrices.Products = AgreementWithCustomerGoods.Products
	AND ItemsPrices.Characteristic = AgreementWithCustomerGoods.Characteristic
	
WHERE
	(ItemsPrices.Terms.ProductSegment = VALUE(Catalog.ProductSegments.EmptyRef)
	OR SegmentProducts.Products IS NOT NULL)
	AND (ItemsPrices.FixedPrice &gt; 0 
	OR ItemsPrices.TypeOfAgreementPrice = AgreementWithCustomerGoods.PriceKind
	OR ItemsPrices.PriceKind =
		CASE
			WHEN
				AgreementWithCustomerGoods.PriceKind IS NOT NULL 
			THEN
				AgreementWithCustomerGoods.PriceKind
			WHEN
				CustomerAgreementPriceGroups.PriceGroup IS NOT NULL
			THEN
				CustomerAgreementPriceGroups.PricesKind
			WHEN
				AgreementWithCustomerHeader.PricesKind &lt;&gt; VALUE(Catalog.TypesOfPrices.EmptyRef)
			THEN
				AgreementWithCustomerHeader.PricesKind
			ELSE
				VALUE(Catalog.TypesOfPrices.EmptyRef)
		END)
	{WHERE (ItemsPrices.Products, ItemsPrices.Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)
	}
	GROUP BY
	ItemsPrices.Terms,
	ItemsPrices.Products,
	ItemsPrices.Characteristic
;

////////////////////////////////////////////////////////////////////////////////
// 8. TOTAL PRICES OF THE ITEM IN THE CURRENCY OF THE AGREEMENT  //////////////////////////

SELECT ALLOWED
	FinalPrices.Terms                  AS Terms,
	FinalPrices.Products                AS Products,
	FinalPrices.Characteristic              AS Characteristic,
	FinalPrices.TypeOfPriceGoodsAgreements     AS PriceKind,
	CASE
		WHEN
			FinalPrices.FixedPrice &gt; 0
		THEN
			FinalPrices.FixedPrice
		WHEN
			FinalPrices.Currency = FinalPrices.AgreementCurrency
		THEN
			FinalPrices.Price
		ELSE
			CAST(ISNULL(FinalPrices.Price,0)
				* CASE
					WHEN ISNULL(CrossSectionExchangeRates.CourseDenominator, 0) &gt; 0
						AND ISNULL(CrossSectionExchangeRates.CourseNumerator, 0) &gt; 0
						AND ISNULL(ExchangeRatesOfSlicePriceType.CourseDenominator, 0) &gt; 0
						AND ISNULL(ExchangeRatesOfSlicePriceType.CourseNumerator, 0) &gt; 0
					THEN 
						(ExchangeRatesOfSlicePriceType.CourseNumerator * CrossSectionExchangeRates.CourseDenominator)
						/ (CrossSectionExchangeRates.CourseNumerator * ExchangeRatesOfSlicePriceType.CourseDenominator)
					ELSE
						0
				END AS NUMBER(31,2))
			END AS Price,
	FinalPrices.Package AS Package,
	CASE
		WHEN
			FinalPrices.FixedPrice &gt; 0
		THEN
			TRUE
		ELSE
			FALSE
	END AS ItSFixedPrice
FROM
	FinalPrices AS FinalPrices

LEFT JOIN
	CurrencyRatesCut AS ExchangeRatesOfSlicePriceType
ON
	ExchangeRatesOfSlicePriceType.Currency = FinalPrices.Currency

LEFT JOIN
	CurrencyRatesCut AS CrossSectionExchangeRates
ON
	CrossSectionExchangeRates.Currency = FinalPrices.AgreementCurrency
	{WHERE (Products, Characteristic) IN
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)
	}</query>
	</dataSet>
