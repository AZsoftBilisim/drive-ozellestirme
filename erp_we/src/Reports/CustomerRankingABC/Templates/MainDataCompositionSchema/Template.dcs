		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ABCXYZClassification.Period AS Period,
	ABCXYZClassification.Partner AS Partner,
	1 AS PartnerQuantity,
	ABCXYZClassification.ClassificationParameterType AS ClassificationParameterType,
	ABCXYZClassification.ClassificationParameterValue AS ClassificationParameterValue,
	ABCXYZClassification.Class AS Class,
	ABCXYZCustomerClassificationSliceLast.Class AS CurrentClass,
	ABCXYZCustomerClassificationSliceLast.ClassificationParameterValue AS CurrentValueOfClassificationParameter
{SELECT
	Period,
	Partner.*,
	PartnerQuantity,
	ClassificationParameterType,
	ClassificationParameterValue,
	Class,
	CurrentClass,
	CurrentValueOfClassificationParameter}
FROM
	InformationRegister.ABCXYZCustomerClassification AS ABCXYZClassification
		LEFT JOIN InformationRegister.ABCXYZCustomerClassification.SliceLast AS ABCXYZCustomerClassificationSliceLast
		ON ABCXYZClassification.Partner = ABCXYZCustomerClassificationSliceLast.Partner
			AND ABCXYZClassification.ClassificationParameterType = ABCXYZCustomerClassificationSliceLast.ClassificationParameterType
			AND ABCXYZClassification.ClassificationType = ABCXYZCustomerClassificationSliceLast.ClassificationType
WHERE
	ABCXYZClassification.ClassificationType = VALUE(Enum.TypesOfClassification.ABC)
	AND ABCXYZClassification.Class &lt;&gt; VALUE(Enum.ABCClassification.NotClassified)
	AND ABCXYZClassification.ClassificationParameterType IN
			(SELECT
				VALUE(Enum.TypesOfClassificationParameters.GrossProfit) AS ClassificationParameter
			FROM
				Constants AS Constants
			WHERE
				Constants.UseABCXYZClassificationOfPartnersByGrossProfit = TRUE
		
			UNION ALL
		
			SELECT
				VALUE(Enum.TypesOfClassificationParameters.Revenue)
			FROM
				Constants AS Constants
			WHERE
				Constants.UseABCXYZClassificationOfPartnersByRevenue = TRUE
		
			UNION ALL
		
			SELECT
				VALUE(Enum.TypesOfClassificationParameters.Count)
			FROM
				Constants AS Constants
			WHERE
				Constants.UseABCXYZClassificationOfPartnersByNumberOfSales = TRUE)
{WHERE
	(ABCXYZClassification.Period &gt;= &amp;BeginOfPeriod),
	(ABCXYZClassification.Period &lt;= &amp;PeriodEnding),
	ABCXYZClassification.ClassificationParameterType,
	ABCXYZClassification.Period,
	(ABCXYZClassification.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	ABCXYZClassification.Class.*,
	ABCXYZCustomerClassificationSliceLast.Class.* AS CurrentClass}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<totalField>
		<dataPath>ClassificationParameterValue</dataPath>
		<expression>Sum(ClassificationParameterValue)</expression>
	</totalField>
	<totalField>
		<dataPath>PartnerQuantity</dataPath>
		<expression>Sum(PartnerQuantity)</expression>
	</totalField>
