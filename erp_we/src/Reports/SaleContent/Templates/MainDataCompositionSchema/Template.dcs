		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	&amp;LineInCommercialOffers AS DocumentType_1,
	&amp;Ref                          AS Ref,
	&amp;Products                    AS Products,
	&amp;Characteristic                  AS Characteristic,
	&amp;Count                      AS Count
FROM
	Catalog.SalesOpportunitiesToCustomer AS CatalogSalesOpportunityOverridable
WHERE
	&amp;ConditionOfEvent
{WHERE
	CatalogSalesOpportunityOverridable.Ref.*}



</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<parameter>
