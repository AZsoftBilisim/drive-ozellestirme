		<dataSource>DataSource1</dataSource>
		<query>SELECT
	BudgetingScenarios.Scenario AS Scenario,
	&amp;TextOfTurnoverFactPeriodSecondField_ AS UpdateDate,
	TurnoverFact.DayPeriod AS DayPeriod,
	TurnoverFact.WeekPeriod AS WeekPeriod,
	TurnoverFact.TenDaysPeriod AS TenDaysPeriod,
	TurnoverFact.MonthPeriod AS MonthPeriod,
	TurnoverFact.QuarterPeriod AS QuarterPeriod,
	TurnoverFact.HalfYearPeriod AS HalfYearPeriod,
	TurnoverFact.YearPeriod AS YearPeriod,
	TurnoverFact.BudgetBalanceItem AS BudgetBalanceItem,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
			THEN TurnoverFact.Dimension1
		ELSE UNDEFINED
	END AS Dimension1,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
			THEN TurnoverFact.Dimension2
		ELSE UNDEFINED
	END AS Dimension2,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
			THEN TurnoverFact.Dimension3
		ELSE UNDEFINED
	END AS Dimension3,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
			THEN TurnoverFact.Dimension4
		ELSE UNDEFINED
	END AS Dimension4,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
			THEN TurnoverFact.Dimension5
		ELSE UNDEFINED
	END AS Dimension5,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
			THEN TurnoverFact.Dimension6
		ELSE UNDEFINED
	END AS Dimension6,
	TurnoverFact.Organization AS Organization,
	TurnoverFact.Department AS Department,
	TurnoverFact.Currency AS Currency,
	0 AS QuantityScenarioReceipt,
	0 AS AmountScenarioReceipt,
	0 AS QuantityScenarioExpense,
	0 AS AmountScenarioExpense,
	TurnoverFact.CountReceipt AS QuantityReceiptFact,
	TurnoverFact.SumReceipt AS AmountReceiptActual,
	TurnoverFact.CountExpense AS QuantityExpenseFact,
	TurnoverFact.SumExpense AS AmountExpenseFact,
	0 AS QuantityScenarioStartBalance,
	0 AS AmountScenarioStartBalance,
	0 AS QuantityStartBalanceFact,
	0 AS AmountStartBalanceFact
{SELECT
	Scenario.*,
	UpdateDate,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BudgetBalanceItem.*,
	Dimension1.*,
	Dimension2.*,
	Dimension3.*,
	Dimension4.*,
	Dimension5.*,
	Dimension6.*,
	Organization.*,
	Department.*,
	Currency.*,
	QuantityScenarioReceipt,
	AmountScenarioReceipt,
	QuantityScenarioExpense,
	AmountScenarioExpense,
	QuantityReceiptFact,
	AmountReceiptActual,
	QuantityExpenseFact,
	AmountExpenseFact,
	QuantityScenarioStartBalance,
	AmountScenarioStartBalance,
	QuantityStartBalanceFact,
	AmountStartBalanceFact}
FROM
	TurnoverFactByInfluencingBudgetItems AS TurnoverFact
		LEFT JOIN BudgetingScenarios AS BudgetingScenarios
		ON (TRUE)
WHERE
	TurnoverFact.Scenario = VALUE(Catalog.BudgetingScenarios.ActualData)
{WHERE
	BudgetingScenarios.Scenario.* AS Scenario,
	&amp;TextOfTurnoverFactPeriodSecondField_ AS UpdateDate,
	TurnoverFact.DayPeriod AS DayPeriod,
	TurnoverFact.WeekPeriod AS WeekPeriod,
	TurnoverFact.TenDaysPeriod AS TenDaysPeriod,
	TurnoverFact.MonthPeriod AS MonthPeriod,
	TurnoverFact.QuarterPeriod AS QuarterPeriod,
	TurnoverFact.HalfYearPeriod AS HalfYearPeriod,
	TurnoverFact.YearPeriod AS YearPeriod,
	TurnoverFact.BudgetBalanceItem.*,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
				THEN TurnoverFact.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
				THEN TurnoverFact.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
				THEN TurnoverFact.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
				THEN TurnoverFact.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
				THEN TurnoverFact.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
				THEN TurnoverFact.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	TurnoverFact.Organization.*,
	TurnoverFact.Department.*,
	TurnoverFact.Currency.*}

UNION ALL

SELECT
	TurnoverFact.Scenario,
	&amp;TextOfTurnoverFactPeriodSecondField_,
	TurnoverFact.DayPeriod,
	TurnoverFact.WeekPeriod,
	TurnoverFact.TenDaysPeriod,
	TurnoverFact.MonthPeriod,
	TurnoverFact.QuarterPeriod,
	TurnoverFact.HalfYearPeriod,
	TurnoverFact.YearPeriod,
	TurnoverFact.BudgetBalanceItem,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
			THEN TurnoverFact.Dimension1
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
			THEN TurnoverFact.Dimension2
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
			THEN TurnoverFact.Dimension3
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
			THEN TurnoverFact.Dimension4
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
			THEN TurnoverFact.Dimension5
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
			THEN TurnoverFact.Dimension6
		ELSE UNDEFINED
	END,
	TurnoverFact.Organization,
	TurnoverFact.Department,
	TurnoverFact.Currency,
	TurnoverFact.CountReceipt,
	TurnoverFact.SumReceipt,
	TurnoverFact.CountExpense,
	TurnoverFact.SumExpense,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0
FROM
	TurnoverFactByInfluencingBudgetItems AS TurnoverFact
WHERE
	TurnoverFact.Scenario = VALUE(Catalog.BudgetingScenarios.BudgetFulfillment)
{WHERE
	TurnoverFact.Scenario.* AS Scenario,
	&amp;TextOfTurnoverFactPeriodSecondField_ AS UpdateDate,
	TurnoverFact.DayPeriod,
	TurnoverFact.WeekPeriod,
	TurnoverFact.TenDaysPeriod,
	TurnoverFact.MonthPeriod,
	TurnoverFact.QuarterPeriod,
	TurnoverFact.HalfYearPeriod,
	TurnoverFact.YearPeriod,
	TurnoverFact.BudgetBalanceItem.*,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
				THEN TurnoverFact.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
				THEN TurnoverFact.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
				THEN TurnoverFact.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
				THEN TurnoverFact.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
				THEN TurnoverFact.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN TurnoverFact.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
				THEN TurnoverFact.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	TurnoverFact.Organization.*,
	TurnoverFact.Department.*,
	TurnoverFact.Currency.*}

UNION ALL

SELECT
	TurnoversPlan.Scenario,
	&amp;TextOfTurnoverFieldPlanPeriodSecond_,
	TurnoversPlan.DayPeriod,
	TurnoversPlan.WeekPeriod,
	TurnoversPlan.TenDaysPeriod,
	TurnoversPlan.MonthPeriod,
	TurnoversPlan.QuarterPeriod,
	TurnoversPlan.HalfYearPeriod,
	TurnoversPlan.YearPeriod,
	TurnoversPlan.BudgetBalanceItem,
	CASE
		WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
			THEN TurnoversPlan.Dimension1
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
			THEN TurnoversPlan.Dimension2
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
			THEN TurnoversPlan.Dimension3
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
			THEN TurnoversPlan.Dimension4
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
			THEN TurnoversPlan.Dimension5
		ELSE UNDEFINED
	END,
	CASE
		WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
			THEN TurnoversPlan.Dimension6
		ELSE UNDEFINED
	END,
	TurnoversPlan.Organization,
	TurnoversPlan.Department,
	TurnoversPlan.Currency,
	TurnoversPlan.NumberOfParishPlan,
	TurnoversPlan.TotalParishPlan,
	TurnoversPlan.NumberOfConsumable_,
	TurnoversPlan.AmountExpensePlan,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0
FROM
	TurnoversPlan AS TurnoversPlan
{WHERE
	TurnoversPlan.Scenario.*,
	&amp;TextOfTurnoverFieldPlanPeriodSecond_ AS UpdateDate,
	TurnoversPlan.DayPeriod,
	TurnoversPlan.WeekPeriod,
	TurnoversPlan.TenDaysPeriod,
	TurnoversPlan.MonthPeriod,
	TurnoversPlan.QuarterPeriod,
	TurnoversPlan.HalfYearPeriod,
	TurnoversPlan.YearPeriod,
	TurnoversPlan.BudgetBalanceItem.*,
	TurnoversPlan.BudgetFlowItem.*,
	(CASE
			WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
				THEN TurnoversPlan.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
				THEN TurnoversPlan.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
				THEN TurnoversPlan.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
				THEN TurnoversPlan.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
				THEN TurnoversPlan.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN TurnoversPlan.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
				THEN TurnoversPlan.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	TurnoversPlan.Organization.*,
	TurnoversPlan.Department.*,
	TurnoversPlan.Currency.*}

UNION ALL

SELECT
	BudgetingScenarios.Scenario,
	&amp;TextOfFactFieldByBudgetIndicatorsPeriodSecond_,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	FactOnBudgetIndicators.BudgetBalanceItem,
	CASE
		WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
			THEN FactOnBudgetIndicators.Dimension1
		ELSE UNDEFINED
	END,
	CASE
		WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
			THEN FactOnBudgetIndicators.Dimension2
		ELSE UNDEFINED
	END,
	CASE
		WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
			THEN FactOnBudgetIndicators.Dimension3
		ELSE UNDEFINED
	END,
	CASE
		WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
			THEN FactOnBudgetIndicators.Dimension4
		ELSE UNDEFINED
	END,
	CASE
		WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
			THEN FactOnBudgetIndicators.Dimension5
		ELSE UNDEFINED
	END,
	CASE
		WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
			THEN FactOnBudgetIndicators.Dimension6
		ELSE UNDEFINED
	END,
	FactOnBudgetIndicators.Organization,
	FactOnBudgetIndicators.Department,
	FactOnBudgetIndicators.Currency,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	CASE
		WHEN CurrentBalanceDatesByScenario.Scenario IS NULL
			THEN FactOnBudgetIndicators.Count
		ELSE 0
	END,
	CASE
		WHEN CurrentBalanceDatesByScenario.Scenario IS NULL
			THEN FactOnBudgetIndicators.Sum
		ELSE 0
	END,
	FactOnBudgetIndicators.Count,
	FactOnBudgetIndicators.Sum
FROM
	FactOnBudgetIndicators AS FactOnBudgetIndicators
		LEFT JOIN BudgetingScenarios AS BudgetingScenarios
		ON (TRUE)
		LEFT JOIN CurrentBalanceDatesByScenario AS CurrentBalanceDatesByScenario
		ON FactOnBudgetIndicators.BudgetBalanceItem = CurrentBalanceDatesByScenario.BudgetBalanceItem
			AND (BudgetingScenarios.Scenario = CurrentBalanceDatesByScenario.Scenario)
{WHERE
	BudgetingScenarios.Scenario.*,
	&amp;TextOfFactFieldByBudgetIndicatorsPeriodSecond_ AS UpdateDate,
	FactOnBudgetIndicators.BudgetBalanceItem.*,
	(CASE
			WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
				THEN FactOnBudgetIndicators.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
				THEN FactOnBudgetIndicators.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
				THEN FactOnBudgetIndicators.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
				THEN FactOnBudgetIndicators.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
				THEN FactOnBudgetIndicators.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN FactOnBudgetIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
				THEN FactOnBudgetIndicators.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	FactOnBudgetIndicators.Organization.*,
	FactOnBudgetIndicators.Department.*,
	FactOnBudgetIndicators.Currency.*}

UNION ALL

SELECT
	BalancesAccordingToCalculatedIndicators.Scenario,
	&amp;TextOfBalanceFieldByCalculatedIndicatorsDateOfBalance_,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	BalancesAccordingToCalculatedIndicators.BudgetBalanceItem,
	CASE
		WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
			THEN BalancesAccordingToCalculatedIndicators.Dimension1
		ELSE UNDEFINED
	END,
	CASE
		WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
			THEN BalancesAccordingToCalculatedIndicators.Dimension2
		ELSE UNDEFINED
	END,
	CASE
		WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
			THEN BalancesAccordingToCalculatedIndicators.Dimension3
		ELSE UNDEFINED
	END,
	CASE
		WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
			THEN BalancesAccordingToCalculatedIndicators.Dimension4
		ELSE UNDEFINED
	END,
	CASE
		WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
			THEN BalancesAccordingToCalculatedIndicators.Dimension5
		ELSE UNDEFINED
	END,
	CASE
		WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
			THEN BalancesAccordingToCalculatedIndicators.Dimension6
		ELSE UNDEFINED
	END,
	BalancesAccordingToCalculatedIndicators.Organization,
	BalancesAccordingToCalculatedIndicators.Department,
	BalancesAccordingToCalculatedIndicators.Currency,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	BalancesAccordingToCalculatedIndicators.Count,
	BalancesAccordingToCalculatedIndicators.Sum,
	0,
	0
FROM
	BalancesAccordingToCalculatedIndicators AS BalancesAccordingToCalculatedIndicators
{WHERE
	BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.*,
	&amp;TextOfBalanceFieldByCalculatedIndicatorsDateOfBalance_ AS UpdateDate,
	(CASE
			WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 1
				THEN BalancesAccordingToCalculatedIndicators.Dimension1
			ELSE UNDEFINED
		END) AS Dimension1,
	(CASE
			WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 2
				THEN BalancesAccordingToCalculatedIndicators.Dimension2
			ELSE UNDEFINED
		END) AS Dimension2,
	(CASE
			WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 3
				THEN BalancesAccordingToCalculatedIndicators.Dimension3
			ELSE UNDEFINED
		END) AS Dimension3,
	(CASE
			WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 4
				THEN BalancesAccordingToCalculatedIndicators.Dimension4
			ELSE UNDEFINED
		END) AS Dimension4,
	(CASE
			WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 5
				THEN BalancesAccordingToCalculatedIndicators.Dimension5
			ELSE UNDEFINED
		END) AS Dimension5,
	(CASE
			WHEN BalancesAccordingToCalculatedIndicators.BudgetBalanceItem.NumberOfUsedDimensions &gt;= 6
				THEN BalancesAccordingToCalculatedIndicators.Dimension6
			ELSE UNDEFINED
		END) AS Dimension6,
	BalancesAccordingToCalculatedIndicators.Organization.*,
	BalancesAccordingToCalculatedIndicators.Department.*,
	BalancesAccordingToCalculatedIndicators.Currency.*}</query>
	</dataSet>
