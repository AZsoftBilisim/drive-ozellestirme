	<totalField>
		<dataPath>Count</dataPath>
		<expression>IsNull(Sum(QuantityScenarioStartBalance), 0)
+ IsNull(Sum(QuantityScenarioReceipt), 0)
- IsNull(Sum(QuantityScenarioExpense), 0)</expression>
	</totalField>
	<totalField>
		<dataPath>CountReal</dataPath>
		<expression>IsNull(Sum(QuantityStartBalanceFact), 0)
+ IsNull(Sum(QuantityReceiptFact), 0)
- IsNull(Sum(QuantityExpenseFact), 0)</expression>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>IsNull(Sum(AmountScenarioStartBalance), 0)
+ IsNull(Sum(AmountScenarioReceipt), 0)
- IsNull(Sum(AmountScenarioExpense), 0)</expression>
	</totalField>
	<totalField>
		<dataPath>SumReal</dataPath>
		<expression>IsNull(Sum(AmountStartBalanceFact), 0)
+ IsNull(Sum(AmountReceiptActual), 0)
- IsNull(Sum(AmountExpenseFact), 0)</expression>
	</totalField>
