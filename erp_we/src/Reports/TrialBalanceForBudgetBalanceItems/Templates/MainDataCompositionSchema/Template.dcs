		<group>BudgetBalanceItem Hierarchy</group>
		<group>Scenario</group>
		<group>Scenario Hierarchy</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>QuantityFinalRemainderFact</dataPath>
		<expression>Sum(IsNull(QuantityStartBalanceFact,0)) + Sum(IsNull(QuantityReceiptFact,0)) - Sum(IsNull(QuantityExpenseFact,0))</expression>
