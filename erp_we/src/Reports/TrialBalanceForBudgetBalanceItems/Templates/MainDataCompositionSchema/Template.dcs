				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Nội dung trường, số lượng số tiền thực tế</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Fields text quantity amount actual</v8:content>
				</v8:item>
				<v8:item>
