		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CAST(TurnoversPlan.Scenario AS Catalog.BudgetingScenarios) AS Scenario,
	&amp;TextOfTurnoverFieldPlanPeriodSecond_ AS UpdateDate,
	TurnoversPlan.Recorder AS Recorder,
	TurnoversPlan.DayPeriod AS DayPeriod,
	TurnoversPlan.WeekPeriod AS WeekPeriod,
	TurnoversPlan.TenDaysPeriod AS TenDaysPeriod,
	TurnoversPlan.MonthPeriod AS MonthPeriod,
	TurnoversPlan.QuarterPeriod AS QuarterPeriod,
	TurnoversPlan.HalfYearPeriod AS HalfYearPeriod,
	TurnoversPlan.YearPeriod AS YearPeriod,
	CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems) AS BudgetBalanceItem,
	CAST(TurnoversPlan.BudgetFlowItem AS Catalog.BudgetFlowItems) AS BudgetFlowItem,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
			THEN TurnoversPlan.Dimension1
		ELSE UNDEFINED
	END AS Dimension1,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
			THEN TurnoversPlan.Dimension2
		ELSE UNDEFINED
	END AS Dimension2,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
			THEN TurnoversPlan.Dimension3
		ELSE UNDEFINED
	END AS Dimension3,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
			THEN TurnoversPlan.Dimension4
		ELSE UNDEFINED
	END AS Dimension4,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
			THEN TurnoversPlan.Dimension5
		ELSE UNDEFINED
	END AS Dimension5,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
			THEN TurnoversPlan.Dimension6
		ELSE UNDEFINED
	END AS Dimension6,
	CAST(TurnoversPlan.Organization AS Catalog.Companies) AS Organization,
	CAST(TurnoversPlan.Department AS Catalog.BusinessStructure) AS Department,
	CAST(TurnoversPlan.Currency AS Catalog.Currencies) AS Currency,
	CAST(TurnoversPlan.NumberOfParishPlan AS NUMBER(15,3)) AS QuantityScenarioReceipt,
	CAST(TurnoversPlan.TotalParishPlan AS NUMBER(31,2)) AS AmountScenarioReceipt,
	CAST(TurnoversPlan.NumberOfConsumable_ AS NUMBER(15,3)) AS QuantityScenarioExpense,
	CAST(TurnoversPlan.AmountExpensePlan AS NUMBER(31,2)) AS AmountScenarioExpense,
	0 AS QuantityReceiptFact,
	0 AS AmountReceiptActual,
	0 AS QuantityExpenseFact,
	0 AS AmountExpenseFact
{SELECT
	Scenario.*,
	UpdateDate,
	Recorder.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BudgetBalanceItem.*,
	BudgetFlowItem.*,
	Dimension1.*,
	Dimension2.*,
	Dimension3.*,
	Dimension4.*,
	Dimension5.*,
	Dimension6.*,
	Organization.*,
	Department.*,
	Currency.*,
	QuantityScenarioReceipt,
	AmountScenarioReceipt,
	QuantityScenarioExpense,
	AmountScenarioExpense,
	QuantityReceiptFact,
	AmountReceiptActual,
	QuantityExpenseFact,
	AmountExpenseFact}
FROM
	TurnoversPlan AS TurnoversPlan
{WHERE
	&amp;TextOfTurnoverFieldPlanPeriodSecond_ AS UpdateDate,
	TurnoversPlan.Recorder AS Recorder,
	TurnoversPlan.DayPeriod AS DayPeriod,
	TurnoversPlan.WeekPeriod AS WeekPeriod,
	TurnoversPlan.TenDaysPeriod AS TenDaysPeriod,
	TurnoversPlan.MonthPeriod AS MonthPeriod,
	TurnoversPlan.QuarterPeriod AS QuarterPeriod,
	TurnoversPlan.HalfYearPeriod AS HalfYearPeriod,
	TurnoversPlan.YearPeriod AS YearPeriod,
	CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).* AS BudgetBalanceItem,
	CAST(TurnoversPlan.BudgetFlowItem AS Catalog.BudgetFlowItems).* AS BudgetFlowItem,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
				THEN TurnoversPlan.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
				THEN TurnoversPlan.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
				THEN TurnoversPlan.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
				THEN TurnoversPlan.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
				THEN TurnoversPlan.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
				THEN TurnoversPlan.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	CAST(TurnoversPlan.Organization AS Catalog.Companies).* AS Organization,
	CAST(TurnoversPlan.Department AS Catalog.BusinessStructure).* AS Department,
	CAST(TurnoversPlan.Currency AS Catalog.Currencies).* AS Currency,
	CAST(TurnoversPlan.NumberOfParishPlan AS NUMBER(15,3)) AS QuantityScenarioReceipt,
	CAST(TurnoversPlan.TotalParishPlan AS NUMBER(31,2)) AS AmountScenarioReceipt,
	CAST(TurnoversPlan.NumberOfConsumable_ AS NUMBER(15,3)) AS QuantityScenarioExpense,
	CAST(TurnoversPlan.AmountExpensePlan AS NUMBER(31,2)) AS AmountScenarioExpense}

UNION ALL

SELECT
	CAST(TurnoverFact.Scenario AS Catalog.BudgetingScenarios),
	&amp;TextOfTurnoverFactPeriodSecondField_,
	TurnoverFact.Recorder,
	TurnoverFact.DayPeriod,
	TurnoverFact.WeekPeriod,
	TurnoverFact.TenDaysPeriod,
	TurnoverFact.MonthPeriod,
	TurnoverFact.QuarterPeriod,
	TurnoverFact.HalfYearPeriod,
	TurnoverFact.YearPeriod,
	CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems),
	CAST(TurnoverFact.BudgetFlowItem AS Catalog.BudgetFlowItems),
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
			THEN TurnoverFact.Dimension1
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
			THEN TurnoverFact.Dimension2
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
			THEN TurnoverFact.Dimension3
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
			THEN TurnoverFact.Dimension4
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
			THEN TurnoverFact.Dimension5
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
			THEN TurnoverFact.Dimension6
		ELSE UNDEFINED
	END,
	CAST(TurnoverFact.Organization AS Catalog.Companies),
	CAST(TurnoverFact.Department AS Catalog.BusinessStructure),
	CAST(TurnoverFact.Currency AS Catalog.Currencies),
	CAST(TurnoverFact.CountReceipt AS NUMBER(15,3)),
	CAST(TurnoverFact.SumReceipt AS NUMBER(31,2)),
	CAST(TurnoverFact.CountExpense AS NUMBER(15,3)),
	CAST(TurnoverFact.SumExpense AS NUMBER(31,2)),
	0,
	0,
	0,
	0
FROM
	TurnoverFactByInfluencingBudgetItems AS TurnoverFact
WHERE
	TurnoverFact.Scenario = VALUE(Catalog.BudgetingScenarios.BudgetFulfillment)
{WHERE
	&amp;TextOfTurnoverFactPeriodSecondField_ AS UpdateDate,
	TurnoverFact.Recorder,
	TurnoverFact.DayPeriod,
	TurnoverFact.WeekPeriod,
	TurnoverFact.TenDaysPeriod,
	TurnoverFact.MonthPeriod,
	TurnoverFact.QuarterPeriod,
	TurnoverFact.HalfYearPeriod,
	TurnoverFact.YearPeriod,
	CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).* AS BudgetBalanceItem,
	CAST(TurnoverFact.BudgetFlowItem AS Catalog.BudgetFlowItems).* AS BudgetFlowItem,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
				THEN TurnoverFact.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
				THEN TurnoverFact.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
				THEN TurnoverFact.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
				THEN TurnoverFact.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
				THEN TurnoverFact.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
				THEN TurnoverFact.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	CAST(TurnoverFact.Organization AS Catalog.Companies).* AS Organization,
	CAST(TurnoverFact.Department AS Catalog.BusinessStructure).* AS Department,
	CAST(TurnoverFact.Currency AS Catalog.Currencies).* AS Currency,
	CAST(TurnoverFact.CountReceipt AS NUMBER(15,3)) AS QuantityScenarioReceipt,
	CAST(TurnoverFact.SumReceipt AS NUMBER(31,2)) AS AmountScenarioReceipt,
	CAST(TurnoverFact.CountExpense AS NUMBER(15,3)) AS QuantityScenarioExpense,
	CAST(TurnoverFact.SumExpense AS NUMBER(31,2)) AS AmountScenarioExpense}
	
UNION ALL

SELECT
	CAST(BudgetingScenarios.Scenario AS Catalog.BudgetingScenarios),
	&amp;TextOfTurnoverFactPeriodSecondField_,
	TurnoverFact.Recorder,
	TurnoverFact.DayPeriod,
	TurnoverFact.WeekPeriod,
	TurnoverFact.TenDaysPeriod,
	TurnoverFact.MonthPeriod,
	TurnoverFact.QuarterPeriod,
	TurnoverFact.HalfYearPeriod,
	TurnoverFact.YearPeriod,
	CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems),
	CAST(TurnoverFact.BudgetFlowItem AS Catalog.BudgetFlowItems),
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
			THEN TurnoverFact.Dimension1
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
			THEN TurnoverFact.Dimension2
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
			THEN TurnoverFact.Dimension3
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
			THEN TurnoverFact.Dimension4
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
			THEN TurnoverFact.Dimension5
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
			THEN TurnoverFact.Dimension6
		ELSE UNDEFINED
	END,
	CAST(TurnoverFact.Organization AS Catalog.Companies),
	CAST(TurnoverFact.Department AS Catalog.BusinessStructure),
	CAST(TurnoverFact.Currency AS Catalog.Currencies),
	0,
	0,
	0,
	0,
	CAST(TurnoverFact.CountReceipt AS NUMBER(15,3)),
	CAST(TurnoverFact.SumReceipt AS NUMBER(31,2)),
	CAST(TurnoverFact.CountExpense AS NUMBER(15,3)),
	CAST(TurnoverFact.SumExpense AS NUMBER(31,2))
FROM
	TurnoverFactByInfluencingBudgetItems AS TurnoverFact
		LEFT JOIN BudgetingScenarios AS BudgetingScenarios
		ON (TRUE)
WHERE
	TurnoverFact.Scenario = VALUE(Catalog.BudgetingScenarios.ActualData)
{WHERE
	&amp;TextOfTurnoverFactPeriodSecondField_ AS UpdateDate,
	TurnoverFact.Recorder AS Recorder,
	TurnoverFact.DayPeriod AS DayPeriod,
	TurnoverFact.WeekPeriod AS WeekPeriod,
	TurnoverFact.TenDaysPeriod AS TenDaysPeriod,
	TurnoverFact.MonthPeriod AS MonthPeriod,
	TurnoverFact.QuarterPeriod AS QuarterPeriod,
	TurnoverFact.HalfYearPeriod AS HalfYearPeriod,
	TurnoverFact.YearPeriod AS YearPeriod,
	CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).* AS BudgetBalanceItem,
	CAST(TurnoverFact.BudgetFlowItem AS Catalog.BudgetFlowItems).* AS BudgetFlowItem,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
				THEN TurnoverFact.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
				THEN TurnoverFact.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
				THEN TurnoverFact.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
				THEN TurnoverFact.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
				THEN TurnoverFact.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
				THEN TurnoverFact.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	CAST(TurnoverFact.Organization AS Catalog.Companies).* AS Organization,
	CAST(TurnoverFact.Department AS Catalog.BusinessStructure).* AS Department,
	CAST(TurnoverFact.Currency AS Catalog.Currencies).* AS Currency,
	CAST(TurnoverFact.CountReceipt AS NUMBER(15,3)) AS QuantityReceiptFact,
	CAST(TurnoverFact.SumReceipt AS NUMBER(31,2)) AS AmountReceiptActual,
	CAST(TurnoverFact.CountExpense AS NUMBER(15,3)) AS QuantityExpenseFact,
	CAST(TurnoverFact.SumExpense AS NUMBER(31,2)) AS AmountExpenseFact}</query>
	</dataSet>
