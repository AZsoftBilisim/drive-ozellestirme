		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>TextOfFieldsQuantityAmountFact</dataPath>
			<field>TextOfFieldsQuantityAmountFact</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Fields text quantity amount actual</v8:content>
				</v8:item>
				<v8:item>
