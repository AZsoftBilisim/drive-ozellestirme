				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.BudgetFlowItems</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems) AS BudgetBalanceItem,
	&amp;TextOfBalanceFieldByCalculatedIndicatorsCoursePeriod_ AS UpdateDate,
	NULL AS Recorder,
	&amp;DateOfRemainingGoods AS DayPeriod,
	&amp;DateOfRemainingGoods AS WeekPeriod,
	&amp;DateOfRemainingGoods AS TenDaysPeriod,
	&amp;DateOfRemainingGoods AS MonthPeriod,
	&amp;DateOfRemainingGoods AS QuarterPeriod,
	&amp;DateOfRemainingGoods AS HalfYearPeriod,
	&amp;DateOfRemainingGoods AS YearPeriod,
	NULL AS BudgetFlowItem,
	CASE
		WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
			THEN BalancesAccordingToCalculatedIndicators.Dimension1
		ELSE UNDEFINED
	END AS Dimension1,
	CASE
		WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
			THEN BalancesAccordingToCalculatedIndicators.Dimension2
		ELSE UNDEFINED
	END AS Dimension2,
	CASE
		WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
			THEN BalancesAccordingToCalculatedIndicators.Dimension3
		ELSE UNDEFINED
	END AS Dimension3,
	CASE
		WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
			THEN BalancesAccordingToCalculatedIndicators.Dimension4
		ELSE UNDEFINED
	END AS Dimension4,
	CASE
		WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
			THEN BalancesAccordingToCalculatedIndicators.Dimension5
		ELSE UNDEFINED
	END AS Dimension5,
	CASE
		WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
			THEN BalancesAccordingToCalculatedIndicators.Dimension6
		ELSE UNDEFINED
	END AS Dimension6,
	CAST(BalancesAccordingToCalculatedIndicators.Organization AS Catalog.Companies) AS Organization,
	CAST(BalancesAccordingToCalculatedIndicators.Department AS Catalog.BusinessStructure) AS Department,
	CAST(BalancesAccordingToCalculatedIndicators.Currency AS Catalog.Currencies) AS Currency
{SELECT
	BudgetBalanceItem.*,
	UpdateDate,
	Recorder.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BudgetFlowItem.*,
	Dimension1.*,
	Dimension2.*,
	Dimension3.*,
	Dimension4.*,
	Dimension5.*,
	Dimension6.*,
	Organization.*,
	Department.*,
	Currency.*}
FROM
	BalancesAccordingToCalculatedIndicators AS BalancesAccordingToCalculatedIndicators
{WHERE
	CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).* AS BudgetBalanceItem,
	&amp;TextOfBalanceFieldByCalculatedIndicatorsCoursePeriod_ AS UpdateDate,
	&amp;DateOfRemainingGoods AS DayPeriod,
	&amp;DateOfRemainingGoods AS WeekPeriod,
	&amp;DateOfRemainingGoods AS TenDaysPeriod,
	&amp;DateOfRemainingGoods AS MonthPeriod,
	&amp;DateOfRemainingGoods AS QuarterPeriod,
	&amp;DateOfRemainingGoods AS HalfYearPeriod,
	&amp;DateOfRemainingGoods AS YearPeriod,
	(CASE
			WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
				THEN BalancesAccordingToCalculatedIndicators.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
				THEN BalancesAccordingToCalculatedIndicators.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
				THEN BalancesAccordingToCalculatedIndicators.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
				THEN BalancesAccordingToCalculatedIndicators.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
				THEN BalancesAccordingToCalculatedIndicators.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN CAST(BalancesAccordingToCalculatedIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
				THEN BalancesAccordingToCalculatedIndicators.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	CAST(BalancesAccordingToCalculatedIndicators.Organization AS Catalog.Companies).* AS Organization,
	CAST(BalancesAccordingToCalculatedIndicators.Department AS Catalog.BusinessStructure).* AS Department,
	CAST(BalancesAccordingToCalculatedIndicators.Currency AS Catalog.Currencies).* AS Currency}

UNION ALL

SELECT
	CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems),
	&amp;TextOfFactFieldByBudgetIndicatorsPeriodSecond_,
	NULL,
	&amp;DateOfRemainingGoods,
	&amp;DateOfRemainingGoods,
	&amp;DateOfRemainingGoods,
	&amp;DateOfRemainingGoods,
	&amp;DateOfRemainingGoods,
	&amp;DateOfRemainingGoods,
	&amp;DateOfRemainingGoods,
	NULL,
	CASE
		WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
			THEN FactOnBudgetIndicators.Dimension1
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
			THEN FactOnBudgetIndicators.Dimension2
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
			THEN FactOnBudgetIndicators.Dimension3
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
			THEN FactOnBudgetIndicators.Dimension4
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
			THEN FactOnBudgetIndicators.Dimension5
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
			THEN FactOnBudgetIndicators.Dimension6
		ELSE UNDEFINED
	END,
	CAST(FactOnBudgetIndicators.Organization AS Catalog.Companies),
	CAST(FactOnBudgetIndicators.Department AS Catalog.BusinessStructure),
	CAST(FactOnBudgetIndicators.Currency AS Catalog.Currencies)
FROM
	FactOnBudgetIndicators AS FactOnBudgetIndicators
{WHERE
	CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).* AS BudgetBalanceItem,
	&amp;TextOfFactFieldByBudgetIndicatorsPeriodSecond_ AS UpdateDate,
	&amp;DateOfRemainingGoods AS DayPeriod,
	&amp;DateOfRemainingGoods AS WeekPeriod,
	&amp;DateOfRemainingGoods AS TenDaysPeriod,
	&amp;DateOfRemainingGoods AS MonthPeriod,
	&amp;DateOfRemainingGoods AS QuarterPeriod,
	&amp;DateOfRemainingGoods AS HalfYearPeriod,
	&amp;DateOfRemainingGoods AS YearPeriod,
	(CASE
			WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
				THEN FactOnBudgetIndicators.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
				THEN FactOnBudgetIndicators.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
				THEN FactOnBudgetIndicators.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
				THEN FactOnBudgetIndicators.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
				THEN FactOnBudgetIndicators.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN CAST(FactOnBudgetIndicators.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
				THEN FactOnBudgetIndicators.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	CAST(FactOnBudgetIndicators.Organization AS Catalog.Companies).* AS Organization,
	CAST(FactOnBudgetIndicators.Department AS Catalog.BusinessStructure).* AS Department,
	CAST(FactOnBudgetIndicators.Currency AS Catalog.Currencies).* AS Currency}
	
UNION ALL

SELECT
	CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems),
	&amp;TextOfTurnoverFactPeriodSecondField_,
	TurnoversPlan.Recorder,
	TurnoversPlan.DayPeriod,
	TurnoversPlan.WeekPeriod,
	TurnoversPlan.TenDaysPeriod,
	TurnoversPlan.MonthPeriod,
	TurnoversPlan.QuarterPeriod,
	TurnoversPlan.HalfYearPeriod,
	TurnoversPlan.YearPeriod,
	CAST(TurnoversPlan.BudgetFlowItem AS Catalog.BudgetFlowItems),
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
			THEN TurnoversPlan.Dimension1
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
			THEN TurnoversPlan.Dimension2
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
			THEN TurnoversPlan.Dimension3
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
			THEN TurnoversPlan.Dimension4
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
			THEN TurnoversPlan.Dimension5
		ELSE UNDEFINED
	END,
	CASE
		WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
			THEN TurnoversPlan.Dimension6
		ELSE UNDEFINED
	END,
	CAST(TurnoversPlan.Organization AS Catalog.Companies),
	CAST(TurnoversPlan.Department AS Catalog.BusinessStructure),
	CAST(TurnoversPlan.Currency AS Catalog.Currencies)
FROM
	TurnoversPlan AS TurnoversPlan
{WHERE
	CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).* AS BudgetBalanceItem,
	&amp;TextOfTurnoverFactPeriodSecondField_ AS UpdateDate,
	TurnoversPlan.Recorder AS Recorder,
	TurnoversPlan.DayPeriod AS DayPeriod,
	TurnoversPlan.WeekPeriod AS WeekPeriod,
	TurnoversPlan.TenDaysPeriod AS TenDaysPeriod,
	TurnoversPlan.MonthPeriod AS MonthPeriod,
	TurnoversPlan.QuarterPeriod AS QuarterPeriod,
	TurnoversPlan.HalfYearPeriod AS HalfYearPeriod,
	TurnoversPlan.YearPeriod AS YearPeriod,
	TurnoversPlan.BudgetFlowItem.*,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
				THEN TurnoversPlan.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
				THEN TurnoversPlan.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
				THEN TurnoversPlan.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
				THEN TurnoversPlan.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
				THEN TurnoversPlan.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN CAST(TurnoversPlan.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
				THEN TurnoversPlan.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	CAST(TurnoversPlan.Organization AS Catalog.Companies).* AS Organization,
	CAST(TurnoversPlan.Department AS Catalog.BusinessStructure).* AS Department,
	CAST(TurnoversPlan.Currency AS Catalog.Currencies).* AS Currency}
	
UNION ALL

SELECT
	CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems) AS BudgetBalanceItem,
	&amp;TextOfTurnoverFactPeriodSecondField_ AS UpdateDate,
	TurnoverFact.Recorder AS Recorder,
	TurnoverFact.DayPeriod AS DayPeriod,
	TurnoverFact.WeekPeriod AS WeekPeriod,
	TurnoverFact.TenDaysPeriod AS TenDaysPeriod,
	TurnoverFact.MonthPeriod AS MonthPeriod,
	TurnoverFact.QuarterPeriod AS QuarterPeriod,
	TurnoverFact.HalfYearPeriod AS HalfYearPeriod,
	TurnoverFact.YearPeriod AS YearPeriod,
	CAST(TurnoverFact.BudgetFlowItem AS Catalog.BudgetFlowItems) AS BudgetFlowItem,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
			THEN TurnoverFact.Dimension1
		ELSE UNDEFINED
	END AS Dimension1,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
			THEN TurnoverFact.Dimension2
		ELSE UNDEFINED
	END AS Dimension2,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
			THEN TurnoverFact.Dimension3
		ELSE UNDEFINED
	END AS Dimension3,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
			THEN TurnoverFact.Dimension4
		ELSE UNDEFINED
	END AS Dimension4,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
			THEN TurnoverFact.Dimension5
		ELSE UNDEFINED
	END AS Dimension5,
	CASE
		WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
			THEN TurnoverFact.Dimension6
		ELSE UNDEFINED
	END AS Dimension6,
	CAST(TurnoverFact.Organization AS Catalog.Companies) AS Organization,
	CAST(TurnoverFact.Department AS Catalog.BusinessStructure) AS Department,
	CAST(TurnoverFact.Currency AS Catalog.Currencies) AS Currency
FROM
	TurnoverFactByInfluencingBudgetItems AS TurnoverFact
WHERE
	TurnoverFact.Scenario = VALUE(Catalog.BudgetingScenarios.ActualData)
{WHERE
	CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).* AS BudgetBalanceItem,
	&amp;TextOfTurnoverFactPeriodSecondField_ AS UpdateDate,
	TurnoverFact.Recorder AS Recorder,
	TurnoverFact.DayPeriod AS DayPeriod,
	TurnoverFact.WeekPeriod AS WeekPeriod,
	TurnoverFact.TenDaysPeriod AS TenDaysPeriod,
	TurnoverFact.MonthPeriod AS MonthPeriod,
	TurnoverFact.QuarterPeriod AS QuarterPeriod,
	TurnoverFact.HalfYearPeriod AS HalfYearPeriod,
	TurnoverFact.YearPeriod AS YearPeriod,
	CAST(TurnoverFact.BudgetFlowItem AS Catalog.BudgetFlowItems).* AS BudgetFlowItem,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 1
				THEN TurnoverFact.Dimension1
			ELSE UNDEFINED
		END).* AS Dimension1,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 2
				THEN TurnoverFact.Dimension2
			ELSE UNDEFINED
		END).* AS Dimension2,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 3
				THEN TurnoverFact.Dimension3
			ELSE UNDEFINED
		END).* AS Dimension3,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 4
				THEN TurnoverFact.Dimension4
			ELSE UNDEFINED
		END).* AS Dimension4,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 5
				THEN TurnoverFact.Dimension5
			ELSE UNDEFINED
		END).* AS Dimension5,
	(CASE
			WHEN CAST(TurnoverFact.BudgetBalanceItem AS Catalog.BudgetBalanceItems).NumberOfUsedDimensions &gt;= 6
				THEN TurnoverFact.Dimension6
			ELSE UNDEFINED
		END).* AS Dimension6,
	CAST(TurnoverFact.Organization AS Catalog.Companies).* AS Organization,
	CAST(TurnoverFact.Department AS Catalog.BusinessStructure).* AS Department,
	CAST(TurnoverFact.Currency AS Catalog.Currencies).* AS Currency}</query>
	</dataSet>
