	<totalField>
		<dataPath>CountFinalRemainderOfScript</dataPath>
		<expression>Sum(IsNull(QuantityScenarioStartBalance,0)) + Sum(IsNull(QuantityScenarioReceipt,0)) - Sum(IsNull(QuantityScenarioExpense,0))</expression>
		<group>Dimension1</group>
		<group>Dimension1 Hierarchy</group>
		<group>Dimension2</group>
		<group>Dimension2 Hierarchy</group>
		<group>Dimension3</group>
