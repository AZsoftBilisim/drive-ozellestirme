	<settingsVariant>
		<dcsset:name>SalesRepresentativeVisitingSchedule</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Sales representative visiting schedule</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>برنامه بازدید نماینده فروش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Calendario delle visite dei rappresentanti commerciali</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Kalendarz wizyt przedstawicieli handlowych</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Календарь визитов торговых представителей</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Satış temsilcilerinin ziyaret takvimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Lịch ghé thăm của đại diện thương mại</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:userFields>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>UserFields.field2</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>en</v8:lang>
							<v8:content>Duration, hours</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>مدت، ساعت</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
							<v8:content>Durata Dell'Orologio</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>pl</v8:lang>
							<v8:content>TrwałośćGodzin</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДлительностьЧасов</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>tr</v8:lang>
							<v8:content>Süre Saat</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>vi</v8:lang>
							<v8:content>Thời lượng giờ</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:detailExpression>Case
	When Duration = 0 Or Duration Is Null
		Then ""
	Else String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Hour")) + ":" + Case
			When DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Hour") * 60 &lt; 10
				Then "0" + String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Hour") * 60)
			Else String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Hour") * 60)
		End
End</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>Case
	When Duration = 0 Or Duration Is Null
		Then ""
	Else String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Hour")) + ":" + Case
			When DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Hour") * 60 &lt; 10
				Then "0" + String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Hour") * 60)
			Else String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Duration), "Hour") * 60)
		End
End</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression>Case
	When Sum(Duration) = 0 Or Sum(Duration) Is Null
		Then ""
	Else String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Hour")) + ":" + Case
			When DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Hour") * 60 &lt; 10
				Then "0" + String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Hour") * 60)
			Else String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Hour") * 60)
		End
End</dcsset:totalExpression>
					<dcsset:totalExpressionPresentation>Case
	When Sum(Duration) = 0 Or Sum(Duration) Is Null
		Then ""
	Else String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Hour")) + ":" + Case
			When DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Hour") * 60 &lt; 10
				Then "0" + String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Hour") * 60)
			Else String(DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Minute") - DateDiff(&amp;DateEmpty, DateAdd(&amp;DateEmpty, "Second", Sum(Duration)), "Hour") * 60)
		End
End</dcsset:totalExpressionPresentation>
				</dcsset:item>
