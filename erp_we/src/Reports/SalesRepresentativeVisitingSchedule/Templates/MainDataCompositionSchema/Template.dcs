			<presentationExpression>Format(PlannedVisitDate, "DF=dd.MM.yy") + " " + "(" + Format(PlannedVisitDate, "DF=ddd")+ ")"</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>SalesRepresentative</dataPath>
			<field>SalesRepresentative</field>
		</field>
