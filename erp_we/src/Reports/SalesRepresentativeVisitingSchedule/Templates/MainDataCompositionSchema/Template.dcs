			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Visits</dataPath>
		<expression>Count(Visits)</expression>
	</totalField>
	<totalField>
		<dataPath>BeginTime</dataPath>
		<expression>Min(BeginTime)</expression>
		<group>Job</group>
		<group>Partner</group>
		<group>SalesRepresentative</group>
	</totalField>
	<totalField>
		<dataPath>EndTime</dataPath>
		<expression>Max(EndTime)</expression>
		<group>Job</group>
		<group>Partner</group>
		<group>SalesRepresentative</group>
	</totalField>
	<totalField>
		<dataPath>Duration</dataPath>
		<expression>Sum(Duration)</expression>
	</totalField>
