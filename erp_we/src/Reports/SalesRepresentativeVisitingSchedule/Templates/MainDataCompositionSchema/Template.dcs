			<presentationExpression>String(Job.Number) + " " + NStr("ru = 'от'; vi = 'ngày'; en = 'dated'; it = 'del'; pl = 'od'; tr = 'itibaren'") + " " + Format(Job.Date, "DF=dd.MM.yy")</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Duration</dataPath>
			<field>Duration</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Duration</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مدت</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Durata</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Czas trwania</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Длительность</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Süre</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Thời lượng</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	JobForSalesRepresentative.PlannedVisitDate AS PlannedVisitDate,
	JobForSalesRepresentative.SalesRepresentative AS SalesRepresentative,
	COUNT(DISTINCT JobForSalesRepresentative.Ref) AS Visits,
	JobForSalesRepresentative.Partner,
	JobForSalesRepresentative.BeginTime AS BeginTime,
	JobForSalesRepresentative.EndTime,
	JobForSalesRepresentative.Ref AS Job,
	CASE
		WHEN JobForSalesRepresentative.BeginTime &lt;&gt; &amp;DateEmpty
				AND JobForSalesRepresentative.EndTime &gt; JobForSalesRepresentative.BeginTime
			THEN ISNULL(DATEDIFF(JobForSalesRepresentative.BeginTime, JobForSalesRepresentative.EndTime, SECOND), 0)
		ELSE 0
	END AS Duration
FROM
	Document.JobForSalesRepresentative AS JobForSalesRepresentative
WHERE
	(NOT JobForSalesRepresentative.DeletionMark)
	AND (JobForSalesRepresentative.PlannedVisitDate &gt;= BEGINOFPERIOD(&amp;BeginOfPeriod, DAY)
				AND (JobForSalesRepresentative.PlannedVisitDate &lt;= ENDOFPERIOD(&amp;EndOfPeriod, DAY)
					OR &amp;EndOfPeriod = &amp;DateEmpty)
			OR JobForSalesRepresentative.PlannedVisitDate = &amp;DateEmpty)

GROUP BY
	JobForSalesRepresentative.SalesRepresentative,
	JobForSalesRepresentative.Partner,
	JobForSalesRepresentative.PlannedVisitDate,
	JobForSalesRepresentative.BeginTime,
	JobForSalesRepresentative.EndTime,
	JobForSalesRepresentative.Ref

ORDER BY
	SalesRepresentative,
	PlannedVisitDate,
	BeginTime</query>
	</dataSet>
