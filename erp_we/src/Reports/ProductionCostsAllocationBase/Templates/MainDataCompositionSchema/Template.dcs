	<totalField>
		<dataPath>IndicatorValue</dataPath>
		<expression>Case When SumUpQuantityByStage Then Sum(IndicatorValue) Else 0 End</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>AmountByStages</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Max(AmountByStages)","ProductionLot, RowCodeProducts, ProductsGroup"))</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>AmountByStages</dataPath>
		<expression>Max(AmountByStages)</expression>
		<group>ProductsGroup</group>
		<group>RowCodeProducts</group>
		<group>ProductionLot</group>
	</totalField>
	<totalField>
		<dataPath>IndicatorValue</dataPath>
		<expression>Sum(IndicatorValue)</expression>
	</totalField>
	<totalField>
		<dataPath>IndicatorValuePercent</dataPath>
		<expression>Sum(Case When EvalExpression("Sum(IndicatorValuePercent)", "EntryType") = 0 Then 0 Else 100 * IndicatorValuePercent / EvalExpression("Sum(IndicatorValuePercent)", "EntryType") End)</expression>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Sum(Sum)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountByDivision</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Sum(AmountByDivision)","Department"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentStages</dataPath>
		<expression>Sum(Case When EvalExpression("Sum(PercentStages)", "Overall") = 0 Then 0 Else 100 * PercentStages / EvalExpression("Sum(PercentStages)", "Overall") End)</expression>
	</totalField>
	<totalField>
		<dataPath>DepartmentPercent</dataPath>
		<expression>Sum(Case When EvalExpression("Sum(DepartmentPercent)", "Overall") = 0 Then 0 Else 100 * DepartmentPercent / EvalExpression("Sum(DepartmentPercent)", "Overall") End)</expression>
	</totalField>
