			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Dynamika zmiany cen wg nomenklatury (Diagram)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
