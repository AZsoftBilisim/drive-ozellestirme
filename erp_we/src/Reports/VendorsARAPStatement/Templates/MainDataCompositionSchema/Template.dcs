End</expression>
	</totalField>
	<totalField>
		<dataPath>ScheduledSupplyOpeningBalance</dataPath>
		<expression>Case
    When Sum(ScheduledSupplyOpeningBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ScheduledSupplyOpeningBalance), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(ScheduledSupplyOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>BeingPaid</dataPath>
		<expression>Case
    When Sum(BeingPaid) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(BeingPaid), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(BeingPaid)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Supplied_2</dataPath>
