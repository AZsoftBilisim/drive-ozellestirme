End</expression>
	</totalField>
	<totalField>
		<dataPath>SheduledPaymentClosingBalance</dataPath>
		<expression>Case
    When Sum(SheduledPaymentClosingBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
