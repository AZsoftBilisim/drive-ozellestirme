			<field xsi:type="DataSetFieldField">
				<dataPath>BeingPaidOpeningBalance</dataPath>
				<field>BeingPaidOpeningBalance</field>
				<valueType>
					<v8:TypeId>48fa9d68-ae46-4d76-988a-88927f7a0ca6</v8:TypeId>
				</valueType>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BeingPaidClosingBalance</dataPath>
				<field>BeingPaidClosingBalance</field>
				<valueType>
					<v8:TypeId>48fa9d68-ae46-4d76-988a-88927f7a0ca6</v8:TypeId>
				</valueType>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	VALUE(Catalog.Companies.EmptyRef)             AS Organization,
	VALUE(Catalog.Partners.EmptyRef)                AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef)             AS Counterparty,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS Contract,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS ARAPObject,
	VALUE(Catalog.Currencies.EmptyRef)                  AS Currency,
	VALUE(Catalog.ARAPObjects.EmptyRef)         AS CorARAPObject,
	VALUE(Catalog.Partners.EmptyRef)                AS CorSupplier,
	VALUE(Catalog.Companies.EmptyRef)             AS CorCompany,
	VALUE(Catalog.Counterparties.EmptyRef)             AS CorCounterparty,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS CorContract,
	UNDEFINED                                              AS ARAPDocument,
	DATETIME(1,1,1)                                          AS OccurrenceDate,
	DATETIME(1,1,1)                                          AS PlannedRepaymentDate,
	""                                                        AS CalculationObjectComment,
	""                                                        AS ContractComment,
	""                                                        AS ARAPObjectCommentOBJECT,
	
	UNDEFINED                                              AS Recorder,
	UNDEFINED                                              AS ARAPAccountingRecorder,
	DATETIME(1,1,1)                                          AS SecondPeriod,
	
	0                                                         AS BeingPaidOpeningBalance,
	0                                                         AS BeingPaid,
	0                                                         AS BeingPaidClosingBalance,
	
	VALUE(Catalog.PartnersSegments.EmptyRef)       AS PartnersSegment</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>Ordered</dataPath>
		<expression>Case
    When Sum(Ordered) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Ordered), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(Ordered)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SetOff</dataPath>
		<expression>Case
    When Sum(SetOff) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SetOff), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(SetOff)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompanyClosingBalance</dataPath>
		<expression>Case
    When Sum(AccountsPayableOfCompanyClosingBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(AccountsPayableOfCompanyClosingBalance), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
        Sum(AccountsPayableOfCompanyClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompanyOpeningBalance</dataPath>
		<expression>Case
    When Sum(AccountsPayableOfCompanyOpeningBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
