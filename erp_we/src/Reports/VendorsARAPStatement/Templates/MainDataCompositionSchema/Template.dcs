    Else
        Sum(AccountsPayableOfCompanyOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Paid</dataPath>
		<expression>Case
    When Sum(Paid) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(Paid), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
