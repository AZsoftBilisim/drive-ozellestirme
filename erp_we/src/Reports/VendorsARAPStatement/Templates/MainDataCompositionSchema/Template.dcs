    When Sum(ScheduledSupplyClosingBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(ScheduledSupplyClosingBalance), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
