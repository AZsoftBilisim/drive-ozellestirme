						<v8:content>توضیح شیء موضوع دریافتنی/پرداختنی</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Объект расчетов объект комментарий</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Alacak/Borç nesnesi nesne yorum</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Đối tượng hạch toán đối tượng ghi chú</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>AR/AP object object comment</v8:content>
					</v8:item>
					<v8:item>
