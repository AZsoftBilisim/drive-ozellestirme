			<dataSource>DataSource1</dataSource>
			<query>SELECT
	VALUE(Catalog.Companies.EmptyRef)             AS Organization,
	VALUE(Catalog.Partners.EmptyRef)                AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef)             AS Counterparty,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS Contract,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS ARAPObject,
	VALUE(Catalog.Currencies.EmptyRef)                  AS Currency,
	VALUE(Catalog.ARAPObjects.EmptyRef)         AS CorARAPObject,
	VALUE(Catalog.Partners.EmptyRef)                AS CorSupplier,
	VALUE(Catalog.Companies.EmptyRef)             AS CorCompany,
	VALUE(Catalog.Counterparties.EmptyRef)             AS CorCounterparty,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS CorContract,
	UNDEFINED                                              AS ARAPDocument,
	DATETIME(1,1,1)                                          AS OccurrenceDate,
	DATETIME(1,1,1)                                          AS PlannedRepaymentDate,
	""                                                        AS CalculationObjectComment,
	""                                                        AS ContractComment,
	""                                                        AS ARAPObjectCommentOBJECT,
	
	UNDEFINED                                              AS Recorder,
	UNDEFINED                                              AS ARAPAccountingRecorder,
	DATETIME(1,1,1)                                          AS SecondPeriod,
	
	0                                                         AS ScheduledSupplyOpeningBalance,
	
	0                                                         AS Ordered,
	
	0                                                         AS ScheduledSupplyClosingBalance,
	
	VALUE(Catalog.PartnersSegments.EmptyRef)       AS PartnersSegment</query>
		</item>
