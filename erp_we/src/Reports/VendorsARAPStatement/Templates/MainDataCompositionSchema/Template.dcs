	</totalField>
	<totalField>
		<dataPath>DebtOfSupplierClosingBalance</dataPath>
		<expression>Case
    When Sum(DebtOfSupplierClosingBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(DebtOfSupplierClosingBalance), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
