End</expression>
	</totalField>
	<totalField>
		<dataPath>DebtOfSupplierOpeningBalance</dataPath>
		<expression>Case
    When Sum(DebtOfSupplierOpeningBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
        DataCompositionServer.RowReplaceLayout(JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(DebtOfSupplierOpeningBalance), ""NFD=2; NZ=0,00""), Currency", "Currency")), ";", "")
    Else
