		<query>SELECT
	RMRequestDefectiveSubAssets.Node AS NodeOfObjectOfOperation,
	RMRequestDefectiveSubAssets.DefectDetails,
	RMRequest.Status AS DefectStatus,
	RMRequest.Date AS DateOfDefectRegistration,
	RMRequest.FailureType
FROM
	Document.RMRequest.DefectiveSubAssets AS RMRequestDefectiveSubAssets
		LEFT JOIN Document.RMRequest AS RMRequest
		ON RMRequestDefectiveSubAssets.Ref = RMRequest.Ref
WHERE
	RMRequest.Posted</query>
