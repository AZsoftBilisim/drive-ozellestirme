		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	RegisterRecordsByExcisesTurnovers.Organization AS Organization,
	RegisterRecordsByExcisesTurnovers.ExcisePaymentBusinessUnit AS ExcisePaymentBusinessUnit,
	RegisterRecordsByExcisesTurnovers.Products AS Products,
	RegisterRecordsByExcisesTurnovers.ExcisableGoodsCategory AS ExcisableGoodsCategory,
	RegisterRecordsByExcisesTurnovers.KindOfTransactionWithExcisableGoods AS KindOfTransactionWithExcisableGoods,
	RegisterRecordsByExcisesTurnovers.QuantityInExcisableCategoryUOMTurnover AS QuantityInExcisableCategoryUOMTurnover,
	RegisterRecordsByExcisesTurnovers.CountTurnover AS CountTurnover,
	RegisterRecordsByExcisesTurnovers.ExciseAmountInCurrencyLocalTurnover AS ExciseAmountInCurrencyLocalTurnover,
	RegisterRecordsByExcisesTurnovers.ExciseAmountInCurrencyMgmtTurnover AS ExciseAmountInCurrencyMgmtTurnover
FROM
	AccumulationRegister.RegisterRecordsByExcises.Turnovers(,,, Products &lt;&gt; VALUE(Catalog.Products.EmptyRef)) AS
		RegisterRecordsByExcisesTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>QuantityInExcisableCategoryUOM</dataPath>
		<expression>Sum(QuantityInExcisableCategoryUOM)</expression>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<totalField>
		<dataPath>ExciseAmountInCurrencyLocal</dataPath>
		<expression>Sum(ExciseAmountInCurrencyLocal)</expression>
	</totalField>
	<totalField>
		<dataPath>ExciseAmountInCurrencyMgmt</dataPath>
		<expression>Sum(ExciseAmountInCurrencyMgmt)</expression>
	</totalField>
