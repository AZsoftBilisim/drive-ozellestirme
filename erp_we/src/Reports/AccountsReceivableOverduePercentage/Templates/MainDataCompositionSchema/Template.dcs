		</title>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
		</useRestriction>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>TotalGroupingAsOfThePeriodEnd</dataPath>
		<expression>NStr("ru = 'На конец периода'; vi = 'Cuối kỳ'; en = 'As of the period end'; it = 'Alla fine del periodo'; pl = 'Na koniec okresu'; tr = 'Dönem sonu itibariyle'")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Total grouping as of the period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>گروه‌بندی کل در پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Raggruppamento finale alla fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Łączne grupowanie na koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Итоговая группировка на конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu itibariyle toplam gruplandırma</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Gom nhóm tổng vào cuối kỳ</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>LogicalField</dataPath>
		<expression>Max(LogicalField)</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfOverdueDebt</dataPath>
		<expression>Case
	When Sum(CustomerAccountsReceivable) &lt;&gt; 0
		Then Sum(OverdueCustomerDebt) / Sum(CustomerAccountsReceivable) * 100
	Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>OverdueCustomerDebt</dataPath>
		<expression>Sum(OverdueCustomerDebt)</expression>
	</totalField>
	<totalField>
		<dataPath>CustomerAccountsReceivable</dataPath>
		<expression>Sum(CustomerAccountsReceivable)</expression>
	</totalField>
	<totalField>
		<dataPath>AccountsPayableOfCompany</dataPath>
		<expression>Sum(AccountsPayableOfCompany)</expression>
	</totalField>
	<totalField>
		<dataPath>ShareOfOverdueDebtMaximum</dataPath>
		<expression>Max(Case
	When CustomerAccountsReceivable &lt;&gt; 0
		Then OverdueCustomerDebt / CustomerAccountsReceivable * 100
	Else 0
End)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfExpirations</dataPath>
		<expression>Sum(EvalExpressionWithGroupArray("Case
	When OverdueCustomerDebt &lt;&gt; 0
	Then 1
	Else 0
End", "DateOfCalculation"))</expression>
	</totalField>
	<totalField>
		<dataPath>SerialNumber</dataPath>
		<expression>EvalExpression("GroupSerialNumber()", , , , , "Sum(OverdueCustomerDebt) Desc")</expression>
	</totalField>
