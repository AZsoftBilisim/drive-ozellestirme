		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Companies.Ref AS Organization,
	CurrencyExchangeRate.Currency AS Currency,
	CASE &amp;ReportData
			WHEN 1
				THEN ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(ManSExchangeRate.CourseDenominator, 1) / (ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1))
			ELSE ISNULL(CurrencyExchangeRate.CourseNumerator, 1) / ISNULL(CurrencyExchangeRate.CourseDenominator, 1)
	END AS ZoomRatio
INTO ExchangeRates
FROM
	Catalog.Companies AS Companies
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)}) AS CurrencyExchangeRate
			ON Companies.LocalAccountingCurrency = CurrencyExchangeRate.BaseCurrency
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast({(&amp;EndOfPeriod)}, Currency = &amp;ManagementAccountingCurrency) AS ManSExchangeRate
			ON Companies.LocalAccountingCurrency = ManSExchangeRate.BaseCurrency
INDEX BY
	Organization,
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SUM(CASE
			WHEN Calculations.SumClosingBalance &lt; 0
				THEN 0 - Calculations.SumClosingBalance
			ELSE 0
		END * CurrencyExchangeRate.ZoomRatio) AS AccountsPayableOfCompany,
	SUM(CASE
			WHEN Calculations.SumClosingBalance &gt; 0
				THEN Calculations.SumClosingBalance
			ELSE 0
		END * CurrencyExchangeRate.ZoomRatio) AS CustomerAccountsReceivable,
	SUM(CASE
			WHEN Calculations.SumClosingBalance &gt; 0
				THEN CASE
						WHEN Calculations.AmountDueClosingBalance &lt; 0
							THEN 0
						WHEN Calculations.SumClosingBalance &lt; Calculations.AmountDueClosingBalance
							THEN Calculations.SumClosingBalance
						ELSE Calculations.AmountDueClosingBalance
					END
			ELSE 0
		END * CurrencyExchangeRate.ZoomRatio) AS OverdueCustomerDebt,
	DimensionAccounting_1.Partner AS Partner,
	DimensionAccounting_1.Partner.BusinessRegion AS BusinessRegion,
	DimensionAccounting_1.Organization AS Organization,
	CASE WHEN NOT Calculations.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
			THEN DimensionAccounting_1.LineOfBusiness
			ELSE Calculations.ARAPObject.LineOfBusiness
	END AS LineOfBusiness,
	&amp;DateOfCalculation AS DateOfCalculation,
	Calculations.ARAPObject.Manager AS Manager,
	Calculations.Currency AS SettlementCurrency,
	CASE &amp;ReportData
		WHEN 1
			THEN &amp;ManagementAccountingCurrency
		ELSE DimensionAccounting_1.Organization.LocalAccountingCurrency
	END AS Currency
FROM
	AccumulationRegister.CustomersARAPAccounting.BalanceAndTurnovers(&amp;BeginningDateOfPeriod, &amp;DateOfCalculation, ) AS Calculations
		{INNER JOIN InformationRegister.AccountingDimensionByPartners AS DimensionAccounting_1
		ON Calculations.AccountingDimensionByPartners = DimensionAccounting_1.DimensionKey}
		LEFT JOIN ExchangeRates AS CurrencyExchangeRate
		ON (CurrencyExchangeRate.Currency = Calculations.Currency)
			AND (CurrencyExchangeRate.Organization = DimensionAccounting_1.Organization)
WHERE
	DimensionAccounting_1.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	(DimensionAccounting_1.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}

GROUP BY
	DimensionAccounting_1.Partner,
	DimensionAccounting_1.Partner.BusinessRegion,
	DimensionAccounting_1.Organization,
	CASE WHEN NOT Calculations.ARAPObject.ARAPAccountingRegistersAreNotDividedByLinesOfBusiness
			THEN DimensionAccounting_1.LineOfBusiness
			ELSE Calculations.ARAPObject.LineOfBusiness
	END,
	Calculations.ARAPObject.Manager,
	Calculations.Currency,
	CASE &amp;ReportData
		WHEN 1
			THEN &amp;ManagementAccountingCurrency
		ELSE DimensionAccounting_1.Organization.LocalAccountingCurrency
	END</query>
	</dataSet>
