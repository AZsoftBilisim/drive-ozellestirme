	<settingsVariant>
		<dcsset:name>ProhibitionOfShipmentOnCreditAndDelay</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Reason for delivery block by allowed credit and AR/AP overdue (context)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دلیل مسدودسازی تحویل بر اساس اعتبار مجاز و سررسیدگذشته دریافتنی/پرداختنی (زمینه)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
