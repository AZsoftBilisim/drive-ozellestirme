			<order>true</order>
		</useRestriction>
	</calculatedField>
	<calculatedField>
		<dataPath>ClosingBalanceCalculation</dataPath>
		<expression>Sum(SumClosingBalance) + IsNull(EvalExpression("IsNull(Sum(SumPlanReceipt), 0) + IsNull(Sum(SumPlanExpense), 0)", "TimeIntervals.DynamicPeriod", "Group", "First", "Current"), 0)</expression>
		<title xsi:type="v8:LocalStringType">
