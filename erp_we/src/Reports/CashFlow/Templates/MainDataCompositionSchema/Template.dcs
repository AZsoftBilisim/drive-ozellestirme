	<calculatedField>
		<dataPath>CashFlowCalculation</dataPath>
		<expression>IsNull(Sum(SumReceipt), 0) + IsNull(Sum(SumExpense), 0) + IsNull(Sum(SumPlanReceipt), 0) + IsNull(Sum(SumPlanExpense), 0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
