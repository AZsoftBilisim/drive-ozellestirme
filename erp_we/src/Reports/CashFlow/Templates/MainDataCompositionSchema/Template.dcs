	<calculatedField>
		<dataPath>PreviousSumCalculation</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And (EvalExpression("Count(Distinct Currency)", "TimeIntervals.DynamicPeriod", "Group", "Previous", "Previous") &gt; 1
Or EvalExpression("Count(Distinct Currency)") &gt; 1)
	Then
	0
	Else
		IsNull(EvalExpression("IsNull(Sum(SumReceipt), 0) + IsNull(Sum(SumExpense), 0) + IsNull(Sum(SumPlanReceipt), 0) + IsNull(Sum(SumPlanExpense), 0)", "TimeIntervals.DynamicPeriod", "Group", "Previous", "Previous"), 0)
End</expression>
