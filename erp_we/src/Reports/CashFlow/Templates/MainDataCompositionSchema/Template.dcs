		<expression>EvalExpression("IsNull(Sum(SumReceipt), 0) + IsNull(Sum(SumExpense), 0) + IsNull(Sum(SumPlanReceipt), 0) + IsNull(Sum(SumPlanExpense), 0)", "TimeIntervals.DynamicPeriod", "Group", "First", "Current")</expression>
