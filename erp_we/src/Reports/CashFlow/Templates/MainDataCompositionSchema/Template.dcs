			<dataSource>DataSource1</dataSource>
			<query>SELECT
	BusinessTransactionsSettings.BusinessOperation AS BusinessOperation
INTO OperationsReceipt
FROM
	Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
WHERE
	BusinessTransactionsSettings.DataSource = "RecordsCashIncomeExpenses"
	AND BusinessTransactionsSettings.Receipt = VALUE(Enum.AccountingDataTypes.Cash)
;
////////////////////////////////////////////////////////////////////////////////

SELECT
	BusinessTransactionsSettings.BusinessOperation AS BusinessOperation
INTO OperationsExpense
FROM
	Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
WHERE
	BusinessTransactionsSettings.DataSource = "RecordsCashIncomeExpenses"
	AND BusinessTransactionsSettings.Expense = VALUE(Enum.AccountingDataTypes.Cash)
;
////////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.LineOfBusinessCash           AS LineOfBusinessCash,
	RegisterData.Cash                    AS CashStorageLocation,
	RegisterData.CashType                  AS CashType,
	RegisterData.CashFlowItem       AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,

	
	RegisterData.IncomeAndExpenseItem               AS CorDimension,
	
	RegisterData.LineOfBusinessItems       AS LineOfBusiness,
	RegisterData.IncomeExpenseBusinessUnit        AS IncomeExpenseBusinessUnit,
	RegisterData.IncomeAndExpenseItem               AS IncomeAndExpenseItem,
	RegisterData.DimensionOfRevenue                    AS DimensionOfIncomeExpense,
	RegisterData.AssetsLiabilitiesDimension            AS AssetsLiabilitiesDimension,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			RegisterData.AmountInCurrencyTurnover
		WHEN 2 THEN
			RegisterData.SumTurnover
		WHEN 3 THEN
			RegisterData.SumComplTurnover
	END AS SumReceipt,
	
	0                                                  AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.Inpayment) AS MovementType,
	FALSE AS TransitOfOperation
	
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BusinessOperation.*,
	Organization.*,
	Department.*,
	LineOfBusinessCash.*,
	CashStorageLocation.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	CorDimension.*,
	LineOfBusiness.*,
	IncomeExpenseBusinessUnit.*,
	IncomeAndExpenseItem.*,
	DimensionOfIncomeExpense.*,
	AssetsLiabilitiesDimension,
	SumReceipt,
	SumExpense
}
FROM
	AccumulationRegister.RecordsCashIncomeExpenses.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (SELECT OperationsReceipt.BusinessOperation FROM OperationsReceipt)
		AND CashType IN (
			VALUE(Enum.CashTypes.CashPayment),
			VALUE(Enum.CashTypes.BankAccountPayments_)
			)
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusinessCash.*}
		{Cash.* AS CashStorageLocation}
		{CashType.*}
		{CashFlowItem.*}
		{Currency.*}
		{IncomeExpenseBusinessUnit.* AS IncomeExpenseBusinessUnit}
		{LineOfBusinessItems.* AS LineOfBusiness}
		{IncomeAndExpenseItem.* AS CorDimension}
		{IncomeAndExpenseItem.*}
		{DimensionOfRevenue.*}
		{AssetsLiabilitiesDimension.*}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.LineOfBusinessCash           AS LineOfBusinessCash,
	RegisterData.Cash                    AS CashStorageLocation,
	RegisterData.CashType                  AS CashType,
	RegisterData.CashFlowItem       AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.IncomeAndExpenseItem               AS CorDimension,
	
	RegisterData.LineOfBusinessItems       AS LineOfBusiness,
	RegisterData.IncomeExpenseBusinessUnit        AS IncomeExpenseBusinessUnit,
	RegisterData.IncomeAndExpenseItem               AS IncomeAndExpenseItem,
	RegisterData.DimensionOfRevenue                    AS DimensionOfIncomeExpense,
	RegisterData.AssetsLiabilitiesDimension            AS AssetsLiabilitiesDimension,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			RegisterData.AmountInCurrencyTurnover
		WHEN 2 THEN
			RegisterData.SumTurnover
		WHEN 3 THEN
			RegisterData.SumComplTurnover
	END AS SumReceipt,
	
	0                                                  AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.Inpayment) AS MovementType,
	FALSE AS TransitOfOperation
	
FROM
	AccumulationRegister.RecordsCashIncomeExpenses.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (SELECT OperationsReceipt.BusinessOperation FROM OperationsReceipt)
		AND CashType IN (
			VALUE(Enum.CashTypes.CashInTransit)
			)
		AND &amp;OutputDSVPaths
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusinessCash.*}
		{Cash.* AS CashStorageLocation}
		{CashType.*}
		{CashFlowItem.*}
		{Currency.*}
		{IncomeExpenseBusinessUnit.* AS IncomeExpenseBusinessUnit}
		{LineOfBusinessItems.* AS LineOfBusiness}
		{IncomeAndExpenseItem.* AS CorDimension}
		{IncomeAndExpenseItem.*}
		{DimensionOfRevenue.*}
		{AssetsLiabilitiesDimension.*}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
