			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Giao dịch đang chuyển</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Transit operations</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Transit operations</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And OpeningBalanceCalculation &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(OpeningBalanceCalculation, ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		OpeningBalanceCalculation
End</expression>
		<group>Indicators.OpeningBalance</group>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And ClosingBalanceCalculation &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(ClosingBalanceCalculation, ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		ClosingBalanceCalculation
End</expression>
		<group>Indicators.ClosingBalance</group>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And AccumulatedCashFlowCalculation &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(AccumulatedCashFlowCalculation, ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		AccumulatedCashFlowCalculation
End</expression>
		<group>Indicators.AccumulatedCashFlow</group>
	</totalField>
	<totalField>
		<dataPath>CashFlow_</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And CashFlowCalculation &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(CashFlowCalculation, ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		CashFlowCalculation
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumReceipt</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And Sum(SumReceipt) &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumReceipt), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		Sum(SumReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumExpense</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And Sum(SumExpense) &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumExpense), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		Sum(SumExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumOpeningBalance</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And Sum(SumOpeningBalance) &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumOpeningBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		Sum(SumOpeningBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumClosingBalance</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And Sum(SumClosingBalance) &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumClosingBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		Sum(SumClosingBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumPlanReceipt</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And Sum(SumPlanReceipt) &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumPlanReceipt), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		Sum(SumPlanReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumPlanExpense</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And Sum(SumPlanExpense) &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumPlanExpense), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		Sum(SumPlanExpense)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AccumulatedCashFlow</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And AccumulatedCashFlowCalculation &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(AccumulatedCashFlowCalculation, ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		AccumulatedCashFlowCalculation
End</expression>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And CashFlowCalculation &lt;&gt; 0
		And NumberOfCurrenciesTotal &gt; 1
	Then
		JoinStrings(EvalExpressionWithGroupValueTable("Format(CashFlowCalculation, ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
	Else
		CashFlowCalculation
End</expression>
	</totalField>
	<totalField>
		<dataPath>ThisIsACalculatedClosingBalance</dataPath>
		<expression>ValueIsFilled(EvalExpression("IsNull(Sum(SumPlanReceipt), 0) + IsNull(Sum(SumPlanExpense), 0)", "TimeIntervals.DynamicPeriod", "Group", "First", "Current"))</expression>
	</totalField>
	<totalField>
		<dataPath>ThisIsACalculatedOpeningBalance</dataPath>
		<expression>ValueIsFilled(EvalExpression("IsNull(Sum(SumPlanReceipt), 0) + IsNull(Sum(SumPlanExpense), 0)", "TimeIntervals.DynamicPeriod", "Group", "First", "Previous"))</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfCurrencies</dataPath>
		<expression>NumberOfCurrencies</expression>
	</totalField>
	<totalField>
		<dataPath>ChangeDirection</dataPath>
		<expression>Case
    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And (EvalExpression("Count(Distinct Currency)", "DynamicPeriod", "Group", "Previous", "Previous") &gt; 1
        Or EvalExpression("Count(Distinct Currency)") &gt; 1)
    Then
        ""
    Else
        Case
            When OpeningBalanceCalculation = 0 And PreviousOpeningBalanceCalculation = 0 Then
        ""
            When OpeningBalanceCalculation = PreviousOpeningBalanceCalculation Then
                "▬"
            When OpeningBalanceCalculation &gt; PreviousOpeningBalanceCalculation Then
                "▲"
            Else
                "▼"
        End
End</expression>
		<group>Indicators.OpeningBalance</group>
	</totalField>
	<totalField>
		<dataPath>ChangeDirection</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And (EvalExpression("Count(Distinct Currency)", "DynamicPeriod", "Group", "Previous", "Previous") &gt; 1
		    Or EvalExpression("Count(Distinct Currency)") &gt; 1)
	Then
		""
	Else
		Case
			When ClosingBalanceCalculation = 0 And PreviousClosingBalanceCalculation = 0 Then
				""
			When ClosingBalanceCalculation = PreviousClosingBalanceCalculation Then
				"▬"
			When ClosingBalanceCalculation &gt; PreviousClosingBalanceCalculation Then
				"▲"
			Else
				"▼"
		End
End
</expression>
		<group>Indicators.ClosingBalance</group>
	</totalField>
	<totalField>
		<dataPath>ChangeDirection</dataPath>
		<expression>Case
	When (&amp;ReportData = 1 Or &amp;ReportData = 3)
		And (EvalExpression("Count(Distinct Currency)", "TimeIntervals.DynamicPeriod", "Group", "Previous", "Previous") &gt; 1
		    Or EvalExpression("Count(Distinct Currency)") &gt; 1)
	Then
		""
	Else
		Case
			When CashFlowCalculation = 0 And PreviousSumCalculation = 0 Then
				""
			When CashFlowCalculation = PreviousSumCalculation Then
				"▬"
			When CashFlowCalculation &gt; PreviousSumCalculation Then
				"▲"
			Else
				"▼"
		End
End</expression>
	</totalField>
	<totalField>
		<dataPath>ChangePercentage_</dataPath>
		<expression>Case
    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And (EvalExpression("Count(Distinct Currency)", "TimeIntervals.DynamicPeriod", "Group", "Previous", "Previous") &gt; 1
    Or EvalExpression("Count(Distinct Currency)") &gt; 1)
    Then
        0
    Else
        Case
        When PreviousOpeningBalanceCalculation = 0 And OpeningBalanceCalculation = 0 Then
            0
        When PreviousOpeningBalanceCalculation &lt;&gt; 0 Then
                (OpeningBalanceCalculation - PreviousOpeningBalanceCalculation)/DataCompositionServer.ModuleNumbers(PreviousOpeningBalanceCalculation) * 100
    Else
            Case
                    When OpeningBalanceCalculation &gt; 0 Then
                            100
                        Else
                                -100
                End
    End
End</expression>
		<group>Indicators.OpeningBalance</group>
	</totalField>
	<totalField>
		<dataPath>ChangePercentage_</dataPath>
		<expression>Case
    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And (EvalExpression("Count(Distinct Currency)", "TimeIntervals.DynamicPeriod", "Group", "Previous", "Previous") &gt; 1
    Or EvalExpression("Count(Distinct Currency)") &gt; 1)
    Then
        0
    Else
        Case
        When PreviousClosingBalanceCalculation = 0 And ClosingBalanceCalculation = 0 Then
            0
        When PreviousClosingBalanceCalculation &lt;&gt; 0 Then
                (ClosingBalanceCalculation - PreviousClosingBalanceCalculation)/DataCompositionServer.ModuleNumbers(PreviousClosingBalanceCalculation) * 100
            Else
                        Case
                            When ClosingBalanceCalculation &gt; 0 Then
                                100
                            Else
                                -100
                        End
    End
End</expression>
		<group>Indicators.ClosingBalance</group>
	</totalField>
	<totalField>
		<dataPath>ChangePercentage_</dataPath>
		<expression>Case
    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And (EvalExpression("Count(Distinct Currency)", "TimeIntervals.DynamicPeriod", "Group", "Previous", "Previous") &gt; 1
    Or EvalExpression("Count(Distinct Currency)") &gt; 1)
    Then
        0
    Else
        Case
		When PreviousSumCalculation = 0 And CashFlowCalculation = 0 Then
			0
		When PreviousSumCalculation &lt;&gt; 0 Then
                (CashFlowCalculation - PreviousSumCalculation)/DataCompositionServer.ModuleNumbers(PreviousSumCalculation) * 100
			Else
		                Case
                		    When CashFlowCalculation &gt; 0 Then
		                        100
		                    Else
		                        -100
		                End
	End
End</expression>
	</totalField>
	<totalField>
		<dataPath>PreviousSum</dataPath>
		<expression>PreviousOpeningBalanceCalculation</expression>
		<group>Indicators.OpeningBalance</group>
	</totalField>
	<totalField>
		<dataPath>PreviousSum</dataPath>
		<expression>PreviousClosingBalanceCalculation</expression>
		<group>Indicators.ClosingBalance</group>
	</totalField>
	<totalField>
		<dataPath>PreviousSum</dataPath>
		<expression>PreviousSumCalculation</expression>
	</totalField>
	<totalField>
		<dataPath>ChangeDirection</dataPath>
		<expression>""</expression>
		<group>Indicators.AccumulatedCashFlow</group>
	</totalField>
	<totalField>
		<dataPath>ChangePercentage_</dataPath>
		<expression>0</expression>
		<group>Indicators.AccumulatedCashFlow</group>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>AmountOfWriteOffSchedule</expression>
		<group>Indicators.WriteOffSchedule</group>
	</totalField>
