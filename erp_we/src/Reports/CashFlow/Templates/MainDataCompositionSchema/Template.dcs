		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>OpeningBalanceCalculation</dataPath>
		<expression>Sum(SumOpeningBalance) + IsNull(EvalExpression("IsNull(Sum(SumPlanReceipt), 0) + IsNull(Sum(SumPlanExpense), 0)", "TimeIntervals.DynamicPeriod", "Group", "First", "Previous"), 0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Opening balance calculation</v8:content>
