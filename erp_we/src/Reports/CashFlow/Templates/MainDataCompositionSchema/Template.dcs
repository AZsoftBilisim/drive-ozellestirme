				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED // WriteOffs
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.CashFlowItem       AS CashFlowItem,
	
	CASE RegisterData.CashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.BankAcquirerCash) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.Deposits) THEN
			UNDEFINED
		ELSE
			RegisterData.Cash
	END                                              AS CashStorageLocation,
	RegisterData.CashType                  AS CashType,
	RegisterData.LineOfBusiness             AS LineOfBusinessCash,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.CorCash                 AS CorDimension,
	
	CASE RegisterData.CorCashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.BankAcquirerCash) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.Deposits) THEN
			UNDEFINED
		ELSE
			RegisterData.CorCash
	END                                              AS CorCashStorageLocation,
	RegisterData.CorCashType               AS CorCashType,
	RegisterData.CorLineOfBusiness          AS LineOfBusiness,
	RegisterData.CorrespondingCurency                           AS CorrespondingCurency,
	
	0                                                  AS SumReceipt,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			-RegisterData.AmountInCurrencyTurnover
		WHEN 2 THEN
			-RegisterData.SumTurnover
		WHEN 3 THEN
			-RegisterData.SumComplTurnover
	END AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.WriteOff) AS MovementType,

	CorCashType IN (
			VALUE(Enum.CashTypes.CashInTransit),
			VALUE(Enum.CashTypes.BankAcquirerCash)
			) AS TransitOfOperation
			
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BusinessOperation.*,
	Organization.*,
	Department.*,
	LineOfBusinessCash.*,
	CashStorageLocation.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	CorDimension.*,
	LineOfBusiness.*,
	SumReceipt,
	SumExpense
}
FROM
	AccumulationRegister.CashFlow.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.CashIssueToCashRegister),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegister),
			VALUE(Enum.BusinessTransactions.CashWithdrawalFromCashRegister),
			VALUE(Enum.BusinessTransactions.DepositCashIntoCashRegister),
			VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.TransferCashToAnotherAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherAccount),
			VALUE(Enum.BusinessTransactions.CashDepositToBankAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromBank),
			VALUE(Enum.BusinessTransactions.CashCollectionToBank),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegisterToBankAccount),
			VALUE(Enum.BusinessTransactions.WithdrawalFromBankAccount),
			VALUE(Enum.BusinessTransactions.CashCollectionFromBank),
			VALUE(Enum.BusinessTransactions.CurrencyConversion),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCurrencyConversion),
			VALUE(Enum.BusinessTransactions.CashRecieptByAcquiringTransactionsPayment),
			VALUE(Enum.BusinessTransactions.IssueCashToAdvanceHolder),
			VALUE(Enum.BusinessTransactions.TransferToDeposits),
			VALUE(Enum.BusinessTransactions.RefundAcquiringPayment)
		)
		AND CashType IN (
			VALUE(Enum.CashTypes.CashPayment),
			VALUE(Enum.CashTypes.BankAccountPayments_)
			)
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusiness.* AS LineOfBusinessCash}
		{Cash.* AS CashStorageLocation}
		{CashType.*}
		{CashFlowItem.*}
		{Currency.*}
		{CorLineOfBusiness.* AS LineOfBusiness}
		{CorCash.*}
		{CorCash.* AS CorDimension}
		{CorCashType.*}
		{CorrespondingCurency.*}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT // WriteOffs
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.CashFlowItem       AS CashFlowItem,
	
	CASE RegisterData.CashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.BankAcquirerCash) THEN
			UNDEFINED
		ELSE
			RegisterData.Cash
	END                                              AS CashStorageLocation,
	RegisterData.CashType                  AS CashType,
	RegisterData.LineOfBusiness             AS LineOfBusinessCash,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.CorCash                 AS CorDimension,
	
	CASE RegisterData.CorCashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.BankAcquirerCash) THEN
			UNDEFINED
		ELSE
			RegisterData.CorCash
	END                                              AS CorCashStorageLocation,
	RegisterData.CorCashType               AS CorCashType,
	RegisterData.CorLineOfBusiness          AS LineOfBusiness,
	RegisterData.CorrespondingCurency                           AS CorrespondingCurency,
	
	0                                                  AS SumReceipt,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			-RegisterData.AmountInCurrencyTurnover
		WHEN 2 THEN
			-RegisterData.SumTurnover
		WHEN 3 THEN
			-RegisterData.SumComplTurnover
	END AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.WriteOff) AS MovementType,
	
	TRUE AS TransitOfOperation
	
FROM
	AccumulationRegister.CashFlow.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.CashIssueToCashRegister),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegister),
			VALUE(Enum.BusinessTransactions.CashWithdrawalFromCashRegister),
			VALUE(Enum.BusinessTransactions.DepositCashIntoCashRegister),
			VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.TransferCashToAnotherAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherAccount),
			VALUE(Enum.BusinessTransactions.CashDepositToBankAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromBank),
			VALUE(Enum.BusinessTransactions.CashCollectionToBank),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegisterToBankAccount),
			VALUE(Enum.BusinessTransactions.WithdrawalFromBankAccount),
			VALUE(Enum.BusinessTransactions.CashCollectionFromBank),
			VALUE(Enum.BusinessTransactions.CurrencyConversion),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCurrencyConversion),
			VALUE(Enum.BusinessTransactions.CashRecieptByAcquiringTransactionsPayment),
			VALUE(Enum.BusinessTransactions.RefundAcquiringPayment)
		)
		AND CashType IN (
			VALUE(Enum.CashTypes.CashInTransit),
			VALUE(Enum.CashTypes.BankAcquirerCash)
			)
		AND &amp;OutputDSVPaths
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusiness.* AS LineOfBusinessCash}
		{Cash.* AS CashStorageLocation}
		{CashType.*}
		{CashFlowItem.*}
		{Currency.*}
		{CorLineOfBusiness.* AS LineOfBusiness}
		{CorCash.*}
		{CorCash.* AS CorDimension}
		{CorCashType.*}
		{CorrespondingCurency.*}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT // Inflow
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.CashFlowItem       AS CashFlowItem,
	
	CASE RegisterData.CorCashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.BankAcquirerCash) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.Deposits) THEN
			UNDEFINED
		ELSE
			RegisterData.CorCash
	END                                              AS CashStorageLocation,
	RegisterData.CorCashType               AS CashType,
	RegisterData.CorLineOfBusiness          AS LineOfBusinessCash,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.CorrespondingCurency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.Cash                    AS CorDimension,
	
	CASE RegisterData.CashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.BankAcquirerCash) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.Deposits) THEN
			UNDEFINED
		ELSE
			RegisterData.Cash
	END                                              AS CorCashStorageLocation,
	RegisterData.CashType                  AS CorCashType,
	RegisterData.LineOfBusiness             AS LineOfBusiness,
	RegisterData.Currency                              AS CorrespondingCurency,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			RegisterData.AmountInCurrencyTurnover
		WHEN 2 THEN
			RegisterData.SumTurnover
		WHEN 3 THEN
			RegisterData.SumComplTurnover
	END AS SumReceipt,
	
	0                                                  AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.Inpayment) AS MovementType,
	
	CashType IN (
			VALUE(Enum.CashTypes.CashInTransit),
			VALUE(Enum.CashTypes.BankAcquirerCash)
			) AS TransitOfOperation
	
FROM
	AccumulationRegister.CashFlow.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.CashIssueToCashRegister),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegister),
			VALUE(Enum.BusinessTransactions.CashWithdrawalFromCashRegister),
			VALUE(Enum.BusinessTransactions.DepositCashIntoCashRegister),
			VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.TransferCashToAnotherAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherAccount),
			VALUE(Enum.BusinessTransactions.CashDepositToBankAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromBank),
			VALUE(Enum.BusinessTransactions.CashCollectionToBank),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegisterToBankAccount),
			VALUE(Enum.BusinessTransactions.WithdrawalFromBankAccount),
			VALUE(Enum.BusinessTransactions.CashCollectionFromBank),
			VALUE(Enum.BusinessTransactions.CurrencyConversion),
			VALUE(Enum.BusinessTransactions.CashRecieptByAcquiringTransactionsPayment),
			VALUE(Enum.BusinessTransactions.CashReturnByAdvanceHolder),
			VALUE(Enum.BusinessTransactions.CashReceiptUnderDeposits),
			VALUE(Enum.BusinessTransactions.RefundAcquiringPayment)
		)
		AND CorCashType IN (
			VALUE(Enum.CashTypes.CashPayment),
			VALUE(Enum.CashTypes.BankAccountPayments_),
			VALUE(Enum.CashTypes.AdvanceHolderSCash)
			)
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusiness.* AS LineOfBusiness}
		{CorCash.* AS CashStorageLocation}
		{CashType.* AS CorCashType}
		{CashFlowItem.*}
		{Currency.* AS CorrespondingCurency}
		{CorLineOfBusiness.* AS LineOfBusinessCash}
		{Cash.* AS CorCashStorageLocation}
		{Cash.* AS CorDimension}
		{CorCashType.* AS CashType}
		{CorrespondingCurency.* AS Currency}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT // Inflow
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.CashFlowItem       AS CashFlowItem,
	
	CASE RegisterData.CorCashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.BankAcquirerCash) THEN
			UNDEFINED
		ELSE
			RegisterData.CorCash
	END                                              AS CashStorageLocation,
	RegisterData.CorCashType               AS CashType,
	RegisterData.CorLineOfBusiness          AS LineOfBusinessCash,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.CorrespondingCurency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.Cash                    AS CorDimension,
	
	CASE RegisterData.CashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		WHEN VALUE(Enum.CashTypes.BankAcquirerCash) THEN
			UNDEFINED
		ELSE
			RegisterData.Cash
	END                                              AS CorCashStorageLocation,
	RegisterData.CashType                  AS CorCashType,
	RegisterData.LineOfBusiness             AS LineOfBusiness,
	RegisterData.Currency                              AS CorrespondingCurency,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			RegisterData.AmountInCurrencyTurnover
		WHEN 2 THEN
			RegisterData.SumTurnover
		WHEN 3 THEN
			RegisterData.SumComplTurnover
	END AS SumReceipt,
	
	0                                                  AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.Inpayment) AS MovementType,
	
	TRUE AS TransitOfOperation
	
FROM
	AccumulationRegister.CashFlow.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.CashIssueToCashRegister),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegister),
			VALUE(Enum.BusinessTransactions.CashWithdrawalFromCashRegister),
			VALUE(Enum.BusinessTransactions.DepositCashIntoCashRegister),
			VALUE(Enum.BusinessTransactions.CashIssueToAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherCashAccount),
			VALUE(Enum.BusinessTransactions.TransferCashToAnotherAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromAnotherAccount),
			VALUE(Enum.BusinessTransactions.CashDepositToBankAccount),
			VALUE(Enum.BusinessTransactions.CashReceiptFromBank),
			VALUE(Enum.BusinessTransactions.CashCollectionToBank),
			VALUE(Enum.BusinessTransactions.CashReceiptFromCashRegisterToBankAccount),
			VALUE(Enum.BusinessTransactions.WithdrawalFromBankAccount),
			VALUE(Enum.BusinessTransactions.CashCollectionFromBank),
			VALUE(Enum.BusinessTransactions.CurrencyConversion),
			VALUE(Enum.BusinessTransactions.CashRecieptByAcquiringTransactionsPayment),
			VALUE(Enum.BusinessTransactions.RefundAcquiringPayment)
		)
		AND CorCashType IN (
			VALUE(Enum.CashTypes.CashInTransit),
			VALUE(Enum.CashTypes.BankAcquirerCash)
			)
		AND &amp;OutputDSVPaths
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusiness.* AS LineOfBusiness}
		{CorCash.* AS CashStorageLocation}
		{CashType.* AS CorCashType}
		{CashFlowItem.*}
		{Currency.* AS CorrespondingCurency}
		{CorLineOfBusiness.* AS LineOfBusinessCash}
		{Cash.* AS CorCashStorageLocation}
		{Cash.* AS CorDimension}
		{CorCashType.* AS CashType}
		{CorrespondingCurency.* AS Currency}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT // Receipts conversion
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.CashFlowItem       AS CashFlowItem,
	
	CASE RegisterData.CorCashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		ELSE
			RegisterData.CorCash
	END                                              AS CashStorageLocation,
	RegisterData.CorCashType               AS CashType,
	RegisterData.CorLineOfBusiness          AS LineOfBusinessCash,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.CorrespondingCurency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.Cash                    AS CorDimension,
	
	CASE RegisterData.CashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		ELSE
			RegisterData.Cash
	END                                              AS CorCashStorageLocation,
	RegisterData.CashType                  AS CorCashType,
	RegisterData.LineOfBusiness             AS LineOfBusiness,
	RegisterData.Currency                              AS CorrespondingCurency,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			RegisterData.AmountInCorCurrencyTurnover
		WHEN 2 THEN
			RegisterData.SumTurnover
		WHEN 3 THEN
			RegisterData.SumComplTurnover
	END AS SumReceipt,
	
	0                                                  AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.Inpayment) AS MovementType,
	
	CashType IN (
			VALUE(Enum.CashTypes.CashInTransit),
			VALUE(Enum.CashTypes.BankAcquirerCash)
			) AS TransitOfOperation
	
FROM
	AccumulationRegister.CashFlow.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.CashReceiptFromCurrencyConversion)
		)
		AND CorCashType IN (
			VALUE(Enum.CashTypes.CashPayment),
			VALUE(Enum.CashTypes.BankAccountPayments_)
			)
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusiness.* AS LineOfBusiness}
		{Cash.* AS CorCashStorageLocation}
		{CashType.* AS CorCashType}
		{CashFlowItem.*}
		{Currency.* AS CorrespondingCurency}
		{CorLineOfBusiness.* AS LineOfBusinessCash}
		{CorCash.* AS CashStorageLocation}
		{Cash.* AS CorDimension}
		{CorCashType.* AS CashType}
		{CorrespondingCurency.* AS Currency}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT // Receipts conversion
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.CashFlowItem       AS CashFlowItem,
	
	CASE RegisterData.CorCashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		ELSE
			RegisterData.CorCash
	END                                              AS CashStorageLocation,
	RegisterData.CorCashType               AS CashType,
	RegisterData.CorLineOfBusiness          AS LineOfBusinessCash,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.CorrespondingCurency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.Cash                    AS CorDimension,
	
	CASE RegisterData.CashType
		WHEN VALUE(Enum.CashTypes.CashInTransit) THEN
			UNDEFINED
		ELSE
			RegisterData.Cash
	END                                              AS CorCashStorageLocation,
	RegisterData.CashType                  AS CorCashType,
	RegisterData.LineOfBusiness             AS LineOfBusiness,
	RegisterData.Currency                              AS CorrespondingCurency,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			RegisterData.AmountInCorCurrencyTurnover
		WHEN 2 THEN
			RegisterData.SumTurnover
		WHEN 3 THEN
			RegisterData.SumComplTurnover
	END AS SumReceipt,
	
	0                                                  AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.Inpayment) AS MovementType,
	
	TRUE AS TransitOfOperation
	
FROM
	AccumulationRegister.CashFlow.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (
			VALUE(Enum.BusinessTransactions.CashReceiptFromCurrencyConversion)
		)
		AND CorCashType = VALUE(Enum.CashTypes.CashInTransit)
		AND &amp;OutputDSVPaths
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusiness.* AS LineOfBusiness}
		{Cash.* AS CorCashStorageLocation}
		{CashType.* AS CorCashType}
		{CashFlowItem.*}
		{Currency.* AS CorrespondingCurency}
		{CorLineOfBusiness.* AS LineOfBusinessCash}
		{CorCash.* AS CashStorageLocation}
		{Cash.* AS CorDimension}
		{CorCashType.* AS CashType}
		{CorrespondingCurency.* AS Currency}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT
	RegisterData.Recorder                         AS Recorder,
	RegisterData.Period                              AS SecondPeriod,
	BEGINOFPERIOD(RegisterData.Period, DAY)         AS DayPeriod,
	BEGINOFPERIOD(RegisterData.Period, WEEK)       AS WeekPeriod,
	BEGINOFPERIOD(RegisterData.Period, TENDAYS)       AS TenDaysPeriod,
	BEGINOFPERIOD(RegisterData.Period, MONTH)        AS MonthPeriod,
	BEGINOFPERIOD(RegisterData.Period, QUARTER)      AS QuarterPeriod,
	BEGINOFPERIOD(RegisterData.Period, HALFYEAR)    AS HalfYearPeriod,
	BEGINOFPERIOD(RegisterData.Period, YEAR)          AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.CashRegister.Department              AS Department,
	RegisterData.CashFlowItem       AS CashFlowItem,
	
	RegisterData.CashRegister                                   AS CashStorageLocation,
	VALUE(Enum.CashTypes.CashPayment)       AS CashType,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusinessCash,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.CashRegister.CashCurrency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	UNDEFINED                                              AS CorDimension,
	UNDEFINED                                              AS CorCashStorageLocation,
	UNDEFINED                                              AS CorCashType,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.Currencies.EmptyRef)                  AS CorrespondingCurency,
	
	CASE
			WHEN RegisterData.RecordType = VALUE(AccumulationRecordType.Receipt)
				THEN CASE &amp;ReportData
						WHEN 1
							THEN RegisterData.Sum
						WHEN 2
							THEN RegisterData.SumMan
						WHEN 3
							THEN RegisterData.SumCompl
					END
			ELSE 0
	END AS SumReceipt,
	
	CASE
			WHEN RegisterData.RecordType = VALUE(AccumulationRecordType.Expense)
				THEN CASE &amp;ReportData
						WHEN 1
							THEN RegisterData.Sum
						WHEN 2
							THEN RegisterData.SumMan
						WHEN 3
							THEN RegisterData.SumCompl
					END
			ELSE 0
	END AS SumExpense,
	
	CASE
		WHEN RegisterData.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN VALUE(Enum.CashFlowTypes.WriteOff)
		ELSE VALUE(Enum.CashFlowTypes.Inpayment)
	END AS MovementType,
	
	FALSE AS TransitOfOperation
	
FROM
	AccumulationRegister.CashInCashRegistersCR AS RegisterData
WHERE
	RegisterData.Active
	AND VALUETYPE(RegisterData.Recorder) IN (
	TYPE(Document.CashRegisterReceipt),
	TYPE(Document.CashRegisterReceiptReturn))
{WHERE
	RegisterData.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod,
	RegisterData.Organization.*,
	RegisterData.CashRegister.* AS CashStorageLocation,
	RegisterData.Recorder.*
}
</query>
		</item>
