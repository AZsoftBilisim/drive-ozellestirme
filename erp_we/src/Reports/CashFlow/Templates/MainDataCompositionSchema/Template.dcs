			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.BaseCurrency AS BaseCurrency,
	CurrencyExchangeRate.CourseNumerator AS CourseNumerator,
	CurrencyExchangeRate.CourseDenominator AS CourseDenominator
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;CurrentDate}) AS CurrencyExchangeRate
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RegisterData.PaymentObject AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	RegisterData.BankAccountCashAccount.LineOfBusiness AS LineOfBusinessCash,
	RegisterData.BankAccountCashAccount AS CashStorageLocation,
	CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment)
			THEN VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_)
			THEN VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard)
			THEN VALUE(Enum.CashTypes.BankAcquirerCash)
	END AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	RegisterData.PayerBeneficiary AS CorDimension,
	RegisterData.PaymentObject AS PaymentObject,
	RegisterData.LineOfBusiness AS LineOfBusiness,
	RegisterData.PlanningArea AS PlanningArea,
	CASE
		WHEN RegisterData.ReceiptIssue = VALUE(Enum.CashFlowTypes.Inpayment)
			THEN CASE
				WHEN &amp;ReportData = 1
					THEN RegisterData.Sum
				ELSE RegisterData.Sum * CASE &amp;ReportData
					WHEN 1
						THEN 1
					WHEN 2
						THEN ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(ManSExchangeRate.CourseDenominator, 1) /
							(ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1))
					ELSE ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseDenominator, 1) /
						(ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseNumerator, 1))
				END
			END
		ELSE 0
	END AS SumPlanReceipt,
	CASE
		WHEN RegisterData.ReceiptIssue = VALUE(Enum.CashFlowTypes.WriteOff)
			THEN CASE
				WHEN &amp;ReportData = 1
					THEN -RegisterData.Sum
				ELSE -RegisterData.Sum * CASE &amp;ReportData
					WHEN 1
						THEN 1
					WHEN 2
						THEN ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(ManSExchangeRate.CourseDenominator, 1) /
							(ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1))
					ELSE ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseDenominator, 1) /
						(ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseNumerator, 1))
				END
			END
		ELSE 0
	END AS SumPlanExpense,
	RegisterData.ReceiptIssue AS MovementType,

	RegisterData.AmountType REFS Enum.CashTransferKinds AS TransitOfOperation
	
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BusinessOperation.*,
	Organization.*,
	Department.*,
	LineOfBusinessCash.*,
	CashStorageLocation.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	CorDimension.*,
	LineOfBusiness.*,
	PlanningArea.*,
	SumPlanReceipt,
	SumPlanExpense}
FROM
	InformationRegister.ScheduleOfPayments AS RegisterData
		LEFT JOIN ExchangeRates AS CurrencyExchangeRate
		ON CurrencyExchangeRate.Currency = RegisterData.Currency
		AND CurrencyExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
		LEFT JOIN ExchangeRates AS ManSExchangeRate
		ON ManSExchangeRate.Currency = &amp;ManagementAccountingCurrency
		AND ManSExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
		LEFT JOIN ExchangeRates AS LocalCurrencyExchangeRate
		ON LocalCurrencyExchangeRate.Currency = RegisterData.Organization.LocalAccountingCurrency
		AND LocalCurrencyExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
WHERE
	RegisterData.PaymentDate &lt;= &amp;EndOfPeriod
	AND &amp;DisplayPlannedRegisteredRecords
{WHERE
	RegisterData.BusinessOperation.*,
	RegisterData.Organization.*,
	RegisterData.Department.*,
	RegisterData.BankAccountCashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccountCashAccount.* AS CashStorageLocation,
	(CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment)
			THEN VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_)
			THEN VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard)
			THEN VALUE(Enum.CashTypes.BankAcquirerCash)
	END).* AS CashType,
	RegisterData.CashFlowItem.*,
	RegisterData.Currency.*,
	RegisterData.LineOfBusiness.*,
	RegisterData.PayerBeneficiary.*,
	RegisterData.PayerBeneficiary.* AS CorDimension,
	RegisterData.PaymentObject.*,
	RegisterData.PlanningArea.*,
	RegisterData.PaymentObject.* AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, YEAR)}

UNION ALL

SELECT // DS on the way
 RegisterData.PaymentObject AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	UNDEFINED AS LineOfBusinessCash,
	UNDEFINED AS CashStorageLocation,
	CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment)
			THEN VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_)
			THEN VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard)
			THEN VALUE(Enum.CashTypes.BankAcquirerCash)
	END AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	RegisterData.PayerBeneficiary AS CorDimension,
	RegisterData.PaymentObject AS PaymentObject,
	RegisterData.LineOfBusiness AS LineOfBusiness,
	RegisterData.PlanningArea AS PlanningArea,
	0 AS SumPlanReceipt,
	CASE
		WHEN &amp;ReportData = 1
			THEN -RegisterData.Sum
		ELSE -RegisterData.Sum * CASE &amp;ReportData
			WHEN 1
				THEN 1
			WHEN 2
				THEN ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(ManSExchangeRate.CourseDenominator, 1) /
					(ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1))
			ELSE ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseDenominator, 1) /
				(ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseNumerator, 1))
		END
	END AS SumPlanExpense,
	VALUE(Enum.CashFlowTypes.WriteOff) AS MovementType,
	
	TRUE AS TransitOfOperation
	
FROM
	InformationRegister.ScheduleOfPayments AS RegisterData
		LEFT JOIN ExchangeRates AS CurrencyExchangeRate
		ON CurrencyExchangeRate.Currency = RegisterData.Currency
		AND CurrencyExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
		LEFT JOIN ExchangeRates AS ManSExchangeRate
		ON ManSExchangeRate.Currency = &amp;ManagementAccountingCurrency
		AND ManSExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
		LEFT JOIN ExchangeRates AS LocalCurrencyExchangeRate
		ON LocalCurrencyExchangeRate.Currency = RegisterData.Organization.LocalAccountingCurrency
		AND LocalCurrencyExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
WHERE
	RegisterData.PaymentDate &lt;= &amp;EndOfPeriod
	AND &amp;DisplayPlannedRegisteredRecords
	AND &amp;OutputDSVPaths
	AND RegisterData.AmountType IN (VALUE(Enum.CashTransferKinds.CashDepositToBank),
		VALUE(Enum.CashTransferKinds.CashTransferToOtherAccount),
		VALUE(Enum.CashTransferKinds.CashCollectionFromBank_),
		VALUE(Enum.CashTransferKinds.TransferToAnotherCashAccount),
		VALUE(Enum.CashTransferKinds.CashReceiptFromBankByAcquiring))
{WHERE
	RegisterData.BusinessOperation.*,
	RegisterData.Organization.*,
	RegisterData.Department.*,
	RegisterData.BankAccountCashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccountCashAccount.* AS CashStorageLocation,
	(CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment)
			THEN VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_)
			THEN VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard)
			THEN VALUE(Enum.CashTypes.BankAcquirerCash)
	END).* AS CashType,
	RegisterData.CashFlowItem.*,
	RegisterData.Currency.*,
	RegisterData.LineOfBusiness.*,
	RegisterData.PayerBeneficiary.*,
	RegisterData.PayerBeneficiary.* AS CorDimension,
	RegisterData.PaymentObject.*,
	RegisterData.PlanningArea.*,
	RegisterData.PaymentObject.* AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, YEAR)}

UNION ALL

SELECT // DS on the way conversion
 RegisterData.PaymentObject AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, YEAR) AS YearPeriod,
	RegisterData.BusinessOperation AS BusinessOperation,
	RegisterData.Organization AS Organization,
	RegisterData.Department AS Department,
	UNDEFINED AS LineOfBusinessCash,
	UNDEFINED AS CashStorageLocation,
	CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment)
			THEN VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_)
			THEN VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard)
			THEN VALUE(Enum.CashTypes.BankAcquirerCash)
	END AS CashType,
	RegisterData.CashFlowItem AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.CorrespondingCurency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	RegisterData.PayerBeneficiary AS CorDimension,
	RegisterData.PaymentObject AS PaymentObject,
	RegisterData.LineOfBusiness AS LineOfBusiness,
	RegisterData.PlanningArea AS PlanningArea,
	0 AS SumPlanReceipt,
	CASE
		WHEN &amp;ReportData = 1
			THEN -RegisterData.DocumentAmount
		ELSE -RegisterData.DocumentAmount * CASE &amp;ReportData
			WHEN 1
				THEN 1
			WHEN 2
				THEN ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(ManSExchangeRate.CourseDenominator, 1) /
					(ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(ManSExchangeRate.CourseNumerator, 1))
			ELSE ISNULL(CurrencyExchangeRate.CourseNumerator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseDenominator, 1) /
				(ISNULL(CurrencyExchangeRate.CourseDenominator, 1) * ISNULL(LocalCurrencyExchangeRate.CourseNumerator, 1))
		END
	END AS SumPlanExpense,
	VALUE(Enum.CashFlowTypes.WriteOff) AS MovementType,
	
	TRUE AS TransitOfOperation
	
FROM
	InformationRegister.ScheduleOfPayments AS RegisterData
		LEFT JOIN ExchangeRates AS CurrencyExchangeRate
		ON CurrencyExchangeRate.Currency = RegisterData.Currency
		AND CurrencyExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
		LEFT JOIN ExchangeRates AS ManSExchangeRate
		ON ManSExchangeRate.Currency = &amp;ManagementAccountingCurrency
		AND ManSExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
		LEFT JOIN ExchangeRates AS LocalCurrencyExchangeRate
		ON LocalCurrencyExchangeRate.Currency = RegisterData.Organization.LocalAccountingCurrency
		AND LocalCurrencyExchangeRate.BaseCurrency = RegisterData.Organization.LocalAccountingCurrency
WHERE
	RegisterData.PaymentDate &lt;= &amp;EndOfPeriod
	AND &amp;DisplayPlannedRegisteredRecords
	AND &amp;OutputDSVPaths
	AND RegisterData.AmountType IN (VALUE(Enum.CashTransferKinds.ForeignExchangeBuying),
		VALUE(Enum.CashTransferKinds.ForeignExchangeSelling))
{WHERE
	RegisterData.BusinessOperation.*,
	RegisterData.Organization.*,
	RegisterData.Department.*,
	RegisterData.BankAccountCashAccount.LineOfBusiness.* AS LineOfBusinessCash,
	RegisterData.BankAccountCashAccount.* AS CashStorageLocation,
	(CASE RegisterData.PaymentMethod
		WHEN VALUE(Enum.PaymentForms.BankAccountPayment)
			THEN VALUE(Enum.CashTypes.BankAccountPayments_)
		WHEN VALUE(Enum.PaymentForms.CashAccountPayment_)
			THEN VALUE(Enum.CashTypes.CashPayment)
		WHEN VALUE(Enum.PaymentForms.PaymentCard)
			THEN VALUE(Enum.CashTypes.BankAcquirerCash)
	END).* AS CashType,
	RegisterData.CashFlowItem.*,
	RegisterData.Currency.*,
	RegisterData.LineOfBusiness.*,
	RegisterData.PayerBeneficiary.*,
	RegisterData.PayerBeneficiary.* AS CorDimension,
	RegisterData.PaymentObject.*,
	RegisterData.PlanningArea.*,
	RegisterData.PaymentObject.* AS Recorder,
	CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END AS SecondPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE
		WHEN RegisterData.PaymentDate &lt; &amp;CurrentDate
			THEN DATEADD(&amp;CurrentDate, DAY, -1)
		ELSE RegisterData.PaymentDate
	END, YEAR)}</query>
		</item>
	</dataSet>
