			<field xsi:type="DataSetFieldField">
				<dataPath>DayPeriod</dataPath>
				<field>DayPeriod</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Period day</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>دوره روز</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
