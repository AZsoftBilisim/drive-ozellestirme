    When (&amp;ReportData = 1 Or &amp;ReportData = 3)
        And (EvalExpression("Count(Distinct Currency)", "TimeIntervals.DynamicPeriod", "Group", "Previous", "Previous") &gt; 1
Or EvalExpression("Count(Distinct Currency)") &gt; 1)
    Then
    0
