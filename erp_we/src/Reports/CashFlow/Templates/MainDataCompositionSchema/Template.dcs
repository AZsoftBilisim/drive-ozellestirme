						<v8:content>Tipo di fondi monetari</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Typ środków pieniężnych</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Тип денежных средств</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Nakit tipi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Kiểu vốn bằng tiền</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Recorder</dataPath>
				<field>Recorder</field>
				<role>
					<dcscom:periodNumber>1</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Contract</dataPath>
				<field>Contract</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	Cash.Organization AS Organization,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN Cash.Organization.LocalAccountingCurrency
	END AS Currency,
	VALUE(Enum.CashTypes.BankAcquirerCash) AS CashType,
	Cash.CashTransferKind AS CashTransferKind,
	Cash.Sender AS Sender,
	Cash.Recipient AS Recipient,
	Cash.Counterparty AS Counterparty,
	Cash.Recorder AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.SumOpeningBalance
		WHEN 2
			THEN Cash.SumManOpeningBalance
		WHEN 3
			THEN Cash.SumComplOpeningBalance
	END AS SumOpeningBalance,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.SumClosingBalance
		WHEN 2
			THEN Cash.SumManClosingBalance
		WHEN 3
			THEN Cash.SumComplClosingBalance
	END AS SumClosingBalance
{SELECT
	Organization.*,
	Sender.*,
	Recipient.*,
	Counterparty.*,
	Currency.*,
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	SumOpeningBalance,
	SumClosingBalance}
FROM
	AccumulationRegister.CashInTransit.BalanceAndTurnovers(, , Auto, , CashTransferKind = VALUE(Enum.CashTransferKinds.CashReceiptFromBankByAcquiring) {(Organization).*, (CashTransferKind), (Recipient).*, (Sender).*, (Counterparty).*, (Currency).*}) AS Cash
WHERE
	&amp;OutputDSVPaths
{WHERE
	Cash.Recorder.*,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod}

UNION ALL

SELECT
	Cash.Organization,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.Currency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN Cash.Organization.LocalAccountingCurrency
	END,
	VALUE(Enum.CashTypes.CashInTransit),
	Cash.CashTransferKind,
	Cash.Sender,
	Cash.Recipient,
	Cash.Counterparty,
	Cash.Recorder,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.SumOpeningBalance
		WHEN 2
			THEN Cash.SumManOpeningBalance
		WHEN 3
			THEN Cash.SumComplOpeningBalance
	END,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.SumClosingBalance
		WHEN 2
			THEN Cash.SumManClosingBalance
		WHEN 3
			THEN Cash.SumComplClosingBalance
	END
FROM
	AccumulationRegister.CashInTransit.BalanceAndTurnovers(, , Auto, , CashTransferKind &lt;&gt; VALUE(Enum.CashTransferKinds.CashReceiptFromBankByAcquiring) {(Organization).*, (CashTransferKind), (Recipient).*, (Sender).*, (Counterparty).*, (Currency).*}) AS Cash
WHERE
	&amp;OutputDSVPaths
{WHERE
	Cash.Recorder.*,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod}</query>
		</item>
