			<dataSource>DataSource1</dataSource>
			<query>SELECT
	BusinessTransactionsSettings.BusinessOperation AS BusinessOperation
INTO OperationsReceipt
FROM
	Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
WHERE
	BusinessTransactionsSettings.DataSource = "RecordsCashCounterparty"
	AND BusinessTransactionsSettings.Receipt = VALUE(Enum.AccountingDataTypes.Cash)
;
////////////////////////////////////////////////////////////////////////////////

SELECT
	BusinessTransactionsSettings.BusinessOperation AS BusinessOperation
INTO OperationsExpense
FROM
	Catalog.BusinessTransactionsSettings AS BusinessTransactionsSettings
WHERE
	BusinessTransactionsSettings.DataSource = "RecordsCashCounterparty"
	AND BusinessTransactionsSettings.Expense = VALUE(Enum.AccountingDataTypes.Cash)
;
////////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.LineOfBusinessCash           AS LineOfBusinessCash,
	RegisterData.Cash                    AS CashStorageLocation,
	RegisterData.CashType                  AS CashType,
	RegisterData.CashFlowItem       AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.PaymentCurrency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.Counterparty                          AS CorDimension,
	
	RegisterData.CounterpartyLineOfBusiness  AS LineOfBusiness,
	RegisterData.Partner                             AS Partner,
	RegisterData.Counterparty                          AS Counterparty,
	RegisterData.Contract                             AS Contract,
	RegisterData.ARAPObject                      AS ARAPObject,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			RegisterData.PaymentAmountPaymentCurrencyTurnover
		WHEN 2 THEN
			RegisterData.PayAmountTurnover
		WHEN 3 THEN
			RegisterData.PaymentAmountLocalTurnover
	END AS SumReceipt,
	
	0                                                  AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.Inpayment) AS MovementType,
	FALSE AS TransitOfOperation
	
{SELECT
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	BusinessOperation.*,
	Organization.*,
	Department.*,
	LineOfBusinessCash.*,
	CashStorageLocation.*,
	CashType.*,
	CashFlowItem.*,
	Currency.*,
	CorDimension.*,
	LineOfBusiness.*,
	Partner.*,
	Counterparty.*,
	Contract.*,
	ARAPObject.*,
	SumReceipt,
	SumExpense}
FROM
	AccumulationRegister.RecordsCashCounterparty.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (SELECT OperationsReceipt.BusinessOperation FROM OperationsReceipt)
		AND CashType IN (
			VALUE(Enum.CashTypes.CashPayment),
			VALUE(Enum.CashTypes.BankAccountPayments_)
			)
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusinessCash.*}
		{Cash.* AS CashStorageLocation}
		{CashType.*}
		{CashFlowItem.*}
		{PaymentCurrency.* AS Currency}
		{CounterpartyLineOfBusiness.* AS LineOfBusiness}
		{Partner.*}
		{Counterparty.*}
		{Counterparty.* AS CorDimension}
		{Contract.*}
		{ARAPObject.*}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.LineOfBusinessCash           AS LineOfBusinessCash,
	RegisterData.Cash                    AS CashStorageLocation,
	RegisterData.CashType                  AS CashType,
	RegisterData.CashFlowItem       AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.PaymentCurrency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.Counterparty                          AS CorDimension,
	
	RegisterData.CounterpartyLineOfBusiness  AS LineOfBusiness,
	RegisterData.Partner                             AS Partner,
	RegisterData.Counterparty                          AS Counterparty,
	RegisterData.Contract                             AS Contract,
	RegisterData.ARAPObject                      AS ARAPObject,
	
	0                                                  AS SumReceipt,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			-RegisterData.PaymentAmountPaymentCurrencyTurnover
		WHEN 2 THEN
			-RegisterData.PayAmountTurnover
		WHEN 3 THEN
			-RegisterData.PaymentAmountLocalTurnover
	END AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.WriteOff) AS MovementType,
	FALSE AS TransitOfOperation
	
FROM
	AccumulationRegister.RecordsCashCounterparty.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (SELECT OperationsExpense.BusinessOperation FROM OperationsExpense)
		AND CashType IN (
			VALUE(Enum.CashTypes.CashPayment),
			VALUE(Enum.CashTypes.BankAccountPayments_)
			)
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusinessCash.*}
		{Cash.* AS CashStorageLocation}
		{CashType.*}
		{CashFlowItem.*}
		{PaymentCurrency.* AS Currency}
		{CounterpartyLineOfBusiness.* AS LineOfBusiness}
		{Partner.*}
		{Counterparty.*}
		{Counterparty.* AS CorDimension}
		{Contract.*}
		{ARAPObject.*}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT // Acquiring
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.LineOfBusinessCash           AS LineOfBusinessCash,
	UNDEFINED                                       AS CashStorageLocation,
	RegisterData.CashType                  AS CashType,
	RegisterData.CashFlowItem       AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.PaymentCurrency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,

	
	RegisterData.Counterparty                          AS CorDimension,
	
	RegisterData.CounterpartyLineOfBusiness  AS LineOfBusiness,
	RegisterData.Partner                             AS Partner,
	RegisterData.Counterparty                          AS Counterparty,
	RegisterData.Contract                             AS Contract,
	RegisterData.ARAPObject                      AS ARAPObject,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			RegisterData.PaymentAmountPaymentCurrencyTurnover
		WHEN 2 THEN
			RegisterData.PayAmountTurnover
		WHEN 3 THEN
			RegisterData.PaymentAmountLocalTurnover
	END AS SumReceipt,
	
	0                                                  AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.Inpayment) AS MovementType,
	FALSE AS TransitOfOperation
	
FROM
	AccumulationRegister.RecordsCashCounterparty.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (SELECT OperationsReceipt.BusinessOperation FROM OperationsReceipt)
		AND CashType IN (
			VALUE(Enum.CashTypes.BankAcquirerCash)
			)
		AND &amp;OutputDSVPaths
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusinessCash.*}
		{Cash.* AS CashStorageLocation}
		{CashType.*}
		{CashFlowItem.*}
		{PaymentCurrency.* AS Currency}
		{CounterpartyLineOfBusiness.* AS LineOfBusiness}
		{Partner.*}
		{Counterparty.*}
		{Counterparty.* AS CorDimension}
		{Contract.*}
		{ARAPObject.*}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}

UNION ALL

SELECT
	RegisterData.Recorder                         AS Recorder,
	
	RegisterData.SecondPeriod                       AS SecondPeriod,
	RegisterData.DayPeriod                          AS DayPeriod,
	RegisterData.WeekPeriod                        AS WeekPeriod,
	RegisterData.TenDaysPeriod                        AS TenDaysPeriod,
	RegisterData.MonthPeriod                         AS MonthPeriod,
	RegisterData.QuarterPeriod                       AS QuarterPeriod,
	RegisterData.HalfYearPeriod                     AS HalfYearPeriod,
	RegisterData.YearPeriod                           AS YearPeriod,
	
	RegisterData.BusinessOperation               AS BusinessOperation,
	RegisterData.Organization                         AS Organization,
	RegisterData.Department                       AS Department,
	RegisterData.LineOfBusinessCash           AS LineOfBusinessCash,
	UNDEFINED                                       AS CashStorageLocation,
	RegisterData.CashType                  AS CashType,
	RegisterData.CashFlowItem       AS CashFlowItem,
	CASE &amp;ReportData
		WHEN 1
			THEN RegisterData.PaymentCurrency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN RegisterData.Organization.LocalAccountingCurrency
	END AS Currency,
	
	RegisterData.Counterparty                          AS CorDimension,
	
	RegisterData.CounterpartyLineOfBusiness  AS LineOfBusiness,
	RegisterData.Partner                             AS Partner,
	RegisterData.Counterparty                          AS Counterparty,
	RegisterData.Contract                             AS Contract,
	RegisterData.ARAPObject                      AS ARAPObject,
	
	0                                                  AS SumReceipt,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			-RegisterData.PaymentAmountPaymentCurrencyTurnover
		WHEN 2 THEN
			-RegisterData.PayAmountTurnover
		WHEN 3 THEN
			-RegisterData.PaymentAmountLocalTurnover
	END AS SumExpense,
	
	VALUE(Enum.CashFlowTypes.WriteOff) AS MovementType,
	FALSE AS TransitOfOperation
	
FROM
	AccumulationRegister.RecordsCashCounterparty.Turnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Auto,
		BusinessOperation IN (SELECT OperationsExpense.BusinessOperation FROM OperationsExpense)
		AND CashType IN (
			VALUE(Enum.CashTypes.BankAcquirerCash)
			)
		AND &amp;OutputDSVPaths
		{BusinessOperation.*}
		{Organization.*}
		{Department.*}
		{LineOfBusinessCash.*}
		{Cash.* AS CashStorageLocation}
		{CashType.*}
		{CashFlowItem.*}
		{PaymentCurrency.* AS Currency}
		{CounterpartyLineOfBusiness.* AS LineOfBusiness}
		{Partner.*}
		{Counterparty.*}
		{Counterparty.* AS CorDimension}
		{Contract.*}
		{ARAPObject.*}
		) AS RegisterData
{WHERE
	RegisterData.Recorder.*,
	RegisterData.SecondPeriod,
	RegisterData.DayPeriod,
	RegisterData.WeekPeriod,
	RegisterData.TenDaysPeriod,
	RegisterData.MonthPeriod,
	RegisterData.QuarterPeriod,
	RegisterData.HalfYearPeriod,
	RegisterData.YearPeriod
}</query>
		</item>
		<item xsi:type="DataSetQuery">
