						<v8:content>Giao dịch đang chuyển</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Transit operation</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Transit operation</v8:content>
					</v8:item>
