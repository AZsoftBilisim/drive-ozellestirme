		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO ManSExchangeRate
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(
			&amp;DateOfCourse,
			Currency IN
				(SELECT
					Constants.ManagementAccountingCurrency
				FROM
					Constants AS Constants)
					AND BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AssignmentToSalesRepresentativeGoods.Ref AS Job,
	SUM(CASE
			WHEN AssignmentToSalesRepresentativeGoods.Ref.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Canceled)
					OR AssignmentToSalesRepresentativeGoods.Ref.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotPrepared2)
				THEN 0
			ELSE AssignmentToSalesRepresentativeGoods.NumberOfPackagesPlan * AssignmentToSalesRepresentativeGoods.Price
		END) AS SumPlan,
	SUM(CASE
			WHEN AssignmentToSalesRepresentativeGoods.Ref.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
					OR AssignmentToSalesRepresentativeGoods.Ref.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					OR AssignmentToSalesRepresentativeGoods.Ref.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
				THEN CASE
						WHEN AssignmentToSalesRepresentativeGoods.Price * AssignmentToSalesRepresentativeGoods.NumberOfPackagesPlan &gt; AssignmentToSalesRepresentativeGoods.Sum
							THEN AssignmentToSalesRepresentativeGoods.Price * AssignmentToSalesRepresentativeGoods.NumberOfPackagesPlan - AssignmentToSalesRepresentativeGoods.Sum
						ELSE 0
					END
			ELSE 0
		END) AS UnderproductionAmount,
	SUM(CASE
			WHEN AssignmentToSalesRepresentativeGoods.Ref.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
					OR AssignmentToSalesRepresentativeGoods.Ref.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					OR AssignmentToSalesRepresentativeGoods.Ref.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
				THEN CASE
						WHEN AssignmentToSalesRepresentativeGoods.Price * AssignmentToSalesRepresentativeGoods.NumberOfPackagesPlan &lt; AssignmentToSalesRepresentativeGoods.Sum
							THEN AssignmentToSalesRepresentativeGoods.Sum - AssignmentToSalesRepresentativeGoods.Price * AssignmentToSalesRepresentativeGoods.NumberOfPackagesPlan
						ELSE 0
					END
			ELSE 0
		END) AS OverproductionAmount
INTO TTDetailedTasks
FROM
	Document.JobForSalesRepresentative.Goods AS AssignmentToSalesRepresentativeGoods
WHERE
	AssignmentToSalesRepresentativeGoods.Ref.ItemsDetails
	AND NOT AssignmentToSalesRepresentativeGoods.Ref.DeletionMark
{WHERE
	(AssignmentToSalesRepresentativeGoods.Ref.PlannedVisitDate &gt;= &amp;BeginOfPeriod
				AND (AssignmentToSalesRepresentativeGoods.Ref.PlannedVisitDate &lt;= &amp;EndOfPeriod
					OR &amp;EndOfPeriod = &amp;DateEmpty)
			OR AssignmentToSalesRepresentativeGoods.Ref.ActualVisitDate &gt;= &amp;BeginOfPeriod
				AND (AssignmentToSalesRepresentativeGoods.Ref.ActualVisitDate &lt;= &amp;EndOfPeriod
					OR &amp;EndOfPeriod = &amp;DateEmpty))}

GROUP BY
	AssignmentToSalesRepresentativeGoods.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	JobForSalesRepresentative.SalesRepresentative AS SalesRepresentative,
	SUM(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					AND JobForSalesRepresentative.ActualVisitDate &gt;= &amp;BeginOfPeriod
					AND (JobForSalesRepresentative.ActualVisitDate &lt;= &amp;EndOfPeriod
						OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN CASE
						WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
							THEN JobForSalesRepresentative.DocumentAmount
						ELSE JobForSalesRepresentative.DocumentAmount * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
					END
			ELSE 0
		END) AS AmountOfCompletedTasks,
	COUNT(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					AND JobForSalesRepresentative.ActualVisitDate &gt;= &amp;BeginOfPeriod
					AND (JobForSalesRepresentative.ActualVisitDate &lt;= &amp;EndOfPeriod
						OR &amp;EndOfPeriod = &amp;DateEmpty)
					AND JobForSalesRepresentative.ActualVisitDate &lt;&gt; &amp;DateEmpty
				THEN JobForSalesRepresentative.Ref
			ELSE NULL
		END) AS NumberOfCompletedTasks,
	COUNT(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
					AND JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
					AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
						OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN JobForSalesRepresentative.Ref
			ELSE NULL
		END) AS NumberOfUnprocessedTasks,
	COUNT(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					AND JobForSalesRepresentative.ActualVisitDate &gt; JobForSalesRepresentative.PlannedVisitDate
					AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
						OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN JobForSalesRepresentative.Ref
			ELSE NULL
		END) AS NumberOfTasksCompletedAfterDeadline,
	SUM(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
					AND JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
					AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
						OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN CASE
						WHEN JobForSalesRepresentative.ItemsDetails
							THEN CASE
									WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
										THEN DetailedTasks.SumPlan
									ELSE DetailedTasks.SumPlan * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
								END
						ELSE CASE
								WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
									THEN JobForSalesRepresentative.SumPlan
								ELSE JobForSalesRepresentative.SumPlan * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
							END
					END
			ELSE 0
		END) AS AmountOfTasksNotCompleted,
	AVG(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					AND JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
					AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
						OR &amp;EndOfPeriod = &amp;DateEmpty)
					AND JobForSalesRepresentative.ActualVisitDate &lt;&gt; &amp;DateEmpty
				THEN CASE
						WHEN JobForSalesRepresentative.ActualVisitDate &gt; JobForSalesRepresentative.PlannedVisitDate
							THEN DATEDIFF(JobForSalesRepresentative.PlannedVisitDate, JobForSalesRepresentative.ActualVisitDate, DAY)
						ELSE CASE
								WHEN JobForSalesRepresentative.ActualVisitDate = &amp;DateEmpty
									THEN DATEDIFF(JobForSalesRepresentative.PlannedVisitDate, &amp;EndOfPeriod, DAY)
								ELSE NULL
							END
					END
			ELSE NULL
		END) AS AverageNumberOfDaysOverdue,
	SUM(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
						AND JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
						AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
							OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN CASE
						WHEN JobForSalesRepresentative.ItemsDetails
							THEN CASE
									WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
										THEN DetailedTasks.SumPlan
									ELSE DetailedTasks.SumPlan * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
								END
						ELSE CASE
								WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
									THEN JobForSalesRepresentative.SumPlan
								ELSE JobForSalesRepresentative.SumPlan * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
							END
					END
			ELSE 0
		END) AS SumPlan,
	SUM(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
						AND JobForSalesRepresentative.ActualVisitDate &gt;= &amp;BeginOfPeriod
						AND (JobForSalesRepresentative.ActualVisitDate &lt;= &amp;EndOfPeriod
							OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN CASE
						WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
							THEN JobForSalesRepresentative.DocumentAmount
						ELSE JobForSalesRepresentative.DocumentAmount * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
					END
			ELSE 0
		END) AS SumReal,
	SUM(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
						AND JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
						AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
							OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN CASE
						WHEN JobForSalesRepresentative.ItemsDetails
							THEN CASE
									WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
										THEN DetailedTasks.UnderproductionAmount
									ELSE DetailedTasks.UnderproductionAmount * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
								END
						ELSE CASE
								WHEN JobForSalesRepresentative.SumPlan &gt; JobForSalesRepresentative.DocumentAmount
									THEN CASE
											WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
												THEN JobForSalesRepresentative.SumPlan - JobForSalesRepresentative.DocumentAmount
											ELSE (JobForSalesRepresentative.SumPlan - JobForSalesRepresentative.DocumentAmount) * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
										END
								ELSE 0
							END
					END
			ELSE 0
		END) AS UnderproductionAmount,
	SUM(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
						AND JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
						AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
							OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN CASE
						WHEN JobForSalesRepresentative.ItemsDetails
							THEN CASE
									WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
										THEN DetailedTasks.OverproductionAmount
									ELSE DetailedTasks.OverproductionAmount * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
								END
						ELSE CASE
								WHEN JobForSalesRepresentative.SumPlan &lt; JobForSalesRepresentative.DocumentAmount
									THEN CASE
											WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
												THEN JobForSalesRepresentative.DocumentAmount - JobForSalesRepresentative.SumPlan
											ELSE (JobForSalesRepresentative.DocumentAmount - JobForSalesRepresentative.SumPlan) * (CurrencyRatesCut.CourseNumerator * ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
										END
								ELSE 0
							END
					END
			ELSE 0
		END) AS OverproductionAmount,
	COUNT(CASE
			WHEN JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.ToProcessing)
					OR JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.NotProcessed_)
						AND JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
						AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
							OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN JobForSalesRepresentative.Ref
			ELSE NULL
		END) AS NumberOfOverdueUnprocessedTasks,
	COUNT(CASE
			WHEN JobForSalesRepresentative.Status &lt;&gt; VALUE(Enum.SalesRepresentativeTaskStatuses.Canceled)
					AND JobForSalesRepresentative.Status &lt;&gt; VALUE(Enum.SalesRepresentativeTaskStatuses.NotPrepared2)
					AND JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
					AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
						OR &amp;EndOfPeriod = &amp;DateEmpty)
				THEN JobForSalesRepresentative.Ref
			ELSE NULL
		END) AS NumberOfPlannedJobs,
	COUNT(DISTINCT CASE
			WHEN JobForSalesRepresentative.ActualVisitDate &gt;= &amp;BeginOfPeriod
					AND (JobForSalesRepresentative.ActualVisitDate &lt;= &amp;EndOfPeriod
						OR &amp;EndOfPeriod = &amp;DateEmpty)
					AND JobForSalesRepresentative.ActualVisitDate &lt;&gt; &amp;DateEmpty
					AND JobForSalesRepresentative.Status = VALUE(Enum.SalesRepresentativeTaskStatuses.Processed_)
				THEN JobForSalesRepresentative.ActualVisitDate
			ELSE NULL
		END) AS NumberOfDaysWorked
FROM
	Document.JobForSalesRepresentative AS JobForSalesRepresentative
		LEFT JOIN TTDetailedTasks AS DetailedTasks
		ON JobForSalesRepresentative.Ref = DetailedTasks.Job
		LEFT JOIN ManSExchangeRate AS ManSExchangeRate
		ON (TRUE)
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;DateOfCourse, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
		ON JobForSalesRepresentative.Currency = CurrencyRatesCut.Currency
WHERE
	NOT JobForSalesRepresentative.DeletionMark
	AND JobForSalesRepresentative.Status &lt;&gt; VALUE(Enum.SalesRepresentativeTaskStatuses.NotPrepared2)
{WHERE
	(JobForSalesRepresentative.PlannedVisitDate &gt;= &amp;BeginOfPeriod
				AND (JobForSalesRepresentative.PlannedVisitDate &lt;= &amp;EndOfPeriod
					OR &amp;EndOfPeriod = &amp;DateEmpty)
			OR JobForSalesRepresentative.ActualVisitDate &gt;= &amp;BeginOfPeriod
				AND (JobForSalesRepresentative.ActualVisitDate &lt;= &amp;EndOfPeriod
					OR &amp;EndOfPeriod = &amp;DateEmpty))}

GROUP BY
	JobForSalesRepresentative.SalesRepresentative</query>
	</dataSet>
	<calculatedField>
		<dataPath>JobsProcessingPercentage</dataPath>
		<expression>Case When NumberOfPlannedJobs = 0 Then NULL Else NumberOfCompletedTasks/NumberOfPlannedJobs * 100 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
