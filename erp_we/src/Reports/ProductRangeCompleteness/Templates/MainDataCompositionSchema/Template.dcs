		<field xsi:type="DataSetFieldField">
			<dataPath>PlanningObject</dataPath>
			<field>PlanningObject</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TypesOfPrices.Ref AS PriceKind
INTO PermittedTypesOfPrices
FROM
	Catalog.TypesOfPrices AS TypesOfPrices
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProductRange.PlanningObject AS StoreFormat,
	ProductRange.Products.ProductKind AS ProductKind,
	ProductRange.Products.ProductCategory AS ProductCategory,
	ProductRange.Products AS Products,
	1 AS NumberOfRows,
	ProductRange.ProductRangeRole AS ProductRangeRole,
	CASE
		WHEN ProductRange.Products IS NULL 
			THEN VALUE(Enum.ProductRangePhases.EmptyRef)
		WHEN ProductRange.SalesAreAllowed
				AND ProductRange.PurchasesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.PurchasesAndSalesArePermitted)
		WHEN ProductRange.SalesAreAllowed
				AND NOT ProductRange.PurchasesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.OnlySalesAreAllowed)
		WHEN ProductRange.PurchasesAreAllowed
				AND NOT ProductRange.SalesAreAllowed
			THEN VALUE(Enum.ProductRangePhases.OnlyPurchasesAreAllowed)
		ELSE VALUE(Enum.ProductRangePhases.SalesAndPurchasesAreProhibited)
	END AS ProductRangePhase,
	ISNULL(ProductRange.PriceKind, VALUE(Catalog.TypesOfPrices.EmptyRef)) AS PriceKind,
	ProductRange.Recorder AS Recorder
FROM
	InformationRegister.ProductRange.SliceLast(ENDOFPERIOD(&amp;Period, DAY), ) AS ProductRange
		INNER JOIN PermittedTypesOfPrices AS PermittedTypesOfPrices
		ON (PermittedTypesOfPrices.PriceKind = ProductRange.PriceKind)</query>
	</dataSet>
	<totalField>
		<dataPath>ProductRangeRole</dataPath>
		<expression>ProductRangeRole</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>ProductRangePhase</dataPath>
		<expression>ProductRangePhase</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>NumberOfRows</dataPath>
		<expression>Count(Distinct Products)</expression>
		<group>ProductKind</group>
		<group>ProductKind Hierarchy</group>
		<group>Products Hierarchy</group>
		<group>ProductCategory</group>
		<group>ProductCategory Hierarchy</group>
		<group>StoreFormat</group>
		<group>StoreFormat Hierarchy</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>PriceKind</dataPath>
		<expression>PriceKind</expression>
		<group>Products</group>
	</totalField>
