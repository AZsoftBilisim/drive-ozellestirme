				<dataPath>ProductsWeight</dataPath>
				<field>ProductsWeight</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ProductsVolume</dataPath>
				<field>ProductsVolume</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>VendorPriceKind</dataPath>
				<field>VendorPriceKind</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>BaseCurrency</dataPath>
				<field>BaseCurrency</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Country</dataPath>
				<field>Country</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	ExchangeRates.Currency,
	ExchangeRates.CourseNumerator,
	ExchangeRates.CourseDenominator
	
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast({&amp;EndOfPeriod}, BaseCurrency = &amp;BaseCurrency) AS ExchangeRates
WHERE
	ExchangeRates.CourseNumerator &lt;&gt; 0
	AND ExchangeRates.CourseDenominator &lt;&gt; 0
;
///////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	InventoryKinds.Ref AS InventoryOwnerAttribute
	
INTO TypesOfStocksCommission
FROM
	Catalog.InventoryKinds AS InventoryKinds
WHERE
	InventoryKinds.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
	AND NOT InventoryKinds.SaleOfAnotherCompanyInventory
	AND InventoryKinds.GoodsOwner REFS Catalog.Partners
	
UNION ALL

SELECT
	InventoryKinds.Ref AS InventoryOwnerAttribute
FROM
	Catalog.InventoryKinds AS InventoryKinds
WHERE
	InventoryKinds.SaleOfAnotherCompanyInventory
	AND InventoryKinds.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
;
///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.Organization,
	Dimension.Products,
	Dimension.Characteristic,
	Dimension.Series,
	Dimension.Purpose,
	CompanyGoods.CCDNumber,
	CompanyGoods.InventoryOwnerAttribute,
	CompanyGoods.InventoryOwnerAttribute.Terms AS Terms,
	
	CASE WHEN NOT ISNULL(CompanyGoods.InventoryOwnerAttribute.Terms.PriceIncludesVAT, FALSE)
		AND CompanyGoods.InventoryOwnerAttribute.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
	THEN
		((ISNULL(ProductsVATRates.VATRate, ISNULL(VATRatesForEmptyCountryProducts.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef))))).Rate1 + 100) / 100
	ELSE
		1
	END VATRate_2,
	
	ISNULL(ExchangeRates.CourseNumerator, 0) AS CourseNumerator,
	ISNULL(ExchangeRates.CourseDenominator, 0) AS CourseDenominator,
	
	CompanyGoods.CountBalance AS CountBalance
	
INTO CompanyGoods 			
FROM
	AccumulationRegister.CompanyGoods.Balance({&amp;EndOfPeriod},
		InventoryOwnerAttribute IN 
			(SELECT
				InventoryOwnerAttribute
			FROM
				TypesOfStocksCommission AS TypesOfStocksCommission)
		) AS CompanyGoods

	LEFT JOIN
		ExchangeRates AS ExchangeRates
	ON
		CompanyGoods.InventoryOwnerAttribute.Currency = ExchangeRates.Currency
	
	LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(&amp;EndOfPeriod)}) AS ProductsVATRates
	ON CompanyGoods.ItemsLocationAttributes.Products = ProductsVATRates.Products
		AND CompanyGoods.Organization.RegistrationCountry = ProductsVATRates.Country
	LEFT JOIN InformationRegister.BasicVATRates.SliceLast({(&amp;EndOfPeriod)}) AS BasicVATRates
	ON CompanyGoods.Organization.RegistrationCountry = BasicVATRates.Country
	LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(&amp;EndOfPeriod)}, Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS VATRatesForEmptyCountryProducts
	ON CompanyGoods.ItemsLocationAttributes.Products = VATRatesForEmptyCountryProducts.Products
	
	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	ON CompanyGoods.ItemsLocationAttributes = Dimension.Ref
	{WHERE
		Dimension.Products.* AS Products,
		Dimension.Characteristic.* AS Characteristic,
		(
			InventoryOwnerAttribute.GoodsOwner IN 
				(SELECT
					SelectionByPartnerSegment.Partner
				FROM
					SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed),
			(Dimension.Products, Dimension.Characteristic) IN 
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)
		)
	}

UNION ALL

SELECT
	InventoryKinds.Organization AS Organization,
	Dimension.Products,
	Dimension.Characteristic,
	Dimension.Series,
	Dimension.Purpose,
	GoodsTransferred.CCDNumber,
	InventoryKinds.Ref AS InventoryOwnerAttribute,
	InventoryKinds.Terms AS Terms,
	
	CASE WHEN NOT ISNULL(InventoryKinds.Terms.PriceIncludesVAT, FALSE)
		AND InventoryKinds.VATTaxation = VALUE(Enum.VATTaxationTypes.SaleIsSubjectToVAT)
	THEN
		((ISNULL(ProductsVATRates.VATRate, ISNULL(VATRatesForEmptyCountryProducts.VATRate, ISNULL(BasicVATRates.VATRate, VALUE(Catalog.VATRates.EmptyRef))))).Rate1 + 100) / 100
	ELSE
		1
	END VATRate_2,
	
	ISNULL(ExchangeRates.CourseNumerator, 0) AS CourseNumerator,
	ISNULL(ExchangeRates.CourseDenominator, 0) AS CourseDenominator,
	
	GoodsTransferred.CountBalance AS CountBalance
FROM
	AccumulationRegister.GoodsTransferredToCommissionAgent.Balance({&amp;EndOfPeriod},
		InventoryOwnerAttribute IN (
			SELECT
				InventoryOwnerAttribute
			FROM
				TypesOfStocksCommission AS TypesOfStocksCommission)
			)  AS GoodsTransferred
		
	INNER JOIN
		Catalog.InventoryKinds AS InventoryKinds
	ON
		(GoodsTransferred.InventoryOwnerAttribute = InventoryKinds.Ref
		AND NOT GoodsTransferred.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory)
		OR
		(GoodsTransferred.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner = InventoryKinds.Ref
		AND GoodsTransferred.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory)
	
	LEFT JOIN
		ExchangeRates AS ExchangeRates
	ON
		InventoryKinds.Currency = ExchangeRates.Currency

	LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(&amp;EndOfPeriod)}) AS ProductsVATRates
	ON GoodsTransferred.ItemsLocationAttributes.Products = ProductsVATRates.Products
		AND GoodsTransferred.Organization.RegistrationCountry = ProductsVATRates.Country
	LEFT JOIN InformationRegister.BasicVATRates.SliceLast({(&amp;EndOfPeriod)}) AS BasicVATRates
	ON GoodsTransferred.Organization.RegistrationCountry = BasicVATRates.Country
	LEFT JOIN InformationRegister.ProductsVATRates.SliceLast({(&amp;EndOfPeriod)}, Country = VALUE(Catalog.WorldCountries.EmptyRef)) AS VATRatesForEmptyCountryProducts
	ON GoodsTransferred.ItemsLocationAttributes.Products = VATRatesForEmptyCountryProducts.Products

	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	ON GoodsTransferred.ItemsLocationAttributes = Dimension.Ref
	{WHERE
		Dimension.Products.* AS Products,
		Dimension.Characteristic.* AS Characteristic,
		(
			GoodsTransferred.InventoryOwnerAttribute.GoodsOwner IN (
				SELECT
					SelectionByPartnerSegment.Partner
				FROM
					SelectionByPartnerSegment
				WHERE
					SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed),
			(Dimension.Products, Dimension.Characteristic) IN (
				SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)
		)
	}
;
///////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	ItemsPrices.VendorPriceKind,
	ItemsPrices.Products,
	ItemsPrices.Characteristic,
	ItemsPrices.Currency,
	
	CASE WHEN NOT &amp;QueryTextPackagingFactor IS NULL
		AND &amp;QueryTextPackagingFactor &lt;&gt; 0
	THEN
		ItemsPrices.Price / &amp;QueryTextPackagingFactor
	ELSE
		ItemsPrices.Price
	END AS Price

INTO ItemsPrices
FROM	
	InformationRegister.ItemsPricesOfVendor.SliceLast({ENDOFPERIOD(&amp;EndOfPeriod, DAY)},
		(Products, Characteristic) IN (
			SELECT
				CompanyGoods.Products,
				CompanyGoods.Characteristic
			FROM
				CompanyGoods AS CompanyGoods
			)
	) AS ItemsPrices
;
///////////////////////////////////////////////////////////////////////////////

SELECT ALLOWED
	CompanyGoods.Organization,
	CompanyGoods.Products,
	CompanyGoods.Products.UnitOfMeasure AS StorageUnit,
	CompanyGoods.Products.UnitForReports AS UnitForReports,
	CompanyGoods.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	CompanyGoods.Characteristic,
	CompanyGoods.InventoryOwnerAttribute,
	
	CompanyGoods.InventoryOwnerAttribute.GoodsOwner AS Consignor,
	CompanyGoods.InventoryOwnerAttribute.Terms AS Terms,
	CompanyGoods.InventoryOwnerAttribute.Currency AS Currency,
	
	CompanyGoods.CountBalance AS CountBalance,
	(
	CASE WHEN ISNULL(ItemsPrices.Price, 0) = 0 THEN
		0
	WHEN (ISNULL(ExchangeRates.CourseNumerator, 0) * CompanyGoods.CourseDenominator) = (ISNULL(ExchangeRates.CourseDenominator, 1) * CompanyGoods.CourseNumerator) THEN
		ItemsPrices.Price
	WHEN (ISNULL(ExchangeRates.CourseDenominator, 1) * CompanyGoods.CourseNumerator) = 0 THEN
		0
	ELSE
		CAST(
			(ISNULL(ExchangeRates.CourseNumerator, 0) * CompanyGoods.CourseDenominator)
			/ (ISNULL(ExchangeRates.CourseDenominator, 1) * CompanyGoods.CourseNumerator)
			* ISNULL(ItemsPrices.Price, 0)
		AS NUMBER(31,2)
		)
	END
	* CompanyGoods.VATRate_2
	) AS Price,
	(
	CASE WHEN ISNULL(ItemsPrices.Price, 0) = 0 THEN
		0
	WHEN (ISNULL(ExchangeRates.CourseNumerator, 0) * CompanyGoods.CourseDenominator) = (ISNULL(ExchangeRates.CourseDenominator, 1) * CompanyGoods.CourseNumerator) THEN
		ItemsPrices.Price
	WHEN (ISNULL(ExchangeRates.CourseDenominator, 1) * CompanyGoods.CourseNumerator) = 0 THEN
		0
	ELSE
		CAST(
			(ISNULL(ExchangeRates.CourseNumerator, 0) * CompanyGoods.CourseDenominator)
			/ (ISNULL(ExchangeRates.CourseDenominator, 1) * CompanyGoods.CourseNumerator)
			* ISNULL(ItemsPrices.Price, 0)
		AS NUMBER(31,2)
		)
	END
	* CompanyGoods.VATRate_2
	* CompanyGoods.CountBalance
	) AS SumBalance,
	
	ISNULL(DatesOfCompanyGoodsReceipt.DateOfReceipt, DATETIME(1,1,1)) AS DateOfReceipt,
	DATEDIFF(DatesOfCompanyGoodsReceipt.DateOfReceipt, &amp;CurrentDate, DAY) AS DaysCount
FROM
	CompanyGoods AS CompanyGoods	
	
	LEFT JOIN
		ItemsPrices AS ItemsPrices
	ON
		CompanyGoods.Products = ItemsPrices.Products
		AND CompanyGoods.Characteristic = ItemsPrices.Characteristic
		AND CompanyGoods.Terms.VendorPriceKind = ItemsPrices.VendorPriceKind
		
	LEFT JOIN
		ExchangeRates AS ExchangeRates
	ON
		ItemsPrices.Currency = ExchangeRates.Currency
		
	{	
	LEFT JOIN
		InformationRegister.DatesOfCompanyGoodsReceipt AS DatesOfCompanyGoodsReceipt
	ON
		CompanyGoods.Products = DatesOfCompanyGoodsReceipt.Products
		AND CompanyGoods.Characteristic = DatesOfCompanyGoodsReceipt.Characteristic
		AND CompanyGoods.Series = DatesOfCompanyGoodsReceipt.Series
		AND CompanyGoods.Purpose = DatesOfCompanyGoodsReceipt.Purpose
		AND CompanyGoods.InventoryOwnerAttribute = DatesOfCompanyGoodsReceipt.InventoryOwnerAttribute
		AND CompanyGoods.CCDNumber = DatesOfCompanyGoodsReceipt.CCDNumber 
	}
</query>
		</item>
