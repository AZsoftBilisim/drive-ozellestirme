	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        StorageUnit
    When &amp;QuantityUnits = 1 Then
        UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>DateOfReceipt</dataPath>
		<expression>Max(DateOfReceipt)</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>DaysCount</dataPath>
		<expression>Max(DaysCount)</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>CountBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(CountBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumBalance</dataPath>
		<expression>Sum(SumBalance)</expression>
		<group>Currency</group>
		<group>Terms</group>
	</totalField>
	<totalField>
		<dataPath>RevenueAmountBalance</dataPath>
		<expression>Sum(RevenueAmountBalance)</expression>
		<group>Currency</group>
		<group>Terms</group>
	</totalField>
	<totalField>
		<dataPath>QuantityToRegisterBalance</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantityToRegisterBalance)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Max(Price)</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>QuantityToRegisterBalanceWeight</dataPath>
		<expression>Sum(QuantityToRegisterBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityToRegisterBalanceVolume</dataPath>
		<expression>Sum(QuantityToRegisterBalanceVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityBalanceWeight</dataPath>
		<expression>Sum(QuantityBalanceWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityBalanceVolume</dataPath>
		<expression>Sum(QuantityBalanceVolume)</expression>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Okres</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">ThisMonth</v8:variant>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>EndOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cuối kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>Case When &amp;Period.EndDate = DateTime(1,1,1) Then &amp;Period.EndDate Else DateAdd(&amp;Period.EndDate, "Second", 1) End</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>CurrentDatePeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Current date period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره تاریخ جاری</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
