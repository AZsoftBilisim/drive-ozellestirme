			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

///////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsForRegistration.InventoryOwnerAttribute.Organization AS Organization,
	GoodsForRegistration.Currency,
	Dimension.Products,
	Dimension.Products.UnitOfMeasure AS StorageUnit,
	Dimension.Products.UnitForReports AS UnitForReports,
	Dimension.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	Dimension.Characteristic,
	GoodsForRegistration.InventoryOwnerAttribute.GoodsOwner AS Consignor,
	GoodsForRegistration.InventoryOwnerAttribute.Terms AS Terms,
	
	GoodsForRegistration.RevenueAmountBalance AS RevenueAmountBalance,
	GoodsForRegistration.CountBalance
	+ GoodsForRegistration.QuantityConsumedBalance AS QuantityToRegisterBalance
FROM
	AccumulationRegister.GoodsToBeRegisteredInReportsToConsignor.Balance({&amp;EndOfPeriod},) AS GoodsForRegistration
	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	ON GoodsForRegistration.ItemsLocationAttributes = Dimension.Ref
	{WHERE
		Dimension.Products.* AS Products,
		Dimension.Characteristic.* AS Characteristic,
		InventoryOwnerAttribute.GoodsOwner REFS Catalog.Partners,
		((Dimension.Products, Dimension.Characteristic) IN 
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)
			),
		(InventoryOwnerAttribute.GoodsOwner IN 
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)
			)
		}
	</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>CountBalance</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		CountBalance
	When &amp;QuantityUnits = 1 Then
		CountBalance / UnitFactorForReports
End</expression>
