		<field xsi:type="DataSetFieldField">
			<dataPath>ThereIsSecurityDelay</dataPath>
			<field>ThereIsSecurityDelay</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>There is a delay in supply</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تأخیر در تأمین وجود دارد</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Есть задержка обеспечения</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Tedarik gecikmesi var</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>There is a delay in supply</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>There is a delay in supply</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>There is a delay in supply</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RegisterRecords.Products AS Products,
	RegisterRecords.Characteristic AS Characteristic,
	RegisterRecords.Warehouse AS Warehouse,
	RegisterRecords.Purpose AS Purpose,
	RegisterRecords.ProductionOrder AS ProductionOrder,
	RegisterRecords.ProductionOrder.LineOfBusiness AS LineOfBusiness,
	RegisterRecords.Stage AS Stage,
	RegisterRecords.BillOfMaterials AS BillOfMaterials,
	RegisterRecords.Department AS Department,
	MAX(CASE
				WHEN Schedule.Begin &lt; &amp;CurrentDate
					THEN TRUE
				ELSE FALSE
			END) AS ThereIsSecurityDelay,
	SUM(RegisterRecords.ToSupply - RegisterRecords.Replaced) AS Count,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.DAY)
			THEN Schedule.Begin
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(Schedule.Begin, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(Schedule.Begin, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(Schedule.Begin, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(Schedule.Begin, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(Schedule.Begin, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(Schedule.Begin, YEAR)
	END AS DemandDate,
	RegisterRecords.DurationBeforeProductionIssue AS DurationBeforeProductionIssue
{SELECT
	Products.*,
	Characteristic.*,
	Warehouse.*,
	Purpose,
	ProductionOrder.*,
	LineOfBusiness.*,
	Stage.*,
	BillOfMaterials.*,
	Department.*,
	Count,
	DemandDate,
	DurationBeforeProductionIssue}
FROM
	InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	
	LEFT JOIN InformationRegister.OrderStructure AS RegisterRecords
	ON Schedule.KeyLot          = RegisterRecords.KeyLot
	 AND Schedule.Stage                = RegisterRecords.Stage
WHERE
	Schedule.Begin BETWEEN &amp;StartDate AND &amp;EndDate
	AND RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
	AND TRUE NOT IN
			(SELECT TOP 1
				TRUE
			FROM
				InformationRegister.OrderStructure AS Transfers
			WHERE
				RegisterRecords.KeyLot = Transfers.KeyLot
				AND Transfers.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Move))
	AND CASE
		WHEN NOT &amp;ToExcludeSemiFinishedProducts OR TRUE NOT IN
				(SELECT TOP 1
					TRUE
				FROM 
					InformationRegister.CacheOfOrderStructureMasterData AS NSICache
				WHERE
					RegisterRecords.ProductionOrder = NSICache.ProductionOrder
					AND RegisterRecords.Products      = NSICache.Products
					AND RegisterRecords.Characteristic    = NSICache.Characteristic
					AND NSICache.SupplyType = VALUE(Enum.SupplyTypes.Production))
			THEN TRUE
		ELSE FALSE
	END
	
GROUP BY
	RegisterRecords.Products,
	RegisterRecords.Characteristic,
	RegisterRecords.Warehouse,
	RegisterRecords.Purpose,
	RegisterRecords.ProductionOrder,
	RegisterRecords.ProductionOrder.LineOfBusiness,
	RegisterRecords.Stage,
	RegisterRecords.BillOfMaterials,
	RegisterRecords.Department,
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.DAY)
			THEN Schedule.Begin
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(Schedule.Begin, WEEK)
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(Schedule.Begin, TENDAYS)
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(Schedule.Begin, MONTH)
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(Schedule.Begin, QUARTER)
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(Schedule.Begin, HALFYEAR)
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(Schedule.Begin, YEAR)
	END,
	RegisterRecords.DurationBeforeProductionIssue

HAVING
	SUM(RegisterRecords.ToSupply - RegisterRecords.Replaced) &gt; 0
	
{WHERE
	Products.* AS Products,
	Characteristic.* AS Characteristic,
	Warehouse.* AS Warehouse,
	Purpose AS Purpose,
	RegisterRecords.ProductionOrder.* AS ProductionOrder,
	RegisterRecords.ProductionOrder.LineOfBusiness.* AS LineOfBusiness,
	RegisterRecords.Stage.*,
	RegisterRecords.BillOfMaterials.*,
	RegisterRecords.Department.* AS Department,
	RegisterRecords.ToSupply - RegisterRecords.Replaced AS Count,
	DurationBeforeProductionIssue AS DurationBeforeProductionIssue}
</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<totalField>
		<dataPath>ThereIsSecurityDelay</dataPath>
		<expression>Max(ThereIsSecurityDelay)</expression>
	</totalField>
