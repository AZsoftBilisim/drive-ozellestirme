				<field>SumClosingBalance</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CashStorageLocation</dataPath>
				<field>CashStorageLocation</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Cash storage location</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>محل نگهداری وجه نقد</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Luogo di deposito dei fondi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Miejsce przechowywania środków pieniężnych</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Место хранения денежных средств</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Nakit saklama yeri</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Nơi lưu trữ tiền</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CashType</dataPath>
				<field>CashType</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Cash type</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>نوع وجه نقد</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Tipo di fondi monetari</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Typ środków pieniężnych</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Тип денежных средств</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Nakit tipi</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Kiểu vốn bằng tiền</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	Cash.Organization AS Organization,
	Cash.BankAccount AS CashStorageLocation,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.BankAccount.CashCurrency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN Cash.Organization.LocalAccountingCurrency
	END AS Currency,
	VALUE(Enum.CashTypes.BankAccountPayments_) AS CashType,
	CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END AS Recorder,
	Cash.SecondPeriod AS SecondPeriod,
	Cash.DayPeriod AS DayPeriod,
	Cash.WeekPeriod AS WeekPeriod,
	Cash.TenDaysPeriod AS TenDaysPeriod,
	Cash.MonthPeriod AS MonthPeriod,
	Cash.QuarterPeriod AS QuarterPeriod,
	Cash.HalfYearPeriod AS HalfYearPeriod,
	Cash.YearPeriod AS YearPeriod,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.SumOpeningBalance
		WHEN 2
			THEN Cash.SumManOpeningBalance
		WHEN 3
			THEN Cash.SumComplOpeningBalance
	END AS SumOpeningBalance,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.SumReceipt
		WHEN 2
			THEN Cash.SumManReceipt
		WHEN 3
			THEN Cash.SumComplReceipt
	END AS SumReceipt,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.SumExpense
		WHEN 2
			THEN Cash.SumManExpense
		WHEN 3
			THEN Cash.SumComplExpense
	END AS SumExpense,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.SumClosingBalance
		WHEN 2
			THEN Cash.SumManClosingBalance
		WHEN 3
			THEN Cash.SumComplClosingBalance
	END AS SumClosingBalance
{SELECT
	Organization.*,
	CashStorageLocation.*,
	Currency.*,
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	SumOpeningBalance,
	SumReceipt,
	SumExpense,
	SumClosingBalance}
FROM
	AccumulationRegister.BankAccountCash.BalanceAndTurnovers(, , Auto, , {(Organization).*, (BankAccount).* AS CashStorageLocation}) AS Cash
{WHERE
	Cash.BankAccount.CashCurrency.* AS Currency,
	(CASE
			WHEN Cash.Recorder = UNDEFINED
				THEN NULL
			ELSE Cash.Recorder
		END).* AS Recorder,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod}</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>CashPayment</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Organization</dataPath>
