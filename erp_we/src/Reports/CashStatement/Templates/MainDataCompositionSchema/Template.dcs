			<field xsi:type="DataSetFieldField">
				<dataPath>SumExpense</dataPath>
				<field>SumExpense</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Amount expense</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>مبلغ هزینه</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Importo uscita</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Wartość kosztu</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Сумма расход</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Gider tutarı</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Số tiền chi</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	Cash.Organization                         AS Organization,
	Cash.CashRegister                            AS CashStorageLocation,
	CASE &amp;ReportData
		WHEN 1
			THEN Cash.CashRegister.CashCurrency
		WHEN 2
			THEN &amp;ManagementAccountingCurrency
		WHEN 3
			THEN Cash.Organization.LocalAccountingCurrency
	END AS Currency,
	VALUE(Enum.CashTypes.CashPayment)  AS CashType,
	CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END AS Recorder,
	Cash.SecondPeriod                       AS SecondPeriod,
	Cash.DayPeriod                          AS DayPeriod,
	Cash.WeekPeriod                        AS WeekPeriod,
	Cash.TenDaysPeriod                        AS TenDaysPeriod,
	Cash.MonthPeriod                         AS MonthPeriod,
	Cash.QuarterPeriod                       AS QuarterPeriod,
	Cash.HalfYearPeriod                     AS HalfYearPeriod,
	Cash.YearPeriod                           AS YearPeriod,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			Cash.SumOpeningBalance
		WHEN 2 THEN
			Cash.SumManOpeningBalance
		WHEN 3 THEN
			Cash.SumComplOpeningBalance
	END AS SumOpeningBalance,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			Cash.SumReceipt
		WHEN 2 THEN
			Cash.SumManReceipt
		WHEN 3 THEN
			Cash.SumComplReceipt
	END AS SumReceipt,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			Cash.SumExpense
		WHEN 2 THEN
			Cash.SumManExpense
		WHEN 3 THEN
			Cash.SumComplExpense
	END AS SumExpense,
	
	CASE &amp;ReportData
		WHEN 1 THEN
			Cash.SumClosingBalance
		WHEN 2 THEN
			Cash.SumManClosingBalance
		WHEN 3 THEN
			Cash.SumComplClosingBalance
	END AS SumClosingBalance
	
{SELECT
	Organization.*,
	CashStorageLocation.*,
	Currency.*,
	Recorder.*,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	SumOpeningBalance,
	SumReceipt,
	SumExpense,
	SumClosingBalance
}
FROM
	AccumulationRegister.CashInCashRegistersCR.BalanceAndTurnovers(,, Auto,,
		{Organization.*}
		{CashRegister.* AS CashStorageLocation}
	) AS Cash
{WHERE
	Cash.CashRegister.CashCurrency.* AS Currency,
	(CASE
		WHEN Cash.Recorder = UNDEFINED
			THEN NULL
		ELSE Cash.Recorder
	END).* AS Recorder,
	Cash.SecondPeriod,
	Cash.DayPeriod,
	Cash.WeekPeriod,
	Cash.TenDaysPeriod,
	Cash.MonthPeriod,
	Cash.QuarterPeriod,
	Cash.HalfYearPeriod,
	Cash.YearPeriod
}</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>SumClosingBalance</dataPath>
		<expression>Case
    When Sum(SumClosingBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
    JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumClosingBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
        Else
        Sum(Array(EvalExpressionWithGroupValueTable("Sum(SumClosingBalance)", "Currency")))
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumOpeningBalance</dataPath>
		<expression>Case
    When Sum(SumOpeningBalance) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
    JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumOpeningBalance), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
        Else
        Sum(Array(EvalExpressionWithGroupValueTable("Sum(SumOpeningBalance)", "Currency")))
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumReceipt</dataPath>
		<expression>Case
    When Sum(SumReceipt) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
    JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumReceipt), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
        Else
        Sum(SumReceipt)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SumExpense</dataPath>
		<expression>Case
    When Sum(SumExpense) &lt;&gt; 0
        And Count(Distinct Currency) &gt; 1
    Then
    JoinStrings(EvalExpressionWithGroupValueTable("Format(Sum(SumExpense), ""NFD=2; NZ=0,00""), Currency", "Currency"),," ")
        Else
        Sum(SumExpense)
End</expression>
	</totalField>
