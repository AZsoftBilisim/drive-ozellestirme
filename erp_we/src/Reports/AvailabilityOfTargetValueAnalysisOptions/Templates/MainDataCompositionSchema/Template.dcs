	<calculatedField>
		<dataPath>AvailableToUsers</dataPath>
		<expression/>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Available to users</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>در دسترس کاربران</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Disponibile per gli utenti</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
