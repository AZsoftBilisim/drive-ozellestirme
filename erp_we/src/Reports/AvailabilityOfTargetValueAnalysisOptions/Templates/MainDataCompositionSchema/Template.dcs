			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Доступно для пользователей</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kullanıcılar tarafından kullanılabilir</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Cho phép người sử dụng</v8:content>
			</v8:item>
		</title>
		<useRestriction>
