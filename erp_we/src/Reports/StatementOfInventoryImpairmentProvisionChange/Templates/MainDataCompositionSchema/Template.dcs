		<dataSource>DataSource1</dataSource>
		<query>// Selection of transfer operations.
SELECT
	InventoryCost.ItemsLocationAttributes AS ItemsLocationAttributes,
	InventoryCost.ItemsLocationAttributes.Products AS Products,
	InventoryCost.ItemsLocationAttributes.Characteristic AS Characteristic,
	InventoryCost.ItemsLocationAttributes.Series AS Series,
	InventoryCost.ItemsLocationAttributes.StorageLocation AS StorageLocation,
	InventoryCost.AccountingSection AS AccountingSection,
	InventoryCost.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	InventoryCost.Organization AS Organization,
	InventoryCost.Lot AS Lot,
	InventoryCost.LotVendorAttributes AS LotVendorAttributes,
	InventoryCost.FinancialAccountingDimension AS FinancialAccountingDimension,
	InventoryCost.VATActivityType AS VATActivityType,
	0 AS NumberOfArrivalsExcludingMovements,
	0 AS QuantityConsumptionExcludingMovement,
	SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InventoryCost.Count
		ELSE 0
	END) AS NumberOfArrivalsMovements,
	SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN InventoryCost.Count
		ELSE 0
	END) AS NumberOfConsumable,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveLocalParishRelocation,
	0 AS ReserveLocalReceiptExcludingRelocation,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveLocalConsumption,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InventoryCost.ProvisionForImpairmentMan
		ELSE 0
	END) AS ReserveManParishMove,
	0 AS ReserveManReceiptExcludingRelocation,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN InventoryCost.ProvisionForImpairmentMan
		ELSE 0
	END) AS ReserveManExpense,
	0 AS ReserveLocalDisposal,
	0 AS ManReserveDisposal
INTO RegisteredRecordsOfReserve
{SELECT
	ItemsLocationAttributes.*,
	Products.*,
	Characteristic.*,
	Series.*,
	StorageLocation.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	NumberOfArrivalsExcludingMovements,
	QuantityConsumptionExcludingMovement,
	NumberOfArrivalsMovements,
	NumberOfConsumable,
	ReserveLocalParishRelocation,
	ReserveLocalReceiptExcludingRelocation,
	ReserveLocalConsumption,
	ReserveManParishMove,
	ReserveManReceiptExcludingRelocation,
	ReserveManExpense,
	ReserveLocalDisposal,
	ManReserveDisposal}
FROM
	AccumulationRegister.InventoryCost AS InventoryCost
	
WHERE
	InventoryCost.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND InventoryCost.ItemsLocationAttributes.Products.ProductKind.ItemsType IN
	(VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
	AND InventoryCost.AccountingSection IN (VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent),
		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit),
		VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToToller),
		VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsTransferredToPartners))
	AND &amp;BatchAccountingVersion22
	AND InventoryCost.Period &gt;= &amp;DateOfTransitionToLotAccountingVersion222
	// Selection by transfer operations.
	AND InventoryCost.BusinessOperation IN (&amp;HouseholdRelocationOperations)
{WHERE
	InventoryCost.ItemsLocationAttributes.* AS ItemsLocationAttributes,
	InventoryCost.ItemsLocationAttributes.Products.* AS Products,
	InventoryCost.ItemsLocationAttributes.Characteristic.* AS Characteristic,
	InventoryCost.ItemsLocationAttributes.Series.* AS Series,
	InventoryCost.ItemsLocationAttributes.StorageLocation.* AS StorageLocation,
	InventoryCost.AccountingSection.* AS AccountingSection,
	InventoryCost.InventoryOwnerAttribute.* AS InventoryOwnerAttribute,
	InventoryCost.Organization.* AS Organization,
	InventoryCost.Lot.* AS Lot,
	InventoryCost.LotVendorAttributes.* AS LotVendorAttributes,
	InventoryCost.FinancialAccountingDimension.* AS FinancialAccountingDimension,
	InventoryCost.VATActivityType.* AS VATActivityType,
	0 AS NumberOfArrivalsExcludingMovements,
	0 AS QuantityConsumptionExcludingMovement,
	SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InventoryCost.Count
		ELSE 0
	END) AS NumberOfArrivalsMovements,
	SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN InventoryCost.Count
		ELSE 0
	END) AS NumberOfConsumable,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveLocalParishRelocation,
	0 AS ReserveLocalReceiptExcludingRelocation,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveLocalConsumption,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InventoryCost.ProvisionForImpairmentMan
		ELSE 0
	END) AS ReserveManParishMove,
	0 AS ReserveManReceiptExcludingRelocation,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN InventoryCost.ProvisionForImpairmentMan
		ELSE 0
	END) AS ReserveManExpense,
	0 AS ReserveLocalDisposal,
	0 AS ManReserveDisposal}
GROUP BY
	InventoryCost.ItemsLocationAttributes,
	InventoryCost.ItemsLocationAttributes.Products,
	InventoryCost.ItemsLocationAttributes.Characteristic,
	InventoryCost.ItemsLocationAttributes.Series,
	InventoryCost.ItemsLocationAttributes.StorageLocation,
	InventoryCost.AccountingSection,
	InventoryCost.InventoryOwnerAttribute,
	InventoryCost.Organization,
	InventoryCost.Lot,
	InventoryCost.LotVendorAttributes,
	InventoryCost.FinancialAccountingDimension,
	InventoryCost.VATActivityType 

UNION 

// Selection for operations other than movements.
SELECT
	InventoryCost.ItemsLocationAttributes AS ItemsLocationAttributes,
	InventoryCost.ItemsLocationAttributes.Products AS Products,
	InventoryCost.ItemsLocationAttributes.Characteristic AS Characteristic,
	InventoryCost.ItemsLocationAttributes.Series AS Series,
	InventoryCost.ItemsLocationAttributes.StorageLocation AS StorageLocation,
	InventoryCost.AccountingSection AS AccountingSection,
	InventoryCost.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	InventoryCost.Organization AS Organization,
	InventoryCost.Lot AS Lot,
	InventoryCost.LotVendorAttributes AS LotVendorAttributes,
	InventoryCost.FinancialAccountingDimension AS FinancialAccountingDimension,
	InventoryCost.VATActivityType AS VATActivityType,
	SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InventoryCost.Count
		ELSE 0
	END) AS NumberOfArrivalsExcludingMovements,
	SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN InventoryCost.Count
		ELSE 0
	END) AS QuantityConsumptionExcludingMovement,
	0 AS NumberOfArrivalsMovements,
	0 AS NumberOfConsumable,
	0 AS ReserveLocalParishRelocation,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			AND NOT InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveLocalReceiptExcludingRelocation,
	0 AS ReserveLocalConsumption,
	0 AS ReserveManParishMove,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			AND NOT InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveManReceiptExcludingRelocation,
	0 AS ReserveManExpense,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			AND NOT InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveLocalDisposal,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
		AND NOT InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision)
			THEN InventoryCost.ProvisionForImpairmentMan
		ELSE 0
	END) AS ManReserveDisposal

FROM
	AccumulationRegister.InventoryCost AS InventoryCost
	
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS DimensionOfProductItem
		ON InventoryCost.ItemsLocationAttributes = DimensionOfProductItem.DimensionKey
	
		LEFT JOIN InformationRegister.ItemsLocationAttributes AS CorAnalysisOfProducts
		ON InventoryCost.CorItemsLocationAttributes = CorAnalysisOfProducts.DimensionKey
	
WHERE
	InventoryCost.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND InventoryCost.ItemsLocationAttributes.Products.ProductKind.ItemsType IN
	(VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
	AND InventoryCost.AccountingSection IN (VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent),
		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit),
		VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToToller),
		VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsTransferredToPartners))
	AND &amp;BatchAccountingVersion22
	AND InventoryCost.Period &gt;= &amp;DateOfMigrationToBatchAccounting22
	// Selection that excludes moving operations.
	AND NOT InventoryCost.BusinessOperation IN (&amp;HouseholdRelocationOperations)
{WHERE
	InventoryCost.ItemsLocationAttributes.* AS ItemsLocationAttributes,
	InventoryCost.ItemsLocationAttributes.Products.* AS Products,
	InventoryCost.ItemsLocationAttributes.Characteristic.* AS Characteristic,
	InventoryCost.ItemsLocationAttributes.Series.* AS Series,
	InventoryCost.ItemsLocationAttributes.StorageLocation.* AS StorageLocation,
	InventoryCost.AccountingSection.* AS AccountingSection,
	InventoryCost.InventoryOwnerAttribute.* AS InventoryOwnerAttribute,
	InventoryCost.Organization.* AS Organization,
	InventoryCost.Lot.* AS Lot,
	InventoryCost.LotVendorAttributes.* AS LotVendorAttributes,
	InventoryCost.FinancialAccountingDimension.* AS FinancialAccountingDimension,
	InventoryCost.VATActivityType.* AS VATActivityType,
	SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN InventoryCost.Count
		ELSE 0
	END) AS NumberOfArrivalsExcludingMovements,
	SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
			THEN InventoryCost.Count
		ELSE 0
	END) AS QuantityConsumptionExcludingMovement,
	0 AS NumberOfArrivalsMovements,
	0 AS NumberOfConsumable,
	0 AS ReserveLocalParishRelocation,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
		AND NOT InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveLocalReceiptExcludingRelocation,
	0 AS ReserveLocalConsumption,
	0 AS ReserveManParishMove,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
		AND NOT InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveManReceiptExcludingRelocation,
	0 AS ReserveManExpense,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
		AND NOT InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision)
			THEN InventoryCost.ProvisionForImpairmentLocal
		ELSE 0
	END) AS ReserveLocalDisposal,
	-SUM(CASE
		WHEN InventoryCost.RecordType = VALUE(AccumulationRecordType.Expense)
		AND NOT InventoryCost.BusinessOperation = VALUE(Enum.BusinessTransactions.AccrualOfInventoriesImpairmentProvision)
			THEN InventoryCost.ProvisionForImpairmentMan
		ELSE 0
	END) AS ManReserveDisposal}
GROUP BY
	InventoryCost.ItemsLocationAttributes,
	InventoryCost.ItemsLocationAttributes.Products,
	InventoryCost.ItemsLocationAttributes.Characteristic,
	InventoryCost.ItemsLocationAttributes.Series,
	InventoryCost.ItemsLocationAttributes.StorageLocation,
	InventoryCost.AccountingSection,
	InventoryCost.InventoryOwnerAttribute,
	InventoryCost.Organization,
	InventoryCost.Lot,
	InventoryCost.LotVendorAttributes,
	InventoryCost.FinancialAccountingDimension,
	InventoryCost.VATActivityType     
     
INDEX BY
	ItemsLocationAttributes,
	AccountingSection,
	InventoryOwnerAttribute,
	Organization,
	Lot,
	LotVendorAttributes,
	FinancialAccountingDimension,
	VATActivityType
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes AS ItemsLocationAttributes,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Products AS Products,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Characteristic AS Characteristic,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Series AS Series,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.StorageLocation AS StorageLocation,
	InventoryCostBalanceAndTurnovers.AccountingSection AS AccountingSection,
	InventoryCostBalanceAndTurnovers.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	InventoryCostBalanceAndTurnovers.Organization AS Organization,
	InventoryCostBalanceAndTurnovers.Lot AS Lot,
	InventoryCostBalanceAndTurnovers.LotVendorAttributes AS LotVendorAttributes,
	InventoryCostBalanceAndTurnovers.FinancialAccountingDimension AS FinancialAccountingDimension,
	InventoryCostBalanceAndTurnovers.VATActivityType AS VATActivityType,
	InventoryCostBalanceAndTurnovers.CountOpeningBalance AS CountOpeningBalance,
	InventoryCostBalanceAndTurnovers.CountClosingBalance AS CountClosingBalance,
	-InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalOpeningBalance AS
		ProvisionForImpairmentLocalOpeningBalance,
	-InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManOpeningBalance AS
		ProvisionForImpairmentManOpeningBalance
INTO ReserveBalances
{SELECT
	ItemsLocationAttributes.*,
	Products.*,
	Characteristic.*,
	Series.*,
	StorageLocation.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	CountOpeningBalance,
	CountClosingBalance,
	ProvisionForImpairmentLocalOpeningBalance,
	ProvisionForImpairmentManOpeningBalance}
FROM
	AccumulationRegister.InventoryCost.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod,,,) AS
		InventoryCostBalanceAndTurnovers
WHERE
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Products.ProductKind.ItemsType IN
	(VALUE(Enum.ItemsTypes.OwnGoods), VALUE(Enum.ItemsTypes.ReusablePackage))
	AND InventoryCostBalanceAndTurnovers.AccountingSection IN
	(VALUE(Enum.SectionsOfInventoryCostAccounting.ProductStock),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToCommissionAgent),
		VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsInTransit),
		VALUE(Enum.SectionsOfInventoryCostAccounting.WorkInProgress),
		VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsTransferredToToller),
		VALUE(Enum.SectionsOfInventoryCostAccounting.OwnGoodsTransferredToPartners))
	AND &amp;BatchAccountingVersion22
	AND &amp;BeginOfPeriod &gt;= &amp;DateOfMigrationToBatchAccounting22
{WHERE
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.* AS ItemsLocationAttributes,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Products.* AS Products,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Characteristic.* AS Characteristic,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.Series.* AS Series,
	InventoryCostBalanceAndTurnovers.ItemsLocationAttributes.StorageLocation.* AS StorageLocation,
	InventoryCostBalanceAndTurnovers.AccountingSection.* AS AccountingSection,
	InventoryCostBalanceAndTurnovers.InventoryOwnerAttribute.* AS InventoryOwnerAttribute,
	InventoryCostBalanceAndTurnovers.Organization.* AS Organization,
	InventoryCostBalanceAndTurnovers.Lot.* AS Lot,
	InventoryCostBalanceAndTurnovers.LotVendorAttributes.* AS LotVendorAttributes,
	InventoryCostBalanceAndTurnovers.FinancialAccountingDimension.* AS FinancialAccountingDimension,
	InventoryCostBalanceAndTurnovers.VATActivityType.* AS VATActivityType,
	InventoryCostBalanceAndTurnovers.CountOpeningBalance AS CountOpeningBalance,
	InventoryCostBalanceAndTurnovers.CountClosingBalance AS CountClosingBalance,
	-InventoryCostBalanceAndTurnovers.ProvisionForImpairmentLocalOpeningBalance AS
		ProvisionForImpairmentLocalOpeningBalance,
	-InventoryCostBalanceAndTurnovers.ProvisionForImpairmentManOpeningBalance AS
		ProvisionForImpairmentManOpeningBalance}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	RegisteredRecordsOfReserve.ItemsLocationAttributes AS ItemsLocationAttributes,
	RegisteredRecordsOfReserve.Products AS Products,
	RegisteredRecordsOfReserve.Characteristic AS Characteristic,
	RegisteredRecordsOfReserve.Series AS Series,
	RegisteredRecordsOfReserve.StorageLocation AS StorageLocation,
	RegisteredRecordsOfReserve.AccountingSection AS AccountingSection,
	RegisteredRecordsOfReserve.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	RegisteredRecordsOfReserve.Organization AS Organization,
	RegisteredRecordsOfReserve.Lot AS Lot,
	RegisteredRecordsOfReserve.LotVendorAttributes AS LotVendorAttributes,
	RegisteredRecordsOfReserve.FinancialAccountingDimension AS FinancialAccountingDimension,
	RegisteredRecordsOfReserve.VATActivityType AS VATActivityType,
	RegisteredRecordsOfReserve.NumberOfArrivalsMovements AS NumberOfArrivalsMovements,
	RegisteredRecordsOfReserve.NumberOfArrivalsExcludingMovements AS NumberOfArrivalsExcludingMovements,
	RegisteredRecordsOfReserve.NumberOfConsumable AS NumberOfConsumable,
	RegisteredRecordsOfReserve.QuantityConsumptionExcludingMovement AS QuantityConsumptionExcludingMovement,
	CASE
		WHEN &amp;ReportData = 1
			THEN RegisteredRecordsOfReserve.ReserveManParishMove
		ELSE RegisteredRecordsOfReserve.ReserveLocalParishRelocation
	END AS ReserveArrivalMovement,
	CASE
		WHEN &amp;ReportData = 1
			THEN RegisteredRecordsOfReserve.ReserveManReceiptExcludingRelocation
		ELSE RegisteredRecordsOfReserve.ReserveLocalReceiptExcludingRelocation
	END AS ReserveReceiptExcludingRelocation,
	CASE
		WHEN &amp;ReportData = 1
			THEN RegisteredRecordsOfReserve.ReserveManExpense
		ELSE RegisteredRecordsOfReserve.ReserveLocalConsumption
	END AS ReserveExpenseMovement,
	CASE
		WHEN &amp;ReportData = 1
			THEN RegisteredRecordsOfReserve.ManReserveDisposal
		ELSE RegisteredRecordsOfReserve.ReserveLocalDisposal
	END AS ProvisionDisposal,
	0 AS CountOpeningBalance,
	0 AS CountClosingBalance,
	0 AS ProvisionForImpairmentOpeningBalance
{SELECT
	ItemsLocationAttributes.*,
	Products.*,
	Characteristic.*,
	Series.*,
	StorageLocation.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	NumberOfArrivalsMovements,
	NumberOfArrivalsExcludingMovements,
	NumberOfConsumable,
	QuantityConsumptionExcludingMovement,
	ReserveArrivalMovement,
	ReserveReceiptExcludingRelocation,
	ReserveExpenseMovement,
	ProvisionDisposal,
	CountOpeningBalance,
	CountClosingBalance,
	ProvisionForImpairmentOpeningBalance}
{WHERE
	RegisteredRecordsOfReserve.ItemsLocationAttributes.* AS ItemsLocationAttributes,
	RegisteredRecordsOfReserve.Products.* AS Products,
	RegisteredRecordsOfReserve.Characteristic.* AS Characteristic,
	RegisteredRecordsOfReserve.Series.* AS Series,
	RegisteredRecordsOfReserve.StorageLocation.* AS StorageLocation,
	RegisteredRecordsOfReserve.AccountingSection.* AS AccountingSection,
	RegisteredRecordsOfReserve.InventoryOwnerAttribute.* AS InventoryOwnerAttribute,
	RegisteredRecordsOfReserve.Organization.* AS Organization,
	RegisteredRecordsOfReserve.Lot.* AS Lot,
	RegisteredRecordsOfReserve.LotVendorAttributes.* AS LotVendorAttributes,
	RegisteredRecordsOfReserve.FinancialAccountingDimension.* AS FinancialAccountingDimension,
	RegisteredRecordsOfReserve.VATActivityType.* AS VATActivityType,
	RegisteredRecordsOfReserve.NumberOfArrivalsMovements AS NumberOfArrivalsMovements,
	RegisteredRecordsOfReserve.NumberOfArrivalsExcludingMovements AS NumberOfArrivalsExcludingMovements,
	RegisteredRecordsOfReserve.NumberOfConsumable AS NumberOfConsumable,
	RegisteredRecordsOfReserve.QuantityConsumptionExcludingMovement AS QuantityConsumptionExcludingMovement,
	CASE
		WHEN &amp;ReportData = 1
			THEN RegisteredRecordsOfReserve.ReserveManParishMove
		ELSE RegisteredRecordsOfReserve.ReserveLocalParishRelocation
	END AS ReserveArrivalMovement,
	CASE
		WHEN &amp;ReportData = 1
			THEN RegisteredRecordsOfReserve.ReserveManReceiptExcludingRelocation
		ELSE RegisteredRecordsOfReserve.ReserveLocalReceiptExcludingRelocation
	END AS ReserveReceiptExcludingRelocation,
	CASE
		WHEN &amp;ReportData = 1
			THEN RegisteredRecordsOfReserve.ReserveManExpense
		ELSE RegisteredRecordsOfReserve.ReserveLocalConsumption
	END AS ReserveExpenseMovement,
	CASE
		WHEN &amp;ReportData = 1
			THEN RegisteredRecordsOfReserve.ManReserveDisposal
		ELSE RegisteredRecordsOfReserve.ReserveLocalDisposal
	END AS ProvisionDisposal}
INTO ReserveBalancesAndRegisteredRecords
FROM
	RegisteredRecordsOfReserve AS RegisteredRecordsOfReserve

UNION ALL

SELECT
	ReserveBalances.ItemsLocationAttributes AS ItemsLocationAttributes,
	ReserveBalances.Products AS Products,
	ReserveBalances.Characteristic AS Characteristic,
	ReserveBalances.Series AS Series,
	ReserveBalances.StorageLocation AS StorageLocation,
	ReserveBalances.AccountingSection AS AccountingSection,
	ReserveBalances.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	ReserveBalances.Organization AS Organization,
	ReserveBalances.Lot AS Lot,
	ReserveBalances.LotVendorAttributes AS LotVendorAttributes,
	ReserveBalances.FinancialAccountingDimension AS FinancialAccountingDimension,
	ReserveBalances.VATActivityType AS VATActivityType,
	0 AS NumberOfArrivalsMovements,
	0 AS NumberOfArrivalsExcludingMovements,
	0 AS NumberOfConsumable,
	0 AS QuantityConsumptionExcludingMovement,
	0 AS ReserveArrivalMovement,
	0 AS ReserveReceiptExcludingRelocation,
	0 AS ReserveExpenseMovement,
	0 AS ProvisionDisposal,
	ReserveBalances.CountOpeningBalance AS CountOpeningBalance,
	ReserveBalances.CountClosingBalance AS CountClosingBalance,
	CASE
		WHEN &amp;ReportData = 1
			THEN ReserveBalances.ProvisionForImpairmentManOpeningBalance
		ELSE ReserveBalances.ProvisionForImpairmentLocalOpeningBalance
	END AS ProvisionForImpairmentOpeningBalance
FROM
	ReserveBalances AS ReserveBalances
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	ReserveBalancesAndRegisteredRecords.ItemsLocationAttributes AS ItemsLocationAttributes,
	ReserveBalancesAndRegisteredRecords.Products AS Products,
	ReserveBalancesAndRegisteredRecords.Characteristic AS Characteristic,
	ReserveBalancesAndRegisteredRecords.Series AS Series,
	ReserveBalancesAndRegisteredRecords.StorageLocation AS StorageLocation,
	ReserveBalancesAndRegisteredRecords.AccountingSection AS AccountingSection,
	ReserveBalancesAndRegisteredRecords.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	ReserveBalancesAndRegisteredRecords.Organization AS Organization,
	ReserveBalancesAndRegisteredRecords.Lot AS Lot,
	ReserveBalancesAndRegisteredRecords.LotVendorAttributes AS LotVendorAttributes,
	ReserveBalancesAndRegisteredRecords.FinancialAccountingDimension AS FinancialAccountingDimension,
	ReserveBalancesAndRegisteredRecords.VATActivityType AS VATActivityType,
	SUM(ReserveBalancesAndRegisteredRecords.NumberOfArrivalsMovements) AS NumberOfArrivalsMovements,
	SUM(ReserveBalancesAndRegisteredRecords.NumberOfArrivalsExcludingMovements) AS NumberOfArrivalsExcludingMovements,
	SUM(ReserveBalancesAndRegisteredRecords.NumberOfConsumable) AS NumberOfConsumable,
	SUM(ReserveBalancesAndRegisteredRecords.QuantityConsumptionExcludingMovement) AS QuantityConsumptionExcludingMovement,
	SUM(ReserveBalancesAndRegisteredRecords.ReserveArrivalMovement) AS ReserveArrivalMovement,
	SUM(ReserveBalancesAndRegisteredRecords.ReserveReceiptExcludingRelocation) AS ReserveReceiptExcludingRelocation,
	SUM(ReserveBalancesAndRegisteredRecords.ReserveExpenseMovement) AS ReserveExpenseMovement,
	SUM(ReserveBalancesAndRegisteredRecords.ProvisionDisposal) AS ProvisionDisposal,
	SUM(ReserveBalancesAndRegisteredRecords.CountOpeningBalance) AS CountOpeningBalance,
	SUM(ReserveBalancesAndRegisteredRecords.CountClosingBalance) AS CountClosingBalance,
	SUM(ReserveBalancesAndRegisteredRecords.ProvisionForImpairmentOpeningBalance) AS ProvisionForImpairmentOpeningBalance
{SELECT
	ItemsLocationAttributes.*,
	Products.*,
	Characteristic.*,
	Series.*,
	StorageLocation.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	NumberOfArrivalsMovements,
	NumberOfArrivalsExcludingMovements,
	NumberOfConsumable,
	QuantityConsumptionExcludingMovement,
	ReserveArrivalMovement,
	ReserveReceiptExcludingRelocation,
	ReserveExpenseMovement,
	ProvisionDisposal,
	CountOpeningBalance,
	CountClosingBalance,
	ProvisionForImpairmentOpeningBalance}
INTO SummaryTable
FROM
	ReserveBalancesAndRegisteredRecords AS ReserveBalancesAndRegisteredRecords
{WHERE
	ReserveBalancesAndRegisteredRecords.ItemsLocationAttributes.*,
	ReserveBalancesAndRegisteredRecords.Products.*,
	ReserveBalancesAndRegisteredRecords.Characteristic.*,
	ReserveBalancesAndRegisteredRecords.Series.*,
	ReserveBalancesAndRegisteredRecords.StorageLocation.*,
	ReserveBalancesAndRegisteredRecords.AccountingSection.*,
	ReserveBalancesAndRegisteredRecords.InventoryOwnerAttribute.*,
	ReserveBalancesAndRegisteredRecords.Organization.*,
	ReserveBalancesAndRegisteredRecords.Lot.*,
	ReserveBalancesAndRegisteredRecords.LotVendorAttributes.*,
	ReserveBalancesAndRegisteredRecords.FinancialAccountingDimension.*,
	ReserveBalancesAndRegisteredRecords.VATActivityType.*,
	SUM(ReserveBalancesAndRegisteredRecords.NumberOfArrivalsMovements) AS NumberOfArrivalsMovements,
	SUM(ReserveBalancesAndRegisteredRecords.NumberOfArrivalsExcludingMovements) AS NumberOfArrivalsExcludingMovements,
	SUM(ReserveBalancesAndRegisteredRecords.NumberOfConsumable) AS NumberOfConsumable,
	SUM(ReserveBalancesAndRegisteredRecords.QuantityConsumptionExcludingMovement) AS QuantityConsumptionExcludingMovement,
	SUM(ReserveBalancesAndRegisteredRecords.ReserveArrivalMovement) AS ReserveArrivalMovement,
	SUM(ReserveBalancesAndRegisteredRecords.ReserveReceiptExcludingRelocation) AS ReserveReceiptExcludingRelocation,
	SUM(ReserveBalancesAndRegisteredRecords.ReserveExpenseMovement) AS ReserveExpenseMovement,
	SUM(ReserveBalancesAndRegisteredRecords.ProvisionDisposal) AS ProvisionDisposal,
	SUM(ReserveBalancesAndRegisteredRecords.CountOpeningBalance) AS CountOpeningBalance,
	SUM(ReserveBalancesAndRegisteredRecords.CountClosingBalance) AS CountClosingBalance,
	SUM(ReserveBalancesAndRegisteredRecords.ProvisionForImpairmentOpeningBalance) AS ProvisionForImpairmentOpeningBalance}
GROUP BY
	ReserveBalancesAndRegisteredRecords.ItemsLocationAttributes,
	ReserveBalancesAndRegisteredRecords.Products,
	ReserveBalancesAndRegisteredRecords.Characteristic,
	ReserveBalancesAndRegisteredRecords.Series,
	ReserveBalancesAndRegisteredRecords.StorageLocation,
	ReserveBalancesAndRegisteredRecords.AccountingSection,
	ReserveBalancesAndRegisteredRecords.InventoryOwnerAttribute,
	ReserveBalancesAndRegisteredRecords.Organization,
	ReserveBalancesAndRegisteredRecords.Lot,
	ReserveBalancesAndRegisteredRecords.LotVendorAttributes,
	ReserveBalancesAndRegisteredRecords.FinancialAccountingDimension,
	ReserveBalancesAndRegisteredRecords.VATActivityType
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	SummaryTable.ItemsLocationAttributes AS ItemsLocationAttributes,
	SummaryTable.Products AS Products,
	SummaryTable.Characteristic AS Characteristic,
	SummaryTable.Series AS Series,
	SummaryTable.StorageLocation AS StorageLocation,
	SummaryTable.AccountingSection AS AccountingSection,
	SummaryTable.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	SummaryTable.Organization AS Organization,
	SummaryTable.Lot AS Lot,
	SummaryTable.LotVendorAttributes AS LotVendorAttributes,
	SummaryTable.FinancialAccountingDimension AS FinancialAccountingDimension,
	SummaryTable.VATActivityType AS VATActivityType,
	SummaryTable.NumberOfArrivalsMovements AS NumberOfArrivalsMovements,
	SummaryTable.NumberOfArrivalsExcludingMovements AS NumberOfArrivalsExcludingMovements,
	SummaryTable.NumberOfConsumable AS NumberOfConsumable,
	SummaryTable.QuantityConsumptionExcludingMovement AS QuantityConsumptionExcludingMovement,
	SummaryTable.ReserveArrivalMovement AS ReserveArrivalMovement,
	SummaryTable.ReserveReceiptExcludingRelocation AS ReserveReceiptExcludingRelocation,
	SummaryTable.ReserveExpenseMovement AS ReserveExpenseMovement,
	SummaryTable.ProvisionDisposal AS ProvisionDisposal,
	SummaryTable.CountOpeningBalance AS CountOpeningBalance,
	SummaryTable.CountClosingBalance AS CountClosingBalance,
	SummaryTable.ProvisionForImpairmentOpeningBalance AS ProvisionForImpairmentOpeningBalance
{SELECT
	ItemsLocationAttributes.*,
	Products.*,
	Characteristic.*,
	Series.*,
	StorageLocation.*,
	AccountingSection.*,
	InventoryOwnerAttribute.*,
	Organization.*,
	Lot.*,
	LotVendorAttributes.*,
	FinancialAccountingDimension.*,
	VATActivityType.*,
	NumberOfArrivalsMovements,
	NumberOfArrivalsExcludingMovements,
	NumberOfConsumable,
	QuantityConsumptionExcludingMovement,
	ReserveArrivalMovement,
	ReserveReceiptExcludingRelocation,
	ReserveExpenseMovement,
	ProvisionDisposal,
	CountOpeningBalance,
	CountClosingBalance,
	ProvisionForImpairmentOpeningBalance}
FROM
	SummaryTable AS SummaryTable
{WHERE
	SummaryTable.ItemsLocationAttributes.*,
	SummaryTable.Products.*,
	SummaryTable.Characteristic.*,
	SummaryTable.Series.*,
	SummaryTable.StorageLocation.*,
	SummaryTable.AccountingSection.*,
	SummaryTable.InventoryOwnerAttribute.*,
	SummaryTable.Organization.*,
	SummaryTable.Lot.*,
	SummaryTable.LotVendorAttributes.*,
	SummaryTable.FinancialAccountingDimension.*,
	SummaryTable.VATActivityType.*,
	SummaryTable.NumberOfArrivalsMovements,
	SummaryTable.NumberOfArrivalsExcludingMovements,
	SummaryTable.NumberOfConsumable,
	SummaryTable.QuantityConsumptionExcludingMovement,
	SummaryTable.ReserveArrivalMovement,
	SummaryTable.ReserveReceiptExcludingRelocation,
	SummaryTable.ReserveExpenseMovement,
	SummaryTable.ProvisionDisposal,
	SummaryTable.CountOpeningBalance,
	SummaryTable.CountClosingBalance,
	SummaryTable.ProvisionForImpairmentOpeningBalance}
WHERE
	CASE
		WHEN NOT SummaryTable.ReserveArrivalMovement = 0
			THEN TRUE
		WHEN NOT SummaryTable.ReserveReceiptExcludingRelocation = 0
			THEN TRUE
		WHEN NOT SummaryTable.ReserveExpenseMovement = 0
			THEN TRUE
		WHEN NOT SummaryTable.ProvisionDisposal = 0
			THEN TRUE
		WHEN NOT SummaryTable.ProvisionForImpairmentOpeningBalance = 0
			THEN TRUE
		ELSE FALSE
	END</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>ReserveAtTimeOfSettlement</dataPath>
		<expression>ProvisionForImpairmentOpeningBalance+ReserveReceiptExcludingRelocation+ReserveArrivalMovement-ReserveExpenseMovement-ProvisionDisposal</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Provision upon calculation</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>ذخیره هنگام محاسبه</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Scorte al momento del calcolo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Rezerwa na moment rozliczenia</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Резерв на момент расчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Hesaplama anındaki rezerv</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Dự phòng tại thời điểm tính toán</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>NFD=2</v8:content>
					</v8:item>
