	<calculatedField>
		<dataPath>OrderedOutOfTime</dataPath>
		<expression>Case
	When DateOfReceipt &gt; DemandDate
			Or &amp;CurrentDate &gt; DemandDate
		Then Ordered + TransferOrdered
	Else 0
End</expression>
