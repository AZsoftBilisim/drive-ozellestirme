				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<presentationExpression>OrderStructureServerCall.FullOrderPresentation(ProductionOrder.Number, ProductionOrder.Date, ProductionOrder.DemandDate)</presentationExpression>
		</field>
