				</dcscor:item>
			</appearance>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Demand.Products AS Products,
	Demand.Characteristic AS Characteristic,
	Demand.Warehouse AS WarehouseNeed,
	Demand.Purpose AS Purpose,
	Demand.ProductionOrder AS ProductionOrder,
	Demand.KeyProducts AS KeyProducts,
	MAX(Demand.Stage) AS Stage,
	MAX(
		CASE
			WHEN Schedule.Begin IS NOT NULL
				THEN BEGINOFPERIOD(Schedule.Begin, DAY)
			ELSE BEGINOFPERIOD(&amp;CurrentDate, DAY)
		END) AS DemandDate,
	MIN(Demand.ConnectionKeyTransfer) AS ConnectionKeyTransfer,
	MAX(CASE
			WHEN Demand.Stage REFS Document.ProductionStage2_2 
				THEN CAST(Demand.Stage AS Document.ProductionStage2_2) &lt;&gt; VALUE(Document.ProductionStage2_2.EmptyRef)
			WHEN Demand.Stage REFS Catalog.ProductionStages 
				THEN CAST(Demand.Stage AS Catalog.ProductionStages) &lt;&gt; VALUE(Catalog.ProductionStages.EmptyRef)
			ELSE FALSE
		END) AS IsStepFilled,
	MAX(ValuesInCache.SupplyMethod) AS SupplyMethod,
	MAX(ValuesInCache.SupplyType) AS SupplyType
INTO Demand
FROM
	InformationRegister.OrderStructure AS Demand
	
	LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	ON Demand.ProductionOrder = Schedule.ProductionOrder
		AND Schedule.ScheduleStatus = 0
		AND Demand.Stage = Schedule.Stage
		AND Demand.KeyLot = Schedule.KeyLot
	
	LEFT JOIN InformationRegister.CacheOfOrderStructureMasterData AS ValuesInCache
	ON Demand.Products = ValuesInCache.Products
		AND Demand.Characteristic = ValuesInCache.Characteristic
		AND Demand.Warehouse = ValuesInCache.Warehouse
		AND Demand.Purpose = ValuesInCache.Purpose
		AND Demand.ProductionOrder = ValuesInCache.ProductionOrder
WHERE
	Demand.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
	AND (&amp;ExcludeManufacturedSemiFinishedProducts
		AND NOT TRUE IN
			(SELECT TOP 1
				TRUE
			FROM 
				InformationRegister.CacheOfOrderStructureMasterData AS NSICache
			WHERE
				Demand.ProductionOrder = NSICache.ProductionOrder
				AND Demand.Products = NSICache.Products
				AND Demand.Characteristic = NSICache.Characteristic
				AND NSICache.SupplyType = VALUE(Enum.SupplyTypes.Production))
		OR NOT &amp;ExcludeManufacturedSemiFinishedProducts)
{WHERE
	Demand.ProductionOrder.* AS ProductionOrder,
	Demand.Products.* AS Products,
	Demand.Characteristic.* AS Characteristic,
	Demand.Warehouse.* AS WarehouseNeed,
	Demand.Purpose.* AS Purpose,
	Demand.KeySet AS KeySet,
	Demand.KeyLot AS KeyLot,
	(ISNULL(Schedule.Begin, DATETIME(1,1,1)) &lt; &amp;EndDate)}

GROUP BY
	Demand.Products,
	Demand.Characteristic,
	Demand.Warehouse,
	Demand.Purpose,
	Demand.ProductionOrder,
	Demand.KeyProducts
	
HAVING
	SUM(Demand.ToSupply + Demand.Done - Demand.Replaced) &gt; 0

INDEX BY
	Products, Characteristic, WarehouseNeed, Purpose, ProductionOrder, KeyProducts
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Demand.Products AS Products,
	Demand.Characteristic AS Characteristic,
	Demand.WarehouseNeed AS WarehouseRelocation,
	Demand.Purpose AS Purpose,
	Demand.ProductionOrder AS ProductionOrder,
	Demand.KeyProducts AS KeyProducts,
	Demand.ConnectionKeyTransfer AS ConnectionKeyTransfer,
	Demand.DemandDate AS DemandDate,
	Demand.SupplyMethod AS SupplyMethod,
	Demand.SupplyType AS SupplyType
INTO Transfers
FROM
	Demand AS Demand
	
WHERE
	Demand.ConnectionKeyTransfer &lt;&gt; &amp;EmptyLinkKey
	AND NOT Demand.IsStepFilled

INDEX BY
	Products, Characteristic, WarehouseRelocation, Purpose, ProductionOrder, KeyProducts
;

////////////////////////////////////////////////////////////////////////////////

// Meeting the needs of
SELECT
	Demand.Products AS Products,
	Demand.Characteristic AS Characteristic,
	Demand.WarehouseNeed AS Warehouse,
	Demand.Purpose AS Purpose,
	Demand.ProductionOrder AS ProductionOrder,
	Demand.KeyProducts AS KeyProducts,
	Demand.Stage AS Stage,
	Demand.SupplyMethod AS SupplyMethod,
	Demand.SupplyType AS SupplyType,
	RegisterRecords.ReceiptOrder AS ReceiptOrder,
	Demand.DemandDate AS DemandDate,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, YEAR) AS YearPeriod,
	CASE
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
				OR (RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
						AND ISNULL(RegisterRecords.ReceiptOrder, UNDEFINED) = UNDEFINED)
			THEN DATETIME(1, 1, 1)
		WHEN RegisterRecords.LineKind IN (
				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
				VALUE(Enum.KindsOfProductionOrderStructureLines.Move))
			AND Schedule.Ending IS NOT NULL
			THEN BEGINOFPERIOD(Schedule.Ending, DAY)
		WHEN ISNULL(RegisterRecords.DateOfReceipt, DATETIME(1, 1, 1)) &lt;&gt; DATETIME(1, 1, 1)
			THEN RegisterRecords.DateOfReceipt
		ELSE DATETIME(1, 1, 1)
	END AS DateOfReceipt,
	CASE
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
				OR (RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
						AND ISNULL(RegisterRecords.ReceiptOrder, UNDEFINED) = UNDEFINED)
			THEN FALSE
		WHEN RegisterRecords.LineKind IN (
				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
				VALUE(Enum.KindsOfProductionOrderStructureLines.Move))
			THEN FALSE
		WHEN ISNULL(RegisterRecords.DateOfReceipt, DATETIME(1, 1, 1)) &lt;&gt; DATETIME(1, 1, 1)
			THEN FALSE
		ELSE TRUE
	END AS DateOfReceiptIsUnknown,
	UNDEFINED AS WarehouseRelocation,
	UNDEFINED AS MethodOfEnsuringMovement,
	UNDEFINED AS TypeOfProvisionMoving,
	DATETIME(1, 1, 1) AS DateOfReceiptTransfer,
	SUM(RegisterRecords.ToSupply + RegisterRecords.Ordered + RegisterRecords.Done - RegisterRecords.Replaced) AS Required2,
	SUM(CASE
		WHEN ISNULL(RegisterRecords.ReceiptOrder, UNDEFINED) = UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory + RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
		ELSE 0
	END + RegisterRecords.Done) AS InStock,
	SUM(CASE
		WHEN ISNULL(RegisterRecords.ReceiptOrder, UNDEFINED) &lt;&gt; UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory
					+ RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
					+ RegisterRecords.AllocatedInFreeProductionLots
					+ RegisterRecords.AllocatedInAssignedProductionLots
		ELSE 0
	END) AS Ordered,
	SUM(RegisterRecords.Scheduled) AS NotOrdered,
	0 AS AvailableMovement,
	0 AS TransferOrdered
FROM
	Demand AS Demand
	
	LEFT JOIN InformationRegister.OrderStructure AS RegisterRecords
	ON Demand.Products = RegisterRecords.Products
		AND Demand.Characteristic = RegisterRecords.Characteristic
		AND Demand.WarehouseNeed = RegisterRecords.Warehouse
		AND Demand.Purpose = RegisterRecords.Purpose
		AND Demand.ProductionOrder = RegisterRecords.ProductionOrder
		AND Demand.KeyProducts = RegisterRecords.KeyProducts
	
	LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	ON RegisterRecords.ProductionOrder = Schedule.ProductionOrder
		AND Schedule.ScheduleStatus = 0
		AND RegisterRecords.Stage = Schedule.Stage
		AND RegisterRecords.KeyLot = Schedule.KeyLot
WHERE
	NOT TRUE IN (
		SELECT TOP 1
			TRUE
		FROM
			Transfers AS Transfers
		WHERE
			Transfers.Products = Demand.Products
			AND Transfers.Characteristic = Demand.Characteristic
			AND Transfers.WarehouseRelocation = Demand.WarehouseNeed
			AND Transfers.Purpose = Demand.Purpose
			AND Transfers.ProductionOrder = Demand.ProductionOrder
			AND Transfers.KeyProducts = Demand.KeyProducts)
	AND RegisterRecords.LineKind &lt;&gt; VALUE(Enum.KindsOfProductionOrderStructureLines.Move)

{WHERE
	RegisterRecords.ProductionOrder.* AS ProductionOrder,
	RegisterRecords.Products.* AS Products,
	RegisterRecords.Characteristic.* AS Characteristic,
	Demand.WarehouseNeed.* AS Warehouse,
	RegisterRecords.Purpose.* AS Purpose}

GROUP BY
	Demand.Products,
	Demand.Characteristic,
	Demand.WarehouseNeed,
	Demand.Purpose,
	Demand.ProductionOrder,
	Demand.KeyProducts,
	Demand.Stage,
	Demand.SupplyMethod,
	Demand.SupplyType,
	RegisterRecords.ReceiptOrder,
	Demand.DemandDate,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, DAY),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, WEEK),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, TENDAYS),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, MONTH),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, QUARTER),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, HALFYEAR),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, YEAR),
	CASE
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
				OR (RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
						AND ISNULL(RegisterRecords.ReceiptOrder, UNDEFINED) = UNDEFINED)
			THEN DATETIME(1, 1, 1)
		WHEN RegisterRecords.LineKind IN (
				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
				VALUE(Enum.KindsOfProductionOrderStructureLines.Move))
			AND Schedule.Ending IS NOT NULL
			THEN BEGINOFPERIOD(Schedule.Ending, DAY)
		WHEN ISNULL(RegisterRecords.DateOfReceipt, DATETIME(1, 1, 1)) &lt;&gt; DATETIME(1, 1, 1)
			THEN RegisterRecords.DateOfReceipt
		ELSE DATETIME(1, 1, 1)
	END,
	CASE
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Consumption)
				OR (RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
						AND ISNULL(RegisterRecords.ReceiptOrder, UNDEFINED) = UNDEFINED)
			THEN FALSE
		WHEN RegisterRecords.LineKind IN (
				VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct),
				VALUE(Enum.KindsOfProductionOrderStructureLines.Move))
			THEN FALSE
		WHEN ISNULL(RegisterRecords.DateOfReceipt, DATETIME(1, 1, 1)) &lt;&gt; DATETIME(1, 1, 1)
			THEN FALSE
		ELSE TRUE
	END

HAVING
	SUM(RegisterRecords.ToSupply + RegisterRecords.Ordered + RegisterRecords.Done - RegisterRecords.Replaced) &gt; 0
	OR SUM(CASE
		WHEN ISNULL(RegisterRecords.ReceiptOrder, UNDEFINED) = UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory + RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
		ELSE 0
	END + RegisterRecords.Done) &gt; 0
	OR SUM(CASE
		WHEN ISNULL(RegisterRecords.ReceiptOrder, UNDEFINED) &lt;&gt; UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory
					+ RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
					+ RegisterRecords.AllocatedInFreeProductionLots
					+ RegisterRecords.AllocatedInAssignedProductionLots
		ELSE 0
	END) &gt; 0
	OR SUM(RegisterRecords.Scheduled) &gt; 0

UNION ALL

// Unsecured materials
SELECT
	Demand.Products AS Products,
	Demand.Characteristic AS Characteristic,
	Demand.WarehouseNeed AS Warehouse,
	Demand.Purpose AS Purpose,
	Demand.ProductionOrder AS ProductionOrder,
	Demand.KeyProducts AS KeyProducts,
	Demand.Stage AS Stage,
	Demand.SupplyMethod AS SupplyMethod,
	Demand.SupplyType AS SupplyType,
	UNDEFINED AS ReceiptOrder,
	Demand.DemandDate AS DemandDate,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, YEAR) AS YearPeriod,
	DATETIME(1, 1, 1) AS DateOfReceipt,
	TRUE AS DateOfReceiptIsUnknown,
	UNDEFINED AS WarehouseRelocation,
	UNDEFINED AS MethodOfEnsuringMovement,
	UNDEFINED AS TypeOfProvisionMoving,
	DATETIME(1, 1, 1) AS DateOfReceiptTransfer,
	0 AS Required2,
	0 AS InStock,
	0 AS Ordered,
	SUM(RegisterRecords.ToSupply
			+ RegisterRecords.Ordered
			- RegisterRecords.Scheduled
			- RegisterRecords.AllocatedFromAvailableInventory
			- RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
			- RegisterRecords.AllocatedInFreeProductionLots
			- RegisterRecords.AllocatedInAssignedProductionLots
			- RegisterRecords.Replaced) AS NotOrdered,
	0 AS AvailableMovement,
	0 AS TransferOrdered
FROM
	Demand AS Demand
	
	LEFT JOIN InformationRegister.OrderStructure AS RegisterRecords
	ON Demand.Products = RegisterRecords.Products
		AND Demand.Characteristic = RegisterRecords.Characteristic
		AND Demand.WarehouseNeed = RegisterRecords.Warehouse
		AND Demand.Purpose = RegisterRecords.Purpose
		AND Demand.ProductionOrder = RegisterRecords.ProductionOrder
		AND Demand.KeyProducts = RegisterRecords.KeyProducts
WHERE
	NOT TRUE IN (
		SELECT TOP 1
			TRUE
		FROM
			Transfers AS Transfers
		WHERE
			Transfers.Products = Demand.Products
			AND Transfers.Characteristic = Demand.Characteristic
			AND Transfers.WarehouseRelocation = Demand.WarehouseNeed
			AND Transfers.Purpose = Demand.Purpose
			AND Transfers.ProductionOrder = Demand.ProductionOrder
			AND Transfers.KeyProducts = Demand.KeyProducts)

{WHERE
	RegisterRecords.ProductionOrder.* AS ProductionOrder,
	RegisterRecords.Products.* AS Products,
	RegisterRecords.Characteristic.* AS Characteristic,
	Demand.WarehouseNeed.* AS Warehouse,
	RegisterRecords.Purpose.* AS Purpose}

GROUP BY
	Demand.Products,
	Demand.Characteristic,
	Demand.WarehouseNeed,
	Demand.Purpose,
	Demand.ProductionOrder,
	Demand.KeyProducts,
	Demand.Stage,
	Demand.SupplyMethod,
	Demand.SupplyType,
	Demand.DemandDate,
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, DAY),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, WEEK),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, TENDAYS),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, MONTH),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, QUARTER),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, HALFYEAR),
	BEGINOFPERIOD(CASE WHEN Demand.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE Demand.DemandDate END, YEAR)

HAVING
	SUM(RegisterRecords.ToSupply
			+ RegisterRecords.Ordered
			- RegisterRecords.Scheduled
			- RegisterRecords.AllocatedFromAvailableInventory
			- RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
			- RegisterRecords.AllocatedInFreeProductionLots
			- RegisterRecords.AllocatedInAssignedProductionLots
			- RegisterRecords.Replaced) &gt; 0

UNION ALL

// Transfers
SELECT
	NeedParent.Products AS Products,
	NeedParent.Characteristic AS Characteristic,
	NeedParent.WarehouseNeed AS Warehouse,
	NeedParent.Purpose AS Purpose,
	NeedParent.ProductionOrder AS ProductionOrder,
	NeedParent.KeyProducts AS KeyProducts,
	NeedParent.Stage AS Stage,
	NeedParent.SupplyMethod AS SupplyMethod,
	NeedParent.SupplyType AS SupplyType,
	RegisterRecords.ReceiptOrder AS ReceiptOrder,
	NeedParent.DemandDate AS DemandDate,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, YEAR) AS YearPeriod,
	CASE
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
				AND RegisterRecords.ReceiptOrder = UNDEFINED
			THEN DATEADD(NeedParent.DemandDate, DAY,
						DATEDIFF(Transfers.DemandDate, CASE WHEN Transfers.DemandDate &gt;= &amp;CurrentDate THEN Transfers.DemandDate ELSE &amp;CurrentDate END, DAY))
						
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct)
			AND Schedule.Ending IS NOT NULL
			THEN DATEADD(NeedParent.DemandDate, DAY,
						DATEDIFF(Transfers.DemandDate, CASE WHEN Schedule.Ending &gt;= &amp;CurrentDate THEN BEGINOFPERIOD(Schedule.Ending, DAY) ELSE &amp;CurrentDate END, DAY))
		
		WHEN RegisterRecords.DateOfReceipt &lt;&gt; DATETIME(1, 1, 1)
			THEN DATEADD(NeedParent.DemandDate, DAY,
						DATEDIFF(Transfers.DemandDate, CASE WHEN RegisterRecords.DateOfReceipt &gt;= &amp;CurrentDate THEN RegisterRecords.DateOfReceipt ELSE &amp;CurrentDate END, DAY))
						
		ELSE DATETIME(1, 1, 1)
	END AS DateOfReceipt,
	RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
		AND RegisterRecords.ReceiptOrder &lt;&gt; UNDEFINED
		AND RegisterRecords.DateOfReceipt = DATETIME(1, 1, 1) AS DateOfReceiptIsUnknown,
	Transfers.WarehouseRelocation AS WarehouseRelocation,
	Transfers.SupplyMethod AS MethodOfEnsuringMovement,
	Transfers.SupplyType AS TypeOfProvisionMoving,
	CASE
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
				AND RegisterRecords.ReceiptOrder = UNDEFINED
			THEN DATETIME(1, 1, 1)
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct)
			AND Schedule.Ending IS NOT NULL
			THEN BEGINOFPERIOD(Schedule.Ending, DAY)
		WHEN RegisterRecords.DateOfReceipt &lt;&gt; DATETIME(1, 1, 1)
			THEN RegisterRecords.DateOfReceipt
		ELSE DATETIME(1, 1, 1)
	END AS DateOfReceiptTransfer,
	0 AS Required2,
	0 AS InStock,
	0 AS Ordered,
	SUM(RegisterRecords.Scheduled) AS NotOrdered,
	SUM(CASE
		WHEN RegisterRecords.ReceiptOrder = UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory + RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
		ELSE 0
	END + RegisterRecords.Done) AS AvailableMovement,
	SUM(CASE
		WHEN RegisterRecords.ReceiptOrder &lt;&gt; UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory
					+ RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
					+ RegisterRecords.AllocatedInFreeProductionLots
					+ RegisterRecords.AllocatedInAssignedProductionLots
		ELSE 0
	END) AS TransferOrdered
FROM
	Transfers AS Transfers
		
	INNER JOIN Demand AS NeedParent
	ON Transfers.Products = NeedParent.Products
		AND Transfers.Characteristic = NeedParent.Characteristic
		AND Transfers.ConnectionKeyTransfer = NeedParent.KeyProducts
	
	LEFT JOIN InformationRegister.OrderStructure AS RegisterRecords
	ON Transfers.Products = RegisterRecords.Products
		AND Transfers.Characteristic = RegisterRecords.Characteristic
		AND Transfers.WarehouseRelocation = RegisterRecords.Warehouse
		AND Transfers.Purpose = RegisterRecords.Purpose
		AND Transfers.ProductionOrder = RegisterRecords.ProductionOrder
		AND Transfers.KeyProducts = RegisterRecords.KeyProducts
	
	LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS Schedule
	ON RegisterRecords.ProductionOrder = Schedule.ProductionOrder
		AND Schedule.ScheduleStatus = 0
		AND RegisterRecords.Stage = Schedule.Stage
		AND RegisterRecords.KeyLot = Schedule.KeyLot
	
WHERE
	RegisterRecords.LineKind IN (
		VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved),
		VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct))

{WHERE
	RegisterRecords.ProductionOrder.* AS ProductionOrder,
	RegisterRecords.Products.* AS Products,
	RegisterRecords.Characteristic.* AS Characteristic,
	NeedParent.WarehouseNeed.* AS Warehouse,
	RegisterRecords.Purpose.* AS Purpose}

GROUP BY
	NeedParent.Products,
	NeedParent.Characteristic,
	NeedParent.WarehouseNeed,
	NeedParent.Purpose,
	NeedParent.ProductionOrder,
	NeedParent.KeyProducts,
	NeedParent.Stage,
	NeedParent.SupplyMethod,
	NeedParent.SupplyType,
	RegisterRecords.ReceiptOrder,
	NeedParent.DemandDate,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, DAY),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, WEEK),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, TENDAYS),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, MONTH),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, QUARTER),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, HALFYEAR),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, YEAR),
	CASE
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
				AND RegisterRecords.ReceiptOrder = UNDEFINED
			THEN DATEADD(NeedParent.DemandDate, DAY,
						DATEDIFF(Transfers.DemandDate, CASE WHEN Transfers.DemandDate &gt;= &amp;CurrentDate THEN Transfers.DemandDate ELSE &amp;CurrentDate END, DAY))
						
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct)
			AND Schedule.Ending IS NOT NULL
			THEN DATEADD(NeedParent.DemandDate, DAY,
						DATEDIFF(Transfers.DemandDate, CASE WHEN Schedule.Ending &gt;= &amp;CurrentDate THEN BEGINOFPERIOD(Schedule.Ending, DAY) ELSE &amp;CurrentDate END, DAY))
		
		WHEN RegisterRecords.DateOfReceipt &lt;&gt; DATETIME(1, 1, 1)
			THEN DATEADD(NeedParent.DemandDate, DAY,
						DATEDIFF(Transfers.DemandDate, CASE WHEN RegisterRecords.DateOfReceipt &gt;= &amp;CurrentDate THEN RegisterRecords.DateOfReceipt ELSE &amp;CurrentDate END, DAY))
		
		ELSE DATETIME(1, 1, 1)
	END,
	RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
		AND RegisterRecords.ReceiptOrder &lt;&gt; UNDEFINED
		AND RegisterRecords.DateOfReceipt = DATETIME(1, 1, 1),
	Transfers.WarehouseRelocation,
	Transfers.SupplyMethod,
	Transfers.SupplyType,
	CASE
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.Reserved)
				AND RegisterRecords.ReceiptOrder = UNDEFINED
			THEN DATETIME(1, 1, 1)
		WHEN RegisterRecords.LineKind = VALUE(Enum.KindsOfProductionOrderStructureLines.ManufactureSemiFinishedProduct)
			AND Schedule.Ending IS NOT NULL
			THEN BEGINOFPERIOD(Schedule.Ending, DAY)
		WHEN RegisterRecords.DateOfReceipt &lt;&gt; DATETIME(1, 1, 1)
			THEN RegisterRecords.DateOfReceipt
		ELSE DATETIME(1, 1, 1)
	END

HAVING
	SUM(RegisterRecords.AllocatedFromAvailableInventory
			+ RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
			+ RegisterRecords.AllocatedInFreeProductionLots
			+ RegisterRecords.AllocatedInAssignedProductionLots
			+ RegisterRecords.Done) &gt; 0
	OR SUM(RegisterRecords.Scheduled) &gt; 0
	OR SUM(CASE
		WHEN RegisterRecords.ReceiptOrder = UNDEFINED
			THEN RegisterRecords.AllocatedFromAvailableInventory + RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
		ELSE 0
	END + RegisterRecords.Done) &gt; 0

UNION ALL

// Unsecured materials of movement chains
SELECT
	NeedParent.Products AS Products,
	NeedParent.Characteristic AS Characteristic,
	NeedParent.WarehouseNeed AS Warehouse,
	NeedParent.Purpose AS Purpose,
	NeedParent.ProductionOrder AS ProductionOrder,
	NeedParent.KeyProducts AS KeyProducts,
	NeedParent.Stage AS Stage,
	NeedParent.SupplyMethod AS SupplyMethod,
	NeedParent.SupplyType AS SupplyType,
	UNDEFINED AS ReceiptOrder,
	NeedParent.DemandDate AS DemandDate,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, DAY) AS DayPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, YEAR) AS YearPeriod,
	DATETIME(1, 1, 1) AS DateOfReceipt,
	TRUE AS DateOfReceiptIsUnknown,
	Transfers.WarehouseRelocation AS WarehouseRelocation,
	Transfers.SupplyMethod AS MethodOfEnsuringMovement,
	Transfers.SupplyType AS TypeOfProvisionMoving,
	DATETIME(1, 1, 1) AS DateOfReceiptTransfer,
	0 AS Required2,
	0 AS InStock,
	0 AS Ordered,
	SUM(RegisterRecords.ToSupply
			+ RegisterRecords.Ordered
			- RegisterRecords.Scheduled
			- RegisterRecords.AllocatedFromAvailableInventory
			- RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
			- RegisterRecords.AllocatedInFreeProductionLots
			- RegisterRecords.AllocatedInAssignedProductionLots
			- RegisterRecords.Replaced) AS NotOrdered,
	0 AS AvailableMovement,
	0 AS TransferOrdered
FROM
	Transfers AS Transfers
	
	INNER JOIN Demand AS NeedParent
	ON Transfers.Products = NeedParent.Products
		AND Transfers.Characteristic = NeedParent.Characteristic
		AND Transfers.ConnectionKeyTransfer = NeedParent.KeyProducts
	
	LEFT JOIN InformationRegister.OrderStructure AS RegisterRecords
	ON Transfers.Products = RegisterRecords.Products
		AND Transfers.Characteristic = RegisterRecords.Characteristic
		AND Transfers.WarehouseRelocation = RegisterRecords.Warehouse
		AND Transfers.Purpose = RegisterRecords.Purpose
		AND Transfers.ProductionOrder = RegisterRecords.ProductionOrder
		AND Transfers.KeyProducts = RegisterRecords.KeyProducts
	
{WHERE
	RegisterRecords.ProductionOrder.* AS ProductionOrder,
	RegisterRecords.Products.* AS Products,
	RegisterRecords.Characteristic.* AS Characteristic,
	NeedParent.WarehouseNeed.* AS Warehouse,
	RegisterRecords.Purpose.* AS Purpose}

GROUP BY
	NeedParent.Products,
	NeedParent.Characteristic,
	NeedParent.WarehouseNeed,
	NeedParent.Purpose,
	NeedParent.ProductionOrder,
	NeedParent.KeyProducts,
	NeedParent.Stage,
	NeedParent.SupplyMethod,
	NeedParent.SupplyType,
	NeedParent.DemandDate,
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, DAY),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, WEEK),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, TENDAYS),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, MONTH),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, QUARTER),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, HALFYEAR),
	BEGINOFPERIOD(CASE WHEN NeedParent.DemandDate &lt; &amp;CurrentDate THEN &amp;CurrentDate ELSE NeedParent.DemandDate END, YEAR),
	Transfers.WarehouseRelocation,
	Transfers.SupplyMethod,
	Transfers.SupplyType

HAVING
	SUM(RegisterRecords.ToSupply
			+ RegisterRecords.Ordered
			- RegisterRecords.Scheduled
			- RegisterRecords.AllocatedFromAvailableInventory
			- RegisterRecords.AllocatedFromAvailableInventoryWithAssignment
			- RegisterRecords.AllocatedInFreeProductionLots
			- RegisterRecords.AllocatedInAssignedProductionLots
			- RegisterRecords.Replaced) &gt; 0</query>
	</dataSet>
	<calculatedField>
		<dataPath>PercentageIsNotOnTime</dataPath>
		<expression/>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>% overdue</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>درصد سررسیدگذشته</v8:content>
			</v8:item>
