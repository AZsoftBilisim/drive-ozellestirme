			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Tedarik kaynağı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Nguồn đảm bảo</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>SourceOfProvisionMoving</dataPath>
		<expression>Case
  When WarehouseRelocation = Undefined
    Then Undefined
	When ReceiptOrder = Undefined
		Then Case
				When MethodOfEnsuringMovement = Value(Catalog.ProcurementStrategies.EmptyRef)
					Then TypeOfProvisionMoving
				Else MethodOfEnsuringMovement
			End
	Else ReceiptOrder 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
