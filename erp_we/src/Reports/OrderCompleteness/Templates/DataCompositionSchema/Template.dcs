				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Etap</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Этап</v8:content>
				</v8:item>
