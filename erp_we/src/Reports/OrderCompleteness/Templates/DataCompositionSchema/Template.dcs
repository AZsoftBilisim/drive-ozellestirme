	<calculatedField>
		<dataPath>OrderedOnTime</dataPath>
		<expression>Case
	When DateOfReceipt &lt;= DemandDate
			And &amp;CurrentDate &lt;= DemandDate
			And DateOfReceiptIsUnknown = False
		Then Ordered + TransferOrdered
	Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Will be on time (ordered)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>به‌موقع خواهد بود (سفارش‌داده‌شده)</v8:content>
