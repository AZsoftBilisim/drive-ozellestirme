				<v8:lang>tr</v8:lang>
				<v8:content>Gecikme, günler</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Chậm trễ, ngày</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>SupplySource</dataPath>
		<expression>Case
	When ReceiptOrder = Undefined
                  Or WarehouseRelocation &lt;&gt; Undefined
		Then Case
				When SupplyMethod = Value(Catalog.ProcurementStrategies.EmptyRef)
					Then SupplyType
				Else SupplyMethod
			End
	Else ReceiptOrder 
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Source of supply</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>منبع تأمین</v8:content>
			</v8:item>
