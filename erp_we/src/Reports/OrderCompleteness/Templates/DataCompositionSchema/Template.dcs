			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>InactivityPeriod</dataPath>
		<expression>Case
	When Ordered+TransferOrdered+NotOrdered &lt;&gt; 0
			And DateOfReceipt &gt; DemandDate
		Then DateDiff(DemandDate, DateOfReceipt, "Day")
	When Ordered+TransferOrdered+NotOrdered &lt;&gt; 0
			And &amp;CurrentDate &gt; DemandDate
		Then DateDiff(DemandDate, &amp;CurrentDate, "Day")
	Else
		0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Delay, days</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تأخیر، روز</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Ritardo, giorni</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Opóźnienie, dni</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
