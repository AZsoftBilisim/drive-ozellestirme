	<calculatedField>
		<dataPath>OnTime</dataPath>
		<expression>Case
	When DateOfReceipt &lt;= DemandDate
			And &amp;CurrentDate &lt;= DemandDate
                    And DateOfReceiptIsUnknown = False
		Then Ordered+TransferOrdered+NotOrdered
	Else 0
End</expression>
