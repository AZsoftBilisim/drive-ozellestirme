	<totalField>
		<dataPath>InStock</dataPath>
		<expression>Sum(InStock)</expression>
	</totalField>
	<totalField>
		<dataPath>InactivityPeriod</dataPath>
		<expression>Max (EvalExpressionWithGroupArray ("Max(
	Case
		When DateOfReceipt &gt; DemandDate
			Then DateDiff(DemandDate, DateOfReceipt, ""Day"")
		Else DateDiff(DemandDate, &amp;CurrentDate, ""Day"")
	End)", "KeyProducts, DateOfReceipt", "Ordered+TransferOrdered+NotOrdered &lt;&gt; 0 And (DateOfReceipt &gt; DemandDate Or &amp;CurrentDate &gt; DemandDate)", "Sum(Ordered+TransferOrdered+NotOrdered) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageAvailable</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(InStock) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>InterestOnTime</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(OnTime) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageIsNotOnTime</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(NotOnTime) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>AvailableMovement</dataPath>
		<expression>Sum(AvailableMovement)</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOrderedOnTime</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(OrderedOnTime) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOrderedOutOfTime</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(OrderedOutOfTime) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageNotOrderedOnTime</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(NotOrderedOnTime) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageNotOrderedNotOnTime</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(NotOrderedOutOfTime) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOrdered</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(Ordered) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageNotOrdered</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(NotOrdered) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>OnTime</dataPath>
		<expression>Sum(OnTime)</expression>
	</totalField>
	<totalField>
		<dataPath>NotOnTime</dataPath>
		<expression>Sum(NotOnTime)</expression>
	</totalField>
	<totalField>
		<dataPath>Ordered</dataPath>
		<expression>Sum(Ordered)</expression>
	</totalField>
	<totalField>
		<dataPath>NotOrdered</dataPath>
		<expression>Sum(NotOrdered)</expression>
	</totalField>
	<totalField>
		<dataPath>OrderedOnTime</dataPath>
		<expression>Sum(OrderedOnTime)</expression>
	</totalField>
	<totalField>
		<dataPath>OrderedOutOfTime</dataPath>
		<expression>Sum(OrderedOutOfTime)</expression>
	</totalField>
	<totalField>
		<dataPath>NotOrderedOnTime</dataPath>
		<expression>Sum(NotOrderedOnTime)</expression>
	</totalField>
	<totalField>
		<dataPath>NotOrderedOutOfTime</dataPath>
		<expression>Sum(NotOrderedOutOfTime)</expression>
	</totalField>
	<totalField>
		<dataPath>Required2</dataPath>
		<expression>Sum(Required2)</expression>
	</totalField>
	<totalField>
		<dataPath>TransferOrdered</dataPath>
		<expression>Sum(TransferOrdered)</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfAvailableMovement</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(AvailableMovement) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOrderedMove</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(TransferOrdered) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageAvailableAmount</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(InStock+AvailableMovement) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOrderedAmount</dataPath>
		<expression>Avg(EvalExpressionWithGroupArray("Sum(Ordered+TransferOrdered) / Sum(Required2) * 100", "Products, Characteristic, Warehouse, Purpose",, "Sum(Required2) &gt; 0"))</expression>
	</totalField>
