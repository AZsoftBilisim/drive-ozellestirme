		<dataSource>DataSource1</dataSource>
		<query>SELECT
	PostOperativeSchedule.PlanningModel AS PlanningModel,
	PostOperativeSchedule.Stage AS Stage,
	PostOperativeSchedule.Stage.ActualStageEnd AS StageActualEnd,
	MAX(PostOperativeSchedule.Ending) AS TimetableEnd,
	SUM(CASE
			WHEN NOT PostOperativeSchedule.ThisIsChangeover
				THEN PostOperativeSchedule.TimePlan
			ELSE 0
		END) AS LoadSeconds,
	SUM(CASE
			WHEN PostOperativeSchedule.ThisIsChangeover
				THEN PostOperativeSchedule.TimePlan
			ELSE 0
		END) AS ChangeoverSeconds,
	SUM(PostOperativeSchedule.TransferTime) AS TransfersSeconds,
	SUM(CASE
			WHEN NOT PostOperativeSchedule.ThisIsChangeover
				THEN PostOperativeSchedule.TimePlan / 3600 * PostOperativeSchedule.WorkCenter.RateWork
			WHEN PostOperativeSchedule.ThisIsChangeover
				THEN PostOperativeSchedule.TimePlan / 3600 * PostOperativeSchedule.WorkCenter.RateChangeover
			ELSE 0
		END) AS Cost,
	ScheduleOfProductionStages2_2.Ending AS StageFinish
FROM
	InformationRegister.PostOperativeSchedule2_2 AS PostOperativeSchedule
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ScheduleOfProductionStages2_2
		ON PostOperativeSchedule.Stage = ScheduleOfProductionStages2_2.Stage
			AND (ScheduleOfProductionStages2_2.ScheduleStatus = 0)
WHERE
	PostOperativeSchedule.TimetableModel = &amp;TimetableModel
	AND PostOperativeSchedule.Modeling = TRUE
	AND PostOperativeSchedule.ThisIsOperationDeletion = FALSE

GROUP BY
	PostOperativeSchedule.PlanningModel,
	PostOperativeSchedule.Stage,
	PostOperativeSchedule.Stage.ActualStageEnd,
	ScheduleOfProductionStages2_2.Ending</query>
	</dataSet>
