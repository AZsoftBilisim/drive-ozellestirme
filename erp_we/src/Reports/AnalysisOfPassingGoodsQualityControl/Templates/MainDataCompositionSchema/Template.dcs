		<dataSource>DataSource1</dataSource>
		<query>// A role has been added to the Quality Management profile for the report to work
// Readinginformation to partners

SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Register3.Ref AS Ref,
	Register3.IBDocumentDate AS IBDocumentDate
INTO ActsWithRegisteredRecords
FROM
	InformationRegister.DocumentsRegistry AS Register3
WHERE
	NOT Register3.AdditionalRecord
	AND Register3.Posted
	AND Register3.RefType = &amp;MetadataIdentifierQualityControlReport
	AND Register3.Status &lt;&gt; VALUE(Enum.StatusesOfQualityControlCertificates.InProgress)
{WHERE Register3.IBDocumentDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod}
INDEX BY
	Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsInWarehousesTurnover.Period AS Period,
	GoodsInWarehousesTurnover.Products AS Products,
	GoodsInWarehousesTurnover.Characteristic AS Characteristic,
	GoodsInWarehousesTurnover.Purpose AS Purpose,
	GoodsInWarehousesTurnover.Series AS Series,
	GoodsInWarehousesTurnover.ControlledLotReference AS ControlledLotReference,
	GoodsInWarehousesTurnover.Recorder AS Recorder,
	GoodsInWarehousesTurnover.InStockTurnover AS InStockTurnover
INTO GoodsInWarehousesTurnover
FROM
	AccumulationRegister.ProductStock.Turnovers({&amp;BeginOfPeriod}, {&amp;EndOfPeriod}, Recorder,
		ControlledLotReference &lt;&gt; VALUE(Catalog.ControlledLots.EmptyRef)
		{(Products, Characteristic) IN(
				SELECT
					FilterTable.Products AS Products,
					FilterTable.Characteristic AS Characteristic
				FROM
					SelectionByProductSegment AS FilterTable
				WHERE
					FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
		{Products.* AS Products,
			Characteristic.* AS Characteristic,
			Purpose.* AS Purpose,
			Series.* AS Series,
			ControlledLotReference.* AS ControlledLotReference}) AS GoodsInWarehousesTurnover
INDEX BY
	Products, Characteristic, Purpose, Series, ControlledLotReference
;
/////////////////////////////////////////////////////////////
SELECT ALLOWED
	Table.Ref AS Ref,
	Table.Warehouse AS Warehouse,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Package AS Package,
	Table.Series AS Series,
	Table.Action AS Action,
	Table.Count Count
INTO DocumentDataTableItems
FROM
	ActsWithRegisteredRecords AS ActsWithRegisteredRecords
		
		INNER JOIN Document.GoodsQualityControlCertificate.Goods AS Table
		ON Table.Ref = ActsWithRegisteredRecords.Ref
{WHERE
	Table.Ref.ControlledLotReference.Partner.* AS Vendor,
	Table.Ref.ControlledLotReference.Contract.* AS Contract,
	Table.Ref.ControlledLotReference.Lot AS DocumentInflow}
{WHERE
	(Table.Products, Table.Characteristic) IN(
		SELECT
			FilterTable.Products AS Products,
			FilterTable.Characteristic AS Characteristic
		FROM
			SelectionByProductSegment AS FilterTable
		WHERE
			FilterTable.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)}
{WHERE
	Table.Products.* AS Products,
	Table.Characteristic.* AS Characteristic,
	Table.Purpose.* AS Purpose,
	Table.Series.* AS Series,
	Table.Ref.ControlledLotReference.* AS ControlledLotReference}
;

/////////////////////////////////////////////////////////////
SELECT
	Goods.Ref AS Ref,
	Goods.Warehouse AS Warehouse,
	Goods.Products AS Products,
	Goods.Characteristic AS Characteristic,
	Goods.Purpose AS Purpose,
	Goods.Series AS Series,
	Goods.Action AS Action,
	Goods.Count Count
INTO DocumentDataGoodsTableCollapseProductLocations
FROM
	DocumentDataTableItems AS Goods
WHERE
	ISNULL(CAST(Goods.Package AS Catalog.PackagesAndUnitsOfMeasure).PackageType,
		UNDEFINED) &lt;&gt; VALUE(Enum.TypesOfItemsPackages.CargoItem)

UNION ALL

SELECT
	Components.Ref AS Ref,
	Components.Warehouse AS Warehouse,
	Components.Products AS Products,
	Components.Characteristic AS Characteristic,
	Components.Purpose AS Purpose,
	Components.Series AS Series,
	Components.Action AS Action,
	MIN(Components.Count) AS Count
FROM(
	SELECT
		Goods.Ref AS Ref,
		Goods.Warehouse AS Warehouse,
		Goods.Products AS Products,
		Goods.Characteristic AS Characteristic,
		Goods.Purpose AS Purpose,
		Goods.Series AS Series,
		Goods.Action AS Action,
		SUM(Goods.Count) AS Count
FROM
	DocumentDataTableItems AS Goods
WHERE
	CAST(Goods.Package AS Catalog.PackagesAndUnitsOfMeasure).PackageType
		= VALUE(Enum.TypesOfItemsPackages.CargoItem)
	GROUP BY
		Goods.Ref,
		Goods.Warehouse,
		Goods.Products,
		Goods.Characteristic,
		Goods.Purpose,
		Goods.Series,
		Goods.Action) AS Components
	GROUP BY
		Components.Ref,
		Components.Warehouse,
		Components.Products,
		Components.Characteristic,
		Components.Purpose,
		Components.Series,
		Components.Action
INDEX BY
	Products
;

/////////////////////////////////////////////////////////////
SELECT ALLOWED
	Table.Period AS Period,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Series AS Series,
	Table.ControlledLotReference AS ControlledLotReference,
	Table.ControlledLotReference.Partner AS Vendor,
	Table.ControlledLotReference.Contract AS Contract,
	Table.ControlledLotReference.Lot AS DocumentInflow,
	Table.Recorder AS Recorder,
	Table.InStockTurnover * &amp;TextOfQuantityUnit AS Received,
	Table.InStockTurnover * &amp;QueryTextItemWeight AS ReceivedWeight,
	Table.InStockTurnover * &amp;QueryTextTheVolumeOfTheItem AS ReceivedVolume_,
	Table.InStockTurnover * &amp;TextOfQuantityUnit AS UnderControl,
	Table.InStockTurnover * &amp;QueryTextItemWeight AS OnWeightControl,
	Table.InStockTurnover * &amp;QueryTextTheVolumeOfTheItem AS VolumeIsUnderControl,
	0 AS WasPassed,
	0 AS WeightPassed,
	0 AS VolumePassed,
	0 AS ChangeQuality,
	0 AS ChangeQualityWeight,
	0 AS ChangeQualityVolume,
	0 AS ToReturnToVendor,
	0 AS ReturnWeightToSupplier,
	0 AS ReturnVolumeToSupplier,
	0 AS DoNotReceiveGoods,
	0 AS DoNotReceiveGoodsByWeight,
	0 AS DoNotReceiveGoodsVolume,
	0 AS MoveTo,
	0 AS MoveWeight,
	0 AS MoveVolume,
	0 AS AwaitingDecision,
	0 AS WeightIsAwaitingDecision,
	0 AS AwaitingDecisionVolume
{SELECT
	Products.* AS Products,
	Characteristic.* AS Characteristic,
	Purpose.* AS Purpose,
	Series.* AS Series,
	ControlledLotReference.* AS ControlledLotReference,
	Vendor.* AS Vendor,
	Contract.* AS Contract,
	DocumentInflow AS DocumentInflow,
	Recorder AS Recorder,
	Received AS Received,
	ReceivedWeight AS ReceivedWeight,
	ReceivedVolume_ AS ReceivedVolume_,
	UnderControl AS UnderControl,
	OnWeightControl AS OnWeightControl,
	VolumeIsUnderControl AS VolumeIsUnderControl,
	WasPassed AS WasPassed,
	WeightPassed AS WeightPassed,
	VolumePassed AS VolumePassed,
	ChangeQuality AS ChangeQuality,
	ChangeQualityWeight AS ChangeQualityWeight,
	ChangeQualityVolume AS ChangeQualityVolume,
	ToReturnToVendor AS ToReturnToVendor,
	ReturnWeightToSupplier AS ReturnWeightToSupplier,
	ReturnVolumeToSupplier AS ReturnVolumeToSupplier,
	DoNotReceiveGoods AS DoNotReceiveGoods,
	DoNotReceiveGoodsByWeight AS DoNotReceiveGoodsByWeight,
	DoNotReceiveGoodsVolume AS DoNotReceiveGoodsVolume,
	MoveTo AS MoveTo,
	MoveWeight AS MoveWeight,
	MoveVolume AS MoveVolume,
	AwaitingDecision AS AwaitingDecision,
	WeightIsAwaitingDecision AS WeightIsAwaitingDecision,
	AwaitingDecisionVolume AS AwaitingDecisionVolume}
FROM
	GoodsInWarehousesTurnover AS Table
{WHERE
	Table.ControlledLotReference.Partner.* AS Vendor,
	Table.ControlledLotReference.Contract.* AS Contract,
	Table.ControlledLotReference.Lot AS DocumentInflow}
WHERE
	NOT VALUETYPE(Table.Recorder) IN(
		TYPE(Document.GoodsQualityControlCertificate),
		TYPE(Document.GoodsDamage),
		TYPE(Document.WriteOffOfGoodsShortages))
	AND NOT TRUE IN(
	SELECT TOP 1
		TRUE ThisIsReturnOnQualityControlCertificate
	FROM
		Document.GoodsIssueNote AS Orders_3
	WHERE
		Orders_3.Ref = Table.Recorder
			AND Orders_3.WarehouseOperation = VALUE(Enum.WarehouseTransactions.ShipmentUnderReturnToVendor))
	
UNION ALL

SELECT
	Table.Ref.Date AS Period,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Series AS Series,
	Table.Ref.ControlledLotReference AS ControlledLotReference,
	Table.Ref.ControlledLotReference.Partner AS Vendor,
	Table.Ref.ControlledLotReference.Contract AS Contract,
	Table.Ref.ControlledLotReference.Lot AS DocumentInflow,
	Table.Ref AS Recorder,
	0 AS Received,
	0 AS ReceivedWeight,
	0 AS ReceivedVolume_,
	- Table.Count * &amp;TextOfQuantityUnit AS UnderControl,
	- Table.Count * &amp;QueryTextItemWeight AS OnWeightControl,
	- Table.Count * &amp;QueryTextTheVolumeOfTheItem AS VolumeIsUnderControl,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.Unlock)
			THEN Table.Count * &amp;TextOfQuantityUnit
		ELSE 0
	END AS WasPassed,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.Unlock)
			THEN Table.Count * &amp;QueryTextItemWeight
		ELSE 0
	END AS WeightPassed,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.Unlock)
			THEN Table.Count * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS VolumePassed,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ChangeQuality),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterStockQualityChange))
			THEN Table.Count * &amp;TextOfQuantityUnit
		ELSE 0
	END AS ChangeQuality,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ChangeQuality),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterStockQualityChange))
			THEN Table.Count * &amp;QueryTextItemWeight
		ELSE 0
	END AS ChangeQualityWeight,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ChangeQuality),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterStockQualityChange))
			THEN Table.Count * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS ChangeQualityVolume,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ToReturnToVendor),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterReturn))
			THEN Table.Count * &amp;TextOfQuantityUnit
		ELSE 0
	END AS ToReturnToVendor,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ToReturnToVendor),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterReturn))
			THEN Table.Count * &amp;QueryTextItemWeight
		ELSE 0
	END AS ReturnWeightToSupplier,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ToReturnToVendor),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterReturn))
			THEN Table.Count * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS ReturnVolumeToSupplier,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.DoNotReceiveGoods),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.MakeDebit))
			THEN Table.Count * &amp;TextOfQuantityUnit
		ELSE 0
	END AS DoNotReceiveGoods,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.DoNotReceiveGoods),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.MakeDebit))
			THEN Table.Count * &amp;QueryTextItemWeight
		ELSE 0
	END AS DoNotReceiveGoodsByWeight,
	CASE
		WHEN Table.Action IN(
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.DoNotReceiveGoods),
			VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.MakeDebit))
			THEN Table.Count * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS DoNotReceiveGoodsVolume,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterGoodsTransfer)
			THEN Table.Count * &amp;TextOfQuantityUnit
		ELSE 0
	END AS MoveTo,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterGoodsTransfer)
			THEN Table.Count * &amp;QueryTextItemWeight
		ELSE 0
	END AS MoveWeight,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.RegisterGoodsTransfer)
			THEN Table.Count * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS MoveVolume,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.EmptyRef)
			THEN Table.Count * &amp;TextOfQuantityUnit
		ELSE 0
	END AS AwaitingDecision,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.EmptyRef)
			THEN Table.Count * &amp;QueryTextItemWeight
		ELSE 0
	END AS WeightIsAwaitingDecision,
	CASE
		WHEN Table.Action = VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.EmptyRef)
			THEN Table.Count * &amp;QueryTextTheVolumeOfTheItem
		ELSE 0
	END AS AwaitingDecisionVolume
FROM
	ActsWithRegisteredRecords AS ActsWithRegisteredRecords
		
		INNER JOIN DocumentDataGoodsTableCollapseProductLocations AS Table
		ON Table.Ref = ActsWithRegisteredRecords.Ref
		
UNION ALL

// Actions to return, not to arrive, or to change the quality lead to discrepancies (non-delivery).
// In non-random warehouses, the shortfall will be reflected by reducing the arrival of the item to the warehouse will be corrected by the act of discrepancies, direct reduction of the invoice, adjustment of the purchase, or recalculation in the warehouse.
// It is necessary to increase the arrival at the warehouse and control.
// In the order warehouse, the under-delivery is reflected by the quality control act.
SELECT
	Table.Ref.Date AS Period,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Series AS Series,
	Table.Ref.ControlledLotReference AS ControlledLotReference,
	Table.Ref.ControlledLotReference.Partner AS Vendor,
	Table.Ref.ControlledLotReference.Contract AS Contract,
	Table.Ref.ControlledLotReference.Lot AS DocumentInflow,
	Table.Ref AS Recorder,
	- Table.Count * &amp;TextOfQuantityUnit AS Received,
	- Table.Count * &amp;QueryTextItemWeight AS ReceivedWeight,
	- Table.Count * &amp;QueryTextTheVolumeOfTheItem AS ReceivedVolume_,
	- Table.Count * &amp;TextOfQuantityUnit AS UnderControl,
	- Table.Count * &amp;QueryTextItemWeight AS OnWeightControl,
	- Table.Count * &amp;QueryTextTheVolumeOfTheItem AS VolumeIsUnderControl,
	0 AS WasPassed,
	0 AS WeightPassed,
	0 AS VolumePassed,
	0 AS ChangeQuality,
	0 AS ChangeQualityWeight,
	0 AS ChangeQualityVolume,
	0 AS ToReturnToVendor,
	0 AS ReturnWeightToSupplier,
	0 AS ReturnVolumeToSupplier,
	0 AS DoNotReceiveGoods,
	0 AS DoNotReceiveGoodsByWeight,
	0 AS DoNotReceiveGoodsVolume,
	0 AS MoveTo,
	0 AS MoveWeight,
	0 AS MoveVolume,
	0 AS AwaitingDecision,
	0 AS WeightIsAwaitingDecision,
	0 AS AwaitingDecisionVolume
FROM
	ActsWithRegisteredRecords AS ActsWithRegisteredRecords
		
		INNER JOIN DocumentDataGoodsTableCollapseProductLocations AS Table
		ON Table.Ref = ActsWithRegisteredRecords.Ref
WHERE
	Table.Action IN(
		VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ToReturnToVendor),
		VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ChangeQuality),
		VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.DoNotReceiveGoods))
	AND Table.Warehouse.UseWarehouseManagemantSystemForGoodsReceipt
	AND Table.Warehouse.StartDateOfWarehouseManagemantSystemForGoodsReceipt &lt;= Table.Ref.Date
	
UNION ALL
	
SELECT
	Table.Ref.Date AS Period,
	Table.Products AS Products,
	Table.Characteristic AS Characteristic,
	Table.Purpose AS Purpose,
	Table.Series AS Series,
	Table.Ref.ControlledLotReference AS ControlledLotReference,
	Table.Ref.ControlledLotReference.Partner AS Vendor,
	Table.Ref.ControlledLotReference.Contract AS Contract,
	Table.Ref.ControlledLotReference.Lot AS DocumentInflow,
	Table.Ref AS Recorder,
	Table.Count * &amp;TextOfQuantityUnit AS Received,
	Table.Count * &amp;QueryTextItemWeight AS ReceivedWeight,
	Table.Count * &amp;QueryTextTheVolumeOfTheItem AS ReceivedVolume_,
	Table.Count * &amp;TextOfQuantityUnit AS UnderControl,
	Table.Count * &amp;QueryTextItemWeight AS OnWeightControl,
	Table.Count * &amp;QueryTextTheVolumeOfTheItem AS VolumeIsUnderControl,
	0 AS WasPassed,
	0 AS WeightPassed,
	0 AS VolumePassed,
	0 AS ChangeQuality,
	0 AS ChangeQualityWeight,
	0 AS ChangeQualityVolume,
	0 AS ToReturnToVendor,
	0 AS ReturnWeightToSupplier,
	0 AS ReturnVolumeToSupplier,
	0 AS DoNotReceiveGoods,
	0 AS DoNotReceiveGoodsByWeight,
	0 AS DoNotReceiveGoodsVolume,
	0 AS MoveTo,
	0 AS MoveWeight,
	0 AS MoveVolume,
	0 AS AwaitingDecision,
	0 AS WeightIsAwaitingDecision,
	0 AS AwaitingDecisionVolume
FROM
	ActsWithRegisteredRecords AS ActsWithRegisteredRecords
		
		INNER JOIN DocumentDataGoodsTableCollapseProductLocations AS Table
		ON Table.Ref = ActsWithRegisteredRecords.Ref
WHERE
	Table.Action IN(
		VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ToReturnToVendor),
		VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.ChangeQuality),
		VALUE(Enum.ActionsOnGoodsInQualityControlCertificate.DoNotReceiveGoods))</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		Products.UnitOfMeasure
	When &amp;QuantityUnits = 1 Then
		Products.UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Unit</v8:content>
			</v8:item>
