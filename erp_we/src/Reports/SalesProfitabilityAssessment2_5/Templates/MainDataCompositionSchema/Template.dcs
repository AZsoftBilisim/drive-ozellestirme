		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CurrencyExchangeRate.Currency AS Currency,
	CurrencyExchangeRate.CourseNumerator * ReportCurrencyRate.CourseDenominator / (CurrencyExchangeRate.CourseDenominator *
		ReportCurrencyRate.CourseNumerator) AS ConversionFactor_
INTO ExchangeRates
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;DocumentDate, BaseCurrency = &amp;BaseCurrency) AS CurrencyExchangeRate
		INNER JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;DocumentDate, Currency = &amp;Currency
		AND BaseCurrency = &amp;BaseCurrency) AS ReportCurrencyRate
		ON (TRUE)
WHERE
	CurrencyExchangeRate.CourseDenominator &lt;&gt; 0
	AND ReportCurrencyRate.CourseNumerator &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DocumentGoods.Ref AS Ref,
	DocumentGoods.Date AS DocumentDate,
	DocumentGoods.Currency AS DocumentCurrency,
	DocumentGoods.LineNumber AS LineNumber,
	DocumentGoods.Products AS Products,
	DocumentGoods.Characteristic AS Characteristic,
	DocumentGoods.Warehouse AS Warehouse,
	DocumentGoods.Package AS Package,
	DocumentGoods.DocumentPriceType AS DocumentPriceType,
	DocumentGoods.DocumentPrice AS DocumentPrice,
	DocumentGoods.Sum AS Sum,
	DocumentGoods.Count AS Count,
	DocumentGoods.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
	DocumentGoods.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
	DocumentGoods.DiscountMarkupAmount AS DiscountMarkupAmount,
	DocumentGoods.ManualDiscount AS ManualDiscount,
	DocumentGoods.VATRate AS VATRate,
	DocumentGoods.VATAmount AS VATAmount
INTO DocumentGoods
FROM
	(SELECT
		DocumentsTable.Ref AS Ref,
		DocumentsTable.Date AS Date,
		DocumentsTable.Currency AS Currency,
		CustomerOrderGoods.LineNumber AS LineNumber,
		CustomerOrderGoods.Products AS Products,
		CustomerOrderGoods.Characteristic AS Characteristic,
		CustomerOrderGoods.Warehouse AS Warehouse,
		CustomerOrderGoods.Package AS Package,
		CustomerOrderGoods.PriceKind AS DocumentPriceType,
		CustomerOrderGoods.Price AS DocumentPrice,
		CustomerOrderGoods.Sum AS Sum,
		CustomerOrderGoods.NumberOfPackages AS Count,
		CustomerOrderGoods.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
		CustomerOrderGoods.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
		CustomerOrderGoods.DiscountMarkupAmount AS DiscountMarkupAmount,
		CustomerOrderGoods.ManualDiscount AS ManualDiscount,
		CustomerOrderGoods.VATRate AS VATRate,
		CustomerOrderGoods.VATAmount AS VATAmount
	FROM
		Document.SalesOrder.Goods AS CustomerOrderGoods
			INNER JOIN Document.SalesOrder AS DocumentsTable
			ON DocumentsTable.Ref = &amp;Document
			AND CustomerOrderGoods.Ref = DocumentsTable.Ref
			AND NOT CustomerOrderGoods.Canceled
	WHERE
		VALUETYPE(&amp;Document) = TYPE(Document.SalesOrder)

	UNION

	SELECT
		DocumentsTable.Ref,
		DocumentsTable.Date,
		DocumentsTable.Currency,
		SalesOfGoodsServicesGoods.LineNumber,
		SalesOfGoodsServicesGoods.Products,
		SalesOfGoodsServicesGoods.Characteristic,
		SalesOfGoodsServicesGoods.Warehouse,
		SalesOfGoodsServicesGoods.Package,
		SalesOfGoodsServicesGoods.PriceKind,
		SalesOfGoodsServicesGoods.Price,
		SalesOfGoodsServicesGoods.Sum,
		SalesOfGoodsServicesGoods.NumberOfPackages,
		SalesOfGoodsServicesGoods.PercentRateOfAutomaticDiscountMarkup,
		SalesOfGoodsServicesGoods.PercentRateOfManualDiscount,
		SalesOfGoodsServicesGoods.DiscountMarkupAmount AS DiscountMarkupAmount,
		SalesOfGoodsServicesGoods.ManualDiscount AS ManualDiscount,
		SalesOfGoodsServicesGoods.VATRate,
		SalesOfGoodsServicesGoods.VATAmount
	FROM
		Document.CustomerInvoice.Goods AS SalesOfGoodsServicesGoods
			INNER JOIN Document.CustomerInvoice AS DocumentsTable
			ON DocumentsTable.Ref = &amp;Document
			AND SalesOfGoodsServicesGoods.Ref = DocumentsTable.Ref
	WHERE
		VALUETYPE(&amp;Document) = TYPE(Document.CustomerInvoice)

	UNION

	SELECT
		DocumentsTable.Ref,
		DocumentsTable.Date,
		DocumentsTable.Currency,
		RequestForReturnOfGoodsFromCustomerGoods.LineNumber,
		RequestForReturnOfGoodsFromCustomerGoods.Products,
		RequestForReturnOfGoodsFromCustomerGoods.Characteristic,
		DocumentsTable.Warehouse,
		RequestForReturnOfGoodsFromCustomerGoods.Package,
		RequestForReturnOfGoodsFromCustomerGoods.PriceKind,
		RequestForReturnOfGoodsFromCustomerGoods.Price,
		RequestForReturnOfGoodsFromCustomerGoods.Sum,
		RequestForReturnOfGoodsFromCustomerGoods.NumberOfPackages,
		RequestForReturnOfGoodsFromCustomerGoods.PercentRateOfAutomaticDiscountMarkup,
		RequestForReturnOfGoodsFromCustomerGoods.PercentRateOfManualDiscount,
		RequestForReturnOfGoodsFromCustomerGoods.DiscountMarkupAmount AS DiscountMarkupAmount,
		RequestForReturnOfGoodsFromCustomerGoods.ManualDiscount AS ManualDiscount,
		RequestForReturnOfGoodsFromCustomerGoods.VATRate,
		RequestForReturnOfGoodsFromCustomerGoods.VATAmount
	FROM
		Document.RequestForReturnOfGoodsFromCustomer.SubstituteGoods AS RequestForReturnOfGoodsFromCustomerGoods
			INNER JOIN Document.RequestForReturnOfGoodsFromCustomer AS DocumentsTable
			ON DocumentsTable.Ref = &amp;Document
			AND RequestForReturnOfGoodsFromCustomerGoods.Ref = DocumentsTable.Ref
			AND NOT RequestForReturnOfGoodsFromCustomerGoods.Canceled
	WHERE
		VALUETYPE(&amp;Document) = TYPE(Document.RequestForReturnOfGoodsFromCustomer)
		AND &amp;SubstitutionOfTextOfLocalizationDocumentRequest) AS DocumentGoods
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	DocumentGoods.LineNumber AS LineNumber,
	DocumentGoods.Products AS Products,
	DocumentGoods.Characteristic AS Characteristic,
	ISNULL(CASE
		WHEN
			ItemKinds.SettingsOfPriceKeyByItemVariant = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)
		ELSE DocumentGoods.Characteristic.ItemsCharacteristicForPricing
	END, VALUE(Catalog.ItemsCharacteristicsForPricing.EmptyRef)) AS PricingVariant,
	VALUE(Catalog.ItemsBatchesForPricing.EmptyRef) AS PricingBatch,
	CASE
		WHEN ItemKinds.SettingsOfPriceKeyByPackage = VALUE(Enum.FilterOptionForPriceKey.DontUse)
			THEN VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
		ELSE DocumentGoods.Package
	END AS PricingPackage,
	DocumentGoods.Package AS Package
INTO GoodsOfDocumentAreSupplemented
FROM
	DocumentGoods AS DocumentGoods
		LEFT JOIN Catalog.ItemKinds AS ItemKinds
		ON ItemKinds.Ref = DocumentGoods.Products.ProductKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	SalesPrices.Products AS Products,
	GoodsOfDocumentAreSupplemented.Characteristic AS Characteristic,
	SalesPrices.PriceKind AS SellingPriceType,
	SalesPrices.Currency AS Currency,
	CAST(SalesPrices.Price * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2)) AS Price,
	SalesPrices.Package AS Package
INTO SalesPrices
FROM
	InformationRegister.ItemsPrices25.SliceLast(ENDOFPERIOD(&amp;DocumentDate, DAY), &amp;SalePrices = 2
	AND (Products, PricingVariant, PricingBatch, PricingPackage) IN
		(SELECT
			GoodsOfDocumentAreSupplemented.Products,
			GoodsOfDocumentAreSupplemented.PricingVariant,
			GoodsOfDocumentAreSupplemented.PricingBatch,
			GoodsOfDocumentAreSupplemented.PricingPackage
		FROM
			GoodsOfDocumentAreSupplemented) {(PriceKind = &amp;PriceKind)}) AS SalesPrices
		LEFT JOIN GoodsOfDocumentAreSupplemented AS GoodsOfDocumentAreSupplemented
		ON SalesPrices.Products = GoodsOfDocumentAreSupplemented.Products
		AND SalesPrices.PricingVariant = GoodsOfDocumentAreSupplemented.PricingVariant
		AND SalesPrices.PricingBatch = GoodsOfDocumentAreSupplemented.PricingBatch
		AND SalesPrices.PricingPackage = GoodsOfDocumentAreSupplemented.PricingPackage
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON SalesPrices.Currency = ExchangeRates.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	PlannedPrices_.Products AS Products,
	GoodsOfDocumentAreSupplemented.Characteristic AS Characteristic,
	PlannedPrices_.PriceKind AS NormativeTypeOfPrice,
	PlannedPrices_.Currency AS Currency,
	CAST(PlannedPrices_.Price * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2)) AS Price,
	PlannedPrices_.Package AS Package
INTO PlannedPrices_
FROM
	InformationRegister.ItemsPrices25.SliceLast(ENDOFPERIOD(&amp;DocumentDate, DAY),
		PriceKind = (CAST(&amp;StandardPriceType AS Catalog.TypesOfPrices))
	AND (Products, PricingVariant, PricingBatch, PricingPackage) IN
		(SELECT
			GoodsOfDocumentAreSupplemented.Products,
			GoodsOfDocumentAreSupplemented.PricingVariant,
			GoodsOfDocumentAreSupplemented.PricingBatch,
			GoodsOfDocumentAreSupplemented.PricingPackage
		FROM
			GoodsOfDocumentAreSupplemented)
	AND
		&amp;GoodsCostWhenEvaluatingSalesProfitability = VALUE(Enum.GoodsCostWhenEvaluatingSalesProfitability.ByAStandardPriceType)) AS
		PlannedPrices_
		LEFT JOIN GoodsOfDocumentAreSupplemented AS GoodsOfDocumentAreSupplemented
		ON PlannedPrices_.Products = GoodsOfDocumentAreSupplemented.Products
		AND PlannedPrices_.PricingVariant = GoodsOfDocumentAreSupplemented.PricingVariant
		AND PlannedPrices_.PricingBatch = GoodsOfDocumentAreSupplemented.PricingBatch
		AND PlannedPrices_.PricingPackage = GoodsOfDocumentAreSupplemented.PricingPackage
		LEFT JOIN ExchangeRates AS ExchangeRates
		ON PlannedPrices_.Currency = ExchangeRates.Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DocumentsTable.Ref AS Ref,
	DocumentsTable.Date AS DocumentDate,
	PreliminaryCalculation
INTO TableCostCalculation
FROM
	Document.InventoryCostCalculation AS DocumentsTable
		INNER JOIN Document.InventoryCostCalculation.Companies AS CompanyTable
		ON CompanyTable.Organization = &amp;Organization
		AND DocumentsTable.Ref = CompanyTable.Ref
		AND DocumentsTable.Posted
		AND DocumentsTable.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	GoodsCost.Products AS Products,
	GoodsCost.Characteristic AS Characteristic,
	CASE
		WHEN SUM(GoodsCost.CountTurnover) = 0
			THEN 0
		ELSE SUM(GoodsCost.SaleCost) / SUM(GoodsCost.CountTurnover)
	END AS CostOfGoods_,
	CASE
		WHEN SUM(GoodsCost.CountTurnover) = 0
			THEN 0
		ELSE SUM(GoodsCost.CostOfSalesAdditionalExpenses) / SUM(GoodsCost.CountTurnover)
	END AS GoodsCostAddExpenses
INTO GoodsCost
FROM
	(SELECT
		DocumentGoods.Products AS Products,
		DocumentGoods.Characteristic AS Characteristic,
		CASE
			WHEN SaleCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN CAST(CASE
					WHEN &amp;ReportData = 1
						THEN SaleCost.RevenueAmountTurnover
					ELSE SaleCost.RevenueAmountExcludingVATTurnover
				END * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
			WHEN SaleCost.ItemsLocationAttributes IS NULL
				THEN CAST(CASE
					WHEN ISNULL(SaleCost.CountTurnover, 0) = 0
						THEN DocumentGoods.Count
					ELSE SaleCost.CountTurnover
				END * (CAST(CASE
					WHEN &amp;ReportData = 1
						THEN CostOfProducts.Cost + CostOfProducts.LaborCosts +
							CostOfProducts.ItemizedFixedCostsIncludingVAT + CostOfProducts.ItemizedVariableCostsIncludingVAT
					ELSE CostOfProducts.CostExcludingVAT + CostOfProducts.LaborCosts +
						CostOfProducts.ItemizedFixedCostsExcludingVAT + CostOfProducts.ItemizedVariableCostsExcludingVAT
				END * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))) AS NUMBER(31, 2))
			ELSE CAST(CASE
				WHEN &amp;ReportData = 1
					THEN SaleCost.CostTurnover + SaleCost.LaborCostsTurnover +
						SaleCost.ItemizedFixedCostsIncludingVATTurnover + SaleCost.ItemizedVariableCostsIncludingVATTurnover
				ELSE SaleCost.CostExcludingVATTurnover + SaleCost.LaborCostsTurnover +
					SaleCost.ItemizedFixedCostsExcludingVATTurnover + SaleCost.ItemizedVariableCostsExcludingVATTurnover
			END * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
		END AS SaleCost,
		CASE
			WHEN SaleCost.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN 0
			WHEN SaleCost.ItemsLocationAttributes IS NULL
				THEN CAST(CASE
					WHEN ISNULL(SaleCost.CountTurnover, 0) = 0
						THEN DocumentGoods.Count
					ELSE SaleCost.CountTurnover
				END * ISNULL(CASE
					WHEN &amp;ReportData = 1
						THEN CostOfProducts.AdditionalExpenseCost
					ELSE CostOfProducts.AdditionalExpensesCostExcludingVAT
				END, 0) AS NUMBER(31, 2))
			ELSE CAST(CASE
				WHEN &amp;ReportData = 1
					THEN SaleCost.AddExpensesForGoodsTurnover
				ELSE SaleCost.AdditionalExpensesExcludingVATTurnover
			END * ISNULL(ExchangeRates.ConversionFactor_, 1) AS NUMBER(31, 2))
		END AS CostOfSalesAdditionalExpenses,
		CASE
			WHEN ISNULL(SaleCost.CountTurnover, 0) = 0
				THEN DocumentGoods.Count
			ELSE SaleCost.CountTurnover
		END AS CountTurnover,
		ISNULL(TableCostCalculation.PreliminaryCalculation, FALSE) AS ThereIsPreliminaryCalculation
	FROM
		DocumentGoods AS DocumentGoods
			LEFT JOIN AccumulationRegister.RevenueAndCOGS.Turnovers(BEGINOFPERIOD(&amp;DocumentDate, MONTH),, Auto,
				SalesOrder IN (&amp;SalesOrder)
				AND SalesOrder &lt;&gt; UNDEFINED
				AND &amp;GoodsCostWhenEvaluatingSalesProfitability = VALUE(Enum.GoodsCostWhenEvaluatingSalesProfitability.ByEstimatedCost)) AS SaleCost
			ON DocumentGoods.Products = SaleCost.ItemsLocationAttributes.Products
			AND DocumentGoods.Characteristic = SaleCost.ItemsLocationAttributes.Characteristic
			LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
			ON DocumentGoods.Products = CostOfProducts.ItemsLocationAttributes.Products
			AND DocumentGoods.Characteristic = CostOfProducts.ItemsLocationAttributes.Characteristic
			AND (NOT DocumentGoods.Warehouse IS NULL
			AND DocumentGoods.Warehouse = CostOfProducts.ItemsLocationAttributes.StorageLocation
			OR DocumentGoods.Warehouse IS NULL)
			AND (NOT SaleCost.InventoryOwnerAttribute IS NULL
			AND SaleCost.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
			OR SaleCost.InventoryOwnerAttribute IS NULL)
			AND (&amp;Organization = CostOfProducts.Organization)
			AND (CostOfProducts.Period = BEGINOFPERIOD(DocumentGoods.DocumentDate, MONTH))
			LEFT JOIN TableCostCalculation
			ON (BEGINOFPERIOD(DocumentGoods.DocumentDate, MONTH) = BEGINOFPERIOD(TableCostCalculation.DocumentDate, MONTH))
			LEFT JOIN ExchangeRates AS ExchangeRates
			ON (&amp;ManagementAccountingCurrency = ExchangeRates.Currency)) AS GoodsCost
GROUP BY
	GoodsCost.Characteristic,
	GoodsCost.Products
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RevenueProfitCalculationStage.LineNumber AS LineNumber,
	RevenueProfitCalculationStage.Products AS Products,
	RevenueProfitCalculationStage.Characteristic AS Characteristic,
	RevenueProfitCalculationStage.Package AS Package,
	RevenueProfitCalculationStage.DocumentPriceType AS DocumentPriceType,
	RevenueProfitCalculationStage.DocumentPrice AS DocumentPrice,
	RevenueProfitCalculationStage.NormativeTypeOfPrice AS NormativeTypeOfPrice,
	RevenueProfitCalculationStage.PriceStandardPriceType AS PriceStandardPriceType,
	RevenueProfitCalculationStage.Cost AS Cost,
	RevenueProfitCalculationStage.SellingPriceType AS SellingPriceType,
	RevenueProfitCalculationStage.PriceBySellingPriceType AS PriceBySellingPriceType,
	RevenueProfitCalculationStage.PriceKind AS PriceKind,
	RevenueProfitCalculationStage.Price AS Price,
	RevenueProfitCalculationStage.Count AS Count,
	RevenueProfitCalculationStage.RevenueExcludingDiscounts AS RevenueExcludingDiscounts,
	RevenueProfitCalculationStage.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
	RevenueProfitCalculationStage.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
	RevenueProfitCalculationStage.PercentageOfDiscounts AS PercentageOfDiscounts,
	RevenueProfitCalculationStage.AmountOfDiscountsGranted AS AmountOfDiscountsGranted,
	RevenueProfitCalculationStage.ManualDiscount AS ManualDiscount,
	RevenueProfitCalculationStage.DiscountMarkupAmount AS DiscountMarkupAmount,
	RevenueProfitCalculationStage.RevenueWithDiscounts AS RevenueWithDiscounts,
	RevenueProfitCalculationStage.VATAmount AS VATAmount,
	RevenueProfitCalculationStage.RevenueWithDiscountsAndTaxesTakenIntoAccount AS RevenueWithDiscountsAndTaxesTakenIntoAccount,
	RevenueProfitCalculationStage.RevenueIncludingDiscountsWithoutTaxes AS RevenueIncludingDiscountsWithoutTaxes,
	CASE
		WHEN &amp;ReportData = 1
			THEN RevenueProfitCalculationStage.RevenueWithDiscountsAndTaxesTakenIntoAccount - RevenueProfitCalculationStage.Cost
		ELSE RevenueProfitCalculationStage.RevenueIncludingDiscountsWithoutTaxes - RevenueProfitCalculationStage.Cost
	END AS MarginProfit,
	100 * CASE
		WHEN &amp;ReportData = 1
		AND RevenueProfitCalculationStage.RevenueWithDiscountsAndTaxesTakenIntoAccount = 0
			THEN 0
		WHEN &amp;ReportData = 1
			THEN (RevenueProfitCalculationStage.RevenueWithDiscountsAndTaxesTakenIntoAccount - RevenueProfitCalculationStage.Cost) /
				RevenueProfitCalculationStage.RevenueWithDiscountsAndTaxesTakenIntoAccount
		WHEN &amp;ReportData &lt;&gt; 1
		AND RevenueProfitCalculationStage.RevenueIncludingDiscountsWithoutTaxes = 0
			THEN 0
		ELSE (RevenueProfitCalculationStage.RevenueIncludingDiscountsWithoutTaxes - RevenueProfitCalculationStage.Cost) /
			RevenueProfitCalculationStage.RevenueIncludingDiscountsWithoutTaxes
	END AS Profitability,
	100 * CASE
		WHEN RevenueProfitCalculationStage.Cost = 0
			THEN 0
		WHEN &amp;ReportData = 1
			THEN (RevenueProfitCalculationStage.RevenueWithDiscountsAndTaxesTakenIntoAccount - RevenueProfitCalculationStage.Cost) /
				RevenueProfitCalculationStage.Cost
		ELSE (RevenueProfitCalculationStage.RevenueIncludingDiscountsWithoutTaxes - RevenueProfitCalculationStage.Cost) /
			RevenueProfitCalculationStage.Cost
	END AS TradeMarkUp
FROM
	(SELECT
		StageOfCalculatingPricesOfCostOfDiscounts.LineNumber AS LineNumber,
		StageOfCalculatingPricesOfCostOfDiscounts.Products AS Products,
		StageOfCalculatingPricesOfCostOfDiscounts.Characteristic AS Characteristic,
		StageOfCalculatingPricesOfCostOfDiscounts.Package AS Package,
		StageOfCalculatingPricesOfCostOfDiscounts.DocumentPriceType AS DocumentPriceType,
		StageOfCalculatingPricesOfCostOfDiscounts.DocumentPrice AS DocumentPrice,
		StageOfCalculatingPricesOfCostOfDiscounts.NormativeTypeOfPrice AS NormativeTypeOfPrice,
		StageOfCalculatingPricesOfCostOfDiscounts.PriceStandardPriceType AS PriceStandardPriceType,
		StageOfCalculatingPricesOfCostOfDiscounts.Cost AS Cost,
		StageOfCalculatingPricesOfCostOfDiscounts.SellingPriceType AS SellingPriceType,
		StageOfCalculatingPricesOfCostOfDiscounts.PriceBySellingPriceType AS PriceBySellingPriceType,
		StageOfCalculatingPricesOfCostOfDiscounts.PriceKind AS PriceKind,
		StageOfCalculatingPricesOfCostOfDiscounts.Price AS Price,
		StageOfCalculatingPricesOfCostOfDiscounts.Sum AS Sum,
		StageOfCalculatingPricesOfCostOfDiscounts.Count AS Count,
		StageOfCalculatingPricesOfCostOfDiscounts.RevenueExcludingDiscounts AS RevenueExcludingDiscounts,
		StageOfCalculatingPricesOfCostOfDiscounts.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
		StageOfCalculatingPricesOfCostOfDiscounts.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
		StageOfCalculatingPricesOfCostOfDiscounts.PercentRateOfAutomaticDiscountMarkup + StageOfCalculatingPricesOfCostOfDiscounts.PercentRateOfManualDiscount AS
			PercentageOfDiscounts,
		StageOfCalculatingPricesOfCostOfDiscounts.AmountOfDiscountsGranted AS AmountOfDiscountsGranted,
		StageOfCalculatingPricesOfCostOfDiscounts.ManualDiscount AS ManualDiscount,
		StageOfCalculatingPricesOfCostOfDiscounts.DiscountMarkupAmount AS DiscountMarkupAmount,
		StageOfCalculatingPricesOfCostOfDiscounts.RevenueExcludingDiscounts - (StageOfCalculatingPricesOfCostOfDiscounts.DiscountMarkupAmount +
			StageOfCalculatingPricesOfCostOfDiscounts.ManualDiscount) AS RevenueWithDiscounts,
		StageOfCalculatingPricesOfCostOfDiscounts.VATAmount AS VATAmount,
		CAST((StageOfCalculatingPricesOfCostOfDiscounts.RevenueExcludingDiscounts -
			(StageOfCalculatingPricesOfCostOfDiscounts.DiscountMarkupAmount + StageOfCalculatingPricesOfCostOfDiscounts.ManualDiscount)) *
			CASE
			WHEN NOT &amp;PriceIncludesVAT
				THEN (StageOfCalculatingPricesOfCostOfDiscounts.VATRate.Rate1 + 100) / 100
			ELSE 1
		END AS NUMBER(31, 2)) AS RevenueWithDiscountsAndTaxesTakenIntoAccount,
		CAST(StageOfCalculatingPricesOfCostOfDiscounts.RevenueExcludingDiscounts -
			(StageOfCalculatingPricesOfCostOfDiscounts.DiscountMarkupAmount + StageOfCalculatingPricesOfCostOfDiscounts.ManualDiscount) - CASE
			WHEN &amp;PriceIncludesVAT
				THEN StageOfCalculatingPricesOfCostOfDiscounts.VATAmount
			ELSE 0
		END AS NUMBER(31, 2)) AS RevenueIncludingDiscountsWithoutTaxes
	FROM
		(SELECT
			StageOfCalculatingTypesOfPricesAndDiscounts.LineNumber AS LineNumber,
			StageOfCalculatingTypesOfPricesAndDiscounts.Products AS Products,
			StageOfCalculatingTypesOfPricesAndDiscounts.Characteristic AS Characteristic,
			StageOfCalculatingTypesOfPricesAndDiscounts.Package AS Package,
			StageOfCalculatingTypesOfPricesAndDiscounts.DocumentPriceType AS DocumentPriceType,
			StageOfCalculatingTypesOfPricesAndDiscounts.DocumentPrice AS DocumentPrice,
			StageOfCalculatingTypesOfPricesAndDiscounts.NormativeTypeOfPrice AS NormativeTypeOfPrice,
			StageOfCalculatingTypesOfPricesAndDiscounts.PriceStandardPriceType AS PriceStandardPriceType,
			ISNULL(CAST(StageOfCalculatingTypesOfPricesAndDiscounts.Count * CASE
				WHEN
					&amp;GoodsCostWhenEvaluatingSalesProfitability = VALUE(Enum.GoodsCostWhenEvaluatingSalesProfitability.ByEstimatedCost)
					THEN StageOfCalculatingTypesOfPricesAndDiscounts.CostOfGoods_ + StageOfCalculatingTypesOfPricesAndDiscounts.GoodsCostAddExpenses
				ELSE StageOfCalculatingTypesOfPricesAndDiscounts.PriceStandardPriceType
			END * (1 + &amp;ChangeInValueOfGoods / 100) AS NUMBER(31, 2)), 0) AS Cost,
			StageOfCalculatingTypesOfPricesAndDiscounts.SellingPriceType AS SellingPriceType,
			StageOfCalculatingTypesOfPricesAndDiscounts.PriceBySellingPriceType AS PriceBySellingPriceType,
			CASE
				WHEN &amp;SalePrices = 1
					THEN StageOfCalculatingTypesOfPricesAndDiscounts.DocumentPriceType
				ELSE StageOfCalculatingTypesOfPricesAndDiscounts.SellingPriceType
			END AS PriceKind,
			CASE
				WHEN &amp;SalePrices = 1
					THEN StageOfCalculatingTypesOfPricesAndDiscounts.DocumentPrice
				ELSE StageOfCalculatingTypesOfPricesAndDiscounts.PriceBySellingPriceType
			END * (1 + &amp;ChangeInSellingPrices / 100) AS Price,
			StageOfCalculatingTypesOfPricesAndDiscounts.Sum AS Sum,
			StageOfCalculatingTypesOfPricesAndDiscounts.VATRate AS VATRate,
			StageOfCalculatingTypesOfPricesAndDiscounts.Count AS Count,
			CASE
				WHEN &amp;SalePrices = 1
					THEN StageOfCalculatingTypesOfPricesAndDiscounts.Count * StageOfCalculatingTypesOfPricesAndDiscounts.DocumentPrice
				ELSE StageOfCalculatingTypesOfPricesAndDiscounts.Count * StageOfCalculatingTypesOfPricesAndDiscounts.PriceBySellingPriceType
			END * (1 + &amp;ChangeInSellingPrices / 100) AS RevenueExcludingDiscounts,
			StageOfCalculatingTypesOfPricesAndDiscounts.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
			StageOfCalculatingTypesOfPricesAndDiscounts.PercentRateOfManualDiscount + &amp;ChangingVolumeOfManualDiscounts AS PercentRateOfManualDiscount,
			StageOfCalculatingTypesOfPricesAndDiscounts.AmountOfDiscountsGranted AS AmountOfDiscountsGranted,
			CASE
				WHEN &amp;SalePrices = 1
					THEN StageOfCalculatingTypesOfPricesAndDiscounts.Count * StageOfCalculatingTypesOfPricesAndDiscounts.DocumentPrice
				ELSE StageOfCalculatingTypesOfPricesAndDiscounts.Count * StageOfCalculatingTypesOfPricesAndDiscounts.PriceBySellingPriceType
			END * (1 + &amp;ChangeInSellingPrices / 100) * (&amp;ChangingVolumeOfManualDiscounts) / 100 +
				StageOfCalculatingTypesOfPricesAndDiscounts.ManualDiscount AS ManualDiscount,
			CASE
				WHEN &amp;SalePrices = 1
					THEN StageOfCalculatingTypesOfPricesAndDiscounts.Count * StageOfCalculatingTypesOfPricesAndDiscounts.DocumentPrice
				ELSE StageOfCalculatingTypesOfPricesAndDiscounts.Count * StageOfCalculatingTypesOfPricesAndDiscounts.PriceBySellingPriceType
			END * (1 + &amp;ChangeInSellingPrices / 100) * StageOfCalculatingTypesOfPricesAndDiscounts.PercentRateOfAutomaticDiscountMarkup / 100 AS
				DiscountMarkupAmount,
			StageOfCalculatingTypesOfPricesAndDiscounts.VATAmount AS VATAmount
		FROM
			(SELECT
				DocumentGoods.LineNumber AS LineNumber,
				DocumentGoods.Products AS Products,
				DocumentGoods.Characteristic AS Characteristic,
				DocumentGoods.Package AS Package,
				DocumentGoods.DocumentPriceType AS DocumentPriceType,
				DocumentGoods.DocumentPrice AS DocumentPrice,
				PlannedPrices_.NormativeTypeOfPrice AS NormativeTypeOfPrice,
				ISNULL(&amp;QueryTextPackagingFactor1, 1) * ISNULL(PlannedPrices_.Price, 0) /
					ISNULL(&amp;QueryTextPackagingFactor2, 1) AS PriceStandardPriceType,
				ISNULL(&amp;QueryTextPackagingFactor1, 1) * GoodsCost.CostOfGoods_ AS CostOfGoods_,
				ISNULL(&amp;QueryTextPackagingFactor1, 1) * GoodsCost.GoodsCostAddExpenses AS
					GoodsCostAddExpenses,
				SalesPrices.SellingPriceType AS SellingPriceType,
				ISNULL(&amp;QueryTextPackagingFactor1, 1) * ISNULL(SalesPrices.Price, 0) /
					ISNULL(&amp;QueryTextPackagingFactor3, 1) AS PriceBySellingPriceType,
				DocumentGoods.VATRate AS VATRate,
				DocumentGoods.Sum AS Sum,
				DocumentGoods.Count AS Count,
				DocumentGoods.PercentRateOfAutomaticDiscountMarkup AS PercentRateOfAutomaticDiscountMarkup,
				DocumentGoods.PercentRateOfManualDiscount AS PercentRateOfManualDiscount,
				CASE
					WHEN &amp;SalePrices = 1
						THEN DocumentGoods.Count * DocumentGoods.DocumentPrice
					ELSE DocumentGoods.Count * ISNULL(&amp;QueryTextPackagingFactor1, 1) * ISNULL(SalesPrices.Price, 0)
						/ ISNULL(&amp;QueryTextPackagingFactor3, 1)
				END * ((1 + &amp;ChangeInSellingPrices / 100) * (&amp;ChangingVolumeOfManualDiscounts) / 100) +
					DocumentGoods.ManualDiscount + CASE
					WHEN &amp;SalePrices = 1
						THEN DocumentGoods.Count * DocumentGoods.DocumentPrice
					ELSE DocumentGoods.Count * ISNULL(&amp;QueryTextPackagingFactor1, 1) * ISNULL(SalesPrices.Price, 0)
						/ ISNULL(&amp;QueryTextPackagingFactor3, 1)
				END * ((1 + &amp;ChangeInSellingPrices / 100) * DocumentGoods.PercentRateOfAutomaticDiscountMarkup / 100) AS
					AmountOfDiscountsGranted,
				DocumentGoods.ManualDiscount AS ManualDiscount,
				DocumentGoods.VATAmount AS VATAmount
			FROM
				DocumentGoods AS DocumentGoods
					LEFT JOIN SalesPrices AS SalesPrices
					ON (&amp;SalePrices = 2)
					AND DocumentGoods.Products = SalesPrices.Products
					AND DocumentGoods.Characteristic = SalesPrices.Characteristic
					LEFT JOIN PlannedPrices_ AS PlannedPrices_
					ON (&amp;GoodsCostWhenEvaluatingSalesProfitability = VALUE(Enum.GoodsCostWhenEvaluatingSalesProfitability.ByAStandardPriceType))
					AND DocumentGoods.Products = PlannedPrices_.Products
					AND DocumentGoods.Characteristic = PlannedPrices_.Characteristic
					LEFT JOIN GoodsCost AS GoodsCost
					ON (&amp;GoodsCostWhenEvaluatingSalesProfitability = VALUE(Enum.GoodsCostWhenEvaluatingSalesProfitability.ByEstimatedCost))
					AND DocumentGoods.Products = GoodsCost.Products
					AND DocumentGoods.Characteristic = GoodsCost.Characteristic
					LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;DocumentDate,
						BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesPrices
					ON DocumentGoods.DocumentCurrency = CurrencyRatesPrices.Currency
					LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;DocumentDate, Currency = &amp;Currency
					AND BaseCurrency = &amp;BaseCurrency) AS Currency_Rates
					ON (TRUE)) AS StageOfCalculatingTypesOfPricesAndDiscounts) AS StageOfCalculatingPricesOfCostOfDiscounts) AS RevenueProfitCalculationStage</query>
	</dataSet>
