<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Products</dataPath>
			<field>Products</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Partner</dataPath>
			<field>Partner</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Customer</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>مشتری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Cliente</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Klient</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Клиент</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Müşteri</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Khách hàng</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Characteristic</dataPath>
			<field>Characteristic</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CountClosingBalance</dataPath>
			<field>CountClosingBalance</field>
			<useRestriction>
				<condition>true</condition>
				<group>true</group>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>SumClosingBalance</dataPath>
			<field>SumClosingBalance</field>
			<useRestriction>
				<condition>true</condition>
				<group>true</group>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Period</dataPath>
			<field>Period</field>
			<role>
				<dcscom:periodNumber>2</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Recorder</dataPath>
			<field>Recorder</field>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Currency</dataPath>
			<field>Currency</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>InventoryOwnerAttribute</dataPath>
			<field>InventoryOwnerAttribute</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DocumentTransfers_</dataPath>
			<field>DocumentTransfers_</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CCDNumber</dataPath>
			<field>CCDNumber</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DepositIsRequired</dataPath>
			<field>DepositIsRequired</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TransferredReturnablePackagingBalanceAndTurnovers.Products,
	TransferredReturnablePackagingBalanceAndTurnovers.Characteristic,
	TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_,
	TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_.Currency AS Currency,
	TransferredReturnablePackagingBalanceAndTurnovers.CountClosingBalance,
	TransferredReturnablePackagingBalanceAndTurnovers.SumClosingBalance,
	TransferredReturnablePackagingBalanceAndTurnovers.Recorder,
	TransferredReturnablePackagingBalanceAndTurnovers.Period
FROM
	AccumulationRegister.TransferredReturnablePackaging.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Recorder, RegisterRecords, ) AS TransferredReturnablePackagingBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Sum(CountClosingBalance)</expression>
		<group>Currency</group>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Recorder</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>SumClosingBalance</dataPath>
		<expression>Sum(SumClosingBalance)</expression>
		<group>Currency</group>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Recorder</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
