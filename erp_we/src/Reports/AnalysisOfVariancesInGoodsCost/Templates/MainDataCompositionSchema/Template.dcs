		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
// In order to determine the Registered Records by movements, we look at the Registered Records that have cor. records.
SELECT ALLOWED DISTINCT
	GoodsCostVariances.FinRecordID AS FinRecordID
INTO IdentifiersOfRegisteredRecordedMovements
FROM
	AccumulationRegister.GoodsCostVariances AS GoodsCostVariances
		INNER JOIN AccumulationRegister.GoodsCostVariances AS CorDeviationsInCostOfGoods
		ON GoodsCostVariances.BusinessTransactionSetting = CorDeviationsInCostOfGoods.BusinessTransactionSetting
			AND GoodsCostVariances.FinRecordID = CorDeviationsInCostOfGoods.FinRecordID
			AND GoodsCostVariances.RecordType &lt;&gt; CorDeviationsInCostOfGoods.RecordType
WHERE
	NOT (GoodsCostVariances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		OR GoodsCostVariances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
{WHERE
	(GoodsCostVariances.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod),
	(CorDeviationsInCostOfGoods.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod),
	((GoodsCostVariances.Products, GoodsCostVariances.Characteristic) IN 
				(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed
					)
	),
	GoodsCostVariances.Organization.*,
	GoodsCostVariances.Products.*,
	GoodsCostVariances.Characteristic.*,
	GoodsCostVariances.InventoryOwnerAttribute.*,
	GoodsCostVariances.LineOfBusiness.*,
	GoodsCostVariances.Department.*,
	GoodsCostVariances.StorageLocation.*,
	GoodsCostVariances.VariancePeriod,
	GoodsCostVariances.Recorder.*,
	GoodsCostVariances.BusinessOperation.*,
	(CASE
			WHEN VALUETYPE(GoodsCostVariances.StorageLocation) = TYPE(Catalog.Warehouses)
				THEN CAST(GoodsCostVariances.StorageLocation AS Catalog.Warehouses)
			ELSE VALUE(Catalog.Warehouses.EmptyRef)
		END).* AS Warehouse,
	(CASE
			WHEN VALUETYPE(GoodsCostVariances.StorageLocation) = TYPE(Catalog.CounterpartyContracts)
				THEN CAST(GoodsCostVariances.StorageLocation AS Catalog.CounterpartyContracts)
			ELSE VALUE(Catalog.CounterpartyContracts.EmptyRef)
		END).* AS Contract}

INDEX BY
	FinRecordID
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Variances.SecondPeriod AS SecondPeriod,
	Variances.DayPeriod AS DayPeriod,
	Variances.WeekPeriod AS WeekPeriod,
	Variances.TenDaysPeriod AS TenDaysPeriod,
	Variances.MonthPeriod AS MonthPeriod,
	Variances.QuarterPeriod AS QuarterPeriod,
	Variances.HalfYearPeriod AS HalfYearPeriod,
	Variances.YearPeriod AS YearPeriod,
	Variances.Recorder AS Recorder,
	Variances.Organization AS Organization,
	Variances.Products AS Products,
	Variances.Characteristic AS Characteristic,
	Variances.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	Variances.LineOfBusiness AS LineOfBusiness,
	Variances.Department AS Department,
	Variances.StorageLocation AS StorageLocation,
	Variances.VariancePeriod AS VariancePeriod,
	1 AS Character,
	CASE
		WHEN VALUETYPE(Variances.StorageLocation) = TYPE(Catalog.Warehouses)
			THEN CAST(Variances.StorageLocation AS Catalog.Warehouses)
		ELSE VALUE(Catalog.Warehouses.EmptyRef)
	END AS Warehouse,
	CASE
		WHEN VALUETYPE(Variances.StorageLocation) = TYPE(Catalog.CounterpartyContracts)
			THEN CAST(Variances.StorageLocation AS Catalog.CounterpartyContracts)
		ELSE VALUE(Catalog.CounterpartyContracts.EmptyRef)
	END AS Contract,
	VALUE(Enum.BusinessTransactions.EmptyRef) AS BusinessOperation,
	CASE
		WHEN &amp;CostData = 1
			THEN Variances.CostVariancesIncludingVATOpeningBalance + Variances.AdditionalExpensesIncludingVATOpeningBalance
		WHEN &amp;CostData = 2
			THEN Variances.CostVariancesExcludingVATOpeningBalance + Variances.AdditionalExpensesExcludingVATOpeningBalance
		WHEN &amp;CostData = 3
			THEN Variances.CostVariancesMgmtOpeningBalance + Variances.AddExpensesManOpeningBalance
		WHEN &amp;CostData = 4
			THEN Variances.CostVariancesLocalOpeningBalance + Variances.AddExpensesLocalOpeningBalance
		WHEN &amp;ByEnterprise
			THEN Variances.CostVariancesExcludingVATOpeningBalance + Variances.AdditionalExpensesExcludingVATOpeningBalance
		ELSE Variances.CostVariancesMgmtOpeningBalance + Variances.AddExpensesManOpeningBalance
	END AS FullValueOpeningBalance,
	CASE
		WHEN &amp;CostData = 1
			THEN Variances.CostVariancesIncludingVATOpeningBalance
		WHEN &amp;CostData = 2
			THEN Variances.CostVariancesExcludingVATOpeningBalance
		WHEN &amp;CostData = 3
			THEN Variances.CostVariancesMgmtOpeningBalance
		WHEN &amp;CostData = 4
			THEN Variances.CostVariancesLocalOpeningBalance
		WHEN &amp;ByEnterprise
			THEN Variances.CostVariancesExcludingVATOpeningBalance
		ELSE Variances.CostVariancesMgmtOpeningBalance
	END AS CostOpeningBalance,
	CASE
		WHEN &amp;CostData = 1
			THEN Variances.AdditionalExpensesIncludingVATOpeningBalance
		WHEN &amp;CostData = 2
			THEN Variances.AdditionalExpensesExcludingVATOpeningBalance
		WHEN &amp;CostData = 3
			THEN Variances.AddExpensesManOpeningBalance
		WHEN &amp;CostData = 4
			THEN Variances.AddExpensesLocalOpeningBalance
		WHEN &amp;ByEnterprise
			THEN Variances.AdditionalExpensesExcludingVATOpeningBalance
		ELSE Variances.AddExpensesManOpeningBalance
	END AS AddExpensesForGoodsOpeningBalance,
	CASE
		WHEN &amp;CostData = 4
			THEN Variances.VATLocalOpeningBalance
		ELSE Variances.VATManagOpeningBalance
	END AS VATOpeningBalance,
	CASE
		WHEN &amp;CostData = 4
			THEN Variances.PermanentDifferenceOpeningBalance
		ELSE 0
	END AS PermanentDifferenceOpeningBalance,
	CASE
		WHEN &amp;CostData = 4
			THEN Variances.CostTDOpeningBalance
		ELSE 0
	END AS CostTDOpeningBalance,
	CASE
		WHEN &amp;CostData = 4
			THEN Variances.AITOpeningBalance
		ELSE 0
	END AS AITOpeningBalance,
	0 AS PurchasesFullCost,
	0 AS ProcurementCost,
	0 AS PurchasesAdditionalExpensesAmount,
	0 AS VATPurchases,
	0 AS PurchasesAreConstantDifferenceInCostsPD,
	0 AS ProcurementCostedTD,
	0 AS AITPurchases,
	0 AS AdditionalExpensesAmountFullCost,
	0 AS AdditionalExpensesAmountOfCost,
	0 AS AdditionalExpensesAmountAdditionalExpensesAmount,
	0 AS AdditionalExpensesAmountOfVAT,
	0 AS AdditionalExpensesAmountOfCostPDIsConstantDifference,
	0 AS AdditionalExpensesAmountOfTimeDifferenceCostTD,
	0 AS AdditionalExpensesAmountOfAIT,
	0 AS MovingFullCost,
	0 AS MovingCost,
	0 AS MovementsAdditionalExpensesAmount,
	0 AS VATMovements,
	0 AS MovementsAreConstantCostPD,
	0 AS MovementsCostTD,
	0 AS AITSMovements,
	0 AS IssueFullCost,
	0 AS IssueCost,
	0 AS IssueOfAdditionalExpensesAmount,
	0 AS VATIssue,
	0 AS IssueIsConstantCostPD,
	0 AS ReleaseCostTDIsTimeDifference,
	0 AS AITIssue,
	0 AS OtherFullCost,
	0 AS Other_Costs,
	0 AS OtherAdditionalExpensesAmount,
	0 AS OtherVAT,
	0 AS OtherCostPDDifferencesAreConstantOne,
	0 AS OtherCostTDOfDay,
	0 AS OtherAIT,
	0 AS SalesFullCost,
	0 AS Sales_Cost,
	0 AS SalesAdditionalExpensesAmount,
	0 AS VATSales,
	0 AS SalesAreConstantDifferenceInCostsPD,
	0 AS SalesAreTimeDifferenceInCostTD,
	0 AS AITSales,
	0 AS WriteOffForExpensesAssetsFullCost,
	0 AS WriteOffForExpensesAssetsCosts,
	0 AS WriteOffToExpensesAssetsAdditionalExpensesAmount,
	0 AS WriteOffForExpensesVATAssets,
	0 AS WriteOffForExpensesOfAssetsCostedPD,
	0 AS WriteOffForExpensesOfAssetsCostTD,
	0 AS WriteOffForExpensesAssetsAIT,
	CASE
		WHEN &amp;CostData = 1
			THEN Variances.CostVariancesIncludingVATClosingBalance + Variances.AdditionalExpensesIncludingVATClosingBalance
		WHEN &amp;CostData = 2
			THEN Variances.CostVariancesExcludingVATClosingBalance + Variances.AdditionalExpensesExcludingVATClosingBalance
		WHEN &amp;CostData = 3
			THEN Variances.CostVariancesMgmtClosingBalance + Variances.AddExpensesManClosingBalance
		WHEN &amp;CostData = 4
			THEN Variances.CostVariancesLocalClosingBalance + Variances.AddExpensesLocalClosingBalance
		WHEN &amp;ByEnterprise
			THEN Variances.CostVariancesExcludingVATClosingBalance + Variances.AdditionalExpensesExcludingVATClosingBalance
		ELSE Variances.CostVariancesMgmtClosingBalance + Variances.AddExpensesManClosingBalance
	END AS FullValueClosingBalance,
	CASE
		WHEN &amp;CostData = 1
			THEN Variances.CostVariancesIncludingVATClosingBalance
		WHEN &amp;CostData = 2
			THEN Variances.CostVariancesExcludingVATClosingBalance
		WHEN &amp;CostData = 3
			THEN Variances.CostVariancesMgmtClosingBalance
		WHEN &amp;CostData = 4
			THEN Variances.CostVariancesLocalClosingBalance
		WHEN &amp;ByEnterprise
			THEN Variances.CostVariancesExcludingVATClosingBalance
		ELSE Variances.CostVariancesMgmtClosingBalance
	END AS CostClosingBalance,
	CASE
		WHEN &amp;CostData = 1
			THEN Variances.AdditionalExpensesIncludingVATClosingBalance
		WHEN &amp;CostData = 2
			THEN Variances.AdditionalExpensesExcludingVATClosingBalance
		WHEN &amp;CostData = 3
			THEN Variances.AddExpensesManClosingBalance
		WHEN &amp;CostData = 4
			THEN Variances.AddExpensesLocalClosingBalance
		WHEN &amp;ByEnterprise
			THEN Variances.AdditionalExpensesExcludingVATClosingBalance
		ELSE Variances.AddExpensesManClosingBalance
	END AS AddExpensesForGoodsClosingBalance,
	CASE
		WHEN &amp;CostData = 4
			THEN Variances.VATLocalClosingBalance
		ELSE Variances.VATManagClosingBalance
	END AS VATClosingBalance,
	CASE
		WHEN &amp;CostData = 4
			THEN Variances.PermanentDifferenceClosingBalance
		ELSE 0
	END AS PermanentDifferenceClosingBalance,
	CASE
		WHEN &amp;CostData = 4
			THEN Variances.CostTDClosingBalance
		ELSE 0
	END AS CostTDClosingBalance,
	CASE
		WHEN &amp;CostData = 4
			THEN Variances.AITClosingBalance
		ELSE 0
	END AS AITClosingBalance
INTO ResidualsAndTurnsOfDeviations
{SELECT
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	Recorder.*,
	Organization.*,
	Products.*,
	Characteristic.*,
	InventoryOwnerAttribute.*,
	LineOfBusiness.*,
	Department.*,
	StorageLocation.*,
	VariancePeriod,
	Warehouse.*,
	Contract.*,
	BusinessOperation.*,
	FullValueOpeningBalance,
	CostOpeningBalance,
	AddExpensesForGoodsOpeningBalance,
	VATOpeningBalance,
	PermanentDifferenceOpeningBalance,
	CostTDOpeningBalance,
	AITOpeningBalance,
	PurchasesFullCost,
	ProcurementCost,
	PurchasesAdditionalExpensesAmount,
	VATPurchases,
	PurchasesAreConstantDifferenceInCostsPD,
	ProcurementCostedTD,
	AITPurchases,
	AdditionalExpensesAmountFullCost,
	AdditionalExpensesAmountOfCost,
	AdditionalExpensesAmountAdditionalExpensesAmount,
	AdditionalExpensesAmountOfVAT,
	AdditionalExpensesAmountOfCostPDIsConstantDifference,
	AdditionalExpensesAmountOfTimeDifferenceCostTD,
	AdditionalExpensesAmountOfAIT,
	MovingFullCost,
	MovingCost,
	MovementsAdditionalExpensesAmount,
	VATMovements,
	MovementsAreConstantCostPD,
	MovementsCostTD,
	AITSMovements,
	IssueFullCost,
	IssueCost,
	IssueOfAdditionalExpensesAmount,
	VATIssue,
	IssueIsConstantCostPD,
	ReleaseCostTDIsTimeDifference,
	AITIssue,
	OtherFullCost,
	Other_Costs,
	OtherAdditionalExpensesAmount,
	OtherVAT,
	OtherCostPDDifferencesAreConstantOne,
	OtherCostTDOfDay,
	OtherAIT,
	SalesFullCost,
	Sales_Cost,
	SalesAdditionalExpensesAmount,
	VATSales,
	SalesAreConstantDifferenceInCostsPD,
	SalesAreTimeDifferenceInCostTD,
	AITSales,
	WriteOffForExpensesAssetsFullCost,
	WriteOffForExpensesAssetsCosts,
	WriteOffToExpensesAssetsAdditionalExpensesAmount,
	WriteOffForExpensesVATAssets,
	WriteOffForExpensesOfAssetsCostedPD,
	WriteOffForExpensesOfAssetsCostTD,
	WriteOffForExpensesAssetsAIT,
	FullValueClosingBalance,
	CostClosingBalance,
	AddExpensesForGoodsClosingBalance,
	VATClosingBalance,
	PermanentDifferenceClosingBalance,
	CostTDClosingBalance,
	AITClosingBalance}
FROM
	AccumulationRegister.GoodsCostVariances.BalanceAndTurnovers(&amp;BeginOfPeriod {(&amp;BeginOfPeriod)}, &amp;EndOfPeriod {(&amp;EndOfPeriod)}, Auto, , {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}) AS Variances
{WHERE
	Variances.SecondPeriod,
	Variances.DayPeriod,
	Variances.WeekPeriod,
	Variances.TenDaysPeriod,
	Variances.MonthPeriod,
	Variances.QuarterPeriod,
	Variances.HalfYearPeriod,
	Variances.YearPeriod,
	Variances.Recorder.* AS Recorder,
	Variances.Organization.*,
	Variances.Products.*,
	Variances.Characteristic.*,
	Variances.InventoryOwnerAttribute.*,
	Variances.LineOfBusiness.*,
	Variances.Department.*,
	Variances.StorageLocation.*,
	Variances.VariancePeriod,
	(CASE
			WHEN VALUETYPE(Variances.StorageLocation) = TYPE(Catalog.Warehouses)
				THEN CAST(Variances.StorageLocation AS Catalog.Warehouses)
			ELSE VALUE(Catalog.Warehouses.EmptyRef)
		END).* AS Warehouse,
	(CASE
			WHEN VALUETYPE(Variances.StorageLocation) = TYPE(Catalog.CounterpartyContracts)
				THEN CAST(Variances.StorageLocation AS Catalog.CounterpartyContracts)
			ELSE VALUE(Catalog.CounterpartyContracts.EmptyRef)
		END).* AS Contract}

UNION ALL

SELECT
	Variances.Period AS SecondPeriod,
	BEGINOFPERIOD(Variances.Period, DAY) AS DayPeriod,
	BEGINOFPERIOD(Variances.Period, WEEK) AS WeekPeriod,
	BEGINOFPERIOD(Variances.Period, TENDAYS) AS TenDaysPeriod,
	BEGINOFPERIOD(Variances.Period, MONTH) AS MonthPeriod,
	BEGINOFPERIOD(Variances.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(Variances.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(Variances.Period, YEAR) AS YearPeriod,
	Variances.Recorder AS Recorder,
	Variances.Organization AS Organization,
	Variances.Products AS Products,
	Variances.Characteristic AS Characteristic,
	Variances.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	Variances.LineOfBusiness AS LineOfBusiness,
	Variances.Department AS Department,
	Variances.StorageLocation AS StorageLocation,
	Variances.VariancePeriod AS VariancePeriod,
	CASE
		WHEN Variances.RecordType = VALUE(AccumulationRecordType.Receipt)
			THEN 1
		ELSE -1
	END AS Character,
	CASE
		WHEN VALUETYPE(Variances.StorageLocation) = TYPE(Catalog.Warehouses)
			THEN CAST(Variances.StorageLocation AS Catalog.Warehouses)
		ELSE VALUE(Catalog.Warehouses.EmptyRef)
	END AS Warehouse,
	CASE
		WHEN VALUETYPE(Variances.StorageLocation) = TYPE(Catalog.CounterpartyContracts)
			THEN CAST(Variances.StorageLocation AS Catalog.CounterpartyContracts)
		ELSE VALUE(Catalog.CounterpartyContracts.EmptyRef)
	END AS Contract,
	Variances.BusinessOperation AS BusinessOperation,
	0 AS FullValueOpeningBalance,
	0 AS CostOpeningBalance,
	0 AS AddExpensesForGoodsOpeningBalance,
	0 AS VATOpeningBalance,
	0 AS PermanentDifferenceOpeningBalance,
	0 AS CostTDOpeningBalance,
	0 AS AITOpeningBalance,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessProcurementOperations)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT + Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt + Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal + Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.CostVariancesMgmt + Variances.AddExpensesMan
				END
		ELSE 0
	END AS PurchasesFullCost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessProcurementOperations)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT
					ELSE Variances.CostVariancesMgmt
				END
		ELSE 0
	END AS ProcurementCost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessProcurementOperations)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.AddExpensesMan
				END
		ELSE 0
	END AS PurchasesAdditionalExpensesAmount,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessProcurementOperations)
			THEN CASE
					WHEN &amp;CostData = 4
						THEN Variances.VATLocal
					ELSE Variances.VATManag
				END
		ELSE 0
	END AS VATPurchases,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessProcurementOperations)
				AND &amp;CostData = 4
			THEN Variances.PermanentDifference
		ELSE 0
	END AS PurchasesAreConstantDifferenceInCostsPD,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessProcurementOperations)
				AND &amp;CostData = 4
			THEN Variances.CostTD
		ELSE 0
	END AS ProcurementCostedTD,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessProcurementOperations)
				AND &amp;CostData = 4
			THEN Variances.AIT
		ELSE 0
	END AS AITPurchases,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOperationsOfOperationsAdditionalExpensesAmount)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT + Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt + Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal + Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.CostVariancesMgmt + Variances.AddExpensesMan
				END
		ELSE 0
	END AS AdditionalExpensesAmountFullCost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOperationsOfOperationsAdditionalExpensesAmount)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT
					ELSE Variances.CostVariancesMgmt
				END
		ELSE 0
	END AS AdditionalExpensesAmountOfCost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOperationsOfOperationsAdditionalExpensesAmount)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.AddExpensesMan
				END
		ELSE 0
	END AS AdditionalExpensesAmountAdditionalExpensesAmount,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOperationsOfOperationsAdditionalExpensesAmount)
			THEN CASE
					WHEN &amp;CostData = 4
						THEN Variances.VATLocal
					ELSE Variances.VATManag
				END
		ELSE 0
	END AS AdditionalExpensesAmountOfVAT,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOperationsOfOperationsAdditionalExpensesAmount)
				AND &amp;CostData = 4
			THEN Variances.PermanentDifference
		ELSE 0
	END AS AdditionalExpensesAmountOfCostPDIsConstantDifference,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOperationsOfOperationsAdditionalExpensesAmount)
				AND &amp;CostData = 4
			THEN Variances.CostTD
		ELSE 0
	END AS AdditionalExpensesAmountOfTimeDifferenceCostTD,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOperationsOfOperationsAdditionalExpensesAmount)
				AND &amp;CostData = 4
			THEN Variances.AIT
		ELSE 0
	END AS AdditionalExpensesAmountOfAIT,
	CASE
		WHEN IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NOT NULL
		 AND NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT + Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt + Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal + Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.CostVariancesMgmt + Variances.AddExpensesMan
				END
		ELSE 0
	END AS MovingFullCost,
	CASE
		WHEN IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NOT NULL
		 AND NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT
					ELSE Variances.CostVariancesMgmt
				END
		ELSE 0
	END AS MovingCost,
	CASE
		WHEN IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NOT NULL
		 AND NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.AddExpensesMan
				END
		ELSE 0
	END AS MovementsAdditionalExpensesAmount,
	CASE
		WHEN IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NOT NULL
		 AND NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
			THEN CASE
					WHEN &amp;CostData = 4
						THEN Variances.VATLocal
					ELSE Variances.VATManag
				END
		ELSE 0
	END AS VATMovements,
	CASE
		WHEN IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NOT NULL
		 AND NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND &amp;CostData = 4
			THEN Variances.PermanentDifference
		ELSE 0
	END AS MovementsAreConstantCostPD,
	CASE
		WHEN IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NOT NULL
		 AND NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND &amp;CostData = 4
			THEN Variances.CostTD
		ELSE 0
	END AS MovementsCostTD,
	CASE
		WHEN IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NOT NULL
		 AND NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND &amp;CostData = 4
			THEN Variances.AIT
		ELSE 0
	END AS AITSMovements,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationRelease)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT + Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt + Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal + Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.CostVariancesMgmt + Variances.AddExpensesMan
				END
		ELSE 0
	END AS IssueFullCost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationRelease)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT
					ELSE Variances.CostVariancesMgmt
				END
		ELSE 0
	END AS IssueCost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationRelease)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.AddExpensesMan
				END
		ELSE 0
	END AS IssueOfAdditionalExpensesAmount,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationRelease)
			THEN CASE
					WHEN &amp;CostData = 4
						THEN Variances.VATLocal
					ELSE Variances.VATManag
				END
		ELSE 0
	END AS VATIssue,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationRelease)
				AND &amp;CostData = 4
			THEN Variances.PermanentDifference
		ELSE 0
	END AS IssueIsConstantCostPD,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationRelease)
				AND &amp;CostData = 4
			THEN Variances.CostTD
		ELSE 0
	END AS ReleaseCostTDIsTimeDifference,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationRelease)
			THEN CASE
					WHEN &amp;CostData = 4
						THEN Variances.AIT
					ELSE 0
				END
		ELSE 0
	END AS AITIssue,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationsOfTransferOfDeviations)
				OR NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND NOT (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			 		OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
				AND IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NULL
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT + Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt + Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal + Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.CostVariancesMgmt + Variances.AddExpensesMan
				END
		ELSE 0
	END AS OtherFullCost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationsOfTransferOfDeviations)
				OR NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND NOT (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			 		OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
				AND IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NULL
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT
					ELSE Variances.CostVariancesMgmt
				END
		ELSE 0
	END AS Other_Costs,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationsOfTransferOfDeviations)
				OR NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND NOT (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			 		OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
				AND IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NULL
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.AddExpensesMan
				END
		ELSE 0
	END AS OtherAdditionalExpensesAmount,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationsOfTransferOfDeviations)
				OR NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND NOT (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			 		OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
				AND IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NULL
			THEN CASE
					WHEN &amp;CostData = 4
						THEN Variances.VATLocal
					ELSE Variances.VATManag
				END
		ELSE 0
	END AS OtherVAT,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationsOfTransferOfDeviations)
				OR NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND NOT (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			 		OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
				AND IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NULL
				AND &amp;CostData = 4
			THEN Variances.PermanentDifference
		ELSE 0
	END AS OtherCostPDDifferencesAreConstantOne,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationsOfTransferOfDeviations)
				OR NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND NOT (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			 		OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
				AND IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NULL
				AND &amp;CostData = 4
			THEN Variances.CostTD
		ELSE 0
	END AS OtherCostTDOfDay,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessOfOperationsOfTransferOfDeviations)
				OR NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
				AND NOT (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			 		OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
				AND IdentifiersOfRegisteredRecordedMovements.FinRecordID IS NULL
				AND &amp;CostData = 4
			THEN Variances.AIT
		ELSE 0
	END AS OtherAIT,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessSalesOfOperations)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT + Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt + Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal + Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.CostVariancesMgmt + Variances.AddExpensesMan
				END
		ELSE 0
	END AS SalesFullCost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessSalesOfOperations)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT
					ELSE Variances.CostVariancesMgmt
				END
		ELSE 0
	END AS Sales_Cost,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessSalesOfOperations)
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.AddExpensesMan
				END
		ELSE 0
	END AS SalesAdditionalExpensesAmount,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessSalesOfOperations)
			THEN CASE
					WHEN &amp;CostData = 4
						THEN Variances.VATLocal
					ELSE Variances.VATManag
				END
		ELSE 0
	END AS VATSales,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessSalesOfOperations)
				AND &amp;CostData = 4
			THEN Variances.PermanentDifference
		ELSE 0
	END AS SalesAreConstantDifferenceInCostsPD,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessSalesOfOperations)
				AND &amp;CostData = 4
			THEN Variances.CostTD
		ELSE 0
	END AS SalesAreTimeDifferenceInCostTD,
	CASE
		WHEN Variances.BusinessOperation IN (&amp;BusinessSalesOfOperations)
				AND &amp;CostData = 4
			THEN Variances.AIT
		ELSE 0
	END AS AITSales,
	CASE
		WHEN NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
		 AND (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT + Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt + Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal + Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT + Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.CostVariancesMgmt + Variances.AddExpensesMan
				END
		ELSE 0
	END AS WriteOffForExpensesAssetsFullCost,
	CASE
		WHEN NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
		 AND (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.CostVariancesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.CostVariancesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.CostVariancesMgmt
					WHEN &amp;CostData = 4
						THEN Variances.CostVariancesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.CostVariancesExcludingVAT
					ELSE Variances.CostVariancesMgmt
				END
		ELSE 0
	END AS WriteOffForExpensesAssetsCosts,
	CASE
		WHEN NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
		 AND (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
			THEN CASE
					WHEN &amp;CostData = 1
						THEN Variances.AdditionalExpensesIncludingVAT
					WHEN &amp;CostData = 2
						THEN Variances.AdditionalExpensesExcludingVAT
					WHEN &amp;CostData = 3
						THEN Variances.AddExpensesMan
					WHEN &amp;CostData = 4
						THEN Variances.AddExpensesLocal
					WHEN &amp;ByEnterprise
						THEN Variances.AdditionalExpensesExcludingVAT
					ELSE Variances.AddExpensesMan
				END
		ELSE 0
	END AS WriteOffToExpensesAssetsAdditionalExpensesAmount,
	CASE
		WHEN NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
		 AND (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
			THEN CASE
					WHEN &amp;CostData = 4
						THEN Variances.VATLocal
					ELSE Variances.VATManag
				END
		ELSE 0
	END AS WriteOffForExpensesVATAssets,
	CASE
		WHEN NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
		 AND (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
		 AND &amp;CostData = 4
			THEN Variances.PermanentDifference
		ELSE 0
	END AS WriteOffForExpensesOfAssetsCostedPD,
	CASE
		WHEN NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
		 AND (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
		 AND &amp;CostData = 4
			THEN Variances.CostTD
		ELSE 0
	END AS WriteOffForExpensesOfAssetsCostTD,
	CASE
		WHEN NOT Variances.BusinessOperation IN (&amp;BusinessOfOperationsByCategory)
		 AND (Variances.ExpenseItemOfWriteOff &lt;&gt; VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
			OR Variances.AssetAndLiabilityItem &lt;&gt; VALUE(ChartOfCharacteristicTypes.AssetLiabilityItems.EmptyRef))
		 AND &amp;CostData = 4
			THEN Variances.AIT
		ELSE 0
	END AS WriteOffForExpensesAssetsAIT,
	0 AS FullValueClosingBalance,
	0 AS CostClosingBalance,
	0 AS AddExpensesForGoodsClosingBalance,
	0 AS VATClosingBalance,
	0 AS PermanentDifferenceClosingBalance,
	0 AS CostTDClosingBalance,
	0 AS AITClosingBalance
FROM
	AccumulationRegister.GoodsCostVariances AS Variances
		LEFT JOIN IdentifiersOfRegisteredRecordedMovements AS IdentifiersOfRegisteredRecordedMovements
		ON (IdentifiersOfRegisteredRecordedMovements.FinRecordID = Variances.FinRecordID)
{WHERE
	(Variances.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod),
	((Variances.Products, Variances.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	Variances.Recorder.* AS Recorder,
	Variances.Period AS SecondPeriod,
	(BEGINOFPERIOD(Variances.Period, DAY)) AS DayPeriod,
	(BEGINOFPERIOD(Variances.Period, WEEK)) AS WeekPeriod,
	(BEGINOFPERIOD(Variances.Period, TENDAYS)) AS TenDaysPeriod,
	(BEGINOFPERIOD(Variances.Period, MONTH)) AS MonthPeriod,
	(BEGINOFPERIOD(Variances.Period, QUARTER)) AS QuarterPeriod,
	(BEGINOFPERIOD(Variances.Period, HALFYEAR)) AS HalfYearPeriod,
	(BEGINOFPERIOD(Variances.Period, YEAR)) AS YearPeriod,
	Variances.Organization.*,
	Variances.Products.*,
	Variances.Characteristic.*,
	Variances.InventoryOwnerAttribute.*,
	Variances.LineOfBusiness.*,
	Variances.Department.*,
	Variances.StorageLocation.*,
	Variances.VariancePeriod,
	(CASE
			WHEN VALUETYPE(Variances.StorageLocation) = TYPE(Catalog.Warehouses)
				THEN CAST(Variances.StorageLocation AS Catalog.Warehouses)
			ELSE VALUE(Catalog.Warehouses.EmptyRef)
		END).* AS Warehouse,
	(CASE
			WHEN VALUETYPE(Variances.StorageLocation) = TYPE(Catalog.CounterpartyContracts)
				THEN CAST(Variances.StorageLocation AS Catalog.CounterpartyContracts)
			ELSE VALUE(Catalog.CounterpartyContracts.EmptyRef)
		END).* AS Contract,
	Variances.BusinessOperation.*}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ResidualsAndTurnsOfDeviations.SecondPeriod AS SecondPeriod,
	ResidualsAndTurnsOfDeviations.DayPeriod AS DayPeriod,
	ResidualsAndTurnsOfDeviations.WeekPeriod AS WeekPeriod,
	ResidualsAndTurnsOfDeviations.TenDaysPeriod AS TenDaysPeriod,
	ResidualsAndTurnsOfDeviations.MonthPeriod AS MonthPeriod,
	ResidualsAndTurnsOfDeviations.QuarterPeriod AS QuarterPeriod,
	ResidualsAndTurnsOfDeviations.HalfYearPeriod AS HalfYearPeriod,
	ResidualsAndTurnsOfDeviations.YearPeriod AS YearPeriod,
	ResidualsAndTurnsOfDeviations.Recorder AS Recorder,
	ResidualsAndTurnsOfDeviations.Organization AS Organization,
	ResidualsAndTurnsOfDeviations.Products AS Products,
	ResidualsAndTurnsOfDeviations.Characteristic AS Characteristic,
	ResidualsAndTurnsOfDeviations.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	ResidualsAndTurnsOfDeviations.LineOfBusiness AS LineOfBusiness,
	ResidualsAndTurnsOfDeviations.Department AS Department,
	ResidualsAndTurnsOfDeviations.StorageLocation AS StorageLocation,
	ResidualsAndTurnsOfDeviations.VariancePeriod AS VariancePeriod,
	ResidualsAndTurnsOfDeviations.Warehouse AS Warehouse,
	ResidualsAndTurnsOfDeviations.Contract AS Contract,
	ResidualsAndTurnsOfDeviations.BusinessOperation AS BusinessOperation,
	SUM(ResidualsAndTurnsOfDeviations.FullValueOpeningBalance) AS FullValueOpeningBalance,
	SUM(ResidualsAndTurnsOfDeviations.CostOpeningBalance) AS CostOpeningBalance,
	SUM(ResidualsAndTurnsOfDeviations.AddExpensesForGoodsOpeningBalance) AS AddExpensesForGoodsOpeningBalance,
	SUM(ResidualsAndTurnsOfDeviations.VATOpeningBalance) AS VATOpeningBalance,
	SUM(ResidualsAndTurnsOfDeviations.PermanentDifferenceOpeningBalance) AS PermanentDifferenceOpeningBalance,
	SUM(ResidualsAndTurnsOfDeviations.CostTDOpeningBalance) AS CostTDOpeningBalance,
	SUM(ResidualsAndTurnsOfDeviations.AITOpeningBalance) AS AITOpeningBalance,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.PurchasesFullCost) AS PurchasesFullCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.ProcurementCost) AS ProcurementCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.PurchasesAdditionalExpensesAmount) AS PurchasesAdditionalExpensesAmount,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.VATPurchases) AS VATPurchases,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.PurchasesAreConstantDifferenceInCostsPD) AS PurchasesAreConstantDifferenceInCostsPD,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.ProcurementCostedTD) AS ProcurementCostedTD,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AITPurchases) AS AITPurchases,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AdditionalExpensesAmountFullCost) AS AdditionalExpensesAmountFullCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AdditionalExpensesAmountOfCost) AS AdditionalExpensesAmountOfCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AdditionalExpensesAmountAdditionalExpensesAmount) AS AdditionalExpensesAmountAdditionalExpensesAmount,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AdditionalExpensesAmountOfVAT) AS AdditionalExpensesAmountOfVAT,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AdditionalExpensesAmountOfCostPDIsConstantDifference) AS AdditionalExpensesAmountOfCostPDIsConstantDifference,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AdditionalExpensesAmountOfTimeDifferenceCostTD) AS AdditionalExpensesAmountOfTimeDifferenceCostTD,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AdditionalExpensesAmountOfAIT) AS AdditionalExpensesAmountOfAIT,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.MovingFullCost) AS MovingFullCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.MovingCost) AS MovingCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.MovementsAdditionalExpensesAmount) AS MovementsAdditionalExpensesAmount,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.VATMovements) AS VATMovements,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.MovementsAreConstantCostPD) AS MovementsAreConstantCostPD,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.MovementsCostTD) AS MovementsCostTD,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AITSMovements) AS AITSMovements,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.IssueFullCost) AS IssueFullCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.IssueCost) AS IssueCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.IssueOfAdditionalExpensesAmount) AS IssueOfAdditionalExpensesAmount,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.VATIssue) AS VATIssue,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.IssueIsConstantCostPD) AS IssueIsConstantCostPD,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.ReleaseCostTDIsTimeDifference) AS ReleaseCostTDIsTimeDifference,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AITIssue) AS AITIssue,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.OtherFullCost) AS OtherFullCost,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.Other_Costs) AS Other_Costs,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.OtherAdditionalExpensesAmount) AS OtherAdditionalExpensesAmount,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.OtherVAT) AS OtherVAT,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.OtherCostPDDifferencesAreConstantOne) AS OtherCostPDDifferencesAreConstantOne,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.OtherCostTDOfDay) AS OtherCostTDOfDay,
	SUM(ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.OtherAIT) AS OtherAIT,
	// For a group of divergent columns, invert the sign.
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.SalesFullCost) AS SalesFullCost,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.Sales_Cost) AS Sales_Cost,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.SalesAdditionalExpensesAmount) AS SalesAdditionalExpensesAmount,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.VATSales) AS VATSales,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.SalesAreConstantDifferenceInCostsPD) AS SalesAreConstantDifferenceInCostsPD,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.SalesAreTimeDifferenceInCostTD) AS SalesAreTimeDifferenceInCostTD,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.AITSales) AS AITSales,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.WriteOffForExpensesAssetsFullCost) AS WriteOffForExpensesAssetsFullCost,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.WriteOffForExpensesAssetsCosts) AS WriteOffForExpensesAssetsCosts,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.WriteOffToExpensesAssetsAdditionalExpensesAmount) AS WriteOffToExpensesAssetsAdditionalExpensesAmount,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.WriteOffForExpensesVATAssets) AS WriteOffForExpensesVATAssets,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.WriteOffForExpensesOfAssetsCostedPD) AS WriteOffForExpensesOfAssetsCostedPD,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.WriteOffForExpensesOfAssetsCostTD) AS WriteOffForExpensesOfAssetsCostTD,
	SUM(-ResidualsAndTurnsOfDeviations.Character * ResidualsAndTurnsOfDeviations.WriteOffForExpensesAssetsAIT) AS WriteOffForExpensesAssetsAIT,
	SUM(ResidualsAndTurnsOfDeviations.FullValueClosingBalance) AS FullValueClosingBalance,
	SUM(ResidualsAndTurnsOfDeviations.CostClosingBalance) AS CostClosingBalance,
	SUM(ResidualsAndTurnsOfDeviations.AddExpensesForGoodsClosingBalance) AS AddExpensesForGoodsClosingBalance,
	SUM(ResidualsAndTurnsOfDeviations.VATClosingBalance) AS VATClosingBalance,
	SUM(ResidualsAndTurnsOfDeviations.PermanentDifferenceClosingBalance) AS PermanentDifferenceClosingBalance,
	SUM(ResidualsAndTurnsOfDeviations.CostTDClosingBalance) AS CostTDClosingBalance,
	SUM(ResidualsAndTurnsOfDeviations.AITClosingBalance) AS AITClosingBalance
{SELECT
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	Recorder.*,
	Organization.*,
	Products.*,
	Characteristic.*,
	InventoryOwnerAttribute.*,
	LineOfBusiness.*,
	Department.*,
	StorageLocation.*,
	VariancePeriod,
	Warehouse.*,
	Contract.*,
	BusinessOperation.*,
	FullValueOpeningBalance,
	CostOpeningBalance,
	AddExpensesForGoodsOpeningBalance,
	VATOpeningBalance,
	PermanentDifferenceOpeningBalance,
	CostTDOpeningBalance,
	AITOpeningBalance,
	PurchasesFullCost,
	ProcurementCost,
	PurchasesAdditionalExpensesAmount,
	VATPurchases,
	PurchasesAreConstantDifferenceInCostsPD,
	ProcurementCostedTD,
	AITPurchases,
	AdditionalExpensesAmountFullCost,
	AdditionalExpensesAmountOfCost,
	AdditionalExpensesAmountAdditionalExpensesAmount,
	AdditionalExpensesAmountOfVAT,
	AdditionalExpensesAmountOfCostPDIsConstantDifference,
	AdditionalExpensesAmountOfTimeDifferenceCostTD,
	AdditionalExpensesAmountOfAIT,
	MovingFullCost,
	MovingCost,
	MovementsAdditionalExpensesAmount,
	VATMovements,
	MovementsAreConstantCostPD,
	MovementsCostTD,
	AITSMovements,
	IssueFullCost,
	IssueCost,
	IssueOfAdditionalExpensesAmount,
	VATIssue,
	IssueIsConstantCostPD,
	ReleaseCostTDIsTimeDifference,
	AITIssue,
	OtherFullCost,
	Other_Costs,
	OtherAdditionalExpensesAmount,
	OtherVAT,
	OtherCostPDDifferencesAreConstantOne,
	OtherCostTDOfDay,
	OtherAIT,
	SalesFullCost,
	Sales_Cost,
	SalesAdditionalExpensesAmount,
	VATSales,
	SalesAreConstantDifferenceInCostsPD,
	SalesAreTimeDifferenceInCostTD,
	AITSales,
	WriteOffForExpensesAssetsFullCost,
	WriteOffForExpensesAssetsCosts,
	WriteOffToExpensesAssetsAdditionalExpensesAmount,
	WriteOffForExpensesVATAssets,
	WriteOffForExpensesOfAssetsCostedPD,
	WriteOffForExpensesOfAssetsCostTD,
	WriteOffForExpensesAssetsAIT,
	FullValueClosingBalance,
	CostClosingBalance,
	AddExpensesForGoodsClosingBalance,
	VATClosingBalance,
	PermanentDifferenceClosingBalance,
	CostTDClosingBalance,
	AITClosingBalance}
FROM
	ResidualsAndTurnsOfDeviations AS ResidualsAndTurnsOfDeviations
{WHERE
	ResidualsAndTurnsOfDeviations.SecondPeriod,
	ResidualsAndTurnsOfDeviations.DayPeriod,
	ResidualsAndTurnsOfDeviations.WeekPeriod,
	ResidualsAndTurnsOfDeviations.TenDaysPeriod,
	ResidualsAndTurnsOfDeviations.MonthPeriod,
	ResidualsAndTurnsOfDeviations.QuarterPeriod,
	ResidualsAndTurnsOfDeviations.HalfYearPeriod,
	ResidualsAndTurnsOfDeviations.YearPeriod,
	ResidualsAndTurnsOfDeviations.Recorder.*,
	ResidualsAndTurnsOfDeviations.Organization.*,
	ResidualsAndTurnsOfDeviations.Products.*,
	ResidualsAndTurnsOfDeviations.Characteristic.*,
	ResidualsAndTurnsOfDeviations.InventoryOwnerAttribute.*,
	ResidualsAndTurnsOfDeviations.LineOfBusiness.*,
	ResidualsAndTurnsOfDeviations.Department.*,
	ResidualsAndTurnsOfDeviations.StorageLocation.*,
	ResidualsAndTurnsOfDeviations.VariancePeriod,
	ResidualsAndTurnsOfDeviations.Warehouse.*,
	ResidualsAndTurnsOfDeviations.Contract.*,
	ResidualsAndTurnsOfDeviations.BusinessOperation.*,
	ResidualsAndTurnsOfDeviations.FullValueOpeningBalance,
	ResidualsAndTurnsOfDeviations.CostOpeningBalance,
	ResidualsAndTurnsOfDeviations.AddExpensesForGoodsOpeningBalance,
	ResidualsAndTurnsOfDeviations.VATOpeningBalance,
	ResidualsAndTurnsOfDeviations.PermanentDifferenceOpeningBalance,
	ResidualsAndTurnsOfDeviations.CostTDOpeningBalance,
	ResidualsAndTurnsOfDeviations.AITOpeningBalance,
	ResidualsAndTurnsOfDeviations.PurchasesFullCost,
	ResidualsAndTurnsOfDeviations.ProcurementCost,
	ResidualsAndTurnsOfDeviations.PurchasesAdditionalExpensesAmount,
	ResidualsAndTurnsOfDeviations.VATPurchases,
	ResidualsAndTurnsOfDeviations.PurchasesAreConstantDifferenceInCostsPD,
	ResidualsAndTurnsOfDeviations.ProcurementCostedTD,
