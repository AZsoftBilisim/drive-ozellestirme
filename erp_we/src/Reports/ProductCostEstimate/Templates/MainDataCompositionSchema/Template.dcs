		<field xsi:type="DataSetFieldField">
			<dataPath>ThisIsOutput_</dataPath>
			<field>ThisIsOutput_</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Are products</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>محصولات هستند</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Это продукция</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Bu bir imal edilen üründür</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đây là thành phẩm</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Are products</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Are products</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type>xs:boolean</v8:Type>
			</valueType>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	FALSE AS ThisIsOutput_,
	CASE
		WHEN TRUE
			THEN VALUE(Document.ProductionStage2_2.EmptyRef)
		WHEN FALSE
			THEN VALUE(Catalog.BillsOfMaterials.EmptyRef)
		WHEN FALSE
			THEN VALUE(Document.ProductionOrder2_2.EmptyRef)
	END AS CostObject,
	VALUE(Document.StandardCosting2_2.EmptyRef) AS StandardCostEstimate,
	VALUE(Catalog.Products.EmptyRef) AS ManufacturedProduct,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS ItemVariant,
	CASE
		WHEN TRUE
			THEN VALUE(Catalog.CounterpartyContracts.EmptyRef)
		WHEN FALSE
			THEN VALUE(Catalog.Companies.EmptyRef)
		WHEN FALSE
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
		WHEN FALSE
			THEN VALUE(Catalog.Partners.EmptyRef)
		WHEN FALSE
			THEN VALUE(Catalog.Warehouses.EmptyRef)
	END AS Department,
	VALUE(Catalog.ProductCostElements.EmptyRef) AS ProductCostElement,
	CASE
		WHEN TRUE
			THEN VALUE(Catalog.Products.EmptyRef)
		WHEN FALSE
			THEN VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef)
		WHEN FALSE
			THEN VALUE(Catalog.EmployeeWorkKinds.EmptyRef)
	END AS Products,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	CAST("" AS STRING(16)) AS ExpenseType,
	CAST(0 AS NUMBER) AS Count,
	CAST(0 AS NUMBER) AS Cost,
	CAST(0 AS NUMBER) AS CostOfMaterial,
	CAST(0 AS NUMBER) AS CostLaborCosts,
	CAST(0 AS NUMBER) AS CostOtherFixed,
	CAST(0 AS NUMBER) AS CostOtherVariable,
	CAST(0 AS NUMBER) AS Price,
	CAST(0 AS NUMBER) AS OffBalanceCost,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS ProductsUnitOfMeasurement_3,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS ProductsUnitOfMeasure,
	CASE
		WHEN TRUE
			THEN VALUE(Document.ProductionStage2_2.EmptyRef)
		WHEN FALSE
			THEN VALUE(Catalog.BillsOfMaterials.EmptyRef)
		WHEN FALSE
			THEN VALUE(Document.BackflushProduction.EmptyRef)
	END AS ProductsBatch,
	FALSE AS ThisIsASemiFinishedProduct,
	VALUE(Catalog.Products.EmptyRef) AS SemiFinishedProduct,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS ItemVariantsOfIntermediateProduct,
	VALUE(Catalog.Assignments.EmptyRef) AS AssignmentOfProducts,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS SemiFinishedProductUnitOfMeasurement,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	CAST(0 AS NUMBER) AS Order,
	CASE
		WHEN TRUE
			THEN VALUE(Document.ProductionStage2_2.EmptyRef)
		WHEN FALSE
			THEN VALUE(Catalog.BillsOfMaterials.EmptyRef)
		WHEN FALSE
			THEN VALUE(Document.BackflushProduction.EmptyRef)
	END AS LotProductBOM,
	CAST(0 AS NUMBER) AS ReleasedQuantity,
	UUID(VALUE(Catalog.Counterparties.EmptyRef)) AS KeyLot
WHERE
	&amp;Cost_Data
	AND &amp;Period</query>
	</dataSet>
	<totalField>
		<dataPath>Cost</dataPath>
		<expression>Sum(Cost)</expression>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Case
	When ThisIsASemiFinishedProduct Or Sum(Count) = 0
		Then Avg(Price) 
	Else Sum(Cost) / Sum(Count)
End</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(ReleasedQuantity)</expression>
		<group>SemiFinishedProduct</group>
	</totalField>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>0</expression>
	</totalField>
	<totalField>
		<dataPath>OffBalanceCost</dataPath>
		<expression>Sum(OffBalanceCost)</expression>
	</totalField>
	<totalField>
		<dataPath>CostOfMaterial</dataPath>
		<expression>Sum(CostOfMaterial)</expression>
	</totalField>
	<totalField>
		<dataPath>CostOtherVariable</dataPath>
		<expression>Sum(CostOtherVariable)</expression>
	</totalField>
	<totalField>
		<dataPath>CostOtherFixed</dataPath>
		<expression>Sum(CostOtherFixed)</expression>
	</totalField>
	<totalField>
		<dataPath>CostLaborCosts</dataPath>
		<expression>Sum(CostLaborCosts)</expression>
	</totalField>
	<totalField>
		<dataPath>Order</dataPath>
		<expression>Max(Order)</expression>
	</totalField>
	<parameter>
		<name>Period</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Okres</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>Cost_Data</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Cost data</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>داده‌های بها</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Dati secondo il costo di produzione</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Dane dot. kosztów własnych</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Данные по себестоимости</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Maliyete ilişkin veriler</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Dữ liệu theo giá vốn</v8:content>
			</v8:item>
