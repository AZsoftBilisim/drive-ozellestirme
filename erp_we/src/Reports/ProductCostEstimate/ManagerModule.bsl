	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	ActualCosts.CostObject AS CostObject,
	|	ActualCosts.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	ActualCosts.LotProductBOM AS LotProductBOM,
	|	ActualCosts.ProductionLot AS ProductionLot,
	|	ActualCosts.KeyLot AS KeyLot
	|INTO PartyAnalysts
	|FROM
	|	ActualCosts AS ActualCosts
	|WHERE
	|	NOT ActualCosts.ItemsLocationAttributes = VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef)
	|	AND ActualCosts.ThisIsOutput_
	|	AND ActualCosts.ExpenseType = ""Material_""
	|
	|UNION ALL
	|
	|SELECT DISTINCT
	|	ActualCosts.CostObject,
	|	ActualCosts.ItemsLocationAttributes,
	|	ActualCosts.SemiFinishedProductLot,
	|	ActualCosts.ProductionLot,
	|	ActualCosts.KeyLot
	|FROM
	|	ActualCosts AS ActualCosts
	|WHERE
	|	NOT ActualCosts.ThisIsOutput_
	|	AND ActualCosts.ExpenseType = ""Material_""
	|
	|INDEX BY
	|	LotProductBOM,
	|	ItemsLocationAttributes
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT DISTINCT
	|	PartyAnalysts.CostObject AS CostObject,
	|	PartyAnalysts.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	PartyAnalysts.LotProductBOM AS LotProductBOM,
	|	PartyDefinition.Lot AS Lot,
	|	PartyDefinition.LotVendorAttributes AS LotVendorAttributes,
	|	PartyAnalysts.KeyLot AS KeyLot
	|INTO TTDefinitionOfLotReference
	|FROM
	|	PartyAnalysts AS PartyAnalysts
	|		INNER JOIN AccumulationRegister.InventoryCost AS PartyDefinition
	|		ON PartyAnalysts.ProductionLot = PartyDefinition.CorLot
	|			AND PartyAnalysts.ItemsLocationAttributes = PartyDefinition.CorItemsLocationAttributes
	|			AND (PartyDefinition.RecordType = VALUE(AccumulationRecordType.Expense))
	|			AND (PartyDefinition.AccountingSection IN (VALUE(Enum.SectionsOfInventoryCostAccounting.ProductionCosts), VALUE(Enum.SectionsOfInventoryCostAccounting.GoodsReceivedForRespSafekeeping)))
	|			AND (PartyDefinition.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpensingToProductionLots))
	|			AND (PartyDefinition.Count > 0)
	|
	|INDEX BY
	|	Lot,
	|	LotVendorAttributes
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT ALLOWED
	|	PartyDefinition.CostObject AS CostObject,
	|	PartyDefinition.ItemsLocationAttributes AS ItemsLocationAttributes,
	|	PartyDefinition.LotProductBOM AS LotProductBOM,
	|	ReleaseRegisteredRecords.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost) AS FixedCost,
	|	SUM(ISNULL(ReleaseRegisteredRecords.Count, 0)) AS Count,
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN ISNULL(ReleaseRegisteredRecords.Cost, 0) + ISNULL(ReleaseRegisteredRecords.AddExpensesForGoods, 0)
	|			WHEN &Cost_Data = 2
	|				THEN ISNULL(ReleaseRegisteredRecords.CostExcludingVAT, 0) + ISNULL(ReleaseRegisteredRecords.AdditionalExpensesExcludingVAT, 0)
	|			ELSE ISNULL(ReleaseRegisteredRecords.LocalCost, 0) + ISNULL(ReleaseRegisteredRecords.AddExpensesLocal, 0)
	|		END) AS CostOfMaterial,
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN ISNULL(ReleaseRegisteredRecords.LaborCosts, 0)
	|			WHEN &Cost_Data = 2
	|				THEN ISNULL(ReleaseRegisteredRecords.LaborCosts, 0)
	|			ELSE ISNULL(ReleaseRegisteredRecords.LaborCostsLocal, 0)
	|		END) AS CostLaborCosts,
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN ISNULL(ReleaseRegisteredRecords.ItemizedFixedCostsIncludingVAT, 0)
	|			WHEN &Cost_Data = 2
	|				THEN ISNULL(ReleaseRegisteredRecords.ItemizedFixedCostsExcludingVAT, 0)
	|			ELSE ISNULL(ReleaseRegisteredRecords.ItemizedFixedCostsCompl, 0)
	|		END) AS CostOtherFixed,
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN ISNULL(ReleaseRegisteredRecords.ItemizedVariableCostsIncludingVAT, 0)
	|			WHEN &Cost_Data = 2
	|				THEN ISNULL(ReleaseRegisteredRecords.ItemizedVariableCostsExcludingVAT, 0)
	|			ELSE ISNULL(ReleaseRegisteredRecords.ItemizedVariableCostsCompl, 0)
	|		END) AS CostOtherVariable,
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN ISNULL(ReleaseRegisteredRecords.Cost, 0) + ISNULL(ReleaseRegisteredRecords.AddExpensesForGoods, 0) + ISNULL(ReleaseRegisteredRecords.ItemizedFixedCostsIncludingVAT, 0) + ISNULL(ReleaseRegisteredRecords.ItemizedVariableCostsIncludingVAT, 0) + ISNULL(ReleaseRegisteredRecords.LaborCosts, 0)
	|			WHEN &Cost_Data = 2
	|				THEN ISNULL(ReleaseRegisteredRecords.CostExcludingVAT, 0) + ISNULL(ReleaseRegisteredRecords.AdditionalExpensesExcludingVAT, 0) + ISNULL(ReleaseRegisteredRecords.ItemizedFixedCostsExcludingVAT, 0) + ISNULL(ReleaseRegisteredRecords.ItemizedVariableCostsExcludingVAT, 0) + ISNULL(ReleaseRegisteredRecords.LaborCosts, 0)
	|			ELSE ISNULL(ReleaseRegisteredRecords.LocalCost, 0) + ISNULL(ReleaseRegisteredRecords.AddExpensesLocal, 0) + ISNULL(ReleaseRegisteredRecords.ItemizedFixedCostsCompl, 0) + ISNULL(ReleaseRegisteredRecords.ItemizedVariableCostsCompl, 0) + ISNULL(ReleaseRegisteredRecords.LaborCostsLocal, 0)
	|		END) AS Cost,
	|	SUM(CASE
	|			WHEN &Cost_Data = 3
	|				THEN ISNULL(ReleaseRegisteredRecords.OffBalanceCost, 0)
	|			ELSE ISNULL(ReleaseRegisteredRecords.OffBalanceCostLocal, 0)
	|		END) AS OffBalanceCost,
	|	PartyDefinition.KeyLot AS KeyLot
	|INTO DefinitionOfSemiFinishedProducts
	|FROM
	|	TTDefinitionOfLotReference AS PartyDefinition
	|		INNER JOIN AccumulationRegister.InventoryCost AS ReleaseRegisteredRecords
	|		ON PartyDefinition.Lot = ReleaseRegisteredRecords.Lot
	|			AND PartyDefinition.LotVendorAttributes = ReleaseRegisteredRecords.LotVendorAttributes
	|			AND (ReleaseRegisteredRecords.BusinessOperation IN (VALUE(Enum.BusinessTransactions.ProductsRelease), VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost)))
	|
	|GROUP BY
	|	PartyDefinition.CostObject,
	|	PartyDefinition.ItemsLocationAttributes,
	|	PartyDefinition.LotProductBOM,
	|	ReleaseRegisteredRecords.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost),
	|	PartyDefinition.KeyLot
	|
	|INDEX BY
	|	ItemsLocationAttributes
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|DROP TTDefinitionOfLotReference
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT
	|	TT.CostObject AS CostObject,
	|	TT.StandardCostEstimate AS StandardCostEstimate,
	|	TT.ManufacturedProduct AS ManufacturedProduct,
	|	TT.ItemVariant AS ItemVariant,
	|	SUM(TT.Cost) / CASE
	|		WHEN SUM(TT.QuantityOfSemiFinishedProduct) = 0
	|			THEN 1
	|		ELSE SUM(TT.QuantityOfSemiFinishedProduct)
	|	END AS Price,
	|	TT.ProductsBatch AS ProductsBatch,
	|	TT.SemiFinishedProduct AS SemiFinishedProduct,
	|	TT.ItemVariantsOfIntermediateProduct AS ItemVariantsOfIntermediateProduct,
	|	TT.AssignmentOfProducts AS AssignmentOfProducts
	|INTO PricesOfSemiFinishedProducts
	|FROM
	|	(SELECT
	|		Data.CostObject AS CostObject,
	|		Data.StandardCostEstimate AS StandardCostEstimate,
	|		Data.ManufacturedProduct AS ManufacturedProduct,
	|		Data.ItemVariant AS ItemVariant,
	|		SUM(Data.Cost) AS Cost,
	|		0 AS QuantityOfSemiFinishedProduct,
	|		Data.LotProductBOM AS ProductsBatch,
	|		Data.SemiFinishedProduct AS SemiFinishedProduct,
	|		Data.ItemVariantsOfIntermediateProduct AS ItemVariantsOfIntermediateProduct,
	|		Data.Purpose AS AssignmentOfProducts,
	|		Data.KeyLot AS KeyLot
	|	FROM
	|		Data AS Data
	|	
	|	GROUP BY
	|		Data.CostObject,
	|		Data.StandardCostEstimate,
	|		Data.ManufacturedProduct,
	|		Data.ItemVariant,
	|		Data.LotProductBOM,
	|		Data.SemiFinishedProduct,
	|		Data.ItemVariantsOfIntermediateProduct,
	|		Data.Purpose,
	|		Data.KeyLot
	|	
	|	UNION ALL
	|	
	|	SELECT
	|		Multipliers.CostObject,
	|		Multipliers.StandardCostEstimate,
	|		Multipliers.ManufacturedProduct,
	|		Multipliers.ItemVariant,
	|		0,
	|		SUM(Multipliers.QuantityOfSemiFinishedProduct),
	|		Multipliers.LotProductBOM,
	|		Multipliers.SemiFinishedProduct,
	|		Multipliers.ItemVariantsOfIntermediateProduct,
	|		Multipliers.Purpose,
	|		Multipliers.KeyLot
	|	FROM
	|		CommonMultipliers AS Multipliers
	|	
	|	GROUP BY
	|		Multipliers.CostObject,
	|		Multipliers.StandardCostEstimate,
	|		Multipliers.ManufacturedProduct,
	|		Multipliers.ItemVariant,
	|		Multipliers.LotProductBOM,
	|		Multipliers.SemiFinishedProduct,
	|		Multipliers.ItemVariantsOfIntermediateProduct,
	|		Multipliers.Purpose,
	|		Multipliers.KeyLot) AS TT
	|
	|GROUP BY
	|	TT.CostObject,
	|	TT.StandardCostEstimate,
	|	TT.ManufacturedProduct,
	|	TT.ItemVariant,
	|	TT.ProductsBatch,
	|	TT.SemiFinishedProduct,
	|	TT.ItemVariantsOfIntermediateProduct,
	|	TT.AssignmentOfProducts
	|";
	
	QueriesTexts.Add(QueryText);
	Result = StrConcat(QueriesTexts, Common.QueryBatchSeparator());
	Return Result;
	
EndFunction

