	|	CommonMultipliers.SemiFinishedProduct,
	|	CommonMultipliers.ItemVariantsOfIntermediateProduct,
	|	InventoryCost.Lot,
	|	InventoryCost.CorLot,
	|	InventoryCost.ItemsLocationAttributes
	|
