//@strict-types

#If Server Or ThickClientOrdinaryApplication Or ExternalConnection Then

#Region Public

// The function returns the general Query Text that is used
//  in the reports: Planned cost of production, comparison of planned items
//  and in the printed Form of the document PLANINGCALCULATION2_2 - PF_MXL_Planned articulation.
// Parameters:
//  GenerateCalculatedAmountOfTT - Boolean - It depends on the transmitted value whether the calculated quantity will be generated in this Query Text, TT.
//  
//  For example, in the Planned Production cost report, this TT is generated by another query.
//
// Returns:
//  String - Query text
Function QueryText_ProductStandardCostData(GenerateCalculatedAmountOfTT) Export
	
	QueriesTexts = New Array();
	If GenerateCalculatedAmountOfTT Then
		QueryText = "
			|SELECT ALLOWED
			|	DD.StandardCostEstimate AS StandardCostEstimate,
			|	DD.ManufacturedProduct AS ManufacturedProduct,
			|	DD.ItemVariant AS ItemVariant,
			|	DD.Purpose AS Purpose,
			|	SUM(DD.QuantityOfSemiFinishedProduct) AS CountTotal
			|INTO CalculatedCount
			|FROM
			|	InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS DD
			|WHERE
			|	DD.StandardCostEstimate IN (&ProductStandardCosts)
			|	AND DD.SemiFinishedProduct = VALUE(Catalog.Products.EmptyRef)
			|
			|GROUP BY
			|	DD.StandardCostEstimate,
			|	DD.ManufacturedProduct,
			|	DD.ItemVariant,
			|	DD.Purpose
			|";
		QueriesTexts.Add(QueryText);
	EndIf;
	
	QueryText = "SELECT ALLOWED
	|	CalculationOfProductsObjectsOfCalculation.Object AS CostObject,
	|	CalculatedCount.ManufacturedProduct AS ManufacturedProduct,
	|	CalculatedCount.ItemVariant AS ItemVariant,
	|	CalculatedCount.Purpose AS Purpose,
	|	CalculatedCount.StandardCostEstimate AS StandardCostEstimate,
	|	CalculationOfProductsObjectsOfCalculation.Count / CalculatedCount.CountTotal AS CostShare
	|INTO SharesOfValueFromCalculatedQuantity
	|FROM
	|	CalculatedCount AS CalculatedCount
	|		INNER JOIN Document.StandardCosting2_2.CostObjects AS CalculationOfProductsObjectsOfCalculation
	|		ON CalculatedCount.StandardCostEstimate = CalculationOfProductsObjectsOfCalculation.Ref
	|			AND CalculatedCount.ManufacturedProduct = CalculationOfProductsObjectsOfCalculation.Products
	|			AND CalculatedCount.ItemVariant = CalculationOfProductsObjectsOfCalculation.Characteristic
	|			AND CalculatedCount.Purpose = CalculationOfProductsObjectsOfCalculation.Purpose
	|
	|		INNER JOIN Document.StandardCosting2_2 AS CalculationOfProduction
	|		ON CalculatedCount.StandardCostEstimate = CalculationOfProduction.Ref
	|WHERE
	|	CalculationOfProduction.CostObject = VALUE(Enum.CostObjects.BillOfMaterial)
	|{WHERE
	|	CalculationOfProductsObjectsOfCalculation.Object AS CostObject}
	|
	|UNION ALL
	|
	|SELECT
	|	CalculationOfProductsObjectsOfCalculation.Object,
	|	CalculatedCount.ManufacturedProduct,
	|	CalculatedCount.ItemVariant,
	|	CalculatedCount.Purpose,
	|	CalculatedCount.StandardCostEstimate,
	|
	|	CalculationOfProductsObjectsOfCalculation.Count / CalculatedCount.CountTotal
	|FROM
	|	CalculatedCount AS CalculatedCount
	|		INNER JOIN Document.StandardCosting2_2.CostObjects AS CalculationOfProductsObjectsOfCalculation
	|		ON CalculatedCount.StandardCostEstimate = CalculationOfProductsObjectsOfCalculation.Ref
	|			AND CalculatedCount.ManufacturedProduct = CalculationOfProductsObjectsOfCalculation.Products
	|			AND CalculatedCount.ItemVariant = CalculationOfProductsObjectsOfCalculation.Characteristic
	|			AND CalculatedCount.Purpose = CalculationOfProductsObjectsOfCalculation.Purpose
	|		INNER JOIN Document.StandardCosting2_2 AS CalculationOfProduction
	|		ON CalculatedCount.StandardCostEstimate = CalculationOfProduction.Ref
	|WHERE
	|	NOT CalculationOfProduction.CostObject = VALUE(Enum.CostObjects.BillOfMaterial)
	|{WHERE
	|	CalculationOfProductsObjectsOfCalculation.Object AS CostObject}
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT ALLOWED
	|	CostShares.CostObject AS CostObject,
	|	MultiplesOfLotsAndSemiFinishedProducts.StandardCostEstimate AS StandardCostEstimate,
	|	MultiplesOfLotsAndSemiFinishedProducts.ManufacturedProduct AS ManufacturedProduct,
	|	MultiplesOfLotsAndSemiFinishedProducts.ItemVariant AS ItemVariant,
	|	MultiplesOfLotsAndSemiFinishedProducts.LotProductBOM AS LotProductBOM,
	|	MultiplesOfLotsAndSemiFinishedProducts.SemiFinishedProduct AS SemiFinishedProduct,
	|	MultiplesOfLotsAndSemiFinishedProducts.ItemVariantsOfIntermediateProduct AS ItemVariantsOfIntermediateProduct,
	|	MultiplesOfLotsAndSemiFinishedProducts.LotSemiFinishedProductBOM AS LotSemiFinishedProductBOM,
	|	MultiplesOfLotsAndSemiFinishedProducts.KeyLot AS KeyLot,
	|	MultiplesOfLotsAndSemiFinishedProducts.Denominator AS Denominator,
	|	MultiplesOfLotsAndSemiFinishedProducts.LotIsReleased AS LotIsReleased,
	|	MultiplesOfLotsAndSemiFinishedProducts.SemiFinishedProduct = VALUE(Catalog.Products.EmptyRef) AS ThisIsOutput_,
	|	MultiplesOfLotsAndSemiFinishedProducts.Purpose AS Purpose,
	|	SUM(MultiplesOfLotsAndSemiFinishedProducts.QuantityOfSemiFinishedProduct * CostShares.CostShare) AS QuantityOfSemiFinishedProduct,
	|	SUM(MultiplesOfLotsAndSemiFinishedProducts.Numerator * CostShares.CostShare) AS Numerator,
	|	SUM(CostShares.CostShare) AS CostShare,
	|	MIN(MultiplesOfLotsAndSemiFinishedProducts.Order) AS Order
	|INTO CommonMultipliers
	|FROM
	|	SharesOfValueFromCalculatedQuantity AS CostShares
	|		INNER JOIN InformationRegister.MultiplesOfLotsAndSemiFinishedProducts AS MultiplesOfLotsAndSemiFinishedProducts
	|		ON (MultiplesOfLotsAndSemiFinishedProducts.StandardCostEstimate = CostShares.StandardCostEstimate)
	|			AND (MultiplesOfLotsAndSemiFinishedProducts.ManufacturedProduct = CostShares.ManufacturedProduct)
	|			AND (MultiplesOfLotsAndSemiFinishedProducts.ItemVariant = CostShares.ItemVariant)
	|			AND (MultiplesOfLotsAndSemiFinishedProducts.Purpose = CostShares.Purpose)
	|
	|GROUP BY
	|	CostShares.CostObject,
	|	MultiplesOfLotsAndSemiFinishedProducts.LotProductBOM,
	|	MultiplesOfLotsAndSemiFinishedProducts.ItemVariant,
	|	MultiplesOfLotsAndSemiFinishedProducts.ManufacturedProduct,
	|	MultiplesOfLotsAndSemiFinishedProducts.StandardCostEstimate,
	|	MultiplesOfLotsAndSemiFinishedProducts.ItemVariantsOfIntermediateProduct,
	|	MultiplesOfLotsAndSemiFinishedProducts.SemiFinishedProduct,
	|	MultiplesOfLotsAndSemiFinishedProducts.LotSemiFinishedProductBOM,
	|	MultiplesOfLotsAndSemiFinishedProducts.LotIsReleased,
	|	MultiplesOfLotsAndSemiFinishedProducts.Denominator,
	|	MultiplesOfLotsAndSemiFinishedProducts.Purpose,
	|	MultiplesOfLotsAndSemiFinishedProducts.SemiFinishedProduct = VALUE(Catalog.Products.EmptyRef),
	|	MultiplesOfLotsAndSemiFinishedProducts.KeyLot
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT ALLOWED
	|	CommonMultipliers.CostObject AS CostObject,
	|	CommonMultipliers.StandardCostEstimate AS StandardCostEstimate,
	|	CommonMultipliers.ManufacturedProduct AS ManufacturedProduct,
	|	CommonMultipliers.ItemVariant AS ItemVariant,
	|	CommonMultipliers.LotProductBOM AS LotProductBOM,
	|	CommonMultipliers.SemiFinishedProduct AS SemiFinishedProduct,
	|	CommonMultipliers.ItemVariantsOfIntermediateProduct AS ItemVariantsOfIntermediateProduct,
	|	CommonMultipliers.LotSemiFinishedProductBOM AS LotSemiFinishedProductBOM,
	|	CommonMultipliers.KeyLot AS KeyLot,
	|	Cost_.Count AS QuantityOfSemiFinishedProduct,
	|	CommonMultipliers.Numerator AS Numerator,
	|	CommonMultipliers.Denominator AS Denominator,
	|	CommonMultipliers.LotIsReleased AS LotIsReleased,
	|	CommonMultipliers.ThisIsOutput_ AS ThisIsOutput_,
	|	CommonMultipliers.Purpose AS Purpose,
	|	CommonMultipliers.CostShare AS CostShare,
	|	Cost_.LotVendorAttributes AS LotVendorAttributes,
	|	CommonMultipliers.Order AS Order
	|INTO CommonMultipliersWithBatchAnalytics
	|FROM
	|	CommonMultipliers AS CommonMultipliers
	|		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Analysts
	|		ON (Analysts.Products = CommonMultipliers.ManufacturedProduct)
	|			AND (Analysts.Characteristic = CommonMultipliers.ItemVariant)
	|		LEFT JOIN AccumulationRegister.InventoryCost AS Cost_
	|		ON (Cost_.ItemsLocationAttributes = Analysts.Ref)
	|			AND (Cost_.Lot = CommonMultipliers.LotProductBOM)
	|			AND (Cost_.RecordType = VALUE(AccumulationRecordType.Receipt))
	|			AND (Cost_.BusinessOperation = VALUE(Enum.BusinessTransactions.ProductsRelease))
	|			AND (Cost_.Count > 0)
	|			AND (Cost_.CorItemsLocationAttributes = VALUE(Catalog.InventoryLocationAttributeKeys.EmptyRef))
	|WHERE
	|	CommonMultipliers.LotIsReleased
	|	AND CommonMultipliers.ThisIsOutput_
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|SELECT ALLOWED
	|	Multipliers.ThisIsOutput_ AS ThisIsOutput_,
	|	Multipliers.CostObject AS CostObject,
	|	Multipliers.StandardCostEstimate AS StandardCostEstimate,
	|	Multipliers.ManufacturedProduct AS ManufacturedProduct,
	|	Multipliers.ItemVariant AS ItemVariant,
	|	Multipliers.QuantityOfSemiFinishedProduct AS QuantityOfSemiFinishedProduct,
	|	PlannedMaterialCosts.Department AS Department,
	|	PlannedMaterialCosts.ProductCostElement AS ProductCostElement,
	|	PlannedMaterialCosts.Products AS Products,
	|	PlannedMaterialCosts.Characteristic AS Characteristic,
	|	SUM(PlannedMaterialCosts.Count / Multipliers.Denominator * Multipliers.Numerator) AS Count,
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN PlannedMaterialCosts.Cost
	|			WHEN &Cost_Data = 2
	|				THEN PlannedMaterialCosts.CostExcludingVAT
	|			ELSE PlannedMaterialCosts.LocalCost
	|		END / Multipliers.Denominator * Multipliers.Numerator) AS Cost,
	|	CASE
	|		WHEN PlannedMaterialCosts.Count < 0
	|			THEN ""RecyclableWaste""
	|		ELSE ""Material_""
	|	END AS ExpenseType,
	|	Multipliers.LotProductBOM AS LotProductBOM,
	|	PlannedMaterialCosts.ThisIsASemiFinishedProduct AS ThisIsASemiFinishedProduct,
	|	Multipliers.ManufacturedProduct AS SemiFinishedProduct,
	|	Multipliers.ItemVariant AS ItemVariantsOfIntermediateProduct,
	|	Multipliers.Purpose AS Purpose,
	|	Multipliers.Order AS Order,
	|	CASE
	|		WHEN &Cost_Data = 3
	|			THEN PlannedMaterialCosts.OffBalanceCostLocal
	|		ELSE PlannedMaterialCosts.OffBalanceCost
	|	END / Multipliers.Denominator * Multipliers.Numerator AS OffBalanceSheet,
	|	Multipliers.KeyLot AS KeyLot
	|INTO Data
	|FROM
	|	CommonMultipliers AS Multipliers
	|		INNER JOIN AccumulationRegister.PlannedMaterialCosts AS PlannedMaterialCosts
	|		ON (Multipliers.StandardCostEstimate = PlannedMaterialCosts.StandardCostEstimate)
	|			AND (Multipliers.LotProductBOM = PlannedMaterialCosts.LotBOM)
	|			AND (Multipliers.KeyLot = PlannedMaterialCosts.KeyLot)
	|WHERE
	|	NOT Multipliers.LotIsReleased
	|	AND Multipliers.ThisIsOutput_
	|
	|GROUP BY
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	PlannedMaterialCosts.Products,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.StandardCostEstimate,
	|	PlannedMaterialCosts.Characteristic,
	|	PlannedMaterialCosts.ProductCostElement,
	|	PlannedMaterialCosts.Department,
	|	CASE
	|		WHEN PlannedMaterialCosts.Count < 0
	|			THEN ""RecyclableWaste""
	|		ELSE ""Material_""
	|	END,
	|	Multipliers.LotProductBOM,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	PlannedMaterialCosts.ThisIsASemiFinishedProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	CASE
	|		WHEN &Cost_Data = 3
	|			THEN PlannedMaterialCosts.OffBalanceCostLocal
	|		ELSE PlannedMaterialCosts.OffBalanceCost
	|	END / Multipliers.Denominator * Multipliers.Numerator,
	|	Multipliers.KeyLot
	|
	|UNION ALL
	|
	|SELECT
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	Multipliers.StandardCostEstimate,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	PlannedLaborCosts.Department,
	|	PlannedLaborCosts.ProductCostElement,
	|	PlannedLaborCosts.WorkKind,
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef),
	|	SUM(PlannedLaborCosts.Count / Multipliers.Denominator * Multipliers.Numerator),
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|					OR &Cost_Data = 2
	|				THEN PlannedLaborCosts.Cost
	|			ELSE PlannedLaborCosts.LocalCost
	|		END / Multipliers.Denominator * Multipliers.Numerator),
	|	""LaborCosts"",
	|	Multipliers.LotProductBOM,
	|	FALSE,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	0,
	|	Multipliers.KeyLot
	|FROM
	|	CommonMultipliers AS Multipliers
	|		INNER JOIN AccumulationRegister.PlannedLaborCosts AS PlannedLaborCosts
	|		ON Multipliers.StandardCostEstimate = PlannedLaborCosts.StandardCostEstimate
	|			AND Multipliers.LotProductBOM = PlannedLaborCosts.LotBOM
	|			AND Multipliers.KeyLot = PlannedLaborCosts.KeyLot
	|WHERE
	|	NOT Multipliers.LotIsReleased
	|	AND Multipliers.ThisIsOutput_
	|
	|GROUP BY
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	PlannedLaborCosts.WorkKind,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.StandardCostEstimate,
	|	PlannedLaborCosts.ProductCostElement,
	|	PlannedLaborCosts.Department,
	|	Multipliers.LotProductBOM,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	Multipliers.KeyLot
	|
	|UNION ALL
	|
	|SELECT
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	Multipliers.StandardCostEstimate,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	PlannedOtherCosts.Department,
	|	PlannedOtherCosts.ProductCostElement,
	|	PlannedOtherCosts.ExpenseItem,
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef),
	|	0,
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN PlannedOtherCosts.Cost
	|			WHEN &Cost_Data = 2
	|				THEN PlannedOtherCosts.CostExcludingVAT
	|			ELSE PlannedOtherCosts.LocalCost
	|		END / Multipliers.Denominator * Multipliers.Numerator),
	|	CASE
	|		WHEN PlannedOtherCosts.ExpenseItem.ProductionCostType = VALUE(Enum.ProductionCostType.Constant)
	|			THEN ""OtherPermanent""
	|		ELSE ""OtherVariables""
	|	END,
	|	Multipliers.LotProductBOM,
	|	FALSE,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	0,
	|	Multipliers.KeyLot
	|FROM
	|	CommonMultipliers AS Multipliers
	|		INNER JOIN AccumulationRegister.PlannedOtherCosts AS PlannedOtherCosts
	|		ON Multipliers.StandardCostEstimate = PlannedOtherCosts.StandardCostEstimate
	|			AND Multipliers.LotProductBOM = PlannedOtherCosts.LotBOM
	|			AND Multipliers.KeyLot = PlannedOtherCosts.KeyLot
	|WHERE
	|	NOT Multipliers.LotIsReleased
	|	AND Multipliers.ThisIsOutput_
	|
	|GROUP BY
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	PlannedOtherCosts.ExpenseItem,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.StandardCostEstimate,
	|	PlannedOtherCosts.ProductCostElement,
	|	PlannedOtherCosts.Department,
	|	Multipliers.LotProductBOM,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	CASE
	|		WHEN PlannedOtherCosts.ExpenseItem.ProductionCostType = VALUE(Enum.ProductionCostType.Constant)
	|			THEN ""OtherPermanent""
	|		ELSE ""OtherVariables""
	|	END,
	|	Multipliers.KeyLot
	|
	|UNION ALL
	|
	|SELECT
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	Multipliers.StandardCostEstimate,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	PlannedMaterialCosts.Department,
	|	PlannedMaterialCosts.ProductCostElement,
	|	PlannedMaterialCosts.Products,
	|	PlannedMaterialCosts.Characteristic,
	|	SUM(PlannedMaterialCosts.Count / Multipliers.Denominator * Multipliers.Numerator),
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN PlannedMaterialCosts.Cost
	|			WHEN &Cost_Data = 2
	|				THEN PlannedMaterialCosts.CostExcludingVAT
	|			ELSE PlannedMaterialCosts.LocalCost
	|		END / Multipliers.Denominator * Multipliers.Numerator),
	|	CASE
	|		WHEN PlannedMaterialCosts.Count < 0
	|			THEN ""RecyclableWaste""
	|		ELSE ""Material_""
	|	END,
	|	Multipliers.LotProductBOM,
	|	PlannedMaterialCosts.ThisIsASemiFinishedProduct,
	|	Multipliers.SemiFinishedProduct,
	|	Multipliers.ItemVariantsOfIntermediateProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	CASE
	|		WHEN &Cost_Data = 3
	|			THEN PlannedMaterialCosts.OffBalanceCostLocal
	|		ELSE PlannedMaterialCosts.OffBalanceCost
	|	END / Multipliers.Denominator * Multipliers.Numerator,
	|	Multipliers.KeyLot
	|FROM
	|	CommonMultipliers AS Multipliers
	|		INNER JOIN AccumulationRegister.PlannedMaterialCosts AS PlannedMaterialCosts
	|		ON Multipliers.StandardCostEstimate = PlannedMaterialCosts.StandardCostEstimate
	|			AND Multipliers.LotSemiFinishedProductBOM = PlannedMaterialCosts.LotBOM
	|			AND Multipliers.KeyLot = PlannedMaterialCosts.KeyLot
	|WHERE
	|	NOT Multipliers.LotIsReleased
	|	AND NOT Multipliers.ThisIsOutput_
	|
	|GROUP BY
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	PlannedMaterialCosts.Products,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.StandardCostEstimate,
	|	PlannedMaterialCosts.Characteristic,
	|	PlannedMaterialCosts.ProductCostElement,
	|	PlannedMaterialCosts.Department,
	|	CASE
	|		WHEN PlannedMaterialCosts.Count < 0
	|			THEN ""RecyclableWaste""
	|		ELSE ""Material_""
	|	END,
	|	Multipliers.LotProductBOM,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	PlannedMaterialCosts.ThisIsASemiFinishedProduct,
	|	Multipliers.SemiFinishedProduct,
	|	Multipliers.ItemVariantsOfIntermediateProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	CASE
	|		WHEN &Cost_Data = 3
	|			THEN PlannedMaterialCosts.OffBalanceCostLocal
	|		ELSE PlannedMaterialCosts.OffBalanceCost
	|	END / Multipliers.Denominator * Multipliers.Numerator,
	|	Multipliers.KeyLot
	|
	|UNION ALL
	|
	|SELECT
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	Multipliers.StandardCostEstimate,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	PlannedLaborCosts.Department,
	|	PlannedLaborCosts.ProductCostElement,
	|	PlannedLaborCosts.WorkKind,
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef),
	|	SUM(PlannedLaborCosts.Count / Multipliers.Denominator * Multipliers.Numerator),
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|					OR &Cost_Data = 2
	|				THEN PlannedLaborCosts.Cost
	|			ELSE PlannedLaborCosts.LocalCost
	|		END / Multipliers.Denominator * Multipliers.Numerator),
	|	""LaborCosts"",
	|	Multipliers.LotProductBOM,
	|	FALSE,
	|	Multipliers.SemiFinishedProduct,
	|	Multipliers.ItemVariantsOfIntermediateProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	0,
	|	Multipliers.KeyLot
	|FROM
	|	CommonMultipliers AS Multipliers
	|		INNER JOIN AccumulationRegister.PlannedLaborCosts AS PlannedLaborCosts
	|		ON Multipliers.StandardCostEstimate = PlannedLaborCosts.StandardCostEstimate
	|			AND Multipliers.LotSemiFinishedProductBOM = PlannedLaborCosts.LotBOM
	|			AND Multipliers.KeyLot = PlannedLaborCosts.KeyLot
	|WHERE
	|	NOT Multipliers.LotIsReleased
	|	AND NOT Multipliers.ThisIsOutput_
	|
	|GROUP BY
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	PlannedLaborCosts.WorkKind,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.StandardCostEstimate,
	|	PlannedLaborCosts.ProductCostElement,
	|	PlannedLaborCosts.Department,
	|	Multipliers.LotProductBOM,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	Multipliers.SemiFinishedProduct,
	|	Multipliers.ItemVariantsOfIntermediateProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	Multipliers.KeyLot
	|
	|UNION ALL
	|
	|SELECT
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	Multipliers.StandardCostEstimate,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	PlannedOtherCosts.Department,
	|	PlannedOtherCosts.ProductCostElement,
	|	PlannedOtherCosts.ExpenseItem,
	|	VALUE(Catalog.ItemsCharacteristics.EmptyRef),
	|	0,
	|	SUM(CASE
	|			WHEN &Cost_Data = 1
	|				THEN PlannedOtherCosts.Cost
	|			WHEN &Cost_Data = 2
	|				THEN PlannedOtherCosts.CostExcludingVAT
	|			ELSE PlannedOtherCosts.LocalCost
	|		END / Multipliers.Denominator * Multipliers.Numerator),
	|	CASE
	|		WHEN PlannedOtherCosts.ExpenseItem.ProductionCostType = VALUE(Enum.ProductionCostType.Constant)
	|			THEN ""OtherPermanent""
	|		ELSE ""OtherVariables""
	|	END,
	|	Multipliers.LotProductBOM,
	|	FALSE,
	|	Multipliers.SemiFinishedProduct,
	|	Multipliers.ItemVariantsOfIntermediateProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	0,
	|	Multipliers.KeyLot
	|FROM
	|	CommonMultipliers AS Multipliers
	|		INNER JOIN AccumulationRegister.PlannedOtherCosts AS PlannedOtherCosts
	|		ON Multipliers.StandardCostEstimate = PlannedOtherCosts.StandardCostEstimate
	|			AND Multipliers.LotSemiFinishedProductBOM = PlannedOtherCosts.LotBOM
	|			AND Multipliers.KeyLot = PlannedOtherCosts.KeyLot
	|WHERE
	|	NOT Multipliers.LotIsReleased
	|	AND NOT Multipliers.ThisIsOutput_
	|
	|GROUP BY
	|	Multipliers.ThisIsOutput_,
	|	Multipliers.CostObject,
	|	PlannedOtherCosts.ExpenseItem,
	|	Multipliers.ManufacturedProduct,
	|	Multipliers.ItemVariant,
	|	Multipliers.StandardCostEstimate,
	|	PlannedOtherCosts.ProductCostElement,
	|	PlannedOtherCosts.Department,
	|	Multipliers.LotProductBOM,
	|	Multipliers.QuantityOfSemiFinishedProduct,
	|	Multipliers.SemiFinishedProduct,
	|	Multipliers.ItemVariantsOfIntermediateProduct,
	|	Multipliers.Purpose,
	|	Multipliers.Order,
	|	CASE
