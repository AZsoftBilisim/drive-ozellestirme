	|	SUM(CASE
	|			WHEN &Cost_Data = 3
	|				THEN InventoryCost.OffBalanceCostLocal
	|			ELSE InventoryCost.OffBalanceCost
	|		END) AS OffBalanceCost
	|INTO TTCostOfGoods_
	|FROM
	|	CommonFactorsForPHSelectionInventoryCosts AS CommonMultipliers
	|		INNER JOIN AccumulationRegister.InventoryCost AS InventoryCost
	|		ON CommonMultipliers.LotSemiFinishedProductBOM = InventoryCost.CorLot
	|			AND CommonMultipliers.SemiFinishedProduct = InventoryCost.CorItemsLocationAttributes.Products
	|			AND CommonMultipliers.ItemVariantsOfIntermediateProduct = InventoryCost.CorItemsLocationAttributes.Characteristic
