	</calculatedField>
	<calculatedField>
		<dataPath>SolvedPercentageOfTotal</dataPath>
		<expression>Case When EvalExpression("Sum(Count)",,) = 0 Then 0 Else ItSDecided/EvalExpression("Sum(Count)",,)*100  End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Solved, % of the total quantity</v8:content>
			</v8:item>
			<v8:item>
