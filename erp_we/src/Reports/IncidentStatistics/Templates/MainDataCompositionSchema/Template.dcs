		<field xsi:type="DataSetFieldField">
			<dataPath>Duplicate1</dataPath>
			<field>Duplicate1</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Duplicate</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>تکراری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Doppione</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Dublikat</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дубль</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Yineleme</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Trùng lặp</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Incidents.Ref AS Ref,
	Incidents.Department AS Department,
	Incidents.Performer AS Performer,
	Incidents.IncidentKind AS IncidentKind,
	1 AS Count,
	CASE
		WHEN Incidents.Status = VALUE(Enum.IncidentStatuses.Registered)
			AND Incidents.Duplicate1 = VALUE(Catalog.Incidents.EmptyRef)
			THEN 1
		ELSE 0
	END AS IsRegistered,
	CASE
		WHEN Incidents.Status = VALUE(Enum.IncidentStatuses.Solved)
				OR Incidents.Status = VALUE(Enum.IncidentStatuses.Closed)
				AND Incidents.Duplicate1 = VALUE(Catalog.Incidents.EmptyRef)
			THEN 1
		ELSE 0
	END AS ItSDecided,
	CASE
		WHEN Incidents.Status = VALUE(Enum.IncidentStatuses.Outdated)
				AND Incidents.Duplicate1 = VALUE(Catalog.Incidents.EmptyRef)
			THEN 1
		ELSE 0
	END AS NotRelevant,
	CASE
		WHEN Incidents.Status = VALUE(Enum.IncidentStatuses.Solved)
				OR Incidents.Status = VALUE(Enum.IncidentStatuses.Closed)
					AND Incidents.RequiredClosingDate &lt;&gt; DATETIME(1, 1, 1, 0, 0, 0)
			THEN CASE
					WHEN Incidents.RequiredClosingDate &gt; Incidents.ClosingDate
						THEN 1
					ELSE 0
				END
		ELSE 0
	END AS NotOnTime,
	CASE
		WHEN Incidents.Duplicate1 &lt;&gt; VALUE(Catalog.Incidents.EmptyRef)
			THEN 1
		ELSE 0
	END AS Duplicate1
FROM
	Catalog.Incidents AS Incidents
WHERE
	Incidents.DeletionMark = FALSE
{WHERE
	(Incidents.RegistrationDate &gt;= &amp;StartDate),
	(Incidents.RegistrationDate &lt;= &amp;EndDate)}</query>
	</dataSet>
	<calculatedField>
		<dataPath>OnTime</dataPath>
		<expression>ItSDecided - NotOnTime</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>On time</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>به‌موقع</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
