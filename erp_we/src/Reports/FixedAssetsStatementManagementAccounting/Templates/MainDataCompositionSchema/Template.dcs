		<dataPath>MAIndicator</dataPath>
		<expression>Max(MAIndicator)</expression>
	</totalField>
	<totalField>
		<dataPath>NetBookValueOpeningBalance</dataPath>
		<expression>Sum(CostOpeningBalance) - Sum(DepreciationOpeningBalance) - Sum(ImpairmenManOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>NetBookValueClosingBalance</dataPath>
		<expression>Sum(CostClosingBalance) - Sum(DepreciationClosingBalance) -Sum(ImpairmenManClosingBalance)</expression>
	</totalField>
