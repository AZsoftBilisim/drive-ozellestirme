	</totalField>
	<totalField>
		<dataPath>NetBookValueOpeningBalance</dataPath>
		<expression>EvalExpression("Sum(CostOpeningBalance)",, "Overall")
+ IsNull(EvalExpression("Sum(CostReceipt)",,,"First", "Previous"), 0)
- IsNull(EvalExpression("Sum(CostExpense)",,,"First", "Previous"), 0)
-
 (EvalExpression("Sum(DepreciationOpeningBalance)",, "Overall")
	+ 	IsNull(EvalExpression("Sum(DepreciationExpense)",,,"First", "Previous"), 0)
	- 	IsNull(EvalExpression("Sum(DepreciationReceipt)",,,"First", "Previous"), 0)
)
-
 (EvalExpression("Sum(ImpairmenManOpeningBalance)",, "Overall")
	+ 	IsNull(EvalExpression("Sum(ImpairmenManExpense)",,,"First", "Previous"), 0)
	- 	IsNull(EvalExpression("Sum(ImpairmenManReceipt)",,,"First", "Previous"), 0)
)</expression>
		<group>Period</group>
		<group>Recorder</group>
		<group>MonthPeriod</group>
	</totalField>
	<totalField>
		<dataPath>NetBookValueClosingBalance</dataPath>
		<expression>EvalExpression("Sum(CostOpeningBalance)",, "Overall")
+ IsNull(EvalExpression("Sum(CostReceipt)",,,"First", "Current"), 0)
- IsNull(EvalExpression("Sum(CostExpense)",,,"First", "Current"), 0)
-
 (EvalExpression("Sum(DepreciationOpeningBalance)",, "Overall")
	+ IsNull(EvalExpression("Sum(DepreciationExpense)",,,"First", "Current"), 0)
	- IsNull(EvalExpression("Sum(DepreciationReceipt)",,,"First", "Current"), 0)
)
-
 (EvalExpression("Sum(ImpairmenManOpeningBalance)",, "Overall")
	+ IsNull(EvalExpression("Sum(ImpairmenManExpense)",,,"First", "Current"), 0)
	- IsNull(EvalExpression("Sum(ImpairmenManReceipt)",,,"First", "Current"), 0)
)</expression>
		<group>Period</group>
		<group>Recorder</group>
		<group>MonthPeriod</group>
	</totalField>
	<totalField>
		<dataPath>NetBookValueLocalOpeningBalance</dataPath>
		<expression>EvalExpression("Sum(LocalCostOpeningBalance)",, "Overall")
+ IsNull(EvalExpression("Sum(LocalCostReceipt)",,,"First", "Previous"), 0)
- IsNull(EvalExpression("Sum(LocalCostExpense)",,,"First", "Previous"), 0)
- 
(EvalExpression("Sum(DepreciationLocalOpeningBalance)",, "Overall")
    + IsNull(EvalExpression("Sum(DepreciationLocalExpense)",,,"First", "Previous"), 0)
    - IsNull(EvalExpression("Sum(DepreciationLocalReceipt)",,,"First", "Previous"), 0))
- 
(EvalExpression("Sum(ImpairmentLocalAssetsOpeningBalance)",, "Overall")
    + IsNull(EvalExpression("Sum(ImpairmentLocalAssetsExpense)",,,"First", "Previous"), 0)
    - IsNull(EvalExpression("Sum(ImpairmentLocalAssetsReceipt)",,,"First", "Previous"), 0))</expression>
		<group>Period</group>
		<group>Recorder</group>
		<group>MonthPeriod</group>
	</totalField>
	<totalField>
		<dataPath>NetBookValueLocalClosingBalance</dataPath>
		<expression>EvalExpression("Sum(LocalCostOpeningBalance)",, "Overall")
+ IsNull(EvalExpression("Sum(LocalCostReceipt)",,,"First", "Current"), 0)
- IsNull(EvalExpression("Sum(LocalCostExpense)",,,"First", "Current"), 0)
- 
(EvalExpression("Sum(DepreciationLocalOpeningBalance)",, "Overall")
    + IsNull(EvalExpression("Sum(DepreciationLocalExpense)",,,"First", "Current"), 0)
    - IsNull(EvalExpression("Sum(DepreciationLocalReceipt)",,,"First", "Current"), 0))
- 
(EvalExpression("Sum(ImpairmentLocalAssetsOpeningBalance)",, "Overall")
    + IsNull(EvalExpression("Sum(ImpairmentLocalAssetsExpense)",,,"First", "Current"), 0)
    - IsNull(EvalExpression("Sum(ImpairmentLocalAssetsReceipt)",,,"First", "Current"), 0))</expression>
		<group>Period</group>
		<group>Recorder</group>
		<group>MonthPeriod</group>
	</totalField>
	<totalField>
		<dataPath>NetBookValueLocalOpeningBalance</dataPath>
		<expression>EvalExpression("Sum(LocalCostOpeningBalance)",, "Overall")
- EvalExpression("Sum(DepreciationLocalOpeningBalance)",, "Overall")
- EvalExpression("Sum(ImpairmentLocalAssetsOpeningBalance)",, "Overall")</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>NetBookValueLocalClosingBalance</dataPath>
		<expression>EvalExpression("Sum(LocalCostClosingBalance)",, "Overall")
- EvalExpression("Sum(DepreciationLocalClosingBalance)",, "Overall")
- EvalExpression("Sum(ImpairmentLocalAssetsClosingBalance)",, "Overall")</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>NetBookValueOpeningBalance</dataPath>
		<expression>EvalExpression("Sum(CostOpeningBalance)",, "Overall")
- EvalExpression("Sum(DepreciationOpeningBalance)",, "Overall")
- EvalExpression("Sum(ImpairmenManOpeningBalance)",, "Overall")</expression>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>NetBookValueClosingBalance</dataPath>
		<expression>EvalExpression("Sum(CostClosingBalance)",, "Overall")
- EvalExpression("Sum(DepreciationClosingBalance)",, "Overall")
- EvalExpression("Sum(ImpairmenManClosingBalance)",, "Overall")</expression>
		<group>Overall</group>
	</totalField>
