		<field xsi:type="DataSetFieldField">
			<dataPath>Recorder</dataPath>
			<field>Recorder</field>
			<attributeUseRestriction>
				<condition>true</condition>
			</attributeUseRestriction>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
				<dcscom:ignoreNullValues>true</dcscom:ignoreNullValues>
			</role>
			<presentationExpression>Case
    When Recorder &lt;&gt; Undefined
        Then TMCommonUse.GetDocumentPresentation(Recorder, Recorder.Number, IsNull(Recorder.Date, SecondPeriod)) 
    Else "" 
End</presentationExpression>
