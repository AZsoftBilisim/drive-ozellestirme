	</totalField>
	<totalField>
		<dataPath>NetBookValueLocalClosingBalance</dataPath>
		<expression>Sum(LocalCostClosingBalance) - Sum(DepreciationLocalClosingBalance) -Sum(ImpairmentLocalAssetsClosingBalance)</expression>
	</totalField>
