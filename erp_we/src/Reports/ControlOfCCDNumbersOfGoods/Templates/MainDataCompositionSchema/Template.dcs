		<field xsi:type="DataSetFieldField">
			<dataPath>ProductAccountingAnalyticsStorageLocation</dataPath>
			<field>ProductAccountingAnalyticsStorageLocation</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	CompanyGoods.ItemsLocationAttributes.Products AS Products,
	CompanyGoods.ItemsLocationAttributes.Characteristic AS Characteristic,
	CompanyGoods.ItemsLocationAttributes,
	CompanyGoods.CCDNumber,
	CompanyGoods.CCDNumber.OriginCountry AS OriginCountry,
	CompanyGoods.InventoryOwnerAttribute,
	CompanyGoods.ItemsLocationAttributes.StorageLocation,
	CompanyGoods.Organization,
		
	CompanyGoods.CountOpeningBalance,
	CompanyGoods.CountTurnover,
	CompanyGoods.CountReceipt,
	CompanyGoods.CountExpense,
	CompanyGoods.CountClosingBalance,
		
	CompanyGoods.SecondPeriod,
	CompanyGoods.MinutePeriod,
	CompanyGoods.HourPeriod,
	CompanyGoods.DayPeriod,
	CompanyGoods.WeekPeriod,
	CompanyGoods.TenDaysPeriod,
	CompanyGoods.MonthPeriod,
	CompanyGoods.QuarterPeriod,
	CompanyGoods.YearPeriod,
	CASE WHEN CompanyGoods.Recorder = UNDEFINED THEN
		NULL
	ELSE
		CompanyGoods.Recorder
	END AS Recorder
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(, , Auto, , ) AS CompanyGoods
	
WHERE
CompanyGoods.ItemsLocationAttributes.Products.KeepRecordsByCCD
	OR CompanyGoods.CCDNumber &lt;&gt; VALUE(Catalog.CCDNumbers.EmptyRef)
</query>
	</dataSet>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Sum(CountClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Sum(CountOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>CountTurnover</dataPath>
		<expression>Sum(CountTurnover)</expression>
	</totalField>
	<totalField>
		<dataPath>CountReceipt</dataPath>
		<expression>Sum(CountReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>CountExpense</dataPath>
		<expression>Sum(CountExpense)</expression>
	</totalField>
