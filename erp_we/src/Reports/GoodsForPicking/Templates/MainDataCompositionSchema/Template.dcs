				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Mặt hàng trọng lượng</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>UnitForReports</dataPath>
			<field>UnitForReports</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Report unit</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>واحد گزارش</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Unità per i report</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Jednostka do sprawozdań</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Единица для отчетов</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Rapor ölçü birimi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Đơn vị tính cho báo cáo</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<attributeUseRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	GoodsForPicking.ReferenceOrder AS ReferenceOrder,
	GoodsForPicking.Products AS Products,
	GoodsForPicking.Characteristic AS Characteristic,
	GoodsForPicking.Purpose AS Purpose,
	GoodsForPicking.Series AS Series,
	GoodsForPicking.CargoItem AS CargoItem,
	GoodsForPicking.ForPickingOpeningBalance + GoodsForPicking.ForPickingReceipt AS ForPicking,
	GoodsForPicking.ForPickingClosingBalance - GoodsForPicking.BeingPickedClosingBalance - GoodsForPicking.PickedClosingBalance AS Pick,
	GoodsForPicking.BeingPickedClosingBalance AS BeingPicked,
	GoodsForPicking.PickedClosingBalance AS Picked,
	ISNULL(TransportationJob.Ref, UNDEFINED) AS TransportationJob
INTO GoodsForPicking
FROM
	AccumulationRegister.GoodsForPicking.BalanceAndTurnovers(, , Auto, , ) AS GoodsForPicking
		LEFT JOIN Document.TransportationJob AS TransportationJob
		ON GoodsForPicking.ReferenceOrder.TransportationJob = TransportationJob.Ref
			AND (TransportationJob.Posted)
			AND (TransportationJob.Status IN (VALUE(Enum.StatusesOfTransportationJobs.ToLoad), VALUE(Enum.StatusesOfTransportationJobs.Sent)))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	GoodsForPicking.ReferenceOrder AS ReferenceOrder,
	GoodsForPicking.Products AS Products,
	GoodsForPicking.Characteristic AS Characteristic,
	GoodsForPicking.Purpose AS Purpose,
	GoodsForPicking.Series AS Series,
	GoodsForPicking.ForPicking AS ForPicking,
	GoodsForPicking.Pick AS Pick,
	GoodsForPicking.BeingPicked AS BeingPicked,
	GoodsForPicking.Picked AS Picked,
	GoodsForPicking.TransportationJob AS TransportationJob
INTO ProductsToBeSelectedWithoutProductLocations
FROM
	GoodsForPicking AS GoodsForPicking
		LEFT JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
		ON (GoodsForPicking.Products = PackagesAndUnitsOfMeasure.Owner
				OR GoodsForPicking.Products.PackagingGroup = PackagesAndUnitsOfMeasure.Owner)
				AND (PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem))
WHERE
	GoodsForPicking.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	AND PackagesAndUnitsOfMeasure.Ref IS NULL 
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	InternalQuery.ReferenceOrder,
	InternalQuery.Products,
	InternalQuery.Characteristic,
	InternalQuery.Purpose,
	InternalQuery.Series,
	InternalQuery.CargoItem,
	InternalQuery.NumberOfPackages,
	SUM(InternalQuery.ForPicking) AS ForPicking,
	SUM(InternalQuery.Pick) AS Pick,
	SUM(InternalQuery.BeingPicked) AS BeingPicked,
	SUM(InternalQuery.Picked) AS Picked,
	InternalQuery.TransportationJob
INTO GoodsToBeSelectedAtCommodityPoints
FROM
	(SELECT
		GoodsForPicking.ReferenceOrder AS ReferenceOrder,
		GoodsForPicking.Products AS Products,
		GoodsForPicking.Characteristic AS Characteristic,
		GoodsForPicking.Purpose AS Purpose,
		GoodsForPicking.Series AS Series,
		PackagesAndUnitsOfMeasure.Ref AS CargoItem,
		PackagesAndUnitsOfMeasure.NumberOfPackages AS NumberOfPackages,
		GoodsForPicking.ForPicking * PackagesAndUnitsOfMeasure.NumberOfPackages AS ForPicking,
		GoodsForPicking.Pick * PackagesAndUnitsOfMeasure.NumberOfPackages AS Pick,
		GoodsForPicking.BeingPicked * PackagesAndUnitsOfMeasure.NumberOfPackages AS BeingPicked,
		GoodsForPicking.Picked * PackagesAndUnitsOfMeasure.NumberOfPackages AS Picked,
		GoodsForPicking.TransportationJob AS TransportationJob
	FROM
		GoodsForPicking AS GoodsForPicking
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
			ON GoodsForPicking.Products = PackagesAndUnitsOfMeasure.Owner
				AND (NOT PackagesAndUnitsOfMeasure.DeletionMark)
				AND (PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem))
	WHERE
		GoodsForPicking.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	
	UNION ALL
	
	SELECT
		GoodsForPicking.ReferenceOrder,
		GoodsForPicking.Products,
		GoodsForPicking.Characteristic,
		GoodsForPicking.Purpose,
		GoodsForPicking.Series,
		PackagesAndUnitsOfMeasure.Ref,
		PackagesAndUnitsOfMeasure.NumberOfPackages,
		GoodsForPicking.ForPicking * PackagesAndUnitsOfMeasure.NumberOfPackages,
		GoodsForPicking.Pick * PackagesAndUnitsOfMeasure.NumberOfPackages,
		GoodsForPicking.BeingPicked * PackagesAndUnitsOfMeasure.NumberOfPackages,
		GoodsForPicking.Picked * PackagesAndUnitsOfMeasure.NumberOfPackages,
		GoodsForPicking.TransportationJob
	FROM
		GoodsForPicking AS GoodsForPicking
			INNER JOIN Catalog.PackagesAndUnitsOfMeasure AS PackagesAndUnitsOfMeasure
			ON GoodsForPicking.Products.PackagingGroup = PackagesAndUnitsOfMeasure.Owner
				AND (NOT PackagesAndUnitsOfMeasure.DeletionMark)
				AND (PackagesAndUnitsOfMeasure.PackageType = VALUE(Enum.TypesOfItemsPackages.CargoItem))
	WHERE
		GoodsForPicking.CargoItem = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
	
	UNION ALL
	
	SELECT
		GoodsForPicking.ReferenceOrder,
		GoodsForPicking.Products,
		GoodsForPicking.Characteristic,
		GoodsForPicking.Purpose,
		GoodsForPicking.Series,
		GoodsForPicking.CargoItem,
		GoodsForPicking.CargoItem.NumberOfPackages,
		GoodsForPicking.ForPicking,
		GoodsForPicking.Pick,
		GoodsForPicking.BeingPicked,
		GoodsForPicking.Picked,
		GoodsForPicking.TransportationJob
	FROM
		GoodsForPicking AS GoodsForPicking
	WHERE
		GoodsForPicking.CargoItem &lt;&gt; VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)) AS InternalQuery

GROUP BY
	InternalQuery.ReferenceOrder,
	InternalQuery.Products,
	InternalQuery.Characteristic,
	InternalQuery.Purpose,
	InternalQuery.Series,
	InternalQuery.CargoItem,
	InternalQuery.NumberOfPackages,
	InternalQuery.TransportationJob
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	GoodsForPicking.ReferenceOrder,
	GoodsForPicking.Products,
	GoodsForPicking.Characteristic,
	GoodsForPicking.Purpose,
	GoodsForPicking.Series,
	MIN(CASE
			WHEN GoodsForPicking.ForPicking / GoodsForPicking.NumberOfPackages - (CAST(GoodsForPicking.ForPicking / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) &gt;= 0
				THEN CAST(GoodsForPicking.ForPicking / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))
			ELSE (CAST(GoodsForPicking.ForPicking / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) - 1
		END) AS ForPicking,
	MIN(CASE
			WHEN GoodsForPicking.Pick / GoodsForPicking.NumberOfPackages - (CAST(GoodsForPicking.Pick / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) &gt;= 0
				THEN CAST(GoodsForPicking.Pick / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))
			ELSE (CAST(GoodsForPicking.Pick / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) - 1
		END) AS Pick,
	MIN(CASE
			WHEN GoodsForPicking.BeingPicked / GoodsForPicking.NumberOfPackages - (CAST(GoodsForPicking.BeingPicked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) &gt;= 0
				THEN CAST(GoodsForPicking.BeingPicked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))
			ELSE (CAST(GoodsForPicking.BeingPicked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) - 1
		END) AS BeingPicked,
	MIN(CASE
			WHEN GoodsForPicking.Picked / GoodsForPicking.NumberOfPackages - (CAST(GoodsForPicking.Picked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) &gt;= 0
				THEN CAST(GoodsForPicking.Picked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))
			ELSE (CAST(GoodsForPicking.Picked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) - 1
		END) AS Picked,
	GoodsForPicking.TransportationJob
INTO GoodsForSelectionWholeSetsOfGoodsPlaces
FROM
	GoodsToBeSelectedAtCommodityPoints AS GoodsForPicking

GROUP BY
	GoodsForPicking.ReferenceOrder,
	GoodsForPicking.Products,
	GoodsForPicking.Characteristic,
	GoodsForPicking.Purpose,
	GoodsForPicking.Series,
	GoodsForPicking.TransportationJob

HAVING
	(MIN(CASE
				WHEN GoodsForPicking.ForPicking / GoodsForPicking.NumberOfPackages - (CAST(GoodsForPicking.ForPicking / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) &gt;= 0
					THEN CAST(GoodsForPicking.ForPicking / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))
				ELSE (CAST(GoodsForPicking.ForPicking / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) - 1
			END) &lt;&gt; 0
		OR MIN(CASE
				WHEN GoodsForPicking.Pick / GoodsForPicking.NumberOfPackages - (CAST(GoodsForPicking.Pick / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) &gt;= 0
					THEN CAST(GoodsForPicking.Pick / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))
				ELSE (CAST(GoodsForPicking.Pick / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) - 1
			END) &lt;&gt; 0
		OR MIN(CASE
				WHEN GoodsForPicking.BeingPicked / GoodsForPicking.NumberOfPackages - (CAST(GoodsForPicking.BeingPicked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) &gt;= 0
					THEN CAST(GoodsForPicking.BeingPicked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))
				ELSE (CAST(GoodsForPicking.BeingPicked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) - 1
			END) &lt;&gt; 0
		OR MIN(CASE
				WHEN GoodsForPicking.Picked / GoodsForPicking.NumberOfPackages - (CAST(GoodsForPicking.Picked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) &gt;= 0
					THEN CAST(GoodsForPicking.Picked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))
				ELSE (CAST(GoodsForPicking.Picked / GoodsForPicking.NumberOfPackages AS NUMBER(12, 0))) - 1
			END) &lt;&gt; 0)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	GoodsToBeSelectedAtCommodityPoints.ReferenceOrder,
	GoodsToBeSelectedAtCommodityPoints.Products,
	GoodsToBeSelectedAtCommodityPoints.Characteristic,
	GoodsToBeSelectedAtCommodityPoints.Purpose,
	GoodsToBeSelectedAtCommodityPoints.Series,
	GoodsToBeSelectedAtCommodityPoints.CargoItem,
	GoodsToBeSelectedAtCommodityPoints.ForPicking - ISNULL(GoodsForSelectionWholeSetsOfGoodsPlaces.ForPicking, 0) * GoodsToBeSelectedAtCommodityPoints.NumberOfPackages AS ForPicking,
	GoodsToBeSelectedAtCommodityPoints.Pick - ISNULL(GoodsForSelectionWholeSetsOfGoodsPlaces.Pick, 0) * GoodsToBeSelectedAtCommodityPoints.NumberOfPackages AS Pick,
	GoodsToBeSelectedAtCommodityPoints.BeingPicked - ISNULL(GoodsForSelectionWholeSetsOfGoodsPlaces.BeingPicked, 0) * GoodsToBeSelectedAtCommodityPoints.NumberOfPackages AS BeingPicked,
	GoodsToBeSelectedAtCommodityPoints.Picked - ISNULL(GoodsForSelectionWholeSetsOfGoodsPlaces.Picked, 0) * GoodsToBeSelectedAtCommodityPoints.NumberOfPackages AS Picked,
	GoodsToBeSelectedAtCommodityPoints.TransportationJob
INTO GoodsForSelectionUnselectedItems
FROM
	GoodsToBeSelectedAtCommodityPoints AS GoodsToBeSelectedAtCommodityPoints
		LEFT JOIN GoodsForSelectionWholeSetsOfGoodsPlaces AS GoodsForSelectionWholeSetsOfGoodsPlaces
		ON GoodsToBeSelectedAtCommodityPoints.ReferenceOrder = GoodsForSelectionWholeSetsOfGoodsPlaces.ReferenceOrder
			AND GoodsToBeSelectedAtCommodityPoints.Products = GoodsForSelectionWholeSetsOfGoodsPlaces.Products
			AND GoodsToBeSelectedAtCommodityPoints.Characteristic = GoodsForSelectionWholeSetsOfGoodsPlaces.Characteristic
			AND GoodsToBeSelectedAtCommodityPoints.Purpose = GoodsForSelectionWholeSetsOfGoodsPlaces.Purpose
			AND GoodsToBeSelectedAtCommodityPoints.Series = GoodsForSelectionWholeSetsOfGoodsPlaces.Series
			AND GoodsToBeSelectedAtCommodityPoints.TransportationJob = GoodsForSelectionWholeSetsOfGoodsPlaces.TransportationJob
WHERE
	(GoodsToBeSelectedAtCommodityPoints.ForPicking - ISNULL(GoodsForSelectionWholeSetsOfGoodsPlaces.ForPicking, 0) * GoodsToBeSelectedAtCommodityPoints.NumberOfPackages &lt;&gt; 0
			OR GoodsToBeSelectedAtCommodityPoints.Pick - ISNULL(GoodsForSelectionWholeSetsOfGoodsPlaces.Pick, 0) * GoodsToBeSelectedAtCommodityPoints.NumberOfPackages &lt;&gt; 0
			OR GoodsToBeSelectedAtCommodityPoints.BeingPicked - ISNULL(GoodsForSelectionWholeSetsOfGoodsPlaces.BeingPicked, 0) * GoodsToBeSelectedAtCommodityPoints.NumberOfPackages &lt;&gt; 0
			OR GoodsToBeSelectedAtCommodityPoints.Picked - ISNULL(GoodsForSelectionWholeSetsOfGoodsPlaces.Picked, 0) * GoodsToBeSelectedAtCommodityPoints.NumberOfPackages &lt;&gt; 0)
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	InternalQuery.ReferenceOrder,
	InternalQuery.Products,
	InternalQuery.StorageUnit,
	InternalQuery.UnitForReports,
	InternalQuery.UnitFactorForReports,
	InternalQuery.ProductsWeight,
	InternalQuery.ProductsVolume,
	InternalQuery.Characteristic,
	InternalQuery.Purpose,
	InternalQuery.Series,
	InternalQuery.ForPicking,
	InternalQuery.Pick,
	InternalQuery.BeingPicked,
	InternalQuery.Picked,
	InternalQuery.TransportationJob
FROM
	(SELECT
		GoodsForPicking.ReferenceOrder AS ReferenceOrder,
		GoodsForPicking.Products AS Products,
		GoodsForPicking.Products.UnitOfMeasure AS StorageUnit,
		GoodsForPicking.Products.UnitForReports AS UnitForReports,
		GoodsForPicking.Products.UnitFactorForReports AS UnitFactorForReports,
		&amp;QueryTextWeight AS ProductsWeight,
		&amp;QueryTextVolumeM3 AS ProductsVolume,
		GoodsForPicking.Characteristic AS Characteristic,
		GoodsForPicking.Purpose AS Purpose,
		GoodsForPicking.Series AS Series,
		GoodsForPicking.ForPicking AS ForPicking,
		GoodsForPicking.Pick AS Pick,
		GoodsForPicking.BeingPicked AS BeingPicked,
		GoodsForPicking.Picked AS Picked,
		GoodsForPicking.TransportationJob AS TransportationJob
	FROM
		ProductsToBeSelectedWithoutProductLocations AS GoodsForPicking
	
	UNION ALL
	
	SELECT
		GoodsForPicking.ReferenceOrder,
		GoodsForPicking.Products,
		GoodsForPicking.Products.UnitOfMeasure,
		GoodsForPicking.Products.UnitForReports,
		GoodsForPicking.Products.UnitFactorForReports,
		&amp;QueryTextWeight,
		&amp;QueryTextVolumeM3,
		GoodsForPicking.Characteristic,
		GoodsForPicking.Purpose,
		GoodsForPicking.Series,
		GoodsForPicking.ForPicking,
		GoodsForPicking.Pick,
		GoodsForPicking.BeingPicked,
		GoodsForPicking.Picked,
		GoodsForPicking.TransportationJob
	FROM
		GoodsForSelectionWholeSetsOfGoodsPlaces AS GoodsForPicking
	
	UNION ALL
	
	SELECT
		GoodsForSelectionUnselectedItems.ReferenceOrder,
		GoodsForSelectionUnselectedItems.Products,
		GoodsForSelectionUnselectedItems.CargoItem,
		GoodsForSelectionUnselectedItems.CargoItem,
		1,
		&amp;QueryTextCargoItemWeight,
		&amp;QueryTextCargoItemVolume,
		GoodsForSelectionUnselectedItems.Characteristic,
		GoodsForSelectionUnselectedItems.Purpose,
		GoodsForSelectionUnselectedItems.Series,
		GoodsForSelectionUnselectedItems.ForPicking,
		GoodsForSelectionUnselectedItems.Pick,
		GoodsForSelectionUnselectedItems.BeingPicked,
		GoodsForSelectionUnselectedItems.Picked,
		GoodsForSelectionUnselectedItems.TransportationJob
	FROM
		GoodsForSelectionUnselectedItems AS GoodsForSelectionUnselectedItems) AS InternalQuery</query>
	</dataSet>
	<calculatedField>
		<dataPath>ForPicking</dataPath>
		<expression>Case When &amp;QuantityUnits = 0 Then
    ForPicking
When &amp;QuantityUnits = 1 Then
    Case When UnitFactorForReports = 0 Then
        0
    Else
        ForPicking / UnitFactorForReports
    End
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
