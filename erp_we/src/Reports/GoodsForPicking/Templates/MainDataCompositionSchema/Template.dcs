	</totalField>
	<totalField>
		<dataPath>SelectedWeight</dataPath>
		<expression>Sum(SelectedWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>PickedVolume</dataPath>
		<expression>Sum(PickedVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>TakeAwayWeight</dataPath>
		<expression>Sum(TakeAwayWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>PickVolume</dataPath>
		<expression>Sum(PickVolume)</expression>
	</totalField>
