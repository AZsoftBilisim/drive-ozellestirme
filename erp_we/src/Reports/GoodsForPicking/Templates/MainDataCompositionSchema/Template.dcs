	<totalField>
		<dataPath>ForPicking</dataPath>
		<expression> Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ForPicking)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Pick</dataPath>
		<expression>  Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(Pick)
End</expression>
	</totalField>
	<totalField>
		<dataPath>BeingPicked</dataPath>
		<expression> Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(BeingPicked)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Picked</dataPath>
		<expression>  Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(Picked)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToWeightSelection</dataPath>
		<expression>Sum(ToWeightSelection)</expression>
	</totalField>
