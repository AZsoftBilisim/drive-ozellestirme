		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>BeingPicked</dataPath>
		<expression>Case When &amp;QuantityUnits = 0 Then
    BeingPicked
When &amp;QuantityUnits = 1 Then
    Case When UnitFactorForReports = 0 Then
        0
    Else
        BeingPicked / UnitFactorForReports
    End
End</expression>
		<title xsi:type="v8:LocalStringType">
