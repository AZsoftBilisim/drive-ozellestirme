			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.PartnersSegments</v8:Type>
			</valueType>
			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceParameters</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameters">
						<dcscor:item>
							<dcscor:choiceParameter>GenerationMethod</dcscor:choiceParameter>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.UpdateRegularly</dcscor:value>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.GenerateManually</dcscor:value>
						</dcscor:item>
					</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	1 AS NumberOfLostTransactions,
	SalesOpportunitiesToCustomer.Ref AS SalesOpportunity,
	SalesOpportunitiesToCustomer.ReasonForLosingSalesOpportunity,
	SalesOpportunitiesToCustomer.EmployeeResponsible,
	SalesOpportunitiesToCustomer.Partner,
	SalesOpportunitiesToCustomer.PotentialSaleAmount
FROM
	Catalog.SalesOpportunitiesToCustomer AS SalesOpportunitiesToCustomer
WHERE
	SalesOpportunitiesToCustomer.Status = VALUE(Enum.OpportunityStatuses.Lost)
{WHERE
	SalesOpportunitiesToCustomer.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)}</query>
	</dataSet>
	<totalField>
		<dataPath>PotentialSaleAmount</dataPath>
		<expression>Sum(PotentialSaleAmount)</expression>
		<group>EmployeeResponsible</group>
		<group>Partner</group>
		<group>ReasonForLosingSalesOpportunity</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>NumberOfLostTransactions</dataPath>
		<expression>Sum(NumberOfLostTransactions)</expression>
		<group>EmployeeResponsible</group>
		<group>Partner</group>
		<group>ReasonForLosingSalesOpportunity</group>
		<group>Overall</group>
	</totalField>
	<parameter>
		<name>FilterByPartnerSegmentIsUsed</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Filter by partner segment is used</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
