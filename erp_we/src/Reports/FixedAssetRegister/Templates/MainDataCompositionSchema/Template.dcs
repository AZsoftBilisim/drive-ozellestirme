		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	FALocation.FixedAsset AS FixedAsset,
	FALocation.Organization AS Organization,
	FALocation.FixedAssetsLocation AS Department,
	FALocation.FinanciallyLiablePerson AS FinanciallyLiablePerson,
	FALocation.LocationAddress AS LocationAddress
INTO FALocation
FROM
	InformationRegister.FALocation.SliceLast({(&amp;Period)}, CorrectionDate = DATETIME(1, 1, 1)) AS FALocation
{WHERE
	Organization.* AS Organization,
	FixedAssetsLocation.* AS Department,
	FinanciallyLiablePerson.* AS FinanciallyLiablePerson,
	FixedAsset.* AS FixedAsset}

INDEX BY
	FixedAsset,
	Organization
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	FALocation.FixedAsset AS FixedAsset,
	FALocation.Organization AS Organization,
	FALocation.Department AS Department,
	FALocation.FinanciallyLiablePerson AS FinanciallyLiablePerson,
	FALocation.LocationAddress AS LocationAddress,
	FixedAssetsAccountingProcedure.FinancialAccountingGroup AS FinancialAccountingGroup,
	FixedAssetsAccountingProcedure.RunningTimeValue AS RunningTimeValue,
	ISNULL(FixedAssetsAccountingProcedure.EstimatedRunningTime, 0) AS StandardRunningTime,
	ISNULL(FARunningTime.Value, 0) AS ActualRunningTime,
	ISNULL(FixedAssetDepreciationParametersManagementAccounting.UsefulLifeMonths, 0) AS UsefulLifeOfMa,
	ISNULL(FixedAssetDepreciationParametersManagementAccounting.UsefulLifeForCalculatingDepreciationMonth, 0) AS UsefulLifeForCalculatingMaDepreciation,
	OSBUDepreciationParameters.AccelerationFactor AS AccelerationFactorAccounting,
	OSBUDepreciationParameters.VolumeOfProductsWorksForCalculatingDepreciationInPhysicalUnits AS VolumeOfProductionWorksForCalculatingDepreciationOfBU,
	OSBUDepreciationParameters.UsefulLifeForCalculatingDepreciationMonth AS UsefulLifeForCalculatingDepreciationMonth,
	OSBUDepreciationParameters.UsefulLifeMonthsAC AS UsefulLifeMonthsAC,
	OSBUDepreciationParameters.LastChangeDate AS DateOfChangeOfParametersOfDepreciationOfBU,
	FixedAssetDepreciationParametersManagementAccounting.CostUsedToCalculateDepreciationManag AS CostUsedToCalculateDepreciationInManagementAccounting,
	FixedAssetDepreciationParametersManagementAccounting.CostUsedToCalculateDepreciationLocal AS CostToCalculateDepreciationMaLocal,
	FixedAssetDepreciationParametersManagementAccounting.AccelerationFactor AS AccelerationFactorManagementAccounting,
	FixedAssetDepreciationParametersManagementAccounting.DepreciationMethod AS DepreciationAccrualMethodManagementAccounting,
	FixedAssetDepreciationParametersManagementAccounting.ResidualValueMan AS ResidualValueMan,
	OSBUDepreciationParameters.ResidualValueMan AS ResidualValueLocal,
	FixedAssetDepreciationParametersManagementAccounting.LastChangeDate AS DateOfChangeInMaDepreciationParameters,
	FixedAssetDepreciationParametersManagementAccounting.VolumeOfProductsWorksForCalculatingDepreciationInPhysicalUnits AS ScopeOfProductionWorksToCalculateMaDepreciation,
	InitialFixedAssetsInformation.AccountingProcedureAC AS AccountingProcedureAC,
	InitialFixedAssetsInformation.AccountingProcedureMA AS AccountingProcedureMA,
	InitialFixedAssetsInformation.InitialCostLocalAccounting AS InitialCostLocalAccounting,
	InitialFixedAssetsInformation.InitialCostMA AS InitialCostMA,
	InitialFixedAssetsInformation.CommissioningDateAC AS CommissioningDateAC,
	InitialFixedAssetsInformation.CommissioningDateMA AS CommissioningDateMA,
	InitialFixedAssetsInformation.CommissioningDocumentAC AS CommissioningDocumentAC,
	InitialFixedAssetsInformation.CommissioningDocumentMA AS CommissioningDocumentMA,
	InitialFixedAssetsInformation.DeregistrationDocumentACC AS DeregistrationDocumentACC,
	InitialFixedAssetsInformation.DeregistrationDocumentMA AS DecommissioningDocument,
	InitialFixedAssetsInformation.DepreciationMethodAccounting AS DepreciationMethodAccounting,
	FixedAssetsAccountingProcedure.LineOfBusiness AS LineOfBusiness,
	AccountingProcedureForOSBU.DepreciationAccrualAccounting AS DepreciationAccrualAccounting,
	
	CASE
		WHEN NOT AccountingProcedureForOSBU.DepreciationRecordMethodLA IN (&amp;EmptyWaysToReflectDepreciation)
				AND DepreciationRecordMethodLA_2.Ref IS NULL
			THEN DepreciationRecordMethodLA_1.ExpenseItem
		ELSE AccountingProcedureForOSBU.ExpenseItemAccounting 
	END AS ExpenseItemAccounting,
	
	CASE
		WHEN NOT AccountingProcedureForOSBU.DepreciationRecordMethodLA IN (&amp;EmptyWaysToReflectDepreciation)
				AND DepreciationRecordMethodLA_2.Ref IS NULL
			THEN DepreciationRecordMethodLA_1.DimensionOfExpenses
		ELSE AccountingProcedureForOSBU.ExpensesDimensionAccounting
	END AS ExpensesDimensionAccounting,
	
	CASE
		WHEN NOT AccountingProcedureForOSBU.DepreciationRecordMethodLA IN (&amp;EmptyWaysToReflectDepreciation)
				AND DepreciationRecordMethodLA_2.Ref IS NULL
			THEN DepreciationRecordMethodLA_1.Department
		ELSE AccountingProcedureForOSBU.DepartmentACC
	END AS ACExpensesDivision,
	
	CASE
		WHEN NOT AccountingProcedureForOSBU.DepreciationRecordMethodLA IN (&amp;EmptyWaysToReflectDepreciation)
				AND DepreciationRecordMethodLA_2.Ref IS NULL
			THEN DepreciationRecordMethodLA_1.LineOfBusiness
		ELSE AccountingProcedureForOSBU.LineOfBusinessBookkeeping
	END AS LineOfBusinessOfExpensesAC,
		
	AccountingProcedureForOSBU.DepreciationRecordMethodLA AS DepreciationRecordMethodLA,
	AccountingProcedureForOSBU.TransferExpensesToAnotherCompany AS TransferExpensesToAnotherCompanyAC,
	AccountingProcedureForOSBU.CompanyRecipientOfExpenses AS CompanyRecipientOfExpensesAC,
	FixedAssetsAccountingProcedureManagementAccounting.AccrueDepreciationOrAmortization AS AccrueDepreciationOrAmortization,
	FixedAssetsAccountingProcedureManagementAccounting.DepreciationRecordMethod AS MethodOfReflectingDepreciationOfMA,
	
	CASE
		WHEN NOT FixedAssetsAccountingProcedureManagementAccounting.ExpensesPostingMethod IN (&amp;EmptyWaysToReflectDepreciation)
				AND MethodOfReflectingDepreciationOfMA_2.Ref IS NULL
			THEN MethodOfReflectingDepreciationOfMA_1.ExpenseItem
		ELSE FixedAssetsAccountingProcedureManagementAccounting.ExpenseItem
	END AS ExpenseItemManagementAccounting,
	
	CASE
		WHEN NOT FixedAssetsAccountingProcedureManagementAccounting.ExpensesPostingMethod IN (&amp;EmptyWaysToReflectDepreciation)
				AND MethodOfReflectingDepreciationOfMA_2.Ref IS NULL
			THEN MethodOfReflectingDepreciationOfMA_1.DimensionOfExpenses
		ELSE FixedAssetsAccountingProcedureManagementAccounting.DimensionOfExpenses
	END AS ExpensesDimensionManagementAccounting,
	
	CASE
		WHEN NOT FixedAssetsAccountingProcedureManagementAccounting.ExpensesPostingMethod IN (&amp;EmptyWaysToReflectDepreciation)
				AND MethodOfReflectingDepreciationOfMA_2.Ref IS NULL
			THEN MethodOfReflectingDepreciationOfMA_1.Department
		ELSE FixedAssetsAccountingProcedureManagementAccounting.Department
	END AS MAExpensesDivision,
	
	CASE
		WHEN NOT FixedAssetsAccountingProcedureManagementAccounting.ExpensesPostingMethod IN (&amp;EmptyWaysToReflectDepreciation)
				AND MethodOfReflectingDepreciationOfMA_2.Ref IS NULL
			THEN MethodOfReflectingDepreciationOfMA_1.LineOfBusiness
		ELSE FixedAssetsAccountingProcedureManagementAccounting.LineOfBusiness
	END AS LineOfBusinessOfExpensesMA,
		
	FixedAssetsAccountingProcedureManagementAccounting.TransferExpensesToAnotherCompany AS TransferExpensesToAnotherMaOrganization,
	FixedAssetsAccountingProcedureManagementAccounting.CompanyRecipientOfExpenses AS OrganizationRecipientOfMaExpenses,
	LeasedAsset.Contract AS Contract
FROM
	FALocation AS FALocation
		
		LEFT JOIN InformationRegister.FixedAssetsAccountingProcedure.SliceLast({(&amp;Period)}, CorrectionDate = DATETIME(1,1,1)) AS FixedAssetsAccountingProcedure
		ON (FixedAssetsAccountingProcedure.FixedAsset = FALocation.FixedAsset)
		
		LEFT JOIN InformationRegister.AssetActivityRecords.SliceLast({(&amp;Period)}) AS FARunningTime
		ON (FARunningTime.Asset = FixedAssetsAccountingProcedure.FixedAsset)
			AND (FARunningTime.RunningTimeValue = FixedAssetsAccountingProcedure.RunningTimeValue)
	
		LEFT JOIN InformationRegister.OSBUDepreciationParameters.SliceLast({(&amp;Period)}, CorrectionDate = DATETIME(1,1,1)) AS OSBUDepreciationParameters
		ON (OSBUDepreciationParameters.Organization = FALocation.Organization)
			AND (OSBUDepreciationParameters.FixedAsset = FALocation.FixedAsset)
		
		LEFT JOIN InformationRegister.FixedAssetDepreciationParametersManagementAccounting.SliceLast({(&amp;Period)}, CorrectionDate = DATETIME(1,1,1)) AS FixedAssetDepreciationParametersManagementAccounting
		ON (FixedAssetDepreciationParametersManagementAccounting.Organization = FALocation.Organization)
			AND (FixedAssetDepreciationParametersManagementAccounting.FixedAsset = FALocation.FixedAsset)
		
		LEFT JOIN InformationRegister.InitialFixedAssetsInformation.SliceLast({(&amp;Period)}, CorrectionDate = DATETIME(1,1,1)) AS InitialFixedAssetsInformation
		ON (InitialFixedAssetsInformation.Organization = FALocation.Organization)
			AND (InitialFixedAssetsInformation.FixedAsset = FALocation.FixedAsset)
	
		LEFT JOIN InformationRegister.AccountingProcedureForOSBU.SliceLast({(&amp;Period)}, CorrectionDate = DATETIME(1,1,1)) AS AccountingProcedureForOSBU
		ON (AccountingProcedureForOSBU.Organization = FALocation.Organization)
			AND (AccountingProcedureForOSBU.FixedAsset = FALocation.FixedAsset)
		
		LEFT JOIN InformationRegister.FixedAssetsAccountingProcedureManagementAccounting.SliceLast({(&amp;Period)}, CorrectionDate = DATETIME(1,1,1)) AS FixedAssetsAccountingProcedureManagementAccounting
		ON (FixedAssetsAccountingProcedureManagementAccounting.Organization = FALocation.Organization)
			AND (FixedAssetsAccountingProcedureManagementAccounting.FixedAsset = FALocation.FixedAsset)
		
		LEFT JOIN InformationRegister.LeasedAsset.SliceLast({(&amp;Period)}) AS LeasedAsset
		ON (LeasedAsset.FixedAsset = FALocation.FixedAsset)
	
		LEFT JOIN Document.ChangeFixedAssetFinancialDetails2_4.Depreciation AS MethodOfReflectingDepreciationOfMA_1
		ON (MethodOfReflectingDepreciationOfMA_1.Ref = FixedAssetsAccountingProcedureManagementAccounting.DepreciationRecordMethod)
			AND (MethodOfReflectingDepreciationOfMA_1.LineNumber = 1)
	
		LEFT JOIN Document.ChangeFixedAssetFinancialDetails2_4.Depreciation AS MethodOfReflectingDepreciationOfMA_2
		ON (MethodOfReflectingDepreciationOfMA_2.Ref = FixedAssetsAccountingProcedureManagementAccounting.DepreciationRecordMethod)
			AND (MethodOfReflectingDepreciationOfMA_2.LineNumber = 2)
	
		LEFT JOIN Document.ChangeFixedAssetFinancialDetails2_4.Depreciation AS DepreciationRecordMethodLA_1
		ON (DepreciationRecordMethodLA_1.Ref = AccountingProcedureForOSBU.DepreciationRecordMethodLA)
			AND (DepreciationRecordMethodLA_1.LineNumber = 1)
	
		LEFT JOIN Document.ChangeFixedAssetFinancialDetails2_4.Depreciation AS DepreciationRecordMethodLA_2
		ON (DepreciationRecordMethodLA_2.Ref = AccountingProcedureForOSBU.DepreciationRecordMethodLA)
			AND (DepreciationRecordMethodLA_2.LineNumber = 2)
	
WHERE
	FixedAssetsAccountingProcedureManagementAccounting.State IN(&amp;RecognizedState)</query>
	</dataSet>
