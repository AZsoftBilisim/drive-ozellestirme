		<expression>Sum(VATManagClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountExcludingVATOpeningBalance</dataPath>
		<expression>Sum(AmountExcludingVATOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountExcludingVATReceipt</dataPath>
		<expression>Sum(AmountExcludingVATReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountExcludingVATExpense</dataPath>
		<expression>Sum(AmountExcludingVATExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountExcludingVATClosingBalance</dataPath>
		<expression>Sum(AmountExcludingVATClosingBalance)</expression>
	</totalField>
