						</v8:item>
						<v8:item>
							<v8:lang>fa</v8:lang>
							<v8:content>انتخاب مغایرت‌های خط کسب‌وکار بر اساس قرارداد و VAT محاسبه‌شده</v8:content>
						</v8:item>
						<v8:item>
							<v8:lang>it</v8:lang>
