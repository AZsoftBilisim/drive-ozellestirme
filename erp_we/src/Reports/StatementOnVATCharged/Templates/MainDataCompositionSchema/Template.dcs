		<field xsi:type="DataSetFieldField">
			<dataPath>Department</dataPath>
			<field>Department</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	VATInvoiced.TaxInvoice AS TaxInvoice,
	VATInvoiced.Vendor AS Vendor,
	VATInvoiced.AssetTaxClass AS AssetTaxClass,
	VATInvoiced.VATRate AS VATRate,
	VATInvoiced.VATActivityType AS VATActivityType,
	VATInvoiced.CorrectedTaxInvoice AS CorrectedTaxInvoice,
	VATInvoiced.SaleExport AS SaleExport,
	VATInvoiced.LineOfBusiness AS LinesOfBusinessVATPresented,
	
	ISNULL(CAST(DocumentsRegistry.Contract AS Catalog.CounterpartyContracts).LineOfBusiness,
			 VALUE(Catalog.LinesOfBusiness.EmptyRef)) AS DirectionOfContract,
			 
	VATInvoiced.AmountExcludingVATOpeningBalance AS AmountExcludingVATOpeningBalance,
	VATInvoiced.AmountExcludingVATReceipt AS AmountExcludingVATReceipt,
	VATInvoiced.AmountExcludingVATExpense AS AmountExcludingVATExpense,
	VATInvoiced.AmountExcludingVATClosingBalance AS AmountExcludingVATClosingBalance,
	VATInvoiced.VATOpeningBalance AS VATOpeningBalance,
	VATInvoiced.VATReceipt AS VATReceipt,
	VATInvoiced.VATExpense AS VATExpense,
	VATInvoiced.VATClosingBalance AS VATClosingBalance,
	VATInvoiced.VATManagOpeningBalance AS VATManagOpeningBalance,
	VATInvoiced.VATManagReceipt AS VATManagReceipt,
	VATInvoiced.VATManagExpense AS VATManagExpense,
	VATInvoiced.VATManagClosingBalance AS VATManagClosingBalance,
	
	ISNULL(
		CASE
			WHEN NOT VATInvoiced.LineOfBusiness.StateContractAndSDOContractFulfillment
				THEN 
					TRUE
 		END, TRUE) AS LinesOfBusinessMatch,
 		
	DocumentsRegistry.Department AS Department
FROM
	AccumulationRegister.VATInvoiced.BalanceAndTurnovers({(&amp;BeginOfPeriod)}, {(&amp;EndOfPeriod)}, Period, RegisterRecordsAndPeriodBoundaries, Organization = &amp;Organization {(Organization)}) AS
		VATInvoiced
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON VATInvoiced.TaxInvoice = DocumentsRegistry.Ref
		AND VATInvoiced.Organization = DocumentsRegistry.Organization
		AND (NOT DocumentsRegistry.AdditionalRecord)</query>
	</dataSet>
	<totalField>
		<dataPath>VATOpeningBalance</dataPath>
		<expression>Sum(VATOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>VATReceipt</dataPath>
		<expression>Sum(VATReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>VATExpense</dataPath>
		<expression>Sum(VATExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>VATClosingBalance</dataPath>
		<expression>Sum(VATClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>VATManagOpeningBalance</dataPath>
		<expression>Sum(VATManagOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>VATManagReceipt</dataPath>
		<expression>Sum(VATManagReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>VATManagExpense</dataPath>
		<expression>Sum(VATManagExpense)</expression>
	</totalField>
	<totalField>
