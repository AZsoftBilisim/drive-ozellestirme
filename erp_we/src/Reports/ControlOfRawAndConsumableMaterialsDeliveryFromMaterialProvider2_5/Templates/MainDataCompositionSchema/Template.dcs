			</role>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Orders.YearPeriod                     AS YearPeriod,
	Orders.HalfYearPeriod               AS HalfYearPeriod,
	Orders.QuarterPeriod                 AS QuarterPeriod,
	Orders.MonthPeriod                   AS MonthPeriod,
	Orders.TenDaysPeriod                  AS TenDaysPeriod,
	Orders.WeekPeriod                  AS WeekPeriod,
	Orders.DayPeriod                    AS DayPeriod,
	Orders.HourPeriod                     AS HourPeriod,
	Orders.MinutePeriod                  AS MinutePeriod,
	Orders.SecondPeriod                 AS SecondPeriod,
	CASE
		WHEN Orders.Recorder = UNDEFINED
			THEN NULL
		ELSE Orders.Recorder
	END                                AS Recorder,
	
	DocumentsRegistry.Organization         AS Organization,
	DocumentsRegistry.Partner             AS MaterialProvider,
	DocumentsRegistry.Contract             AS Contract,
	Orders.PurchaseOrder               AS PurchaseOrder,
	DocumentsRegistry.IBDocumentDate     AS IBDocumentDate,
	DocumentsRegistry.IBDocumentNumber    AS IBDocumentNumber,
	Orders.Products                  AS Products,
	Orders.Products.UnitOfMeasure AS UnitOfMeasure,
	Orders.Characteristic                AS Characteristic,
	Orders.Warehouse                         AS Warehouse,
	Orders.RowCode                     AS RowCode,
	Orders.RowCode = 0                 AS ExceedingOrder,
	
	Orders.ToRegisterOpeningBalance   AS ToRegisterOpeningBalance,
	Orders.ToRegisterReceipt             AS ToRegisterReceipt,
	Orders.ToRegisterExpense             AS ToRegisterExpense,
	Orders.ToRegisterClosingBalance    AS ToRegisterClosingBalance
	
INTO RegisterData
FROM
	AccumulationRegister.PurchaseOrders.BalanceAndTurnovers(
		{(&amp;StartDate)},
		{(&amp;EndDate)},
		Auto,,
		VALUETYPE(PurchaseOrder) = TYPE(Document.MaterialProviderOrder2_5)
		{PurchaseOrder.* AS PurchaseOrder,
		Products.*     AS Products,
		Characteristic.*   AS Characteristic,
		RowCode          AS RowCode,
		(RowCode = 0)    AS ExceedingOrder,
		Warehouse.*            AS Warehouse}
	) AS Orders
	
		LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON DocumentsRegistry.Ref = Orders.PurchaseOrder
		 AND NOT DocumentsRegistry.AdditionalRecord
{WHERE
	Orders.Recorder.*           AS Recorder,
	DocumentsRegistry.Organization.* AS Organization,
	DocumentsRegistry.Partner.*     AS MaterialProvider,
	DocumentsRegistry.Contract.*     AS Contract}
	
INDEX BY
	PurchaseOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterData.PurchaseOrder        AS PurchaseOrder,
	RegisterData.RowCode              AS RowCode,
	MAX(TSUsedMaterials.DateOfReceipt) AS DateOfReceiptPlan
INTO DeliveryTerm
FROM
	RegisterData AS RegisterData

		LEFT JOIN Document.MaterialProviderOrder2_5.UsedMaterials AS TSUsedMaterials
		ON RegisterData.PurchaseOrder = TSUsedMaterials.Ref
		 AND RegisterData.RowCode       = TSUsedMaterials.RowCode
WHERE
	NOT TSUsedMaterials.Canceled

GROUP BY
	RegisterData.PurchaseOrder,
	RegisterData.RowCode

INDEX BY
	PurchaseOrder,
	RowCode
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	RegisterData.YearPeriod                     AS YearPeriod,
	RegisterData.HalfYearPeriod               AS HalfYearPeriod,
	RegisterData.QuarterPeriod                 AS QuarterPeriod,
	RegisterData.MonthPeriod                   AS MonthPeriod,
	RegisterData.TenDaysPeriod                  AS TenDaysPeriod,
	RegisterData.WeekPeriod                  AS WeekPeriod,
	RegisterData.DayPeriod                    AS DayPeriod,
	RegisterData.HourPeriod                     AS HourPeriod,
	RegisterData.MinutePeriod                  AS MinutePeriod,
	RegisterData.SecondPeriod                 AS SecondPeriod,
	RegisterData.Recorder                   AS Recorder,
	
	RegisterData.Organization                   AS Organization,
	RegisterData.MaterialProvider                       AS MaterialProvider,
	RegisterData.Contract                       AS Contract,
	RegisterData.PurchaseOrder               AS PurchaseOrder,
	RegisterData.IBDocumentDate               AS IBDocumentDate,
	RegisterData.IBDocumentNumber              AS IBDocumentNumber,
	RegisterData.Products                  AS Products,
	RegisterData.Products.UnitOfMeasure AS UnitOfMeasure,
	RegisterData.Characteristic                AS Characteristic,
	RegisterData.RowCode                     AS RowCode,
	DeliveryTerm.DateOfReceiptPlan            AS DateOfReceiptPlan,
	RegisterData.Warehouse                         AS Warehouse,
	RegisterData.ExceedingOrder                   AS ExceedingOrder,
	
	RegisterData.ToRegisterOpeningBalance   AS ToRegisterOpeningBalance,
	RegisterData.ToRegisterReceipt             AS ToRegisterReceipt,
	RegisterData.ToRegisterExpense             AS ToRegisterExpense,
	RegisterData.ToRegisterClosingBalance    AS ToRegisterClosingBalance
FROM
	RegisterData AS RegisterData
	
		LEFT JOIN DeliveryTerm AS DeliveryTerm
		ON RegisterData.PurchaseOrder = DeliveryTerm.PurchaseOrder
		 AND RegisterData.RowCode = DeliveryTerm.RowCode
	</query>
	</dataSet>
	<calculatedField>
		<dataPath>ReceivedLate</dataPath>
		<expression>Case
		When Not RowCode = 0 And DayPeriod &gt; DateOfReceiptPlan
			Then ToRegisterExpense
		Else 0
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Delivered out-of-time</v8:content>
