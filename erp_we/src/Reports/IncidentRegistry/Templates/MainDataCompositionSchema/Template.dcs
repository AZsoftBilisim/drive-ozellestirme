		<field xsi:type="DataSetFieldField">
			<dataPath>Author</dataPath>
			<field>Author</field>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	Incidents.Ref AS Ref,
	Incidents.Department AS Department,
	Incidents.Performer AS Performer,
	Incidents.IncidentKind AS IncidentKind,
	Incidents.Severity AS Severity,
	Incidents.Status AS Status,
	Incidents.Author AS Author,
	CASE
		WHEN Incidents.Duplicate1 &lt;&gt; VALUE(Catalog.Incidents.EmptyRef)
			THEN TRUE
		ELSE FALSE
	END AS Duplicate1,
	Incidents.RequiredClosingDate AS RequiredClosingDate,
	Incidents.ClosingDate AS ClosingDate,
	1 AS Count,
	CASE
		WHEN Incidents.RequiredClosingDate = DATETIME(1, 1, 1, 0, 0, 0)
			THEN FALSE
		ELSE CASE
				WHEN Incidents.ClosingDate = DATETIME(1, 1, 1, 0, 0, 0)
					THEN CASE
							WHEN DATEDIFF(BEGINOFPERIOD(Incidents.RequiredClosingDate, DAY), BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY) &gt; 0
								THEN TRUE
							ELSE FALSE
						END
				ELSE CASE
						WHEN DATEDIFF(Incidents.RequiredClosingDate, Incidents.ClosingDate, DAY) &gt; 0
							THEN TRUE
						ELSE FALSE
					END
			END
	END AS Overdue,
	CASE
		WHEN Incidents.RequiredClosingDate = DATETIME(1, 1, 1, 0, 0, 0)
			THEN 0
		ELSE CASE
				WHEN Incidents.ClosingDate = DATETIME(1, 1, 1, 0, 0, 0)
					THEN CASE
							WHEN BEGINOFPERIOD(Incidents.RequiredClosingDate, DAY) &lt; BEGINOFPERIOD(&amp;CurrentDate, DAY)
								THEN DATEDIFF(BEGINOFPERIOD(Incidents.RequiredClosingDate, DAY), BEGINOFPERIOD(&amp;CurrentDate, DAY), DAY)
							ELSE 0
						END
				ELSE CASE
						WHEN Incidents.RequiredClosingDate &lt; Incidents.ClosingDate
							THEN DATEDIFF(Incidents.RequiredClosingDate, Incidents.ClosingDate, DAY)
						ELSE 0
					END
			END
	END AS OverdueDays
FROM
	Catalog.Incidents AS Incidents
WHERE
	Incidents.DeletionMark = FALSE
{WHERE
	(Incidents.RegistrationDate &gt;= &amp;StartDate),
	(Incidents.RegistrationDate &lt;= &amp;EndDate)}</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
