				<field xsi:type="DataSetFieldField">
					<dataPath>Organization</dataPath>
					<field>Organization</field>
				</field>
				<dataSource>DataSource1</dataSource>
				<query>// !!! TAGS ARE USED !!!

SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN InventoryConsumptionPlansTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN InventoryConsumptionPlansTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN InventoryConsumptionPlansTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN InventoryConsumptionPlansTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN InventoryConsumptionPlansTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN InventoryConsumptionPlansTurnovers.YearPeriod
		ELSE InventoryConsumptionPlansTurnovers.DayPeriod
	END AS DynamicPeriod,
	InventoryConsumptionPlansTurnovers.Department AS Department,
	InventoryConsumptionPlansTurnovers.Products AS Products,
	InventoryConsumptionPlansTurnovers.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN InventoryConsumptionPlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	InventoryConsumptionPlansTurnovers.Recorder AS Recorder,
	SUM(InventoryConsumptionPlansTurnovers.CountTurnover) AS Count
INTO InventoryConsumptionPlan
{SELECT
	Department.*}
FROM
	AccumulationRegister.InventoryConsumptionPlans.Turnovers(
		,
		,
		Auto,
		Scenario = &amp;Scenario
		{(Department),
		((Products, Characteristic) IN
			(SELECT
					SelectionByProductSegment.Products,
					SelectionByProductSegment.Characteristic
				FROM
					SelectionByProductSegment AS SelectionByProductSegment
				WHERE
					SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))
		}) AS InventoryConsumptionPlansTurnovers

GROUP BY
	InventoryConsumptionPlansTurnovers.Products,
	InventoryConsumptionPlansTurnovers.Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN InventoryConsumptionPlansTurnovers.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	InventoryConsumptionPlansTurnovers.Department,
	InventoryConsumptionPlansTurnovers.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN InventoryConsumptionPlansTurnovers.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN InventoryConsumptionPlansTurnovers.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN InventoryConsumptionPlansTurnovers.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN InventoryConsumptionPlansTurnovers.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN InventoryConsumptionPlansTurnovers.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN InventoryConsumptionPlansTurnovers.YearPeriod
		ELSE InventoryConsumptionPlansTurnovers.DayPeriod
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN GoodsInWarehousesTurnover.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN GoodsInWarehousesTurnover.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN GoodsInWarehousesTurnover.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN GoodsInWarehousesTurnover.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN GoodsInWarehousesTurnover.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN GoodsInWarehousesTurnover.YearPeriod
		ELSE GoodsInWarehousesTurnover.DayPeriod
	END AS DynamicPeriod,
	CASE
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
			THEN ISNULL(GoodsInWarehousesTurnover.Recorder.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
			THEN ISNULL(CAST(CAST(GoodsInWarehousesTurnover.Recorder AS Document.GoodsIssueNote).Recipient AS Catalog.BusinessStructure), VALUE(Catalog.BusinessStructure.EmptyRef))


		WHEN TRUE
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END AS Department,
	GoodsInWarehousesTurnover.Products AS Products,
	GoodsInWarehousesTurnover.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN GoodsInWarehousesTurnover.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	GoodsInWarehousesTurnover.Recorder AS Recorder,
	SUM(GoodsInWarehousesTurnover.InStockTurnover) AS FactQuantity
INTO DomesticConsumption
FROM
	AccumulationRegister.ProductStock.Turnovers(
		,
		,
		Auto,
		{(CASE
			WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
				THEN (Products, Characteristic) IN
					(SELECT DISTINCT
						InventoryConsumptionPlan.Products,
						InventoryConsumptionPlan.Characteristic
					FROM
						InventoryConsumptionPlan AS InventoryConsumptionPlan)
			ELSE TRUE
		END)}) AS GoodsInWarehousesTurnover
WHERE
	GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
	OR GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
	AND GoodsInWarehousesTurnover.Recorder.WarehouseOperation = VALUE(Enum.WarehouseTransactions.ShipmentForInternalNeeds)



GROUP BY
	CASE
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.InventoryConsumption
			THEN ISNULL(GoodsInWarehousesTurnover.Recorder.Department, VALUE(Catalog.BusinessStructure.EmptyRef))
		WHEN GoodsInWarehousesTurnover.Recorder REFS Document.GoodsIssueNote
			THEN ISNULL(CAST(CAST(GoodsInWarehousesTurnover.Recorder AS Document.GoodsIssueNote).Recipient AS Catalog.BusinessStructure), VALUE(Catalog.BusinessStructure.EmptyRef))


		WHEN TRUE
			THEN VALUE(Catalog.BusinessStructure.EmptyRef)
	END,
	GoodsInWarehousesTurnover.Characteristic,
	GoodsInWarehousesTurnover.Products,
	CASE
		WHEN &amp;SpecifyTargets
			THEN GoodsInWarehousesTurnover.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	GoodsInWarehousesTurnover.Recorder,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN GoodsInWarehousesTurnover.WeekPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN GoodsInWarehousesTurnover.TenDaysPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN GoodsInWarehousesTurnover.MonthPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN GoodsInWarehousesTurnover.QuarterPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN GoodsInWarehousesTurnover.HalfYearPeriod
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN GoodsInWarehousesTurnover.YearPeriod
		ELSE GoodsInWarehousesTurnover.DayPeriod
	END

UNION ALL

SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN MaterialsAndWorksInProductionTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN MaterialsAndWorksInProductionTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN MaterialsAndWorksInProductionTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN MaterialsAndWorksInProductionTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN MaterialsAndWorksInProductionTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN MaterialsAndWorksInProductionTurnovers.YearPeriod
		ELSE MaterialsAndWorksInProductionTurnovers.DayPeriod
	END,
	ISNULL(MaterialsAndWorksInProductionTurnovers.Department, VALUE(Catalog.BusinessStructure.EmptyRef)),
	MaterialsAndWorksInProductionTurnovers.Products,
	MaterialsAndWorksInProductionTurnovers.Characteristic,
	MaterialsAndWorksInProductionTurnovers.Purpose,
	MaterialsAndWorksInProductionTurnovers.Recorder,
	SUM(MaterialsAndWorksInProductionTurnovers.CountTurnover)
FROM
	AccumulationRegister.MaterialsAndWorksInProduction.Turnovers(, , Auto, {(CASE
			WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
				THEN (Products, Characteristic) IN
					(SELECT DISTINCT
						InventoryConsumptionPlan.Products,
						InventoryConsumptionPlan.Characteristic
					FROM
						InventoryConsumptionPlan AS InventoryConsumptionPlan)
			ELSE TRUE
		END)}) AS MaterialsAndWorksInProductionTurnovers
WHERE
	MaterialsAndWorksInProductionTurnovers.Recorder REFS Document.InventoryConsumption


	AND MaterialsAndWorksInProductionTurnovers.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
GROUP BY
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN MaterialsAndWorksInProductionTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN MaterialsAndWorksInProductionTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN MaterialsAndWorksInProductionTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN MaterialsAndWorksInProductionTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN MaterialsAndWorksInProductionTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN MaterialsAndWorksInProductionTurnovers.YearPeriod
		ELSE MaterialsAndWorksInProductionTurnovers.DayPeriod
	END,
	ISNULL(MaterialsAndWorksInProductionTurnovers.Department, VALUE(Catalog.BusinessStructure.EmptyRef)),
	MaterialsAndWorksInProductionTurnovers.Products,
	MaterialsAndWorksInProductionTurnovers.Characteristic,
	MaterialsAndWorksInProductionTurnovers.Purpose,
	MaterialsAndWorksInProductionTurnovers.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	Table.Products AS Products,
	Table.Characteristic AS Characteristic
INTO TTPlanProducts
FROM
	InventoryConsumptionPlan AS Table

INDEX BY
	Products,
	Characteristic
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, YEAR)
		ELSE BEGINOFPERIOD(Orders.DateOfShipment, DAY)
	END AS DynamicPeriod,
	OrderDetails.Department AS Department,
	Orders.Products AS Products,
	Orders.Characteristic AS Characteristic,
	CASE
		WHEN &amp;SpecifyTargets
			THEN CASE
					WHEN Orders.WithAssignment
						THEN OrderDetails.Purpose
					ELSE VALUE(Catalog.Assignments.EmptyRef)
				END
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END AS Purpose,
	OrderDetails.Ref AS Recorder,
	SUM(CASE
			WHEN Orders.WithAssignment
				THEN ISNULL(OrdersToBeRegistered.ToRegisterBalance, 0)
			ELSE Orders.Count
		END) AS OrderedQuantity
INTO Orders
FROM
	Document.InventoryConsumptionOrder.Goods AS Orders
		
		INNER JOIN Document.InventoryConsumptionOrder AS OrderDetails
		ON Orders.Ref = OrderDetails.Ref
		
		LEFT JOIN AccumulationRegister.InventoryConsumptionOrders.Balance(
			,
			InventoryConsumptionOrder REFS Document.InventoryConsumptionOrder
			AND CASE
				WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
					THEN (Products, Characteristic) IN
						(SELECT
							FilterOfProductItem.Products AS Products,
							FilterOfProductItem.Characteristic AS Characteristic
						FROM
							TTPlanProducts AS FilterOfProductItem)
				ELSE TRUE
			END) AS OrdersToBeRegistered
		ON Orders.Ref = OrdersToBeRegistered.InventoryConsumptionOrder
		 AND Orders.RowCode = OrdersToBeRegistered.RowCode
WHERE
	NOT Orders.Canceled
	AND Orders.Ref.Posted
	AND CASE
		WHEN &amp;SelectionAccordingToProductOfPlansIsUsed
			THEN (Orders.Products, Orders.Characteristic) IN
				(SELECT
						FilterOfProductItem.Products AS Products,
						FilterOfProductItem.Characteristic AS Characteristic
					FROM
						TTPlanProducts AS FilterOfProductItem)
		ELSE TRUE
	END

GROUP BY
	Orders.Products,
	Orders.Characteristic,
	OrderDetails.Department,
	CASE
		WHEN &amp;SpecifyTargets
			THEN CASE
					WHEN Orders.WithAssignment
						THEN OrderDetails.Purpose
					ELSE VALUE(Catalog.Assignments.EmptyRef)
				END
		ELSE VALUE(Catalog.Assignments.EmptyRef)
	END,
	OrderDetails.Ref,
	CASE
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.WEEK)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, WEEK)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.TENDAYS)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, TENDAYS)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.MONTH)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, MONTH)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.QUARTER)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, QUARTER)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.HALFYEAR)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, HALFYEAR)
		WHEN &amp;Periodicity = VALUE(Enum.Periodicity.YEAR)
			THEN BEGINOFPERIOD(Orders.DateOfShipment, YEAR)
		ELSE BEGINOFPERIOD(Orders.DateOfShipment, DAY)
	END
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.DynamicPeriod,
	NestedQuery.Department,
	NestedQuery.Products,
	NestedQuery.Characteristic,
	NestedQuery.Purpose,
	NestedQuery.Recorder,
	SUM(NestedQuery.PlanQuantity) AS PlanQuantity,
	SUM(NestedQuery.FactQuantity) AS FactQuantity,
	SUM(NestedQuery.OrderedQuantity) AS OrderedQuantity
INTO DomesticConsumptionPlanFact
FROM
	(SELECT
		InventoryConsumptionPlan.DynamicPeriod AS DynamicPeriod,
		InventoryConsumptionPlan.Department AS Department,
		InventoryConsumptionPlan.Products AS Products,
		InventoryConsumptionPlan.Characteristic AS Characteristic,
		InventoryConsumptionPlan.Purpose AS Purpose,
		InventoryConsumptionPlan.Recorder AS Recorder,
		InventoryConsumptionPlan.Count AS PlanQuantity,
		0 AS FactQuantity,
		0 AS OrderedQuantity
	FROM
		InventoryConsumptionPlan AS InventoryConsumptionPlan
	
	UNION ALL
	
	SELECT
		DomesticConsumption.DynamicPeriod,
		DomesticConsumption.Department,
		DomesticConsumption.Products,
		DomesticConsumption.Characteristic,
		DomesticConsumption.Purpose,
		DomesticConsumption.Recorder,
		0,
		DomesticConsumption.FactQuantity,
		0
	FROM
		DomesticConsumption AS DomesticConsumption
	
	UNION ALL
	
	SELECT
		Orders.DynamicPeriod,
		Orders.Department,
		Orders.Products,
		Orders.Characteristic,
		Orders.Purpose,
		Orders.Recorder,
		0,
		0,
		Orders.OrderedQuantity
	FROM
		Orders AS Orders) AS NestedQuery

GROUP BY
	NestedQuery.DynamicPeriod,
	NestedQuery.Characteristic,
	NestedQuery.Products,
	NestedQuery.Purpose,
	NestedQuery.Department,
	NestedQuery.Recorder
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	DomesticConsumptionPlanFact.DynamicPeriod,
	DomesticConsumptionPlanFact.Department AS Department,
	DomesticConsumptionPlanFact.Products AS Products,
	DomesticConsumptionPlanFact.Products.UnitOfMeasure AS StorageUnit,
	DomesticConsumptionPlanFact.Products.UnitForReports AS UnitForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	DomesticConsumptionPlanFact.Characteristic AS Characteristic,
	DomesticConsumptionPlanFact.Purpose AS Purpose,
	DomesticConsumptionPlanFact.Recorder AS Recorder,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN SUM(DomesticConsumptionPlanFact.PlanQuantity)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN DomesticConsumptionPlanFact.Products.UnitFactorForReports &lt;&gt; 0
					THEN SUM(DomesticConsumptionPlanFact.PlanQuantity) * (1 / DomesticConsumptionPlanFact.Products.UnitFactorForReports)
				ELSE SUM(DomesticConsumptionPlanFact.PlanQuantity)
			END
	END AS PlanQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN -SUM(DomesticConsumptionPlanFact.FactQuantity)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN DomesticConsumptionPlanFact.Products.UnitFactorForReports &lt;&gt; 0
					THEN -SUM(DomesticConsumptionPlanFact.FactQuantity) * (1 / DomesticConsumptionPlanFact.Products.UnitFactorForReports)
				ELSE -SUM(DomesticConsumptionPlanFact.FactQuantity)
			END
	END AS FactQuantity,
	100 * (CASE
		WHEN SUM(DomesticConsumptionPlanFact.PlanQuantity) = 0
			THEN 0
		ELSE -SUM(DomesticConsumptionPlanFact.FactQuantity) / SUM(DomesticConsumptionPlanFact.PlanQuantity)
	END) AS ExecutionOfPlanQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN SUM(DomesticConsumptionPlanFact.OrderedQuantity)
		WHEN &amp;QuantityUnits = 1
			THEN CASE
				WHEN DomesticConsumptionPlanFact.Products.UnitFactorForReports &lt;&gt; 0
					THEN SUM(DomesticConsumptionPlanFact.OrderedQuantity) * (1 / DomesticConsumptionPlanFact.Products.UnitFactorForReports)
				ELSE SUM(DomesticConsumptionPlanFact.OrderedQuantity)
			END
	END AS OrderedQuantity
FROM
	DomesticConsumptionPlanFact AS DomesticConsumptionPlanFact
WHERE
	DomesticConsumptionPlanFact.DynamicPeriod BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod

GROUP BY
	DomesticConsumptionPlanFact.DynamicPeriod,
	DomesticConsumptionPlanFact.Products,
	DomesticConsumptionPlanFact.Products.UnitOfMeasure,
	DomesticConsumptionPlanFact.Products.UnitForReports,
	DomesticConsumptionPlanFact.Characteristic,
	DomesticConsumptionPlanFact.Purpose,
	DomesticConsumptionPlanFact.Recorder,
	DomesticConsumptionPlanFact.Department</query>
			</dataSet>
