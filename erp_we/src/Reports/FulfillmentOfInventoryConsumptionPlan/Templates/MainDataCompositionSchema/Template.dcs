				<v8:lang>it</v8:lang>
				<v8:content>Solo nomenclatura dei piani</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Tylko pozycje z planów</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
