		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	TransferredReturnablePackagingBalanceAndTurnovers.Partner,
	TransferredReturnablePackagingBalanceAndTurnovers.Products,
	TransferredReturnablePackagingBalanceAndTurnovers.Characteristic,
	TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_,
	SUM(CASE
		WHEN
			TransferredReturnablePackaging.Buyout
		THEN
			0
		ELSE
			TransferredReturnablePackagingBalanceAndTurnovers.CountExpense
	END) AS QuantityReturned,
	SUM(CASE
		WHEN
			TransferredReturnablePackaging.Buyout
		THEN
			TransferredReturnablePackagingBalanceAndTurnovers.CountExpense
		ELSE
			0
	END) AS QuantityRedeemed,
	SUM(CASE
		WHEN
			TransferredReturnablePackaging.Buyout
		THEN
			0
		ELSE
			TransferredReturnablePackagingBalanceAndTurnovers.SumExpense
	END) AS AmountReturned,
	SUM(CASE
		WHEN
			TransferredReturnablePackaging.Buyout
		THEN
			TransferredReturnablePackagingBalanceAndTurnovers.SumExpense
		ELSE
			0
	END) AS AmountRedeemed
INTO
	TransferredReturnablePackaging
FROM
	AccumulationRegister.TransferredReturnablePackaging.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Record, , ) AS TransferredReturnablePackagingBalanceAndTurnovers
		LEFT JOIN AccumulationRegister.TransferredReturnablePackaging AS TransferredReturnablePackaging
		ON TransferredReturnablePackagingBalanceAndTurnovers.Recorder = TransferredReturnablePackaging.Recorder
			AND TransferredReturnablePackagingBalanceAndTurnovers.LineNumber = TransferredReturnablePackaging.LineNumber
			AND TransferredReturnablePackagingBalanceAndTurnovers.Period = TransferredReturnablePackaging.Period
			AND TransferredReturnablePackagingBalanceAndTurnovers.Partner = TransferredReturnablePackaging.Partner
			AND TransferredReturnablePackagingBalanceAndTurnovers.Products =  TransferredReturnablePackaging.Products
			AND TransferredReturnablePackagingBalanceAndTurnovers.Characteristic =  TransferredReturnablePackaging.Characteristic
			AND TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_ =  TransferredReturnablePackaging.DocumentTransfers_
			AND TransferredReturnablePackagingBalanceAndTurnovers.InventoryOwnerAttribute =  TransferredReturnablePackaging.InventoryOwnerAttribute
			AND TransferredReturnablePackagingBalanceAndTurnovers.CCDNumber =  TransferredReturnablePackaging.CCDNumber
WHERE
	TransferredReturnablePackagingBalanceAndTurnovers.Recorder &lt;&gt; UNDEFINED
GROUP BY
	TransferredReturnablePackagingBalanceAndTurnovers.Partner,
	TransferredReturnablePackagingBalanceAndTurnovers.Products,
	TransferredReturnablePackagingBalanceAndTurnovers.Characteristic,
	TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_
;
SELECT ALLOWED
	TransferredReturnablePackagingBalanceAndTurnovers.Partner,
	TransferredReturnablePackagingBalanceAndTurnovers.Products,
	TransferredReturnablePackagingBalanceAndTurnovers.Characteristic,
	TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_,
	TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_.Currency AS Currency,
	SUM(TransferredReturnablePackagingBalanceAndTurnovers.CountOpeningBalance),
	SUM(TransferredReturnablePackagingBalanceAndTurnovers.CountClosingBalance),
	SUM(TransferredReturnablePackagingBalanceAndTurnovers.SumOpeningBalance),
	SUM(TransferredReturnablePackagingBalanceAndTurnovers.SumClosingBalance),
	SUM(TransferredReturnablePackagingBalanceAndTurnovers.CountReceipt) AS QuantityAccepted,
	SUM(TransferredReturnablePackagingBalanceAndTurnovers.SumReceipt) AS AmountAccepted,
	SUM(TransferredReturnablePackaging.QuantityReturned) AS QuantityReturned,
	SUM(TransferredReturnablePackaging.QuantityRedeemed) AS QuantityRedeemed,
	SUM(TransferredReturnablePackaging.AmountReturned) AS AmountReturned,
	SUM(TransferredReturnablePackaging.AmountRedeemed) AS AmountRedeemed
FROM
	AccumulationRegister.TransferredReturnablePackaging.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, , , ) AS TransferredReturnablePackagingBalanceAndTurnovers
LEFT JOIN
	TransferredReturnablePackaging
		ON TransferredReturnablePackagingBalanceAndTurnovers.Partner = TransferredReturnablePackaging.Partner
		AND TransferredReturnablePackagingBalanceAndTurnovers.Products =  TransferredReturnablePackaging.Products
		AND TransferredReturnablePackagingBalanceAndTurnovers.Characteristic =  TransferredReturnablePackaging.Characteristic
		AND TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_ = TransferredReturnablePackaging.DocumentTransfers_
GROUP BY
	TransferredReturnablePackagingBalanceAndTurnovers.Partner,
	TransferredReturnablePackagingBalanceAndTurnovers.Products,
	TransferredReturnablePackagingBalanceAndTurnovers.Characteristic,
	TransferredReturnablePackagingBalanceAndTurnovers.DocumentTransfers_
</query>
	</dataSet>
