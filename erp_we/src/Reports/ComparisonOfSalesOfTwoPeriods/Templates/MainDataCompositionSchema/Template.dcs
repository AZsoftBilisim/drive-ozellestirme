		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CurSalePeriod.Department AS Department,
	DimensionByPartners.Partner AS Partner,
	DimensionByPartners.Partner.BusinessRegion AS BusinessRegion,
	DimensionByPartners.Organization AS Organization,
	CASE WHEN &amp;ReportData = 3 THEN
		DimensionByPartners.Organization.LocalAccountingCurrency
	ELSE
		&amp;ManagementAccountingCurrency
	END AS Currency,
	DimensionByPartners.LineOfBusiness AS LineOfBusiness,
	DimensionOfProductItem.Products AS Products,
	DimensionOfProductItem.Products.UnitOfMeasure AS StorageUnit,
	DimensionOfProductItem.Products.UnitForReports AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	&amp;QueryTextItemWeight AS ProductsWeight,
	&amp;QueryTextTheVolumeOfTheItem AS ProductsVolume,
	CurSalePeriod.Manager AS Manager,
	CurSalePeriod.SalesOrder AS SalesOrder,
	CurSalePeriod.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CASE
		WHEN CurSalePeriod.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
			THEN CASE
					WHEN CurSalePeriod.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
						THEN CurSalePeriod.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
					ELSE CurSalePeriod.LotVendorAttributes.Vendor
				END
		ELSE CASE
				WHEN CurSalePeriod.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
					THEN CurSalePeriod.InventoryOwnerAttribute.GoodsOwner
				ELSE CurSalePeriod.LotVendorAttributes.Vendor
			END
	END AS Vendor,
	SUM(CurSalePeriod.CountTurnover) AS QuantityCurrentPeriod,
	SUM(CASE
			WHEN &amp;ReportData = 1
				THEN CurSalePeriod.RevenueAmountTurnover
			WHEN &amp;ReportData = 2
				THEN CurSalePeriod.RevenueAmountExcludingVATTurnover
			WHEN &amp;ReportData = 3
				THEN CurSalePeriod.RevenueAmountExclVATLocalTurnover
		END) AS RevenueAmountCurrentPeriod,
	SUM(CASE
			WHEN CurSalePeriod.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN CASE
						WHEN &amp;ReportData = 1
							THEN CurSalePeriod.RevenueAmountTurnover
						WHEN &amp;ReportData = 2
							THEN CurSalePeriod.RevenueAmountExcludingVATTurnover
						WHEN &amp;ReportData = 3
							THEN CurSalePeriod.RevenueAmountExclVATLocalTurnover
					END
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(CurSalePeriod.CountTurnover * CASE
							WHEN &amp;ReportData = 1
								THEN ISNULL(CostOfProducts.Cost, 0)
							WHEN &amp;ReportData = 2
								THEN ISNULL(CostOfProducts.CostExcludingVAT, 0)
							WHEN &amp;ReportData = 3
								THEN ISNULL(CostOfProducts.LocalCost, 0)
						END AS NUMBER(31,2))
			ELSE CASE
					WHEN &amp;ReportData = 1
						THEN CurSalePeriod.CostTurnover
					WHEN &amp;ReportData = 2
						THEN CurSalePeriod.CostExcludingVATTurnover
					WHEN &amp;ReportData = 3
						THEN CurSalePeriod.LocalCostTurnover
				END
		END) AS CostOfCurPeriod,
	SUM(CASE
			WHEN CurSalePeriod.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN 0
			ELSE CASE
					WHEN &amp;ReportData = 1
						THEN CurSalePeriod.AddExpensesForGoodsTurnover
					WHEN &amp;ReportData = 2
						THEN CurSalePeriod.AdditionalExpensesExcludingVATTurnover
					ELSE 0
				END
		END) AS AdditionalExpensesCurPeriod,
	0 AS NumberComparisonPeriod,
	0 AS RevenueAmountComparisonPeriod,
	0 AS CostOfSalesComparisonPeriod,
	0 AS AdditionalCostsComparisonPeriod
{SELECT
	Department.*,
	Partner.*,
	BusinessRegion.*,
	Organization.*,
	Products.*,
	Manager.*,
	SalesOrder.*,
	InventoryOwnerAttribute.*,
	Vendor.*,
	QuantityCurrentPeriod,
	RevenueAmountCurrentPeriod,
	CostOfCurPeriod,
	AdditionalExpensesCurPeriod,
	NumberComparisonPeriod,
	RevenueAmountComparisonPeriod,
	CostOfSalesComparisonPeriod,
	AdditionalCostsComparisonPeriod}
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;CurrentPeriodStart, &amp;CurrentPeriodEnd, Auto, ) AS CurSalePeriod
		{LEFT JOIN Catalog.DimensionKeysOfAccountingByPartners AS DimensionByPartners
		ON CurSalePeriod.AccountingDimensionByPartners = DimensionByPartners.Ref}
		{LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON CurSalePeriod.ItemsLocationAttributes = DimensionOfProductItem.Ref}
		{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON CurSalePeriod.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
			AND (DimensionByPartners.Organization = CostOfProducts.Organization)
			AND CurSalePeriod.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
			AND (CostOfProducts.Period = BEGINOFPERIOD(CurSalePeriod.MonthPeriod, MONTH))}
		{LEFT JOIN Document.InventoryCostCalculation.Companies AS CalculationOfCost
		ON (BEGINOFPERIOD(CurSalePeriod.MonthPeriod, MONTH) = BEGINOFPERIOD(CalculationOfCost.Ref.Date, MONTH))
			AND (DimensionByPartners.Organization = CalculationOfCost.Organization)
			AND CalculationOfCost.Ref.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
			AND (CalculationOfCost.Ref.Posted)}
WHERE
	DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	CurSalePeriod.Department.*,
	DimensionByPartners.Partner.*,
	DimensionByPartners.Partner.BusinessRegion.* AS BusinessRegion,
	DimensionByPartners.Organization.*,
	DimensionOfProductItem.Products.*,
	DimensionOfProductItem.Products.UnitOfMeasure.* AS UnitOfMeasure,
	DimensionOfProductItem.Products.UnitForReports.* AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	(&amp;QueryTextItemWeight) AS ProductsWeight,
	(&amp;QueryTextTheVolumeOfTheItem) AS ProductsVolume,
	CurSalePeriod.Manager.* AS Manager,
	CurSalePeriod.SalesOrder.*,
	CurSalePeriod.InventoryOwnerAttribute.*,
	(CASE
			WHEN CurSalePeriod.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
				THEN CASE
						WHEN CurSalePeriod.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
							THEN CurSalePeriod.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
						ELSE CurSalePeriod.LotVendorAttributes.Vendor
					END
			ELSE CASE
					WHEN CurSalePeriod.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
						THEN CurSalePeriod.InventoryOwnerAttribute.GoodsOwner
					ELSE CurSalePeriod.LotVendorAttributes.Vendor
				END
		END).* AS Vendor}

GROUP BY
	CurSalePeriod.Department,
	DimensionByPartners.Partner,
	DimensionByPartners.Partner.BusinessRegion,
	DimensionByPartners.Organization,
	DimensionByPartners.LineOfBusiness,
	DimensionOfProductItem.Products,
	CurSalePeriod.Manager,
	CurSalePeriod.SalesOrder,
	CurSalePeriod.InventoryOwnerAttribute,
	CASE
		WHEN CurSalePeriod.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
			THEN CASE
					WHEN CurSalePeriod.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
						THEN CurSalePeriod.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
					ELSE CurSalePeriod.LotVendorAttributes.Vendor
				END
		ELSE CASE
				WHEN CurSalePeriod.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
					THEN CurSalePeriod.InventoryOwnerAttribute.GoodsOwner
				ELSE CurSalePeriod.LotVendorAttributes.Vendor
			END
	END,
	DimensionOfProductItem.Products.UnitOfMeasure,
	DimensionOfProductItem.Products.UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports

UNION ALL

SELECT
	ComparisonPeriodOfSale.Department,
	DimensionByPartners.Partner,
	DimensionByPartners.Partner.BusinessRegion,
	DimensionByPartners.Organization,
	CASE WHEN &amp;ReportData = 3 THEN
		DimensionByPartners.Organization.LocalAccountingCurrency
	ELSE
		&amp;ManagementAccountingCurrency
	END AS Currency,
	DimensionByPartners.LineOfBusiness,
	DimensionOfProductItem.Products,
	DimensionOfProductItem.Products.UnitOfMeasure,
	DimensionOfProductItem.Products.UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports,
	&amp;QueryTextItemWeight,
	&amp;QueryTextTheVolumeOfTheItem,
	ComparisonPeriodOfSale.Manager,
	ComparisonPeriodOfSale.SalesOrder,
	ComparisonPeriodOfSale.InventoryOwnerAttribute,
	CASE
		WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
			THEN CASE
					WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
						THEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
					ELSE ComparisonPeriodOfSale.LotVendorAttributes.Vendor
				END
		ELSE CASE
				WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
					THEN ComparisonPeriodOfSale.InventoryOwnerAttribute.GoodsOwner
				ELSE ComparisonPeriodOfSale.LotVendorAttributes.Vendor
			END
	END,
	0,
	0,
	0,
	0,
	SUM(ComparisonPeriodOfSale.CountTurnover),
	SUM(CASE
			WHEN &amp;ReportData = 1
				THEN ComparisonPeriodOfSale.RevenueAmountTurnover
			WHEN &amp;ReportData = 2
				THEN ComparisonPeriodOfSale.RevenueAmountExcludingVATTurnover
			WHEN &amp;ReportData = 3
				THEN ComparisonPeriodOfSale.RevenueAmountExclVATLocalTurnover
		END),
	SUM(CASE
			WHEN ComparisonPeriodOfSale.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN CASE
						WHEN &amp;ReportData = 1
							THEN ComparisonPeriodOfSale.RevenueAmountTurnover
						WHEN &amp;ReportData = 2
							THEN ComparisonPeriodOfSale.RevenueAmountExcludingVATTurnover
						WHEN &amp;ReportData = 3
							THEN ComparisonPeriodOfSale.RevenueAmountExclVATLocalTurnover
					END
			WHEN ISNULL(CalculationOfCost.Ref.PreliminaryCalculation, FALSE)
				THEN CAST(ComparisonPeriodOfSale.CountTurnover * CASE
							WHEN &amp;ReportData = 1
								THEN ISNULL(CostOfProducts.Cost, 0)
							WHEN &amp;ReportData = 2
								THEN ISNULL(CostOfProducts.CostExcludingVAT, 0)
							WHEN &amp;ReportData = 3
								THEN ISNULL(CostOfProducts.LocalCost, 0)
						END AS NUMBER(31,2))
			ELSE CASE
					WHEN &amp;ReportData = 1
						THEN ComparisonPeriodOfSale.CostTurnover
					WHEN &amp;ReportData = 2
						THEN ComparisonPeriodOfSale.CostExcludingVATTurnover
					WHEN &amp;ReportData = 3
						THEN ComparisonPeriodOfSale.LocalCostTurnover
				END
		END),
	SUM(CASE
			WHEN ComparisonPeriodOfSale.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
				THEN 0
			ELSE CASE
					WHEN &amp;ReportData = 1
						THEN ComparisonPeriodOfSale.AddExpensesForGoodsTurnover
					WHEN &amp;ReportData = 2
						THEN ComparisonPeriodOfSale.AdditionalExpensesExcludingVATTurnover
					ELSE 0
				END
		END)
FROM
	AccumulationRegister.RevenueAndCOGS.Turnovers(&amp;ComparisonPeriodStartDate, &amp;ComparisonPeriodEndDate, Auto, ) AS ComparisonPeriodOfSale
		{LEFT JOIN Catalog.DimensionKeysOfAccountingByPartners AS DimensionByPartners
		ON ComparisonPeriodOfSale.AccountingDimensionByPartners = DimensionByPartners.Ref}
		{LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionOfProductItem
		ON ComparisonPeriodOfSale.ItemsLocationAttributes = DimensionOfProductItem.Ref}
		{LEFT JOIN InformationRegister.GoodsCost AS CostOfProducts
		ON ComparisonPeriodOfSale.ItemsLocationAttributes = CostOfProducts.ItemsLocationAttributes
			AND (DimensionByPartners.Organization = CostOfProducts.Organization)
			AND ComparisonPeriodOfSale.InventoryOwnerAttribute = CostOfProducts.InventoryOwnerAttribute
			AND (CostOfProducts.Period = BEGINOFPERIOD(ComparisonPeriodOfSale.MonthPeriod, MONTH))}
		{LEFT JOIN Document.InventoryCostCalculation.Companies AS CalculationOfCost
		ON (BEGINOFPERIOD(ComparisonPeriodOfSale.MonthPeriod, MONTH) = BEGINOFPERIOD(CalculationOfCost.Ref.Date, MONTH))
			AND (DimensionByPartners.Organization = CalculationOfCost.Organization)
			AND CalculationOfCost.Ref.EntryType = VALUE(Enum.LotRecordTypes.EmptyRef)
			AND (CalculationOfCost.Ref.Posted)}
WHERE
	DimensionByPartners.Partner &lt;&gt; VALUE(Catalog.Partners.OurEnterprise)
{WHERE
	((DimensionOfProductItem.Products, DimensionOfProductItem.Characteristic) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.Characteristic
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(DimensionByPartners.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	ComparisonPeriodOfSale.Department.*,
	DimensionByPartners.Partner.*,
	DimensionByPartners.Partner.BusinessRegion.* AS BusinessRegion,
	DimensionByPartners.Organization.*,
	DimensionOfProductItem.Products.*,
	DimensionOfProductItem.Products.UnitOfMeasure.* AS UnitOfMeasure,
	DimensionOfProductItem.Products.UnitForReports.* AS UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports AS UnitFactorForReports,
	(&amp;QueryTextItemWeight) AS ProductsWeight,
	(&amp;QueryTextTheVolumeOfTheItem) AS ProductsVolume,
	ComparisonPeriodOfSale.Manager.* AS Manager,
	ComparisonPeriodOfSale.SalesOrder.*,
	ComparisonPeriodOfSale.InventoryOwnerAttribute.*,
	(CASE
			WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
				THEN CASE
						WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
							THEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
						ELSE ComparisonPeriodOfSale.LotVendorAttributes.Vendor
					END
			ELSE CASE
					WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
						THEN ComparisonPeriodOfSale.InventoryOwnerAttribute.GoodsOwner
					ELSE ComparisonPeriodOfSale.LotVendorAttributes.Vendor
				END
		END).* AS Vendor}

GROUP BY
	ComparisonPeriodOfSale.Department,
	DimensionByPartners.Partner,
	DimensionByPartners.Partner.BusinessRegion,
	DimensionByPartners.Organization,
	DimensionByPartners.LineOfBusiness,
	DimensionOfProductItem.Products,
	ComparisonPeriodOfSale.Manager,
	ComparisonPeriodOfSale.SalesOrder,
	ComparisonPeriodOfSale.InventoryOwnerAttribute,
	CASE
		WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.SaleOfAnotherCompanyInventory
			THEN CASE
					WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
						THEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryOwnerAttributeOfCompanyGoodsOwner.GoodsOwner
					ELSE ComparisonPeriodOfSale.LotVendorAttributes.Vendor
				END
		ELSE CASE
				WHEN ComparisonPeriodOfSale.InventoryOwnerAttribute.InventoryType = VALUE(Enum.InventoryTypes.ConsignedGoods)
					THEN ComparisonPeriodOfSale.InventoryOwnerAttribute.GoodsOwner
				ELSE ComparisonPeriodOfSale.LotVendorAttributes.Vendor
			END
	END,
	DimensionOfProductItem.Products.UnitOfMeasure,
	DimensionOfProductItem.Products.UnitForReports,
	DimensionOfProductItem.Products.UnitFactorForReports</query>
	</dataSet>
	<calculatedField>
		<dataPath>RelativeRevenueGrowth</dataPath>
		<expression>SalesServer.IncreasePercentage(RevenueAmountComparisonPeriod, RevenueAmountCurrentPeriod)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Revenue change, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تغییر درآمد، درصد</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Variazione del fatturato, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Zmiana utargu, %</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
