					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>ND=15; NFD=3</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>ND=15; NFD=3</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MarkNegatives</dcscor:parameter>
				<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MaxWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>ReportUnit</dataPath>
		<expression>Case
	When &amp;QuantityUnits = 0 Then
		StorageUnit
	When &amp;QuantityUnits = 1 Then
		UnitForReports
End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report unit</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>واحد گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Unità del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Jednostka raportu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Единица отчета</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Rapor birimi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đơn vị báo cáo</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>RevenueAmountCurrentPeriod</dataPath>
		<expression>Sum(RevenueAmountCurrentPeriod)
</expression>
	</totalField>
	<totalField>
		<dataPath>RevenueAmountComparisonPeriod</dataPath>
		<expression>Sum(RevenueAmountComparisonPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityCurrentPeriod</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(QuantityCurrentPeriod)
End</expression>
	</totalField>
	<totalField>
		<dataPath>NumberComparisonPeriod</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(NumberComparisonPeriod)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AverageRevenueGrowth</dataPath>
		<expression>EvalExpression("SalesServer.IncreasePercentage(Sum(RevenueAmountComparisonPeriod), Sum(RevenueAmountCurrentPeriod))", "Overall")</expression>
	</totalField>
	<totalField>
		<dataPath>AverageQuantityGrowth</dataPath>
		<expression>EvalExpression("SalesServer.IncreasePercentage(
	Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then 0 Else Sum(NumberComparisonPeriod) End, 
	Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then 0 Else Sum(QuantityCurrentPeriod) End)", "Overall")</expression>
	</totalField>
	<totalField>
		<dataPath>AbsoluteRevenueGrowth</dataPath>
		<expression>Sum(AbsoluteRevenueGrowth)</expression>
	</totalField>
	<totalField>
		<dataPath>AbsoluteIncreaseInQuantity</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
		Then 0
	Else Sum(AbsoluteIncreaseInQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>RelativeRevenueGrowth</dataPath>
		<expression>SalesServer.IncreasePercentage(Sum(RevenueAmountComparisonPeriod), Sum(RevenueAmountCurrentPeriod))</expression>
	</totalField>
	<totalField>
		<dataPath>RelativeIncreaseInQuantity</dataPath>
		<expression>SalesServer.IncreasePercentage(
		Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then 0 Else Sum(NumberComparisonPeriod) End,
		Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then 0 Else Sum(QuantityCurrentPeriod) End)</expression>
	</totalField>
	<totalField>
		<dataPath>Growth</dataPath>
		<expression>Case
	When (Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod)) &gt; 0
	Then Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod)
	Else 0
End)</expression>
	</totalField>
	<totalField>
		<dataPath>Slippage</dataPath>
		<expression>Case
	When (Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod)) &lt; 0
	Then Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod)
	Else 0
End)</expression>
	</totalField>
	<totalField>
		<dataPath>CostOfSalesComparisonPeriod</dataPath>
		<expression>Sum(CostOfSalesComparisonPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>CostOfCurPeriod</dataPath>
		<expression>Sum(CostOfCurPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>AdditionalCostsComparisonPeriod</dataPath>
		<expression>Sum(AdditionalCostsComparisonPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>AdditionalExpensesCurPeriod</dataPath>
		<expression>Sum(AdditionalExpensesCurPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>ProfitComparisonPeriod</dataPath>
		<expression>Sum(ProfitComparisonPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>ProfitCurPeriod</dataPath>
		<expression>Sum(ProfitCurPeriod)</expression>
	</totalField>
	<totalField>
		<dataPath>NegativeChangeInRevenue</dataPath>
		<expression>Case 
	When Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod) &lt; 0 
	Then Sum(RevenueAmountComparisonPeriod) - Sum(RevenueAmountCurrentPeriod) Else 0
End
</expression>
	</totalField>
	<totalField>
		<dataPath>PositiveChangeInRevenue</dataPath>
		<expression>Case 
	When Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod) &gt; 0 
	Then Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod) Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>RevenueComparisonPeriodForChart</dataPath>
		<expression>Case 
	When Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod) &gt; 0 
	Then Sum(RevenueAmountComparisonPeriod) 
	Else 0 
End
</expression>
	</totalField>
	<totalField>
		<dataPath>CurPeriodRevenueForChart</dataPath>
		<expression>Case 
	When Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod) &lt; 0 
	Then Sum(RevenueAmountCurrentPeriod) 
	Else 0 
End
</expression>
	</totalField>
	<totalField>
		<dataPath>NegativeChangeInRevenuePercentage</dataPath>
		<expression>Case 
    When Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod) &lt; 0 
    Then
        (-1)*SalesServer.IncreasePercentage(Sum(RevenueAmountComparisonPeriod), Sum(RevenueAmountCurrentPeriod))
    Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>PositiveChangeInRevenuePercentage</dataPath>
		<expression>Case 
    When Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod) &gt; 0 
    Then
        SalesServer.IncreasePercentage(Sum(RevenueAmountComparisonPeriod), Sum(RevenueAmountCurrentPeriod))
    Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>RatingCurPeriod</dataPath>
		<expression>Rank("Sum(RevenueAmountCurrentPeriod) Desc")</expression>
	</totalField>
	<totalField>
		<dataPath>RatingComparisonPeriod</dataPath>
		<expression>Rank("Sum(RevenueAmountComparisonPeriod) Desc")</expression>
	</totalField>
	<totalField>
		<dataPath>RatingDirection</dataPath>
		<expression>Case
    When Rank("Sum(RevenueAmountCurrentPeriod) Desc") = Rank("Sum(RevenueAmountComparisonPeriod) Desc")
    	And Rank("Sum(RevenueAmountCurrentPeriod) Desc") &lt;&gt; 0
    Then "▬"
    When Rank("Sum(RevenueAmountCurrentPeriod) Desc") &gt; Rank("Sum(RevenueAmountComparisonPeriod) Desc")
    Then "▼"
    When Rank("Sum(RevenueAmountCurrentPeriod) Desc") &lt; Rank("Sum(RevenueAmountComparisonPeriod) Desc")
    Then "▲"
End</expression>
	</totalField>
	<totalField>
		<dataPath>PositiveChangeInRevenuePercentageBelowAverage</dataPath>
		<expression>Case 
    When Sum(RevenueAmountCurrentPeriod) - Sum(RevenueAmountComparisonPeriod) &gt; 0 
    Then
        Case 
            When Sum(RevenueAmountComparisonPeriod) = 0 
            Then
                Case
                    When 100 &lt;=
                    EvalExpression("SalesServer.IncreasePercentage(Sum(RevenueAmountComparisonPeriod), Sum(RevenueAmountCurrentPeriod))", "Overall")
                    Then 100
                    Else 0
                End
            Else
                Case
                    When SalesServer.IncreasePercentage(Sum(RevenueAmountComparisonPeriod), Sum(RevenueAmountCurrentPeriod)) &lt;=
                    EvalExpression("SalesServer.IncreasePercentage(Sum(RevenueAmountComparisonPeriod), Sum(RevenueAmountCurrentPeriod))", "Overall")
                    Then SalesServer.IncreasePercentage(Sum(RevenueAmountComparisonPeriod), Sum(RevenueAmountCurrentPeriod)) 
                    Else 0
                End
        End
    Else 0
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityComparisonPeriodWeight</dataPath>
		<expression>Sum(QuantityComparisonPeriodWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberPeriodOfComparisonVolume</dataPath>
		<expression>Sum(NumberPeriodOfComparisonVolume)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityCurPeriodWeight</dataPath>
		<expression>Sum(QuantityCurPeriodWeight)</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityCurPeriodVolume</dataPath>
		<expression>Sum(QuantityCurPeriodVolume)</expression>
	</totalField>
