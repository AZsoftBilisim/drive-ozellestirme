		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN OccupancyPlansForWorkCenterTypesTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN OccupancyPlansForWorkCenterTypesTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN OccupancyPlansForWorkCenterTypesTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN OccupancyPlansForWorkCenterTypesTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN OccupancyPlansForWorkCenterTypesTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN OccupancyPlansForWorkCenterTypesTurnovers.YearPeriod
		ELSE OccupancyPlansForWorkCenterTypesTurnovers.DayPeriod
	END AS Period,
	ProductionPlansTurnovers.Scenario AS Scenario,
	OccupancyPlansForWorkCenterTypesTurnovers.WorkCenterType AS WorkCenterType,
	OccupancyPlansForWorkCenterTypesTurnovers.ProductionDispatcherBusinessUnit AS ProductionDispatcherBusinessUnit,
	OccupancyPlansForWorkCenterTypesTurnovers.AssigneeBusinessUnit AS AssigneeBusinessUnit,
	OccupancyPlansForWorkCenterTypesTurnovers.ProductsItems AS ProductsItems,
	OccupancyPlansForWorkCenterTypesTurnovers.ItemVariant AS ItemVariant,
	OccupancyPlansForWorkCenterTypesTurnovers.ProductionPlan AS ProductionPlan,
	OccupancyPlansForWorkCenterTypesTurnovers.ProductionDate AS ProductionDate,
	OccupancyPlansForWorkCenterTypesTurnovers.WorkCenterType.MaximumWorkCenterAvailability AS MaximumTypeOfWorkCentersAvailability,
	OccupancyPlansForWorkCenterTypesTurnovers.WorkCenterType.UnitOfMeasureOfWorkCenterSchedule AS UnitOfMeasureForWorkCenterType,
	OccupancyPlansForWorkCenterTypesTurnovers.WorkCenterType.EnterAvailabilityForWorkCenterType AS CheckForTypeOfWorkCentersAvailabilityInput,
	OccupancyPlansForWorkCenterTypesTurnovers.WorkCenterType.NumberOfWorkCenters AS QuantityOfWorkCentersInWorkCenterType,
	OccupancyPlansForWorkCenterTypesTurnovers.OccupationTurnover / &amp;TimeOption AS Required2,
	ProductionPlansTurnovers.CountTurnover AS ProductsQuantity
FROM
	AccumulationRegister.OccupancyPlansForWorkCenterTypes.Turnovers(,, Auto, Scenario = &amp;Scenario) AS
		OccupancyPlansForWorkCenterTypesTurnovers
		{LEFT JOIN AccumulationRegister.ProductionPlans.Turnovers({(&amp;PlanPeriodStart)}, {(&amp;PlanPeriodEnd)},
			Record, Scenario = &amp;Scenario {(Products) AS ProductsItems, (Characteristic) AS
			ItemVariant, (Department) AS ProductionDispatcherBusinessUnit}) AS ProductionPlansTurnovers
		ON OccupancyPlansForWorkCenterTypesTurnovers.ProductsItems = ProductionPlansTurnovers.Products
		AND OccupancyPlansForWorkCenterTypesTurnovers.ItemVariant = ProductionPlansTurnovers.Characteristic
		AND OccupancyPlansForWorkCenterTypesTurnovers.AssignmentOfProducts = ProductionPlansTurnovers.Purpose
		AND OccupancyPlansForWorkCenterTypesTurnovers.ProductionDispatcherBusinessUnit = ProductionPlansTurnovers.Department
		AND OccupancyPlansForWorkCenterTypesTurnovers.Scenario = ProductionPlansTurnovers.Scenario
		AND OccupancyPlansForWorkCenterTypesTurnovers.ProductionPlan = ProductionPlansTurnovers.ProductionPlan
		AND OccupancyPlansForWorkCenterTypesTurnovers.ProductionDate = ProductionPlansTurnovers.Period}</query>
	</dataSet>
