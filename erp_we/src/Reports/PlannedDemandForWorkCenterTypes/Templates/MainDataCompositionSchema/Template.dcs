		<field xsi:type="DataSetFieldField">
			<dataPath>Period</dataPath>
			<field>Period</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دوره</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Periodo</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Okres</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Dönem</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kỳ</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT
	CASE &amp;Periodicity
		WHEN VALUE(Enum.Periodicity.WEEK)
			THEN AvailabilityOfWorkCenterTypesTurnovers.WeekPeriod
		WHEN VALUE(Enum.Periodicity.TENDAYS)
			THEN AvailabilityOfWorkCenterTypesTurnovers.TenDaysPeriod
		WHEN VALUE(Enum.Periodicity.MONTH)
			THEN AvailabilityOfWorkCenterTypesTurnovers.MonthPeriod
		WHEN VALUE(Enum.Periodicity.QUARTER)
			THEN AvailabilityOfWorkCenterTypesTurnovers.QuarterPeriod
		WHEN VALUE(Enum.Periodicity.HALFYEAR)
			THEN AvailabilityOfWorkCenterTypesTurnovers.HalfYearPeriod
		WHEN VALUE(Enum.Periodicity.YEAR)
			THEN AvailabilityOfWorkCenterTypesTurnovers.YearPeriod
		ELSE AvailabilityOfWorkCenterTypesTurnovers.DayPeriod
	END AS Period,
	AvailabilityOfWorkCenterTypesTurnovers.WorkCenterType AS WorkCenterType,
	AvailabilityOfWorkCenterTypesTurnovers.WorkCenterType.Department AS WorkCenterTypeDepartment,
	CASE
		WHEN AvailabilityOfWorkCenterTypesTurnovers.WorkCenterType.EnterAvailabilityForWorkCenterType
			THEN AvailabilityOfWorkCenterTypesTurnovers.WorkCenterTypeScheduleTurnover
		ELSE AvailabilityOfWorkCenterTypesTurnovers.WorkCenterScheduleTurnover
	END / &amp;TimeOption AS Available
FROM
	AccumulationRegister.AvailabilityOfWorkCenterTypes.Turnovers(, , Auto, ) AS AvailabilityOfWorkCenterTypesTurnovers</query>
	</dataSet>
