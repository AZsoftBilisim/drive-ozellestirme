					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>NFD=0</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>15</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>ValueOfTimeOption</dataPath>
		<expression>Case When &amp;TimeOption = 3600 Then 1 When &amp;TimeOption = 3600000 Then 1000 Else 1 End</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Value of time option</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>مقدار گزینه زمان</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Valore dell'opzione tempo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wartość wariantu czasu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Значение варианта времени</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Zaman seçeneği değeri</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Giá trị tùy chọn thời gian</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Format</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>ЧДЦ(NFD)=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>NFD=0</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>NFD=0</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>15</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>Available</dataPath>
		<expression>Sum(Available)</expression>
	</totalField>
	<totalField>
		<dataPath>Required2</dataPath>
		<expression>Sum(Required2)</expression>
	</totalField>
	<totalField>
		<dataPath>ProductsQuantity</dataPath>
		<expression>Sum(ProductsQuantity)</expression>
	</totalField>
	<totalField>
		<dataPath>ExcessShortagePercentage</dataPath>
		<expression>Case When Sum(Required2) = 0 Then 0  When Sum(Available) = 0 Then 100 Else ((Sum(Required2) - Sum(Available)) / Sum(Available)) * 100 End</expression>
	</totalField>
	<totalField>
		<dataPath>ExcessShortage</dataPath>
		<expression>Sum(Required2) - Sum(Available)</expression>
	</totalField>
	<totalField>
		<dataPath>MaximumPower</dataPath>
		<expression>Case 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Hour) And &amp;Periodicity = Value(Enum.Periodicity.Week) 
		Then (MaximumTypeOfWorkCentersAvailability * NumberOfRC_ * 7) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Minute) And &amp;Periodicity = Value(Enum.Periodicity.Week) 
		Then ((MaximumTypeOfWorkCentersAvailability / 60) * NumberOfRC_ * 7) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Days1) And &amp;Periodicity = Value(Enum.Periodicity.Week) 
		Then (MaximumTypeOfWorkCentersAvailability * 24 * NumberOfRC_ * 7) / ValueOfTimeOption

	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Hour) And &amp;Periodicity = Value(Enum.Periodicity.TenDays) 
		Then (MaximumTypeOfWorkCentersAvailability * NumberOfRC_ * 10) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Minute) And &amp;Periodicity = Value(Enum.Periodicity.TenDays) 
		Then ((MaximumTypeOfWorkCentersAvailability / 60) * NumberOfRC_ * 10) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Days1) And &amp;Periodicity = Value(Enum.Periodicity.TenDays) 
		Then (MaximumTypeOfWorkCentersAvailability * 24 * NumberOfRC_ * 10) / ValueOfTimeOption

	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Hour) And &amp;Periodicity = Value(Enum.Periodicity.Month) 
		Then (MaximumTypeOfWorkCentersAvailability * NumberOfRC_ * 31) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Minute) And &amp;Periodicity = Value(Enum.Periodicity.Month) 
		Then ((MaximumTypeOfWorkCentersAvailability / 60) * NumberOfRC_ * 31) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Days1) And &amp;Periodicity = Value(Enum.Periodicity.Month) 
		Then (MaximumTypeOfWorkCentersAvailability * 24 * NumberOfRC_ * 31) / ValueOfTimeOption

	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Hour) And &amp;Periodicity = Value(Enum.Periodicity.Quarter) 
		Then (MaximumTypeOfWorkCentersAvailability * NumberOfRC_ * 92) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Minute) And &amp;Periodicity = Value(Enum.Periodicity.Quarter) 
		Then ((MaximumTypeOfWorkCentersAvailability / 60) * NumberOfRC_ * 92) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Days1) And &amp;Periodicity = Value(Enum.Periodicity.Quarter) 
		Then (MaximumTypeOfWorkCentersAvailability * 24 * NumberOfRC_ * 92) / ValueOfTimeOption

	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Hour) And &amp;Periodicity = Value(Enum.Periodicity.HalfYear) 
		Then (MaximumTypeOfWorkCentersAvailability * NumberOfRC_ * 184) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Minute) And &amp;Periodicity = Value(Enum.Periodicity.HalfYear) 
		Then ((MaximumTypeOfWorkCentersAvailability / 60) * NumberOfRC_ * 184) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Days1) And &amp;Periodicity = Value(Enum.Periodicity.HalfYear) 
		Then (MaximumTypeOfWorkCentersAvailability * 24 * NumberOfRC_ * 184) / ValueOfTimeOption

	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Hour) And &amp;Periodicity = Value(Enum.Periodicity.Year)
		Then (MaximumTypeOfWorkCentersAvailability * NumberOfRC_ * 365) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Minute) And &amp;Periodicity = Value(Enum.Periodicity.Year) 
		Then ((MaximumTypeOfWorkCentersAvailability / 60) * NumberOfRC_ * 365) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Days1) And &amp;Periodicity = Value(Enum.Periodicity.Year) 
		Then (MaximumTypeOfWorkCentersAvailability * 24 * NumberOfRC_ * 365) / ValueOfTimeOption

	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Hour) And &amp;Periodicity = Value(Enum.Periodicity.Day) 
		Then (MaximumTypeOfWorkCentersAvailability * NumberOfRC_) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Minute) And &amp;Periodicity = Value(Enum.Periodicity.Day) 
		Then ((MaximumTypeOfWorkCentersAvailability / 60) * NumberOfRC_) / ValueOfTimeOption 
	When UnitOfMeasureForWorkCenterType = Value(Enum.TimeMeasureUnits.Days1) And &amp;Periodicity = Value(Enum.Periodicity.Day) 
		Then (MaximumTypeOfWorkCentersAvailability * 24 * NumberOfRC_) / ValueOfTimeOption
End</expression>
	</totalField>
	<totalField>
		<dataPath>RequiredAvailabilityPercentage</dataPath>
		<expression>Case When Sum(Available) = 0 Then 0 Else Format((Sum(Required2) / Sum(Available)) * 100, "NFD=2") End</expression>
	</totalField>
