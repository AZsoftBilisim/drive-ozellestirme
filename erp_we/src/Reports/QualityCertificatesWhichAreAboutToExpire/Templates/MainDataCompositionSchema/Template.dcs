				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Sertifika türü</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kiểu giấy chứng nhận</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT DISTINCT
	QualityCertificateApplicationAreas.QualityCertificate,
	QualityCertificateApplicationAreas.QualityCertificate.CertificateType AS CertificateType,
	QualityCertificateApplicationAreas.QualityCertificate.Permanent,
	CASE
		WHEN QualityCertificateApplicationAreas.QualityCertificate.Permanent
			THEN DATETIME(3999, 12, 31, 23, 59, 59)
		ELSE QualityCertificateApplicationAreas.QualityCertificate.ValidTo
	END AS Expiration,
	QualityCertificateApplicationAreas.QualityCertificate.ValidTo AS State,
	QualityCertificateApplicationAreas.QualityCertificate.Status AS Status
FROM
	InformationRegister.QualityCertificateApplicationAreas AS QualityCertificateApplicationAreas
{WHERE
	(&amp;ProductKind = QualityCertificateApplicationAreas.ProductKind),
	(&amp;Products = QualityCertificateApplicationAreas.Products),
	(&amp;Characteristic = QualityCertificateApplicationAreas.Characteristic),
	(&amp;Series = QualityCertificateApplicationAreas.Series),
	(QualityCertificateApplicationAreas.QualityCertificate.ValidTo &gt;= &amp;DateHideCertificates OR QualityCertificateApplicationAreas.QualityCertificate.Permanent),
	(QualityCertificateApplicationAreas.QualityCertificate.ValidTo &lt; &amp;InvalidAsOfTheDate
			OR QualityCertificateApplicationAreas.QualityCertificate.Status = VALUE(Enum.StatusesOfQualityCertificates.Inactive))}</query>
	</dataSet>
