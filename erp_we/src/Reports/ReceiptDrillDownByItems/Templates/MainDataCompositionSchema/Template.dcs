		<dataSource>DataSource1</dataSource>
		<query>SELECT
	RegisterRecords.Recorder AS Document,
	
	Dimension.Products AS Products,
	Dimension.Characteristic AS Characteristic,
	Dimension.Series AS Series,
		
	RegisterRecords.Count AS Count,
	RegisterRecords.Cost AS Sum,
	&amp;QueryTextItemWeight AS Weight,
	&amp;QueryTextTheVolumeOfTheItem AS VolumeM3,
	CASE
		WHEN &amp;QueryTextItemWeight = 0 OR &amp;QueryTextTheVolumeOfTheItem = 0
		THEN 1
		ELSE 0
	END AS Error
FROM
	AccumulationRegister.InventoryCost AS RegisterRecords
	LEFT JOIN Catalog.InventoryLocationAttributeKeys AS Dimension
	ON RegisterRecords.ItemsLocationAttributes = Dimension.Ref
	
	LEFT JOIN Catalog.Products AS CatProducts
	ON CatProducts.Ref = Dimension.Products
WHERE
	RegisterRecords.Recorder IN (&amp;DocumentsArray)</query>
	</dataSet>
	<totalField>
		<dataPath>Count</dataPath>
		<expression>Sum(Count)</expression>
	</totalField>
	<totalField>
		<dataPath>Sum</dataPath>
		<expression>Sum(Sum)</expression>
	</totalField>
	<totalField>
		<dataPath>VolumeM3</dataPath>
		<expression>Sum(VolumeM3)</expression>
	</totalField>
	<totalField>
		<dataPath>Weight</dataPath>
		<expression>Sum(Weight)</expression>
	</totalField>
