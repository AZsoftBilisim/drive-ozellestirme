	<totalField>
		<dataPath>PurchasedQuantityBase</dataPath>
		<expression>Sum(PurchasedQuantityBase)</expression>
	</totalField>
	<totalField>
		<dataPath>PurchasedQuantity</dataPath>
		<expression>Sum(PurchasedQuantity)</expression>
	</totalField>
	<totalField>
		<dataPath>PurchaseCostBase</dataPath>
		<expression>Sum(PurchaseCostBase)</expression>
	</totalField>
	<totalField>
		<dataPath>PurchaseCost</dataPath>
		<expression>Sum(PurchaseCost)</expression>
	</totalField>
	<totalField>
		<dataPath>PurchasePriceBase</dataPath>
		<expression>Case When Sum(PurchasedQuantityBase) &lt;&gt; 0 Then Sum(PurchaseCostBase) / Sum(PurchasedQuantityBase) Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>PurchasePrice</dataPath>
		<expression>Case When Sum(PurchasedQuantity) &lt;&gt; 0 Then Sum(PurchaseCost) / Sum(PurchasedQuantity) Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>PurchasingPriceIndex</dataPath>
		<expression>Case When Sum(PurchaseCostBase) &lt;&gt; 0 Then Sum(Case When PurchasedQuantity &lt;&gt; 0 Then PurchaseCost / PurchasedQuantity * PurchasedQuantityBase Else 0 End) / Sum(PurchaseCostBase) * 100 Else 0 End</expression>
	</totalField>
	<totalField>
		<dataPath>SerialNumber</dataPath>
		<expression>EvalExpression("GroupSerialNumber()", , , , , )</expression>
	</totalField>
	<totalField>
		<dataPath>PurchasePriceIndexWeight</dataPath>
		<expression>Sum(PurchaseCostBase) / EvalExpression("Sum(PurchaseCostBase)", "Products", "Hierarchy")</expression>
	</totalField>
	<totalField>
		<dataPath>ImpactOfPurchasingPriceIndex</dataPath>
		<expression>(Case When Sum(PurchaseCostBase) &lt;&gt; 0 Then Sum(Case When PurchasedQuantity &lt;&gt; 0 Then PurchaseCost / PurchasedQuantity * PurchasedQuantityBase Else 0 End) / Sum(PurchaseCostBase) Else 0 End - 1) * Sum(PurchaseCostBase) / EvalExpression("Sum(PurchaseCostBase)", "Products", "Hierarchy") * 100</expression>
	</totalField>
	<totalField>
		<dataPath>ChangeInPurchasePriceIndex</dataPath>
		<expression>Case When Sum(PurchaseCostBase) &lt;&gt; 0 Then Sum(Case When PurchasedQuantity &lt;&gt; 0 Then PurchaseCost / PurchasedQuantity * PurchasedQuantityBase Else 0 End) / Sum(PurchaseCostBase) * 100 - 100 Else 0 End</expression>
	</totalField>
