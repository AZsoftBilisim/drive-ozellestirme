		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Purchases.Partner AS Vendor,
	Purchases.ItemsLocationAttributes.Products AS Products,
	SUM(Purchases.CountTurnover) AS PurchasedQuantityBase,
	SUM(Purchases.CostTurnover) AS PurchaseCostBase
INTO ProcurementBasePeriod
{SELECT
	Vendor.*,
	Products.*,
	PurchasedQuantityBase,
	PurchaseCostBase}
FROM
	AccumulationRegister.Purchases.Turnovers(&amp;BeginOfPeriod, &amp;BasicPeriodEnd, Auto,
		BusinessOperation IN (VALUE(Enum.BusinessTransactions.PurchaseFromSupplier),
			VALUE(Enum.BusinessTransactions.PurchaseByImport),
			VALUE(Enum.BusinessTransactions.PurchaseViaAdvanceHolder))
		) AS Purchases
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS PartnerAnalytics_
		ON Purchases.Partner = PartnerAnalytics_.Partner
			AND Purchases.Organization = PartnerAnalytics_.Organization
			AND Purchases.Counterparty = PartnerAnalytics_.Counterparty
			AND Purchases.Contract = PartnerAnalytics_.Contract}
WHERE
	Purchases.CountTurnover &lt;&gt; 0
		OR Purchases.CostTurnover &lt;&gt; 0
GROUP BY
	Purchases.Partner,
	Purchases.ItemsLocationAttributes.Products
{WHERE
	(Purchases.ItemsLocationAttributes.Products IN
			(SELECT
				SelectionByProductSegment.Products
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(PartnerAnalytics_.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
			
INDEX BY
	Products,
	Vendor
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Purchases.Partner AS Vendor,
	Purchases.ItemsLocationAttributes.Products AS Products,
	Purchases.Recorder AS DocumentPurchases,
	Purchases.DayPeriod AS DayPeriod,
	Purchases.WeekPeriod AS WeekPeriod,
	Purchases.TenDaysPeriod AS TenDaysPeriod,
	Purchases.MonthPeriod AS MonthPeriod,
	Purchases.QuarterPeriod AS QuarterPeriod,
	Purchases.HalfYearPeriod AS HalfYearPeriod,
	Purchases.YearPeriod AS YearPeriod,
	SUM(Purchases.CountTurnover) AS PurchasedQuantity,
	SUM(Purchases.CostTurnover) AS PurchaseCost
INTO Purchases
{SELECT
	Vendor.*,
	Products.*,
	DocumentPurchases.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	PurchasedQuantity,
	PurchaseCost}
FROM
	AccumulationRegister.Purchases.Turnovers(&amp;BeginOfPeriod, &amp;PeriodEnding, Auto,
		BusinessOperation IN (VALUE(Enum.BusinessTransactions.PurchaseFromSupplier),
			VALUE(Enum.BusinessTransactions.PurchaseByImport),
			VALUE(Enum.BusinessTransactions.PurchaseViaAdvanceHolder))
		) AS Purchases
		{LEFT JOIN InformationRegister.AccountingDimensionByPartners AS PartnerAnalytics_
		ON Purchases.Partner = PartnerAnalytics_.Partner
			AND Purchases.Organization = PartnerAnalytics_.Organization
			AND Purchases.Counterparty = PartnerAnalytics_.Counterparty
			AND Purchases.Contract = PartnerAnalytics_.Contract}
WHERE
	Purchases.CountTurnover &lt;&gt; 0
		OR Purchases.CostTurnover &lt;&gt; 0
GROUP BY
	Purchases.Partner,
	Purchases.ItemsLocationAttributes.Products,
	Purchases.Recorder,
	Purchases.DayPeriod,
	Purchases.WeekPeriod,
	Purchases.TenDaysPeriod,
	Purchases.MonthPeriod,
	Purchases.QuarterPeriod,
	Purchases.HalfYearPeriod,
	Purchases.YearPeriod
{WHERE
	(Purchases.ItemsLocationAttributes.Products IN
			(SELECT
				SelectionByProductSegment.Products
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)),
	(PartnerAnalytics_.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
			
INDEX BY
	Products,
	Vendor
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ProcurementBasePeriod.Vendor AS Vendor,
	ProcurementBasePeriod.Products AS Products,
	Purchases.DayPeriod AS DayPeriod,
	Purchases.WeekPeriod AS WeekPeriod,
	Purchases.TenDaysPeriod AS TenDaysPeriod,
	Purchases.MonthPeriod AS MonthPeriod,
	Purchases.QuarterPeriod AS QuarterPeriod,
	Purchases.HalfYearPeriod AS HalfYearPeriod,
	Purchases.YearPeriod AS YearPeriod,
	ProcurementBasePeriod.PurchasedQuantityBase AS PurchasedQuantityBase,
	ProcurementBasePeriod.PurchaseCostBase AS PurchaseCostBase,
	Purchases.PurchasedQuantity AS PurchasedQuantity,
	Purchases.PurchaseCost AS PurchaseCost,
	Purchases.DocumentPurchases AS DocumentPurchases
{SELECT
	Vendor.*,
	Products.*,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	PurchasedQuantityBase,
	PurchaseCostBase,
	PurchasedQuantity,
	PurchaseCost,
	DocumentPurchases.*}
FROM
	ProcurementBasePeriod AS ProcurementBasePeriod
		LEFT JOIN Purchases AS Purchases
		ON ProcurementBasePeriod.Products = Purchases.Products
			AND ProcurementBasePeriod.Vendor = Purchases.Vendor
{WHERE
	ProcurementBasePeriod.Vendor.*,
	ProcurementBasePeriod.Products.*,
	Purchases.DayPeriod,
	Purchases.WeekPeriod,
	Purchases.TenDaysPeriod,
	Purchases.MonthPeriod,
	Purchases.QuarterPeriod,
	Purchases.HalfYearPeriod,
	Purchases.YearPeriod,
	ProcurementBasePeriod.PurchasedQuantityBase,
	ProcurementBasePeriod.PurchaseCostBase,
	Purchases.PurchasedQuantity,
	Purchases.PurchaseCost,
	Purchases.DocumentPurchases.*}</query>
	</dataSet>
