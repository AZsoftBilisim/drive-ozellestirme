		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	ReceivedReturnablePackagingBalanceAndTurnovers.Products,
	ReceivedReturnablePackagingBalanceAndTurnovers.Characteristic,
	ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow,
	ReceivedReturnablePackagingBalanceAndTurnovers.DocumentInflow.Currency AS Currency,
	ReceivedReturnablePackagingBalanceAndTurnovers.CountClosingBalance,
	ReceivedReturnablePackagingBalanceAndTurnovers.SumClosingBalance,
	ReceivedReturnablePackagingBalanceAndTurnovers.Recorder,
	ReceivedReturnablePackagingBalanceAndTurnovers.Period
FROM
	AccumulationRegister.ReceivedReturnablePackaging.BalanceAndTurnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Recorder, RegisterRecords, ) AS ReceivedReturnablePackagingBalanceAndTurnovers</query>
	</dataSet>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Sum(CountClosingBalance)</expression>
		<group>Currency</group>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Period</group>
		<group>Recorder</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>SumClosingBalance</dataPath>
		<expression>Sum(SumClosingBalance)</expression>
		<group>Currency</group>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>Period</group>
		<group>Recorder</group>
		<group>Characteristic</group>
		<group>Overall</group>
	</totalField>
