		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	StorageBinsLocks.Cell AS Cell,
	StorageBinsLocks.Cell.Owner AS Warehouse,
	StorageBinsLocks.Cell.Premise AS Premise,
	StorageBinsLocks.LockType AS LockType,
	StorageBinsLocks.Recorder AS DocumentLocks
FROM
	InformationRegister.StorageBinsLocks AS StorageBinsLocks
</query>
