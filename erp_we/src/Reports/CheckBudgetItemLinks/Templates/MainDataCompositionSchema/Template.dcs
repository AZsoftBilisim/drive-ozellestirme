	<calculatedField>
		<dataPath>FinalRemainderByRules</dataPath>
		<expression>Case When &amp;Factor = "Count" Then QuantityClosingBalanceByRules Else AmountClosingBalanceAccordingToRules End</expression>
		<title xsi:type="v8:LocalStringType">
