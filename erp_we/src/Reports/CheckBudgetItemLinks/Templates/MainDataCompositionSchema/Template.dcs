				<dcscor:value xsi:type="xs:decimal">16</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>FinalBalanceOnTurnoverOfArticles</dataPath>
		<expression>0</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Closing balance by item turnovers</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>مانده اختتامیه بر اساس گردش‌های قلم</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Saldi alla fine per numero di articoli</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Saldo na koniec według obrotów pozycji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сальдо на конец по оборотам статей</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Kalemlerin devirlerine göre kapanış bakiyesi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Dư cuối kỳ theo khoản mục phát sinh</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<group>true</group>
		</useRestriction>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MarkNegatives</dcscor:parameter>
				<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>MinWidth</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">16</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>StartBalanceAccordingToRules</dataPath>
		<expression>Sum(StartBalanceAccordingToRules)</expression>
	</totalField>
	<totalField>
		<dataPath>ReceiptByItemTurnovers</dataPath>
		<expression>Sum(ReceiptByItemTurnovers)</expression>
	</totalField>
	<totalField>
		<dataPath>ItemTurnoverExpenses</dataPath>
		<expression>Sum(ItemTurnoverExpenses)</expression>
	</totalField>
	<totalField>
		<dataPath>FinalBalanceOnTurnoverOfArticles</dataPath>
		<expression>IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(ReceiptByItemTurnovers),0) - IsNull(Sum(ItemTurnoverExpenses),0)</expression>
	</totalField>
	<totalField>
		<dataPath>Deviation</dataPath>
		<expression>IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(ReceiptByItemTurnovers),0) - IsNull(Sum(ItemTurnoverExpenses),0) - IsNull(Sum(FinalRemainderByRules),0)</expression>
	</totalField>
	<totalField>
		<dataPath>VariancePercentage</dataPath>
		<expression>Case 
	When IsNull(Sum(FinalRemainderByRules),0) = 0 And (IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(ReceiptByItemTurnovers),0) - IsNull(Sum(ItemTurnoverExpenses),0)) = 0
		Then 0
	When IsNull(Sum(FinalRemainderByRules),0) = 0 
		Then 1
	When (IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(ReceiptByItemTurnovers),0) - IsNull(Sum(ItemTurnoverExpenses),0) - Sum(FinalRemainderByRules)) / Sum(FinalRemainderByRules) &lt; 0
		Then -(IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(ReceiptByItemTurnovers),0) - IsNull(Sum(ItemTurnoverExpenses),0) - Sum(FinalRemainderByRules)) / Sum(FinalRemainderByRules)
	Else (IsNull(Sum(StartBalanceAccordingToRules),0) + IsNull(Sum(ReceiptByItemTurnovers),0) - IsNull(Sum(ItemTurnoverExpenses),0) - Sum(FinalRemainderByRules)) / Sum(FinalRemainderByRules)
End * 100</expression>
	</totalField>
	<totalField>
		<dataPath>FinalRemainderByRules</dataPath>
		<expression>Sum(FinalRemainderByRules)</expression>
	</totalField>
