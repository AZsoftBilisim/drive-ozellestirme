		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	Products,
	Characteristic,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	ProductRange.Products AS Products,
	ProductRange.PlanningObject AS PlanningObject,
	TRUE AS FilterByProductRangeIsUsed
INTO SelectionByAssortment
FROM
	InformationRegister.ProductRange.SliceLast(&amp;Period, ) AS ProductRange
{WHERE
	ProductRange.Products.* AS Products,
	ProductRange.PlanningObject.* AS PlanningObject,
	ProductRange.ItemsCollection.* AS ItemsCollection,
	ProductRange.SalesAreAllowed AS SalesAreAllowed}

INDEX BY
	Products,
	PlanningObject,
	FilterByProductRangeIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	Inventories.Products AS Products,
	Inventories.Characteristic AS Characteristic,
	Inventories.Warehouse AS Warehouse,
	Inventories.Purpose AS Purpose,
	Inventories.InStockBalance AS InStockBalance,
	Inventories.LockedInStockBalance AS LockedInStockBalance,
	Inventories.OrderedBalance AS OrderedBalance,
	Inventories.Received_1Balance AS Received_1Balance,
	Inventories.LockedReceiptBalance AS LockedReceiptBalance,
	Inventories.ReserveAtWarehouseBalance AS ReserveAtWarehouseBalance,
	Inventories.ReserveAsReceivedBalance AS ReserveAsReceivedBalance,
	Inventories.SnoozeReservationBalance AS SnoozeReservationBalance,
	Inventories.ToSupplyBalance AS ToSupplyBalance,
	Inventories.NotProvideBalance AS NotProvideBalance
INTO InventoryAndDemandsBalance
FROM
	AccumulationRegister.InventoryAndDemands.Balance(,
		Purpose = VALUE(Catalog.Assignments.EmptyRef)) AS Inventories
;

///////////////////////////////////////////////////////
SELECT
	CAST(Calculation.Products AS Catalog.Products) AS Products,
	Calculation.Characteristic AS Characteristic,
	Calculation.Warehouse AS Warehouse,
	Calculation.QuantityForShipAction AS Balance
INTO FreeBalancesFromRegisters
FROM
	CalculationOfBalancesForSettingActions AS Calculation
WHERE
	Calculation.QuantityForShipAction &gt; 0
INDEX BY
	Products, Characteristic, Warehouse
;

////////////////////////////////////////////////////////////////////////////////
DROP InventoryAndDemandsBalance
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	WarehouseStockBalance.Products AS Products,
	WarehouseStockBalance.Characteristic AS Characteristic,
	WarehouseStockBalance.Warehouse AS Warehouse,
	WarehouseStockBalance.Balance AS Balance,
	ProductRestrictions.SafetyStockQuantity AS SafetyStockQuantity,
	ProductRestrictions.MinimumInventoryQuantity AS MinimumInventoryQuantity,
	ProductRestrictions.MaximumInventoryAmount AS MaximumInventoryAmount,
	ProductRestrictions.InventoryReplenishmentMethod AS InventoryReplenishmentMethod
INTO AvailableStock
FROM
	FreeBalancesFromRegisters AS WarehouseStockBalance
		LEFT JOIN InformationRegister.ProductRestrictions AS ProductRestrictions
		ON &amp;SubstituteGoodsRestriction
WHERE
	WarehouseStockBalance.Products.ItemsType IN(
		VALUE(Enum.ItemsTypes.OwnGoods),
		VALUE(Enum.ItemsTypes.ReusablePackage))
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Sets.Owner AS Set,
	SetComponents.Ref AS Components,
	SUM(SetComponents.CostShare) AS SumOfCostShares
INTO SetShares
FROM
	Catalog.ProductKitConfigurations AS Sets
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS SetComponents
		ON Sets.Ref = SetComponents.Ref
WHERE
	NOT Sets.DeletionMark
	AND NOT Sets.Owner.DeletionMark
	AND Sets.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToShares)
	AND &amp;SetsAreDisplayed
GROUP BY
	Sets.Owner,
	SetComponents.Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Sets.Owner AS Set,
	SetComponents.Ref AS Components,
	ItemPricesCrossSectionOfTheLatest.PriceKind AS PriceKind,
	SUM(ItemPricesCrossSectionOfTheLatest.Price) AS SumOfComponentPrices,
	COUNT(DISTINCT ItemPricesCrossSectionOfTheLatest.Currency) AS NumberOfCurrencies
INTO SetsDistributionByPrice
FROM
	Catalog.ProductKitConfigurations AS Sets
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS SetComponents
		ON Sets.Ref = SetComponents.Ref
		LEFT JOIN InformationRegister.ItemsPrices.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices)) AS ItemPricesCrossSectionOfTheLatest
		ON (SetComponents.Products = ItemPricesCrossSectionOfTheLatest.Products)
			AND (SetComponents.Characteristic = ItemPricesCrossSectionOfTheLatest.Characteristic)
WHERE
	NOT Sets.DeletionMark
	AND NOT Sets.Owner.DeletionMark
	AND Sets.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToPrices)
	AND &amp;SetsAreDisplayed

GROUP BY
	Sets.Owner,
	SetComponents.Ref,
	ItemPricesCrossSectionOfTheLatest.PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AccessoriesNomeclaturePriceByComponents.Ref.Owner AS SetOfProducts,
	ISNULL(AccessoriesNomeclaturePriceByComponents.Count, 0) AS QuantityInSet,
	ISNULL(AccessoriesNomeclaturePriceByComponents.Count, 0) * ItemPricesCrossSectionOfTheLatest.Price AS SetPrice,
	ItemPricesCrossSectionOfTheLatest.Products AS Products,
	ItemPricesCrossSectionOfTheLatest.Characteristic AS Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind AS PriceKind,
	ItemPricesCrossSectionOfTheLatest.Price AS Price,
	"" AS PriceByLine,
	CASE
		WHEN ItemPricesCrossSectionOfTheLatest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN ItemPricesCrossSectionOfTheLatest.Products.UnitOfMeasure
		ELSE ItemPricesCrossSectionOfTheLatest.Package
	END AS Package,
	ItemPricesCrossSectionOfTheLatest.Currency AS Currency,
	ItemPricesCrossSectionOfTheLatest.Products.PriceGroup AS PriceGroup,
	CASE
		WHEN ItemPricesCrossSectionOfTheLatest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN AvailableStock.Balance
		ELSE AvailableStock.Balance / &amp;QueryTextPackagingFactor
	END AS Balance,
	CASE
		WHEN AvailableStock.Balance &lt;= 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.OutOfStock)
		ELSE CASE
				WHEN AvailableStock.Balance &lt;= AvailableStock.MinimumInventoryQuantity
					THEN VALUE(Enum.GoodsAvailabilityForCustomer.SpecifyAvailability)
				ELSE CASE
						WHEN AvailableStock.Balance &lt; AvailableStock.SafetyStockQuantity + AvailableStock.MinimumInventoryQuantity
							THEN VALUE(Enum.GoodsAvailabilityForCustomer.Little)
						ELSE CASE
								WHEN AvailableStock.Balance &lt; AvailableStock.MaximumInventoryAmount
									THEN VALUE(Enum.GoodsAvailabilityForCustomer.Enough)
								ELSE CASE
										WHEN AvailableStock.Balance &gt;= AvailableStock.MaximumInventoryAmount
											THEN VALUE(Enum.GoodsAvailabilityForCustomer.Many)
										ELSE VALUE(Enum.GoodsAvailabilityForCustomer.Unknown)
									END
							END
					END
			END
	END AS RemainingBalance,
	AvailableStock.Warehouse AS Warehouse,
	AvailableStock.InventoryReplenishmentMethod AS InventoryReplenishmentMethod
INTO Prices
FROM
	InformationRegister.ItemsPrices.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices) {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (Products IN
			    (SELECT
			        SelectionByAssortment.Products
			    FROM
			        SelectionByAssortment
			    WHERE
			        SelectionByAssortment.FilterByProductRangeIsUsed = &amp;FilterByProductRangeIsUsed))}) AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN AvailableStock AS AvailableStock
		ON ItemPricesCrossSectionOfTheLatest.Products = AvailableStock.Products
			AND ItemPricesCrossSectionOfTheLatest.Characteristic = AvailableStock.Characteristic
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS AccessoriesNomeclaturePriceByComponents
		ON ItemPricesCrossSectionOfTheLatest.Products = AccessoriesNomeclaturePriceByComponents.Products
			AND ItemPricesCrossSectionOfTheLatest.Characteristic = AccessoriesNomeclaturePriceByComponents.Characteristic
			AND (ItemPricesCrossSectionOfTheLatest.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
					AND ItemPricesCrossSectionOfTheLatest.Products.UnitOfMeasure = AccessoriesNomeclaturePriceByComponents.Package
				OR ItemPricesCrossSectionOfTheLatest.Package = AccessoriesNomeclaturePriceByComponents.Package)
			AND (AccessoriesNomeclaturePriceByComponents.Ref.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.CaclulatesFromComponentPrices))
		LEFT JOIN Catalog.ProductKitConfigurations AS SetOfNomeclaturePriceBySet
		ON ItemPricesCrossSectionOfTheLatest.Products = SetOfNomeclaturePriceBySet.Owner
			AND (SetOfNomeclaturePriceBySet.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToPrices)
				OR SetOfNomeclaturePriceBySet.SetPricingOption = VALUE(Enum.SetPriceCalculationOptions.PriceAssignedForKitThenAllocatedToComponentsProportionallyToShares))
		{LEFT JOIN InformationRegister.ItemsPrices.SliceLast(&amp;Period, {(PriceKind) AS PriceTypeRange}) AS ProductPricesSelection
		ON ItemPricesCrossSectionOfTheLatest.Products = ProductPricesSelection.Products
			AND ItemPricesCrossSectionOfTheLatest.Characteristic = ProductPricesSelection.Characteristic}
WHERE
	ItemPricesCrossSectionOfTheLatest.Price &gt; 0
	AND SetOfNomeclaturePriceBySet.Ref IS NULL
{WHERE
	ProductPricesSelection.Price AS PriceFrom,
	ProductPricesSelection.Price AS PriceUpTo}

UNION ALL

SELECT
	SetShares.Set,
	KitComponentsPricesByKit.Count,
	CASE
		WHEN NOT SetShares.Set IS NULL
				AND SetShares.SumOfCostShares &gt; 0
			THEN ItemPricesCrossSectionOfTheLatest.Price * KitComponentsPricesByKit.CostShare / SetShares.SumOfCostShares
		ELSE 0
	END,
	KitComponentsPricesByKit.Products,
	KitComponentsPricesByKit.Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	CASE
		WHEN NOT SetShares.Set IS NULL
				AND SetShares.SumOfCostShares &gt; 0
				AND NOT KitComponentsPricesByKit.Products IS NULL
				AND KitComponentsPricesByKit.Count &gt; 0
			THEN ItemPricesCrossSectionOfTheLatest.Price * KitComponentsPricesByKit.CostShare / SetShares.SumOfCostShares / KitComponentsPricesByKit.Count
		ELSE 0
	END,
	"",
	CASE
		WHEN KitComponentsPricesByKit.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN KitComponentsPricesByKit.Products.UnitOfMeasure
		ELSE KitComponentsPricesByKit.Package
	END,
	ItemPricesCrossSectionOfTheLatest.Currency,
	ItemPricesCrossSectionOfTheLatest.Products.PriceGroup,
	CASE
		WHEN KitComponentsPricesByKit.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN AvailableStock.Balance
		ELSE AvailableStock.Balance / &amp;QueryTextSecondPackingFactor
	END,
	CASE
		WHEN AvailableStock.Balance &lt;= 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.OutOfStock)
		ELSE CASE
				WHEN AvailableStock.Balance &lt;= AvailableStock.MinimumInventoryQuantity
					THEN VALUE(Enum.GoodsAvailabilityForCustomer.SpecifyAvailability)
				ELSE CASE
						WHEN AvailableStock.Balance &lt; AvailableStock.SafetyStockQuantity + AvailableStock.MinimumInventoryQuantity
							THEN VALUE(Enum.GoodsAvailabilityForCustomer.Little)
						ELSE CASE
								WHEN AvailableStock.Balance &lt; AvailableStock.MaximumInventoryAmount
									THEN VALUE(Enum.GoodsAvailabilityForCustomer.Enough)
								ELSE CASE
										WHEN AvailableStock.Balance &gt;= AvailableStock.MaximumInventoryAmount
											THEN VALUE(Enum.GoodsAvailabilityForCustomer.Many)
										ELSE VALUE(Enum.GoodsAvailabilityForCustomer.Unknown)
									END
							END
					END
			END
	END,
	AvailableStock.Warehouse,
	AvailableStock.InventoryReplenishmentMethod
FROM
	InformationRegister.ItemsPrices.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices) {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (Products IN
			    (SELECT
			        SelectionByAssortment.Products
			    FROM
			        SelectionByAssortment
			    WHERE
			        SelectionByAssortment.FilterByProductRangeIsUsed = &amp;FilterByProductRangeIsUsed)), (Products IN
			    (SELECT
			        SetShares.Set
			    FROM
			        SetShares))}) AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN SetShares AS SetShares
		ON ItemPricesCrossSectionOfTheLatest.Products = SetShares.Set
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS KitComponentsPricesByKit
		ON (SetShares.Components = KitComponentsPricesByKit.Ref)
		LEFT JOIN AvailableStock AS AvailableStock
		ON (KitComponentsPricesByKit.Products = AvailableStock.Products)
			AND (KitComponentsPricesByKit.Characteristic = AvailableStock.Characteristic)
		{LEFT JOIN InformationRegister.ItemsPrices.SliceLast(&amp;Period, {(PriceKind) AS PriceTypeRange}) AS ProductPricesSelection
		ON ItemPricesCrossSectionOfTheLatest.Products = ProductPricesSelection.Products
			AND ItemPricesCrossSectionOfTheLatest.Characteristic = ProductPricesSelection.Characteristic}
WHERE
	ItemPricesCrossSectionOfTheLatest.Price &gt; 0
	AND SetShares.Set IS NOT NULL 
{WHERE
	ProductPricesSelection.Price AS PriceFrom,
	ProductPricesSelection.Price AS PriceUpTo}

UNION ALL

SELECT
	SetsDistributionByPrice.Set,
	KitComponentsPricesByKit.Count,
	CASE
		WHEN NOT SetsDistributionByPrice.Set IS NULL
				AND SetsDistributionByPrice.SumOfComponentPrices &gt; 0
			THEN ItemPricesCrossSectionOfTheLatest.Price * PricesOfComponentProductsCrossSection.Price / SetsDistributionByPrice.SumOfComponentPrices
		ELSE 0
	END,
	KitComponentsPricesByKit.Products,
	KitComponentsPricesByKit.Characteristic,
	ItemPricesCrossSectionOfTheLatest.PriceKind,
	CASE
		WHEN SetsDistributionByPrice.NumberOfCurrencies = 1
				AND NOT SetsDistributionByPrice.Set IS NULL
				AND SetsDistributionByPrice.SumOfComponentPrices &gt; 0
				AND NOT KitComponentsPricesByKit.Products IS NULL
				AND KitComponentsPricesByKit.Count &gt; 0
			THEN ItemPricesCrossSectionOfTheLatest.Price * PricesOfComponentProductsCrossSection.Price / SetsDistributionByPrice.SumOfComponentPrices / KitComponentsPricesByKit.Count
		ELSE 0
	END,
	CASE
		WHEN SetsDistributionByPrice.NumberOfCurrencies &gt; 1
			THEN "-"
		ELSE ""
	END,
	CASE
		WHEN KitComponentsPricesByKit.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN KitComponentsPricesByKit.Products.UnitOfMeasure
		ELSE KitComponentsPricesByKit.Package
	END,
	ItemPricesCrossSectionOfTheLatest.Currency,
	ItemPricesCrossSectionOfTheLatest.Products.PriceGroup,
	CASE
		WHEN KitComponentsPricesByKit.Package = VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef)
			THEN AvailableStock.Balance
		ELSE AvailableStock.Balance / &amp;QueryTextSecondPackingFactor
	END,
	CASE
		WHEN AvailableStock.Balance &lt;= 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.OutOfStock)
		ELSE CASE
				WHEN AvailableStock.Balance &lt;= AvailableStock.MinimumInventoryQuantity
					THEN VALUE(Enum.GoodsAvailabilityForCustomer.SpecifyAvailability)
				ELSE CASE
						WHEN AvailableStock.Balance &lt; AvailableStock.SafetyStockQuantity + AvailableStock.MinimumInventoryQuantity
							THEN VALUE(Enum.GoodsAvailabilityForCustomer.Little)
						ELSE CASE
								WHEN AvailableStock.Balance &lt; AvailableStock.MaximumInventoryAmount
									THEN VALUE(Enum.GoodsAvailabilityForCustomer.Enough)
								ELSE CASE
										WHEN AvailableStock.Balance &gt;= AvailableStock.MaximumInventoryAmount
											THEN VALUE(Enum.GoodsAvailabilityForCustomer.Many)
										ELSE VALUE(Enum.GoodsAvailabilityForCustomer.Unknown)
									END
							END
					END
			END
	END,
	AvailableStock.Warehouse,
	AvailableStock.InventoryReplenishmentMethod
FROM
	InformationRegister.ItemsPrices.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices) {((Products, Characteristic) IN
			    (SELECT
			        SelectionByProductSegment.Products,
			        SelectionByProductSegment.Characteristic
			    FROM
			        SelectionByProductSegment
			    WHERE
			        SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed)), (Products IN
			    (SELECT
			        SelectionByAssortment.Products
			    FROM
			        SelectionByAssortment
			    WHERE
			        SelectionByAssortment.FilterByProductRangeIsUsed = &amp;FilterByProductRangeIsUsed)), (Products IN
			    (SELECT
			        SetsDistributionByPrice.Set
			    FROM
			        SetsDistributionByPrice))}) AS ItemPricesCrossSectionOfTheLatest
		LEFT JOIN SetsDistributionByPrice AS SetsDistributionByPrice
		ON ItemPricesCrossSectionOfTheLatest.Products = SetsDistributionByPrice.Set
		LEFT JOIN Catalog.ProductKitConfigurations.Goods AS KitComponentsPricesByKit
		ON (SetsDistributionByPrice.Components = KitComponentsPricesByKit.Ref)
			AND (ItemPricesCrossSectionOfTheLatest.PriceKind = SetsDistributionByPrice.PriceKind)
		LEFT JOIN InformationRegister.ItemsPrices.SliceLast(&amp;Period, PriceKind IN (&amp;TypesOfPrices)) AS PricesOfComponentProductsCrossSection
		ON (KitComponentsPricesByKit.Products = PricesOfComponentProductsCrossSection.Products)
			AND (KitComponentsPricesByKit.Characteristic = PricesOfComponentProductsCrossSection.Characteristic)
			AND ItemPricesCrossSectionOfTheLatest.PriceKind = PricesOfComponentProductsCrossSection.PriceKind
		LEFT JOIN AvailableStock AS AvailableStock
		ON (KitComponentsPricesByKit.Products = AvailableStock.Products)
			AND (KitComponentsPricesByKit.Characteristic = AvailableStock.Characteristic)
		{LEFT JOIN InformationRegister.ItemsPrices.SliceLast(&amp;Period, {(PriceKind) AS PriceTypeRange}) AS ProductPricesSelection
		ON ItemPricesCrossSectionOfTheLatest.Products = ProductPricesSelection.Products
			AND ItemPricesCrossSectionOfTheLatest.Characteristic = ProductPricesSelection.Characteristic}
WHERE
	PricesOfComponentProductsCrossSection.Price &gt; 0
	AND SetsDistributionByPrice.Set IS NOT NULL 
{WHERE
	ProductPricesSelection.Price AS PriceFrom,
	ProductPricesSelection.Price AS PriceUpTo}
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Prices.SetOfProducts AS SetOfProducts,
	Prices.QuantityInSet AS QuantityInSet,
	Prices.SetPrice AS SetPrice,
	CASE
		WHEN Prices.SetOfProducts IS NULL
			THEN 0
		ELSE 1
	END AS ComponentCounter,
	Prices.Products AS Products,
	Prices.Characteristic AS Characteristic,
	Prices.PriceKind AS PriceKind,
	CASE
		WHEN Prices.SetOfProducts IS NULL
				AND Prices.PriceByLine = "-"
			THEN Prices.PriceByLine
		ELSE Prices.Price
	END AS Price,
	Prices.Package AS Package,
	Prices.Currency AS Currency,
	Prices.PriceGroup AS PriceGroup,
	Prices.Warehouse AS Warehouse,
	CASE
		WHEN Prices.Balance &lt; 0
			THEN 0
		ELSE Prices.Balance
	END AS Balance,
	CASE
		WHEN Prices.InventoryReplenishmentMethod = VALUE(Enum.InventoryReplenishmentMethods.OrderAgainstOrder)
				OR Prices.InventoryReplenishmentMethod IS NULL
					AND Prices.Balance &gt; 0
			THEN VALUE(Enum.GoodsAvailabilityForCustomer.AgainstOrder)
		ELSE Prices.RemainingBalance
	END AS RemainingBalance
{SELECT
	Products.*,
	Characteristic.*,
	PriceKind.*,
	Price,
	Package.*,
	Currency.*,
	PriceGroup.*,
	Warehouse.*}
FROM
	Prices AS Prices
{WHERE
	Prices.Products.*,
	Prices.Characteristic.*,
	Prices.PriceKind.*,
	Prices.Price,
	Prices.Package.*,
	Prices.Currency.*,
	Prices.Warehouse.*}</query>
	</dataSet>
	<totalField>
		<dataPath>Currency</dataPath>
		<expression>Max(Currency)</expression>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Case When Count(Distinct Price) = 1 Then Max(Price) Else Undefined End</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Sum(Balance)</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>RemainingBalance</dataPath>
		<expression>Case When Count(Distinct RemainingBalance) = 1 Then Max(RemainingBalance) Else Undefined End</expression>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Case When Sum(ComponentCounter)&gt;0 And Count(Distinct Currency)&gt;1 Then "-" 
Else Case When Count(Distinct Warehouse)&gt;0 And Sum(ComponentCounter)/Count(Distinct Warehouse)&gt;1 Then Sum(SetPrice)/Count(Distinct Warehouse) 
Else Case When Count(Distinct Warehouse)=0 And Sum(ComponentCounter)&gt;1 Then Sum(SetPrice) 
Else Case When Count(Distinct Price) = 1 Then Max(Price) Else Undefined End End End End</expression>
		<group>SetOfProducts</group>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>0</expression>
		<group>Products Hierarchy</group>
		<group>SetOfProducts Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>0</expression>
		<group>Products Hierarchy</group>
		<group>SetOfProducts Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>RemainingBalance</dataPath>
		<expression>0</expression>
		<group>Products Hierarchy</group>
		<group>SetOfProducts Hierarchy</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Case When Sum(ComponentCounter)&gt;0 And Count(Distinct Balance) = 1 Then Max(Balance) Else Undefined End
</expression>
		<group>SetOfProducts</group>
	</totalField>
	<totalField>
		<dataPath>RemainingBalance</dataPath>
		<expression>Case When Sum(ComponentCounter)&gt;0 And Count(Distinct Balance) = 1 Then Max(RemainingBalance) Else Undefined End
</expression>
		<group>SetOfProducts</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Case When Count(Distinct Balance) = 1 Then Max(Balance) Else Undefined End</expression>
		<group>Warehouse</group>
	</totalField>
	<parameter>
		<name>ReportDate</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Report date</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تاریخ گزارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Data del report</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Data sprawozdania</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
