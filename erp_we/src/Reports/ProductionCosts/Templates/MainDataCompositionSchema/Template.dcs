				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>In valuta della contabilità gestionale con IVA</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>W walucie zarz. ewidencji z VAT</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>В валюте упр. учета с НДС</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>KDV dahil yönetim muhasebesi para birimi cinsinden</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Theo tiền tệ kế toán quản trị gồm thuế GTGT</v8:content>
				</v8:item>
			</presentation>
