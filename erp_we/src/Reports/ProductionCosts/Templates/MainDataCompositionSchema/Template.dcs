			<dataSource>DataSource1</dataSource>
			<query>SELECT
	"" AS Table,
	"" AS Content,
	VALUE(Catalog.Companies.EmptyRef)                AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef)       AS Department,
	VALUE(Catalog.BusinessStructure.EmptyRef)       AS Sender,
	VALUE(Catalog.BusinessStructure.EmptyRef)       AS Recipient,
	VALUE(Catalog.BusinessStructure.EmptyRef)       AS WarehouseDivision,
	UNDEFINED                                                 AS Recorder,
	
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	UNDEFINED                                                 AS DimensionOfExpenses,
	VALUE(Catalog.LinesOfBusiness.EmptyRef)    AS LineOfBusiness,
	VALUE(Catalog.ProductionLots.EmptyRef)         AS ProductionLot,
	UNDEFINED                                                 AS ProductionOrder,

	0 AS InitialBalanceCost,
	0 AS InitialBalanceOfPD,
	0 AS InitialBalanceOfTD,
	
	0 AS ReceivedCost,
	0 AS ReceivedPD,
	0 AS TDHasBeenReceived,
	
	0 AS SpentOnProductionCost,
	0 AS SpentOnProductionOfPD,
	0 AS SpentOnProductionOfTD,
	
	0 AS OtherWriteOffCost,
	0 AS OtherWriteOffOfPD,
	0 AS OtherWriteOffsOfTD,
	
	0 AS TransitBetweenHIACost,
	0 AS TransitBetweenOVZPR,
	0 AS TransitBetweenHIA_,
	
	0 AS FinalRemainderCost,
	0 AS FinalBalanceOfPD,
	0 AS FinalBalanceOfTD
{WHERE
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
	VALUE(Catalog.BusinessStructure.EmptyRef) AS Department,
	VALUE(ChartOfCharacteristicTypes.ExpenseItems.EmptyRef) AS ExpenseItem,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.ProductCostElements.EmptyRef) AS ProductCostElement,
	VALUE(Catalog.ProductionLots.EmptyRef) AS ProductionLot}</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>Order</dataPath>
		<expression>Case When Cast(WarehouseDivision, "Catalog.Warehouses") Is NULL   
Then 2 
Else 
1
End </expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Sequence</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>توالی</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
