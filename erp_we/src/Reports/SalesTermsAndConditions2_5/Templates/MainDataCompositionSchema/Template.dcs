		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	SegmentPartners.Segment AS Segment
INTO SegmentPartners
FROM
	InformationRegister.SegmentPartners AS SegmentPartners
{WHERE
	(SegmentPartners.Partner = &amp;Partner)}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AgreementWithCustomerHeader.Ref AS AgreementLink,
	AgreementWithCustomerHeader.Description AS AgreementName,
	AgreementWithCustomerHeader.Currency AS AgreementCurrency_,
	AgreementWithCustomerHeader.PricesKind AS AgreementTypeOfPrices,
	AgreementWithCustomerHeader.SpecialPriceType AS SpecialPriceType,
	AgreementWithCustomerHeader.PaymentSchedule AS AgreementPaymentSchedule_,
	AgreementWithCustomerHeader.ValidityStartDate AS AgreementEffectiveDate,
	AgreementWithCustomerHeader.ValidityEndDate AS AgreementExpirationDate,
	AgreementWithCustomerHeader.Partner AS TermsPartner,
	AgreementWithCustomerHeader.Counterparty AS AgreementCounterparty,
	AgreementWithCustomerHeader.PartnersSegment AS PartnerSegmentAgreement,
	AgreementWithCustomerHeader.Organization AS AgreementOrganization,
	AgreementWithCustomerHeader.BusinessOperation AS AgreementBusinessTransaction,
	AgreementWithCustomerHeader.PriceIncludesVAT AS AgreementPriceIncludesVAT,
	AgreementWithCustomerHeader.Warehouse AS AgreementWarehouse,
	AgreementWithCustomerHeader.DeliveryPeriodDays AS AgreementDeliveryTime,
	AgreementWithCustomerHeader.ProductSegment AS AgreementProductSegment,
	AgreementWithCustomerHeader.Manager AS AgreementManager,
	AgreementWithCustomerHeader.Frequent AS AgreementRegular,
	AgreementWithCustomerHeader.Period AS AgreementPeriod,
	AgreementWithCustomerHeader.NumberOfPeriods AS AgreementNumberOfPeriods,
	AgreementWithCustomerHeader.KeepCommissionFee AS AgreementToWithholdRemuneration,
	AgreementWithCustomerHeader.RemunerationPercentage AS AgreementPercentageOfRemuneration
FROM
	Catalog.TermsOfSale AS AgreementWithCustomerHeader
WHERE
	NOT AgreementWithCustomerHeader.DeletionMark
	AND AgreementWithCustomerHeader.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)
{WHERE
	(AgreementWithCustomerHeader.Ref IN (&amp;Document)),
	(AgreementWithCustomerHeader.Standard_ = &amp;OnlyStandard),
	(AgreementWithCustomerHeader.Partner = &amp;Partner
			OR AgreementWithCustomerHeader.PartnersSegment IN
				(SELECT
					SegmentPartners.Segment AS PartnersSegment
				FROM
					SegmentPartners AS SegmentPartners))}</query>
	</dataSet>
	<totalField>
		<dataPath>PriceKind</dataPath>
		<expression>Min(PriceKind)</expression>
	</totalField>
	<totalField>
		<dataPath>Price</dataPath>
		<expression>Min(Price)</expression>
	</totalField>
	<totalField>
		<dataPath>ThisIsIndividualTypeOfPrices</dataPath>
		<expression>Max(ThisIsIndividualTypeOfPrices)</expression>
	</totalField>
