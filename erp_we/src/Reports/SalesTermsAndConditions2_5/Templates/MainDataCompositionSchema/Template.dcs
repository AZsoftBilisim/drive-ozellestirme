		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Products AS Products,
	Segments.Characteristic AS Characteristic,
	Segments.Characteristic.ItemsCharacteristicForPricing AS PricingVariant,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic,
	Segments.Characteristic.ItemsCharacteristicForPricing.* AS PricingVariant}

INDEX BY
	Products,
	Characteristic,
	Segments.Characteristic.ItemsCharacteristicForPricing,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO CurrencyRatesCut
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(, BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut

INDEX BY
	Currency
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SegmentPartners.Segment AS Segment
INTO SegmentPartners
FROM
	InformationRegister.SegmentPartners AS SegmentPartners
{WHERE
	(SegmentPartners.Partner = &amp;Partner)}
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AgreementWithCustomerHeader.Ref AS Terms,
	AgreementWithCustomerHeader.PricesKind AS PricesKind,
	AgreementWithCustomerHeader.SpecialPriceType AS IndividualTypeOfPrices,
	AgreementWithCustomerHeader.Currency AS Currency
INTO AgreementWithCustomerHeader
FROM
	Catalog.TermsOfSale AS AgreementWithCustomerHeader
{WHERE
	(AgreementWithCustomerHeader.Ref IN (&amp;Document)),
	(AgreementWithCustomerHeader.Standard_ = &amp;OnlyStandard
			AND NOT AgreementWithCustomerHeader.DeletionMark
			AND AgreementWithCustomerHeader.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid)),
	((AgreementWithCustomerHeader.Partner = &amp;Partner
			OR AgreementWithCustomerHeader.PartnersSegment IN
				(SELECT
					SegmentPartners.Segment AS PartnersSegment
				FROM
					SegmentPartners AS SegmentPartners))
			AND NOT AgreementWithCustomerHeader.DeletionMark
			AND AgreementWithCustomerHeader.Status = VALUE(Enum.StatusesOfTermsOfSales.Valid))}

INDEX BY
	Terms,
	PricesKind,
	IndividualTypeOfPrices
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	ItemPricesCrossSectionOfTheLatest.Products AS Products,
	ItemPricesCrossSectionOfTheLatest.PricingVariant AS PricingVariant,
	ItemPricesCrossSectionOfTheLatest.PricingBatch AS PricingBatch,
	ItemPricesCrossSectionOfTheLatest.PricingPackage AS PricingPackage,
	ItemPricesCrossSectionOfTheLatest.PriceKind AS PriceKind,
	ItemPricesCrossSectionOfTheLatest.Currency AS Currency,
	ItemPricesCrossSectionOfTheLatest.Price AS Price,
	ItemPricesCrossSectionOfTheLatest.Package AS Package
INTO ItemsPrices
FROM
	InformationRegister.ItemsPrices25.SliceLast(
			{(ENDOFPERIOD(&amp;Period, DAY))},
			PriceKind IN
				(SELECT DISTINCT
					AgreementWithCustomerHeader.PricesKind
				FROM
					AgreementWithCustomerHeader AS AgreementWithCustomerHeader
			
				UNION
			
				SELECT DISTINCT
					AgreementWithCustomerHeader.IndividualTypeOfPrices
				FROM
					AgreementWithCustomerHeader AS AgreementWithCustomerHeader)) AS ItemPricesCrossSectionOfTheLatest

INDEX BY
	Products,
	PricingVariant,
	PricingBatch,
	PricingPackage,
	PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	NestedQuery.Terms AS Terms,
	NestedQuery.Products AS Products,
	NestedQuery.PricingVariant AS PricingVariant,
	NestedQuery.PricingBatch AS PricingBatch,
	NestedQuery.PricingPackage AS PricingPackage,
	MIN(CASE
			WHEN NestedQuery.SpecialPriceType IS NULL
				THEN NestedQuery.PriceKind
			ELSE NestedQuery.SpecialPriceType
		END) AS PriceKind,
	MAX(NestedQuery.ThisIsIndividualTypeOfPrices) AS ThisIsIndividualTypeOfPrices
INTO FinalTypesOfPricesUnderAgreements
FROM
	(SELECT
		AgreementWithCustomerHeader.Terms AS Terms,
		ItemsPrices.Products AS Products,
		ItemsPrices.PricingVariant AS PricingVariant,
		ItemsPrices.PricingBatch AS PricingBatch,
		ItemsPrices.PricingPackage AS PricingPackage,
		ItemsPrices.PriceKind AS PriceKind,
		NULL AS SpecialPriceType,
		FALSE AS ThisIsIndividualTypeOfPrices
	FROM
		AgreementWithCustomerHeader AS AgreementWithCustomerHeader
			INNER JOIN ItemsPrices AS ItemsPrices
			ON AgreementWithCustomerHeader.PricesKind = ItemsPrices.PriceKind
	
	UNION ALL
	
	SELECT
		AgreementWithCustomerHeader.Terms,
		ItemsPrices.Products,
		ItemsPrices.PricingVariant,
		ItemsPrices.PricingBatch,
		ItemsPrices.PricingPackage,
		NULL,
		ItemsPrices.PriceKind,
		TRUE
	FROM
		AgreementWithCustomerHeader AS AgreementWithCustomerHeader
			INNER JOIN ItemsPrices AS ItemsPrices
			ON AgreementWithCustomerHeader.IndividualTypeOfPrices = ItemsPrices.PriceKind) AS NestedQuery
{WHERE
	((NestedQuery.Products, NestedQuery.PricingVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}

GROUP BY
	NestedQuery.Terms,
	NestedQuery.Products,
	NestedQuery.PricingVariant,
	NestedQuery.PricingBatch,
	NestedQuery.PricingPackage

INDEX BY
	Terms,
	Products,
	PricingVariant,
	PricingBatch,
	PricingPackage,
	PriceKind
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	AgreementWithCustomerHeader.Terms AS Terms,
	ItemsPrices.Products AS Products,
	ItemsPrices.PricingVariant AS PricingVariant,
	ItemsPrices.PricingBatch AS PricingBatch,
	ItemsPrices.PricingPackage AS PricingPackage,
	ItemsPrices.PriceKind AS PriceKind,
	ItemsPrices.Currency AS Currency,
	CASE
		WHEN ItemsPrices.Currency = AgreementWithCustomerHeader.Currency
			THEN ItemsPrices.Price
		ELSE CAST(ISNULL(ItemsPrices.Price, 0) * CASE
					WHEN ISNULL(CrossSectionExchangeRates.CourseDenominator, 0) &gt; 0
							AND ISNULL(CrossSectionExchangeRates.CourseNumerator, 0) &gt; 0
							AND ISNULL(ExchangeRatesOfSlicePriceType.CourseDenominator, 0) &gt; 0
							AND ISNULL(ExchangeRatesOfSlicePriceType.CourseNumerator, 0) &gt; 0
						THEN ExchangeRatesOfSlicePriceType.CourseNumerator * CrossSectionExchangeRates.CourseDenominator / (CrossSectionExchangeRates.CourseNumerator * ExchangeRatesOfSlicePriceType.CourseDenominator)
					ELSE 0
				END AS NUMBER(31, 2))
	END AS Price,
	ItemsPrices.Package AS Package,
	FinalTypesOfPricesUnderAgreements.ThisIsIndividualTypeOfPrices AS ThisIsIndividualTypeOfPrices
FROM
	FinalTypesOfPricesUnderAgreements AS FinalTypesOfPricesUnderAgreements
		LEFT JOIN ItemsPrices AS ItemsPrices
		ON FinalTypesOfPricesUnderAgreements.PriceKind = ItemsPrices.PriceKind
			AND FinalTypesOfPricesUnderAgreements.Products = ItemsPrices.Products
			AND FinalTypesOfPricesUnderAgreements.PricingVariant = ItemsPrices.PricingVariant
			AND FinalTypesOfPricesUnderAgreements.PricingBatch = ItemsPrices.PricingBatch
			AND FinalTypesOfPricesUnderAgreements.PricingPackage = ItemsPrices.PricingPackage
		LEFT JOIN AgreementWithCustomerHeader AS AgreementWithCustomerHeader
		ON FinalTypesOfPricesUnderAgreements.Terms = AgreementWithCustomerHeader.Terms
		LEFT JOIN CurrencyRatesCut AS ExchangeRatesOfSlicePriceType
		ON (ExchangeRatesOfSlicePriceType.Currency = ItemsPrices.Currency)
		LEFT JOIN CurrencyRatesCut AS CrossSectionExchangeRates
		ON (CrossSectionExchangeRates.Currency = AgreementWithCustomerHeader.Currency)
{WHERE
	((ItemsPrices.Products, ItemsPrices.PricingVariant) IN
			(SELECT
				SelectionByProductSegment.Products,
				SelectionByProductSegment.PricingVariant
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))}</query>
	</dataSet>
