				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Результат</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Sonuç</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Kết quả</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	Job.Ref,
	Job.Date,
	Job.Completed,
	Job.Started,
	Job.Description,
	Job.Importance,
	Job.TaskDueDate,
	Job.SubjectOf,
	Job.Author,
	Job.CompletedOn,
	Job.IterationNumber,
	Job.Completed2,
	Job.Accepted,
	CASE
		WHEN Job.Completed
				AND Job.Completed2
			THEN 0
		WHEN Job.Completed
				AND (NOT Job.Completed2)
			THEN 1
		ELSE 2
	END AS Result
FROM
	BusinessProcess.Job AS Job
WHERE
	Job.SourceTask = VALUE(Task.PerformerTask.EmptyRef)	
{WHERE
	(Job.Completed = &amp;Completed),
	(Job.CompletedOn &gt;= &amp;PeriodBeginning
			OR Job.CompletedOn = DATETIME(1, 1, 1))}</query>
	</dataSet>
