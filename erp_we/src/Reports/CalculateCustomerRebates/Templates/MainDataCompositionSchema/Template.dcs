		<dataSource>DataSource1</dataSource>
		<query>SELECT
	DATETIME(1, 1, 1) AS Period,
	DATETIME(1, 1, 1) AS CalculationPeriod,
	ConditionsOfCustomerRebates.TermDocument AS ConditionOfRebateBonusIs,
	VALUE(Enum.TargetSalesIndicatorsOfRebatesByGoods.EmptyRef) AS GoodsIndicator,
	VALUE(Enum.ARAPAccountingDrilldownsOfRebatesParticipants.EmptyRef) AS PartyCountDetails,
	VALUE(Enum.RebatesFrequencies.EmptyRef) AS AccrualFrequency,
	VALUE(Enum.RebatesFrequencies.EmptyRef) AS ConditionFrequency,
	VALUE(Document.CustomerInvoice.EmptyRef) AS DocumentSales,
	ConditionsOfCustomerRebates.TermDocument.Organization AS Organization,
	CustomerRebatesCounterparties.Counterparty AS Counterparty,
	CustomerRebatesCounterparties.Partner AS Partner,
	VALUE(Catalog.CounterpartyContracts.EmptyRef) AS Contract,
	VALUE(Catalog.TermsOfSale.EmptyRef) AS Terms,
	VALUE(Catalog.Products.EmptyRef) AS Products,
	VALUE(Catalog.PackagesAndUnitsOfMeasure.EmptyRef) AS UnitOfMeasure,
	FALSE AS ItemVariantsAreUsed,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS CharacteristicsOfSalesPurchases,
	VALUE(Catalog.ItemsCharacteristics.EmptyRef) AS Characteristic,
	UNDEFINED AS PropertyValue,
	0 AS RangeNumber,
	"" AS PresentationOfRangeUnit,
	0 AS RangeFrom,
	0 AS RangeBy,
	FALSE AS RestrictAccrualOverPlan,
	FALSE AS PlanIsFulfilled,
	VALUE(Catalog.Currencies.EmptyRef) AS Currency,
	0 AS BasePrice,
	0 AS SalesAmount,
	0 AS RevenueAmount,
	0 AS RevenueAmountExcludingVAT,
	0 AS QuantitySales,
	0 AS AmountInBasePrices,
	0 AS AmountBonus,
	0 AS SumPlan,
	0 AS CountPlan,
	0 AS PercentageBonus,
	0 AS CalculationBase,
	0 AS PackagesSold
{SELECT
	ConditionOfRebateBonusIs.*,
	Period,
	CalculationPeriod,
	GoodsIndicator,
	PartyCountDetails,
	AccrualFrequency,
	ConditionFrequency,
	RestrictAccrualOverPlan,
	DocumentSales.*,
	Organization.*,
	Counterparty.*,
	Partner.*,
	Contract.*,
	Terms.*,
	Products.*,
	UnitOfMeasure.*,
	ItemVariantsAreUsed,
	CharacteristicsOfSalesPurchases.*,
	Characteristic.*,
	PropertyValue,
	RangeNumber,
	PresentationOfRangeUnit,
	RangeFrom,
	RangeBy,
	PlanIsFulfilled,
	PercentageBonus,
	QuantitySales,
	Currency,
	BasePrice,
	SalesAmount,
	RevenueAmount,
	RevenueAmountExcludingVAT,
	AmountInBasePrices,
	AmountBonus,
	SumPlan,
	CountPlan,
	CalculationBase,
	PackagesSold}
FROM
	InformationRegister.CustomerRebatesConditions AS ConditionsOfCustomerRebates
		LEFT JOIN InformationRegister.CustomerRebatesCounterparties AS CustomerRebatesCounterparties
		ON ConditionsOfCustomerRebates.TermDocument = CustomerRebatesCounterparties.TermDocument
WHERE
	ConditionsOfCustomerRebates.TermDocument = &amp;DocumentTermsOfRetroBonuses
{WHERE
	VALUE(Document.CustomerInvoice.EmptyRef) AS DocumentSales,
	ConditionsOfCustomerRebates.TermDocument.Organization.* AS Organization,
	(VALUE(Catalog.Currencies.EmptyRef)).* AS Currency,
	CustomerRebatesCounterparties.Counterparty.*,
	CustomerRebatesCounterparties.Partner.*,
	(VALUE(Catalog.CounterpartyContracts.EmptyRef)).* AS Contract,
	(VALUE(Catalog.TermsOfSale.EmptyRef)).* AS Terms,
	DATETIME(1, 1, 1) AS CalculationPeriod,
	UNDEFINED AS PropertyValue,
	(VALUE(Catalog.Products.EmptyRef)).* AS Products,
	(VALUE(Catalog.ItemsCharacteristics.EmptyRef)).* AS Characteristic}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>AmountBonusTotal</dataPath>
		<expression/>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
