	</calculatedField>
	<totalField>
		<dataPath>QuantitySales</dataPath>
		<expression>Sum(QuantitySales)</expression>
		<group>PropertyValue</group>
		<group>Products</group>
	</totalField>
	<totalField>
		<dataPath>AmountInBasePrices</dataPath>
		<expression>Sum(AmountInBasePrices)</expression>
	</totalField>
	<totalField>
		<dataPath>SalesAmount</dataPath>
		<expression>Case
	When Count(Distinct Currency) &gt; 1
		Then 0
    Else Sum(SalesAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountBonus</dataPath>
		<expression>Case
	When Count(Distinct Currency) &gt; 1
		Then 0
    Else Sum(AmountBonus)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CalculationBase</dataPath>
		<expression>Case
	When Count(Distinct Currency) &gt; 1
		Then 0
    Else Sum(CalculationBase)
End</expression>
	</totalField>
	<totalField>
		<dataPath>RevenueAmount</dataPath>
		<expression>Case
	When Count(Distinct Currency) &gt; 1
		Then 0
    Else Sum(RevenueAmount)
End</expression>
	</totalField>
	<totalField>
		<dataPath>RevenueAmountExcludingVAT</dataPath>
		<expression>Case
	When Count(Distinct Currency) &gt; 1
		Then 0
    Else Sum(RevenueAmountExcludingVAT)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SalesAmount</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>QuantitySales</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>AmountInBasePrices</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>RevenueAmount</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>RevenueAmountExcludingVAT</dataPath>
		<expression>0</expression>
		<group>RangeFrom</group>
		<group>RangeBy</group>
		<group>RangeNumber</group>
	</totalField>
	<totalField>
		<dataPath>ItemVariantsAreUsed</dataPath>
		<expression>Max(ItemVariantsAreUsed)</expression>
		<group>Products</group>
	</totalField>
