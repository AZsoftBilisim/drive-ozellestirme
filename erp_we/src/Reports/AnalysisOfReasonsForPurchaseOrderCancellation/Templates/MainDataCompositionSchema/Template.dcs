				<v8:lang>vi</v8:lang>
				<v8:content>Số lượng dòng của đơn hàng</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>0</v8:Digits>
				<v8:FractionDigits>0</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>NumberOfCanceledLines</dataPath>
		<expression>Case When LineIsCanceled Then 1 Else 0 End</expression>
		<title xsi:type="v8:LocalStringType">
