		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>NumberOfOrderLines</dataPath>
		<expression>Sum(NumberOfOrderLines)</expression>
	</totalField>
	<totalField>
		<dataPath>NumberOfCanceledLines</dataPath>
		<expression>Sum(NumberOfCanceledLines)</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfCancellations</dataPath>
		<expression>100 * Case When EvalExpression(" Sum(NumberOfOrderLines)", "Partner") = 0 Then 0 Else Sum(NumberOfCanceledLines) / EvalExpression(" Sum(NumberOfOrderLines)", "Partner") End</expression>
	</totalField>
