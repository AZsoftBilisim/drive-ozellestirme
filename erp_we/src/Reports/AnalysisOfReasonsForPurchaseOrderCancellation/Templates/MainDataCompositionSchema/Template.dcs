<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>DataSource1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>DataSet1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Partner</dataPath>
			<field>Partner</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>CancellationReason</dataPath>
			<field>CancellationReason</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Cancellation reason</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>دلیل لغو</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Causa di annullamento</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Przyczyna anulowania</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Причина отмены</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>İptal sebebi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Nguyên nhân hủy bỏ</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PartnersSegment</dataPath>
			<field>PartnersSegment</field>
			<inputParameters>
				<dcscor:item>
					<dcscor:parameter>ChoiceParameters</dcscor:parameter>
					<dcscor:value xsi:type="dcscor:ChoiceParameters">
						<dcscor:item>
							<dcscor:choiceParameter>Filter.GenerationMethod</dcscor:choiceParameter>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.UpdateRegularly</dcscor:value>
							<dcscor:value xsi:type="dcscor:DesignTimeValue">Enum.SegmentGenerationMethods.GenerateManually</dcscor:value>
						</dcscor:item>
					</dcscor:value>
				</dcscor:item>
			</inputParameters>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>PurchaseOrder</dataPath>
			<field>PurchaseOrder</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>RowCode</dataPath>
			<field>RowCode</field>
			<useRestriction>
				<field>true</field>
				<group>true</group>
				<order>true</order>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>LineIsCanceled</dataPath>
			<field>LineIsCanceled</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Line is canceled</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>سطر لغو شده است</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>La riga è stata annullata</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Wiersz anulowany</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Строка отменена</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Satır iptal edildi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Dòng đã bị hủy bỏ</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	PurchaseOrders.PurchaseOrder AS PurchaseOrder,
	PurchaseOrders.RowCode AS RowCode,
	ISNULL(OrdersToSuppliersCanceledLines.CancellationReason, VALUE(Catalog.ReasonsForPurchaseOrderCancellation.EmptyRef)) AS CancellationReason,
	PurchaseOrders.PurchaseOrder.Partner AS Partner,
	CASE
		WHEN NOT OrdersToSuppliersCanceledLines.CancellationReason IS NULL 
			THEN TRUE
		ELSE FALSE
	END AS LineIsCanceled
{SELECT
	PurchaseOrder.*,
	RowCode,
	CancellationReason.*,
	Partner.*}
FROM
	AccumulationRegister.PurchaseOrders AS PurchaseOrders
		LEFT JOIN AccumulationRegister.PurchaseOrders AS OrdersToSuppliersCanceledLines
		ON PurchaseOrders.PurchaseOrder = OrdersToSuppliersCanceledLines.PurchaseOrder
			AND PurchaseOrders.RowCode = OrdersToSuppliersCanceledLines.RowCode
			AND (OrdersToSuppliersCanceledLines.Ordered &lt; 0)
WHERE
	PurchaseOrders.RecordType = VALUE(AccumulationRecordType.Receipt)
	AND PurchaseOrders.Ordered &gt; 0
	AND PurchaseOrders.Active
{WHERE
	(PurchaseOrders.PurchaseOrder.Partner IN
			(SELECT
				SelectionByPartnerSegment.Partner
			FROM
				SelectionByPartnerSegment
			WHERE
				SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed)),
	(PurchaseOrders.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod),
	PurchaseOrders.PurchaseOrder.Partner.* AS Partner,
	PurchaseOrders.PurchaseOrder.*,
	OrdersToSuppliersCanceledLines.CancellationReason.* AS CancellationReason}</query>
	</dataSet>
	<calculatedField>
		<dataPath>NumberOfOrderLines</dataPath>
		<expression>1</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Number of order lines</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تعداد سطرهای سفارش</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Numero di righe ordinate</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
