		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	VATRegisterRecordsTurnovers.Recorder AS Recorder, 
	VATRegisterRecordsTurnovers.DayPeriod AS DayPeriod,
	VATRegisterRecordsTurnovers.WeekPeriod AS WeekPeriod,
	VATRegisterRecordsTurnovers.TenDaysPeriod AS TenDaysPeriod,
	VATRegisterRecordsTurnovers.MonthPeriod AS MonthPeriod,
	VATRegisterRecordsTurnovers.QuarterPeriod AS QuarterPeriod,
	VATRegisterRecordsTurnovers.HalfYearPeriod AS HalfYearPeriod,
	VATRegisterRecordsTurnovers.YearPeriod AS YearPeriod,
	VATRegisterRecordsTurnovers.Organization AS Organization,
	VATRegisterRecordsTurnovers.EntryType AS EntryType,
	VATRegisterRecordsTurnovers.Counterparty AS Counterparty,
	VATRegisterRecordsTurnovers.TaxInvoice AS TaxInvoice,
	VATRegisterRecordsTurnovers.VATRate AS VATRate,
	VATRegisterRecordsTurnovers.AssetTaxClass AS AssetTaxClass,
	VATRegisterRecordsTurnovers.AmountExcludingVATTurnover AS AmountExcludingVAT,
	VATRegisterRecordsTurnovers.VATTurnover AS VAT,
	VATRegisterRecordsTurnovers.VATManagTurnover AS VATManag
INTO VATRegisterRecords
FROM
	AccumulationRegister.VATRegisterRecords.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto) AS VATRegisterRecordsTurnovers
INDEX BY
	TaxInvoice,
	Organization
;

SELECT  
	VATRegisterRecords.Recorder AS Recorder, 
	VATRegisterRecords.DayPeriod AS DayPeriod,
	VATRegisterRecords.WeekPeriod AS WeekPeriod,
	VATRegisterRecords.TenDaysPeriod AS TenDaysPeriod,
	VATRegisterRecords.MonthPeriod AS MonthPeriod,
	VATRegisterRecords.QuarterPeriod AS QuarterPeriod,
	VATRegisterRecords.HalfYearPeriod AS HalfYearPeriod,
	VATRegisterRecords.YearPeriod AS YearPeriod,
	VATRegisterRecords.Organization AS Organization,
	VATRegisterRecords.EntryType AS EntryType,
	VATRegisterRecords.Counterparty AS Counterparty,
	ISNULL(ReceivedTaxInvoicePrepayment.Ref, 
		ISNULL(IssuedTaxInvoicePrepayment.Ref, VATRegisterRecords.TaxInvoice)) AS TaxInvoice,
	VATRegisterRecords.VATRate AS VATRate,
	VATRegisterRecords.AssetTaxClass AS AssetTaxClass,
	VATRegisterRecords.AmountExcludingVAT AS AmountExcludingVAT,
	VATRegisterRecords.VAT AS VAT,
	VATRegisterRecords.VATManag AS VATManag,
	ISNULL(RegisterOfDocumentsInvoiceReceivedAdvance.SourceDocumentNumber, 
		ISNULL(RegisterOfDocumentsInvoiceIssuedAdvance.SourceDocumentNumber, DocumentsRegistry.SourceDocumentNumber)) AS Number,
	ISNULL(RegisterOfDocumentsInvoiceReceivedAdvance.SourceDocumentDate, 
		ISNULL(RegisterOfDocumentsInvoiceIssuedAdvance.SourceDocumentDate, DocumentsRegistry.SourceDocumentDate)) AS Date,
	ISNULL(RegisterOfDocumentsInvoiceReceivedAdvance.SourceDocumentName, 
		ISNULL(RegisterOfDocumentsInvoiceIssuedAdvance.SourceDocumentName, DocumentsRegistry.SourceDocumentName)) AS SourceDocumentName
FROM
	VATRegisterRecords AS VATRegisterRecords
	LEFT JOIN
		InformationRegister.DocumentsRegistry AS DocumentsRegistry
	ON
		VATRegisterRecords.Organization = DocumentsRegistry.Organization
		AND VATRegisterRecords.TaxInvoice = DocumentsRegistry.Ref
		AND NOT DocumentsRegistry.AdditionalRecord
	
	LEFT JOIN
		Document.ReceivedTaxInvoicePrepayment AS ReceivedTaxInvoicePrepayment
	ON
		ReceivedTaxInvoicePrepayment.DocumentBasis = VATRegisterRecords.TaxInvoice
		AND ReceivedTaxInvoicePrepayment.Posted
		AND VATRegisterRecords.AssetTaxClass IN (&amp;TypesOfValuesAdvances)
		
	LEFT JOIN
		InformationRegister.DocumentsRegistry AS RegisterOfDocumentsInvoiceReceivedAdvance
	ON
		ReceivedTaxInvoicePrepayment.Ref = RegisterOfDocumentsInvoiceReceivedAdvance.Ref
		AND NOT RegisterOfDocumentsInvoiceReceivedAdvance.AdditionalRecord
		
	LEFT JOIN
		Document.IssuedTaxInvoicePrepayment AS IssuedTaxInvoicePrepayment
	ON
		IssuedTaxInvoicePrepayment.DocumentBasis = VATRegisterRecords.TaxInvoice
		AND IssuedTaxInvoicePrepayment.Posted
		AND VATRegisterRecords.AssetTaxClass IN (&amp;TypesOfValuesAdvances)
	
	LEFT JOIN
		InformationRegister.DocumentsRegistry AS RegisterOfDocumentsInvoiceIssuedAdvance
	ON
		IssuedTaxInvoicePrepayment.Ref = RegisterOfDocumentsInvoiceIssuedAdvance.Ref
		AND NOT RegisterOfDocumentsInvoiceIssuedAdvance.AdditionalRecord
</query>
	</dataSet>
	<totalField>
		<dataPath>VAT</dataPath>
		<expression>Sum(
	Case When EntryType = &amp;RecordTypeOutgoing
		Then VAT
		Else -VAT
	End)</expression>
		<group>Organization</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>VATManag</dataPath>
		<expression>Sum(
	Case When EntryType = &amp;RecordTypeOutgoing
		Then VATManag
		Else -VATManag
	End)</expression>
		<group>Organization</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>AmountExcludingVAT</dataPath>
		<expression>Sum(
	Case When EntryType = &amp;RecordTypeOutgoing
		Then AmountExcludingVAT
		Else -AmountExcludingVAT
	End)</expression>
		<group>Organization</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>VAT</dataPath>
		<expression>Sum(VAT)</expression>
	</totalField>
	<totalField>
		<dataPath>VATManag</dataPath>
		<expression>Sum(VATManag)</expression>
	</totalField>
	<totalField>
		<dataPath>AmountExcludingVAT</dataPath>
		<expression>Sum(AmountExcludingVAT)</expression>
	</totalField>
