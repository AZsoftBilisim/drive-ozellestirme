				<dataPath>Organization</dataPath>
				<field>Organization</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	"ReturnedOrWrittenOff" 			 			 AS DataType,
	Software_3.SecondPeriod 			 AS SecondPeriod,
	Software_3.DayPeriod    			 AS DayPeriod,
	Software_3.MonthPeriod   			 AS MonthPeriod,
	CASE
		WHEN Software_3.Operation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
			THEN Software_3.Purpose
		ELSE VALUE(Catalog.Assignments.EmptyRef)	
	END 							 			 AS Purpose,	
	CASE
		WHEN Software_3.Operation = VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
			THEN VALUE(Enum.InventoryMovementTypes.Inpayment)
		ELSE VALUE(Enum.InventoryMovementTypes.Shipment)
	END 										 AS MovementType,
	Software_3.ReferenceOrder 			 AS ProductionStage,
	CASE
		WHEN Software_3.Recorder = UNDEFINED
			THEN NULL
		ELSE Software_3.Recorder
	END 										 AS Recorder,		
	0 											 AS LineNumber,
	Software_3.Products,
	Software_3.Characteristic,
	CatProducts.UnitOfMeasure 			 AS StorageUnit,
	CatProducts.UnitForReports 			 AS UnitForReports,
	CatProducts.UnitFactorForReports AS UnitFactorForReports,
	CASE
		WHEN Software_3.Operation &lt;&gt; VALUE(Enum.BusinessTransactions.ReturnOfMaterialsFromProduction)
			THEN 0
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.CountExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN Software_3.CountExpense / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END 										 AS ReturnedOrWrittenOff,
	CASE
		WHEN Software_3.Operation &lt;&gt; VALUE(Enum.BusinessTransactions.TransferOfProductsFromProduction)
			THEN 0
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.CountExpense
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN Software_3.CountExpense / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END 										 AS TransferredToWarehouse
FROM
	AccumulationRegister.ReferencesToTransferFromProduction.BalanceAndTurnovers(, , Auto, , {(ReferenceOrder) AS Ref}) AS Software_3
	
		LEFT JOIN Catalog.Products AS CatProducts
		ON Software_3.Products = CatProducts.Ref

UNION ALL

SELECT
	"ReturnedOrWrittenOff",
	OneStageTable.Date,
	BEGINOFPERIOD(Software_3.DateOfTransaction, DAY),
	BEGINOFPERIOD(Software_3.DateOfTransaction, MONTH),
	VALUE(Catalog.Assignments.EmptyRef),
	VALUE(Enum.InventoryMovementTypes.Shipment),
	Software_3.Ref,
	Software_3.Ref,
	Software_3.LineNumber,
	Software_3.Products,
	Software_3.Characteristic,
	CatProducts.UnitOfMeasure,
	CatProducts.UnitForReports,
	CatProducts.UnitFactorForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN Software_3.Count / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END,
	0
FROM
	Document.ProductionStage2_2 AS OneStageTable
	
		INNER JOIN Document.ProductionStage2_2.UnusedMaterials AS Software_3
		ON OneStageTable.Ref = Software_3.Ref
		
		LEFT JOIN Catalog.Products AS CatProducts
		ON Software_3.Products = CatProducts.Ref
WHERE
	OneStageTable.Posted
	AND (Software_3.ToExpenseAs
			OR Software_3.Recipient.ShopFloorStockroom
				AND Software_3.Recipient.Department = Software_3.Department)
{WHERE
	Software_3.Ref AS Ref}</query>
		</item>
