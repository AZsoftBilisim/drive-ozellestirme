			<field xsi:type="DataSetFieldField">
				<dataPath>MonthPeriod</dataPath>
				<field>MonthPeriod</field>
				<role>
					<dcscom:periodNumber>5</dcscom:periodNumber>
					<dcscom:periodType>Additional</dcscom:periodType>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SecondPeriod</dataPath>
				<field>SecondPeriod</field>
				<role>
					<dcscom:periodNumber>3</dcscom:periodNumber>
					<dcscom:periodType>Main</dcscom:periodType>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	Assignments.Ref AS Ref
INTO Assignments
FROM
	Catalog.Assignments AS Assignments
{WHERE
	Assignments.OrderDocument AS Ref}

INDEX BY
	Ref
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	"MaterialsEnteredProduction"			 		AS DataType,
	Software_3.SecondPeriod 			 		AS SecondPeriod,
	Software_3.DayPeriod    			 		AS DayPeriod,
	Software_3.MonthPeriod   			 		AS MonthPeriod,
	VALUE(Catalog.Assignments.EmptyRef) 		AS Purpose,
	VALUE(Enum.InventoryMovementTypes.Shipment) AS MovementType,
	Software_3.Purpose.OrderDocument 				AS ProductionStage,
	Software_3.Recorder 						AS Recorder,
	0 													AS LineNumber,
	Software_3.Products 					AS Products,
	Software_3.Characteristic 					AS Characteristic,
	CatProducts.UnitOfMeasure 					AS StorageUnit,
	CatProducts.UnitForReports 					AS UnitForReports,
	CatProducts.UnitFactorForReports 		AS UnitFactorForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.ToRegisterExpense - Software_3.ShippedNotReceivedClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN (Software_3.ToRegisterExpense - Software_3.ShippedNotReceivedClosingBalance) / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END 												AS Received
FROM
	AccumulationRegister.OrdersOfMaterialsForProduction.BalanceAndTurnovers(
			,
			,
			Auto,
			,
			Purpose IN
				(SELECT
					Assignments.Ref
				FROM
					Assignments)
	) AS Software_3
					
		LEFT JOIN Catalog.Products AS CatProducts
		ON Software_3.Products = CatProducts.Ref
WHERE
	Software_3.ToRegisterExpense - Software_3.ShippedNotReceivedClosingBalance &gt; 0</query>
		</item>
