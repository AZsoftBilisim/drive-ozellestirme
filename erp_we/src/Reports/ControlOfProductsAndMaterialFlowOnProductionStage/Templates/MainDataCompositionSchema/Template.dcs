			<field xsi:type="DataSetFieldField">
				<dataPath>Purpose</dataPath>
				<field>Purpose</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	"PlannedAndProduced"                            AS DataType,
	VALUE(Enum.InventoryMovementTypes.Inpayment) AS MovementType,
    DocumentStage.Ref 			                       AS Ref,
	DocumentStage.Date   			                       AS Date,
	DocumentStage.Status 			                       AS Status,
	Software_3.Department	                   AS Department,
	DocumentStage.ReferenceOrder                              AS ReferenceOrder,
	DocumentStage.ProductionByThirdParty                     AS ProductionByThirdParty,
	DocumentStage.SubcontractOrder                        AS SubcontractOrder,
	Software_3.LineNumber                         AS LineNumber,
	Software_3.Purpose                          AS Purpose, 
	Software_3.Manufactured                         AS Manufactured,
	Software_3.ToExpenseAs                    AS ToExpenseAs,
	Software_3.Recipient                          AS Recipient,
	Software_3.ProductionDate                    AS ProductionDate,
	Software_3.Products                        AS Products,
	Software_3.Characteristic                      AS Characteristic,
	CatProducts.UnitOfMeasure 					   AS StorageUnit,
	CatProducts.UnitForReports 					   AS UnitForReports,
	CatProducts.UnitFactorForReports		   AS UnitFactorForReports,
	CatProducts.ItemsType 
		= VALUE(Enum.ItemsTypes.Work_5)   AS Work_5,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN Software_3.Count / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END												   AS Count
INTO Software_3	
FROM
	Document.ProductionStage2_2 AS DocumentStage
	
		INNER JOIN Document.ProductionStage2_2.ManufacturedProducts AS Software_3
		ON DocumentStage.Ref = Software_3.Ref
		
		LEFT JOIN Catalog.Products AS CatProducts
		ON Software_3.Products = CatProducts.Ref
WHERE
	DocumentStage.Posted
	AND NOT Software_3.Canceled
{WHERE
	Software_3.Ref AS Ref}		
	
UNION ALL

SELECT
	"PlannedAndProduced"                            AS DataType,
	VALUE(Enum.InventoryMovementTypes.Inpayment) AS MovementType,
    DocumentStage.Ref 			                       AS Ref,
	DocumentStage.Date   			                       AS Date,
	DocumentStage.Status 			                       AS Status,
	Software_3.Department	                   AS Department,
	DocumentStage.ReferenceOrder                              AS ReferenceOrder,
	DocumentStage.ProductionByThirdParty                     AS ProductionByThirdParty,
	DocumentStage.SubcontractOrder                        AS SubcontractOrder,
	Software_3.LineNumber                         AS LineNumber,
	Software_3.Purpose                          AS Purpose, 
	Software_3.Manufactured                         AS Manufactured,
	Software_3.ToExpenseAs                    AS ToExpenseAs,
	Software_3.Recipient                          AS Recipient,
	Software_3.ProductionDate                    AS ProductionDate,
	Software_3.Products                        AS Products,
	Software_3.Characteristic                      AS Characteristic,
	CatProducts.UnitOfMeasure 					   AS StorageUnit,
	CatProducts.UnitForReports 					   AS UnitForReports,
	CatProducts.UnitFactorForReports		   AS UnitFactorForReports,
	CatProducts.ItemsType 
		= VALUE(Enum.ItemsTypes.Work_5)   AS Work_5,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN Software_3.Count / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END												   AS Count
FROM
	Document.ProductionStage2_2 AS DocumentStage
	
		INNER JOIN Document.ProductionStage2_2.SideAndIntermediateRelease AS Software_3
		ON DocumentStage.Ref = Software_3.Ref
		
		LEFT JOIN Catalog.Products AS CatProducts
		ON Software_3.Products = CatProducts.Ref
WHERE
	DocumentStage.Posted
	AND NOT Software_3.Canceled
{WHERE
	Software_3.Ref AS Ref}
	
INDEX BY
	Ref,
	ReferenceOrder
			
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	Software_3.DataType   					AS DataType,
	Software_3.MovementType 					AS MovementType,
	Software_3.Date        					AS SecondPeriod,
	CASE
	
		WHEN Software_3.Status IN (
					VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
					VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			THEN Software_3.ProductionDate
			
		WHEN Software_3.Status = VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion)
			AND (Constants.UsePlanningByMaterialResources
		  OR Constants.UsePlanningByProductionResources)
		    AND NOT ProductionSchedule.Stage IS NULL
				THEN BEGINOFPERIOD(ProductionSchedule.Ending, DAY)
				
		ELSE BEGINOFPERIOD(
				DATEADD(
					DocumentOrderDocument.EarliestStartDate, 
					SECOND, 
					ISNULL(StandardProductionSchedule.DurationBeforeStart + StandardProductionSchedule.ResourceIntensity, 0)), 
				DAY)
											     
	END 											AS DayPeriod,
	CASE
	
		WHEN Software_3.Status IN (
					VALUE(Enum.StatusesOfProductionStages2_2.Initiated),
					VALUE(Enum.StatusesOfProductionStages2_2.Completed))
			THEN BEGINOFPERIOD(Software_3.ProductionDate, MONTH)
			
		WHEN Software_3.Status = VALUE(Enum.StatusesOfProductionStages2_2.ForCompletion)
			AND (Constants.UsePlanningByMaterialResources
		  OR Constants.UsePlanningByProductionResources)
		    AND NOT ProductionSchedule.Stage IS NULL
				THEN BEGINOFPERIOD(ProductionSchedule.Ending, MONTH)
				
		ELSE BEGINOFPERIOD(
				DATEADD(
					DocumentOrderDocument.EarliestStartDate, 
					SECOND, 
					ISNULL(StandardProductionSchedule.DurationBeforeStart + StandardProductionSchedule.ResourceIntensity, 0)), 
				MONTH)
											     
	END 											AS MonthPeriod,						
	Software_3.Purpose 					AS Purpose, 
	Software_3.Ref 						AS ProductionStage,
	Software_3.Ref 						AS Recorder,
	Software_3.LineNumber					AS LineNumber,
	Software_3.Products 				AS Products,
	Software_3.Characteristic 				AS Characteristic,
	Software_3.StorageUnit				AS StorageUnit,
	Software_3.UnitForReports            AS UnitForReports,
	Software_3.UnitFactorForReports AS UnitFactorForReports,
	Software_3.Count                   AS PlannedToManufacture,
	0 												AS Manufactured,
	0	 											AS WrittenOffAsExpenses,
	0 												AS TransferredToWarehouse,
	Software_3.Work_5 						AS Work_5
FROM
	Software_3 AS Software_3
		 	
		LEFT JOIN InformationRegister.ScheduleOfProductionStages2_2 AS ProductionSchedule
		ON Software_3.ReferenceOrder  = ProductionSchedule.ProductionOrder
		 AND Software_3.Ref        = ProductionSchedule.Stage
		 AND ProductionSchedule.ScheduleStatus = &amp;ScheduleStatus
		 
		LEFT JOIN InformationRegister.StandardScheduleOfProductionStages AS StandardProductionSchedule
		ON Software_3.ReferenceOrder = StandardProductionSchedule.ReferenceOrder
		 AND Software_3.Ref       = StandardProductionSchedule.ProductionStage
		 
		LEFT JOIN Document.ProductionOrder2_2 AS DocumentOrderDocument
		ON Software_3.ReferenceOrder = DocumentOrderDocument.Ref
		 
		LEFT JOIN Constants AS Constants
		ON (TRUE)
{WHERE
	Software_3.Ref AS Ref}		
	
UNION ALL

SELECT
	Software_3.DataType   							  AS DataType,
	Software_3.MovementType 							  AS MovementType,
	Software_3.Date        							  AS SecondPeriod,
	Software_3.ProductionDate						  AS DayPeriod,
	BEGINOFPERIOD(Software_3.ProductionDate, MONTH) AS MonthPeriod,						
	Software_3.Purpose 							  AS Purpose, 
	Software_3.Ref 								  AS ProductionStage,
	Software_3.Ref 								  AS Recorder,
	Software_3.LineNumber							  AS LineNumber,
	Software_3.Products 						  AS Products,
	Software_3.Characteristic 						  AS Characteristic,
	Software_3.StorageUnit						  AS StorageUnit,
	Software_3.UnitForReports            		  AS UnitForReports,
	Software_3.UnitFactorForReports 		  AS UnitFactorForReports,
	0                   						    		  AS PlannedToManufacture,
	Software_3.Count 							  AS Manufactured,
	CASE
		WHEN Software_3.ToExpenseAs
			THEN Software_3.Count
		ELSE 0
	END													  AS WrittenOffAsExpenses,
	CASE
		WHEN NOT Software_3.Recipient REFS Catalog.Warehouses
		  OR Software_3.Recipient = VALUE(Catalog.Warehouses.EmptyRef)
		  OR NOT CAST(Software_3.Recipient AS Catalog.Warehouses).ShopFloorStockroom
		  OR CAST(Software_3.Recipient AS Catalog.Warehouses).Department &lt;&gt; Software_3.Department
			THEN 0
		ELSE Software_3.Count
	END 													  AS TransferredToWarehouse,
	Software_3.Work_5 								  AS Work_5
FROM
	Software_3 AS Software_3
WHERE
	Software_3.Manufactured	
{WHERE
	Software_3.Ref AS Ref}</query>
		</item>
