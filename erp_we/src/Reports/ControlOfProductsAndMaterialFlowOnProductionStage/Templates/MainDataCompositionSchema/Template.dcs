			<field xsi:type="DataSetFieldField">
				<dataPath>ReturnToTheBeginningOfPeriod</dataPath>
				<field>ReturnToTheBeginningOfPeriod</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>en</v8:lang>
						<v8:content>Return to the beginning of period</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>بازگشت به ابتدای دوره</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>In restituzione per l'inizio del periodo</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Do zwrotu na początek okresu</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>К возврату на начало периода</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Dönem başında iade edilecek</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Trở về đầu kỳ</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Organization</dataPath>
				<field>Organization</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	"ForReturn"                      			 		AS DataType,
	Software_3.SecondPeriod 			 		AS SecondPeriod,
	Software_3.DayPeriod    			 		AS DayPeriod,
	Software_3.MonthPeriod   			 		AS MonthPeriod,
	VALUE(Catalog.Assignments.EmptyRef) 		AS Purpose,
	VALUE(Enum.InventoryMovementTypes.Shipment) AS MovementType,
	Software_3.ReferenceOrder 					AS ProductionStage,
	CASE
		WHEN Software_3.Recorder = UNDEFINED
			THEN NULL
		ELSE Software_3.Recorder
	END 												AS Recorder, 
	0 													AS LineNumber,
	Software_3.Products 					AS Products,
	Software_3.Characteristic 					AS Characteristic,
	CatProducts.UnitOfMeasure 					AS StorageUnit,
	CatProducts.UnitForReports 					AS UnitForReports,
	CatProducts.UnitFactorForReports 		AS UnitFactorForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.CountClosingBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN Software_3.CountClosingBalance / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END 												AS ForReturn,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.CountOpeningBalance
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN Software_3.CountOpeningBalance / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END 												AS ReturnToTheBeginningOfPeriod
FROM
	AccumulationRegister.ReferencesToTransferFromProduction.BalanceAndTurnovers(
			, 
			, 
			Auto, 
			, 
			Operation = VALUE(Enum.BusinessTransactions.ReturnOfMaterialsFromProduction) {(ReferenceOrder) AS Ref}
	) AS Software_3
		
		LEFT JOIN Catalog.Products AS CatProducts
		ON Software_3.Products = CatProducts.Ref
		</query>
		</item>
