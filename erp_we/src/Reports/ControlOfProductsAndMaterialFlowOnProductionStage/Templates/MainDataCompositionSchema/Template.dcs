					</v8:item>
					<v8:item>
						<v8:lang>fa</v8:lang>
						<v8:content>تخصیص</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>it</v8:lang>
						<v8:content>Destinazione</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>pl</v8:lang>
						<v8:content>Przeznaczenie</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Назначение</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>tr</v8:lang>
						<v8:content>Atama</v8:content>
					</v8:item>
					<v8:item>
						<v8:lang>vi</v8:lang>
						<v8:content>Mục đích</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT
	"OrderedAndReceivedInPantry"                         AS DataType,
	OneStageTable.Date                       				  AS SecondPeriod,
	BEGINOFPERIOD(Software_3.DateOfShipment, DAY)  AS DayPeriod,
	BEGINOFPERIOD(Software_3.DateOfShipment, MONTH) AS MonthPeriod,
	VALUE(Catalog.Assignments.EmptyRef)          AS Purpose,
	VALUE(Enum.InventoryMovementTypes.Shipment)   AS MovementType,
	Software_3.Ref 							  AS ProductionStage,
	Software_3.Ref 							  AS Recorder,
	Software_3.LineNumber 						  AS LineNumber,
	Software_3.Products 					  AS Products,
	Software_3.Characteristic 					  AS Characteristic,
	CatProducts.UnitOfMeasure 					  AS StorageUnit,
	CatProducts.UnitForReports 					  AS UnitForReports,
	CatProducts.UnitFactorForReports 		  AS UnitFactorForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN Software_3.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN Software_3.Count / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END 												  AS Ordered
FROM
	Document.ProductionStage2_2 AS OneStageTable
	
		INNER JOIN Document.ProductionStage2_2.SupplyWithMaterialsAndWorks AS Software_3
		ON OneStageTable.Ref = Software_3.Ref
		
		LEFT JOIN Catalog.Products AS CatProducts
		ON Software_3.Products = CatProducts.Ref
WHERE
	OneStageTable.Posted
	AND NOT Software_3.Canceled
	AND (NOT OneStageTable.ProductionByThirdParty
		OR Software_3.SupplyOption &lt;&gt; VALUE(Enum.SupplyOptions.NotRequired))
{WHERE
	Software_3.Ref AS Ref}</query>
		</item>
