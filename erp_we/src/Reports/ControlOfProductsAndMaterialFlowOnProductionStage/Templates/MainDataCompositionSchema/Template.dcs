			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	"EnteredProduction_"						 AS DataType,
	TableMaintenanceOfWorks.Period						 AS SecondPeriod,
	BEGINOFPERIOD(TableMaintenanceOfWorks.Period, DAY)  AS DayPeriod,
	BEGINOFPERIOD(TableMaintenanceOfWorks.Period, MONTH) AS MonthPeriod,
	VALUE(Catalog.Assignments.EmptyRef)		 AS Purpose,
	VALUE(Enum.InventoryMovementTypes.Shipment)  AS MovementType,
	TableMaintenanceOfWorks.Recorder					 AS ProductionStage,
	TableMaintenanceOfWorks.Recorder					 AS Recorder,
	0													 AS LineNumber,
	TableMaintenanceOfWorks.Products				 AS Products,
	TableMaintenanceOfWorks.Characteristic				 AS Characteristic,
	CatProducts.UnitOfMeasure					 AS StorageUnit,
	CatProducts.UnitForReports					 AS UnitForReports,
	CatProducts.UnitFactorForReports		 AS UnitFactorForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableMaintenanceOfWorks.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN TableMaintenanceOfWorks.Count / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END												 AS Received
FROM
	AccumulationRegister.MaterialsAndWorksInProduction AS TableMaintenanceOfWorks
	
		LEFT JOIN Catalog.Products AS CatProducts
		ON TableMaintenanceOfWorks.Products = CatProducts.Ref
WHERE
	VALUETYPE(TableMaintenanceOfWorks.Recorder) = TYPE(Document.ProductionStage2_2)
	AND TableMaintenanceOfWorks.RecordType = VALUE(AccumulationRecordType.Expense)
{WHERE
	TableMaintenanceOfWorks.Recorder AS Ref}

UNION ALL

SELECT
	"EnteredProduction_"						 AS DataType,
	TableMaintenanceOfWorks.Period						 AS SecondPeriod,
	BEGINOFPERIOD(TableMaintenanceOfWorks.Period, DAY)  AS DayPeriod,
	BEGINOFPERIOD(TableMaintenanceOfWorks.Period, MONTH) AS MonthPeriod,
	VALUE(Catalog.Assignments.EmptyRef)		 AS Purpose,
	VALUE(Enum.InventoryMovementTypes.Shipment)  AS MovementType,
	TableMaintenanceOfWorks.Recorder					 AS ProductionStage,
	TableMaintenanceOfWorks.Recorder					 AS Recorder,
	0													 AS LineNumber,
	DimensionKeys.Products							 AS Products,
	DimensionKeys.Characteristic						 AS Characteristic,
	CatProducts.UnitOfMeasure					 AS StorageUnit,
	CatProducts.UnitForReports					 AS UnitForReports,
	CatProducts.UnitFactorForReports		 AS UnitFactorForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN TableMaintenanceOfWorks.Count
		WHEN &amp;QuantityUnits = 1
			THEN CASE
					WHEN CatProducts.UnitFactorForReports &lt;&gt; 0
						THEN TableMaintenanceOfWorks.Count / CatProducts.UnitFactorForReports
					ELSE 0
				END
	END												 AS Received
FROM
	AccumulationRegister.CompanyGoods AS TableMaintenanceOfWorks
		LEFT JOIN Catalog.InventoryLocationAttributeKeys AS DimensionKeys
		ON TableMaintenanceOfWorks.ItemsLocationAttributes = DimensionKeys.Ref
		
		LEFT JOIN Catalog.Products AS CatProducts
		ON DimensionKeys.Products = CatProducts.Ref
WHERE
	VALUETYPE(TableMaintenanceOfWorks.Recorder) = TYPE(Document.ProductionStage2_2)
	AND TableMaintenanceOfWorks.RecordType = VALUE(AccumulationRecordType.Expense)
	AND CatProducts.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
{WHERE
	TableMaintenanceOfWorks.Recorder AS Ref}</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>Products.UnitOfMeasure</dataPath>
		<expression>Case
    When &amp;QuantityUnits = 0 Then
        Products.UnitOfMeasure
    When &amp;QuantityUnits = 1 Then
        Products.UnitForReports
End</expression>
