	<calculatedField>
		<dataPath>LeftToProduce</dataPath>
		<expression>Case 
	When IsNull(PlannedToManufacture,0) 
			- IsNull(Manufactured,0) &gt; 0 
		Then IsNull(PlannedToManufacture,0) - IsNull(Manufactured,0) 
	Else 
		0 
End</expression>
		<title xsi:type="v8:LocalStringType">
