	</calculatedField>
	<totalField>
		<dataPath>Ordered</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    Sum(Ordered)
End</expression>
	</totalField>
	<totalField>
		<dataPath>LineNumber</dataPath>
		<expression>Max(LineNumber)</expression>
	</totalField>
	<totalField>
		<dataPath>Spent</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    Sum(Spent)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ReturnedOrWrittenOff</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    IsNull(Sum(ReturnedOrWrittenOff), 0)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ForReturn</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    IsNull(Sum(ForReturn), 0)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Received</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    IsNull(Sum(Received), 0)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToReceive</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
     IsNull(Sum(Ordered),0) -  IsNull(Sum(Received),0)
End</expression>
	</totalField>
	<totalField>
		<dataPath>PlannedToManufacture</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    IsNull(Sum(PlannedToManufacture), 0)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Manufactured</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    IsNull(Sum(Manufactured), 0)
End</expression>
	</totalField>
	<totalField>
		<dataPath>TransferredToWarehouse</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    IsNull(Sum(TransferredToWarehouse), 0)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ForTransferToWarehouse</dataPath>
		<expression>Case
	When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 
		Then 0
Else
    Sum(IsNull(Case When Work_5 Then 0 Else Manufactured End, 0)) 
    - Sum(IsNull(Case When Work_5 Then 0 Else TransferredToWarehouse End, 0)) 
    - Sum(IsNull(Case When Work_5 Then 0 Else WrittenOffAsExpenses End, 0))
End</expression>
	</totalField>
	<totalField>
		<dataPath>LeftToProduce</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
    When IsNull(Sum(PlannedToManufacture),0) 
            - IsNull(Sum(Manufactured),0) &gt; 0 
        Then IsNull(Sum(PlannedToManufacture),0) - IsNull(Sum(Manufactured),0) 
    Else 
        0 
End</expression>
	</totalField>
	<totalField>
		<dataPath>WrittenOffAsExpenses</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    IsNull(Sum(WrittenOffAsExpenses), 0)
End</expression>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
	IsNull(Sum(Received),0) - IsNull(Sum(Spent),0) - IsNull(Sum(ReturnedOrWrittenOff),0)
End</expression>
		<group>ReportUnit</group>
		<group>ProductionStage</group>
		<group>Products</group>
		<group>Products Hierarchy</group>
		<group>MovementType</group>
		<group>Purpose</group>
		<group>UnitForReports</group>
		<group>UnitForReports Hierarchy</group>
		<group>StorageUnit</group>
		<group>StorageUnit Hierarchy</group>
		<group>Work_5</group>
		<group>Characteristic</group>
		<group>Recorder</group>
		<group>SecondPeriod</group>
		<group>Overall</group>
	</totalField>
	<totalField>
		<dataPath>Balance</dataPath>
		<expression>Case When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1 Then
   0
Else
    Case When &amp;ShowDetailsOnPeriod = 1 Then 
    		EvalExpression("IsNull(Sum(Received),0) - IsNull(Sum(Spent),0) - IsNull(Sum(ReturnedOrWrittenOff),0)", "DayPeriod",, "First", "Current")
    	  When &amp;ShowDetailsOnPeriod = 2 Then 
    		EvalExpression("IsNull(Sum(Received),0) - IsNull(Sum(Spent),0) - IsNull(Sum(ReturnedOrWrittenOff),0)", "MonthPeriod",, "First", "Current")
    End	 
End
</expression>
		<group>DayPeriod</group>
		<group>MonthPeriod</group>
	</totalField>
