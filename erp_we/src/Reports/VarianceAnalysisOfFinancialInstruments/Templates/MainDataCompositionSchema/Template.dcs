	<settingsVariant>
		<dcsset:name>PlanFactualAnalysis</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Variance analysis of payments and accruals under contracts</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>تحلیل انحراف پرداخت‌ها و محاسبات بر اساس قراردادها</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Analisi degli indicatori preventivati e effettivi di pagamenti e accrediti secondo i contratti</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Planowa-faktyczna analiza płatności i naliczeń według kontraktów</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>План-фактный анализ оплат и начислений по договорам</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Sözleşmeler kapsamındaki ödemelerin ve tahakkukların plan-gerçek analizi</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Phân tích giữa thanh toán và tính lãi dự tính và thực tế theo hợp đồng</v8:content>
			</v8:item>
		</dcsset:presentation>
