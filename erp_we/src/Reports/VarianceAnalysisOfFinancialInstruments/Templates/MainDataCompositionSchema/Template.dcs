					<dataSource>DataSource1</dataSource>
					<query>SELECT
	ScheduleOfTrancheForLoansAndDeposits.Period AS Period,
	ScheduleOfTrancheForLoansAndDeposits.ScheduleOption.Owner AS Contract,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Tranches) AS ScheduleType,
	YEAR(ScheduleOfTrancheForLoansAndDeposits.Period) AS YearNumber,
	BEGINOFPERIOD(ScheduleOfTrancheForLoansAndDeposits.Period, MONTH) AS MonthName,
	ScheduleOfTrancheForLoansAndDeposits.Sum AS TrancheAmountPlan,
	0 AS DebtAmountPlan,
	0 AS PaymentPercentPlan,
	0 AS PaymentFeePlan,
	0 AS AccrualPercentPlan,
	0 AS AccrualFeePlan,
	0 AS TrancheAmountActual,
	0 AS DebtAmountActual,
	0 AS PaymentPercentActual,
	0 AS PaymentFeeActual,
	0 AS AccrualPercentActual,
	0 AS AccrualFeeActual
FROM
	InformationRegister.ScheduleOfTrancheForLoansAndDeposits AS ScheduleOfTrancheForLoansAndDeposits
WHERE
	ScheduleOfTrancheForLoansAndDeposits.ScheduleOption.Used

UNION ALL

SELECT
	ScheduleOfPaymentForLoansAndDeposits.Period,
	ScheduleOfPaymentForLoansAndDeposits.ScheduleOption.Owner,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Payments),
	YEAR(ScheduleOfPaymentForLoansAndDeposits.Period),
	BEGINOFPERIOD(ScheduleOfPaymentForLoansAndDeposits.Period, MONTH),
	0,
	ScheduleOfPaymentForLoansAndDeposits.Sum,
	ScheduleOfPaymentForLoansAndDeposits.Interests,
	ScheduleOfPaymentForLoansAndDeposits.Fee,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0
FROM
	InformationRegister.ScheduleOfPaymentForLoansAndDeposits AS ScheduleOfPaymentForLoansAndDeposits
WHERE
	ScheduleOfPaymentForLoansAndDeposits.ScheduleOption.Used

UNION ALL

SELECT
	ScheduleOfAccrualsForLoansAndDeposits.Period,
	ScheduleOfAccrualsForLoansAndDeposits.ScheduleOption.Owner,
	VALUE(Enum.FinancialInstrumentScheduleTypes.Accruals),
	YEAR(ScheduleOfAccrualsForLoansAndDeposits.Period),
	BEGINOFPERIOD(ScheduleOfAccrualsForLoansAndDeposits.Period, MONTH),
	0,
	0,
	0,
	0,
	ScheduleOfAccrualsForLoansAndDeposits.Interests,
	ScheduleOfAccrualsForLoansAndDeposits.Fee,
	0,
	0,
	0,
	0,
	0,
	0
FROM
	InformationRegister.ScheduleOfAccrualsForLoansAndDeposits AS ScheduleOfAccrualsForLoansAndDeposits
WHERE
	ScheduleOfAccrualsForLoansAndDeposits.ScheduleOption.Used
</query>
				</item>
