		<field xsi:type="DataSetFieldField">
			<dataPath>DateOfDefectRegistrationDocument</dataPath>
			<field>DateOfDefectRegistrationDocument</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>R&amp;M request document data</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>داده‌های سند درخواست تعمیر و نگهداری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Data del documento di registrazione del difetto</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Data dokumentu rejestracji wady</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата документа регистрации дефекта</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Kusur tescil belgesinin tarihi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Ngày của chứng từ đăng ký hỏng hóc</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	RMRequest.Ref AS DefectRegistrationDocument,
	RMRequest.Number AS NumberOfDefectRegistrationDocument,
	RMRequest.Date AS DateOfDefectRegistrationDocument,
	RMRequest.FailureType AS FailureType,
	RMRequest.Status,
	RMRequest.Asset AS Asset,
	RMRequest.Asset.OperatingBusinessUnit AS OperatingBusinessUnit,

	RMRequestDefectiveSubAssets.Node AS NodeOfObjectOfOperation,
	RMRequestDefectiveSubAssets.DefectDetails,
	RMRequestDefectiveSubAssets.Node.Class AS Class,
	RMRequestDefectiveSubAssets.Node.Subclass AS Subclass
FROM
	Document.RMRequest AS RMRequest
		INNER JOIN Document.RMRequest.DefectiveSubAssets AS RMRequestDefectiveSubAssets
		ON RMRequestDefectiveSubAssets.Ref = RMRequest.Ref
WHERE
	RMRequest.Posted
	AND (RMRequest.Date &gt;= &amp;BeginOfPeriod
		OR &amp;BeginOfPeriod = DATETIME(1, 1, 1))
	AND (RMRequest.Date &lt;= &amp;PeriodEnding
		OR &amp;PeriodEnding = DATETIME(1, 1, 1))</query>
	</dataSet>
	<parameter>
		<name>PeriodEnding</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period end</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>پایان دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Fine del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Koniec okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Окончание периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem sonu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Kết thúc kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<expression>&amp;ReportPeriod.EndDate</expression>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>BeginOfPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period start</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>شروع دوره</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Inizio del periodo</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Początek okresu</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>tr</v8:lang>
				<v8:content>Dönem başı</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>vi</v8:lang>
				<v8:content>Đầu kỳ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<expression>&amp;ReportPeriod.StartDate</expression>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ReportPeriod</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
