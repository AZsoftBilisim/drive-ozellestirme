	</parameter>
	<settingsVariant>
		<dcsset:name>DefectsOfSubAssets</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Defects of sub-assets</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>fa</v8:lang>
				<v8:content>نقص‌های زیردارایی‌ها</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>it</v8:lang>
				<v8:content>Difetti dei nodi degli oggetti utilizzati</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>pl</v8:lang>
				<v8:content>Wady węzłów obiektów eksploatacji</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>ru</v8:lang>
