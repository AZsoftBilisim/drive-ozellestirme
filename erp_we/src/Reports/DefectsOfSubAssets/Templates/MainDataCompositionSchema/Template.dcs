				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Kusur tescil belgesinin numarası</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Số của chứng từ đăng ký hỏng hóc</v8:content>
				</v8:item>
			</title>
