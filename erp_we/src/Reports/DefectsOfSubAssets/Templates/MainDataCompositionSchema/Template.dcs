		<field xsi:type="DataSetFieldField">
			<dataPath>DefectRegistrationDocument</dataPath>
			<field>DefectRegistrationDocument</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>R&amp;M request document</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>fa</v8:lang>
					<v8:content>سند درخواست تعمیر و نگهداری</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>it</v8:lang>
					<v8:content>Documento di registrazione del difetto</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>pl</v8:lang>
					<v8:content>Dokument rejestracji wady</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ регистрации дефекта</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>tr</v8:lang>
					<v8:content>Kusur tescil belgesi</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>vi</v8:lang>
					<v8:content>Ngày đăng ký hỏng hóc</v8:content>
				</v8:item>
			</title>
			<presentationExpression>NStr("ru = '№'; vi = 'Số'; en = 'No.'; it = '№'; pl = '№'; tr = 'No.'") + NumberOfDefectRegistrationDocument + " " + NStr("ru = 'от'; vi = 'ngày'; en = 'dated'; it = 'del'; pl = 'z dn.'; tr = 'tarih'") + " " + Format(DateOfDefectRegistrationDocument, "DLF=D;")</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Asset</dataPath>
			<field>Asset</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>NumberOfDefectRegistrationDocument</dataPath>
			<field>NumberOfDefectRegistrationDocument</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
