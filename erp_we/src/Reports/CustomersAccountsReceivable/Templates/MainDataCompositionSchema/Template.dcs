		<dataSource>DataSource1</dataSource>
		<query>SELECT
	VALUE(Catalog.Companies.EmptyRef)             AS Organization,
	VALUE(Catalog.Partners.EmptyRef)                AS Partner,
	VALUE(Catalog.Counterparties.EmptyRef)             AS Counterparty,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS Contract,
	VALUE(Catalog.LinesOfBusiness.EmptyRef) AS LineOfBusiness,
	VALUE(Catalog.CounterpartyContracts.EmptyRef)    AS ARAPObject,
	VALUE(Catalog.Currencies.EmptyRef)                  AS Currency,
	UNDEFINED                                              AS ARAPDocument,
	DATETIME(1,1,1)                                          AS PlannedRepaymentDate,
	DATETIME(1,1,1)                                          AS OccurrenceDate,
	0                                                         AS AccountsPayableOfCompany,
	0                                                         AS CustomerAccountsReceivable,
	0                                                         AS OverdueCustomerDebt,
	0                                                         AS BeingPaid,
	
	0                                                         AS ScheduledPaymentInAdvance,
	0                                                         AS ScheduledPaymentPrepayment,
	0                                                         AS ScheduledPaymentCredit,
	0                                                         AS ScheduledPaymentRegardless,
	0                                                         AS ScheduledPaymentOverdue,
	0                                                         AS ScheduledPaymentForEverything,
	
	0                                                         AS ScheduledShipment,
	0                                                         AS ScheduledShipmentOverdue,
	0                                                         AS BeingShipped,
	
	VALUE(Catalog.PartnersSegments.EmptyRef)       AS PartnersSegment,
	
	FALSE                                                      AS ShipmentIsProhibitedInCaseOfARAPOverdue,
	FALSE                                                      AS LimitDebtAmount,
	0                                                         AS AllowableAmountPayable
</query>
	</dataSet>
	<calculatedField>
		<dataPath>Balance_</dataPath>
		<expression>CustomerAccountsReceivable - AccountsPayableOfCompany</expression>
