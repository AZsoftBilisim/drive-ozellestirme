		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED DISTINCT
	Segments.Partner AS Partner,
	TRUE AS FilterByPartnerSegmentIsUsed
INTO SelectionByPartnerSegment
FROM
	InformationRegister.SegmentPartners AS Segments
{WHERE
	Segments.Segment.* AS PartnersSegment,
	Segments.Partner.* AS Partner}

INDEX BY
	Partner,
	FilterByPartnerSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
 SELECT
	CurrencyRatesCut.Currency AS Currency,
	CurrencyRatesCut.CourseNumerator AS CourseNumerator,
	CurrencyRatesCut.CourseDenominator AS CourseDenominator
INTO ManSExchangeRate
FROM
	InformationRegister.RelativeExchangeRates.SliceLast(&amp;DateOfCourse, Currency IN
		(SELECT
			Constants.ManagementAccountingCurrency
		FROM
			Constants AS Constants)
	AND BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
;

////////////////////////////////////////////////////////////////////////////////
 SELECT ALLOWED
	JobForSalesRepresentative.SalesRepresentative AS SalesRepresentative,
	JobForSalesRepresentative.Partner AS Partner,
	SUM(CASE
		WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
			THEN JobForSalesRepresentative.DocumentAmount
		ELSE JobForSalesRepresentative.DocumentAmount * (CurrencyRatesCut.CourseNumerator *
			ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
	END) AS Sum,
	SUM(CASE
		WHEN JobForSalesRepresentative.Currency = ManSExchangeRate.Currency
			THEN JobForSalesRepresentative.SumPlan
		ELSE JobForSalesRepresentative.SumPlan * (CurrencyRatesCut.CourseNumerator *
			ManSExchangeRate.CourseDenominator) / (ManSExchangeRate.CourseNumerator * CurrencyRatesCut.CourseDenominator)
	END) AS SumPlan,
	JobForSalesRepresentative.Ref AS Job
FROM
	Document.JobForSalesRepresentative AS JobForSalesRepresentative
		LEFT JOIN ManSExchangeRate AS ManSExchangeRate
		ON (TRUE)
		LEFT JOIN InformationRegister.RelativeExchangeRates.SliceLast(&amp;DateOfCourse,
			BaseCurrency = &amp;BaseCurrency) AS CurrencyRatesCut
		ON JobForSalesRepresentative.Currency = CurrencyRatesCut.Currency
WHERE
	NOT JobForSalesRepresentative.DeletionMark
	AND JobForSalesRepresentative.Status &lt;&gt; VALUE(Enum.SalesRepresentativeTaskStatuses.NotPrepared2)
{WHERE
	(JobForSalesRepresentative.PlannedVisitDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	OR JobForSalesRepresentative.ActualVisitDate BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod),
	(JobForSalesRepresentative.Partner IN
		(SELECT
			SelectionByPartnerSegment.Partner
		FROM
			SelectionByPartnerSegment
		WHERE
			SelectionByPartnerSegment.FilterByPartnerSegmentIsUsed = &amp;FilterByPartnerSegmentIsUsed))}
GROUP BY
	JobForSalesRepresentative.SalesRepresentative,
	JobForSalesRepresentative.Partner,
	JobForSalesRepresentative.Ref</query>
	</dataSet>
	<calculatedField>
		<dataPath>DifferenceInAmount</dataPath>
		<expression>Sum - SumPlan</expression>
