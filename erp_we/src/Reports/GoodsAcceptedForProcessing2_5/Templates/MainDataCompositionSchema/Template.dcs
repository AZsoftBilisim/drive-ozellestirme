			<field xsi:type="DataSetFieldField">
				<dataPath>ItemsLocationAttributes</dataPath>
				<field>ItemsLocationAttributes</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>InventoryOwnerAttribute</dataPath>
				<field>InventoryOwnerAttribute</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>CompletedReports</dataPath>
				<field>CompletedReports</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>SpoilageReSortingQuantity</dataPath>
				<field>SpoilageReSortingQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ToBeReceivedQuantity</dataPath>
				<field>ToBeReceivedQuantity</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>QuantityToBeShipped</dataPath>
				<field>QuantityToBeShipped</field>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED
	GoodsAcceptedForProcessing.Recorder                 AS Recorder,
	GoodsAcceptedForProcessing.SecondPeriod               AS SecondPeriod,
	GoodsAcceptedForProcessing.DayPeriod                  AS DayPeriod,
	GoodsAcceptedForProcessing.WeekPeriod                AS WeekPeriod,
	GoodsAcceptedForProcessing.TenDaysPeriod                AS TenDaysPeriod,
	GoodsAcceptedForProcessing.MonthPeriod                 AS MonthPeriod,
	GoodsAcceptedForProcessing.QuarterPeriod               AS QuarterPeriod,
	GoodsAcceptedForProcessing.HalfYearPeriod             AS HalfYearPeriod,
	GoodsAcceptedForProcessing.YearPeriod                   AS YearPeriod,
	
	GoodsAcceptedForProcessing.Organization                 AS Organization,
	GoodsAcceptedForProcessing.Owner                    AS Owner,
	GoodsAcceptedForProcessing.Contract                     AS Contract,
	GoodsAcceptedForProcessing.StorageLocation               AS StorageLocation,
	GoodsAcceptedForProcessing.Products                AS Products,
	ProductData_1.UnitOfMeasure                    AS StorageUnit,
	ProductData_1.UnitForReports                   AS UnitForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductData_1.UnitOfMeasure
		WHEN &amp;QuantityUnits = 1
			THEN ProductData_1.UnitForReports
	END                                                  AS ReportUnit,
	ProductData_1.UnitFactorForReports        AS UnitFactorForReports,
	GoodsAcceptedForProcessing.Characteristic              AS Characteristic,
	GoodsAcceptedForProcessing.Purpose                  AS Purpose,
	GoodsAcceptedForProcessing.Series                       AS Series,
	GoodsAcceptedForProcessing.CCDNumber                    AS CCDNumber,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.InitialBalanceQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.InitialBalanceQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS InitialBalanceQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.ToBeReceivedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.ToBeReceivedQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS ToBeReceivedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.ReceivedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.ReceivedQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS ReceivedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.ProducedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.ProducedQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS ProducedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.AmountUsedUp
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.AmountUsedUp
				/ ProductData_1.UnitFactorForReports
	END                                                  AS AmountUsedUp,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.QuantityToBeShipped
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.QuantityToBeShipped
				/ ProductData_1.UnitFactorForReports
	END                                                  AS QuantityToBeShipped,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.ShippedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.ShippedQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS ShippedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.RedeemedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.RedeemedQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS RedeemedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.QuantityToBeRedeemed
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.QuantityToBeRedeemed
				/ ProductData_1.UnitFactorForReports
	END                                                  AS QuantityToBeRedeemed,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.SpoilageReSortingQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.SpoilageReSortingQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS SpoilageReSortingQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.DebitedQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.DebitedQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS DebitedQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.AmountToBeDebited
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.AmountToBeDebited
				/ ProductData_1.UnitFactorForReports
	END                                                  AS AmountToBeDebited,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.FinalRemainderQuantity
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.FinalRemainderQuantity
				/ ProductData_1.UnitFactorForReports
	END                                                  AS FinalRemainderQuantity,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.ToDesignOfReports
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.ToDesignOfReports
				/ ProductData_1.UnitFactorForReports
	END                                                  AS ToDesignOfReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN GoodsAcceptedForProcessing.CompletedReports
		WHEN &amp;QuantityUnits = 1
			THEN GoodsAcceptedForProcessing.CompletedReports
				/ ProductData_1.UnitFactorForReports
	END                                                  AS CompletedReports
	
{SELECT
	Recorder,
	SecondPeriod,
	DayPeriod,
	WeekPeriod,
	TenDaysPeriod,
	MonthPeriod,
	QuarterPeriod,
	HalfYearPeriod,
	YearPeriod,
	
	Organization.*,
	Owner.*,
	Contract.*,
	StorageLocation.*,
	Products.*,
	StorageUnit.*,
	UnitForReports.*,
	ReportUnit.*,
	UnitFactorForReports,
	Characteristic.*,
	Purpose.*,
	Series.*,
	CCDNumber.*,
	InitialBalanceQuantity,
	ToBeReceivedQuantity,
	ReceivedQuantity,
	ProducedQuantity,
	AmountUsedUp,
	QuantityToBeShipped,
	ShippedQuantity,
	RedeemedQuantity,
	QuantityToBeRedeemed,
	SpoilageReSortingQuantity,
	DebitedQuantity,
	AmountToBeDebited,
	FinalRemainderQuantity,
	ToDesignOfReports,
	CompletedReports
}
FROM
	(SELECT
		CompanyGoods.Recorder                      AS Recorder,
		CompanyGoods.Period                           AS SecondPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, YEAR)       AS YearPeriod,
		
		CompanyGoods.Organization                      AS Organization,
		CompanyGoods.InventoryOwnerAttribute.GoodsOwner        AS Owner,
		CompanyGoods.InventoryOwnerAttribute.Contract               AS Contract,
		CompanyGoods.ItemsLocationAttributes.StorageLocation  AS StorageLocation,
		CompanyGoods.ItemsLocationAttributes.Products   AS Products,
		CompanyGoods.ItemsLocationAttributes.Characteristic AS Characteristic,
		CompanyGoods.ItemsLocationAttributes.Purpose     AS Purpose,
		CompanyGoods.ItemsLocationAttributes.Series AS Series,
		CompanyGoods.CCDNumber                         AS CCDNumber,
		0                                                  AS InitialBalanceQuantity,
		0                                                  AS ToBeReceivedQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND NOT CompanyGoods.BusinessOperation IN
					(VALUE(Enum.BusinessTransactions.ProductsRelease),
					VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost),
					VALUE(Enum.BusinessTransactions.EnterRemainingSemiFinishedProductsOfProvider),
					VALUE(Enum.BusinessTransactions.EnterRemainingManufacturedProductsOfProvider),
					VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
					VALUE(Enum.BusinessTransactions.Subcontracting2_5),
					VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.GoodsMisgrading),
					VALUE(Enum.BusinessTransactions.MisgradingOfGoodsAtToller),
					VALUE(Enum.BusinessTransactions.GoodsDamage),
					VALUE(Enum.BusinessTransactions.DamageAtToller),
					VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
					VALUE(Enum.BusinessTransactions.ErrorCorrection),
					VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
					VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS ReceivedQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND CompanyGoods.BusinessOperation IN
					(VALUE(Enum.BusinessTransactions.ProductsRelease),
					VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost),
					VALUE(Enum.BusinessTransactions.EnterRemainingSemiFinishedProductsOfProvider),
					VALUE(Enum.BusinessTransactions.EnterRemainingManufacturedProductsOfProvider),
					VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
					VALUE(Enum.BusinessTransactions.Subcontracting2_5),
					VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
					VALUE(Enum.BusinessTransactions.ErrorCorrection),
					VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
					VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN CompanyGoods.Count
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND CompanyGoods.BusinessOperation IN
					(VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
					VALUE(Enum.BusinessTransactions.Subcontracting2_5),
					VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
					VALUE(Enum.BusinessTransactions.ErrorCorrection),
					VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
					VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN -CompanyGoods.Count
			ELSE 0
		END                                              AS ProducedQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND CompanyGoods.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpensingToProductionLots)
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS AmountUsedUp,
		0                                                  AS QuantityToBeShipped,
		CASE
			// "Spent", "Written off" and "Redeemed" are excluded from "Shipped" for balance:
			// KonOst = Nachost + Received - Spent - Shipped - Redeemed - Paid- Off - Written-off
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND NOT CompanyGoods.BusinessOperation IN
						(VALUE(Enum.BusinessTransactions.RedemptionOfProviderGoods),
						VALUE(Enum.BusinessTransactions.ExpensingToProductionLots),
						VALUE(Enum.BusinessTransactions.GoodsConsumption),
						VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand),
						VALUE(Enum.BusinessTransactions.ProviderGoodsWriteOffAtTheExpenseOfProvider),
						VALUE(Enum.BusinessTransactions.ProviderGoodsWriteOffAsExpenses),
						VALUE(Enum.BusinessTransactions.GoodsWriteOffAtToller),
						VALUE(Enum.BusinessTransactions.GoodsMisgrading),
						VALUE(Enum.BusinessTransactions.MisgradingOfGoodsAtToller),
						VALUE(Enum.BusinessTransactions.GoodsDamage),
						VALUE(Enum.BusinessTransactions.DamageAtToller),
						VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
						VALUE(Enum.BusinessTransactions.Subcontracting2_5),
						VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
						VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
						VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
						VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
						VALUE(Enum.BusinessTransactions.ErrorCorrection),
						VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
						VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS ShippedQuantity,
		CASE
			WHEN CompanyGoods.BusinessOperation =
						(VALUE(Enum.BusinessTransactions.RedemptionOfProviderGoods))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS RedeemedQuantity,
		0                                                  AS QuantityToBeRedeemed,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND CompanyGoods.BusinessOperation IN
						(VALUE(Enum.BusinessTransactions.GoodsMisgrading),
						VALUE(Enum.BusinessTransactions.MisgradingOfGoodsAtToller),
						VALUE(Enum.BusinessTransactions.GoodsDamage),
						VALUE(Enum.BusinessTransactions.DamageAtToller))
				THEN CompanyGoods.Count
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND CompanyGoods.BusinessOperation IN
						(VALUE(Enum.BusinessTransactions.GoodsMisgrading),
						VALUE(Enum.BusinessTransactions.MisgradingOfGoodsAtToller),
						VALUE(Enum.BusinessTransactions.GoodsDamage),
						VALUE(Enum.BusinessTransactions.DamageAtToller))
				THEN -CompanyGoods.Count
			ELSE 0
		END                                              AS SpoilageReSortingQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND CompanyGoods.BusinessOperation IN
						(VALUE(Enum.BusinessTransactions.GoodsConsumption),
						VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand),
						VALUE(Enum.BusinessTransactions.GoodsWriteOffAtToller))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS DebitedQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND NOT CompanyGoods.ToRegisterGoodsIssue = 0
				THEN CompanyGoods.ToRegisterGoodsIssue
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND NOT CompanyGoods.ToRegisterGoodsIssue = 0
				THEN -CompanyGoods.ToRegisterGoodsIssue
			ELSE 0
		END                                              AS AmountToBeDebited,
		0                                                  AS FinalRemainderQuantity,
		0                                                  AS ToDesignOfReports,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND CompanyGoods.BusinessOperation IN
					(VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
					VALUE(Enum.BusinessTransactions.Subcontracting2_5),
					VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
					VALUE(Enum.BusinessTransactions.ErrorCorrection),
					VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
					VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS CompletedReports
	FROM
		AccumulationRegister.CompanyGoods AS CompanyGoods
	WHERE
		
		CompanyGoods.InventoryOwnerAttribute.InventoryType IN
			(VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider),
			VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
			VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider))
	{WHERE
		CompanyGoods.Period BETWEEN &amp;StartDate AND &amp;EndDate OR &amp;EndDate = DATETIME(1,1,1),
		CompanyGoods.ItemsLocationAttributes.*,
		CompanyGoods.InventoryOwnerAttribute.*,
		CompanyGoods.Recorder                      AS Recorder,
		CompanyGoods.Period                           AS SecondPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(CompanyGoods.Period, YEAR)       AS YearPeriod,
		
		CompanyGoods.Organization.*                    AS Organization,
		CompanyGoods.InventoryOwnerAttribute.GoodsOwner.*                 AS Owner,
		CompanyGoods.InventoryOwnerAttribute.Contract.*                        AS Contract,
		CompanyGoods.ItemsLocationAttributes.StorageLocation.*  AS StorageLocation,
		CompanyGoods.ItemsLocationAttributes.Products.*   AS Products,
		CompanyGoods.ItemsLocationAttributes.Characteristic.* AS Characteristic,
		CompanyGoods.ItemsLocationAttributes.Purpose.*     AS Purpose,
		CompanyGoods.ItemsLocationAttributes.Series.*          AS Series,
		CompanyGoods.CCDNumber.*                       AS CCDNumber,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND NOT CompanyGoods.BusinessOperation IN
					(VALUE(Enum.BusinessTransactions.ProductsRelease),
					VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost),
					VALUE(Enum.BusinessTransactions.EnterRemainingSemiFinishedProductsOfProvider),
					VALUE(Enum.BusinessTransactions.EnterRemainingManufacturedProductsOfProvider),
					VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
					VALUE(Enum.BusinessTransactions.Subcontracting2_5),
					VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.GoodsMisgrading),
					VALUE(Enum.BusinessTransactions.MisgradingOfGoodsAtToller),
					VALUE(Enum.BusinessTransactions.GoodsDamage),
					VALUE(Enum.BusinessTransactions.DamageAtToller),
					VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
					VALUE(Enum.BusinessTransactions.ErrorCorrection),
					VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
					VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS ReceivedQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND CompanyGoods.BusinessOperation IN
					(VALUE(Enum.BusinessTransactions.ProductsRelease),
					VALUE(Enum.BusinessTransactions.ProductsReleaseFixCost),
					VALUE(Enum.BusinessTransactions.EnterRemainingSemiFinishedProductsOfProvider),
					VALUE(Enum.BusinessTransactions.EnterRemainingManufacturedProductsOfProvider),
					VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
					VALUE(Enum.BusinessTransactions.Subcontracting2_5),
					VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
					VALUE(Enum.BusinessTransactions.ErrorCorrection),
					VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
					VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN CompanyGoods.Count
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND CompanyGoods.BusinessOperation IN
					(VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
					VALUE(Enum.BusinessTransactions.Subcontracting2_5),
					VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
					VALUE(Enum.BusinessTransactions.ErrorCorrection),
					VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
					VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN -CompanyGoods.Count
			ELSE 0
		END                                              AS ProducedQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND CompanyGoods.BusinessOperation = VALUE(Enum.BusinessTransactions.ExpensingToProductionLots)
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS AmountUsedUp,
		CASE
			// "Spent", "Written off" and "Redeemed" are excluded from "Shipped" for balance:
			// KonOst = Nachost + Received - Spent - Shipped - Redeemed - Paid- Off - Written-off
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND NOT CompanyGoods.BusinessOperation IN
						(VALUE(Enum.BusinessTransactions.RedemptionOfProviderGoods),
						VALUE(Enum.BusinessTransactions.ExpensingToProductionLots),
						VALUE(Enum.BusinessTransactions.GoodsConsumption),
						VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand),
						VALUE(Enum.BusinessTransactions.ProviderGoodsWriteOffAtTheExpenseOfProvider),
						VALUE(Enum.BusinessTransactions.ProviderGoodsWriteOffAsExpenses),
						VALUE(Enum.BusinessTransactions.GoodsWriteOffAtToller),
						VALUE(Enum.BusinessTransactions.GoodsMisgrading),
						VALUE(Enum.BusinessTransactions.MisgradingOfGoodsAtToller),
						VALUE(Enum.BusinessTransactions.GoodsDamage),
						VALUE(Enum.BusinessTransactions.DamageAtToller),
						VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
						VALUE(Enum.BusinessTransactions.Subcontracting2_5),
						VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
						VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
						VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
						VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
						VALUE(Enum.BusinessTransactions.ErrorCorrection),
						VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
						VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS ShippedQuantity,
		CASE
			WHEN CompanyGoods.BusinessOperation =
						(VALUE(Enum.BusinessTransactions.RedemptionOfProviderGoods))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS RedeemedQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND CompanyGoods.BusinessOperation IN
						(VALUE(Enum.BusinessTransactions.GoodsMisgrading),
						VALUE(Enum.BusinessTransactions.MisgradingOfGoodsAtToller),
						VALUE(Enum.BusinessTransactions.GoodsDamage),
						VALUE(Enum.BusinessTransactions.DamageAtToller))
				THEN CompanyGoods.Count
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND CompanyGoods.BusinessOperation IN
						(VALUE(Enum.BusinessTransactions.GoodsMisgrading),
						VALUE(Enum.BusinessTransactions.MisgradingOfGoodsAtToller),
						VALUE(Enum.BusinessTransactions.GoodsDamage),
						VALUE(Enum.BusinessTransactions.DamageAtToller))
				THEN -CompanyGoods.Count
			ELSE 0
		END                                              AS SpoilageReSortingQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND CompanyGoods.BusinessOperation IN
						(VALUE(Enum.BusinessTransactions.GoodsConsumption),
						VALUE(Enum.BusinessTransactions.GoodsConsumptionOnDemand),
						VALUE(Enum.BusinessTransactions.GoodsWriteOffAtToller))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS DebitedQuantity,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND NOT CompanyGoods.ToRegisterGoodsIssue = 0
				THEN CompanyGoods.ToRegisterGoodsIssue
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Expense)
				AND NOT CompanyGoods.ToRegisterGoodsIssue = 0
				THEN -CompanyGoods.ToRegisterGoodsIssue
			ELSE 0
		END                                              AS AmountToBeDebited,
		CASE
			WHEN CompanyGoods.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND CompanyGoods.BusinessOperation IN
					(VALUE(Enum.BusinessTransactions.ReportToMaterialProvider2_5),
					VALUE(Enum.BusinessTransactions.Subcontracting2_5),
					VALUE(Enum.BusinessTransactions.RepairProductsFromProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformWorksUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.PerformRMUsingProvidedMaterials2_5),
					VALUE(Enum.BusinessTransactions.AdjustmentUnderApprovalOfParties),
					VALUE(Enum.BusinessTransactions.ErrorCorrection),
					VALUE(Enum.BusinessTransactions.AdjustmentOfImplementationDebtReductionConsolidated),
					VALUE(Enum.BusinessTransactions.AdjustmentOfSalesIncreaseInDebtConsolidated))
				THEN CompanyGoods.Count
			ELSE 0
		END                                              AS CompletedReports
	}
	
	UNION ALL
	
	SELECT
		CompanySafeStock.Recorder                      AS Recorder,
		CompanySafeStock.Period                           AS SecondPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, YEAR)       AS YearPeriod,
		
		CompanySafeStock.Organization                      AS Organization,
		CompanySafeStock.InventoryOwnerAttribute.GoodsOwner                 AS Owner,
		CompanySafeStock.InventoryOwnerAttribute.Contract                        AS Contract,
		CompanySafeStock.ItemsLocationAttributes.StorageLocation  AS StorageLocation,
		CompanySafeStock.ItemsLocationAttributes.Products   AS Products,
		CompanySafeStock.ItemsLocationAttributes.Characteristic AS Characteristic,
		CompanySafeStock.ItemsLocationAttributes.Purpose     AS Purpose,
		CompanySafeStock.ItemsLocationAttributes.Series          AS Series,
		CompanySafeStock.CCDNumber                         AS CCDNumber,
		0                                                          AS InitialBalanceQuantity,
		0                                                          AS ToBeReceivedQuantity,
		0                                                          AS ReceivedQuantity,
		0                                                          AS ProducedQuantity,
		0                                                          AS AmountUsedUp,
		0                                                          AS QuantityToBeShipped,
		0                                                          AS ShippedQuantity,
		0                                                          AS RedeemedQuantity,
		CASE
			WHEN CompanySafeStock.RecordType = VALUE(AccumulationRecordType.Expense)
				THEN CompanySafeStock.Count
			WHEN CompanySafeStock.RecordType = VALUE(AccumulationRecordType.Receipt)
				THEN -CompanySafeStock.Count
			ELSE 0
		END                                                      AS QuantityToBeRedeemed,
		0                                                          AS SpoilageReSortingQuantity,
		0                                                          AS DebitedQuantity,
		0                                                          AS AmountToBeDebited,
		0                                                          AS FinalRemainderQuantity,
		0                                                          AS ToDesignOfReports,
		0                                                          AS CompletedReports
	FROM
		AccumulationRegister.CompanySafeStock AS CompanySafeStock
	WHERE
		
		CompanySafeStock.InventoryOwnerAttribute.InventoryType IN
			(VALUE(Enum.InventoryTypes.MaterialOfMaterialProvider),
			VALUE(Enum.InventoryTypes.SemiFinishedProductOfMaterialProvider),
			VALUE(Enum.InventoryTypes.ProductsOfMaterialProvider))
	{WHERE
		CompanySafeStock.Period BETWEEN &amp;StartDate AND &amp;EndDate OR &amp;EndDate = DATETIME(1,1,1),
		CompanySafeStock.ItemsLocationAttributes.*,
		CompanySafeStock.InventoryOwnerAttribute.*,
		CompanySafeStock.Recorder                      AS Recorder,
		CompanySafeStock.Period                           AS SecondPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(CompanySafeStock.Period, YEAR)       AS YearPeriod,
		
		CompanySafeStock.Organization.*                    AS Organization,
		CompanySafeStock.InventoryOwnerAttribute.GoodsOwner.*                 AS Owner,
		CompanySafeStock.InventoryOwnerAttribute.Contract.*                        AS Contract,
		CompanySafeStock.ItemsLocationAttributes.StorageLocation.*  AS StorageLocation,
		CompanySafeStock.ItemsLocationAttributes.Products.*   AS Products,
		CompanySafeStock.ItemsLocationAttributes.Characteristic.* AS Characteristic,
		CompanySafeStock.ItemsLocationAttributes.Purpose.*     AS Purpose,
		CompanySafeStock.ItemsLocationAttributes.Series.*          AS Series,
		CompanySafeStock.CCDNumber.*                       AS CCDNumber,
		CASE
			WHEN CompanySafeStock.RecordType = VALUE(AccumulationRecordType.Expense)
				THEN CompanySafeStock.Count
			WHEN CompanySafeStock.RecordType = VALUE(AccumulationRecordType.Receipt)
				THEN -CompanySafeStock.Count
			ELSE 0
		END                                                      AS QuantityToBeRedeemed
	}
	
	UNION ALL
	
	SELECT
		JobsForMaterialProvider.Recorder                      AS Recorder,
		JobsForMaterialProvider.Period                           AS SecondPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, YEAR)       AS YearPeriod,
		
		JobsForMaterialProvider.Organization                      AS Organization,
		JobsForMaterialProvider.Purpose.Partner               AS Owner,
		JobsForMaterialProvider.Purpose.Contract               AS Contract,
		JobsForMaterialProvider.Department                    AS StorageLocation,
		JobsForMaterialProvider.Products                     AS Products,
		JobsForMaterialProvider.Characteristic                   AS Characteristic,
		JobsForMaterialProvider.Purpose                       AS Purpose,
		JobsForMaterialProvider.Series                            AS Series,
		VALUE(Catalog.CCDNumbers.EmptyRef)      AS CCDNumber,
		0                                                AS InitialBalanceQuantity,
		0                                                AS ToBeReceivedQuantity,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND NOT VALUETYPE(JobsForMaterialProvider.Recorder) IN (
						TYPE(Document.SubcontractorReport2_5),
						TYPE(Document.BackflushProduction),
						TYPE(Document.RecyclableWasteAllocation),
						TYPE(Document.ProductionStage2_2))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS ReceivedQuantity,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(JobsForMaterialProvider.Recorder) IN (
						TYPE(Document.SubcontractorReport2_5),
						TYPE(Document.BackflushProduction),
						TYPE(Document.RecyclableWasteAllocation),
						TYPE(Document.ProductionStage2_2))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS ProducedQuantity,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(JobsForMaterialProvider.Recorder) IN (
						TYPE(Document.SubcontractorReport2_5),
						TYPE(Document.BackflushProduction),
						TYPE(Document.ProductionStage2_2))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS AmountUsedUp,
		0                                                AS QuantityToBeShipped,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Expense)
				AND NOT VALUETYPE(JobsForMaterialProvider.Recorder) IN (
						TYPE(Document.SubcontractorReport2_5),
						TYPE(Document.BackflushProduction),
						TYPE(Document.RecyclableWasteAllocation),
						TYPE(Document.ProductionStage2_2))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS ShippedQuantity,
		0                                                AS RedeemedQuantity,
		0                                                AS QuantityToBeRedeemed,
		0                                                AS SpoilageReSortingQuantity,
		0                                                AS DebitedQuantity,
		0                                                AS AmountToBeDebited,
		0                                                AS FinalRemainderQuantity,
		0                                                AS ToDesignOfReports,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(JobsForMaterialProvider.Recorder) IN
					(TYPE(Document.SaleAdjustment),
					TYPE(Document.ReportToMaterialProvider2_5))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS CompletedReports
	FROM
		AccumulationRegister.MaterialsAndWorksInProduction AS JobsForMaterialProvider
	WHERE
		JobsForMaterialProvider.Products.ItemsType = VALUE(Enum.ItemsTypes.Work_5)
		AND JobsForMaterialProvider.Purpose.AssignmentType = VALUE(Enum.AssignmentTypes.Giveaway2_5)
	{WHERE
		JobsForMaterialProvider.Period BETWEEN &amp;StartDate AND &amp;EndDate OR &amp;EndDate = DATETIME(1,1,1),
		JobsForMaterialProvider.Recorder                      AS Recorder,
		JobsForMaterialProvider.Period                           AS SecondPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(JobsForMaterialProvider.Period, YEAR)       AS YearPeriod,
		
		JobsForMaterialProvider.Organization                      AS Organization,
		JobsForMaterialProvider.Purpose.Partner               AS Owner,
		JobsForMaterialProvider.Purpose.Contract               AS Contract,
		JobsForMaterialProvider.Department                    AS StorageLocation,
		JobsForMaterialProvider.Products                     AS Products,
		JobsForMaterialProvider.Characteristic                   AS Characteristic,
		JobsForMaterialProvider.Purpose                       AS Purpose,
		JobsForMaterialProvider.Series                            AS Series,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND NOT VALUETYPE(JobsForMaterialProvider.Recorder) IN (
						TYPE(Document.SubcontractorReport2_5),
						TYPE(Document.BackflushProduction),
						TYPE(Document.RecyclableWasteAllocation),
						TYPE(Document.ProductionStage2_2))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS ReceivedQuantity,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Receipt)
				AND VALUETYPE(JobsForMaterialProvider.Recorder) IN (
						TYPE(Document.SubcontractorReport2_5),
						TYPE(Document.BackflushProduction),
						TYPE(Document.RecyclableWasteAllocation),
						TYPE(Document.ProductionStage2_2))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS ProducedQuantity,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(JobsForMaterialProvider.Recorder) IN (
						TYPE(Document.SubcontractorReport2_5),
						TYPE(Document.BackflushProduction),
						TYPE(Document.ProductionStage2_2))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS AmountUsedUp,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Expense)
				AND NOT VALUETYPE(JobsForMaterialProvider.Recorder) IN (
						TYPE(Document.SubcontractorReport2_5),
						TYPE(Document.BackflushProduction),
						TYPE(Document.RecyclableWasteAllocation),
						TYPE(Document.ProductionStage2_2))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS ShippedQuantity,
		CASE
			WHEN JobsForMaterialProvider.RecordType = VALUE(AccumulationRecordType.Expense)
				AND VALUETYPE(JobsForMaterialProvider.Recorder) IN
					(TYPE(Document.SaleAdjustment),
					TYPE(Document.ReportToMaterialProvider2_5))
				THEN JobsForMaterialProvider.Count
			ELSE 0
		END                                            AS CompletedReports
	}
	
	UNION ALL
	
	SELECT
		PurchaseOrders.Recorder                      AS Recorder,
		PurchaseOrders.Period                           AS SecondPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, YEAR)       AS YearPeriod,
		
		DocumentsRegistry.Organization                       AS Organization,
		DocumentsRegistry.Partner                           AS Owner,
		DocumentsRegistry.Contract                           AS Contract,
		PurchaseOrders.Warehouse                            AS StorageLocation,
		PurchaseOrders.Products                     AS Products,
		PurchaseOrders.Characteristic                   AS Characteristic,
		OrderingMaterials.Purpose                          AS Purpose,
		VALUE(Catalog.ItemsBatches.EmptyRef) AS Series,
		VALUE(Catalog.CCDNumbers.EmptyRef)        AS CCDNumber,
		0                                                  AS InitialBalanceQuantity,
		CASE
			WHEN PurchaseOrders.RecordType = VALUE(AccumulationRecordType.Receipt)
				THEN PurchaseOrders.ToRegister
			ELSE -PurchaseOrders.ToRegister
		END                                              AS ToBeReceivedQuantity,
		0                                                  AS ReceivedQuantity,
		0                                                  AS ProducedQuantity,
		0                                                  AS AmountUsedUp,
		0                                                  AS QuantityToBeShipped,
		0                                                  AS ShippedQuantity,
		0                                                  AS RedeemedQuantity,
		0                                                  AS QuantityToBeRedeemed,
		0                                                  AS SpoilageReSortingQuantity,
		0                                                  AS DebitedQuantity,
		0                                                  AS AmountToBeDebited,
		0                                                  AS FinalRemainderQuantity,
		0                                                  AS ToDesignOfReports,
		0                                                  AS CompletedReports
	FROM
		AccumulationRegister.PurchaseOrders AS PurchaseOrders
		
		{LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON DocumentsRegistry.Ref = PurchaseOrders.PurchaseOrder
		
		INNER JOIN Document.MaterialProviderOrder2_5.UsedMaterials AS OrderingMaterials
		ON OrderingMaterials.Ref = PurchaseOrders.PurchaseOrder
		AND OrderingMaterials.RowCode = PurchaseOrders.RowCode}
		
	WHERE
		VALUETYPE(PurchaseOrders.PurchaseOrder) = TYPE(Document.MaterialProviderOrder2_5)
	{WHERE
		PurchaseOrders.Period BETWEEN &amp;StartDate AND &amp;EndDate OR &amp;EndDate = DATETIME(1,1,1),
		PurchaseOrders.Recorder                      AS Recorder,
		PurchaseOrders.Period                           AS SecondPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(PurchaseOrders.Period, YEAR)       AS YearPeriod,
		
		DocumentsRegistry.Organization.*                     AS Organization,
		DocumentsRegistry.Partner.*                         AS Owner,
		DocumentsRegistry.Contract.*                         AS Contract,
		PurchaseOrders.Warehouse.*                          AS StorageLocation,
		PurchaseOrders.Products.*                   AS Products,
		PurchaseOrders.Characteristic.*                 AS Characteristic,
		OrderingMaterials.Purpose.*                        AS Purpose,
		CASE
			WHEN PurchaseOrders.RecordType = VALUE(AccumulationRecordType.Receipt)
				THEN PurchaseOrders.ToRegister
			ELSE -PurchaseOrders.ToRegister
		END                                              AS ToBeReceivedQuantity
	}
	
	UNION ALL
	
	SELECT
		SalesOrders.Recorder                      AS Recorder,
		SalesOrders.Period                           AS SecondPeriod,
		BEGINOFPERIOD(SalesOrders.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(SalesOrders.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(SalesOrders.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(SalesOrders.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(SalesOrders.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(SalesOrders.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(SalesOrders.Period, YEAR)       AS YearPeriod,
		
		DocumentsRegistry.Organization                    AS Organization,
		DocumentsRegistry.Partner                        AS Owner,
		DocumentsRegistry.Contract                        AS Contract,
		SalesOrders.Warehouse                            AS StorageLocation,
		SalesOrders.Products                     AS Products,
		SalesOrders.Characteristic                   AS Characteristic,
		GiverSOrders.Purpose                       AS Purpose,
		SalesOrders.Series                            AS Series,
		VALUE(Catalog.CCDNumbers.EmptyRef)     AS CCDNumber,
		0                                               AS InitialBalanceQuantity,
		0                                               AS ToBeReceivedQuantity,
		0                                               AS ReceivedQuantity,
		0                                               AS ProducedQuantity,
		0                                               AS AmountUsedUp,
		CASE
			WHEN SalesOrders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
				THEN SalesOrders.Count
			ELSE -SalesOrders.Count
		END                                              AS QuantityToBeShipped,
		0                                                  AS ShippedQuantity,
		0                                                  AS RedeemedQuantity,
		0                                                  AS QuantityToBeRedeemed,
		0                                                  AS SpoilageReSortingQuantity,
		0                                                  AS DebitedQuantity,
		0                                                  AS AmountToBeDebited,
		0                                                  AS FinalRemainderQuantity,
		0                                                  AS ToDesignOfReports,
		0                                                  AS CompletedReports
	FROM
		AccumulationRegister.ShipmentAndReturnReferences AS SalesOrders
		
		{LEFT JOIN InformationRegister.DocumentsRegistry AS DocumentsRegistry
		ON DocumentsRegistry.Ref = SalesOrders.ReferenceOrder
		
		INNER JOIN Document.MaterialProviderOrder2_5 AS GiverSOrders
		ON GiverSOrders.Ref = SalesOrders.ReferenceOrder}
		
	WHERE
		VALUETYPE(SalesOrders.ReferenceOrder) = TYPE(Document.MaterialProviderOrder2_5)
		AND SalesOrders.Factor IN
			(VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip),
			VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.Shipped))
	{WHERE
		SalesOrders.Period BETWEEN &amp;StartDate AND &amp;EndDate OR &amp;EndDate = DATETIME(1,1,1),
		SalesOrders.Recorder                      AS Recorder,
		SalesOrders.Period                           AS SecondPeriod,
		BEGINOFPERIOD(SalesOrders.Period, DAY)      AS DayPeriod,
		BEGINOFPERIOD(SalesOrders.Period, WEEK)    AS WeekPeriod,
		BEGINOFPERIOD(SalesOrders.Period, TENDAYS)    AS TenDaysPeriod,
		BEGINOFPERIOD(SalesOrders.Period, MONTH)     AS MonthPeriod,
		BEGINOFPERIOD(SalesOrders.Period, QUARTER)   AS QuarterPeriod,
		BEGINOFPERIOD(SalesOrders.Period, HALFYEAR) AS HalfYearPeriod,
		BEGINOFPERIOD(SalesOrders.Period, YEAR)       AS YearPeriod,
		
		DocumentsRegistry.Organization.*                  AS Organization,
		DocumentsRegistry.Partner.*                      AS Owner,
		DocumentsRegistry.Contract.*                      AS Contract,
		SalesOrders.Warehouse.*                          AS StorageLocation,
		SalesOrders.Products.*                   AS Products,
		SalesOrders.Characteristic.*                 AS Characteristic,
		GiverSOrders.Purpose.*                     AS Purpose,
		SalesOrders.Series.*                          AS Series,
		CASE
			WHEN SalesOrders.Factor = VALUE(Enum.IndicatorsOfShipmentAndReturnReferences.ToShip)
				THEN SalesOrders.Count
			ELSE -SalesOrders.Count
		END AS QuantityToBeShipped
	}) AS GoodsAcceptedForProcessing
	
	LEFT JOIN Catalog.Products AS ProductData_1
	ON GoodsAcceptedForProcessing.Products = ProductData_1.Ref
	
{WHERE
	ProductData_1.UnitOfMeasure.*           AS StorageUnit,
	ProductData_1.UnitForReports.*          AS UnitForReports,
	CASE
		WHEN &amp;QuantityUnits = 0
			THEN ProductData_1.UnitOfMeasure
		WHEN &amp;QuantityUnits = 1
			THEN ProductData_1.UnitForReports
	END                                           AS ReportUnit,
	ProductData_1.UnitFactorForReports AS UnitFactorForReports
}</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>RedeemedQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(RedeemedQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountUsedUp</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(AmountUsedUp)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityToBeRedeemed</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(QuantityToBeRedeemed)
End</expression>
	</totalField>
	<totalField>
		<dataPath>FinalRemainderQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(FinalRemainderQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToDesignOfReports</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ToDesignOfReports)
End</expression>
	</totalField>
	<totalField>
		<dataPath>AmountToBeDebited</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(AmountToBeDebited)
End</expression>
	</totalField>
	<totalField>
		<dataPath>InitialBalanceQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(InitialBalanceQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ShippedQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ShippedQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ReceivedQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ReceivedQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ProducedQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ProducedQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>DebitedQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(DebitedQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>CompletedReports</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(CompletedReports)
End</expression>
	</totalField>
	<totalField>
		<dataPath>SpoilageReSortingQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(SpoilageReSortingQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>ToBeReceivedQuantity</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(ToBeReceivedQuantity)
End</expression>
	</totalField>
	<totalField>
		<dataPath>QuantityToBeShipped</dataPath>
		<expression>Case
    When &amp;QuantitativeResultsForUnits And Count(Distinct ReportUnit) &gt; 1
        Then 0
    Else Sum(QuantityToBeShipped)
End</expression>
	</totalField>
