	<parameter>
		<name>ThereIsNegativeInventory</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>There is negative inventory</v8:content>
			</v8:item>
			<v8:item>
