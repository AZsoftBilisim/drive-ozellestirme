			<field xsi:type="DataSetFieldField">
				<dataPath>Characteristic</dataPath>
				<field>Characteristic</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ThereIsACreditAndDebitBalance</dataPath>
				<field>ThereIsACreditAndDebitBalance</field>
				<valueType>
					<v8:Type>xs:boolean</v8:Type>
				</valueType>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ProductSegment</dataPath>
				<field>ProductSegment</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ItemsLocationAttributes</dataPath>
				<field>ItemsLocationAttributes</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Warehouse</dataPath>
				<field>Warehouse</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Series</dataPath>
				<field>Series</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Purpose</dataPath>
				<field>Purpose</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Dimension.DimensionKey AS ItemsLocationAttributes,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
	
	INNER JOIN
		InformationRegister.ItemsLocationAttributes AS Dimension
	ON
		Segments.Products = Dimension.Products
		AND Segments.Characteristic = Dimension.Characteristic
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	ItemsLocationAttributes,
	FilterByProductSegmentIsUsed
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	CompanyGoods.Organization AS Organization,
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	CompanyGoods.Period AS Period
INTO TTTableOfNegativeBalances
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(, , Month, , 
		{(ItemsLocationAttributes IN (
			SELECT
				SelectionByProductSegment.ItemsLocationAttributes
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))
		}
		) AS CompanyGoods
WHERE
	CompanyGoods.CountClosingBalance &lt; 0
	AND CompanyGoods.CountOpeningBalance &lt;&gt; CompanyGoods.CountClosingBalance
	AND &amp;ThereIsACreditAndDebitBalance

INDEX BY
	Organization,
	ItemsLocationAttributes,
	Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.Organization AS Organization,
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	CompanyGoods.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CompanyGoods.CCDNumber AS CCDNumber,
	CompanyGoods.Period AS Period,
	TRUE AS ThereIsACreditAndDebitBalance
INTO TTTableExpandedBalance
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(, , Month, , 
		{((ItemsLocationAttributes) IN (
			SELECT
				SelectionByProductSegment.ItemsLocationAttributes
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed))
		}) AS CompanyGoods
		
		LEFT JOIN TTTableOfNegativeBalances AS TableOfNegativeResiduals
		ON CompanyGoods.Organization = TableOfNegativeResiduals.Organization
			AND CompanyGoods.ItemsLocationAttributes = TableOfNegativeResiduals.ItemsLocationAttributes
			AND CompanyGoods.Period = TableOfNegativeResiduals.Period
WHERE
	CompanyGoods.CountClosingBalance &lt; 0
	AND CompanyGoods.CountOpeningBalance &lt;&gt; CompanyGoods.CountClosingBalance
	AND TableOfNegativeResiduals.Period IS NULL 
	AND &amp;ThereIsACreditAndDebitBalance

INDEX BY
	Organization,
	ItemsLocationAttributes,
	InventoryOwnerAttribute,
	CCDNumber,
	Period
;

////////////////////////////////////////////////////////////////////////////////
SELECT DISTINCT
	TableExpandedBalance.Organization,
	TableExpandedBalance.ItemsLocationAttributes,
	TableExpandedBalance.Period
INTO TTTableSelectionOfProductsByPeriod
FROM
	TTTableExpandedBalance AS TableExpandedBalance
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.Organization AS Organization,
	CompanyGoods.ItemsLocationAttributes.Products AS Products,
	CompanyGoods.ItemsLocationAttributes.Characteristic AS Characteristic,
	CompanyGoods.ItemsLocationAttributes.Series AS Series,
	CompanyGoods.ItemsLocationAttributes.StorageLocation AS Warehouse,
	CompanyGoods.ItemsLocationAttributes.Purpose AS Purpose,
	CompanyGoods.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CompanyGoods.CCDNumber AS CCDNumber,
	CompanyGoods.MonthPeriod AS Period,
	CompanyGoods.SecondPeriod AS SecondPeriod,
	CASE
		WHEN CompanyGoods.Recorder = UNDEFINED
			THEN NULL
		ELSE CompanyGoods.Recorder
	END AS Recorder,
	CompanyGoods.CountOpeningBalance AS CountOpeningBalance,
	CompanyGoods.CountReceipt AS CountReceipt,
	CompanyGoods.CountExpense AS CountExpense,
	CompanyGoods.CountClosingBalance AS CountClosingBalance,
	ISNULL(TableExpandedBalance.ThereIsACreditAndDebitBalance, FALSE) AS ThereIsACreditAndDebitBalance
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(
			,
			,
			Auto,
			RegisterRecords,
			&amp;ThereIsACreditAndDebitBalance
				AND (Organization, ItemsLocationAttributes) IN
					(SELECT
						TableExpandedBalance.Organization,
						TableExpandedBalance.ItemsLocationAttributes
					FROM
						TTTableExpandedBalance AS TableExpandedBalance)
	) AS CompanyGoods
	
	INNER JOIN
		TTTableSelectionOfProductsByPeriod AS TableSelectionOfProductsByPeriod
	ON
		CompanyGoods.Organization = TableSelectionOfProductsByPeriod.Organization
		AND CompanyGoods.ItemsLocationAttributes = TableSelectionOfProductsByPeriod.ItemsLocationAttributes
		AND CompanyGoods.MonthPeriod = TableSelectionOfProductsByPeriod.Period
		
	LEFT JOIN
		TTTableExpandedBalance AS TableExpandedBalance
	ON
		CompanyGoods.Organization = TableExpandedBalance.Organization
		AND CompanyGoods.ItemsLocationAttributes = TableExpandedBalance.ItemsLocationAttributes
		AND CompanyGoods.InventoryOwnerAttribute = TableExpandedBalance.InventoryOwnerAttribute
		AND CompanyGoods.CCDNumber = TableExpandedBalance.CCDNumber
		AND CompanyGoods.MonthPeriod = TableExpandedBalance.Period</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>Negative_Balance</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>InventoryOwnerAttribute</dataPath>
