				</role>
			</field>
			<dataSource>DataSource1</dataSource>
			<query>SELECT ALLOWED DISTINCT
	Dimension.DimensionKey AS ItemsLocationAttributes,
	TRUE AS FilterByProductSegmentIsUsed
INTO SelectionByProductSegment
FROM
	InformationRegister.SegmentProducts AS Segments
	
	INNER JOIN
		InformationRegister.ItemsLocationAttributes AS Dimension
	ON
		Segments.Products = Dimension.Products
		AND Segments.Characteristic = Dimension.Characteristic
{WHERE
	Segments.Segment.* AS ProductSegment,
	Segments.Products.* AS Products,
	Segments.Characteristic.* AS Characteristic}

INDEX BY
	ItemsLocationAttributes,
	FilterByProductSegmentIsUsed
;
////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	CompanyGoods.Organization AS Organization,
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	CompanyGoods.Period AS Period,
	TRUE AS ThereIsNegativeInventory

INTO TTTableOfNegativeBalances
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(, , Month,, 
		{(ItemsLocationAttributes) IN (
			SELECT
				SelectionByProductSegment.ItemsLocationAttributes
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed
			)
		}
	) AS CompanyGoods
WHERE
	CompanyGoods.CountClosingBalance &lt; 0
	AND CompanyGoods.CountOpeningBalance &lt;&gt; CompanyGoods.CountClosingBalance
	AND &amp;ThereIsNegativeInventory

INDEX BY
	Organization,
	ItemsLocationAttributes,
	Period
;
/////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED DISTINCT
	CompanyGoods.ItemsLocationAttributes AS ItemsLocationAttributes,
	CompanyGoods.Period AS Period,
	TRUE AS ThereAreMissingGoods

INTO TTTableMissingItems
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(, , Month,, 
		{(ItemsLocationAttributes) IN (
			SELECT
				SelectionByProductSegment.ItemsLocationAttributes
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed
			)
		}
	) AS CompanyGoods
WHERE
	CompanyGoods.CountClosingBalance &lt; 0
	AND CompanyGoods.CountOpeningBalance &lt;&gt; CompanyGoods.CountClosingBalance
	AND &amp;ThereIsNegativeInventory

INDEX BY
	ItemsLocationAttributes,
	Period
;
/////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	CompanyGoods.Organization AS Organization,
	Dimension.Products AS Products,
	Dimension.Characteristic AS Characteristic,
	Dimension.Series AS Series,
	Dimension.StorageLocation AS Warehouse,
	Dimension.Purpose AS Purpose,
	CompanyGoods.InventoryOwnerAttribute AS InventoryOwnerAttribute,
	CompanyGoods.CCDNumber AS CCDNumber,
	CompanyGoods.MonthPeriod AS Period,
	CompanyGoods.SecondPeriod AS SecondPeriod,
	
	CASE WHEN CompanyGoods.Recorder = UNDEFINED THEN
		NULL
	ELSE
		CompanyGoods.Recorder
	END AS Recorder,
	
	CompanyGoods.CountOpeningBalance AS CountOpeningBalance,
	CompanyGoods.CountReceipt AS CountReceipt,
	CompanyGoods.CountExpense AS CountExpense,
	CompanyGoods.CountClosingBalance AS CountClosingBalance,
	
	CASE WHEN CompanyGoods.CountClosingBalance &lt; 0 THEN
		-CompanyGoods.CountClosingBalance
	ELSE
		0
	END AS QuantityToRegister,
	
	CASE WHEN CompanyGoods.CountClosingBalance &gt; 0 THEN
		CompanyGoods.CountClosingBalance
	ELSE
		0
	END AS QuantityInStock,
	
	ISNULL(TableOfNegativeResiduals.ThereIsNegativeInventory, FALSE) AS ThereIsNegativeInventory,
	CASE WHEN CompanyGoods.CountClosingBalance &lt; 0
		THEN ISNULL(TableMissingProducts.ThereAreMissingGoods, FALSE)
		ELSE FALSE
	END AS ThereAreMissingGoods
FROM
	AccumulationRegister.CompanyGoods.BalanceAndTurnovers(, , Auto, , 
		&amp;ThereIsNegativeInventory
		AND (ItemsLocationAttributes) IN (
			SELECT
				TableOfNegativeResiduals.ItemsLocationAttributes
			FROM
				TTTableOfNegativeBalances AS TableOfNegativeResiduals)
		{(ItemsLocationAttributes) IN (
			SELECT
				SelectionByProductSegment.ItemsLocationAttributes
			FROM
				SelectionByProductSegment
			WHERE
				SelectionByProductSegment.FilterByProductSegmentIsUsed = &amp;FilterByProductSegmentIsUsed
			)
		}
		
	) AS CompanyGoods
	
	INNER JOIN
		Catalog.InventoryLocationAttributeKeys AS Dimension
	ON
		CompanyGoods.ItemsLocationAttributes = Dimension.Ref
	
	LEFT JOIN
		TTTableOfNegativeBalances AS TableOfNegativeResiduals
	ON
		CompanyGoods.Organization = TableOfNegativeResiduals.Organization
		AND CompanyGoods.ItemsLocationAttributes = TableOfNegativeResiduals.ItemsLocationAttributes
		AND CompanyGoods.MonthPeriod = TableOfNegativeResiduals.Period
		
	LEFT JOIN
		TTTableMissingItems AS TableMissingProducts
	ON
		CompanyGoods.ItemsLocationAttributes = TableMissingProducts.ItemsLocationAttributes
		AND CompanyGoods.MonthPeriod = TableMissingProducts.Period
WHERE
	&amp;OnlyNegativeInventory AND CompanyGoods.CountClosingBalance &lt; 0
	OR NOT &amp;OnlyNegativeInventory</query>
		</item>
	</dataSet>
	<totalField>
		<dataPath>CountClosingBalance</dataPath>
		<expression>Sum(CountClosingBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>CountOpeningBalance</dataPath>
		<expression>Sum(CountOpeningBalance)</expression>
	</totalField>
	<totalField>
		<dataPath>CountReceipt</dataPath>
		<expression>Sum(CountReceipt)</expression>
	</totalField>
	<totalField>
		<dataPath>CountExpense</dataPath>
		<expression>Sum(CountExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>ThereIsACreditAndDebitBalance</dataPath>
		<expression>Max(ThereIsACreditAndDebitBalance)</expression>
	</totalField>
