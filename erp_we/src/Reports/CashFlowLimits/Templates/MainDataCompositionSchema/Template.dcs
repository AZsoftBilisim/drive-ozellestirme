	<totalField>
		<dataPath>Deviation</dataPath>
		<expression>Case When Max(LimitIsNotSet) Then 0 Else Sum(Limit) - Sum(ConsumptionWithinLimit) - Sum(ExcessExpense) End</expression>
	</totalField>
	<totalField>
		<dataPath>Limit</dataPath>
		<expression>Sum(Limit)</expression>
	</totalField>
	<totalField>
		<dataPath>Available</dataPath>
		<expression>Sum(Available)</expression>
	</totalField>
	<totalField>
		<dataPath>ConsumptionWithinLimit</dataPath>
		<expression>Sum(ConsumptionWithinLimit)</expression>
	</totalField>
	<totalField>
		<dataPath>ExcessExpense</dataPath>
		<expression>Sum(ExcessExpense)</expression>
	</totalField>
	<totalField>
		<dataPath>Underconsumption</dataPath>
		<expression>Case When Max(LimitIsNotSet) Then 0 
When Sum(Limit) - Sum(ConsumptionWithinLimit) - Sum(ExcessExpense)&gt; 0 
Then Sum(Limit) - Sum(ConsumptionWithinLimit) - Sum(ExcessExpense) End</expression>
	</totalField>
	<totalField>
		<dataPath>overspending</dataPath>
		<expression>Case When Max(LimitIsNotSet) Then 0 
When Sum(ConsumptionWithinLimit) + Sum(ExcessExpense) - Sum(Limit) &gt; 0 
Then Sum(ConsumptionWithinLimit) + Sum(ExcessExpense) - Sum(Limit) End</expression>
	</totalField>
	<totalField>
		<dataPath>PercentageOfExpense</dataPath>
		<expression>Case When Max(LimitIsNotSet) Then 0 When Sum(Limit) = 0 And (Sum(ConsumptionWithinLimit) + Sum(ExcessExpense)) = 0 Then 0 When Sum(Limit) = 0 Then 100 Else (Sum(ConsumptionWithinLimit) + Sum(ExcessExpense)) / Sum(Limit) * 100 End</expression>
	</totalField>
