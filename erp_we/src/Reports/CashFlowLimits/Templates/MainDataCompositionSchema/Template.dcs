		<dataSource>DataSource1</dataSource>
		<query>SELECT ALLOWED
	DocumentsLimits.CashFlowItem AS CashFlowItem,
	DocumentsLimits.Ref.Period AS Period,
	DocumentsLimits.Ref AS Recorder,
	DocumentsLimits.Ref.PointInTime AS PointInTime,
	DocumentsLimits.Ref.Organization AS Organization,
	DocumentsLimits.Ref.Department AS Department,
	DocumentsLimits.ThereIsLimit AS ThereIsLimit
INTO SpendingLimitsForDocuments
FROM
	Document.CashFlowLimits.Limits AS DocumentsLimits
WHERE
	DocumentsLimits.Ref.Period BETWEEN &amp;BeginOfPeriod AND &amp;EndOfPeriod
	AND DocumentsLimits.Ref.Posted

INDEX BY
	CashFlowItem,
	Period,
	Organization,
	Department
;

////////////////////////////////////////////////////////////////////////////////
SELECT ALLOWED
	SpendingLimitsForDocuments.CashFlowItem,
	SpendingLimitsForDocuments.Organization,
	SpendingLimitsForDocuments.Department,
	999999999999999 AS Limit,
	0 AS ConsumptionWithinLimit,
	0 AS ExcessExpense,
	SpendingLimitsForDocuments.Recorder,
	SpendingLimitsForDocuments.Period AS MonthPeriod,
	BEGINOFPERIOD(SpendingLimitsForDocuments.Period, QUARTER) AS QuarterPeriod,
	BEGINOFPERIOD(SpendingLimitsForDocuments.Period, HALFYEAR) AS HalfYearPeriod,
	BEGINOFPERIOD(SpendingLimitsForDocuments.Period, YEAR) AS YearPeriod,
	TRUE AS LimitIsNotSet
INTO CashFlowLimits
FROM
	SpendingLimitsForDocuments AS SpendingLimitsForDocuments
		LEFT JOIN SpendingLimitsForDocuments AS Filter
		ON SpendingLimitsForDocuments.CashFlowItem = Filter.CashFlowItem
			AND SpendingLimitsForDocuments.Period = Filter.Period
			AND SpendingLimitsForDocuments.Organization = Filter.Organization
			AND SpendingLimitsForDocuments.Department = Filter.Department
			AND SpendingLimitsForDocuments.PointInTime &lt; Filter.PointInTime
WHERE
	Filter.PointInTime IS NULL 
	AND NOT SpendingLimitsForDocuments.ThereIsLimit

UNION ALL

SELECT
	CashFlowLimitsTurnovers.CashFlowItem,
	CashFlowLimitsTurnovers.Organization,
	CashFlowLimitsTurnovers.Department,
	CashFlowLimitsTurnovers.LimitTurnover,
	CashFlowLimitsTurnovers.ConsumptionWithinLimitTurnover,
	CashFlowLimitsTurnovers.ExcessExpenseTurnover,
	CashFlowLimitsTurnovers.Recorder,
	CashFlowLimitsTurnovers.MonthPeriod,
	CashFlowLimitsTurnovers.QuarterPeriod,
	CashFlowLimitsTurnovers.HalfYearPeriod,
	CashFlowLimitsTurnovers.YearPeriod,
	FALSE
FROM
	AccumulationRegister.CashFlowLimits.Turnovers(&amp;BeginOfPeriod, &amp;EndOfPeriod, Auto, ) AS CashFlowLimitsTurnovers
;

////////////////////////////////////////////////////////////////////////////////
SELECT
	CashFlowLimits.CashFlowItem,
	CashFlowLimits.Organization,
	CashFlowLimits.Department,
	SUM(CashFlowLimits.Limit) AS Limit,
	SUM(CashFlowLimits.ConsumptionWithinLimit) AS ConsumptionWithinLimit,
	SUM(CashFlowLimits.ExcessExpense) AS ExcessExpense,
	CashFlowLimits.Recorder,
	CashFlowLimits.MonthPeriod,
	CashFlowLimits.QuarterPeriod,
	CashFlowLimits.HalfYearPeriod,
	CashFlowLimits.YearPeriod,
	MAX(CashFlowLimits.LimitIsNotSet) AS LimitIsNotSet
FROM
	CashFlowLimits AS CashFlowLimits
WHERE
	(&amp;Document = UNDEFINED
			OR &amp;BusinessOperation = VALUE(Enum.BusinessTransactions.EmptyRef)
			OR (CashFlowLimits.CashFlowItem IN
					(SELECT DISTINCT
						DocumentData.CashFlowItem
					FROM
						Document.PaymentRequest AS DocumentData
					WHERE
						DocumentData.Ref = &amp;Document)
				OR CashFlowLimits.CashFlowItem IN
					(SELECT DISTINCT
						Catalog.Ref
					FROM
						Catalog.CashFlowReportItems.BusinessTransactions AS Catalog
					WHERE
						Catalog.BusinessOperation = &amp;BusinessOperation)))

GROUP BY
	CashFlowLimits.CashFlowItem,
	CashFlowLimits.Organization,
	CashFlowLimits.Department,
	CashFlowLimits.Recorder,
	CashFlowLimits.MonthPeriod,
	CashFlowLimits.QuarterPeriod,
	CashFlowLimits.HalfYearPeriod,
	CashFlowLimits.YearPeriod</query>
	</dataSet>
