  <attributes>
    <name>List</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.RestrictUseInPostings</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	International.Ref,
	International.ChartOfAccounts,
	International.Parent,
	International.Code,
	International.Description,
	International.Order,
	CASE International.Type
		WHEN VALUE(AccountType.Active)
			THEN &amp;AssetBalanceSheetName
		WHEN VALUE(AccountType.Passive)
			THEN &amp;Liabilities
		WHEN VALUE(AccountType.ActivePassive)
			THEN &amp;AssetLiability
	END AS Kind,
	International.AccountingByBusinessUnits,
	International.AccountingByLinesOfBusiness,
	International.QuickSelectionCode,
	International.OffBalance,
	International.Reclass,
	International.DescriptionInternational,
	International.RestrictUseInPostings,
	International.LongDesc,
	International.Currency1,
	International.Quantitative,
	ExtDimension1.ExtDimension AS ExtDimension1,
	ExtDimension2.ExtDimension AS ExtDimension2,
	ExtDimension3.ExtDimension AS ExtDimension3
FROM
	ChartOfAccounts.International AS International
		LEFT JOIN (SELECT
			InternationalExtdimensionDay.ExtDimensionType.Description + CASE
				WHEN InternationalExtdimensionDay.TurnoversOnly
					THEN &amp;TurnoversOnly
				ELSE &quot;&quot;
			END AS ExtDimension,
			InternationalExtdimensionDay.Ref AS Ref
		FROM
			ChartOfAccounts.International.ExtDimensionTypes AS InternationalExtdimensionDay
		WHERE
			InternationalExtdimensionDay.LineNumber = 1) AS ExtDimension1
		ON International.Ref = ExtDimension1.Ref
		LEFT JOIN (SELECT
			InternationalExtdimensionDay.ExtDimensionType.Description + CASE
				WHEN InternationalExtdimensionDay.TurnoversOnly
					THEN &amp;TurnoversOnly
				ELSE &quot;&quot;
			END AS ExtDimension,
			InternationalExtdimensionDay.Ref AS Ref
		FROM
			ChartOfAccounts.International.ExtDimensionTypes AS InternationalExtdimensionDay
		WHERE
			InternationalExtdimensionDay.LineNumber = 2) AS ExtDimension2
		ON International.Ref = ExtDimension2.Ref
		LEFT JOIN (SELECT
			InternationalExtdimensionDay.ExtDimensionType.Description + CASE
				WHEN InternationalExtdimensionDay.TurnoversOnly
					THEN &amp;TurnoversOnly
				ELSE &quot;&quot;
			END AS ExtDimension,
			InternationalExtdimensionDay.Ref AS Ref
		FROM
			ChartOfAccounts.International.ExtDimensionTypes AS InternationalExtdimensionDay
		WHERE
			InternationalExtdimensionDay.LineNumber = 3) AS ExtDimension3
		ON International.Ref = ExtDimension3.Ref
WHERE
	International.ChartOfAccounts = &amp;ChartOfAccounts</queryText>
      <mainTable>ChartOfAccounts.International</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
