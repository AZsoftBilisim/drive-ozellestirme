  <items xsi:type="form:Decoration">
    <name>DescriptionNoDiscountsForAppointments</name>
    <id>33</id>
    <title>
      <key>en</key>
      <value>No discounts assigned manually.</value>
    </title>
    <title>
      <key>fa</key>
      <value>هیچ تخفیفی به صورت دستی تخصیص نیافته است.</value>
    </title>
    <title>
      <key>it</key>
      <value>Gli sconti assegnati assegnati manualmente non sini disponibili.</value>
    </title>
    <title>
      <key>pl</key>
      <value>Brak rabatów ustalanych ręcznie.</value>
    </title>
    <title>
      <key>ru</key>
      <value>Скидки, назначаемые вручную отсутствуют.</value>
    </title>
    <title>
      <key>tr</key>
      <value>Manuel olarak atanan indirimler mevcut değil.</value>
    </title>
    <title>
      <key>vi</key>
      <value>Không có chiết khấu được ấn định thủ công.</value>
    </title>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>DescriptionNoDiscountsForAppointmentsExtendedTooltip</name>
      <id>37</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>DescriptionNoDiscountsForAppointmentsContextMenu</name>
