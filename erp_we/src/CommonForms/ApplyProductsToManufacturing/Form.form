      <queryText>SELECT
	EngineeringChangeOrderOverridable.Ref AS Ref,
	EngineeringChangeOrderOverridable.DataVersion AS DataVersion,
	EngineeringChangeOrderOverridable.DeletionMark AS DeletionMark,
	EngineeringChangeOrderOverridable.Number AS Number,
