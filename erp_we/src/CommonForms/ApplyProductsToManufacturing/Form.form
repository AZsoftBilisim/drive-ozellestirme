    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BOMList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogBillsOfMaterials.Ref,
	CatalogBillsOfMaterials.Code,
	CatalogBillsOfMaterials.Description,
	CatalogBillsOfMaterials.Status,
	CatalogBillsOfMaterials.ValidOnDate,
	CatalogBillsOfMaterials.ValidToDate,
	CatalogBillsOfMaterials.EmployeeResponsible,
	CatalogBillsOfMaterials.LongDesc,
	VALUE(Enum.UseOfItemsInProductionMasterData.Material) AS UsedAs
FROM
	Catalog.BillsOfMaterials AS CatalogBillsOfMaterials
WHERE
	TRUE IN (
		SELECT TOP 1
			TRUE
		FROM
			Catalog.BillsOfMaterials.MaterialsAndServices AS FilterOfSpecifications
		WHERE
			FilterOfSpecifications.Ref = CatalogBillsOfMaterials.Ref
			AND FilterOfSpecifications.Products = &amp;FilterProduct
			AND (FilterOfSpecifications.Characteristic = &amp;FilterItemVariantOfProduct
				OR &amp;FilterItemVariantOfProduct = VALUE(Catalog.ItemsCharacteristics.EmptyRef))
	)
	</queryText>
      <mainTable>Catalog.BillsOfMaterials</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
