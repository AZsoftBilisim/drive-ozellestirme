    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	BillsOfMaterialsOverridable.Ref AS BillOfMaterials,

	BillsOfMaterialsOverridable.ValidOnDate AS ValidOnDate,
	BillsOfMaterialsOverridable.ValidToDate AS ValidToDate,

	BillsOfMaterialsOverridable.Status AS Status
FROM
	Catalog.BillsOfMaterials AS BillsOfMaterialsOverridable
</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
