    </title>
    <title>
      <key>vi</key>
      <value>Danh sách tính giá thành kế hoạch 2.2</value>
    </title>
    <id>45</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	VALUE(Document.StandardCosting2_2.EmptyRef) AS Ref,
	FALSE AS DeletionMark,
	CAST(&quot;&quot; AS STRING(9)) AS Number,
	DATETIME(1, 1, 1) AS Date,
	FALSE AS Posted,
	VALUE(Catalog.Companies.EmptyRef) AS Organization,
