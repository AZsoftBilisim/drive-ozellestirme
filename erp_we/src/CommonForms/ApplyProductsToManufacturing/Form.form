	EngineeringChangeOrderOverridable.Posted AS Posted,
	EngineeringChangeOrderOverridable.ValidityStartDate AS ValidityStartDate,
	EngineeringChangeOrderOverridable.ValidityEndDate AS ValidityEndDate,
	EngineeringChangeOrderOverridable.Status AS Status,
	EngineeringChangeOrderOverridable.UsageNote AS UsageNote,
	EngineeringChangeOrderOverridable.EmployeeResponsible AS EmployeeResponsible
FROM
	Document.EngineeringChangeOrder AS EngineeringChangeOrderOverridable</queryText>
