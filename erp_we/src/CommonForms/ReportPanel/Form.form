        <wrap>true</wrap>
        <dropListButton>true</dropListButton>
        <clearButton>true</clearButton>
        <chooseType>true</chooseType>
        <typeDomainEnabled>true</typeDomainEnabled>
        <textEdit>true</textEdit>
        <inputHint>
          <key>en</key>
          <value>Report description, field, or author</value>
        </inputHint>
        <inputHint>
          <key>fa</key>
          <value>شرح گزارش، فیلد یا ایجادکننده</value>
        </inputHint>
        <inputHint>
          <key>it</key>
