    <items xsi:type="form:FormGroup">
      <name>GroupParallelizeCalculation</name>
      <id>10</id>
      <items xsi:type="form:FormField">
        <name>VectorizeCalculation</name>
        <id>7</id>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <dataPath xsi:type="form:DataPath">
          <segments>VectorizeCalculation</segments>
        </dataPath>
        <titleLocation>Right</titleLocation>
        <handlers>
          <event>OnChange</event>
          <name>VectorizeCalculationOnChange</name>
        </handlers>
        <extendedTooltip>
          <name>VectorizeCalculationExtendedTooltip</name>
          <id>9</id>
