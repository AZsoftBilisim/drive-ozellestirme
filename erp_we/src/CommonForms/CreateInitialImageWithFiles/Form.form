    <id>1</id>
    <toolTip>
      <key>en</key>
      <value>Creates an initial infobase image with the specified parameters.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>تصویر اولیه پایگاه اطلاعات را با پارامترهای مشخص‌شده ایجاد می‌کند.</value>
