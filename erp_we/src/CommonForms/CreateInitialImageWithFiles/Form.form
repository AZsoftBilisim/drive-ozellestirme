      <key>it</key>
      <value>Creare un'immagine iniziale della DB con i parametri specificati</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Tworzy obraz początkowy BI ze wskazanymi parametrami</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Выполняет создание начального образа ИБ с указанными параметрами</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>Belirtilen parametrelerle Infobase ilk görüntüsünü oluşturur</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Đang thực hiện việc tạo ảnh ban đầu của CSTT với các tham số đã cho</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>CreateInitialImage</name>
      </handler>
    </action>
    <currentRowUse>DontUse</currentRowUse>
