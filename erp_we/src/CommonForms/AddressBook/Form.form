  <attributes>
    <name>UsersList</name>
    <title>
      <key>en</key>
      <value>User list</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست کاربران</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco utenti</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista użytkowników</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список пользователей</value>
    </title>
    <title>
      <key>tr</key>
      <value>Kullanıcı listesi</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách người sử dụng</value>
    </title>
    <id>6</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UsersList.Description</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>UsersList.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	Users.Ref,
	Users.DeletionMark,
	Users.Predefined,
	Users.Description,
	CASE
		WHEN Users.DeletionMark
			THEN 0
		ELSE 1
	END AS PictureNumber,
	UsersContactInformation.Presentation
FROM
	Catalog.Users AS Users
	LEFT JOIN Catalog.Users.ContactInformation AS UsersContactInformation
	ON (UsersContactInformation.Ref = Users.Ref)
		AND (UsersContactInformation.KindForList = &amp;Email)
WHERE
	Users.IsInternal = FALSE
	AND Users.DeletionMark = FALSE
	AND Users.Invalid = FALSE
	AND TRUE IN
			(SELECT
				TRUE
			FROM
				InformationRegister.UserGroupCompositions AS UserGroupCompositions
			WHERE
				UserGroupCompositions.User = Users.Ref
				AND UserGroupCompositions.UsersGroup = &amp;UsersGroup)
</queryText>
      <mainTable>Catalog.Users</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
