            <items xsi:type="form:FormField">
              <name>MinPasswordLifetime</name>
              <id>25</id>
              <title>
                <key>en</key>
                <value>Minimum password lifetime</value>
              </title>
              <title>
                <key>fa</key>
                <value>حداقل مدت اعتبار رمز عبور</value>
              </title>
              <title>
                <key>it</key>
                <value>Validità minima della password</value>
              </title>
              <title>
                <key>pl</key>
                <value>Minimalny termin ważności hasła</value>
              </title>
              <title>
                <key>ru</key>
                <value>Минимальный срок действия пароля</value>
              </title>
              <title>
                <key>tr</key>
                <value>Parolanın minimum geçerlilik süresi</value>
              </title>
              <title>
                <key>vi</key>
                <value>Thời hạn hiệu lực tối thiểu của mật khẩu</value>
