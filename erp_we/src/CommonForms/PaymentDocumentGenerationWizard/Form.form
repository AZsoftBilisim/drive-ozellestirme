  <attributes>
    <name>CreatedDocuments</name>
    <title>
      <key>en</key>
      <value>Created documents</value>
    </title>
    <title>
      <key>fa</key>
      <value>اسناد ایجادشده</value>
    </title>
    <title>
      <key>it</key>
      <value>Documenti creati</value>
    </title>
    <title>
      <key>pl</key>
      <value>Utworzone dokumenty</value>
    </title>
    <title>
      <key>ru</key>
      <value>Созданные документы</value>
    </title>
    <title>
      <key>tr</key>
      <value>Oluşturulmuş belgeler</value>
    </title>
    <title>
      <key>vi</key>
      <value>Chứng từ đã tạo mới</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CreatedDocuments.BankAccount</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CreatedDocuments.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentData.Posted                       AS Posted,
	DocumentData.DeletionMark                AS DeletionMark,
	DocumentData.IBDocumentNumber               AS Number,
	DocumentData.IBDocumentDate                AS Date,
	DocumentData.RefType                      AS Type,
	DocumentData.BusinessOperation          AS Operation,
	DocumentData.Sum                          AS DocumentAmount,
	DocumentData.Currency                         AS Currency,
	
	DocumentData.Counterparty                     AS RecipientPayer,
	DocumentData.StorageLocation                  AS BankAccountCashAccount,
	DocumentData.StorageLocation                  AS BankAccount,
	DocumentData.Organization                    AS Organization,
	DocumentData.Ref                         AS Ref,
	CASE
		WHEN DocumentData.Posted
			THEN 0
		WHEN DocumentData.DeletionMark
			THEN 1
		ELSE 2
	END AS CustomPicture
FROM
	InformationRegister.DocumentsRegistry AS DocumentData
	
WHERE
	DocumentData.RefType IN (
		&amp;IDOfTheObjectReceiptOfNonCashDS,
		&amp;TheObjectIDOfTheNonCashWriteOffOfDS,
		&amp;IDOfThePKOObject,
		&amp;IDOfTheRKOObject,
		&amp;TheObjectIDOfTheApplication)
</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
