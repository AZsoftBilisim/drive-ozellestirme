    </edit>
    <functionalOptions>FunctionalOption.UseAccountingOfOtherAssetsAndLiabilities</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>AssetLiabilityItems.IsFolder</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>AssetLiabilityItems.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CCT.Ref,
	CCT.DataVersion,
	CCT.DeletionMark,
	CCT.Predefined,
	CCT.Parent,
	CCT.IsFolder,
	CCT.Description AS Description,
	CCT.ValueType,
	CCT.LongDesc,
	CCT.AssetLiability,
	CCT.AddlOrderingAttribute
FROM
	ChartOfCharacteristicTypes.AssetLiabilityItems AS CCT
WHERE
	(CCT.AssetLiability &lt;> VALUE(Enum.KindsOfBalanceSheetStatementItems.EmptyRef)
	OR CCT.DataSource = &amp;OtherAssetsAndLiabilitiesRecords)
	AND
	(CCT.AssetLiability IN (&amp;ArticleActivity)
	OR &amp;NoLimitOnTheAssetLiability)</queryText>
      <mainTable>ChartOfCharacteristicTypes.AssetLiabilityItems</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
