  <attributes>
    <name>List</name>
    <title>
      <key>en</key>
      <value>List</value>
    </title>
    <title>
      <key>fa</key>
      <value>فهرست</value>
    </title>
    <title>
      <key>it</key>
      <value>Elenco</value>
    </title>
    <title>
      <key>pl</key>
      <value>Lista</value>
    </title>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <title>
      <key>tr</key>
      <value>Liste</value>
    </title>
    <title>
      <key>vi</key>
      <value>Danh sách</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Currency</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Date</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Number</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>List.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	DocumentsRegistry.Ref AS Ref,
	DocumentsRegistry.IBDocumentDate AS Date,
	DocumentsRegistry.IBDocumentNumber AS Number,
	DocumentsRegistry.Organization AS Organization,
	DocumentsRegistry.Partner AS Partner,
	DocumentsRegistry.Counterparty AS Counterparty,
	DocumentsRegistry.Sum AS Sum,
	DocumentsRegistry.Currency AS Currency,
	(NOT VALUETYPE(DocumentsRegistry.Ref) IN (TYPE(Document.CustomerInvoice), TYPE(Document.CustomerInvoiceServices))
		OR
		TRUE IN (SELECT TOP 1 TRUE FROM Document.CustomerInvoice AS CustomerInvoice
				WHERE CustomerInvoice.Ref = DocumentsRegistry.Ref 
					AND ISNULL(CustomerInvoice.SalesOrder, UNDEFINED) IN (VALUE(Document.SalesOrder.EmptyRef), UNDEFINED))
		
		OR 
		TRUE IN (SELECT TOP 1 TRUE 
						FROM Document.CustomerInvoiceServices AS CustomerInvoiceServices 
						WHERE CustomerInvoiceServices.Ref = DocumentsRegistry.Ref 
							AND ISNULL(CustomerInvoiceServices.SalesOrder, UNDEFINED) IN (VALUE(Document.SalesOrder.EmptyRef), UNDEFINED))
	) AS OrderIsNotFilledIn,
	VALUETYPE(DocumentsRegistry.Ref) AS Type,
	CASE
		WHEN DocumentsRegistry.Posted
			THEN 0
		WHEN DocumentsRegistry.DeletionMark
			THEN 1
		ELSE 2
	END AS DocumentState
FROM
	InformationRegister.DocumentsRegistry AS DocumentsRegistry
WHERE
	DocumentsRegistry.RefType IN(&amp;RefsTypes)
	AND NOT DocumentsRegistry.AdditionalRecord AND NOT DocumentsRegistry.ReverseTransactionCorrection AND DocumentsRegistry.Posted
	AND ISNULL(CAST(DocumentsRegistry.Ref AS Document.GoodsShipmentToCustomer).SalesOrder, UNDEFINED) = UNDEFINED
	AND NOT DocumentsRegistry.BusinessOperation IN (VALUE(Enum.BusinessTransactions.TransferToCommissionAgent),
													VALUE(Enum.BusinessTransactions.ReturnFromCommissionAgent))</queryText>
      <mainTable>InformationRegister.DocumentsRegistry</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
