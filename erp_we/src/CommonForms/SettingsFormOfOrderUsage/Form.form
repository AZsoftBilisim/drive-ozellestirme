  </title>
  <title>
    <key>vi</key>
    <value>Tùy chỉnh đơn hàng</value>
  </title>
  <items xsi:type="form:FormGroup">
    <name>OrderExecutionGroup</name>
    <id>1</id>
    <items xsi:type="form:FormField">
      <name>OrderExecutionMode</name>
      <id>3</id>
