      <warningOnEdit>
        <key>ru</key>
        <value>Изменять режим использования заказов после начала работы с системой не рекомендуется</value>
      </warningOnEdit>
      <warningOnEdit>
        <key>tr</key>
        <value>Sistemi kullanmaya başladıktan sonra sipariş modunu değiştirmeniz önerilmemektedir</value>
      </warningOnEdit>
      <warningOnEdit>
        <key>vi</key>
        <value>Không nên thay đổi chế độ sử dụng đơn hàng sau khi bắt đầu làm việc với hệ thống</value>
      </warningOnEdit>
      <editMode>Enter</editMode>
      <showInHeader>true</showInHeader>
      <headerHorizontalAlign>Left</headerHorizontalAlign>
      <showInFooter>true</showInFooter>
      <extInfo xsi:type="form:RadioButtonsFieldExtInfo">
        <choiceList>
          <presentation>
            <key>en</key>
            <value>Order as a commercial invoice</value>
          </presentation>
          <presentation>
            <key>fa</key>
            <value>سفارش به عنوان فاکتور تجاری</value>
          </presentation>
          <presentation>
            <key>it</key>
            <value>Ordine come conto</value>
          </presentation>
          <presentation>
            <key>pl</key>
            <value>Zamówienie jako rachunek</value>
          </presentation>
          <presentation>
            <key>ru</key>
            <value>Заказ как счет</value>
          </presentation>
          <presentation>
            <key>tr</key>
            <value>Fatura olarak sipariş</value>
          </presentation>
          <presentation>
            <key>vi</key>
            <value>Đơn hàng dưới dạng hóa đơn</value>
          </presentation>
          <value xsi:type="core:NumberValue">
            <value>0</value>
          </value>
