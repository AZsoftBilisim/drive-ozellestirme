      <name>SignAlgorithmWarning</name>
      <id>75</id>
      <title>
        <key>en</key>
        <value>Signature algorithm</value>
      </title>
      <title>
        <key>fa</key>
        <value>الگوریتم امضا</value>
      </title>
      <title>
        <key>it</key>
        <value>Algoritmo di firma</value>
      </title>
      <title>
        <key>pl</key>
        <value>Algorytm podpisu</value>
      </title>
      <title>
        <key>ru</key>
        <value>Алгоритм подписи</value>
      </title>
      <title>
        <key>tr</key>
        <value>İmza algoritması</value>
      </title>
      <title>
        <key>vi</key>
        <value>Thuật toán chữ ký</value>
