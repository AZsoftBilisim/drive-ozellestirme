    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>ContinueExecute</name>
      </handler>
    </action>
    <currentRowUse>DontUse</currentRowUse>
  </formCommands>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
</form:Form>
