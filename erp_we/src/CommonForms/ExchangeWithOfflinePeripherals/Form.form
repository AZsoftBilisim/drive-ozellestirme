      <value>Yazar kasalar</value>
    </title>
    <title>
      <key>vi</key>
      <value>Quầy thu ngân</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashRegisters.CashRegister</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashRegisters.ImportDate</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>CashRegisters.Peripherals</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	OfflineEquipmentCatalogOverridable.Peripherals,
	OfflineEquipmentCatalogOverridable.ExportDate,
	OfflineEquipmentCatalogOverridable.ImportDate,
	OfflineEquipmentCatalogOverridable.ExportIsCompleted,
	OfflineEquipmentCatalogOverridable.ImportIsCompleted,
	OfflineEquipmentCatalogOverridable.ExportPictureIndex,
	OfflineEquipmentCatalogOverridable.ExchangeRule,
	OfflineEquipmentCatalogOverridable.CashRegister,
	OfflineEquipmentCatalogOverridable.Changes,
	OfflineEquipmentCatalogOverridable.Warehouse,
	OfflineEquipmentCatalogOverridable.ConnectedToTheCurrentWorkplace
	FROM
	(SELECT
		UNDEFINED AS Peripherals,
		DATETIME(1, 1, 1) AS ExportDate,
		DATETIME(1, 1, 1) AS ImportDate,
		FALSE AS ExportIsCompleted,
		FALSE AS ImportIsCompleted,
		0 AS ExportPictureIndex,
		VALUE(Catalog.RulesOfExchangeWithOfflinePeripherals.EmptyRef) AS ExchangeRule,
		VALUE(Catalog.CWPSettings.EmptyRef) AS CashRegister,
		0 AS Changes,
		VALUE(Catalog.Warehouses.EmptyRef) AS Warehouse,
		FALSE AS ConnectedToTheCurrentWorkplace) AS OfflineEquipmentCatalogOverridable
	WHERE FALSE AND &amp;CurrentWorkplace = VALUE(Catalog.Workplaces.EmptyRef)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
