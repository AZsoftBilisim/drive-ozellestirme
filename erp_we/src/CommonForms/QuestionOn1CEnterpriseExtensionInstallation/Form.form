    <id>1</id>
    <toolTip>
      <key>en</key>
      <value>Install 1C:Enterprise Extension and continue.</value>
    </toolTip>
    <toolTip>
      <key>fa</key>
      <value>نصب افزونه 1C:Enterprise و ادامه.</value>
    </toolTip>
    <toolTip>
      <key>it</key>
      <value>Installare l'estensione di lavoro 1C:Enterprise e continuare</value>
    </toolTip>
    <toolTip>
      <key>pl</key>
      <value>Zainstaluj rozszerzenie do pracy z 1C:Enterprise i kontynuuj</value>
    </toolTip>
    <toolTip>
      <key>ru</key>
      <value>Установить расширение для работы с 1С:Предприятием и продолжить</value>
    </toolTip>
    <toolTip>
      <key>tr</key>
      <value>1C:Enterprise ile çalışmak için uzantıyı yükleyin ve devam edin</value>
    </toolTip>
    <toolTip>
      <key>vi</key>
      <value>Cài đặt tiện ích mở rộng để hoạt động với 1C: Enterprise và tiếp tục</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>InstallAndContinue</name>
      </handler>
    </action>
    <currentRowUse>DontUse</currentRowUse>
  </formCommands>
