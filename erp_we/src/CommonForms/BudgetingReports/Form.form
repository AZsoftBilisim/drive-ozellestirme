    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>BudgetProfileList.Parent</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>SELECT
	CatalogBudgetProfiles.Ref AS BudgetProfile,
	CatalogBudgetProfiles.DeletionMark,
	CatalogBudgetProfiles.Parent,
	CatalogBudgetProfiles.IsFolder,
	CatalogBudgetProfiles.Description,
	CASE
		WHEN CatalogBudgetProfiles.IsFolder
			THEN 2
		ELSE 1
	END AS CustomPicture,
	CatalogBudgetProfiles.Comment,
	CatalogBudgetProfiles.Owner
FROM
	Catalog.BudgetProfiles AS CatalogBudgetProfiles
WHERE
	NOT CatalogBudgetProfiles.DeletionMark</queryText>
      <mainTable>Catalog.BudgetProfiles</mainTable>
